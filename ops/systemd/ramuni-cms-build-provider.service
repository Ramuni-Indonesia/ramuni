[Unit]
Description=RAMUNI CMS Astro build provider
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/meetsin/internal/ramuni-source-provider-runtime
ExecStart=/usr/bin/docker run --rm --name ramuni-cms-build-provider --user 1000:1000 --network host --read-only --cap-drop ALL --security-opt no-new-privileges --pids-limit 512 --tmpfs /tmp:rw,nosuid,nodev,noexec,size=128m,uid=1000,gid=1000 --env-file /home/meetsin/.config/ramuni-cms-build-provider/provider.env -v /home/meetsin/internal/ramuni-source-provider-runtime:/app:rw -v /home/meetsin/.config/ramuni-cms-build-provider:/run/secrets:ro -v /var/lib/ramuni-cms-build-provider:/var/lib/ramuni-cms-build-provider -v /var/www/ramuni-staging:/var/www/ramuni-staging -w /app node:22.18.0-bookworm@sha256:3266bc9e8bee1acc8a77386eefaf574987d2729b8c5ec35b0dbd6ddbc40b0ce2 node ops/cms-build-provider/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

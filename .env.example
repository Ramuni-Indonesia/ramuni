# Public deployment policy. Fail-closed defaults keep local, preview, and
# staging builds out of search. Production requires both values below to be
# changed explicitly by the release environment.
PUBLIC_DEPLOY_ENV=local
PUBLIC_INDEXING_ENABLED=false

# Canonical production origin.
PUBLIC_SITE_URL=https://www.ramuni.id

# Optional public asset origin. Leave empty locally; staging uses the R2 custom
# domain during its verified post-build rewrite.
PUBLIC_ASSET_BASE_URL=

# Keep empty until an approved, protected lead endpoint exists.
PUBLIC_LEAD_ENDPOINT=

# Indexability gates. Enable only after the named owner signs off.
PUBLIC_CLAIM_PAGES_APPROVED=false
PUBLIC_SECURITY_REVIEW_APPROVED=false
PUBLIC_CALCULATOR_REVIEW_APPROVED=false
PUBLIC_RESOURCE_REVIEW_APPROVED=false
# Public price values require a separate Finance/Product sign-off.
PUBLIC_PRICING_APPROVED=false

# Route A mascot remains an internal concept until brand/IP approval.
PUBLIC_MASCOT_EXPLORATION_APPROVED=false

# Build-time CMS delivery. `local` remains the safe default. Candidate builds
# may keep unmigrated local routes through the explicit migration fallback.
RAMUNI_CONTENT_SOURCE=local
RAMUNI_CMS_BASE_URL=https://cms.ramuni.id
RAMUNI_CMS_LOCALE=id-ID
RAMUNI_CMS_DELIVERY_TOKEN_FILE=
RAMUNI_CMS_MIGRATION_FALLBACK=
RAMUNI_CMS_CANDIDATE_FILE=
RAMUNI_CMS_EVENT_ID=
RAMUNI_CMS_SNAPSHOT_ID=
RAMUNI_CMS_REVISION_HASH=

# Loopback build-provider settings. Secret values are file references and must
# never be exposed to browser-side PUBLIC_* variables.
RAMUNI_PROVIDER_BIND_HOST=127.0.0.1
RAMUNI_PROVIDER_PORT=4330
RAMUNI_PROVIDER_MARKETING_SHA=
RAMUNI_PROVIDER_CMS_BASE_URL=https://cms.ramuni.id
RAMUNI_PROVIDER_PUBLIC_BASE_URL=https://staging.ramuni.id
RAMUNI_PROVIDER_CMS_DELIVERY_TOKEN_FILE=
RAMUNI_PROVIDER_SHARED_HMAC_SECRET_FILE=
RAMUNI_PROVIDER_DATABASE_PATH=/var/lib/ramuni-cms-build-provider/inbox.sqlite
RAMUNI_PROVIDER_STATE_ROOT=/var/lib/ramuni-cms-build-provider
RAMUNI_PROVIDER_MARKETING_REPOSITORY=/app
RAMUNI_PROVIDER_RELEASE_ROOT=/var/www/ramuni-staging
RAMUNI_PROVIDER_COMMAND_TIMEOUT_MS=1200000
RAMUNI_PROVIDER_RELEASE_RETENTION=8

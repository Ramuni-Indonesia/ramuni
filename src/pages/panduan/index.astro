---
import BaseLayout from '../../layouts/BaseLayout.astro';
const guides=[
  { slug:'membaca-stok-harian', title:'Membaca stok harian', text:'Hubungkan sisa stok dengan kecepatan penjualan.', question:'Produk mana yang perlu dicek lebih dulu?', time:'6 menit' },
  { slug:'memahami-arus-kas', title:'Memahami arus kas', text:'Pisahkan uang masuk, uang keluar, dan waktu terjadinya.', question:'Kenapa omzet naik tetapi kas terasa sempit?', time:'7 menit' },
  { slug:'menilai-insight-ai', title:'Menilai insight AI', text:'Periksa periode, bukti, dan batas kesimpulan sebelum bertindak.', question:'Apa yang perlu dicek sebelum mengikuti saran?', time:'5 menit' },
];
---
<BaseLayout title="Panduan Bisnis Praktis" description="Panduan praktis RAMUNI untuk membaca stok, arus kas, penjualan, dan insight AI dengan langkah yang jelas.">
  <section class="resource-hero"><div class="container"><nav class="breadcrumbs"><a href="/">Beranda</a><span>/</span><a href="/sumber-daya">Sumber Daya</a><span>/</span><span>Panduan</span></nav><p class="eyebrow">Panduan</p><h1>Satu masalah. Satu alur yang jelas.</h1><p class="lede">Bacaan singkat untuk membantu tim memahami angka sebelum menentukan langkah berikutnya.</p></div></section>
  <section class="section surface" aria-labelledby="guide-list-title"><div class="container"><div class="section-intro reveal"><div><p class="section-kicker">Mulai di sini</p><h2 id="guide-list-title">Pilih pertanyaan yang sedang mengganggu.</h2></div><p>Setiap panduan dimulai dari konteks, menunjukkan angka yang perlu dilihat, lalu menutup dengan pemeriksaan sederhana.</p></div><div class="guide-list">{guides.map((guide,i)=><a class="guide-row reveal" href={`/panduan/${guide.slug}`}><span>0{i+1}</span><div><small>{guide.question} · {guide.time}</small><h3>{guide.title}</h3><p>{guide.text}</p></div><b>Baca panduan</b></a>)}</div></div></section>
  <section class="section" aria-labelledby="guide-method-title"><div class="container resource-path"><div class="reveal"><p class="section-kicker">Cara membaca</p><h2 id="guide-method-title">Berhenti pada bukti, bukan dugaan.</h2><p>Panduan RAMUNI tidak menggantikan catatan usaha. Gunakan sebagai urutan pemeriksaan agar diskusi tim lebih terarah.</p></div><ol class="resource-questions"><li>Pastikan periode dan sumber datanya sama.</li><li>Bandingkan perubahan, bukan hanya angka terakhir.</li><li>Catat keputusan dan waktu pemeriksaan berikutnya.</li></ol></div></section>
</BaseLayout>

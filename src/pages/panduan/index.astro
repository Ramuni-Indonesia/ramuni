  <section class="section surface"><div class="container guide-list">{guides.map(([slug,title,text],i)=><a class="guide-row reveal" href={`/panduan/${slug}`}><span>0{i+1}</span><div><h2>{title}</h2><p>{text}</p></div><b>Baca panduan</b></a>)}</div></section>

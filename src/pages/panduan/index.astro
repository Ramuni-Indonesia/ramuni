---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { releaseGates } from '../../config/release';
import '../../styles/learning-resource-pages.css';

const guides = [
  {
    slug: 'membaca-stok-harian',
    title: 'Membaca stok harian',
    question: 'Produk mana yang perlu dicek lebih dulu?',
    text: 'Hubungkan sisa stok, barang masuk, dan laju penjualan sebelum buru-buru memesan lagi.',
    time: '6 menit',
    visual: 'stock',
    signals: ['Saldo hari ini', 'Barang keluar', 'Catatan selisih'],
  },
  {
    slug: 'memahami-arus-kas',
    title: 'Memahami arus kas',
    question: 'Kenapa omzet naik tetapi kas terasa sempit?',
    text: 'Pisahkan waktu uang masuk dan keluar agar omzet tidak dibaca sebagai uang yang sudah tersedia.',
    time: '7 menit',
    visual: 'cash',
    signals: ['Saldo pembuka', 'Uang masuk', 'Uang keluar'],
  },
  {
    slug: 'menilai-insight-ai',
    title: 'Menilai insight AI',
    question: 'Apa yang perlu dicek sebelum mengikuti saran?',
    text: 'Periksa periode, bukti, dan dasar kesimpulan sebelum membawa jawaban AI ke keputusan usaha.',
    time: '5 menit',
    visual: 'ai',
    signals: ['Pertanyaan', 'Bukti', 'Dasar jawaban'],
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Panduan Bisnis Praktis RAMUNI',
    description: 'Panduan praktis untuk membaca stok, arus kas, dan insight AI dengan urutan pemeriksaan yang jelas.',
    url: new URL('/panduan/', Astro.site || Astro.url.origin).toString(),
    inLanguage: 'id-ID',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: guides.map((guide, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: guide.title,
      url: new URL(`/panduan/${guide.slug}/`, Astro.site || Astro.url.origin).toString(),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: new URL('/', Astro.site || Astro.url.origin).toString() },
      { '@type': 'ListItem', position: 2, name: 'Panduan', item: new URL('/panduan/', Astro.site || Astro.url.origin).toString() },
    ],
  },
];
---

<BaseLayout
  title="Panduan Bisnis Praktis untuk UMKM"
  description="Panduan langkah demi langkah untuk membaca stok harian, arus kas, dan insight AI sebelum mengambil keputusan usaha."
  noindex={!releaseGates.resourcePagesIndexable}
  schema={schema}
  keywords={['panduan bisnis UMKM', 'cara membaca stok', 'cara membaca arus kas', 'menilai insight AI', 'RAMUNI']}
>
  <div class="learning-page learning-page--guide">
    <header class="learning-hero">
      <div class="container learning-hero__grid">
        <div class="learning-hero__copy reveal is-visible">
          <nav class="breadcrumbs" aria-label="Jejak navigasi"><a href="/">Beranda</a><span>/</span><a href="/sumber-daya/">Sumber Daya</a><span>/</span><span aria-current="page">Panduan</span></nav>
          <p class="eyebrow">Panduan bisnis praktis</p>
          <h1>Mulai dari pertanyaan yang mengganggu pekerjaan hari ini.</h1>
          <p class="lede">Pilih satu masalah, lihat angka yang perlu diperiksa, lalu tentukan langkah kecil berikutnya. Tidak perlu membaca semuanya sekaligus.</p>
          <div class="learning-hero__pills" aria-label="Topik panduan"><a href="#panduan-stok">Stok</a><a href="#panduan-kas">Arus kas</a><a href="#panduan-ai">Insight AI</a></div>
        </div>

        <div class="learning-guide-map reveal is-visible" data-guide-map>
          <header><span>Peta pemeriksaan</span><small>Gunakan catatan yang tersedia</small></header>
          <div class="learning-guide-map__tabs" role="tablist" aria-label="Contoh alur panduan">
            {guides.map((guide, index) => <button type="button" role="tab" id={`guide-map-tab-${guide.visual}`} aria-controls={`guide-map-panel-${guide.visual}`} aria-selected={index === 0 ? 'true' : 'false'} data-guide-map-tab={guide.visual}>{guide.visual === 'stock' ? 'Stok' : guide.visual === 'cash' ? 'Kas' : 'Insight AI'}</button>)}
          </div>
          <div class="learning-guide-map__stage">
            <img src="/website-original/ramuni-mascot-muni-manyar.webp" width="720" height="720" alt="Muni membantu menunjukkan urutan pemeriksaan bisnis" decoding="async" />
            {guides.map((guide, index) => <section role="tabpanel" id={`guide-map-panel-${guide.visual}`} aria-labelledby={`guide-map-tab-${guide.visual}`} data-guide-map-panel={guide.visual} hidden={index !== 0}>
              <small>{guide.question}</small>
              <h2>{guide.title}</h2>
              <ol>{guide.signals.map((signal, signalIndex) => <li><span>0{signalIndex + 1}</span><strong>{signal}</strong></li>)}</ol>
              <a href={`/panduan/${guide.slug}/`}>Buka alur lengkap <span aria-hidden="true">→</span></a>
            </section>)}
          </div>
          <footer><span>Catatan</span><strong>→</strong><span>Bukti</span><strong>→</strong><span>Langkah</span></footer>
        </div>
      </div>
    </header>

    <section class="section surface learning-catalog" aria-labelledby="guide-list-title">
      <div class="container">
        <div class="learning-section-head reveal">
          <div><p class="section-kicker">Pilih panduan</p><h2 id="guide-list-title">Satu panduan untuk satu keputusan.</h2></div>
          <p>Setiap panduan berhenti pada pemeriksaan manusia. Angka contoh hanya membantu menjelaskan urutan, bukan menggambarkan hasil usaha tertentu.</p>
        </div>
        <div class="learning-guide-deck">
          {guides.map((guide, index) => <a id={`panduan-${guide.visual === 'stock' ? 'stok' : guide.visual === 'cash' ? 'kas' : 'ai'}`} class:list={['learning-guide-card', `learning-guide-card--${guide.visual}`, 'reveal']} href={`/panduan/${guide.slug}/`} style={`--i:${index}`}>
            <div class="learning-guide-card__visual" aria-hidden="true"><span>0{index + 1}</span><i></i><i></i><i></i><b></b></div>
            <div class="learning-guide-card__copy"><small>{guide.question} · {guide.time}</small><h3>{guide.title}</h3><p>{guide.text}</p><ul>{guide.signals.map((signal) => <li>{signal}</li>)}</ul><strong>Baca panduan <span aria-hidden="true">→</span></strong></div>
          </a>)}
        </div>
      </div>
    </section>

    <section class="section learning-method" aria-labelledby="guide-method-title">
      <div class="container learning-method__grid">
        <div class="learning-method__copy reveal"><p class="section-kicker">Cara memakai panduan</p><h2 id="guide-method-title">Berhenti pada bukti, bukan dugaan.</h2><p>Panduan RAMUNI tidak menggantikan catatan usaha. Gunakan sebagai urutan pemeriksaan agar diskusi dengan tim tidak melompat langsung ke kesimpulan.</p><a class="text-link" href="/blog/metodologi-fact-check/">Lihat cara kami memeriksa materi</a></div>
        <ol class="learning-method__rail">
          <li class="reveal"><span>01</span><div><h3>Samakan konteks</h3><p>Tentukan pertanyaan, periode, dan satuan yang sedang dibahas.</p></div></li>
          <li class="reveal"><span>02</span><div><h3>Buka catatan</h3><p>Bandingkan perubahan dengan transaksi, bukti, atau kejadian yang relevan.</p></div></li>
          <li class="reveal"><span>03</span><div><h3>Tulis langkah kecil</h3><p>Catat siapa yang memeriksa dan kapan hasilnya perlu dilihat lagi.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="section learning-close-stage">
      <div class="container learning-close reveal">
        <div class="learning-close__mascot" aria-hidden="true"><span></span><img src="/website-original/ramuni-mascot-muni-manyar.webp" width="720" height="720" alt="Maskot Muni Manyar RAMUNI" loading="lazy" decoding="async" /></div>
        <div><p class="section-kicker">Belajar sambil mencoba</p><h2>Bawa satu pertanyaan. Pilih alat yang paling dekat.</h2><p>Gunakan kalkulator untuk memeriksa hitungan atau template untuk merapikan catatan sebelum membaca panduan lagi.</p><div class="button-row"><a class="button button--primary" href="/kalkulator/">Buka kalkulator</a><a class="button button--secondary" href="/template/">Lihat template</a></div></div>
        <div class="learning-close__cards"><a href="/kalkulator/reorder-stok/"><small>Untuk stok</small><strong>Hitung titik pemeriksaan</strong><span>→</span></a><a href="/template/arus-kas-sederhana/"><small>Untuk kas</small><strong>Rapikan uang masuk dan keluar</strong><span>→</span></a></div>
      </div>
    </section>
  </div>

  <script>
    document.querySelectorAll<HTMLElement>('[data-guide-map]').forEach((map) => {
      const tabs = Array.from(map.querySelectorAll<HTMLButtonElement>('[data-guide-map-tab]'));
      const panels = Array.from(map.querySelectorAll<HTMLElement>('[data-guide-map-panel]'));
      const activate = (id: string) => {
        tabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.guideMapTab === id)));
        panels.forEach((panel) => { panel.hidden = panel.dataset.guideMapPanel !== id; });
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => activate(tab.dataset.guideMapTab || 'stock'));
        tab.addEventListener('keydown', (event) => {
          if (!['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(event.key)) return;
          event.preventDefault();
          const nextIndex = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : event.key === 'ArrowRight' ? (index + 1) % tabs.length : (index - 1 + tabs.length) % tabs.length;
          tabs[nextIndex]?.focus();
          activate(tabs[nextIndex]?.dataset.guideMapTab || 'stock');
        });
      });
    });
  </script>
</BaseLayout>

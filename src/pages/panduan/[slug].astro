---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { releaseGates } from '../../config/release';
export function getStaticPaths(){
const guides={
  'membaca-stok-harian':{title:'Membaca Stok Harian',outcome:'Menemukan stok yang perlu diperiksa sebelum jam ramai.',steps:[{title:'Pilih produk yang bergerak cepat',text:'Mulai dari produk yang paling sering terjual atau paling berisiko habis.'},{title:'Bandingkan sisa stok dengan penjualan',text:'Gunakan periode yang sama agar sisa stok dan laju penjualan dapat dibaca bersama.'},{title:'Periksa pergerakan dan selisih',text:'Telusuri barang masuk, penjualan, retur, serta koreksi sebelum menyimpulkan penyebab.'},{title:'Catat keputusan berikutnya',text:'Tentukan produk yang perlu dihitung ulang, dipindahkan, atau disiapkan untuk pemesanan.'}]},
  'memahami-arus-kas':{title:'Memahami Arus Kas',outcome:'Membaca arah uang masuk dan keluar dalam satu periode.',steps:[{title:'Tentukan periode',text:'Pilih tanggal awal dan akhir, lalu catat saldo kas pada kedua titik tersebut.'},{title:'Kelompokkan uang masuk',text:'Pisahkan penerimaan penjualan, pelunasan piutang, modal, dan sumber lain yang diketahui.'},{title:'Kelompokkan uang keluar',text:'Bedakan pembelian stok, biaya rutin, pembayaran utang, dan pengeluaran lain.'},{title:'Periksa perubahan yang tidak biasa',text:'Bandingkan arus bersih dengan perubahan saldo dan telusuri selisih yang belum memiliki catatan.'}]},
  'menilai-insight-ai':{title:'Menilai Insight AI',outcome:'Memeriksa jawaban AI sebelum menjadikannya dasar keputusan.',steps:[{title:'Baca kesimpulan',text:'Pastikan jawaban menjawab pertanyaan Anda dan tidak menyamarkan ketidakpastian.'},{title:'Periksa periode',text:'Cocokkan rentang waktu, waktu pembaruan, dan kelengkapan data yang digunakan.'},{title:'Telusuri bukti',text:'Buka angka atau catatan pendukung dan periksa apakah bukti sesuai dengan kesimpulannya.'},{title:'Nilai batas dan tindakan',text:'Catat asumsi yang tersisa, lalu tentukan pemeriksaan manusia sebelum mengambil tindakan.'}]},
};
return Object.entries(guides).map(([slug,guide])=>({params:{slug},props:{guide}}));
}
const {guide}=Astro.props;
---
<BaseLayout title={`${guide.title} | Panduan RAMUNI`} description={`${guide.outcome} Panduan RAMUNI dengan langkah praktis dan batas penggunaan yang jelas.`} noindex={!releaseGates.resourcePagesIndexable}>
  <article class="guide-article"><header class="container guide-header"><nav class="breadcrumbs"><a href="/">Beranda</a><span>/</span><a href="/panduan">Panduan</a><span>/</span><span>{guide.title}</span></nav><p class="eyebrow">Panduan praktis</p><h1>{guide.title}</h1><p class="lede">{guide.outcome}</p><div class="article-meta"><span>Tim Editorial RAMUNI</span><span>Contoh edukatif</span><span>5 menit</span></div></header><section class="section surface"><div class="container guide-body"><aside><strong>Hasil yang dituju</strong><p>{guide.outcome}</p><small>Gunakan data contoh atau data yang sudah disamarkan. Jangan masukkan data sensitif.</small></aside><ol>{guide.steps.map((step,i)=><li class="reveal"><span>0{i+1}</span><div><h2>{step.title}</h2><p>{step.text}</p></div></li>)}</ol></div></section></article>
</BaseLayout>

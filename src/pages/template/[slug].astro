---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TemplatePreview from '../../components/template/TemplatePreview.astro';
import { releaseGates } from '../../config/release';
import { templateEntries } from '../../data/templates';
import '../../styles/template-library.css';

export function getStaticPaths() {
  return templateEntries.map(([slug, template]) => ({ params: { slug }, props: { template } }));
}

const { template } = Astro.props;
const templateUrl = new URL(`/template/${template.slug}/`, Astro.site || Astro.url.origin).toString();
const relatedResources = {
  'stok-harian': [
    { type: 'Panduan', title: 'Membaca stok harian', text: 'Tentukan urutan pemeriksaan sebelum mengisi dan membandingkan saldo.', href: '/panduan/membaca-stok-harian/' },
    { type: 'Kalkulator', title: 'Titik reorder stok', text: 'Perkirakan kapan stok perlu mulai diperiksa untuk pemesanan.', href: '/kalkulator/reorder-stok/' },
    { type: 'Kamus', title: 'Stok pengaman', text: 'Pahami fungsi cadangan stok dan risikonya.', href: '/kamus-bisnis/stok-pengaman/' },
  ],
  'arus-kas-sederhana': [
    { type: 'Panduan', title: 'Memahami arus kas', text: 'Pisahkan kas, omzet, piutang, dan waktu pembayaran.', href: '/panduan/memahami-arus-kas/' },
    { type: 'Kalkulator', title: 'Arus kas bersih', text: 'Hitung selisih uang masuk dan keluar pada periode yang sama.', href: '/kalkulator/arus-kas-bersih/' },
    { type: 'Kamus', title: 'Arus kas', text: 'Lihat definisi dan contoh yang sering tertukar dengan laba.', href: '/kamus-bisnis/arus-kas/' },
  ],
  'evaluasi-mingguan': [
    { type: 'Panduan', title: 'Menilai insight AI', text: 'Periksa pertanyaan, bukti, periode, dan dasar jawaban.', href: '/panduan/menilai-insight-ai/' },
    { type: 'Kalkulator', title: 'Laba usaha', text: 'Bawa hasil hitung ke evaluasi dengan periode yang jelas.', href: '/kalkulator/laba-usaha/' },
    { type: 'Sumber daya', title: 'Pusat sumber daya', text: 'Pilih panduan, alat, atau istilah untuk temuan berikutnya.', href: '/sumber-daya/' },
  ],
  'penjualan-harian': [
    { type: 'Kalkulator', title: 'Perubahan omzet', text: 'Bandingkan dua periode penjualan yang setara.', href: '/kalkulator/perubahan-omzet/' },
    { type: 'Kalkulator', title: 'Nilai transaksi rata-rata', text: 'Lihat apakah perubahan datang dari nilai belanja per transaksi.', href: '/kalkulator/nilai-transaksi-rata-rata/' },
    { type: 'Produk', title: 'Penjualan RAMUNI', text: 'Baca transaksi, produk, dan waktu yang membentuk omzet.', href: '/produk/penjualan/' },
  ],
  'hpp-produk': [
    { type: 'Kalkulator', title: 'Harga jual target', text: 'Perkirakan harga jual dari HPP per unit dan target margin.', href: '/kalkulator/harga-jual/' },
    { type: 'Kamus', title: 'Harga Pokok Penjualan', text: 'Samakan definisi biaya barang sebelum membaca margin.', href: '/kamus-bisnis/hpp/' },
    { type: 'Produk', title: 'Katalog Produk', text: 'Rapikan SKU, unit, harga, dan HPP agar transaksi konsisten.', href: '/produk/katalog-produk/' },
  ],
  'stok-opname': [
    { type: 'Panduan', title: 'Membaca stok harian', text: 'Susun pemeriksaan saldo dan mutasi sebelum melakukan koreksi.', href: '/panduan/membaca-stok-harian/' },
    { type: 'Kalkulator', title: 'Titik reorder stok', text: 'Bandingkan hasil opname dengan batas pemeriksaan stok berikutnya.', href: '/kalkulator/reorder-stok/' },
    { type: 'Produk', title: 'Inventori RAMUNI', text: 'Lihat saldo, mutasi, dan laju keluar dalam satu urutan pemeriksaan.', href: '/produk/inventori/' },
  ],
}[template.slug];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'DigitalDocument',
    name: template.title,
    description: template.summary,
    url: templateUrl,
    inLanguage: 'id-ID',
    encodingFormat: 'text/csv',
    version: template.version,
    dateModified: template.updatedAtIso,
    isAccessibleForFree: true,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: new URL('/', Astro.site || Astro.url.origin).toString() },
      { '@type': 'ListItem', position: 2, name: 'Template', item: new URL('/template/', Astro.site || Astro.url.origin).toString() },
      { '@type': 'ListItem', position: 3, name: template.title, item: templateUrl },
    ],
  },
];
---

<BaseLayout title={template.title} description={`${template.summary} Unduh CSV gratis dengan contoh dan petunjuk kolom.`} noindex={!releaseGates.resourcePagesIndexable} schema={schema} keywords={[template.title, 'template bisnis UMKM', 'template CSV gratis', 'RAMUNI']}>
  <article class="template-detail-page">
    <header class="template-detail-hero utility-masthead">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Jejak navigasi"><a href="/">Beranda</a><span>/</span><a href="/template/">Template</a><span>/</span><span aria-current="page">{template.shortTitle}</span></nav>
        <div class="template-detail-hero__grid">
          <div class="template-detail-hero__copy">
            <p class="eyebrow">{template.eyebrow}</p>
            <h1>{template.title}</h1>
            <p class="lede">{template.summary}</p>
            <div class="button-row">
              <a class="button button--primary" href="#pratinjau">Pratinjau & unduh CSV</a>
              <a class="button button--secondary" href="/template/">Lihat template lain</a>
            </div>
          </div>
          <aside class="template-detail-hero__brief" aria-label="Ringkasan template">
            <span>Hasil yang dibantu</span>
            <strong>{template.outcome}</strong>
            <dl>
              <div><dt>Ritme</dt><dd>{template.cadence}</dd></div>
              <div><dt>Format</dt><dd>CSV · {template.columns.length} kolom</dd></div>
              <div><dt>Versi</dt><dd>{template.version} · {template.updatedAt}</dd></div>
            </dl>
          </aside>
        </div>
      </div>
    </header>

    <section class="section surface" id="pratinjau" aria-label={`Pratinjau ${template.title}`}>
      <div class="container"><TemplatePreview template={template} /></div>
    </section>

    <section class="section template-how" aria-labelledby="template-how-title">
      <div class="container template-how__layout">
        <div class="template-how__lead reveal">
          <p class="section-kicker">Cara pakai</p>
          <h2 id="template-how-title">Pakai dengan urutan yang mudah diulang.</h2>
          <p>Ikuti langkah inti terlebih dahulu. Ubah nama kolom hanya jika proses usaha memang membutuhkannya.</p>
        </div>
        <ol class="template-how__steps">
          {template.instructions.map((item, index) => <li class="reveal" style={`--i:${index}`}><span>0{index + 1}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></li>)}
        </ol>
        <aside class="template-how__guardrails" aria-labelledby="template-guardrails-title">
          <p class="section-kicker">Sebelum memakai</p>
          <h3 id="template-guardrails-title">Batas penggunaan yang perlu diingat.</h3>
          <ul>{template.limitations.map((limitation) => <li>{limitation}</li>)}</ul>
        </aside>
      </div>
    </section>

    <section class="section dark-surface template-columns-stage" aria-labelledby="template-columns-title">
      <div class="container">
        <div class="template-columns-stage__head reveal">
          <p class="section-kicker">Definisi kolom</p>
          <h2 id="template-columns-title">Tidak ada kolom yang perlu ditebak.</h2>
        </div>
        <div class="template-column-index">
          {template.columns.map((column, index) => <article class="reveal" style={`--i:${index % 4}`}><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{column.label}</h3><p>{column.description}</p></div></article>)}
        </div>
      </div>
    </section>

    <section class="section template-related" aria-labelledby="template-related-title">
      <div class="container">
        <div class="template-library-intro reveal"><div><p class="section-kicker">Gunakan bersama</p><h2 id="template-related-title">Baca catatan sebelum mengambil keputusan.</h2></div><p>Template menyimpan urutan data. Materi berikut membantu Anda membaca angka, istilah, dan cara penggunaannya.</p></div>
        <div class="template-related__grid">
          {relatedResources.map((item, index) => <a class="reveal" href={item.href}><span>{String(index + 1).padStart(2, '0')}</span><small>{item.type}</small><h3>{item.title}</h3><p>{item.text}</p><b>Buka materi <i aria-hidden="true">→</i></b></a>)}
        </div>
      </div>
    </section>

  </article>
</BaseLayout>

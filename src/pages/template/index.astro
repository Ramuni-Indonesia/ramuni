---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { releaseGates } from '../../config/release';
const templates=[
  { title:'Stok harian', text:'Catat saldo, gerak barang, dan keputusan restock.', includes:'Saldo awal, barang masuk, barang keluar, catatan pemeriksaan' },
  { title:'Arus kas mingguan', text:'Pisahkan pemasukan, pengeluaran, dan perubahan penting.', includes:'Uang masuk, uang keluar, saldo, penjelasan perubahan' },
  { title:'Review bisnis', text:'Bawa tiga insight utama ke evaluasi mingguan.', includes:'Temuan, bukti, keputusan, penanggung jawab, pemeriksaan berikutnya' },
];
---
<BaseLayout title="Template Bisnis RAMUNI" description="Template bisnis RAMUNI untuk membantu UMKM menyiapkan catatan stok, arus kas, dan evaluasi mingguan." noindex={!releaseGates.resourcePagesIndexable}>
  <section class="resource-hero"><div class="container"><nav class="breadcrumbs"><a href="/">Beranda</a><span>/</span><a href="/sumber-daya">Sumber Daya</a><span>/</span><span>Template</span></nav><p class="eyebrow">Template</p><h1>Format kerja yang menjelaskan cara pakainya.</h1><p class="lede">Lihat struktur setiap template sebelum file unduhan dibuka setelah review.</p></div></section>
  <section class="section surface" aria-labelledby="template-list-title"><div class="container"><div class="section-intro reveal"><div><p class="section-kicker">Dalam persiapan</p><h2 id="template-list-title">Tiga catatan yang membantu menjaga konteks.</h2></div><p>Setiap format akan menyertakan contoh, definisi kolom, dan cara meninjau hasilnya.</p></div><div class="template-ledger">{templates.map((item,i)=><article class="template-row reveal"><span>0{i+1}</span><div><h3>{item.title}</h3><small>{item.includes}</small></div><p>{item.text}</p><b aria-label={`${item.title} sedang ditinjau`}>Sedang ditinjau</b></article>)}</div></div></section>
  <section class="section" aria-labelledby="template-release-title"><div class="container resource-path"><div class="reveal"><p class="section-kicker">Standar rilis</p><h2 id="template-release-title">File dibuka setelah isinya bisa dipakai tanpa menebak.</h2></div><ol class="resource-questions"><li>Kolom dan istilah sudah didefinisikan.</li><li>Contoh tidak memuat data pelanggan nyata.</li><li>Versi dan tanggal pembaruan terlihat jelas.</li></ol></div></section>
</BaseLayout>

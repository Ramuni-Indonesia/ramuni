---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TourEvidenceCTA from '../../components/TourEvidenceCTA.astro';
import { releaseGates } from '../../config/release';
import { templateEntries } from '../../data/templates';
import '../../styles/template-library.css';

const templateUrl = new URL('/template/', Astro.site || Astro.url.origin).toString();
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Template Bisnis Gratis untuk UMKM',
    description: 'Kumpulan template stok, stok opname, arus kas, penjualan harian, HPP produk, dan evaluasi mingguan dalam format CSV.',
    url: templateUrl,
    inLanguage: 'id-ID',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: templateEntries.map(([, template], index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: template.title,
      url: new URL(`/template/${template.slug}/`, Astro.site || Astro.url.origin).toString(),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: new URL('/', Astro.site || Astro.url.origin).toString() },
      { '@type': 'ListItem', position: 2, name: 'Template', item: templateUrl },
    ],
  },
];
---

<BaseLayout title="Template Bisnis Gratis untuk UMKM" description="Unduh template stok, arus kas, penjualan harian, HPP, stok opname, dan evaluasi mingguan dalam CSV gratis dengan contoh dan petunjuk kolom." noindex={!releaseGates.resourcePagesIndexable} pageType="CollectionPage" schema={schema} keywords={['template bisnis gratis', 'template UMKM', 'template stok', 'template stok opname', 'template arus kas', 'template penjualan harian', 'template HPP produk', 'RAMUNI']}>
  <div class="template-library-page">
    <header class="template-library-hero">
      <div class="container template-library-hero__grid">
        <div>
          <nav class="breadcrumbs" aria-label="Jejak navigasi"><a href="/">Beranda</a><span>/</span><a href="/sumber-daya/">Sumber Daya</a><span>/</span><span aria-current="page">Template</span></nav>
          <p class="eyebrow">Template kerja gratis</p>
          <h1>Catatan yang siap dipakai, bukan sekadar file kosong.</h1>
          <p class="lede">{templateEntries.length} format CSV untuk pekerjaan rutin usaha. Setiap template dilengkapi baris contoh, arti kolom, dan cara memeriksanya.</p>
        </div>
        <div class="template-library-hero__signal" aria-hidden="true">
          <div><span>01</span><i></i><strong>Catat</strong></div>
          <div><span>02</span><i></i><strong>Periksa</strong></div>
          <div><span>03</span><i></i><strong>Putuskan</strong></div>
        </div>
      </div>
    </header>

    <section class="section surface" aria-labelledby="template-list-title">
      <div class="container">
        <div class="template-library-intro reveal">
          <div><p class="section-kicker">Pilih pekerjaan</p><h2 id="template-list-title">Mulai dari catatan yang paling sering tercecer.</h2></div>
          <p>Pratinjau isi sebelum mengunduh. File dapat dibuka di aplikasi spreadsheet yang mendukung CSV.</p>
        </div>
        <div class="template-catalog">
          {templateEntries.map(([, template], index) => <a class="template-catalog__card reveal" style={`--i:${index}`} href={`/template/${template.slug}/`}>
            <div class="template-catalog__visual" aria-hidden="true"><span>{String(index + 1).padStart(2, '0')}</span>{Array.from({ length: 5 }, (_, line) => <i style={`--line:${line}`} />)}</div>
            <div class="template-catalog__copy">
              <small>{template.eyebrow} · {template.cadence}</small>
              <h2>{template.shortTitle}</h2>
              <p>{template.summary}</p>
              <dl><div><dt>Format</dt><dd>CSV</dd></div><div><dt>Kolom</dt><dd>{template.columns.length}</dd></div><div><dt>Versi</dt><dd>{template.version}</dd></div></dl>
              <b>Lihat pratinjau <span>→</span></b>
            </div>
          </a>)}
        </div>
      </div>
    </section>

    <section class="section template-library-guidance" aria-labelledby="template-guidance-title">
      <div class="container template-library-guidance__grid">
        <div><p class="section-kicker">Mulai dengan rapi</p><h2 id="template-guidance-title">Pilih satu format, isi dengan data sendiri, lalu tetapkan waktu ceknya.</h2></div>
        <ol><li><b>01</b><span>Pahami kolom dan ganti seluruh baris contoh.</span></li><li><b>02</b><span>Gunakan satu aturan pencatatan secara konsisten.</span></li><li><b>03</b><span>Hindari password atau data pribadi yang tidak diperlukan.</span></li></ol>
      </div>
    </section>

    <section class="section" aria-label="Lanjutkan catatan template ke RAMUNI">
      <div class="container">
        <TourEvidenceCTA
          eyebrow="Setelah catatan siap"
          title="Pahami perubahan sebelum menentukan langkah berikutnya."
          body="Bawa satu masalah dari catatan stok, penjualan, biaya, atau evaluasi. Lihat contoh alur RAMUNI yang paling dekat dengan kebutuhan usaha Anda."
          primaryLabel="Lihat contoh alur gratis"
          primaryHref="/tour-produk-gratis/?intent=overview"
          secondaryLabel="Lihat semua produk"
          secondaryHref="/produk/"
          visual={{ src: '/website-original/context/ramuni-context-stock-operations.webp', width: 1200, height: 800, alt: 'Ilustrasi catatan stok dan operasi yang dihubungkan ke langkah pemeriksaan' }}
          visualBadge="Dari catatan ke arah"
          points={['Pilih satu template', 'Isi catatan penting', 'Bahas langkah berikutnya']}
        />
      </div>
    </section>
  </div>
</BaseLayout>

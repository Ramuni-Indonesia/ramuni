---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { releaseGates } from '../../config/release';
import CalculatorWidget from '../../components/CalculatorWidget.astro';
import '../../styles/calculator-widget.css';
import { calculatorEntries } from '../../data/calculators';
export function getStaticPaths(){
return calculatorEntries.map(([slug,calculator])=>({params:{slug},props:{calculator,slug}}));
}
const {calculator,slug}=Astro.props;
const calculatorUrl = new URL(`/kalkulator/${slug}/`, Astro.site || Astro.url.origin).toString();
const schema = [
  { '@context':'https://schema.org', '@type':'WebApplication', name:calculator.title, url:calculatorUrl, applicationCategory:'BusinessApplication', operatingSystem:'Web', inLanguage:'id-ID', description:calculator.decision },
  { '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement:[
    { '@type':'ListItem', position:1, name:'Beranda', item:new URL('/', Astro.site || Astro.url.origin).toString() },
    { '@type':'ListItem', position:2, name:'Kalkulator', item:new URL('/kalkulator/', Astro.site || Astro.url.origin).toString() },
    { '@type':'ListItem', position:3, name:calculator.title, item:calculatorUrl },
  ] },
];
---
<BaseLayout title={calculator.title} description={`${calculator.decision} Kalkulator edukasi dengan formula dan batas yang terlihat.`} noindex={!releaseGates.calculatorPagesIndexable} schema={schema}>
  <section class="calculator-hero"><div class="container"><nav class="breadcrumbs"><a href="/">Beranda</a><span>/</span><a href="/kalkulator">Kalkulator</a><span>/</span><span>{calculator.title}</span></nav><p class="eyebrow">Alat bantu hitung</p><h1>{calculator.title}</h1><p class="lede">{calculator.decision}</p></div></section>
  <section class="section surface"><div class="container"><CalculatorWidget kind={slug} /></div></section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CommercialAnalytics from '../components/CommercialAnalytics.astro';
import { pageLastmods } from '../data/pageLastmods';
import '../styles/commercial-pages.css';
const rows = [
  ['Catatan tersebar di WhatsApp dan spreadsheet', 'Proses penting dapat disusun dalam satu workspace yang lebih terarah.'],
  ['Laporan dibuat manual', 'Dashboard dan ringkasan membantu menyamakan periode serta sumber angka.'],
  ['Pemilik sulit mengetahui margin', 'Kerangka Profit Intelligence membantu membaca pendapatan, biaya, dan margin ketika dirilis.'],
  ['Banyak aplikasi terpisah', 'RAMUNI membantu menyatukan proses penting dan mengurangi ketergantungan pada tools yang terpisah.'],
  ['SOP hanya ada di kepala pemilik', 'SOP dan catatan dapat disimpan sebagai pengetahuan yang bisa dibahas bersama.'],
  ['Follow-up pelanggan mudah terlupakan', 'Pelanggan dan tugas follow-up dapat dipantau saat jalur terkait tersedia.'],
];
const origin = new URL('/', Astro.site || Astro.url.origin).origin;
const canonical = new URL('/compare/', origin).toString();
const schema = [{ '@context': 'https://schema.org', '@type': 'WebPage', '@id': canonical, url: canonical, name: 'RAMUNI dibandingkan cara kerja manual', description: 'Bandingkan cara kerja manual dengan alur RAMUNI tanpa klaim menggantikan seluruh software bisnis.', dateModified: pageLastmods.commercial, inLanguage: 'id-ID' }, { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Beranda', item: origin + '/' }, { '@type': 'ListItem', position: 2, name: 'Compare', item: canonical }] }];
---
<BaseLayout title="RAMUNI vs Cara Kerja Manual | Compare" description="Bandingkan cara kerja manual dengan alur RAMUNI tanpa klaim menggantikan seluruh software bisnis." canonical="/compare/" schema={schema}>
  <div class="commercial-page" data-commercial-page="compare"><section class="commercial-hero"><div class="container commercial-hero__grid"><div><Breadcrumbs items={[{ label: 'Beranda', href: '/' }, { label: 'Compare' }]} /><p class="section-kicker">Cara kerja</p><h1>Kurangi pekerjaan yang tercecer, mulai dari proses yang paling penting.</h1></div><div class="commercial-hero__aside"><p>RAMUNI membantu menyatukan proses penting dan mengurangi ketergantungan pada tools yang terpisah. RAMUNI bukan pengganti seluruh software bisnis.</p><div class="button-row"><a class="button button--primary" href="/tour-produk-gratis/?flow=trial" data-analytics-event="free_trial_click" data-analytics-location="compare_hero" data-destination="tour">Coba gratis</a><a class="button button--secondary" href="/pricing/">Bandingkan paket</a></div></div></div></section><section class="commercial-section commercial-section--white"><div class="container"><div class="commercial-section__head"><div><p class="section-kicker">Perbandingan sederhana</p><h2>Yang berubah adalah alurnya, bukan kendali Anda.</h2></div><p>Gunakan tabel ini sebagai pembuka percakapan internal. Kebutuhan teknis tetap perlu diverifikasi sebelum memilih paket.</p></div><div class="compare-table-wrap"><table class="compare-table"><thead><tr><th>Cara lama</th><th>Dengan RAMUNI</th></tr></thead><tbody>{rows.map(([oldWay, ramuniWay]) => <tr><td>{oldWay}</td><td>{ramuniWay}</td></tr>)}</tbody></table></div></div></section><section class="commercial-section"><div class="container"><div class="commercial-cta"><div><p class="section-kicker">Lihat kecocokan</p><h2>Mulai dari masalah usaha, bukan dari daftar aplikasi.</h2><p>Tim dapat menunjukkan alur yang relevan melalui sesi coba gratis.</p></div><div class="commercial-cta__actions"><a class="button button--primary" href="/tour-produk-gratis/?flow=consultation" data-analytics-event="demo_request" data-analytics-location="compare_final" data-destination="tour">Lihat demo</a><a class="button button--secondary" href="/faq/">Baca FAQ</a></div></div></div></section></div><CommercialAnalytics />
</BaseLayout>

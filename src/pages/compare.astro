---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CommercialAnalytics from '../components/CommercialAnalytics.astro';
import CommercialProofShowcase from '../components/CommercialProofShowcase.astro';
import { pageLastmods } from '../data/pageLastmods';
import '../styles/commercial-pages.css';
const rows = [
  ['Catatan tersebar di WhatsApp dan spreadsheet', 'Simpan catatan penting dalam satu workspace dengan pemilik dan waktu pembaruan yang jelas.'],
  ['Laporan dibuat manual', 'Gunakan ringkasan dan periode yang sama agar tim tidak membahas angka dari versi berbeda.'],
  ['Margin sulit ditelusuri', 'Pisahkan penjualan, HPP, biaya, dan kas sebelum menilai produk atau periode.'],
  ['Banyak aplikasi terpisah', 'Satukan proses yang paling sering dipakai tanpa mengklaim mengganti seluruh software bisnis.'],
  ['SOP hanya ada di kepala pemilik', 'Simpan SOP dan keputusan rapat supaya tim punya rujukan yang sama.'],
  ['Follow-up pelanggan mudah terlupakan', 'Tandai riwayat, status, dan izin sebelum tim menindaklanjuti pelanggan.'],
];
const origin = new URL('/', Astro.site || Astro.url.origin).origin;
const canonical = new URL('/compare/', origin).toString();
const schema = [{ '@context': 'https://schema.org', '@type': 'WebPage', '@id': canonical, url: canonical, name: 'RAMUNI dibandingkan cara kerja manual', description: 'Bandingkan cara kerja manual dengan alur RAMUNI tanpa klaim menggantikan seluruh software bisnis.', dateModified: pageLastmods.commercial, inLanguage: 'id-ID' }, { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Beranda', item: origin + '/' }, { '@type': 'ListItem', position: 2, name: 'Compare', item: canonical }] }];
---
<BaseLayout title="RAMUNI vs Cara Manual: Perbandingan untuk UMKM" description="Bandingkan cara manual dengan workspace RAMUNI untuk penjualan, stok, keuangan, pelanggan, dan laporan." canonical="/compare/" schema={schema}>
  <div class="commercial-page" data-commercial-page="compare"><section class="commercial-hero"><div class="container commercial-hero__grid"><div><Breadcrumbs items={[{ label: 'Beranda', href: '/' }, { label: 'Compare' }]} /><p class="section-kicker">Perbandingan cara kerja</p><h1>Kurangi catatan yang tercecer tanpa mengganti semua alat Anda.</h1></div><div class="commercial-hero__aside"><p>RAMUNI menyatukan pekerjaan penting agar tim membaca data yang sama. Anda tetap bisa memakai tools lain yang memang dibutuhkan.</p><div class="button-row"><a class="button button--primary" href="/tour-produk-gratis/?flow=trial" data-analytics-event="free_trial_click" data-analytics-location="compare_hero" data-destination="tour">Lihat demo gratis</a><a class="button button--secondary" href="/pricing/">Bandingkan paket</a></div></div></div></section><CommercialProofShowcase id="compare-product-proof" eyebrow="Bukti alur" heading="Bandingkan pekerjaan yang selesai, bukan daftar fitur." body="Lihat bagaimana catatan, ringkasan, dan tindak lanjut disusun dalam satu alur yang bisa diperiksa." focus="overview" location="compare_product_proof" /><section class="commercial-section commercial-section--white"><div class="container"><div class="commercial-section__head"><div><p class="section-kicker">Perbandingan sederhana</p><h2>Yang berubah adalah cara tim menemukan dan membahas informasi.</h2></div><p>Gunakan tabel ini sebagai titik awal diskusi. Kebutuhan teknis tetap perlu diverifikasi sebelum memilih paket.</p></div><div class="compare-table-wrap"><table class="compare-table"><thead><tr><th>Cara manual</th><th>Dengan RAMUNI</th></tr></thead><tbody>{rows.map(([oldWay, ramuniWay]) => <tr><td>{oldWay}</td><td>{ramuniWay}</td></tr>)}</tbody></table></div></div></section><section class="commercial-section"><div class="container"><div class="commercial-cta"><div><p class="section-kicker">Lihat kecocokan</p><h2>Mulai dari pekerjaan yang ingin segera selesai.</h2><p>Tim RAMUNI dapat menunjukkan satu alur yang sesuai tanpa meminta data sensitif.</p></div><div class="commercial-cta__actions"><a class="button button--primary" href="/tour-produk-gratis/?flow=consultation" data-analytics-event="demo_request" data-analytics-location="compare_final" data-destination="tour">Lihat demo</a><a class="button button--secondary" href="/faq/">Baca FAQ</a></div></div></div></section></div><CommercialAnalytics />
</BaseLayout>

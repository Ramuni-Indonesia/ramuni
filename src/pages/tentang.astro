---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import '../styles/section-variance.css';

const principles = [
  ['Insight lebih dulu', 'Mulai dari arti bisnis, lalu buka angka pendukung.'],
  ['Rumus yang konsisten', 'Angka dasar dihitung dengan cara yang sama dan dapat diperiksa.'],
  ['Bukti terlihat', 'Periode, sumber, dan batas jawaban tidak disembunyikan.'],
  ['Manusia menyetujui', 'AI tidak mengambil alih keputusan atau aksi berisiko.'],
];
---
<BaseLayout title="Tentang RAMUNI" description="Misi, sudut pandang, prinsip produk, batas saat ini, dan cara RAMUNI memvalidasi kebutuhan UMKM Indonesia.">
  <PageHero eyebrow="Tentang RAMUNI" title="Bantu pemilik usaha memahami angka sebelum mengambil keputusan." description="Nama RAMUNI berasal dari Meramu Insight untuk Menavigasi Bisnis Indonesia. Kami membuat data usaha lebih mudah dibaca tanpa meminta Anda menjadi analis." primaryLabel="Coba Simulasi Gratis" primaryHref="/tour-produk-gratis" secondaryLabel="Pelajari Produk" secondaryHref="/produk" />

  <section class="section company-page__problem" id="masalah" aria-labelledby="problem-title">
    <div class="container company-page__editorial">
      <div class="company-page__heading reveal"><h2 id="problem-title">Banyak catatan belum tentu memberi arah.</h2></div>
      <div class="company-page__statement reveal"><p>Penjualan, stok, biaya, dan pelanggan sering hidup di tempat berbeda. Saat keputusan perlu dibuat, tim masih menyatukan konteks secara manual.</p><strong>RAMUNI berangkat dari kebutuhan untuk melihat arti di balik angka, bukan sekadar menambah dashboard.</strong></div>
    </div>
  </section>

  <section class="section dark-surface company-page__view" id="sudut-pandang" aria-labelledby="view-title">
    <div class="container company-page__view-layout">
      <div class="company-page__heading reveal"><p class="eyebrow">Sudut pandang</p><h2 id="view-title">Membantu, bukan mengambil alih.</h2><p>Teknologi harus membantu orang bertanya lebih baik, memeriksa bukti, dan memilih langkah yang masuk akal.</p></div>
      <div class="company-page__decision-map" aria-label="Cara RAMUNI mendukung keputusan"><article><span>Catatan</span><strong>Kumpulkan konteks yang tersebar.</strong></article><article><span>Pemeriksaan</span><strong>Buka angka di balik ringkasan.</strong></article><article><span>Keputusan</span><strong>Anda memilih langkah akhirnya.</strong></article></div>
      <blockquote class="company-page__quote reveal">“Pahami bisnis Anda. Tahu langkah berikutnya.”<cite>Pesan utama RAMUNI</cite></blockquote>
    </div>
  </section>

  <section class="section surface company-page__principles" id="prinsip-produk" aria-labelledby="product-principles-title">
    <div class="container">
      <div class="company-page__heading reveal"><h2 id="product-principles-title">Kejelasan dibangun dengan aturan yang konsisten.</h2></div>
      <ol class="company-page__principle-rail">{principles.map((item, index) => <li class="reveal"><span>{String(index + 1).padStart(2, '0')}</span><div class="company-page__principle-visual" aria-hidden="true"><i></i><i></i><i></i><i></i></div><strong>{item[0]}</strong><p>{item[1]}</p></li>)}</ol>
    </div>
  </section>

  <section class="section company-page__serve" id="untuk-siapa" aria-labelledby="serve-title">
    <div class="container company-page__split">
      <div class="company-page__heading reveal"><h2 id="serve-title">Dibuat dekat dengan ritme UMKM Indonesia.</h2><p>Bahasa, contoh, dan prioritas dimulai dari kebutuhan pemilik usaha dan tim operasional.</p></div>
      <dl class="company-page__boundary reveal">
        <div><dt>Yang kami bantu</dt><dd>Menyatukan konteks, membaca perubahan, dan menyiapkan pertanyaan tindak lanjut.</dd></div>
        <div><dt>Yang tidak kami janjikan</dt><dd>Keputusan otomatis, hasil bisnis tertentu, atau cakupan enterprise yang belum tersedia.</dd></div>
        <div><dt>Tahap saat ini</dt><dd>Tahap uji coba; kami masih mencocokkan fitur dengan kebutuhan usaha.</dd></div>
      </dl>
    </div>
  </section>

  <section class="section surface company-page__validation" id="cara-bekerja" aria-labelledby="validation-title">
    <div class="container company-page__split">
      <div class="company-page__heading reveal"><p class="eyebrow">Cara kami bekerja</p><h2 id="validation-title">Kami menguji sebelum menjanjikan.</h2><p>Informasi baru kami terbitkan setelah isi, tanggal, dan persetujuannya diperiksa.</p></div>
      <ol class="company-page__timeline">
        <li class="reveal"><span>01</span><div><strong>Dengar</strong><p>Pahami pekerjaan, keputusan, dan batas data pengguna.</p></div></li>
        <li class="reveal"><span>02</span><div><strong>Uji</strong><p>Gunakan contoh sintetis untuk memeriksa alur dan bahasa.</p></div></li>
        <li class="reveal"><span>03</span><div><strong>Verifikasi</strong><p>Cocokkan kemampuan dengan implementasi dan bukti rilis.</p></div></li>
        <li class="reveal"><span>04</span><div><strong>Publikasikan</strong><p>Sampaikan status dan batas dengan bahasa yang jujur.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section company-page__close"><div class="container company-page__closing reveal"><div><h2>Lihat apakah cara berpikir RAMUNI sesuai kebutuhan usaha Anda.</h2><p>Simulasi memakai data sintetis dan tidak membutuhkan data bisnis sensitif.</p></div><div class="button-row"><a class="button button--primary" href="/tour-produk-gratis">Coba Simulasi Gratis</a><a class="button button--secondary" href="https://wa.me/message/K35W6X6WT7YMJ1">Hubungi Kami</a></div></div></section>
</BaseLayout>

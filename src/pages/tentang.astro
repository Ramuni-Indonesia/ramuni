---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CommercialActionBar from '../components/CommercialActionBar.astro';
import CommercialProofShowcase from '../components/CommercialProofShowcase.astro';
import { releaseGates } from '../config/release';
import '../styles/section-variance.css';
import '../styles/other-pages-refinement.css';

const principles = [
  ['Insight lebih dulu', 'Mulai dari arti bisnis, lalu buka angka pendukung.'],
  ['Rumus yang konsisten', 'Angka dasar dihitung dengan cara yang sama dan dapat diperiksa.'],
  ['Bukti terlihat', 'Periode, sumber, dan alasan jawaban selalu dapat diperiksa.'],
  ['Manusia menyetujui', 'AI tidak mengambil alih keputusan atau aksi berisiko.'],
];

const dailyRhythm = [
  ['Sebelum mulai', 'Pemilik melihat stok, penjualan, dan pekerjaan yang perlu perhatian lebih dulu.'],
  ['Saat usaha berjalan', 'Tim mencatat perubahan tanpa kehilangan alasan di balik koreksi.'],
  ['Ketika mengevaluasi', 'Angka dibandingkan pada periode yang sama sebelum langkah berikutnya dipilih.'],
];

const mascotSrc = releaseGates.mascotExplorationEnabled
  ? '/website-original/ramuni-mascot-muni-manyar.webp'
  : '/website-original/ramuni-mascot-problem-section.webp';
---
<BaseLayout
  title="Tentang RAMUNI | AI Business Companion untuk UMKM"
  description="Kenali alasan RAMUNI dibangun, cara kami menyusun produk, dan bagaimana AI membantu pemilik UMKM membaca angka sebelum mengambil keputusan."
  pageType="AboutPage"
  schema={{
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://ramuni.id/#organization',
    name: 'RAMUNI',
    url: 'https://ramuni.id/',
    logo: 'https://ramuni.id/brand/ramuni-lockup-horizontal-color-tight.webp',
    description: 'AI Business Companion untuk membantu UMKM memahami bisnis dan menentukan perhatian berikutnya.',
  }}
>
  <PageHero eyebrow="Tentang RAMUNI" title="Kami membuat angka usaha lebih mudah dipahami." description="RAMUNI berarti Meramu Insight untuk Menavigasi Bisnis Indonesia. Kami membantu pemilik usaha membaca penjualan, stok, kas, dan pelanggan dengan bahasa yang dekat dengan pekerjaan sehari-hari." primaryLabel="Lihat Cara Kami Bekerja" primaryHref="#cara-bekerja" secondaryLabel="Lihat Produk" secondaryHref="/produk/" />

  <CommercialProofShowcase
    id="about-product-proof"
    eyebrow="Bukti di balik prinsip"
    heading="Prinsipnya terlihat dari cara workspace membaca perubahan."
    body="Kami tidak ingin halaman Tentang berhenti pada filosofi. Lihat bentuk produk yang menjadi dasar cara kerja RAMUNI."
    focus="overview"
    location="about_product_proof"
  />

  <section class="section company-story" id="masalah" aria-labelledby="story-title">
    <div class="container company-story__layout">
      <div class="company-story__copy reveal">
        <p class="eyebrow">Berangkat dari keseharian usaha</p>
        <h2 id="story-title">Banyak catatan belum tentu memberi arah.</h2>
        <p>Penjualan, stok, biaya, dan pelanggan sering berada di tempat berbeda. RAMUNI menyatukan catatan itu agar pemilik dan tim dapat melihat perubahan dari sumber yang sama.</p>
        <strong>Bukan menambah dashboard. Membantu orang memahami apa yang perlu diperiksa.</strong>
      </div>
      <figure class="company-story__scene reveal">
        <div class="company-story__scene-top"><span>Contoh ritme UMKM</span><small>Data tidak dikirim dari halaman ini</small></div>
        <ol>
          {dailyRhythm.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div><strong>{item[0]}</strong><p>{item[1]}</p></div>
            </li>
          ))}
        </ol>
        <img src={mascotSrc} width="720" height="720" alt="Maskot RAMUNI" aria-hidden="true" loading="lazy" decoding="async" />
        <figcaption>Bahasa, contoh, dan prioritas dimulai dari pekerjaan yang dekat dengan pemilik usaha dan tim operasional.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section company-focus" id="fokus-kami" aria-labelledby="focus-title">
    <div class="container company-focus__layout">
      <div class="company-page__heading reveal"><p class="eyebrow">Yang kami bangun</p><h2 id="focus-title">Satu ruang untuk pekerjaan yang berulang setiap hari.</h2><p>RAMUNI dimulai dari pekerjaan yang paling sering menyita waktu pemilik dan tim operasional.</p></div>
      <div class="company-focus__grid">
        <article class="reveal"><span>01</span><h3>Penjualan</h3><p>Lihat produk, waktu, kanal, dan transaksi yang mengubah omzet.</p><a href="/produk/penjualan/">Buka penjualan <b aria-hidden="true">↗</b></a></article>
        <article class="reveal"><span>02</span><h3>Stok</h3><p>Temukan SKU yang perlu dicek berdasarkan saldo dan laju keluar.</p><a href="/produk/inventori/">Buka inventori <b aria-hidden="true">↗</b></a></article>
        <article class="reveal"><span>03</span><h3>Keuangan</h3><p>Pisahkan omzet, biaya, laba, dan kas sebelum menilai kondisi usaha.</p><a href="/produk/keuangan/">Buka keuangan <b aria-hidden="true">↗</b></a></article>
        <article class="reveal"><span>04</span><h3>Pelanggan</h3><p>Baca riwayat dan pembelian berulang tanpa mengabaikan izin tindak lanjut.</p><a href="/produk/pelanggan/">Buka pelanggan <b aria-hidden="true">↗</b></a></article>
      </div>
    </div>
  </section>

  <section class="section dark-surface company-page__view" id="sudut-pandang" aria-labelledby="view-title">
    <div class="container company-page__view-layout">
      <div class="company-page__heading reveal"><p class="eyebrow">Sudut pandang</p><h2 id="view-title">Membantu, bukan mengambil alih.</h2><p>Teknologi harus membantu orang bertanya lebih baik, memeriksa bukti, dan memilih langkah yang masuk akal.</p></div>
      <div class="company-page__decision-map" aria-label="Cara RAMUNI mendukung keputusan"><article><span>Catatan</span><strong>Satukan data yang tersebar.</strong></article><article><span>Pemeriksaan</span><strong>Buka angka di balik ringkasan.</strong></article><article><span>Keputusan</span><strong>Anda memilih tindakan akhirnya.</strong></article></div>
      <blockquote class="company-page__quote reveal">“Pahami bisnis Anda. Ambil langkah dengan data.”<cite>Pesan utama RAMUNI</cite></blockquote>
    </div>
  </section>

  <section class="section surface company-page__principles" id="prinsip-produk" aria-labelledby="product-principles-title">
    <div class="container">
      <div class="company-page__heading reveal"><h2 id="product-principles-title">Kejelasan dibangun dengan aturan yang konsisten.</h2></div>
      <ol class="company-page__principle-rail">{principles.map((item, index) => <li class="reveal"><span>{String(index + 1).padStart(2, '0')}</span><div class="company-page__principle-visual" aria-hidden="true"><i></i><i></i><i></i><i></i></div><strong>{item[0]}</strong><p>{item[1]}</p></li>)}</ol>
    </div>
  </section>

  <section class="section surface company-page__validation" id="cara-bekerja" aria-labelledby="validation-title">
    <div class="container company-method">
      <div class="company-page__heading reveal"><p class="eyebrow">Cara kami bekerja</p><h2 id="validation-title">Kami uji alurnya sebelum menyebutnya siap.</h2><p>Setiap informasi kami susun, tinjau, dan perbarui agar pemilik usaha bisa langsung memahami langkahnya.</p></div>
      <div class="company-method__body">
        <ol class="company-page__timeline">
          <li class="reveal"><span>01</span><div><strong>Dengar</strong><p>Pahami pekerjaan, keputusan, dan kualitas data yang digunakan.</p></div></li>
          <li class="reveal"><span>02</span><div><strong>Tinjau</strong><p>Gunakan skenario yang jelas untuk memeriksa alur dan bahasa.</p></div></li>
          <li class="reveal"><span>03</span><div><strong>Verifikasi</strong><p>Pastikan setiap manfaat dapat ditelusuri pada cara kerja produk.</p></div></li>
          <li class="reveal"><span>04</span><div><strong>Publikasikan</strong><p>Sampaikan cara kerja dengan bahasa yang jelas dan mudah diterapkan.</p></div></li>
        </ol>
        <aside class="company-method__boundary reveal" aria-label="Peran RAMUNI dan pengguna">
          <span>Peran Anda</span>
          <h3>Keputusan tetap di tangan Anda.</h3>
          <p>RAMUNI membantu menyatukan data, membaca perubahan, dan menyiapkan pertanyaan tindak lanjut.</p>
          <p>Anda melihat alasan dan sumbernya, lalu menentukan tindakan yang paling sesuai untuk usaha.</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section company-page__status" id="status-produk" aria-labelledby="status-title">
    <div class="container company-status-grid">
      <div><p class="eyebrow">Transparansi produk</p><h2 id="status-title">Yang sudah tersedia, dan yang kami sempurnakan berikutnya.</h2><p>Setiap fitur yang ditampilkan memiliki alur, akses, dan batas penggunaan yang dapat diperiksa.</p></div>
      <div class="company-status-columns"><div><span>Dapat digunakan sekarang</span><ul><li>Workspace penjualan, stok, kas, pelanggan, dan laporan.</li><li>AI Copilot, Knowledge OS, Web Builder, dan alur pelanggan.</li><li>Jalur demo, trial, serta formulir kontak yang masuk ke CRM.</li></ul></div><div><span>Penyempurnaan roadmap</span><ul><li>Kolaborasi tim, integrasi, dan kontrol laporan yang lebih dalam.</li><li>Penguatan performa, ekspor, dan pengaturan workspace.</li><li>Urutan pengerjaan dapat dilihat di halaman roadmap publik.</li></ul></div></div>
    </div>
  </section>

  <div class="container"><CommercialActionBar pageType="about" location="about_close" eyebrow="Kenali cara kerja kami" title="Lihat demo, pricing, atau bahas kebutuhan usaha Anda." body="Kami menunjukkan alur yang relevan tanpa meminta data bisnis sensitif sebelum Anda memilih cara mulai." /></div>
</BaseLayout>

<style>
  .company-story{overflow:hidden}
  .company-story__layout{display:grid;grid-template-columns:minmax(0,.76fr) minmax(520px,1.24fr);gap:clamp(42px,7vw,104px);align-items:center}
  .company-story__copy{display:grid;gap:22px;min-width:0}
  .company-story__copy .eyebrow{margin:0;color:var(--teal)}
  .company-story__copy h2{max-width:13ch}
  .company-story__copy>p:not(.eyebrow){max-width:46ch;color:var(--ink-72);font-size:1.05rem;line-height:1.7}
  .company-story__copy>strong{max-width:25ch;padding-top:22px;border-top:1px solid var(--ink);font-size:clamp(1.22rem,2vw,1.72rem);line-height:1.32}
  .company-story__scene{position:relative;min-width:0;margin:0;padding:24px 24px 116px;border:1px solid var(--ink);background:var(--rice);box-shadow:14px 14px 0 var(--yellow);overflow:hidden;isolation:isolate}
  .company-story__scene::before{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(var(--ink-10) 1px,transparent 1px),linear-gradient(90deg,var(--ink-10) 1px,transparent 1px);background-size:44px 44px;opacity:.45}
  .company-story__scene-top{display:flex;justify-content:space-between;gap:18px;padding-bottom:18px;border-bottom:1px solid var(--ink)}
  .company-story__scene-top span{color:var(--teal);font-size:.7rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .company-story__scene-top small{color:var(--ink-56);font-size:.68rem;text-align:right}
  .company-story__scene ol{position:relative;z-index:1;display:grid;gap:10px;list-style:none;margin:22px 0 0;padding:0;width:min(78%,510px)}
  .company-story__scene li{display:grid;grid-template-columns:38px minmax(0,1fr);gap:14px;padding:16px 18px;border:1px solid var(--ink);background:rgb(255 255 255/.94)}
  .company-story__scene li:nth-child(2){margin-left:8%;background:var(--yellow)}
  .company-story__scene li:nth-child(3){margin-left:16%;background:var(--ink);color:var(--white)}
  .company-story__scene li>span{color:var(--teal);font-size:.68rem;font-weight:800}
  .company-story__scene li:nth-child(3)>span{color:var(--yellow)}
  .company-story__scene li strong{font-size:.92rem}
  .company-story__scene li p{margin-top:5px;color:var(--ink-72);font-size:.78rem;line-height:1.45}
  .company-story__scene li:nth-child(3) p{color:rgb(255 255 255/.72)}
  .company-story__scene img{position:absolute;z-index:0;right:-50px;bottom:22px;width:250px;height:250px;object-fit:contain;filter:drop-shadow(0 18px 20px rgb(11 48 69/.18));pointer-events:none}
  .company-story__scene figcaption{position:absolute;z-index:2;left:24px;right:24px;bottom:22px;max-width:52ch;padding:13px 15px;background:var(--teal);color:var(--white);font-size:.76rem;line-height:1.5}
  .company-method{display:grid;gap:clamp(38px,6vw,72px)}
  .company-method>.company-page__heading{max-width:760px}
  .company-method__body{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(300px,.65fr);gap:clamp(24px,5vw,68px);align-items:start}
  .company-method__body .company-page__timeline{margin-top:0}
  .company-method__boundary{position:sticky;top:112px;display:grid;gap:15px;padding:28px;border:1px solid var(--ink);background:var(--ink);color:var(--white);box-shadow:10px 10px 0 var(--yellow)}
  .company-method__boundary>span{color:var(--yellow);font-size:.7rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .company-method__boundary h3{font-size:clamp(1.35rem,2.5vw,2rem);line-height:1.15}
  .company-method__boundary p{color:rgb(255 255 255/.72);font-size:.9rem;line-height:1.55}
  .company-page__view-layout{display:grid;grid-template-columns:minmax(0,.92fr) minmax(360px,1.08fr);gap:clamp(34px,6vw,82px);align-items:start}
  .company-page__view-layout .company-page__heading{max-width:620px}
  .company-page__decision-map{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:0;background:transparent;border:0}
  .company-page__decision-map article{min-width:0;min-height:clamp(168px,18vw,230px);margin-top:0!important;padding:clamp(20px,3vw,28px);border:1px solid rgb(255 255 255/.2)}
  .company-page__decision-map strong{max-width:14ch;overflow-wrap:anywhere;font-size:clamp(1.2rem,2vw,2rem)}
  .company-page__quote{grid-column:1/-1;max-width:min(100%,15ch);margin:clamp(34px,6vw,72px) 0 0 auto;font-size:clamp(2rem,5vw,4.2rem);text-wrap:balance}
  @media(max-width:1080px){
    .company-story__layout,.company-method__body,.company-page__view-layout{grid-template-columns:1fr}
    .company-story__scene{width:min(780px,100%)}
    .company-page__decision-map{grid-template-columns:repeat(3,minmax(0,1fr));margin-top:clamp(18px,4vw,34px)}
    .company-page__quote{margin-left:0;text-align:left}
    .company-method__boundary{position:static;grid-template-columns:minmax(180px,.5fr) 1fr;align-items:start}
    .company-method__boundary>span,.company-method__boundary h3{grid-column:1}
    .company-method__boundary p{grid-column:2}
  }
  @media(max-width:820px){
    .company-page__decision-map{grid-template-columns:1fr}
    .company-page__decision-map article{min-height:0}
    .company-page__decision-map strong{max-width:24ch}
  }
  @media(max-width:680px){
    .company-story__copy h2{max-width:100%}
    .company-story__scene{padding:18px 18px 174px;box-shadow:8px 8px 0 var(--yellow)}
    .company-story__scene-top{display:grid}
    .company-story__scene-top small{text-align:left}
    .company-story__scene ol{width:100%}
    .company-story__scene li:nth-child(n){margin-left:0;padding:14px}
    .company-story__scene img{right:-34px;bottom:34px;width:178px;height:178px;opacity:.82}
    .company-story__scene figcaption{left:18px;right:18px;bottom:18px;max-width:calc(100% - 112px)}
    .company-method__boundary{grid-template-columns:1fr;box-shadow:7px 7px 0 var(--yellow)}
    .company-method__boundary>span,.company-method__boundary h3,.company-method__boundary p{grid-column:auto}
  }
  .company-page__status{background:var(--white)}.company-status-grid{display:grid;grid-template-columns:minmax(0,.78fr) minmax(0,1.22fr);gap:clamp(38px,8vw,110px);align-items:start}.company-status-grid>div:first-child p:last-child{max-width:48ch;margin-top:18px;color:var(--ink-72)}.company-status-columns{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.company-status-columns>div{padding:22px;border:1px solid var(--ink-20);background:var(--rice)}.company-status-columns span{display:block;color:var(--teal);font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.company-status-columns ul{display:grid;gap:10px;margin:18px 0 0;padding:0;list-style:none}.company-status-columns li{padding-left:15px;position:relative;color:var(--ink-72);font-size:.82rem;line-height:1.5}.company-status-columns li::before{content:'·';position:absolute;left:0;color:var(--teal);font-weight:800}.company-page__status .money-action-bar{margin-bottom:0}
  .company-focus{background:var(--white)}.company-focus__layout{display:grid;grid-template-columns:minmax(0,.72fr) minmax(0,1.28fr);gap:clamp(38px,8vw,108px);align-items:start}.company-focus__layout>.company-page__heading{position:sticky;top:110px}.company-focus__layout>.company-page__heading>p:last-child{max-width:42ch;margin-top:18px;color:var(--ink-72)}.company-focus__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--ink-10)}.company-focus__grid article{display:grid;align-content:start;min-height:230px;padding:24px;background:var(--rice)}.company-focus__grid article>span{color:var(--teal);font-size:.68rem;font-weight:800}.company-focus__grid h3{margin-top:38px;font-size:1.2rem}.company-focus__grid p{margin-top:10px;color:var(--ink-72);font-size:.82rem;line-height:1.5}.company-focus__grid a{margin-top:auto;padding-top:20px;color:var(--teal);font-size:.76rem;font-weight:800;text-decoration:none}.company-focus__grid a b{margin-left:4px}
  @media(max-width:1080px){.company-focus__layout{grid-template-columns:1fr}.company-focus__layout>.company-page__heading{position:static}}
  @media(max-width:760px){.company-status-grid,.company-status-columns,.company-focus__grid{grid-template-columns:1fr}}
  @media(prefers-reduced-motion:reduce){.company-story__scene img{animation:none}}
</style>

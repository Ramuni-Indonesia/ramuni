---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MascotDecisionCTA from '../../components/MascotDecisionCTA.astro';
import PageHero from '../../components/PageHero.astro';
import ProductScreenshotRail from '../../components/ProductScreenshotRail.astro';
import { industries, products, roles } from '../../data/site';
import { getRoleDriveVisuals, toProductScreen } from '../../data/driveVisuals';
import { releaseGates } from '../../config/release';
import { pageLastmods } from '../../data/pageLastmods';
import '../../styles/role-detail.css';

const roleContext: Record<string, {
  workflow: string[];
  permissions: { action: string; status: string }[];
  alerts: string[];
  questions: string[];
  collaboration: string[];
  collaborationNotes: string[];
  success: string[];
  aiBoundary: string[];
  faq: { question: string; answer: string }[];
  industrySlugs: string[];
  headings: { responsibility: string; priorities: string; workflow: string; permissions: string; collaboration: string; success: string; related: string; closing: string };
}> = {
  'pemilik-usaha': {
    workflow: ['Baca ringkasan lintas modul', 'Telusuri perubahan yang paling penting', 'Tinjau permintaan atau pengecualian tim', 'Tentukan keputusan dan penanggung jawab'],
    permissions: [{ action: 'Lihat data', status: 'Lintas modul sesuai akun' }, { action: 'Buat dan edit', status: 'Sesuai kebijakan' }, { action: 'Setujui', status: 'Sesuai izin akun' }, { action: 'Ekspor', status: 'Sesuai izin akun' }, { action: 'Tagihan', status: 'Kelola' }],
    alerts: ['Perubahan omzet atau kas', 'Stok yang perlu pemeriksaan', 'Masalah operasional yang belum selesai'],
    questions: ['Apa yang perlu saya perhatikan hari ini?', 'Mengapa kas berubah dibanding periode lalu?', 'Masalah mana yang belum ditindaklanjuti?'],
    collaboration: ['Mengatur akses tim', 'Menerima ringkasan dari supervisor', 'Menetapkan keputusan dan penanggung jawab'],
    collaborationNotes: ['Pastikan setiap peran hanya melihat data yang dibutuhkan.', 'Baca masalah bersama bukti yang sudah dikumpulkan.', 'Tentukan siapa yang menindaklanjuti.'],
    success: ['Ringkasan tiba tepat waktu', 'Definisi angka konsisten', 'Tindak lanjut memiliki pemilik'],
    aiBoundary: ['AI merangkum, bukan menyetujui keputusan.', 'Perubahan akses dan tagihan tetap dilakukan pemilik.', 'Setiap saran perlu ditelusuri ke angka pendukung.'],
    faq: [
      { question: 'Apakah pemilik dapat melihat semua aktivitas tim?', answer: 'Hanya aktivitas yang tersedia dalam cakupan akun dan jejak yang sudah diterapkan.' },
      { question: 'Apakah AI dapat menyetujui perubahan penting?', answer: 'Tidak. Persetujuan akses, tagihan, harga, dan tindakan berisiko tetap berada pada manusia.' },
    ],
    industrySlugs: ['retail', 'distributor', 'jasa'],
    headings: { responsibility: 'Tahu mana yang membutuhkan keputusan hari ini.', priorities: 'Ringkasan pertama menjawab tiga pertanyaan pemilik.', workflow: 'Mulai dari perubahan, lalu tetapkan orang yang menindaklanjuti.', permissions: 'Kendali akun tetap berada pada pemilik.', collaboration: 'Keputusan sampai ke tim tanpa kehilangan alasan.', success: 'Hari kerja lebih jelas ketika setiap tindak lanjut punya pemilik.', related: 'Pilih modul dan contoh usaha yang paling dekat.', closing: 'Lihat ringkasan yang dirancang untuk pemilik usaha.' },
  },
  'admin-toko': {
    workflow: ['Cek tugas data yang belum lengkap', 'Rapikan produk, pelanggan, transaksi, atau biaya', 'Koreksi sesuai akses dengan jejak', 'Teruskan pengecualian yang perlu persetujuan'],
    permissions: [{ action: 'Lihat data', status: 'Operasional sesuai cakupan' }, { action: 'Buat dan edit', status: 'Sesuai akses' }, { action: 'Setujui', status: 'Mengikuti pemilik' }, { action: 'Ekspor', status: 'Jika diizinkan' }, { action: 'Tagihan', status: 'Dikelola pemilik' }],
    alerts: ['Data wajib belum lengkap', 'Impor atau sinkronisasi perlu perhatian', 'Koreksi menunggu persetujuan'],
    questions: ['Data apa yang belum lengkap?', 'Transaksi mana yang perlu diperiksa ulang?', 'Produk mana yang tidak punya unit konsisten?'],
    collaboration: ['Menjaga data operasional', 'Meminta persetujuan saat diperlukan', 'Memberi dasar kepada supervisor dan pemilik'],
    collaborationNotes: ['Rapikan data yang paling sering dipakai tim.', 'Kirim koreksi beserta catatannya.', 'Jelaskan masalah tanpa menghilangkan riwayat perubahan.'],
    success: ['Duplikasi berkurang', 'Koreksi memiliki jejak', 'Tugas data selesai tepat waktu'],
    aiBoundary: ['AI menunjukkan data yang perlu dicek ulang.', 'Koreksi tetap mengikuti izin dan jejak perubahan.', 'Masalah akses diteruskan ke pemilik atau supervisor.'],
    faq: [
      { question: 'Apakah admin boleh mengubah semua data?', answer: 'Tidak. Jenis perubahan mengikuti izin, dan koreksi penting perlu jejak atau persetujuan.' },
      { question: 'Apa yang dilakukan saat impor tidak cocok?', answer: 'Hentikan proses, periksa pemetaan kolom, lalu teruskan masalah tanpa menimpa data yang benar.' },
    ],
    industrySlugs: ['retail', 'fnb', 'reseller-online'],
    headings: { responsibility: 'Data rapi sebelum masuk laporan.', priorities: 'Tugas yang belum lengkap muncul lebih dulu.', workflow: 'Rapikan, koreksi, lalu teruskan yang butuh persetujuan.', permissions: 'Admin bekerja luas tanpa mengambil alih keputusan pemilik.', collaboration: 'Koreksi bergerak bersama catatannya.', success: 'Pekerjaan admin selesai saat tim memakai data yang sama.', related: 'Buka modul yang paling sering dirawat admin.', closing: 'Lihat contoh alur admin tanpa memakai data usaha asli.' },
  },
  kasir: {
    workflow: ['Mulai transaksi yang diizinkan', 'Periksa item dan status pembayaran', 'Selesaikan transaksi', 'Gunakan panduan pemulihan jika alur gagal'],
    permissions: [{ action: 'Lihat data', status: 'Transaksi yang relevan' }, { action: 'Buat dan edit', status: 'Transaksi aktif sesuai izin' }, { action: 'Setujui', status: 'Diteruskan ke atasan' }, { action: 'Ekspor', status: 'Diteruskan ke admin' }, { action: 'Tagihan', status: 'Dikelola pemilik' }],
    alerts: ['Pembayaran belum jelas', 'Transaksi gagal disimpan', 'Perlu bantuan admin atau supervisor'],
    questions: ['Apa langkah pemulihan transaksi ini?', 'Apakah pembayaran sudah tercatat?', 'Siapa yang perlu membantu koreksi?'],
    collaboration: ['Mencatat transaksi', 'Meneruskan masalah dengan detail', 'Mengikuti koreksi dari admin atau supervisor'],
    collaborationNotes: ['Pastikan item dan pembayaran tercatat dengan jelas.', 'Teruskan transaksi gagal tanpa mengulang input.', 'Ikuti koreksi yang sudah disetujui.'],
    success: ['Transaksi selesai tanpa duplikasi', 'Status pembayaran jelas', 'Masalah cepat diteruskan'],
    aiBoundary: ['AI tidak mengubah pembayaran atau transaksi.', 'Transaksi gagal tidak boleh dikirim ulang tanpa pemeriksaan.', 'Koreksi diteruskan ke admin atau supervisor.'],
    faq: [
      { question: 'Apa yang dilakukan jika transaksi gagal disimpan?', answer: 'Jangan mengulang pembayaran. Simpan konteks kegagalan dan minta admin atau supervisor memeriksa statusnya.' },
      { question: 'Apakah kasir dapat mengubah transaksi selesai?', answer: 'Tidak secara bebas. Koreksi mengikuti izin dan jalur persetujuan yang tersedia.' },
    ],
    industrySlugs: ['retail', 'fnb', 'reseller-online'],
    headings: { responsibility: 'Transaksi selesai tanpa input ulang.', priorities: 'Layar kasir fokus pada transaksi yang sedang dikerjakan.', workflow: 'Selesaikan transaksi. Jika gagal, teruskan tanpa mengulang dari awal.', permissions: 'Kasir melihat yang dibutuhkan untuk melayani pembeli.', collaboration: 'Masalah sampai ke admin bersama detail transaksi.', success: 'Kasir berhasil ketika pembayaran jelas dan antrean tetap bergerak.', related: 'Lihat modul yang mendukung alur transaksi harian.', closing: 'Lihat contoh transaksi dan jalur pemulihannya.' },
  },
  supervisor: {
    workflow: ['Baca daftar pengecualian', 'Bandingkan periode dan aktivitas tim', 'Tinjau alasan masalah', 'Teruskan keputusan yang memerlukan pemilik'],
    permissions: [{ action: 'Lihat data', status: 'Operasional lintas tim' }, { action: 'Buat dan edit', status: 'Sesuai kebijakan' }, { action: 'Setujui', status: 'Sesuai akses' }, { action: 'Ekspor', status: 'Jika diizinkan' }, { action: 'Tagihan', status: 'Dikelola pemilik' }],
    alerts: ['Masalah operasional', 'Laporan periode belum selesai', 'Tindak lanjut tim melewati waktu'],
    questions: ['Masalah mana yang berulang?', 'Tim mana yang perlu data tambahan?', 'Apa yang harus dibawa ke pemilik?'],
    collaboration: ['Meninjau pekerjaan tim', 'Menghubungkan masalah dengan bukti', 'Meneruskan keputusan kepada pemilik'],
    collaborationNotes: ['Periksa pekerjaan yang belum selesai.', 'Bawa masalah dan bukti ke pemilik.', 'Catat keputusan agar tim menerima arah yang sama.'],
    success: ['Pengecualian terlihat lebih cepat', 'Tindak lanjut tidak hilang', 'Laporan memakai definisi yang sama'],
    aiBoundary: ['AI membantu mengelompokkan masalah berulang.', 'Eskalasi tetap dibuat supervisor berdasarkan bukti.', 'Keputusan pemilik tidak digantikan oleh ringkasan AI.'],
    faq: [
      { question: 'Masalah apa yang perlu diteruskan ke pemilik?', answer: 'Teruskan masalah yang berdampak pada uang, akses, kebijakan, atau keputusan di luar izin supervisor.' },
      { question: 'Apakah supervisor dapat melihat semua data akun?', answer: 'Tidak otomatis. Cakupan tampilan mengikuti kebutuhan kerja dan akses yang diberikan.' },
    ],
    industrySlugs: ['retail', 'distributor', 'manufaktur-kecil'],
    headings: { responsibility: 'Masalah berulang terlihat sebelum menumpuk.', priorities: 'Pengecualian datang lebih dulu daripada aktivitas normal.', workflow: 'Tinjau masalah, kumpulkan alasan, lalu eskalasi bila perlu.', permissions: 'Supervisor meninjau operasi tanpa mengelola tagihan.', collaboration: 'Pemilik menerima masalah yang sudah disertai dasar.', success: 'Supervisor berhasil saat masalah tidak hilang di pergantian tim.', related: 'Pilih modul dan industri dengan banyak koordinasi tim.', closing: 'Lihat contoh alur supervisor dari masalah sampai tindak lanjut.' },
  },
};

export function getStaticPaths() {
  return roles.map((role) => ({ params: { slug: role.slug }, props: { role } }));
}

const { role } = Astro.props;
const context = roleContext[role.slug];
const roleSeo: Record<string, { title: string; description: string }> = {
  'pemilik-usaha': { title: 'Dashboard untuk Pemilik Usaha | RAMUNI', description: 'Bantu pemilik UMKM membaca perubahan penjualan, stok, kas, dan pekerjaan tim sebelum menentukan prioritas serta penanggung jawab.' },
  'admin-toko': { title: 'Sistem Kerja Admin Toko UMKM | RAMUNI', description: 'Bantu admin toko merapikan produk, pelanggan, transaksi, biaya, dan koreksi sesuai akses dengan jejak yang dapat diperiksa.' },
  kasir: { title: 'Aplikasi Kasir dengan Alur Aman | RAMUNI', description: 'Bantu kasir menyelesaikan transaksi, memeriksa status pembayaran, dan meneruskan masalah tanpa mengulang input atau mengambil akses lain.' },
  supervisor: { title: 'Dashboard Supervisor Operasional | RAMUNI', description: 'Bantu supervisor UMKM melihat masalah berulang, meninjau laporan, dan meneruskan keputusan kepada pemilik bersama bukti pendukung.' },
};
const seo = roleSeo[role.slug] || { title: `RAMUNI untuk ${role.title}`, description: role.summary };
const roleHeroTitles: Record<string, string> = {
  'pemilik-usaha': 'Tahu mana yang membutuhkan keputusan hari ini.',
  'admin-toko': 'Rapikan input, koreksi, dan handoff tanpa kehilangan jejak.',
  kasir: 'Selesaikan transaksi dan pulihkan error tanpa input ulang.',
  supervisor: 'Lihat pengecualian, approval, dan tindak lanjut per shift.',
};
const canonicalPath = `/untuk/${role.slug}/`;
const roleIntentBySlug: Record<string, string> = {
  'pemilik-usaha': 'overview',
  'admin-toko': 'catalog',
  kasir: 'sales',
  supervisor: 'report',
};
const roleConsultationHref = `/tour-produk-gratis/?flow=consultation&intent=${roleIntentBySlug[role.slug] || 'overview'}`;
const relevantProducts = products.filter((product) => product.roles.includes(role.title)).slice(0, 4);
const relatedIndustries = industries.filter((industry) => context.industrySlugs.includes(industry.slug));
const roleDriveSet = getRoleDriveVisuals(role.slug);
const roleScreens = [roleDriveSet.primary, ...roleDriveSet.supporting.slice(0, 1)].map(toProductScreen);
const roleHelpLinks: Record<string, { label: string; href: string }[]> = {
  'pemilik-usaha': [
    { label: 'Atur akses tim', href: '/keamanan/' },
    { label: 'Siapkan pertanyaan sebelum mencoba', href: '/panduan/' },
  ],
  'admin-toko': [
    { label: 'Panduan merapikan data awal', href: '/panduan/' },
    { label: 'Sampaikan kendala impor ke dukungan', href: '/kontak/' },
  ],
  kasir: [
    { label: 'Cari langkah pemulihan transaksi', href: '/bantuan/' },
    { label: 'Minta akses melalui Pemilik Usaha', href: '/untuk/pemilik-usaha/' },
  ],
  supervisor: [
    { label: 'Panduan membaca tindak lanjut tim', href: '/panduan/' },
    { label: 'Periksa status layanan', href: '/status/' },
  ],
};
const closingLinks = role.slug === 'kasir'
  ? [
      { label: 'Buka Pusat Bantuan', href: '/bantuan/', className: 'button button--primary' },
      { label: 'Lihat Peran Pemilik', href: '/untuk/pemilik-usaha/', className: 'button button--secondary' },
    ]
  : [
      { label: role.ctaLabel, href: role.ctaHref, className: 'button button--primary' },
      { label: 'Bahas kebutuhan', href: roleConsultationHref, className: 'button button--secondary' },
    ];
const roleUrl = new URL(canonicalPath, Astro.site || Astro.url.origin).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': roleUrl,
  url: roleUrl,
  name: seo.title,
  description: seo.description,
  dateModified: pageLastmods.role,
  inLanguage: 'id-ID',
};
---
<BaseLayout title={seo.title} description={seo.description} canonical={canonicalPath} noindex={!releaseGates.claimPagesIndexable} schema={structuredData}>
  <div class="container audience-breadcrumb"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Beranda</a><span aria-hidden="true">/</span><a href="/untuk/">Untuk Tim</a><span aria-hidden="true">/</span><span aria-current="page">{role.title}</span></nav></div>
  <PageHero compact eyebrow={`Untuk ${role.title}`} title={roleHeroTitles[role.slug] || role.summary} description={role.summary} primaryLabel={role.ctaLabel} primaryHref={role.ctaHref} secondaryLabel="Semua Peran" secondaryHref="/untuk/" />

  <ProductScreenshotRail
    id={`role-${role.slug}-screens`}
    eyebrow="Tampilan produk"
    heading={`Layar untuk pekerjaan ${role.title}.`}
    body="Capture workspace RAMUNI memakai data demo terkontrol. Lihat bukti visual sebelum membahas akses dan alur kerja."
    items={roleScreens}
    compact
  />

  <section class="section surface role-detail-permission" id="izin" aria-labelledby="permission-title">
    <div class="container">
      <div class="role-detail-section-head reveal"><div><p class="eyebrow">Akses dan tindakan</p><h2 id="permission-title">{context.headings.permissions}</h2></div><p class="lede">{role.permissions}</p></div>
      <div class="role-detail-permission__layout">
        <dl class="role-detail-permission__table reveal">{context.permissions.map((item) => <div><dt>{item.action}</dt><dd>{item.status}</dd></div>)}</dl>
        <aside class="role-detail-priorities reveal"><strong>Yang muncul lebih dulu</strong><ul>{role.priorities.map((priority) => <li>{priority}</li>)}</ul><p>Informasi lain tetap dapat dibuka saat dibutuhkan.</p></aside>
      </div>
    </div>
  </section>

  <section class="section dark-surface role-detail-exception" id="pengecualian" aria-labelledby="exception-title">
    <div class="container">
      <div class="role-detail-section-head reveal"><div><p class="eyebrow">Pengecualian dan handoff</p><h2 id="exception-title">{context.headings.workflow}</h2></div><p class="lede">{context.headings.success}</p></div>
      <ol class="role-detail-flow reveal">{context.workflow.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><p>{step}</p></li>)}</ol>
      <div class="role-detail-signals">
        <article class="reveal"><span>Peringatan</span><ul>{context.alerts.map((item) => <li>{item}</li>)}</ul></article>
        <article class="reveal"><span>Pertanyaan</span><ul>{context.questions.map((item) => <li>{item}</li>)}</ul></article>
        <article class="reveal"><span>Handoff</span><ul>{context.collaboration.map((item, index) => <li>{item}<small>{context.collaborationNotes[index]}</small></li>)}</ul></article>
      </div>
      <div class="role-detail-ai reveal"><strong>Peran AI</strong><p>{context.aiBoundary.join(' ')}</p></div>
      <div class="role-detail-links reveal">
        <div><strong>Modul yang relevan</strong>{relevantProducts.map((product) => <a href={'/produk/' + product.slug + '/'}>{product.title}</a>)}</div>
        <div><strong>Industri terkait</strong>{relatedIndustries.map((industry) => <a href={'/industri/' + industry.slug + '/'}>{industry.title}</a>)}</div>
        <div><strong>Panduan</strong>{roleHelpLinks[role.slug].map((link) => <a href={link.href}>{link.label}</a>)}</div>
      </div>
    </div>
  </section>

  <section class="section surface role-detail-close" id="faq" aria-labelledby="faq-title">
    <div class="container role-detail-close__layout">
      <div class="role-detail-faq reveal"><p class="eyebrow">Pertanyaan umum</p><h2 id="faq-title">Pertanyaan tentang akses {role.title}.</h2><div class="faq-list">{context.faq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></div>
      <div class="role-detail-close__cta reveal">
      <MascotDecisionCTA
        headingId="role-cta-title"
        eyebrow={'Langkah berikutnya untuk ' + role.title}
        title={context.headings.closing}
        body="Lihat contoh pekerjaan untuk peran ini, periksa sumbernya, lalu bahas langkah yang dapat diterapkan di usaha Anda."
        primaryLabel={closingLinks[0]?.label}
        primaryHref={closingLinks[0]?.href}
        secondaryLabel={closingLinks[1]?.label}
        secondaryHref={closingLinks[1]?.href}
        theme="yellow"
        mascot="guide3d"
      />
      </div>
    </div>
  </section>
</BaseLayout>

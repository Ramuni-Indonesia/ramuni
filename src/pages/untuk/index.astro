---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AudienceContextBoard from '../../components/AudienceContextBoard.astro';
import ProductScreenshotRail from '../../components/ProductScreenshotRail.astro';
import TourEvidenceCTA from '../../components/TourEvidenceCTA.astro';
import { roles } from '../../data/site';
import { getRoleDriveVisuals, toProductScreen } from '../../data/driveVisuals';
import { editorialLeadPhotos } from '../../data/editorialVisuals';
import '../../styles/role-hub.css';

const roleViews: Record<string, { lens: string; primary: string; handoff: string; proof: string; ai: string; industries: string[]; products: string[] }> = {
  'pemilik-usaha': { lens: 'Kesehatan bisnis', primary: 'Melihat perubahan omzet, kas, stok, dan tim dari satu layar.', handoff: 'Memberi persetujuan setelah alasan dan bukti terlihat.', proof: 'Periode, sumber data, dan pemilik tindak lanjut.', ai: 'AI merangkum dan memberi pertanyaan lanjutan. Keputusan tetap di pemilik.', industries: ['retail', 'distributor', 'jasa'], products: ['dashboard-bisnis', 'laporan-insight', 'asisten-ai'] },
  'admin-toko': { lens: 'Kerapian data', primary: 'Menjaga produk, pelanggan, transaksi, dan biaya tetap rapi.', handoff: 'Mengirim koreksi yang sudah punya jejak dan alasan.', proof: 'Baris gagal, perubahan data, dan status sinkronisasi.', ai: 'AI menjelaskan anomali data sesuai akses admin, bukan menyetujui perubahan.', industries: ['retail', 'fnb', 'reseller-online'], products: ['katalog-produk', 'penjualan', 'integrasi'] },
  kasir: { lens: 'Transaksi berjalan', primary: 'Menyelesaikan penjualan yang diizinkan tanpa membuka area sensitif.', handoff: 'Minta bantuan dengan detail transaksi yang jelas.', proof: 'Status pembayaran, waktu transaksi, dan catatan pemulihan.', ai: 'AI membantu membaca instruksi dan pengecualian, bukan menjalankan refund otomatis.', industries: ['retail', 'fnb', 'reseller-online'], products: ['penjualan', 'katalog-produk', 'dashboard-bisnis'] },
  supervisor: { lens: 'Pengecualian operasi', primary: 'Melihat masalah harian sebelum menumpuk di akhir periode.', handoff: 'Meneruskan masalah ke pemilik dengan konteks lengkap.', proof: 'Daftar pengecualian, periode laporan, dan status tindak lanjut.', ai: 'AI menyusun ringkasan masalah sesuai izin, tanpa membuka tagihan.', industries: ['retail', 'distributor', 'manufaktur-kecil'], products: ['dashboard-bisnis', 'inventori', 'laporan-insight'] },
};
const roleHubCtas: Record<string, string> = {
  'pemilik-usaha': 'Lihat kontrol usaha',
  'admin-toko': 'Lihat alur input dan koreksi',
  kasir: 'Lihat mode kerja kasir',
  supervisor: 'Lihat laporan dan approval',
};
const visibility = [
  { area: 'Ringkasan bisnis', owner: 'Penuh', admin: 'Operasional', cashier: 'Transaksi sendiri', supervisor: 'Operasional' },
  { area: 'Koreksi data', owner: 'Sesuai kebijakan', admin: 'Sesuai cakupan', cashier: 'Minta bantuan', supervisor: 'Tinjau' },
  { area: 'Persetujuan & ekspor', owner: 'Atur dan setujui', admin: 'Jika diizinkan', cashier: 'Diteruskan ke admin', supervisor: 'Sesuai kebijakan' },
  { area: 'Tagihan', owner: 'Kelola', admin: 'Dikelola pemilik', cashier: 'Dikelola pemilik', supervisor: 'Dikelola pemilik' },
];
const collaborationFlow = [
  { label: 'Catat', text: 'Tim mengerjakan aktivitas yang sesuai izin.' },
  { label: 'Tinjau', text: 'Pengecualian muncul bersama periode dan sumber data.' },
  { label: 'Putuskan', text: 'Orang yang berwenang memilih tindak lanjut.' },
  { label: 'Pantau', text: 'Status terlihat lagi oleh tim yang perlu tahu.' },
];
const roleContextPanes = [
  {
    label: 'Lihat',
    title: 'Ringkasan berubah mengikuti tanggung jawab.',
    items: [
      'Pemilik melihat lintas modul dan prioritas usaha.',
      'Admin melihat data yang perlu dirapikan.',
      'Kasir melihat transaksi dan status pembayaran.',
      'Supervisor melihat pengecualian dan tindak lanjut.',
    ],
  },
  {
    label: 'Tindak',
    title: 'Aksi dibuka secukupnya, sesuai pekerjaan.',
    items: [
      'Buat dan edit mengikuti cakupan akses akun.',
      'Persetujuan serta ekspor mengikuti kebijakan.',
      'Tagihan tetap berada di tangan pemilik.',
    ],
  },
  {
    label: 'Handoff',
    title: 'Masalah berpindah bersama bukti yang dibutuhkan.',
    items: [
      'Catat kejadian dan status terakhirnya.',
      'Tinjau periode serta sumber data yang relevan.',
      'Teruskan kepada orang yang berwenang memutuskan.',
    ],
  },
];
const roleCloseVisual = editorialLeadPhotos.freeDemo;
const roleHubScreens = (() => {
  const set = getRoleDriveVisuals('pemilik-usaha');
  return [set.primary, set.supporting[0]].filter(Boolean).map(toProductScreen);
})();
---

<BaseLayout title="RAMUNI untuk Tim Usaha" description="Pilih peran tim dan lihat pekerjaan, akses, serta handoff yang perlu dijaga bersama.">
  <div class="container audience-breadcrumb role-hub-breadcrumb">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Beranda</a><span aria-hidden="true">/</span><span aria-current="page">Untuk Tim</span></nav>
  </div>

  <section class="section role-hub-hero" aria-labelledby="role-hub-title">
    <div class="container">
      <div class="role-hub-hero__intro reveal">
        <p class="eyebrow">Untuk tim usaha</p>
        <h1 id="role-hub-title">Setiap peran melihat keputusan yang berbeda.</h1>
        <p class="lede">RAMUNI menyatukan pemahaman bisnis, lalu membatasi tampilan dan tindakan sesuai pekerjaan setiap orang.</p>
        <div class="button-row"><a class="button button--primary" href="#daftar-peran">Pilih peran</a></div>
      </div>
      <div class="role-hub-hero__chooser" id="daftar-peran">
        <div class="role-hub-hero__chooser-head"><h2>Mulai dari pekerjaan yang paling sering tertahan.</h2><p>Jelaskan tanggung jawabnya dulu. Modul dan akses mengikuti kebutuhan itu.</p></div>
        <nav class="role-hub-hero__cards" aria-label="Pilih peran tim">
          {roles.map((role, index) => <a class="role-hub-hero__card reveal" style={`--i:${index}`} href={`/untuk/${role.slug}/`}>
            <span>{roleViews[role.slug].lens}</span>
            <strong>{role.title}</strong>
            <p>{roleViews[role.slug].primary}</p>
            <small>{roleHubCtas[role.slug]}</small>
          </a>)}
        </nav>
      </div>
    </div>
  </section>

  <section class="section surface role-hub-permission" id="izin" aria-labelledby="permission-title">
    <div class="container">
      <div class="role-hub-section-head reveal"><h2 id="permission-title">Aksi dibuka sesuai tanggung jawab.</h2><p class="lede">Contoh matriks ini membantu tim menyepakati siapa yang dapat melihat, mengubah, menyetujui, dan mengelola tagihan.</p></div>
      <div class="role-hub-table reveal" role="region" aria-label="Perbandingan visibilitas peran" tabindex="0">
        <table><thead><tr><th scope="col">Area</th><th scope="col">Pemilik</th><th scope="col">Admin</th><th scope="col">Kasir</th><th scope="col">Supervisor</th></tr></thead><tbody>{visibility.map((row) => <tr><th scope="row">{row.area}</th><td>{row.owner}</td><td>{row.admin}</td><td>{row.cashier}</td><td>{row.supervisor}</td></tr>)}</tbody></table>
      </div>
    </div>
  </section>

  <section class="section surface role-hub-context" id="peta-peran" aria-labelledby="role-hub-context-title">
    <div class="container">
      <AudienceContextBoard
        id="role-hub-context"
        eyebrow="Peta kerja tim"
        title="Satu masalah. Sudut pandang dan tindakan bisa berbeda."
        description="Telusuri bagaimana RAMUNI memisahkan pekerjaan melihat, menindak, dan meneruskan tanpa membuat tim kehilangan konteks."
        panes={roleContextPanes}
        note="Matriks dan contoh ini adalah dasar pembicaraan. Akses akhir tetap mengikuti kebijakan akun Anda."
        variant="role"
      />
    </div>
  </section>

  <section class="section role-hub-handoff" id="kolaborasi" aria-labelledby="collaboration-title">
    <div class="container">
      <div class="role-hub-section-head reveal"><h2 id="collaboration-title">Satu handoff, empat langkah yang dapat diperiksa.</h2><p class="lede">Masalah tidak berhenti di chat. Status, sumber, dan pemilik tindak lanjut ikut berpindah.</p></div>
      <ol class="role-hub-handoff__flow reveal">{collaborationFlow.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{step.label}</strong><p>{step.text}</p></li>)}</ol>
      <div class="role-hub-handoff__ai reveal"><div><strong>AI mengikuti izin yang sama</strong><p>AI membantu membaca pola dan menyiapkan pertanyaan. Perubahan, persetujuan, dan tindakan berisiko tetap memerlukan manusia.</p></div><div class="role-hub-handoff__ai-roles">{roles.map((role) => <article><span>{role.title}</span><p>{roleViews[role.slug].ai}</p></article>)}</div></div>
    </div>
  </section>

  <ProductScreenshotRail
    id="role-hub-screens"
    eyebrow="Tampilan produk"
    heading="Satu layar, fokus yang berbeda untuk tiap peran."
    body="Capture workspace RAMUNI memakai data demo terkontrol. Lihat contoh ringkasan sebelum menentukan akses tim."
    items={roleHubScreens}
    compact
  />

  <section class="section role-hub-cta" id="cta" aria-labelledby="role-cta-title">
    <div class="container reveal">
      <TourEvidenceCTA
        headingId="role-cta-title"
        eyebrow="Langkah berikutnya"
        title="Cocokkan akses dengan pekerjaan tim Anda."
        body="Mulai dari satu peran yang paling penting, lalu bahas data dan tindak lanjut yang perlu terlihat bersama."
        primaryLabel="Konsultasi"
        primaryHref="/tour-produk-gratis/?flow=consultation&intent=overview"
        secondaryLabel="Baca Panduan"
        secondaryHref="/panduan/"
        visual={roleCloseVisual}
        visualBadge="Ilustrasi handoff antarperan"
        points={['Pilih peran utama', 'Cocokkan akses data', 'Sepakati tindak lanjut']}
        theme="ink"
      />
    </div>
  </section>
</BaseLayout>

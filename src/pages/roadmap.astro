---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CommercialAnalytics from '../components/CommercialAnalytics.astro';
import { pageLastmods } from '../data/pageLastmods';
import '../styles/commercial-pages.css';

const origin = new URL('/', Astro.site || Astro.url.origin).origin;
const canonical = new URL('/roadmap/', origin).toString();
const liveItems = [
  { label: 'Workspace bisnis', title: 'Penjualan, stok, kas, pelanggan, dan laporan', text: 'Satu ruang kerja untuk membaca perubahan operasional, membuka sumber angka, dan menyiapkan pemeriksaan berikutnya.', href: '/produk/' },
  { label: 'AI Copilot', title: 'Pertanyaan bisnis berbasis konteks', text: 'Jawaban menyertakan periode, sumber, dan bagian yang tetap perlu diverifikasi oleh pemilik usaha.', href: '/features/ai-copilot/' },
];
const nextItems = [
  { title: 'Knowledge OS untuk SOP dan catatan tim', text: 'Wiki, dokumen, keputusan, dan pencarian pengetahuan dibuka setelah rilis disetujui.', confidence: 'Sedang divalidasi' },
  { title: 'Web Builder dan alur pelanggan', text: 'Halaman bisnis, form kontak, dan follow-up dibuka bertahap setelah validasi kanal dan publikasi.', confidence: 'Sedang divalidasi' },
  { title: 'Kolaborasi tim yang lebih dalam', text: 'Role, approval, dan activity trail untuk membantu tim bekerja dengan konteks yang sama.', confidence: 'Dalam penyempurnaan' },
];
const laterItems = [
  { title: 'Integrasi dan impor yang lebih terarah', text: 'Mapping CSV/API, validasi baris, dan status sinkronisasi yang lebih mudah diperiksa.', confidence: 'Eksplorasi' },
  { title: 'Kontrol laporan dan ekspor', text: 'Ringkasan terjadwal, format berbagi, dan pengaturan output sesuai kebutuhan tim.', confidence: 'Eksplorasi' },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', '@id': canonical, url: canonical, name: 'Roadmap RAMUNI', description: 'Lihat kemampuan RAMUNI yang tersedia sekarang dan urutan penyempurnaan produk berikutnya.', dateModified: pageLastmods.commercial, inLanguage: 'id-ID' },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Beranda', item: `${origin}/` }, { '@type': 'ListItem', position: 2, name: 'Roadmap', item: canonical }] },
];
---

<BaseLayout title="Roadmap RAMUNI | Produk dan Penyempurnaan" description="Lihat kemampuan RAMUNI yang tersedia sekarang dan urutan penyempurnaan produk berikutnya." canonical="/roadmap/" schema={schema} pageType="WebPage">
  <div class="commercial-page" data-commercial-page="roadmap">
    <section class="commercial-hero commercial-hero--utility utility-masthead">
      <div class="container commercial-hero__grid">
        <div><Breadcrumbs items={[{ label: 'Beranda', href: '/' }, { label: 'Roadmap' }]} /><p class="section-kicker">Roadmap RAMUNI</p><h1>Produk yang bisa dipakai hari ini, disempurnakan dengan urutan yang jelas.</h1></div>
        <div class="commercial-hero__aside"><p>Kami membuka kemampuan yang sudah tersedia dan pekerjaan berikutnya agar tim dapat memahami arah produk tanpa menebak-nebak.</p><div class="button-row"><a class="button button--primary" href="/pricing/" data-analytics-event="pricing_view" data-analytics-location="roadmap_hero">Lihat pricing</a><a class="button button--secondary" href="/tour-produk-gratis/?flow=consultation" data-analytics-event="demo_request" data-analytics-location="roadmap_hero" data-destination="consultation">Konsultasi</a></div><p class="commercial-hero__note">Urutan ini menunjukkan prioritas produk, bukan janji tanggal rilis.</p></div>
      </div>
    </section>

    <section class="commercial-section commercial-section--white" aria-labelledby="live-title"><div class="container roadmap-board"><div class="roadmap-board__intro"><p class="section-kicker">Now / Next / Later</p><h2 id="live-title">Status produk dibaca sebagai urutan kerja, bukan janji tanggal.</h2><p>Setiap area memiliki halaman produk atau fitur yang menjelaskan input, output, batas, dan jalur mulai.</p></div><div class="roadmap-lanes">
      <section aria-labelledby="roadmap-now-title"><h3 id="roadmap-now-title">Now</h3><div>{liveItems.map((item, index) => <a class="roadmap-card roadmap-card--live" href={item.href} data-analytics-event="feature_view" data-analytics-location="roadmap_live"><span>{String(index + 1).padStart(2, '0')} · {item.label}</span><h4>{item.title}</h4><p>{item.text}</p><b>Lihat detail →</b></a>)}</div></section>
      <section aria-labelledby="roadmap-next-title"><h3 id="roadmap-next-title">Next</h3><div>{nextItems.map((item, index) => <article class="roadmap-card"><span>{String(index + 1).padStart(2, '0')} · {item.confidence}</span><h4>{item.title}</h4><p>{item.text}</p></article>)}</div></section>
      <section aria-labelledby="roadmap-later-title"><h3 id="roadmap-later-title">Later</h3><div>{laterItems.map((item, index) => <article class="roadmap-card roadmap-card--later"><span>{String(index + 1).padStart(2, '0')} · {item.confidence}</span><h4>{item.title}</h4><p>{item.text}</p></article>)}</div></section>
    </div><p class="roadmap-note">Roadmap ini tidak memuat data pelanggan, estimasi kontrak, atau tanggal yang belum disepakati. Gunakan halaman pricing dan demo untuk melihat akses yang berlaku saat ini.</p></div></section>

    <section class="commercial-section"><div class="container"><div class="commercial-cta"><div><p class="section-kicker">Mulai dari kebutuhan Anda</p><h2>Ingin melihat kemampuan yang paling relevan?</h2><p>Pilih satu masalah usaha, lalu tim RAMUNI akan menunjukkan alur yang sesuai tanpa meminta data sensitif.</p></div><div class="commercial-cta__actions"><a class="button button--primary" href="/tour-produk-gratis/?flow=consultation" data-analytics-event="demo_request" data-analytics-location="roadmap_final" data-destination="consultation">Konsultasi</a><a class="text-link" href="/features/">Semua fitur</a></div></div></div></section>
  </div>
  <CommercialAnalytics />
</BaseLayout>

<style is:inline>
  .roadmap-board{display:grid;grid-template-columns:minmax(250px,.48fr) minmax(0,1.52fr);gap:clamp(30px,7vw,92px);align-items:start}.roadmap-board__intro{position:sticky;top:108px}.roadmap-board__intro h2{max-width:14ch}.roadmap-board__intro p:last-child{max-width:42ch;margin-top:18px;color:var(--ink-72);line-height:1.62}.roadmap-lanes{display:grid;gap:16px}.roadmap-lanes>section{display:grid;grid-template-columns:88px minmax(0,1fr);gap:18px;padding-top:18px;border-top:1px solid var(--ink-10)}.roadmap-lanes h3{color:var(--teal);font-size:.75rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.roadmap-lanes>section>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.roadmap-card{display:flex;flex-direction:column;min-height:190px;padding:22px;border:1px solid var(--ink-12);background:var(--white);box-shadow:none;text-decoration:none;color:inherit}.roadmap-card--live{border-top:3px solid var(--teal)}.roadmap-card--later{background:var(--rice)}.roadmap-card>span{color:var(--teal);font-size:.62rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.roadmap-card h4{margin-top:14px;font-size:clamp(1.02rem,1.5vw,1.28rem);line-height:1.2}.roadmap-card p{margin-top:10px;color:var(--ink-72);font-size:.82rem;line-height:1.55}.roadmap-card b{margin-top:auto;padding-top:18px;color:var(--teal);font-size:.76rem}.roadmap-note{grid-column:2;max-width:70ch;margin-top:8px;color:var(--ink-56);font-size:.76rem;line-height:1.55}@media(max-width:960px){.roadmap-board{grid-template-columns:1fr}.roadmap-board__intro{position:static}.roadmap-note{grid-column:auto}}@media(max-width:680px){.roadmap-lanes>section,.roadmap-lanes>section>div{grid-template-columns:1fr}.roadmap-card{min-height:0;padding:20px}}
</style>

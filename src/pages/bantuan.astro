---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
const collections=[['Mulai menggunakan RAMUNI','Persiapan bisnis, data awal, dan langkah pertama.'],['Produk, stok, dan penjualan','Fondasi katalog, transaksi, dan pergerakan stok.'],['Laporan dan Asisten AI','Cara membaca insight, sumber, periode, dan batas jawaban.'],['Tim, akses, dan persetujuan','Peran, akses, koreksi, dan persetujuan.'],['Keamanan dan privasi','Data sensitif, izin, dan batas kanal publik.'],['Pemecahan masalah','Pemulihan masalah tanpa membuka data sensitif.']];
---
<BaseLayout title="Pusat Bantuan RAMUNI" description="Struktur awal pusat bantuan RAMUNI. Artikel dan pencarian publik menunggu dokumentasi yang lengkap dan terverifikasi." noindex={true}>
  <PageHero eyebrow="Pusat Bantuan" title="Temukan langkah kerja, bukan sekadar daftar fitur." description="Pusat bantuan masih berupa struktur awal. Artikel, pencarian, dan kompatibilitas versi akan dibuka setelah dokumentasi produk diverifikasi." primaryLabel="Hubungi Dukungan" primaryHref="https://wa.me/message/K35W6X6WT7YMJ1" secondaryLabel="Lihat Status" secondaryHref="/status" />
  <section class="section surface support-page__search" id="pencarian" aria-labelledby="search-title"><div class="container support-page__search-layout"><div class="support-page__heading reveal"><h2 id="search-title">Pencarian belum diaktifkan.</h2><p>Hasil pencarian baru akan tersedia setelah artikel publik memiliki cakupan, versi, dan pemilik review yang jelas.</p></div><div class="support-page__search-state reveal" role="status"><label for="help-search">Cari tugas atau masalah</label><div><input id="help-search" type="search" placeholder="Contoh: koreksi stok" disabled /><button type="button" disabled>Cari</button></div><small>Struktur placeholder: tidak mengirim atau menyimpan kueri.</small></div></div></section>
  <section class="section support-page__collections" id="koleksi" aria-labelledby="collections-title"><div class="container support-page__split"><div class="support-page__heading reveal"><p class="eyebrow">Koleksi bantuan</p><h2 id="collections-title">Disusun mengikuti pekerjaan pengguna.</h2><p>Koleksi tidak dibuat menjadi halaman publik sampai memiliki sedikitnya tiga artikel yang lengkap dan berguna.</p></div><ol class="support-page__index">{collections.map((item,index)=><li class="reveal"><span>{String(index+1).padStart(2,'0')}</span><div><strong>{item[0]}</strong><p>{item[1]}</p></div><small>Draft struktur</small></li>)}</ol></div></section>
  <section class="section dark-surface support-page__roles" id="berdasarkan-peran" aria-labelledby="roles-title"><div class="container"><div class="support-page__heading reveal"><h2 id="roles-title">Mulai dari tanggung jawab Anda.</h2></div><nav class="support-page__role-rail" aria-label="Bantuan berdasarkan peran"><a class="reveal" href="/untuk/pemilik-usaha"><strong>Pemilik Usaha</strong><span>Insight, kontrol tim, dan keputusan</span></a><a class="reveal" href="/untuk/admin-toko"><strong>Admin Toko</strong><span>Data, koreksi, dan tugas operasional</span></a><a class="reveal" href="/untuk/kasir"><strong>Kasir</strong><span>Transaksi dan panduan pemulihan</span></a><a class="reveal" href="/untuk/supervisor"><strong>Supervisor</strong><span>Pengecualian, laporan, dan tindak lanjut</span></a></nav></div></section>
  <section class="section surface support-page__empty" id="artikel" aria-labelledby="articles-title"><div class="container support-page__split"><div class="support-page__heading reveal"><h2 id="articles-title">Belum ada artikel publik yang dinyatakan siap.</h2></div><div class="support-page__empty-state reveal"><strong>Mengapa masih kosong?</strong><p>Artikel harus memiliki langkah yang dapat diuji, versi produk, tanggal review, dan batas keamanan sebelum masuk daftar populer atau terbaru.</p><a class="text-link" href="/blog">Baca artikel bisnis di Blog RAMUNI</a></div></div></section>
  <section class="section support-page__escalation" id="eskalasi" aria-labelledby="escalation-title"><div class="container support-page__split"><div class="support-page__heading reveal"><p class="eyebrow">Eskalasi</p><h2 id="escalation-title">Sampaikan masalah tanpa mengirim data sensitif.</h2><p>Jangan kirim password, token, data pelanggan, transaksi rinci, atau kredensial melalui formulir publik.</p></div><div class="support-page__contact-ledger reveal"><a href="/status"><strong>Periksa status</strong><span>Lihat apakah feed operasional sudah tersedia.</span></a><a href="/keamanan"><strong>Baca keamanan</strong><span>Pahami batas AI, akses, dan pengungkapan data.</span></a><a href="https://wa.me/message/K35W6X6WT7YMJ1"><strong>Hubungi RAMUNI</strong><span>Kirim konteks minimum yang aman untuk ditindaklanjuti.</span></a></div></div></section>
  <section class="section surface support-page__notice"><div class="container support-page__closing reveal"><div><h2>Pusat bantuan belum menjadi sumber operasional final.</h2><p>Halaman ini noindex sampai artikel publik, pencarian, feedback, dan kompatibilitas versi siap digunakan.</p></div><a class="button button--primary" href="https://wa.me/message/K35W6X6WT7YMJ1">Hubungi Dukungan</a></div></section>
</BaseLayout>

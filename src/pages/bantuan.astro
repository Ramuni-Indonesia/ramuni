---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
const collections=[['Mulai menggunakan RAMUNI','Persiapan bisnis, data awal, dan langkah pertama.'],['Produk, stok, dan penjualan','Fondasi katalog, transaksi, dan pergerakan stok.'],['Laporan dan Asisten AI','Cara membaca insight, sumber, periode, dan batas jawaban.'],['Tim, akses, dan persetujuan','Peran, akses, koreksi, dan persetujuan.'],['Keamanan dan privasi','Data sensitif, izin, dan batas kanal publik.'],['Pemecahan masalah','Pemulihan masalah tanpa membuka data sensitif.']];
---
<BaseLayout title="Pusat Bantuan RAMUNI" description="Peta topik bantuan, batas keamanan, dan jalur dukungan RAMUNI untuk pekerjaan umum pengguna." noindex={true}>
  <PageHero eyebrow="Pusat Bantuan" title="Temukan langkah kerja, bukan sekadar daftar fitur." description="Mulai dari topik atau tanggung jawab yang paling dekat dengan pekerjaan Anda. Jika jawabannya tidak ada di halaman ini, hubungi tim RAMUNI dengan konteks minimum yang aman." primaryLabel="Hubungi Dukungan" primaryHref="https://wa.me/message/K35W6X6WT7YMJ1" secondaryLabel="Baca Keamanan" secondaryHref="/keamanan" />
  <section class="section surface support-page__search" id="pencarian" aria-labelledby="search-title"><div class="container support-page__search-layout"><div class="support-page__heading reveal"><h2 id="search-title">Mulai dari topik yang tersedia.</h2><p>Ketik kebutuhan singkat, lalu daftar koleksi di bawah akan menyesuaikan tanpa mengirim data ke server.</p></div><form class="support-page__search-state reveal" role="search" data-help-search><label for="help-search">Cari koleksi bantuan</label><div><input id="help-search" type="search" placeholder="Contoh: koreksi stok" autocomplete="off" data-help-search-input /><button type="reset">Reset</button></div><small data-help-search-status>6 koleksi tersedia.</small></form></div></section>
  <section class="section support-page__collections" id="koleksi" aria-labelledby="collections-title"><div class="container support-page__split"><div class="support-page__heading reveal"><p class="eyebrow">Koleksi bantuan</p><h2 id="collections-title">Disusun mengikuti pekerjaan pengguna.</h2><p>Enam kelompok topik ini membantu Anda menentukan rujukan atau konteks yang perlu disampaikan kepada dukungan.</p></div><ol class="support-page__index">{collections.map((item,index)=><li class="reveal" data-help-topic={`${item[0]} ${item[1]}`}><span>{String(index+1).padStart(2,'0')}</span><div><strong>{item[0]}</strong><p>{item[1]}</p></div><small>Peta topik</small></li>)}</ol></div></section>
  <section class="section dark-surface support-page__roles" id="berdasarkan-peran" aria-labelledby="roles-title"><div class="container"><div class="support-page__heading reveal"><h2 id="roles-title">Mulai dari tanggung jawab Anda.</h2></div><nav class="support-page__role-rail" aria-label="Bantuan berdasarkan peran"><a class="reveal" href="/untuk/pemilik-usaha"><strong>Pemilik Usaha</strong><span>Insight, kontrol tim, dan keputusan</span></a><a class="reveal" href="/untuk/admin-toko"><strong>Admin Toko</strong><span>Data, koreksi, dan tugas operasional</span></a><a class="reveal" href="/untuk/kasir"><strong>Kasir</strong><span>Transaksi dan panduan pemulihan</span></a><a class="reveal" href="/untuk/supervisor"><strong>Supervisor</strong><span>Pengecualian, laporan, dan tindak lanjut</span></a></nav></div></section>
  <section class="section surface support-page__empty" id="artikel" aria-labelledby="articles-title"><div class="container support-page__split"><div class="support-page__heading reveal"><h2 id="articles-title">Gunakan rujukan yang tersedia sekarang.</h2></div><div class="support-page__empty-state reveal"><strong>Artikel edukasi ada di Blog RAMUNI.</strong><p>Blog membahas stok, arus kas, dan AI untuk UMKM. Untuk masalah akun atau operasi produk, sampaikan konteks singkat melalui kanal dukungan.</p><a class="text-link" href="/blog">Baca artikel bisnis di Blog RAMUNI</a></div></div></section>
  <section class="section support-page__escalation" id="eskalasi" aria-labelledby="escalation-title"><div class="container support-page__split"><div class="support-page__heading reveal"><p class="eyebrow">Eskalasi</p><h2 id="escalation-title">Sampaikan masalah tanpa mengirim data sensitif.</h2><p>Jangan kirim password, token, data pelanggan, transaksi rinci, atau kredensial melalui formulir publik.</p></div><div class="support-page__contact-ledger reveal"><a href="/keamanan"><strong>Baca keamanan</strong><span>Pahami batas AI, akses, dan pengungkapan data.</span></a><a href="https://wa.me/message/K35W6X6WT7YMJ1"><strong>Hubungi RAMUNI</strong><span>Kirim konteks minimum yang aman untuk ditindaklanjuti.</span></a></div></div></section>
  <section class="section surface support-page__notice"><div class="container support-page__closing reveal"><div><h2>Butuh jawaban untuk kondisi tertentu?</h2><p>Kirim jenis masalah, peran Anda, dan langkah yang sudah dicoba. Hindari password, token, data pelanggan, dan rincian transaksi.</p></div><a class="button button--primary" href="https://wa.me/message/K35W6X6WT7YMJ1">Hubungi Dukungan</a></div></section>
  <script>
    document.querySelectorAll<HTMLFormElement>('[data-help-search]').forEach((form) => {
      const input = form.querySelector<HTMLInputElement>('[data-help-search-input]');
      const status = form.querySelector<HTMLElement>('[data-help-search-status]');
      const topics = Array.from(document.querySelectorAll<HTMLElement>('[data-help-topic]'));
      const update = () => {
        const query = (input?.value || '').trim().toLowerCase();
        let visible = 0;
        topics.forEach((topic) => {
          const match = !query || (topic.dataset.helpTopic || '').toLowerCase().includes(query);
          topic.hidden = !match;
          if (match) visible += 1;
        });
        if (status) status.textContent = query ? visible + ' koleksi cocok untuk "' + query + '".' : topics.length + ' koleksi tersedia.';
      };
      input?.addEventListener('input', update);
      form.addEventListener('reset', () => setTimeout(update, 0));
      form.addEventListener('submit', (event) => event.preventDefault());
      update();
    });
  </script>
</BaseLayout>

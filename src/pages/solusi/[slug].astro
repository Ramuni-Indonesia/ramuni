---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MascotDecisionCTA from '../../components/MascotDecisionCTA.astro';
import SolutionDataVisual from '../../components/solution/SolutionDataVisual.astro';
import SolutionManualGap from '../../components/solution/SolutionManualGap.astro';
import SolutionScenario from '../../components/solution/SolutionScenario.astro';
import SolutionWorkflow from '../../components/solution/SolutionWorkflow.astro';
import ProductScrollMotion from '../../components/product/ProductScrollMotion.astro';
import InsightEvidenceFlow from '../../components/InsightEvidenceFlow.astro';
import { listSolutionRouteModels, type SolutionRouteModel } from '../../content-gateway/site-records';
import { capabilityIconAttributes } from '../../data/capabilityIcons';
import { releaseGates } from '../../config/release';
import '../../styles/solution-detail.css';

export async function getStaticPaths() {
  return (await listSolutionRouteModels()).map((model) => ({ params: { slug: model.solution.slug }, props: model }));
}

const { solution, cmsSnapshotId } = Astro.props as SolutionRouteModel;
const capabilityIconForHref = (href?: string) => {
  const slug = href?.startsWith('/produk/') ? href.replace(/\/+$/, '').split('/').pop() : undefined;
  return slug ? capabilityIconAttributes('product', slug) : {};
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: solution.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---
<BaseLayout title={`${solution.title} | RAMUNI`} description={solution.metaDescription} noindex={!releaseGates.claimPagesIndexable} schema={faqSchema}>
  <article class={`sd-page sd-page--${solution.layout} sd-page--${solution.visual.kind}`} data-solution={solution.slug} data-cms-snapshot={cmsSnapshotId}>
    <section class="sd-hero" aria-labelledby="solution-title">
      <div class="container sd-hero__layout">
        <div class="sd-hero__copy reveal is-visible">
          <div class="sd-hero__meta">
            <span class="sd-solution-glyph" aria-hidden="true" {...capabilityIconAttributes('solution', solution.slug)}><i></i><i></i><i></i></span>
            <p class="section-kicker">{solution.eyebrow}</p>
          </div>
          <h1 id="solution-title">{solution.heroTitle}</h1>
          <p class="lede">{solution.heroText}</p>
          <div class="sd-hero__action">
            <a class="button button--primary" href="/tour-produk-gratis/">{solution.ctaLabel}</a>
            <p>{solution.heroOutcome}</p>
          </div>
        </div>
        <div class="sd-hero__visual reveal is-visible">
          <SolutionDataVisual visual={solution.visual} slug={solution.slug} />
        </div>
      </div>
    </section>

    <section class="section sd-problem" aria-labelledby="problem-title">
      <div class="container sd-problem__grid">
        <header class="sd-problem__heading reveal">
          <p class="section-kicker">Kenali masalahnya</p>
          <h2 id="problem-title">Apakah ini terjadi di usaha Anda?</h2>
          <p>Cocokkan gejala dengan catatan yang tersedia. Satu tanda belum cukup untuk menyimpulkan penyebab.</p>
        </header>
        <ol class="sd-symptoms">
          {solution.symptoms.map((symptom, index) => <li class="reveal" style={`--i:${index}`}><span>{String(index + 1).padStart(2, '0')}</span><strong>{symptom}</strong></li>)}
        </ol>
        <div class="sd-impact" aria-label="Dampak bisnis">
          {solution.impact.map((impact, index) => <article class="reveal" style={`--i:${index}`}><span>Dampak {String(index + 1).padStart(2, '0')}</span><h3>{impact.title}</h3><p>{impact.text}</p></article>)}
        </div>
        <InsightEvidenceFlow
          context="Solusi"
          title="Uji satu gejala sebelum menarik kesimpulan."
          prompt={solution.heroOutcome}
          sources={solution.symptoms}
          outcome={solution.scenario.decision}
          variant={solution.slug}
        />
      </div>
    </section>

    <SolutionManualGap solution={solution} />

    <section class="section sd-workflow-section" aria-labelledby="workflow-title">
      <div class="container">
        <header class="sd-section-heading reveal">
          <p class="section-kicker">Cara kerja</p>
          <h2 id="workflow-title">Dari catatan usaha ke keputusan yang tetap Anda pegang.</h2>
          <p>Setiap tahap menyimpan jalur kembali ke periode, sumber, dan konteks yang dipakai.</p>
        </header>
        <SolutionWorkflow steps={solution.workflow} />
      </div>
    </section>

    <section class="section sd-scenario-section" aria-labelledby="scenario-title">
      <div class="container"><SolutionScenario scenario={solution.scenario} /></div>
    </section>

    <section class="section sd-capabilities" aria-labelledby="capabilities-title">
      <div class="container sd-capabilities__layout">
        <header class="reveal">
          <p class="section-kicker">Cakupan dan status</p>
          <h2 id="capabilities-title">Modul yang membantu alur ini.</h2>
          <p>Lihat bagian yang dapat dicoba saat demo dan yang masih disiapkan.</p>
        </header>
        <div class="sd-capability-list">
          {solution.capabilities.map((capability, index) => (
            capability.href ? (
              <a class="sd-capability reveal" style={`--i:${index}`} href={capability.href}>
                <span {...capabilityIconForHref(capability.href)}><i></i><i></i><i></i><b class="sr-only">{String(index + 1).padStart(2, '0')}</b></span><div><strong>{capability.title}</strong><small>{capability.status}</small></div><p>{capability.text}</p><b>Buka</b>
              </a>
            ) : (
              <div class="sd-capability sd-capability--limited reveal" style={`--i:${index}`}>
                <span {...capabilityIconForHref(capability.href)}><i></i><i></i><i></i><b class="sr-only">{String(index + 1).padStart(2, '0')}</b></span><div><strong>{capability.title}</strong><small>{capability.status}</small></div><p>{capability.text}</p>
              </div>
            )
          ))}
        </div>
      </div>
    </section>

    <section class="section sd-context" aria-labelledby="context-title">
      <div class="container">
        <header class="sd-section-heading reveal">
          <p class="section-kicker">Konteks usaha</p>
          <h2 id="context-title">Masalah yang sama muncul dengan ritme berbeda.</h2>
          <p>Contoh berikut memakai data rekaan. Kecocokannya bergantung pada data dan cara kerja usaha Anda.</p>
        </header>
        <nav class="sd-industry-list" aria-label="Contoh berdasarkan industri">
          {solution.industries.map((industry, index) => (
            <a class="reveal" style={`--i:${index}`} href={industry.href}><span>{String(index + 1).padStart(2, '0')}</span><strong>{industry.title}</strong><p>{industry.example}</p><b>Lihat konteks</b></a>
          ))}
        </nav>
      </div>
    </section>

    <section class="section sd-start" aria-labelledby="start-title">
      <div class="container sd-start__layout">
        <div class="sd-start__steps reveal">
          <p class="section-kicker">Mulai tanpa proyek besar</p>
          <h2 id="start-title">Siapkan satu kasus yang memang perlu dijelaskan.</h2>
          <ol>{solution.onboarding.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><strong>{item.title}</strong><p>{item.text}</p></div></li>)}</ol>
        </div>
        <aside class="sd-resource reveal" aria-labelledby="resource-title">
          <span>{solution.resource.type}</span>
          <h3 id="resource-title">{solution.resource.title}</h3>
          <p>{solution.resource.text}</p>
          <a class="text-link" href={solution.resource.href}>{solution.resource.cta}</a>
        </aside>
      </div>
    </section>

    <section class="section sd-faq-close" aria-labelledby="faq-title">
      <div class="container sd-faq__layout">
        <header class="reveal"><p class="section-kicker">Sebelum memulai</p><h2 id="faq-title">Pertanyaan yang perlu dijawab lebih dulu.</h2></header>
        <div class="sd-faq-list">
          {solution.faq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
        </div>
      </div>
      <div class="container sd-close-visual reveal">
        <MascotDecisionCTA
          eyebrow="Langkah berikutnya"
          title={solution.closingTitle}
          body={solution.closingText}
          secondaryLabel="Bandingkan Solusi"
          secondaryHref="/solusi/"
          theme="ink"
        />
      </div>
    </section>
  </article>
  <ProductScrollMotion />
</BaseLayout>

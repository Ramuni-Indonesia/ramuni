---
import BaseLayout from '../layouts/BaseLayout.astro';
import { releaseGates } from '../config/release';
import PageHero from '../components/PageHero.astro';

const principles = [
  ['Minimalkan data', 'Kumpulkan hanya data yang diperlukan untuk tujuan yang jelas.'],
  ['Batasi akses', 'Setiap peran melihat konteks sesuai kewenangannya.'],
  ['Jaga jejak', 'Koreksi, persetujuan, dan perubahan penting perlu dapat diperiksa.'],
  ['Nyatakan status', 'Kontrol dipublikasikan hanya setelah implementasi dan bukti tersedia.'],
];

const controlMap = [
  {
    step: '01', title: 'Input',
    text: 'Data masuk melalui metode yang tersedia dan tujuan yang dijelaskan.',
    control: 'Data minimum', status: 'verified', statusLabel: 'Batas produk saat ini',
  },
  {
    step: '02', title: 'Akses',
    text: 'Identitas, sesi, dan peran membatasi siapa yang dapat melihat atau mengubah.',
    control: 'Pemisahan data dan akses peran', status: 'pending', statusLabel: 'Menunggu verifikasi',
  },
  {
    step: '03', title: 'Insight',
    text: 'Jawaban AI mengikuti data yang diizinkan dan hanya bersifat penjelasan pada versi awal.',
    control: 'AI hanya membaca', status: 'verified', statusLabel: 'Batas produk saat ini',
  },
  {
    step: '04', title: 'Tindakan',
    text: 'Persetujuan manusia dibutuhkan sebelum tindakan berisiko.',
    control: 'Kontrol manusia', status: 'verified', statusLabel: 'Batas produk saat ini',
  },
];

const unclaimedControls = [
  ['Enkripsi dan cadangan data', 'Metode, cakupan, masa simpan, dan uji pemulihan menunggu bukti.'],
  ['Sertifikasi keamanan', 'RAMUNI tidak menampilkan badge sertifikasi tanpa verifikasi.'],
];
---
<BaseLayout title="Keamanan RAMUNI" description="Batas keamanan, privasi, AI, akses, dan status kontrol RAMUNI yang disampaikan tanpa klaim berlebihan." noindex={!releaseGates.securityPageIndexable}>
  <PageHero eyebrow="Keamanan" title="Kepercayaan dimulai dari batas yang bisa diperiksa." description="RAMUNI menjelaskan apa yang berlaku sekarang, apa yang masih harus diverifikasi, dan siapa yang tetap memegang keputusan." primaryLabel="Bahas Kebutuhan Keamanan" primaryHref="/kontak/" secondaryLabel="Baca Privasi" secondaryHref="/privasi/" />

  <section class="section surface trust-page__principles" id="prinsip" aria-labelledby="principles-title">
    <div class="container trust-page__split">
      <div class="trust-page__heading reveal"><p class="eyebrow">Prinsip keamanan</p><h2 id="principles-title">Kontrol harus mengikuti risiko nyata.</h2><p>Keamanan bukan daftar badge. Setiap kontrol perlu cakupan, pemilik, bukti, dan tanggal verifikasi.</p></div>
      <ol class="trust-page__ledger">{principles.map((item, index) => <li class="reveal"><span>{String(index + 1).padStart(2, '0')}</span><div><strong>{item[0]}</strong><p>{item[1]}</p></div></li>)}</ol>
    </div>
  </section>

  <section class="section dark-surface control-map" id="batas-data" aria-labelledby="boundary-title">
    <div class="container control-map__layout">
      <header class="control-map__intro reveal">
        <p class="eyebrow">Peta kontrol</p>
        <h2 id="boundary-title">Data bergerak melalui jalur yang diketahui.</h2>
        <p>Peta ini membedakan batas produk yang dinyatakan sekarang, kontrol yang masih menunggu verifikasi, dan hal yang belum diklaim.</p>
        <div class="control-map__legend" aria-label="Arti status kontrol">
          <span data-tone="verified"><i aria-hidden="true"></i>Batas produk saat ini</span>
          <span data-tone="pending"><i aria-hidden="true"></i>Menunggu verifikasi</span>
          <span data-tone="unclaimed"><i aria-hidden="true"></i>Belum diklaim</span>
        </div>
      </header>

      <ol class="control-map__flow">
        {controlMap.map((item) => (
          <li class="control-map__step reveal" data-status={item.status}>
            <div class="control-map__rail" aria-hidden="true"><span>{item.step}</span><i></i></div>
            <div class="control-map__step-copy">
              <div><strong>{item.title}</strong><small>{item.control}</small></div>
              <p>{item.text}</p>
              <span class="control-map__status">{item.statusLabel}</span>
            </div>
          </li>
        ))}
      </ol>

      <aside class="control-map__unclaimed reveal" aria-labelledby="unclaimed-title">
        <div><span>Belum diklaim</span><h3 id="unclaimed-title">Bukti harus tersedia sebelum status dipublikasikan.</h3></div>
        <dl>{unclaimedControls.map((item) => <div><dt>{item[0]}</dt><dd>{item[1]}</dd></div>)}</dl>
      </aside>
    </div>
  </section>

  <section class="section trust-page__ai" id="ai" aria-labelledby="ai-title">
    <div class="container trust-page__split">
      <div class="trust-page__heading reveal"><p class="eyebrow">Penggunaan AI</p><h2 id="ai-title">Batas AI harus terlihat sebelum data diproses.</h2><p>RAMUNI tidak mengklaim data bebas pelatihan, tanpa penyimpanan, berlokasi di Indonesia, atau memiliki perlindungan kontrak tertentu sebelum bukti penyedia dan legal tersedia.</p></div>
      <dl class="trust-page__definition reveal">
        <div><dt>Data minimum</dt><dd>Hanya konteks yang diperlukan untuk pertanyaan yang diizinkan.</dd></div>
        <div><dt>Penyedia dan masa simpan</dt><dd>Disampaikan setelah konfigurasi produksi dan perjanjian dipastikan.</dd></div>
        <div><dt>Kontrol manusia</dt><dd>Jawaban menjadi bahan pertimbangan, bukan keputusan otomatis.</dd></div>
        <div><dt>Penghapusan</dt><dd>Mekanisme mengikuti kebijakan retensi dan implementasi produk yang terverifikasi.</dd></div>
      </dl>
    </div>
  </section>

  <section class="section trust-page__incident" id="insiden" aria-labelledby="incident-title">
    <div class="container trust-page__split">
      <div class="trust-page__heading reveal"><h2 id="incident-title">Komunikasi dimulai dari verifikasi.</h2><p>Detail publik tidak menampilkan data pribadi, kata sandi, rincian sistem, atau informasi yang memperbesar risiko.</p></div>
      <ol class="trust-page__timeline">
        <li class="reveal"><span>Deteksi</span><p>Validasi sinyal dan cakupan dampak.</p></li>
        <li class="reveal"><span>Kendalikan</span><p>Batasi dampak dan jaga bukti operasional.</p></li>
        <li class="reveal"><span>Pulihkan</span><p>Uji layanan sebelum menyatakan kondisi normal.</p></li>
        <li class="reveal"><span>Pelajari</span><p>Catat tindak lanjut tanpa membuka data sensitif.</p></li>
      </ol>
    </div>
  </section>

  <section class="section surface trust-page__faq" id="faq" aria-labelledby="security-faq-title">
    <div class="container trust-page__split">
      <div class="trust-page__heading reveal"><p class="eyebrow">FAQ keamanan</p><h2 id="security-faq-title">Tanyakan bukti, bukan asumsi.</h2></div>
      <div class="faq-list reveal">
        <details><summary>Apakah RAMUNI sudah memiliki sertifikasi keamanan?</summary><p>Belum ada sertifikasi yang diklaim pada halaman ini. Status hanya akan dipublikasikan setelah bukti dan cakupannya disetujui.</p></details>
        <details><summary>Apakah tour memakai data bisnis saya?</summary><p>Tidak. Kami menggunakan skenario yang sudah disiapkan agar Anda dapat melihat alurnya dengan aman.</p></details>
        <details><summary>Bagaimana melaporkan masalah keamanan?</summary><p><code>security.txt</code> saat ini mengarah ke kanal kontak umum RAMUNI. Kontak keamanan khusus akan ditambahkan setelah pemilik dan alur responsnya disetujui.</p></details>
      </div>
    </div>
  </section>

  <section class="section trust-page__close"><div class="container trust-page__closing reveal"><div><h2>Butuh jawaban untuk evaluasi keamanan?</h2><p>Sampaikan kontrol, bukti, dan cakupan yang perlu Anda periksa tanpa mengirim rahasia melalui formulir publik.</p></div><a class="button button--primary" href="/kontak/">Ajukan pertanyaan keamanan</a></div></section>
</BaseLayout>

<style>
  .control-map { overflow: clip; }
  .control-map__layout { display: grid; grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr); gap: clamp(48px, 7vw, 104px); align-items: start; }
  .control-map__intro { position: sticky; top: 118px; max-width: 560px; }
  .control-map__intro h2 { max-width: 13ch; margin: 12px 0 20px; }
  .control-map__intro > p:last-of-type { max-width: 58ch; color: rgba(244, 240, 231, .72); }
  .control-map__legend { display: flex; flex-wrap: wrap; gap: 10px 18px; margin-top: 30px; }
  .control-map__legend span, .control-map__status { display: inline-flex; align-items: center; gap: 8px; color: rgba(244, 240, 231, .76); font-size: .75rem; font-weight: 650; letter-spacing: .02em; }
  .control-map__legend i { width: 8px; height: 8px; border-radius: 50%; background: #64c8b0; }
  .control-map__legend [data-tone="pending"] i { background: #dfad55; }
  .control-map__legend [data-tone="unclaimed"] i { background: rgba(244, 240, 231, .34); }
  .control-map__flow { list-style: none; margin: 0; padding: 0; }
  .control-map__step { display: grid; grid-template-columns: 52px minmax(0, 1fr); min-width: 0; }
  .control-map__rail { display: flex; flex-direction: column; align-items: center; }
  .control-map__rail span { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid rgba(244, 240, 231, .3); border-radius: 50%; color: #f4f0e7; font-size: .72rem; font-weight: 750; }
  .control-map__rail i { width: 1px; flex: 1; min-height: 42px; background: rgba(244, 240, 231, .18); }
  .control-map__step:last-child .control-map__rail i { display: none; }
  .control-map__step-copy { min-width: 0; margin: 0 0 18px 16px; padding: 0 0 28px; border-bottom: 1px solid rgba(244, 240, 231, .14); }
  .control-map__step-copy > div { display: flex; justify-content: space-between; gap: 18px; align-items: baseline; }
  .control-map__step-copy strong { color: #f4f0e7; font-size: clamp(1.08rem, 1.5vw, 1.34rem); }
  .control-map__step-copy small { color: rgba(244, 240, 231, .5); text-align: right; }
  .control-map__step-copy p { max-width: 60ch; margin: 10px 0 14px; color: rgba(244, 240, 231, .72); }
  .control-map__status::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: #64c8b0; }
  .control-map__step[data-status="pending"] .control-map__status::before { background: #dfad55; }
  .control-map__unclaimed { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(240px, .72fr) minmax(0, 1.28fr); gap: clamp(28px, 5vw, 72px); margin-top: 8px; padding: clamp(26px, 4vw, 42px); border: 1px solid rgba(244, 240, 231, .16); background: rgba(244, 240, 231, .045); }
  .control-map__unclaimed > div > span { color: #dfad55; font-size: .72rem; font-weight: 750; letter-spacing: .12em; text-transform: uppercase; }
  .control-map__unclaimed h3 { max-width: 24ch; margin: 10px 0 0; color: #f4f0e7; font-size: clamp(1.25rem, 2vw, 1.72rem); }
  .control-map__unclaimed dl { margin: 0; }
  .control-map__unclaimed dl div { display: grid; grid-template-columns: minmax(150px, .65fr) minmax(0, 1.35fr); gap: 24px; padding: 17px 0; border-top: 1px solid rgba(244, 240, 231, .14); }
  .control-map__unclaimed dt { color: #f4f0e7; font-weight: 700; }
  .control-map__unclaimed dd { margin: 0; color: rgba(244, 240, 231, .66); }

  @media (max-width: 900px) {
    .control-map__layout { grid-template-columns: 1fr; gap: 44px; }
    .control-map__intro { position: static; }
    .control-map__intro h2 { max-width: 18ch; }
    .control-map__unclaimed { grid-column: auto; grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .control-map__layout { gap: 34px; }
    .control-map__legend { display: grid; }
    .control-map__step { grid-template-columns: 38px minmax(0, 1fr); }
    .control-map__rail span { width: 32px; height: 32px; }
    .control-map__step-copy { margin-left: 12px; }
    .control-map__step-copy > div { display: block; }
    .control-map__step-copy small { display: block; margin-top: 4px; text-align: left; }
    .control-map__unclaimed { padding: 24px 20px; }
    .control-map__unclaimed dl div { grid-template-columns: 1fr; gap: 7px; }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/forms-conversion.css';
const whatsappHref = 'https://wa.me/message/K35W6X6WT7YMJ1';
const siteOrigin = new URL('/', Astro.site || Astro.url.origin).origin;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteOrigin}/#organization`,
  name: 'RAMUNI',
  url: siteOrigin,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    availableLanguage: ['id'],
    url: whatsappHref,
  },
};
const contactPaths = [
  ['Demo produk', 'Lihat apakah RAMUNI cocok untuk alur usaha Anda.', 'Jenis usaha + masalah utama'],
  ['Pertanyaan produk', 'Tanya batas fitur, data yang dibutuhkan, atau status rilis.', 'Konteks singkat tanpa data sensitif'],
  ['Kerja sama', 'Bahas peluang partner, edukasi, atau kolaborasi.', 'Tujuan kerja sama + kanal resmi'],
  ['Privasi / keamanan', 'Minta arahan untuk permintaan data atau laporan keamanan.', 'Jenis permintaan tanpa rahasia teknis'],
];
const safeBrief = [
  ['Boleh dikirim', 'Peran Anda, jenis usaha, masalah yang ingin dipahami.'],
  ['Jangan dikirim', 'Password, token, data pelanggan, transaksi rinci.'],
  ['Langkah berikut', 'Tim mengarahkan ke demo, bantuan, keamanan, atau sumber yang tepat.'],
];
---
<BaseLayout title="Kontak RAMUNI" description="Hubungi RAMUNI untuk membahas demo, produk, atau kerja sama tanpa mengirim data sensitif." schema={schema}>
  <section class="contact-conversion-page" id="formulir-kontak" aria-labelledby="contact-form">
    <div class="container contact-conversion-page__layout">
      <div class="contact-conversion-page__intro reveal is-visible">
        <p class="section-kicker">Kontak RAMUNI</p>
        <h1 id="contact-form">Ada yang ingin dibahas?</h1>
        <p class="lede">Ceritakan kebutuhan Anda secara ringkas lewat WhatsApp. Tim RAMUNI akan membantu mengarahkan pertanyaan tentang produk atau kerja sama.</p>
        <p class="contact-conversion-page__safe">Jangan sertakan data pelanggan, transaksi, kata sandi, atau token.</p>
        <nav class="contact-conversion-links" aria-label="Tautan bantuan kontak">
          <a href="/bantuan">Pusat Bantuan</a>
          <a href="/privasi">Privasi</a>
          <a href="/keamanan">Keamanan</a>
        </nav>
        <div class="contact-intent-board" aria-label="Jenis pertanyaan yang bisa diarahkan">
          {contactPaths.map((path, index) => (
            <article class="contact-intent-card" style={`--i:${index}`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{path[0]}</strong>
              <p>{path[1]}</p>
              <small>{path[2]}</small>
            </article>
          ))}
        </div>
      </div>
      <div class="contact-conversion-page__panel reveal is-visible">
        <div class="contact-channel-visual" aria-hidden="true">
          <span>Pesan masuk</span>
          <i></i><i></i><i></i>
          <b>Arah aman</b>
        </div>
        <p class="section-kicker">Kanal resmi</p>
        <h2>Mulai percakapan di WhatsApp.</h2>
        <p>Sampaikan nama, jenis usaha, dan satu hal yang ingin dipahami. Hindari mengirim data sensitif.</p>
        <ol class="contact-safe-steps">
          {safeBrief.map((item) => <li><strong>{item[0]}</strong><span>{item[1]}</span></li>)}
        </ol>
        <a class="button button--primary" href={whatsappHref} target="_blank" rel="noopener noreferrer">Hubungi RAMUNI di WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>

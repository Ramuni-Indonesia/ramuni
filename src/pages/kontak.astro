---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
const siteOrigin = new URL('/', Astro.site || Astro.url.origin).origin;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteOrigin}/#organization`,
  name: 'RAMUNI',
  url: siteOrigin,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    availableLanguage: ['id'],
    url: `${siteOrigin}/kontak/`,
  },
};
---
<BaseLayout title="Kontak RAMUNI" description="Hubungi RAMUNI untuk demo, dukungan produk, kemitraan, privasi, atau keamanan melalui jalur yang sesuai." schema={schema}>
  <header class="contact-hero"><div class="container contact-hero-layout"><div class="reveal is-visible"><h1>Kontak RAMUNI.</h1><p class="lede">Ceritakan kebutuhan bisnisnya secara ringkas. Kami arahkan ke demo, bantuan, atau jalur privasi yang sesuai.</p></div><div class="contact-principle reveal is-visible"><span>Catatan aman</span><strong>Konteks cukup. Rahasia jangan.</strong><p>Jangan kirim token, password, data pelanggan, atau rincian kerentanan lewat formulir umum.</p></div></div></header>

  <section class="section surface" aria-labelledby="contact-paths"><div class="container contact-path-layout"><div class="contact-sticky"><p class="section-kicker">Jalur cepat</p><h2 id="contact-paths">Pilih tujuan utama.</h2><p>Halaman ini sengaja ringkas supaya pengunjung cepat sampai ke tindakan yang tepat.</p></div><div class="contact-path-list">
    <article class="contact-path"><span>01</span><div><h3>Sales dan demo</h3><p>Untuk membahas apakah RAMUNI cocok dengan masalah operasional Anda.</p></div><a href="/demo">Minta Demo</a></article>
    <article class="contact-path"><span>02</span><div><h3>Bantuan produk</h3><p>Untuk membaca panduan umum dan status kanal bantuan.</p></div><a href="/bantuan">Pusat Bantuan</a></article>
    <article class="contact-path"><span>03</span><div><h3>Privasi dan keamanan</h3><p>Untuk memahami kebijakan data sebelum mengirim informasi sensitif.</p></div><a href="/privasi">Baca Privasi</a></article>
  </div></div></section>

  <section class="section surface" id="formulir-kontak" aria-labelledby="contact-form"><div class="container contact-form-layout"><div><p class="section-kicker">Formulir umum</p><h2 id="contact-form">Untuk pertanyaan bisnis non-sensitif.</h2><p>Gunakan formulir ini untuk konteks awal penjualan, demo, atau kebutuhan bisnis umum.</p><ul><li>Tulis masalahnya, bukan data pelanggan atau transaksi.</li><li>Jangan kirim kredensial, token, atau rincian kerentanan.</li><li>Anggap pesan berhasil hanya setelah halaman konfirmasi tampil.</li></ul></div><LeadForm kind="contact" /></div></section>

  <section class="section faq-stage" aria-labelledby="contact-faq"><div class="container faq-composition"><div class="faq-heading"><p class="section-kicker">Sebelum kirim</p><h2 id="contact-faq">Dua batas sederhana.</h2></div><div class="faq-list"><details><summary>Bagaimana jika formulir belum aktif?</summary><p>Data tidak dikirim. Gunakan halaman bantuan untuk informasi publik yang sudah tersedia.</p></details><details><summary>Bolehkah saya mengirim data pelanggan?</summary><p>Tidak. Cukup tulis konteks umum tanpa nama, transaksi, atau informasi pribadi.</p></details></div></div></section>
</BaseLayout>

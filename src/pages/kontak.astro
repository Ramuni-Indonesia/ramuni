---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { pageLastmods } from '../data/pageLastmods';
import '../styles/contact-page.css';
import '../styles/forms-conversion.css';
const siteOrigin = new URL('/', Astro.site || Astro.url.origin).origin;
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteOrigin}/#organization`,
  name: 'RAMUNI',
  url: siteOrigin,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    availableLanguage: ['id'],
    url: `${siteOrigin}/kontak/`,
  },
};
const schema = [
  organizationSchema,
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${siteOrigin}/kontak/#webpage`,
    url: `${siteOrigin}/kontak/`,
    name: 'Kontak RAMUNI: Dukungan dan Sesi Coba UMKM',
    description: 'Hubungi RAMUNI untuk membahas sesi coba gratis, pertanyaan produk, atau kerja sama tanpa mengirim data sensitif.',
    dateModified: pageLastmods.contact,
    inLanguage: 'id-ID',
  },
];
const contactPaths = [
  ['Coba gratis', 'Lihat apakah RAMUNI cocok untuk alur usaha Anda.', 'Jenis usaha + masalah utama'],
  ['Pertanyaan produk', 'Tanya fitur, data yang dibutuhkan, atau alur yang paling sesuai.', 'Konteks singkat tanpa data sensitif'],
  ['Kerja sama', 'Bahas peluang partner, edukasi, atau kolaborasi.', 'Tujuan kerja sama + kanal resmi'],
  ['Privasi / keamanan', 'Minta arahan untuk permintaan data atau laporan keamanan.', 'Jenis permintaan tanpa rahasia teknis'],
];
const safeBrief = [
  ['Boleh dikirim', 'Peran Anda, jenis usaha, masalah yang ingin dipahami.'],
  ['Jangan dikirim', 'Password, token, data pelanggan, transaksi rinci.'],
  ['Langkah berikut', 'Tim akan mengarahkan Anda ke sesi coba gratis, bantuan, keamanan, atau sumber daya yang sesuai.'],
];
---
<BaseLayout title="Kontak RAMUNI: Dukungan dan Sesi Coba UMKM" description="Hubungi RAMUNI untuk membahas sesi coba gratis, pertanyaan produk, atau kerja sama tanpa mengirim data sensitif." schema={schema}>
  <section class="contact-conversion-page" id="formulir-kontak" aria-labelledby="contact-form">
    <div class="container contact-conversion-page__layout">
      <div class="contact-conversion-page__intro reveal is-visible">
        <p class="section-kicker">Kontak RAMUNI</p>
        <h1 id="contact-form">Ceritakan satu masalah usaha. Kami bantu menentukan langkah awalnya.</h1>
        <p class="lede">Sampaikan kebutuhan Anda agar tim RAMUNI dapat mengarahkan ke sesi coba gratis, bantuan, keamanan, atau pembahasan kerja sama.</p>
        <p class="contact-conversion-page__safe">Jangan sertakan data pelanggan, transaksi, kata sandi, atau token.</p>
        <nav class="contact-conversion-links" aria-label="Tautan bantuan kontak">
          <a href="/bantuan/">Pusat Bantuan</a>
          <a href="/privasi/">Privasi</a>
          <a href="/keamanan/">Keamanan</a>
        </nav>
        <div class="contact-intent-board" aria-label="Jenis pertanyaan yang bisa diarahkan">
          {contactPaths.map((path, index) => (
            <article class="contact-intent-card" style={`--i:${index}`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{path[0]}</strong>
              <p>{path[1]}</p>
              <small>{path[2]}</small>
            </article>
          ))}
        </div>
      </div>
      <div class="contact-conversion-page__panel reveal is-visible">
        <div class="contact-channel-visual" aria-hidden="true">
          <span>Pesan masuk</span>
          <i></i><i></i><i></i>
          <b>Arah aman</b>
        </div>
        <p class="section-kicker">Formulir konsultasi</p>
        <h2>Mulai dari satu masalah yang ingin dibereskan.</h2>
        <p>Isi kontak dan ceritakan singkat kebutuhan Anda. Setelah formulir terkirim, lanjutkan percakapan melalui WhatsApp RAMUNI.</p>
        <ol class="contact-safe-steps">
          {safeBrief.map((item) => <li><strong>{item[0]}</strong><span>{item[1]}</span></li>)}
        </ol>
        <LeadForm kind="contact" handoff="whatsapp" location="contact-page" submitLabel="Kirim lalu buka WhatsApp" />
      </div>
    </div>
  </section>
</BaseLayout>

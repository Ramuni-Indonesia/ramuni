---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TourEvidenceCTA from '../../components/TourEvidenceCTA.astro';
import ProductDomainVisual from '../../components/product/ProductDomainVisual.astro';
import ProductHeroCanvas from '../../components/product/ProductHeroCanvas.astro';
import ProductDashboardChapter from '../../components/product/ProductDashboardChapter.astro';
import ProductScrollMotion from '../../components/product/ProductScrollMotion.astro';
import InsightEvidenceFlow from '../../components/InsightEvidenceFlow.astro';
import { getProductContextVisual } from '../../data/dashboardVisuals';
import { products } from '../../data/site';
import { capabilityIconAttributes } from '../../data/capabilityIcons';
import { productNarratives } from '../../data/pageNarratives';
import { listProductRouteModels, type ProductRouteModel } from '../../content-gateway/site-records';
import { releaseGates } from '../../config/release';
import '../../styles/product-detail.css';

export async function getStaticPaths() {
  return (await listProductRouteModels()).map((model) => ({ params: { slug: model.product.slug }, props: model }));
}

const { product, detail, seo: cmsSeo, cmsSnapshotId } = Astro.props as ProductRouteModel;

if (!detail) {
  throw new Error(`Product detail content is missing for ${product.slug}`);
}

const productSeo: Record<string, { title: string; description: string }> = {
  'asisten-ai': { title: 'Asisten AI untuk UMKM | RAMUNI', description: 'Gunakan Asisten AI RAMUNI untuk membaca kondisi usaha, menelusuri bukti, dan menyusun pertanyaan berikutnya tanpa menjalankan keputusan otomatis.' },
  'dashboard-bisnis': { title: 'Dashboard Bisnis UMKM | RAMUNI', description: 'Satukan perubahan penjualan, stok, kas, dan pelanggan dalam dashboard bisnis UMKM yang menunjukkan prioritas serta angka pendukungnya.' },
  'katalog-produk': { title: 'Aplikasi Katalog Produk UMKM | RAMUNI', description: 'Rapikan nama produk, SKU, kategori, unit, harga, dan HPP agar transaksi, stok, serta laporan memakai identitas yang konsisten.' },
  penjualan: { title: 'Aplikasi Penjualan untuk UMKM | RAMUNI', description: 'Baca transaksi, produk, waktu penjualan, dan perubahan omzet dalam satu alur yang membantu UMKM menelusuri penyebab sebelum bertindak.' },
  inventori: { title: 'Aplikasi Inventori UMKM | RAMUNI', description: 'Pantau saldo, mutasi, selisih, dan kebutuhan pemeriksaan stok agar UMKM dapat menentukan barang yang perlu diperhatikan lebih dulu.' },
  keuangan: { title: 'Aplikasi Keuangan UMKM | RAMUNI', description: 'Pisahkan omzet, biaya, laba, dan arus kas dengan definisi yang konsisten agar perubahan keuangan lebih mudah diperiksa bersama bukti.' },
  pelanggan: { title: 'CRM dan Data Pelanggan UMKM | RAMUNI', description: 'Satukan riwayat pembelian dan pola pelanggan berulang untuk memahami konteks pelanggan tanpa mengirim tindak lanjut secara otomatis.' },
  'laporan-insight': { title: 'Laporan Bisnis UMKM | RAMUNI', description: 'Susun ringkasan harian dan mingguan dari sumber serta periode yang sama agar laporan bisnis UMKM lebih konsisten dan mudah ditelusuri.' },
  integrasi: { title: 'Integrasi Data Bisnis UMKM | RAMUNI', description: 'Siapkan impor dan integrasi data usaha dengan pemetaan, validasi, status pembaruan, serta batas yang jelas sebelum data dipakai.' },
};
const defaultSeo = productSeo[product.slug] || { title: `${product.title} untuk UMKM | RAMUNI`, description: detail.heroLead };
const productHeroTitles: Record<string, string> = {
  'asisten-ai': 'Ajukan pertanyaan bisnis, lalu buka dasar jawabannya.',
  'dashboard-bisnis': 'Tahu apa yang perlu diperhatikan sebelum membuka semua angka.',
  'katalog-produk': 'Rapikan identitas produk agar transaksi dan laporan bicara hal yang sama.',
  penjualan: 'Lihat apa yang mendorong perubahan omzet.',
  inventori: 'Tahu stok mana yang perlu dicek lebih dulu.',
  keuangan: 'Pisahkan omzet, laba, dan kas sebelum menilai usaha.',
  pelanggan: 'Kenali pelanggan yang kembali dari riwayat pembelian.',
  'laporan-insight': 'Tutup hari dan minggu dengan angka dari sumber yang sama.',
  integrasi: 'Masukkan data dengan pemetaan dan status yang jelas.',
};
const heroTitle = productHeroTitles[product.slug] || detail.outcome;
const tourIntentByProduct: Record<string, string> = {
  'asisten-ai': 'overview',
  'dashboard-bisnis': 'overview',
  'katalog-produk': 'catalog',
  penjualan: 'sales',
  inventori: 'stock',
  keuangan: 'finance',
  pelanggan: 'customer',
  'laporan-insight': 'report',
  integrasi: 'overview',
};
const tourHref = `/tour-produk-gratis/?intent=${tourIntentByProduct[product.slug] || 'overview'}`;
const closingVisual = getProductContextVisual(product.slug);
const narrative = productNarratives[product.slug];
const seo = {
  title: cmsSeo?.title || defaultSeo.title,
  description: cmsSeo?.description || defaultSeo.description,
};

const relatedProducts = detail.relatedProductSlugs.flatMap((slug) => {
  const related = products.find((entry) => entry.slug === slug);
  return related ? [related] : [];
});

const capabilityRows = detail.capabilities.map((capability) => {
  const isApproved = releaseGates.claimPagesIndexable
    && capability.publicApproved
    && Boolean(capability.approvedStatus);
  return {
    ...capability,
    status: isApproved ? capability.approvedStatus : 'Dalam pengembangan',
    statusClass: isApproved ? 'is-approved' : 'is-concept',
  };
});

const canonicalPath = `/produk/${product.slug}/`;
const productUrl = new URL(canonicalPath, Astro.site || Astro.url.origin).toString();
const breadcrumbItems = [
  { label: 'Beranda', href: '/' },
  { label: 'Produk', href: '/produk/' },
  { label: product.title },
];
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': productUrl,
    url: productUrl,
    name: seo?.title || `${product.title} RAMUNI`,
    description: seo?.description || detail.heroLead,
    inLanguage: 'id-ID',
    isPartOf: {
      '@type': 'WebSite',
      name: 'RAMUNI',
      url: new URL('/', Astro.site || Astro.url.origin).toString(),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      ...(item.href ? { item: new URL(item.href, Astro.site || Astro.url.origin).toString() } : {}),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: detail.faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<BaseLayout
  title={seo?.title || `${product.title} RAMUNI`}
  description={seo?.description || detail.heroLead}
  canonical={canonicalPath}
  noindex={!releaseGates.claimPagesIndexable}
  schema={structuredData}
  pageType="WebPage"
>
  <article class="pd-page" data-layout={detail.layout} data-product={product.slug} data-cms-snapshot={cmsSnapshotId}>
    <section id="product-outcome" class="pd-hero" data-section-id="product-outcome" data-analytics-id="product_outcome_hero" aria-labelledby="product-title">
      <div class="container pd-hero__layout">
        <div class="pd-hero__copy reveal is-visible">
          <div class="pd-hero__meta">
            <span class="pd-product-glyph" aria-hidden="true" {...capabilityIconAttributes('product', product.slug)}><i></i><i></i><i></i></span>
            <span class="pd-module-name">{product.title}</span>
            <span class="pd-status-label">Preview produk · data demo</span>
          </div>
          <h1 id="product-title">{heroTitle}</h1>
          <p class="pd-hero__lead">{detail.heroLead}</p>
          <div class="button-row">
            <a class="button button--primary" href={tourHref}>Bahas tour {product.title}</a>
            <a class="button button--secondary" href="#product-workflow">Lihat cara kerja</a>
          </div>
          <p class="pd-hero__availability">Kemampuan pada halaman ini masih ditinjau. Status setiap bagian tersedia di bawah.</p>
        </div>
        <div class="pd-hero__canvas reveal is-visible">
          <ProductHeroCanvas slug={product.slug} title={product.title} question={detail.question} />
        </div>
      </div>
    </section>

    <section id="product-problem" class="pd-problem" data-section-id="product-problem" data-analytics-id="product_problem_context" aria-labelledby="product-problem-title">
      <div class="container pd-problem__layout">
        <div class="pd-problem__overview">
          <header>
            <span>Situasi awal</span>
            <h2 id="product-problem-title">{narrative?.problemHeading || 'Masalahnya terlihat sederhana. Jejaknya sering tersebar.'}</h2>
            <p>Tiga situasi ini sering muncul sebagai satu masalah. Buka satu per satu agar penyebabnya tidak tercampur.</p>
          </header>
          <ol>
            {detail.problems.map((problem, index) => (
              <li class="reveal" style={`--i:${index}`}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <p>{problem}</p>
              </li>
            ))}
          </ol>
        </div>
        <InsightEvidenceFlow
          context="Produk"
          title="Pilih satu catatan, lalu lihat hubungannya."
          prompt={detail.question}
          sources={detail.problems}
          outcome={detail.outcome}
          variant={product.slug}
        />
      </div>
    </section>

    <section id="product-benefits" class="pd-benefits" data-section-id="product-benefits" data-analytics-id="product_benefit_decisions" aria-labelledby="product-benefits-title">
      <div class="container">
        <div id="product-example" class="pd-example-embedded" data-section-id="product-example" data-analytics-id="product_example_output">
          <div class="pd-example__intro reveal">
            <span>{detail.example.label}</span>
            <h2 id="product-example-title">{detail.example.heading}</h2>
            <p>Contoh ini menunjukkan hasil dan dasar bacanya dalam satu tampilan.</p>
          </div>
          <div class="pd-example__stage">
            <ProductDomainVisual slug={product.slug} title={product.title} question={detail.question} />
            <figure class="pd-example__receipt reveal">
              <blockquote>{detail.question}</blockquote>
              <dl>
                {detail.example.rows.map(([term, description]) => (
                  <div><dt>{term}</dt><dd>{description}</dd></div>
                ))}
              </dl>
              <figcaption>{detail.example.takeaway}</figcaption>
            </figure>
          </div>
        </div>
        <header class="pd-section-heading">
          <h2 id="product-benefits-title">{narrative?.featureHeading || 'Dari informasi ke keputusan yang lebih jelas.'}</h2>
          <p>Setiap manfaat menjawab satu hal: apa artinya bagi pekerjaan Anda.</p>
        </header>
        <div class="pd-benefit-grid">
          {detail.benefits.map((benefit, index) => (
            <article class="pd-benefit reveal" style={`--i:${index}`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{benefit.title}</h3>
              <p>{benefit.meaning}</p>
              <strong>{benefit.decision}</strong>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="product-workflow" class="pd-workflow" data-section-id="product-workflow" data-analytics-id="product_workflow" aria-labelledby="product-workflow-title">
      <div class="container pd-workflow__layout">
        <header>
          <h2 id="product-workflow-title">{narrative?.workflowHeading || 'Empat langkah dari data ke tindakan.'}</h2>
          <p>Urutannya tetap dapat diperiksa pada setiap tahap.</p>
        </header>
        <ol class="pd-workflow__steps reveal">
          {detail.workflow.map((step, index) => (
            <li style={`--i:${index}`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div><strong>{step.label}</strong><p>{step.text}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <ProductDashboardChapter slug={product.slug} title={product.title} />

    <section id="product-capabilities" class="pd-capabilities" data-section-id="product-capabilities" data-analytics-id="product_capability_status" aria-labelledby="product-capabilities-title">
      <div class="container pd-capabilities__layout">
        <header>
          <span>Status kemampuan</span>
          <h2 id="product-capabilities-title">Lihat kemampuan yang sedang kami siapkan.</h2>
          <p>Status diperbarui setelah setiap kemampuan siap dipakai dan sudah melalui pemeriksaan.</p>
        </header>
        <div class="pd-capability-list">
          {capabilityRows.map((capability) => (
            <article>
              <div><h3>{capability.label}</h3><p>{capability.description}</p></div>
              <span class={`pd-capability-status ${capability.statusClass}`}>{capability.status}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="product-safety" class="pd-safety" data-section-id="product-safety" data-analytics-id="product_evidence_safety" aria-labelledby="product-safety-title">
      <div class="container pd-safety__layout">
        <div class="pd-safety__copy">
          <span>Bukti, izin, dan batas</span>
          <h2 id="product-safety-title">{detail.safety.heading}</h2>
          <p>{detail.safety.boundary}</p>
        </div>
        <div class="pd-safety__seal" aria-hidden="true"><span>Bukti</span><strong>Manusia</strong><small>menentukan</small></div>
        <ol>
          {detail.safety.checks.map((check, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{check}</strong></li>)}
        </ol>
        <a class="text-link" href="/keamanan/">Pelajari keamanan RAMUNI</a>
      </div>
    </section>

    <section id="product-roles" class="pd-roles" data-section-id="product-roles" data-analytics-id="product_role_relevance" aria-labelledby="product-roles-title">
      <div class="container pd-roles__layout">
        <header>
          <span>Untuk siapa</span>
          <h2 id="product-roles-title">{narrative?.roleHeading || 'Satu konteks, tanggung jawab yang berbeda.'}</h2>
          <p>Setiap peran masuk dari pekerjaan yang memang perlu mereka periksa.</p>
        </header>
        <nav class="pd-role-track" data-count={detail.roles.length} aria-label={`Kegunaan ${product.title} berdasarkan peran`}>
          {detail.roles.map((role, index) => (
            <a href={role.href}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{role.title}</strong>
              <p>{role.text}</p>
              <small>Lihat kebutuhan peran</small>
            </a>
          ))}
        </nav>
      </div>
    </section>

    <section id="product-industries" class="pd-industries" data-section-id="product-industries" data-analytics-id="product_industry_examples" aria-labelledby="product-industries-title">
      <div class="container">
        <header class="pd-section-heading">
          <h2 id="product-industries-title">{narrative?.industryHeading || 'Pertanyaannya berubah mengikuti cara usaha bekerja.'}</h2>
          <p>Contoh berikut menunjukkan konteks pemakaian, bukan klaim hasil atau ketersediaan fitur khusus industri.</p>
        </header>
        <div class="pd-industry-spread">
          {detail.industries.map((industry, index) => (
            <a href={industry.href}>
              <span>{industry.title}</span>
              <p>{industry.text}</p>
              <small>{String(index + 1).padStart(2, '0')} · Lihat contoh usaha</small>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="product-related" class="pd-related" data-section-id="product-related" data-analytics-id="product_related_paths" aria-labelledby="product-related-title">
      <div class="container pd-related__layout">
        <div class="pd-related__modules">
          <h2 id="product-related-title">Modul yang memakai konteks yang sama.</h2>
          <div>
            {relatedProducts.map((related, index) => (
              <a href={`/produk/${related.slug}/`}><span>{String(index + 1).padStart(2, '0')}</span><strong>{related.title}</strong><p>{related.summary}</p></a>
            ))}
          </div>
        </div>
        <div class="pd-related__paths" aria-label="Jalur lanjutan">
          <a href={detail.solution.href}><small>Solusi terkait</small><strong>{detail.solution.title}</strong><span>{detail.solution.text}</span></a>
          <a href={detail.resource.href}><small>Materi edukasi</small><strong>{detail.resource.title}</strong><span>{detail.resource.text}</span></a>
          <a href={detail.help.href}><small>Panduan dan bantuan</small><strong>{detail.help.title}</strong><span>{detail.help.text}</span></a>
          <div class="pd-related__quick"><a href="/tour-produk-gratis/">Bahas tour produk</a></div>
        </div>
      </div>
    </section>

    <section id="product-faq" class="pd-faq" data-section-id="product-faq" data-analytics-id="product_faq" aria-labelledby="product-faq-title">
      <div class="container pd-faq__layout">
        <div><span>FAQ</span><h2 id="product-faq-title">Pertanyaan tentang {product.title}.</h2></div>
        <div class="faq-list">
          {detail.faq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
        </div>
      </div>
    </section>

    <section id="product-next-step" class="pd-close" data-section-id="product-next-step" data-analytics-id="product_final_cta" aria-labelledby="product-next-step-title">
      <div class="container">
        <TourEvidenceCTA
          headingId="product-next-step-title"
          eyebrow="Tour produk"
          title={detail.closing}
          body={`${detail.outcome} Tour memakai data contoh agar cara kerja dan batas ${product.title} bisa dibahas sebelum akses.`}
          primaryLabel={`Minta tour ${product.title}`}
          primaryHref={tourHref}
          secondaryLabel="Bandingkan Produk"
          secondaryHref="/produk/"
          visual={closingVisual}
          visualBadge="Visual konteks · bukan akun pelanggan"
          points={[`Mulai dari ${product.title}`, 'Lihat contoh data yang bisa ditelusuri', 'Sepakati batas sebelum akses']}
        />
      </div>
    </section>
  </article>
  <ProductScrollMotion />
</BaseLayout>

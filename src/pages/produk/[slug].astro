---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { industries, products } from '../../data/site';
import { productNarratives } from '../../data/pageNarratives';
import { releaseGates } from '../../config/release';

export function getStaticPaths() { return products.map((product) => ({ params: { slug: product.slug }, props: { product } })); }
const { product } = Astro.props;
const narrative = productNarratives[product.slug];
const relatedProductSlugs: Record<string, string[]> = {
  'asisten-ai': ['dashboard-bisnis', 'laporan-insight', 'integrasi'],
  'dashboard-bisnis': ['asisten-ai', 'laporan-insight', 'keuangan'],
  'katalog-produk': ['inventori', 'penjualan', 'integrasi'],
  penjualan: ['dashboard-bisnis', 'inventori', 'pelanggan'],
  inventori: ['katalog-produk', 'penjualan', 'laporan-insight'],
  keuangan: ['penjualan', 'dashboard-bisnis', 'laporan-insight'],
  pelanggan: ['penjualan', 'asisten-ai', 'dashboard-bisnis'],
  'laporan-insight': ['dashboard-bisnis', 'asisten-ai', 'keuangan'],
  integrasi: ['katalog-produk', 'dashboard-bisnis', 'laporan-insight'],
};
const educationByProduct: Record<string, { href: string; title: string; text: string }> = {
  'asisten-ai': { href: '/blog/ai-business-companion-umkm', title: 'Kenali peran AI dalam membaca data usaha', text: 'Pelajari mengapa jawaban AI tetap perlu memiliki dasar data dan diperiksa manusia.' },
  'dashboard-bisnis': { href: '/kamus-bisnis', title: 'Pahami istilah di balik ringkasan bisnis', text: 'Gunakan kamus sederhana sebelum membandingkan omzet, laba, kas, dan stok.' },
  'katalog-produk': { href: '/blog/panduan-membaca-stok-harian', title: 'Baca stok harian dari daftar produk yang rapi', text: 'Lihat hubungan antara identitas produk, saldo, dan kecepatan barang keluar.' },
  penjualan: { href: '/kamus-bisnis', title: 'Bedakan omzet, transaksi, dan pembayaran', text: 'Buka definisi dasar agar tim membaca angka penjualan dengan cara yang sama.' },
  inventori: { href: '/blog/panduan-membaca-stok-harian', title: 'Cara membaca stok sebelum masalah muncul', text: 'Pelajari cara membandingkan saldo dengan laju penjualan dan waktu isi ulang.' },
  keuangan: { href: '/blog/arus-kas-umkm-ringan', title: 'Mulai membaca arus kas dengan bahasa ringan', text: 'Pisahkan uang masuk, uang keluar, laba, dan saldo sebelum menarik kesimpulan.' },
  pelanggan: { href: '/panduan', title: 'Pelajari cara membaca pola pelanggan', text: 'Mulai dari riwayat yang tersedia dan pastikan izin sebelum menindaklanjuti.' },
  'laporan-insight': { href: '/template', title: 'Siapkan catatan untuk laporan yang konsisten', text: 'Gunakan struktur yang sama agar perubahan, alasan, dan tindak lanjut mudah dibahas.' },
  integrasi: { href: '/panduan', title: 'Siapkan data sebelum masuk ke RAMUNI', text: 'Pelajari langkah awal untuk merapikan sumber dan format data usaha.' },
};
const relatedProducts = (relatedProductSlugs[product.slug] || []).flatMap((slug) => {
  const related = products.find((entry) => entry.slug === slug);
  return related ? [related] : [];
});
const matchingIndustries = product.industries.flatMap((title) => {
  const industry = industries.find((entry) => entry.title.toLocaleLowerCase('id-ID') === title.toLocaleLowerCase('id-ID'));
  return industry ? [industry] : [];
});
const education = educationByProduct[product.slug];
---
<BaseLayout title={`${product.title} RAMUNI`} description={product.summary} noindex={!releaseGates.claimPagesIndexable}>
  <section class="detail-hero">
    <div class="container detail-hero__layout">
      <div class="detail-hero__copy reveal is-visible">
        <Breadcrumbs items={[{ label: 'Beranda', href: '/' }, { label: 'Produk', href: '/produk' }, { label: product.title }]} />
        <span class="availability-label">Concept Preview</span>
        <h1>{product.title}</h1>
        <p class="lede">{product.summary}</p>
        <div class="button-row"><a class="button button--primary" href="/early-access">Daftar Early Access</a><a class="button button--secondary" href="/demo">Lihat Demo</a></div>
      </div>
      <aside class="detail-hero__statement reveal is-visible">
        <span>Pertanyaan utama</span>
        <strong>{product.question}</strong>
        <p>{product.outcome}</p>
      </aside>
    </div>
  </section>

  <section class="section surface problem-sequence" aria-labelledby="problem-sequence-title">
    <div class="container problem-sequence__layout">
      <header><h2 id="problem-sequence-title">{narrative.problemHeading}</h2></header>
      <ol>{product.situations.map((situation, index) => <li class="reveal"><span>{String(index + 1).padStart(2, '0')}</span><p>{situation}</p></li>)}</ol>
    </div>
  </section>

  <section class="section evidence-section" aria-labelledby="evidence-title">
    <div class="container evidence-section__layout">
      <div class="evidence-question reveal">
        <span>{narrative.exampleLabel} dengan data sintetis</span>
        <h2 id="evidence-title">{narrative.exampleHeading}</h2>
        <p>Contoh ini menunjukkan urutan membaca informasi, bukan tampilan aplikasi final.</p>
      </div>
      <figure class="product-sample reveal">
        <blockquote>
          <span>Pertanyaan usaha</span>
          <p>{product.question}</p>
        </blockquote>
        <dl>{narrative.exampleRows.map(([term, description]) => <div><dt>{term}</dt><dd>{description}</dd></div>)}</dl>
        <figcaption>
          <span>Hasil yang dicari</span>
          <strong>{product.outcome}</strong>
          <small>Gunakan data usaha yang sudah diperiksa sebelum mengambil keputusan.</small>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section surface feature-chapters" aria-labelledby="feature-chapters-title">
    <div class="container feature-chapters__layout">
      <header><h2 id="feature-chapters-title">{narrative.featureHeading}</h2><p>Preview ini menunjukkan cara kerja inti. Cakupan final mengikuti fitur yang sudah lolos uji.</p></header>
      <div class="feature-chapters__list">
        {product.features.map((feature, index) => <article class="feature-line reveal"><span>{String(index + 1).padStart(2, '0')}</span><h3>{feature.title}</h3><p>{feature.text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section product-workflow" aria-labelledby="product-workflow-title">
    <div class="container">
      <h2 id="product-workflow-title">{narrative.workflowHeading}</h2>
      <ol class="product-flow reveal">{narrative.workflow.map(([title, text], index) => <li style={`--i:${index}`}><span>{String(index + 1).padStart(2, '0')}</span><div><strong>{title}</strong><p>{text}</p></div></li>)}</ol>
    </div>
  </section>

  <section class="section surface relevance-section">
    <div class="container relevance-section__layout">
      <div><h2>{narrative.roleHeading}</h2><div class="relevance-list">{product.roles.map((role) => <span>{role}</span>)}</div></div>
      <div><h2>{narrative.industryHeading}</h2><div class="relevance-list">{matchingIndustries.map((industry) => <a href={`/industri/${industry.slug}`}>{industry.title}</a>)}</div></div>
    </div>
  </section>

  <section class="section related-learning" aria-labelledby="related-learning-title">
    <div class="container related-learning__layout">
      <div class="related-learning__modules reveal">
        <h2 id="related-learning-title">Lanjutkan dengan modul yang memakai data yang sama.</h2>
        <div class="related-module-list">
          {relatedProducts.map((related, index) => (
            <a href={`/produk/${related.slug}`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div><strong>{related.title}</strong><p>{related.summary}</p></div>
              <small>Buka modul</small>
            </a>
          ))}
        </div>
      </div>
      <aside class="learning-route reveal" aria-labelledby="learning-route-title">
        <span>Pelajari dasarnya</span>
        <h2 id="learning-route-title">{education.title}</h2>
        <p>{education.text}</p>
        <a class="text-link" href={education.href}>Buka materi edukasi</a>
      </aside>
    </div>
  </section>

  <section class="section safety-ledger" aria-labelledby="safety-ledger-title">
    <div class="container safety-ledger__layout">
      <div><p class="section-kicker">Bukti dan kendali</p><h2 id="safety-ledger-title">Batas produk terlihat sebelum digunakan.</h2></div>
      <div class="safety-ledger__content"><strong>{product.safety}</strong><p>Waktu pembaruan, izin akses, dan status kemampuan harus dapat diperiksa. Tindakan berisiko tetap membutuhkan persetujuan manusia.</p><a class="text-link" href="/keamanan">Pelajari keamanan RAMUNI</a></div>
    </div>
  </section>

  <section class="section surface detail-faq">
    <div class="container detail-faq__layout"><h2>Pertanyaan tentang {product.title}.</h2><div class="faq-list"><details><summary>Apakah semua kemampuan sudah tersedia?</summary><p>Tidak selalu. Status ditampilkan sesuai bukti rilis dan dapat berbeda pada setiap kelompok fitur.</p></details><details><summary>Apakah hasil dapat langsung dijalankan?</summary><p>Insight adalah bahan keputusan. Pengguna tetap memeriksa bukti dan menentukan tindakan.</p></details><details><summary>Bagaimana cara melihat kecocokannya?</summary><p>Gunakan demo dengan data sintetis atau daftar early access untuk membahas kebutuhan awal.</p></details></div></div>
  </section>

  <section class="section product-detail-close"><div class="container product-detail-close__layout"><h2>{narrative.closing}</h2><div class="button-row"><a class="button button--primary" href="/early-access">Daftar Early Access</a><a class="button button--secondary" href="/produk">Lihat Semua Produk</a></div></div></section>
</BaseLayout>

<style>
  .evidence-question > p {
    max-width: 36rem;
    margin-top: 24px;
    color: rgb(255 255 255 / 0.72);
  }

  .product-sample {
    margin: 0;
    border: 1px solid rgb(255 255 255 / 0.34);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .product-sample blockquote,
  .product-sample figcaption {
    margin: 0;
    padding: clamp(24px, 4vw, 40px);
  }

  .product-sample blockquote {
    background: var(--ink);
  }

  .product-sample blockquote span,
  .product-sample figcaption span,
  .learning-route > span {
    display: block;
    color: var(--yellow);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .product-sample blockquote p {
    margin-top: 14px;
    font-size: clamp(1.35rem, 2.6vw, 2.25rem);
    font-weight: 800;
    line-height: 1.25;
  }

  .product-sample dl {
    margin: 0;
    padding: 8px clamp(24px, 4vw, 40px);
  }

  .product-sample dl > div {
    display: grid;
    grid-template-columns: minmax(110px, 0.45fr) 1fr;
    gap: 20px;
    padding: 18px 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.2);
  }

  .product-sample dl > div:last-child {
    border-bottom: 0;
  }

  .product-sample dt {
    color: var(--yellow);
    font-size: 0.76rem;
    font-weight: 800;
  }

  .product-sample dd {
    margin: 0;
    color: rgb(255 255 255 / 0.78);
  }

  .product-sample figcaption {
    background: var(--white);
    color: var(--ink);
  }

  .product-sample figcaption span {
    color: var(--teal);
  }

  .product-sample figcaption strong,
  .product-sample figcaption small {
    display: block;
  }

  .product-sample figcaption strong {
    margin-top: 12px;
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    line-height: 1.35;
  }

  .product-sample figcaption small {
    margin-top: 10px;
    color: var(--ink-72);
  }

  .related-learning {
    background: var(--rice);
  }

  .related-learning__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(260px, 0.7fr);
    gap: clamp(48px, 9vw, 128px);
    align-items: start;
  }

  .related-learning__modules > h2,
  .learning-route h2 {
    font-size: clamp(1.85rem, 3.4vw, 3.25rem);
  }

  .related-module-list {
    margin-top: 36px;
    border-top: 1px solid var(--ink);
  }

  .related-module-list > a {
    display: grid;
    grid-template-columns: 36px 1fr auto;
    gap: 20px;
    align-items: start;
    padding: 24px 0;
    border-bottom: 1px solid var(--ink-10);
    color: inherit;
    text-decoration: none;
  }

  .related-module-list > a > span,
  .related-module-list > a > small {
    color: var(--teal);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .related-module-list strong {
    font-size: 1.15rem;
  }

  .related-module-list p {
    max-width: 48ch;
    margin-top: 7px;
    color: var(--ink-72);
  }

  .learning-route {
    border-top: 4px solid var(--yellow);
    padding-top: 24px;
  }

  .learning-route > span {
    color: var(--teal);
  }

  .learning-route h2 {
    margin-top: 18px;
  }

  .learning-route p {
    margin: 20px 0 24px;
    color: var(--ink-72);
  }

  @media (hover: hover) {
    .related-module-list > a {
      transition: padding 180ms ease, background-color 180ms ease;
    }

    .related-module-list > a:hover {
      padding-inline: 14px;
      background: var(--white);
    }
  }

  @media (max-width: 960px) {
    .related-learning__layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .product-sample dl > div,
    .related-module-list > a {
      grid-template-columns: 32px 1fr;
      gap: 12px;
    }

    .product-sample dl > div {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .related-module-list > a > small {
      grid-column: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .related-module-list > a {
      transition: none;
    }
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TourEvidenceCTA from '../../components/TourEvidenceCTA.astro';
import ProductHeroCanvas from '../../components/product/ProductHeroCanvas.astro';
import ProductScrollMotion from '../../components/product/ProductScrollMotion.astro';
import DecisionFlow3D from '../../components/product/DecisionFlow3D.astro';
import VisualVariety from '../../components/VisualVariety.astro';
import { products, solutions } from '../../data/site';
import { capabilityIconAttributes } from '../../data/capabilityIcons';
import { heroContextVisuals } from '../../data/dashboardVisuals';

const intelligence = products.filter((product) => ['asisten-ai', 'dashboard-bisnis', 'laporan-insight'].includes(product.slug));
const operations = products.filter((product) => ['katalog-produk', 'penjualan', 'inventori', 'keuangan', 'pelanggan'].includes(product.slug));
const ecosystem = products.find((product) => product.slug === 'integrasi');
const productCloseVisual = heroContextVisuals.aiImport;
const productFaq = [
  { question: 'Haruskah memakai semua modul sekaligus?', answer: 'Tidak. Mulai dari catatan yang paling penting, lalu tambah modul saat alurnya sudah rapi.' },
  { question: 'Bagaimana AI membantu pekerjaan?', answer: 'AI membaca konteks dan bukti, lalu membantu menyiapkan pertanyaan dan perhatian berikutnya. Tindakan tetap diputuskan pengguna.' },
  { question: 'Bagaimana memilih modul pertama?', answer: 'Pilih masalah yang paling sering menghambat pekerjaan, kemudian ikuti rekomendasi modul dan alur yang terkait.' },
];
---
<BaseLayout title="Produk RAMUNI: Penjualan, Stok, Keuangan & AI untuk UMKM" description="Pilih modul RAMUNI untuk membaca penjualan, stok, keuangan, pelanggan, laporan, dan data usaha dalam satu workspace. Lihat input dan hasil tiap modul.">
  <div class="product-hub">
    <section class="catalog-hero">
      <div class="container catalog-hero__layout">
        <div class="reveal is-visible">
          <p class="section-kicker">Produk RAMUNI</p>
          <h1>Pilih modul berdasarkan pekerjaan yang ingin selesai.</h1>
        </div>
        <div class="catalog-hero__aside reveal is-visible">
          <p>Mulai dari transaksi, stok, kas, pelanggan, atau laporan. Pilih pekerjaan yang ingin dibereskan, lalu lihat data yang dibutuhkan dan batasnya.</p>
          <div class="button-row">
            <a class="button button--primary" href="/tour-produk-gratis/?flow=consultation" data-analytics-event="demo_request" data-analytics-location="products_hero" data-destination="consultation">Konsultasi</a>
            <a class="button button--secondary" href="#product-catalog">Lihat semua modul</a>
          </div>
        </div>
        <div class="product-hub__hero-visual reveal is-visible">
          <ProductHeroCanvas slug="hub" title="Produk RAMUNI" question="Bagaimana data usaha menjadi arah yang bisa ditinjau?" />
        </div>
      </div>
    </section>

    <section id="product-catalog" class="section product-catalog" aria-labelledby="product-catalog-title">
      <div class="container product-catalog__layout">
        <header class="product-catalog__intro">
          <p class="section-kicker">Satu chooser, tiga jalur</p>
          <h2 id="product-catalog-title">Pilih pekerjaan. Hubungkan angka yang ikut berubah.</h2>
          <p>Produk RAMUNI dibagi berdasarkan cara Anda bekerja: membaca insight, menjalankan operasional, atau menyiapkan jalur data.</p>
        </header>
        <div class="product-catalog__workflow">
          <div>
            <span class="product-catalog__workflow-label">Cara modul saling bicara</span>
            <strong>Penjualan memengaruhi stok. Biaya memengaruhi kas.</strong>
            <p>Mulai dari satu modul, lalu buka hubungan yang perlu diperiksa.</p>
          </div>
          <div id="product-direction-model" class="product-direction-model reveal">
            <DecisionFlow3D />
          </div>
        </div>
        <div class="product-families">
          <section class="product-family" aria-labelledby="family-intelligence">
            <h3 id="family-intelligence">Insight dan laporan</h3>
            <VisualVariety kind="concept" asset="aiEvidenceBoard" title="Pertanyaan → sumber → pemeriksaan." note="Visual konsep berbasis alur Asisten AI RAMUNI; bukan capture workspace live." accent="teal" class="product-family__visual product-family-map product-family-map--insight reveal" />
            <div class="product-family__caption">
              <span>Insight berbasis bukti</span>
              <strong>Jawaban disertai sumber dan batas yang dapat ditinjau.</strong>
              <small>Alur contoh untuk menjelaskan hubungan catatan, konteks, dan pemeriksaan.</small>
            </div>
            {intelligence.map((product, index) => (
              <a class="product-row reveal" data-product-card={product.slug} style={`--i:${index}`} href={`/produk/${product.slug}/`}>
                <span class="product-row__mark" aria-hidden="true" {...capabilityIconAttributes('product', product.slug)}><i></i><i></i><i></i></span>
                <span><strong>{product.title}</strong><small>{product.question}</small></span>
                <span class="availability-label">Buka modul</span>
              </a>
            ))}
          </section>
          <section class="product-family product-family--operations" aria-labelledby="family-operations">
            <h3 id="family-operations">Operasional</h3>
            <figure class="product-family__visual product-family-map product-family-map--operations reveal">
              <div class="product-family-map__mast"><span><i aria-hidden="true"></i> Jalur pemeriksaan</span><strong>01 → 03</strong></div>
              <div class="product-family-map__shelf" aria-hidden="true"><i></i><i></i><i></i><b></b><b></b><b></b></div>
              <ol aria-label="Urutan pemeriksaan operasional">
                <li>
                  <span class="product-family-map__step">01</span>
                  <div><strong>Baca saldo terakhir</strong><small>Produk dan unit tercatat</small></div>
                </li>
                <li>
                  <span class="product-family-map__step">02</span>
                  <div><strong>Bandingkan gerak</strong><small>Penjualan dan mutasi</small></div>
                </li>
                <li>
                  <span class="product-family-map__step">03</span>
                  <div><strong>Pastikan di lapangan</strong><small>Cek fisik sebelum restock</small></div>
                </li>
              </ol>
              <div class="product-family-map__note"><span>Yang dijaga</span><strong>Prioritas tidak melompat.</strong></div>
            </figure>
            <div class="product-family__caption">
              <span>Operasional berurutan</span>
              <strong>Saldo dan pergerakan mengarahkan pemeriksaan berikutnya.</strong>
              <small>Alur contoh untuk membaca data sebelum menentukan tindakan.</small>
            </div>
            {operations.map((product, index) => (
              <a class="product-row reveal" data-product-card={product.slug} style={`--i:${index}`} href={`/produk/${product.slug}/`}>
                <span class="product-row__mark" aria-hidden="true" {...capabilityIconAttributes('product', product.slug)}><i></i><i></i><i></i></span>
                <span><strong>{product.title}</strong><small>{product.question}</small></span>
                <span class="availability-label">Buka modul</span>
              </a>
            ))}
          </section>
          {ecosystem && (
            <section class="product-family product-family--ecosystem" aria-labelledby="family-ecosystem">
              <h3 id="family-ecosystem">Jalur data</h3>
              <a class="product-row" data-product-card={ecosystem.slug} href={`/produk/${ecosystem.slug}/`}>
                <span class="product-row__mark" aria-hidden="true" {...capabilityIconAttributes('product', ecosystem.slug)}><i></i><i></i><i></i></span>
                <span><strong>{ecosystem.title}</strong><small>{ecosystem.question}</small></span>
                <span class="availability-label">Status per metode</span>
              </a>
            </section>
          )}
        </div>
        <aside class="product-outcome-links" aria-labelledby="product-outcome-title">
          <div>
            <p class="section-kicker">Belum tahu modulnya?</p>
            <h3 id="product-outcome-title">Mulai dari masalah yang ingin segera dibaca.</h3>
          </div>
          <nav aria-label="Solusi berdasarkan masalah">
            {solutions.map((solution) => <a data-solution-card={solution.slug} href={`/solusi/${solution.slug}/`}><strong>{solution.title}</strong><span>{solution.summary}</span><b>Lihat alur</b></a>)}
          </nav>
        </aside>
      </div>
    </section>

    <section class="section product-faq" aria-labelledby="product-faq-title">
      <div class="container product-faq__layout">
        <h2 id="product-faq-title">Pertanyaan sebelum memilih modul.</h2>
        <div>{productFaq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
      </div>
    </section>

    <section class="section product-close">
      <div class="container">
        <TourEvidenceCTA
          eyebrow="Mulai dari satu alur"
          title="Mulai dari satu pekerjaan yang paling penting."
          body="Lihat modul yang paling dekat dengan kebutuhan usaha Anda, lalu bahas akses dan cara mulai dengan tim RAMUNI."
          visual={productCloseVisual}
          visualBadge="Ilustrasi alur produk"
          points={['Pilih satu pertanyaan usaha', 'Lihat modul yang terkait', 'Pilih cara mulai']}
        />
      </div>
    </section>
  </div>
  <ProductScrollMotion />
</BaseLayout>

<style>
  .product-hub .catalog-hero h1{max-width:16ch;font-size:clamp(2.55rem,3.7vw,4.1rem);overflow-wrap:normal}
  .product-hub .catalog-hero{overflow:hidden;background:var(--rice)}
  .product-hub .catalog-hero__layout{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(320px,.92fr);gap:clamp(28px,5vw,72px);align-items:end}
  .product-hub .catalog-hero__aside{padding-bottom:12px}
  .product-hub .catalog-hero__aside>p{max-width:46ch;color:var(--ink-72)}
  .product-hub__hero-visual{grid-column:1/-1;width:100%;margin-top:clamp(22px,4vw,48px);justify-self:center}
  .product-system__heading{display:grid;grid-template-columns:minmax(0,1.16fr) minmax(280px,.84fr);gap:clamp(28px,6vw,84px);align-items:end}
  .product-system__heading h2{max-width:19ch}.product-system__heading p{max-width:46ch;color:var(--ink-72)}
  .product-direction-model{margin-top:clamp(40px,6vw,68px);overflow:hidden}
  .product-hub .product-row{grid-template-columns:56px minmax(0,1fr) auto;min-width:0;margin-inline:0;padding:14px 16px;border:1px solid transparent;border-top-color:var(--ink-10);overflow:hidden;transition:transform .32s var(--ease),background-color .32s ease,border-color .32s ease,box-shadow .32s ease}
  .product-hub .product-row:last-child{border-bottom-color:var(--ink-10)}
  .product-row__mark{position:relative;width:44px;height:44px;border:1px solid var(--ink);background:var(--rice);overflow:hidden;transition:transform .38s var(--ease),background-color .38s ease,color .38s ease}
  .product-row__mark::before{content:"";position:absolute;inset:8px;border:1px solid currentColor;color:var(--teal);opacity:.72}
  .product-row__mark::after{content:"";position:absolute;right:-5px;bottom:-5px;width:12px;height:12px;background:var(--yellow);border:1px solid var(--ink)}
  .product-row__mark i{position:absolute;left:10px;right:10px;height:3px;background:var(--teal);transform-origin:left}.product-row__mark i:nth-child(1){top:13px;width:42%}.product-row__mark i:nth-child(2){top:21px;width:66%;background:var(--ink)}.product-row__mark i:nth-child(3){top:29px;width:30%;background:var(--yellow)}
  .product-hub .product-row[data-product-card="asisten-ai"] .product-row__mark,.product-hub .product-row[data-product-card="laporan-insight"] .product-row__mark{background:var(--ink)}
  .product-hub .product-row[data-product-card="asisten-ai"] .product-row__mark::before,.product-hub .product-row[data-product-card="laporan-insight"] .product-row__mark::before{color:var(--yellow)}
  .product-hub .product-row[data-product-card="asisten-ai"] .product-row__mark i:nth-child(2),.product-hub .product-row[data-product-card="laporan-insight"] .product-row__mark i:nth-child(2){background:var(--white)}
  .product-hub .product-row[data-product-card="penjualan"] .product-row__mark,.product-hub .product-row[data-product-card="inventori"] .product-row__mark{background:var(--teal)}
  .product-hub .product-row[data-product-card="penjualan"] .product-row__mark i,.product-hub .product-row[data-product-card="inventori"] .product-row__mark i{background:var(--white)}
  .product-hub .product-row:hover,.product-hub .product-row:focus-visible{padding-inline:16px;transform:translateX(6px);border-color:var(--ink-10);background:var(--white);box-shadow:-6px 6px 0 var(--yellow)}
  .product-hub .product-row:hover .product-row__mark,.product-hub .product-row:focus-visible .product-row__mark{transform:rotate(-5deg) scale(1.04)}
  .product-hub .product-catalog__layout{display:grid;gap:clamp(42px,6vw,72px)}
  .product-hub .product-catalog__intro{max-width:760px;position:static}
  .product-hub .product-catalog__intro>p:last-of-type{max-width:58ch;margin-top:18px;color:var(--ink-72)}
  .product-hub .product-families{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(28px,4vw,56px)}
  .product-hub .product-family{min-width:0}
  .product-hub .product-family--ecosystem{grid-column:1/-1}
  .product-family__visual{position:relative;margin:18px 0 10px;background:transparent;overflow:visible}
  .product-family-map{border:1px solid var(--ink);background:var(--rice);box-shadow:8px 8px 0 var(--yellow);overflow:hidden}
  .product-family-map>.visual-variety{border:0;box-shadow:none}
  .product-family-map__mast{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 13px;background:var(--ink);color:var(--white);font-size:.62rem}
  .product-family-map__mast span{display:flex;align-items:center;gap:8px;color:var(--yellow);font-weight:900;letter-spacing:.08em;text-transform:uppercase}
  .product-family-map__mast i{width:7px;height:7px;border-radius:50%;background:var(--yellow)}
  .product-family-map__mast strong{color:rgb(255 255 255/.72);font-size:inherit}
  .product-family-map>ol{position:relative;display:grid;gap:0;margin:0;padding:22px 18px;list-style:none}
  .product-family-map>ol::before{position:absolute;top:35px;bottom:35px;left:39px;width:1px;background:linear-gradient(var(--teal),var(--yellow));content:""}
  .product-family-map>ol li{position:relative;display:grid;grid-template-columns:42px minmax(0,1fr);gap:14px;align-items:center;min-height:62px}
  .product-family-map__step{position:relative;z-index:1;display:grid;place-items:center;width:42px;height:42px;border:1px solid var(--ink);border-radius:50%;background:var(--white);color:var(--teal);font-size:.62rem;font-weight:900}
  .product-family-map>ol li:nth-child(2) .product-family-map__step{background:var(--yellow);color:var(--ink)}
  .product-family-map>ol li:nth-child(3) .product-family-map__step{background:var(--teal);color:var(--white)}
  .product-family-map>ol li strong,.product-family-map>ol li small{display:block}.product-family-map>ol li strong{font-size:.78rem;line-height:1.25}.product-family-map>ol li small{margin-top:4px;color:var(--ink-56);font-size:.64rem;line-height:1.35}
  .product-family-map__shelf{display:flex;align-items:flex-end;gap:8px;height:52px;margin:17px 18px 0;padding:0 8px 7px;border-bottom:2px solid var(--ink)}
  .product-family-map__shelf i,.product-family-map__shelf b{display:block;width:14px;border:1px solid var(--ink);background:var(--teal);font-style:normal}.product-family-map__shelf i:nth-child(1){height:22px}.product-family-map__shelf i:nth-child(2){height:34px;background:var(--yellow)}.product-family-map__shelf i:nth-child(3){height:17px;background:var(--ink)}.product-family-map__shelf b:nth-child(4){height:28px;background:var(--teal)}.product-family-map__shelf b:nth-child(5){height:39px;background:var(--yellow)}.product-family-map__shelf b:nth-child(6){height:25px;background:var(--ink)}
  .product-family-map__note{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding:12px 14px;border-top:1px solid var(--ink-10);background:var(--white)}.product-family-map__note span{color:var(--teal);font-size:.6rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.product-family-map__note strong{font-size:.72rem}
  .product-family__caption{display:grid;gap:5px;margin:16px 0 10px;padding:13px 0 0;border-top:1px solid var(--ink-10)}
  .product-family__caption span{color:var(--teal);font-size:.65rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.product-family__caption strong{font-size:.88rem;line-height:1.4}.product-family__caption small{color:var(--ink-56);font-size:.65rem;line-height:1.45}
  .product-family--ecosystem .product-row{margin-top:18px}
  .product-hub .outcome-index__layout{display:grid;gap:clamp(34px,5vw,58px)}
  .product-hub .outcome-index__layout>div:first-child{max-width:720px}
  .product-hub .outcome-index__list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;border:1px solid var(--ink);background:var(--ink)}
  .product-hub .outcome-index__list a{position:relative;min-height:210px;border:0;padding:24px;background:var(--rice);overflow:hidden;transition:transform .3s var(--ease),background-color .3s ease}
  .product-hub .outcome-index__list a:nth-child(2n){background:var(--white)}
  .product-hub .outcome-index__list a:hover,.product-hub .outcome-index__list a:focus-visible{z-index:1;transform:translateY(-5px);background:var(--yellow)}
  .product-hub .outcome-index__list .outcome-glyph{position:relative;display:block;width:42px;height:42px;margin-bottom:auto;border:1px solid var(--ink);background:var(--white);font-style:normal;overflow:hidden;transition:transform .3s var(--ease)}
  .product-hub .outcome-index__list .outcome-glyph::before{content:"";position:absolute;left:8px;bottom:8px;width:8px;height:18px;background:var(--teal);box-shadow:11px -6px 0 var(--yellow),22px -13px 0 var(--ink)}
  .product-hub .outcome-index__list .outcome-glyph b{position:absolute;border:1px solid var(--ink);border-radius:50%}.product-hub .outcome-index__list .outcome-glyph b:nth-child(1){inset:7px 22px 22px 7px}.product-hub .outcome-index__list .outcome-glyph b:nth-child(2){inset:18px 9px 9px 18px}.product-hub .outcome-index__list .outcome-glyph b:nth-child(3){right:7px;top:7px;width:8px;height:8px;background:var(--yellow)}
  .product-hub .outcome-index__list a:hover .outcome-glyph,.product-hub .outcome-index__list a:focus-visible .outcome-glyph{transform:rotate(-6deg)}
  .product-hub .outcome-index__list small{margin-top:auto}
  .product-capabilities{background:var(--ink);color:var(--white)}
  .product-capabilities__layout{display:grid;gap:clamp(42px,6vw,72px)}
  .product-capabilities header{max-width:820px}
  .product-capabilities header p{max-width:36ch;margin-top:22px;color:rgb(255 255 255/.68)}
  .capability-folds{display:grid;grid-template-columns:1.15fr .85fr 1fr;gap:14px}
  .capability-fold{position:relative;min-height:220px;padding:28px;border:1px solid rgb(255 255 255/.18);overflow:visible}
  .capability-fold:nth-child(2),.capability-fold:nth-child(3){background:rgb(255 255 255/.06)}
  .capability-fold:nth-child(2){margin-top:44px}.capability-fold:nth-child(4){grid-column:2/4;min-height:190px}
  .capability-fold::after{content:"";position:absolute;z-index:0;right:18px;bottom:18px;width:78px;height:78px;border:1px solid var(--yellow);opacity:.42;transform:rotate(38deg);transition:transform .55s cubic-bezier(.16,1,.3,1);pointer-events:none}
  .capability-fold:hover::after{transform:rotate(28deg) translate(-8px,-8px)}
  .capability-fold span,.capability-fold h3,.capability-fold p{position:relative;z-index:1}
  .capability-fold span{font-size:.72rem;font-weight:800;color:var(--yellow)}
  .capability-fold h3{margin-top:30px;font-size:clamp(1.2rem,2vw,1.65rem)}
  .capability-fold p{max-width:38ch;margin-top:14px;color:rgb(255 255 255/.7);overflow-wrap:break-word}
  .role-paths{background:var(--rice)}
  .role-paths__layout{display:grid;gap:clamp(42px,6vw,72px)}
  .role-paths__layout header{max-width:760px}
  .role-paths__layout header p{max-width:36ch;margin-top:22px;color:var(--ink-72)}
  .role-paths__nav{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:var(--ink-10)}
  .role-paths__nav a{min-height:190px;padding:26px;background:var(--rice);text-decoration:none;transition:background .3s ease,transform .3s ease}
  .role-paths__nav a:hover,.role-paths__nav a:focus-visible{background:var(--white);transform:translateY(-4px)}
  .role-paths__nav strong,.role-paths__nav span{display:block}.role-paths__nav strong{font-size:1.2rem}.role-paths__nav span{margin-top:40px;color:var(--ink-72)}
  .product-trust{background:var(--teal);color:var(--white)}
  .product-trust__layout{display:grid;grid-template-columns:1.2fr .8fr;gap:clamp(34px,6vw,88px);align-items:center}
  .product-trust__layout>div:first-child{position:relative}.product-trust__layout>div:first-child::after{content:"MANUSIA";display:block;margin-top:34px;color:rgb(255 255 255/.12);font-size:clamp(3.6rem,10vw,9rem);font-weight:800;line-height:.8;letter-spacing:-.07em}
  .product-trust__copy{border:1px solid rgb(255 255 255/.35);padding:clamp(24px,4vw,38px)}
  .product-trust .section-kicker{color:var(--yellow)}.product-trust p{max-width:52ch;color:rgb(255 255 255/.78)}
  .product-trust a{display:inline-block;margin-top:24px;color:var(--white);font-weight:800;text-underline-offset:5px}
  .product-faq{background:var(--white)}
  .product-faq__layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(48px,9vw,132px)}
  .product-faq details{border-top:1px solid var(--ink-10);padding:22px 0}.product-faq details:last-child{border-bottom:1px solid var(--ink-10)}
  .product-faq summary{cursor:pointer;font-weight:800}.product-faq details p{max-width:58ch;margin-top:14px;color:var(--ink-72)}
  @media (prefers-reduced-motion:no-preference) and (min-width:1201px) and (hover:hover) and (pointer:fine){.capability-fold{animation:hub-rise .7s both;animation-delay:calc(var(--i,0)*70ms)}@keyframes hub-rise{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}}
  @media(max-width:1200px){.product-hub .catalog-hero__layout,.product-system__heading,.product-trust__layout,.product-faq__layout{grid-template-columns:1fr}.product-hub .outcome-index__list,.role-paths__nav{grid-template-columns:repeat(2,minmax(0,1fr))}.product-family--ecosystem .product-row{margin-top:0}}
  @media(min-width:961px) and (max-width:1200px){.product-hub .catalog-hero__layout{grid-template-columns:minmax(330px,1.08fr) minmax(360px,.92fr);gap:clamp(24px,3vw,40px)}}

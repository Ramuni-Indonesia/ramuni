---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBlogPosts } from '../lib/blog';
import StoryMicroVisual from '../components/blog/StoryMicroVisual.astro';
import { releaseGates } from '../config/release';
import { navigationIconAttributes } from '../data/capabilityIcons';
import '../styles/resource-hub.css';

const posts = (await getBlogPosts())
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const mascotSrc = releaseGates.mascotExplorationEnabled ? '/website-original/ramuni-mascot-muni-manyar.webp' : '/website-original/ramuni-mascot-problem-section.webp';
const featuredPost = posts.find((post) => post.data.featured) || posts[0];
const formatDate = (value: Date) => new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(value);
const resourceFormats = [
  { href: '/panduan/', title: 'Panduan', text: 'Ikuti langkah berurutan saat Anda belum tahu harus mulai memeriksa dari mana.', fit: 'Untuk memahami proses', visual: 'guide' },
  { href: '/template/', title: 'Template', text: 'Pakai format siap isi untuk stok, opname, penjualan, arus kas, HPP, dan evaluasi mingguan.', fit: 'Untuk pekerjaan berulang', visual: 'template' },
  { href: '/generator/lembar-stok-harian/', title: 'Generator', text: 'Susun lembar pemeriksaan stok dari data yang Anda isi, lalu simpan sebagai CSV, Excel, atau PDF.', fit: 'Untuk membuat dokumen kerja', visual: 'generator' },
  { href: '/kalkulator/', title: 'Kalkulator', text: 'Uji laba, HPP, harga jual, target transaksi, arus kas, atau titik pesan ulang dengan rumus terbuka.', fit: 'Untuk memeriksa hitungan', visual: 'calculator' },
  { href: '/kamus-bisnis/', title: 'Kamus Bisnis', text: 'Cari arti istilah laporan sebelum membandingkan angka atau membahasnya bersama tim.', fit: 'Untuk menyamakan istilah', visual: 'glossary' },
];

const paths = [
  { question: 'Stok berubah, tetapi penyebabnya belum terlihat', href: '/panduan/membaca-stok-harian/', label: 'Baca panduan stok', visual: 'stock' },
  { question: 'Omzet naik, tetapi laba belum terasa', href: '/kalkulator/laba-usaha/', label: 'Periksa laba sederhana', visual: 'profit' },
  { question: 'Istilah di laporan masih membingungkan', href: '/kamus-bisnis/', label: 'Cari istilah bisnis', visual: 'terms' },
  { question: 'Review mingguan belum punya urutan tetap', href: '/template/', label: 'Lihat struktur template', visual: 'weekly' },
];

const modes = [
  { id: 'baca', label: 'Baca', title: 'Mulai dari penjelasan', text: 'Artikel dan panduan menunjukkan urutan pemeriksaan sebelum Anda membuka alat.', steps: ['Pilih masalah', 'Baca contoh', 'Catat pertanyaan'] },
  { id: 'coba', label: 'Coba', title: 'Uji dengan angka contoh', text: 'Kalkulator dan template membantu memeriksa asumsi tanpa mengirim data usaha.', steps: ['Isi angka', 'Lihat cara hitung', 'Bandingkan hasil'] },
  { id: 'periksa', label: 'Periksa', title: 'Lihat sumber dan cara pakainya', text: 'Standar editorial menjelaskan cara materi disusun, diperbarui, dan dikoreksi.', steps: ['Buka sumber', 'Cek pembaruan', 'Kirim koreksi'] },
];

const standards = [
  { number: '01', title: 'Sumber terlihat', text: 'Definisi, periode, dan rujukan ditulis agar pembaca dapat memeriksanya.', href: '/blog/kebijakan-sumber/' },
  { number: '02', title: 'Contoh diberi konteks', text: 'Setiap skenario dijelaskan sebagai panduan, bukan hasil usaha atau janji produk.', href: '/blog/metodologi-fact-check/' },
  { number: '03', title: 'Pembaruan tercatat', text: 'Perubahan penting memiliki tanggal, ringkasan, dan jalur koreksi.', href: '/blog/kebijakan-pembaruan/' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Sumber Daya RAMUNI',
    description: 'Pusat artikel, panduan, kalkulator, template, kamus bisnis, dan standar editorial RAMUNI untuk UMKM.',
    url: new URL('/sumber-daya/', Astro.site || Astro.url.origin).toString(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: resourceFormats.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.title,
      url: new URL(item.href, Astro.site || Astro.url.origin).toString(),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: new URL('/', Astro.site || Astro.url.origin).toString() },
      { '@type': 'ListItem', position: 2, name: 'Sumber Daya', item: new URL('/sumber-daya/', Astro.site || Astro.url.origin).toString() },
    ],
  },
];
---

<BaseLayout title="Sumber Daya Bisnis UMKM | RAMUNI" description="Pusat artikel, panduan, kalkulator, template, kamus bisnis, dan standar editorial untuk membantu UMKM memahami angka usaha." schema={schema}>
  <div class="resource-hub-page">
    <header class="resource-hub-hero">
      <div class="container resource-hub-hero__grid">
        <div class="resource-hub-hero__copy reveal is-visible">
          <nav class="breadcrumbs" aria-label="Jejak navigasi"><a href="/">Beranda</a><span>/</span><span aria-current="page">Sumber Daya</span></nav>
          <p class="eyebrow">Sumber Daya</p>
          <h1>Cari jawaban untuk angka usaha.</h1>
          <p class="lede">Baca artikel, coba alat sederhana, lalu periksa sumber dan cara pakainya sebelum menentukan langkah.</p>
          <nav class="resource-hub-hero__links" aria-label="Pintasan sumber daya">
            <a href="/blog/">Artikel</a><a href="/panduan/">Panduan</a><a href="/template/">Template</a><a href="/generator/lembar-stok-harian/">Generator</a><a href="/kalkulator/">Kalkulator</a><a href="/kamus-bisnis/">Kamus</a>
          </nav>
        </div>

        <div class="resource-navigator reveal is-visible" data-resource-navigator>
          <div class="resource-navigator__top"><span>Peta belajar</span><small>Mulai dari skenario sederhana</small></div>
          <div class="resource-navigator__tabs" role="tablist" aria-label="Cara memakai sumber daya">
            {modes.map((mode, index) => <button type="button" role="tab" id={`resource-tab-${mode.id}`} aria-controls={`resource-panel-${mode.id}`} aria-selected={index === 0 ? 'true' : 'false'} data-resource-tab={mode.id}>{mode.label}</button>)}
          </div>
          <div class="resource-navigator__panels">
            {modes.map((mode, index) => <section role="tabpanel" id={`resource-panel-${mode.id}`} aria-labelledby={`resource-tab-${mode.id}`} data-resource-panel={mode.id} hidden={index !== 0}>
              <span>0{index + 1}</span><h2>{mode.title}</h2><p>{mode.text}</p>
              <ol>{mode.steps.map((step, stepIndex) => <li><b>{String(stepIndex + 1).padStart(2, '0')}</b><strong>{step}</strong></li>)}</ol>
            </section>)}
          </div>
          <div class="resource-navigator__orbit" aria-hidden="true"><i></i><b></b><img src={mascotSrc} width="720" height="720" alt="Maskot RAMUNI" decoding="async" /></div>
        </div>
      </div>
    </header>

    <div class="resource-hub-main">
      <section class="section resource-library" aria-labelledby="resource-library-title">
        <div class="container">
          <div class="resource-library__head reveal">
            <p class="section-kicker">Pusat materi</p>
            <h2 id="resource-library-title">Pilih format yang sesuai dengan pekerjaan Anda.</h2>
            <p>Tidak ada urutan wajib. Mulai dari artikel jika butuh konteks, atau langsung buka alat jika pertanyaannya sudah jelas.</p>
          </div>
          <div class="resource-library__grid">
            {featuredPost && <a class="resource-featured-article reveal" href={`/blog/${featuredPost.id}/`}>
              <figure><img src={featuredPost.data.cover} width="1200" height="720" alt={featuredPost.data.coverAlt} loading="lazy" /><StoryMicroVisual categorySlug={featuredPost.data.categorySlug} compact /></figure>
              <div><span>Artikel pilihan</span><h3>{featuredPost.data.title}</h3><p>{featuredPost.data.dek}</p><small>{formatDate(featuredPost.data.updatedAt || featuredPost.data.publishedAt)} · {featuredPost.data.readingTime}</small><b>Baca artikel <i aria-hidden="true">&rarr;</i></b></div>
            </a>}
            <div class="resource-format-grid">
              {resourceFormats.map((item, index) => <a class="resource-format-card reveal" href={item.href} style={`--i:${index}`}><span>0{index + 1}</span><div class:list={['resource-format-card__visual', `resource-format-card__visual--${item.visual}`]} aria-hidden="true"><i></i><i></i><i></i><i></i><b class="resource-format-card__icon" {...navigationIconAttributes(item.href)}></b></div><div><small>{item.fit}</small><h3>{item.title}</h3><p>{item.text}</p></div><b>Buka {item.title} <i aria-hidden="true">&rarr;</i></b></a>)}
            </div>
          </div>
        </div>
      </section>

      <section class="section resource-problem-stage" aria-labelledby="resource-problem-title">
        <div class="container">
          <div class="resource-problem-stage__head reveal"><p class="section-kicker">Mulai dari masalah</p><h2 id="resource-problem-title">Apa yang ingin Anda pahami hari ini?</h2><p>Pilih kalimat yang paling dekat. Setiap jalur membuka satu materi yang bisa langsung dipakai.</p></div>
          <div class="resource-problem-deck">
            {paths.map((item, index) => <a class:list={['resource-problem-card', `resource-problem-card--${item.visual}`, 'reveal']} href={item.href} style={`--i:${index}`}>
              <div class="resource-problem-card__visual" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
              <span>0{index + 1}</span><h3>{item.question}</h3><b>{item.label} <i aria-hidden="true">&rarr;</i></b>
            </a>)}
          </div>
        </div>
      </section>

      <section class="section resource-editorial" aria-labelledby="resource-editorial-title">
        <div class="container resource-editorial__layout">
          <div class="resource-editorial__statement reveal"><p class="section-kicker">Standar editorial</p><h2 id="resource-editorial-title">Materi yang berguna harus bisa diperiksa.</h2><p>Kami menunjukkan sumber, konteks contoh, dan riwayat pembaruan. Jika ada yang kurang tepat, jalur koreksi selalu tersedia.</p><a class="text-link" href="/blog/kebijakan-editorial/">Baca kebijakan editorial</a></div>
          <ol class="resource-editorial__standards">
            {standards.map((standard) => <li class="reveal"><a href={standard.href}><span>{standard.number}</span><div><h3>{standard.title}</h3><p>{standard.text}</p></div><i aria-hidden="true">&rarr;</i></a></li>)}
          </ol>
          <nav class="resource-editorial__policies" aria-label="Kebijakan editorial"><a href="/blog/metodologi-fact-check/">Pengecekan fakta</a><a href="/blog/kebijakan-sumber/">Sumber</a><a href="/blog/kebijakan-pembaruan/">Pembaruan</a><a href="/blog/koreksi/">Koreksi</a></nav>
        </div>
      </section>

      <section class="section resource-close-stage">
        <div class="container resource-close reveal"><div><p class="section-kicker">Belajar sambil mencoba</p><h2>Bawa satu pertanyaan usaha.</h2><p>Mulai dari artikel jika butuh penjelasan, atau coba gratis untuk melihat alurnya langsung.</p></div><div class="button-row"><a class="button button--primary" href="/blog/">Jelajahi Artikel</a><a class="button button--secondary" href="/tour-produk-gratis/">Coba gratis</a></div></div>
      </section>
    </div>
  </div>

  <script>
    document.querySelectorAll<HTMLElement>('[data-resource-navigator]').forEach((navigator) => {
      const tabs = Array.from(navigator.querySelectorAll<HTMLButtonElement>('[data-resource-tab]'));
      const panels = Array.from(navigator.querySelectorAll<HTMLElement>('[data-resource-panel]'));
      const activate = (id: string) => {
        tabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.resourceTab === id)));
        panels.forEach((panel) => { panel.hidden = panel.dataset.resourcePanel !== id; });
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => activate(tab.dataset.resourceTab || 'baca'));
        tab.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
          event.preventDefault();
          const nextIndex = event.key === 'ArrowRight' ? (index + 1) % tabs.length : (index - 1 + tabs.length) % tabs.length;
          tabs[nextIndex]?.focus();
          activate(tabs[nextIndex]?.dataset.resourceTab || 'baca');
        });
      });
    });
  </script>
</BaseLayout>

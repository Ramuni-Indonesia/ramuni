---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TourEvidenceCTA from '../../components/TourEvidenceCTA.astro';
import { industries, products } from '../../data/site';
import { driveCardVisuals } from '../../data/driveVisuals';
import '../../styles/industry-pages.css';

type IndustryProfile = {
  rhythm: string;
  stock: string;
  customer: string;
  finance: string;
  signal: string;
  problem: string;
  module: string;
};

const industryProfiles: Record<string, IndustryProfile> = {
  retail: { rhythm: 'Cepat, sepanjang hari', stock: 'Banyak SKU; laju berbeda', customer: 'Datang langsung dan kembali', finance: 'Omzet, margin, kas harian', signal: 'SKU cepat laku', problem: 'Stok kritis dan selisih shift', module: 'Penjualan + Inventori' },
  fnb: { rhythm: 'Mengikuti jam makan', stock: 'Bahan bergerak dan terbuang', customer: 'Kembali karena menu', finance: 'Penjualan, bahan, sisa terbuang', signal: 'Jam ramai', problem: 'Menu habis dan waste bahan', module: 'Penjualan + Keuangan' },
  distributor: { rhythm: 'Pesanan besar dan bertahap', stock: 'Volume tinggi', customer: 'Repeat order dan tempo', finance: 'Kas dan piutang', signal: 'Pesanan ulang', problem: 'Alokasi stok dan invoice tertunda', module: 'Penjualan + Pelanggan' },
  'reseller-online': { rhythm: 'Datang dari beberapa kanal', stock: 'Cepat mengikuti tren', customer: 'Riwayat tersebar', finance: 'Margin produk dan kanal', signal: 'Margin per kanal', problem: 'Fee kanal mengubah margin', module: 'Katalog + Penjualan' },
  jasa: { rhythm: 'Mengikuti layanan dan periode', stock: 'Bukan fokus utama', customer: 'Butuh layanan berulang', finance: 'Pendapatan dan biaya layanan', signal: 'Layanan konsisten', problem: 'Biaya pengerjaan belum terlihat', module: 'Keuangan + Pelanggan' },
  'manufaktur-kecil': { rhythm: 'Produksi bertemu penjualan', stock: 'Bahan dan barang jadi', customer: 'Pesanan mengikuti kapasitas', finance: 'Biaya produksi dan kas', signal: 'Bahan vs barang jadi', problem: 'Bahan rusak dan reorder terlambat', module: 'Inventori + Keuangan' },
};

const sharedModules = products.filter((product) => ['Dashboard Bisnis', 'Laporan & Insight', 'Asisten AI'].includes(product.title));
const industryCloseVisual = driveCardVisuals.operationsContext;
const exampleFlow = [
  { label: 'Buka toko', text: 'Cek stok kritis sebelum pelanggan datang.' },
  { label: 'Jaga shift', text: 'Catat transaksi dan koreksi dengan status yang jelas.' },
  { label: 'Periksa sinyal', text: 'Bandingkan produk laris dengan saldo yang tersisa.' },
  { label: 'Tutup hari', text: 'Tentukan siapa yang memeriksa selisih atau restock.' },
];
---

<BaseLayout title="RAMUNI untuk Berbagai Industri" description="Pilih konteks usaha dan lihat masalah operasional, data, serta modul RAMUNI yang paling relevan.">
  <div class="container audience-breadcrumb industry-hub-breadcrumb">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Beranda</a><span aria-hidden="true">/</span><span aria-current="page">Industri</span></nav>
  </div>

  <section class="section industry-hub-hero" aria-labelledby="industry-hub-title">
    <div class="container">
      <div class="industry-hub-hero__intro reveal">
        <p class="eyebrow">Industri</p>
        <h1 id="industry-hub-title">Mulai dari masalah operasional yang paling sering muncul.</h1>
        <p class="lede">Pilih jenis usaha Anda. Contoh alur, pertanyaan, dan modul di dalamnya mengikuti pekerjaan yang benar-benar perlu diperiksa.</p>
        <div class="button-row"><a class="button button--primary" href="#daftar-industri">Pilih industri</a></div>
      </div>
      <div class="industry-hub-hero__chooser" id="daftar-industri">
        <div class="industry-hub-hero__chooser-head">
          <h2>Masalahnya spesifik. Dasar datanya tetap jelas.</h2>
          <p>Setiap halaman dimulai dari pertanyaan yang biasa muncul di lapangan, bukan dari daftar fitur.</p>
        </div>
        <nav class="industry-hub-hero__cards" aria-label="Pilih industri">
          {industries.map((industry, index) => {
            const profile = industryProfiles[industry.slug];
            return <a class="industry-hub-hero__card reveal" style={`--i:${index}`} href={`/industri/${industry.slug}/`}>
              <span>{profile.signal}</span>
              <strong>{industry.title}</strong>
              <p>{profile.problem}</p>
              <small>{profile.module}</small>
              <b aria-hidden="true">Lihat contoh</b>
            </a>;
          })}
        </nav>
      </div>
    </div>
  </section>

  <section class="section surface industry-hub-comparison" id="perbandingan" aria-labelledby="comparison-title">
    <div class="container">
      <div class="industry-hub-section-head reveal">
        <h2 id="comparison-title">Satu angka dibaca dengan konteks berbeda.</h2>
        <p class="lede">Bandingkan pola transaksi, stok, pelanggan, dan keuangan sebelum memilih halaman yang paling dekat dengan usaha Anda.</p>
      </div>
      <div class="industry-hub-table reveal" role="region" aria-label="Perbandingan kebutuhan industri" tabindex="0">
        <table>
          <thead><tr><th scope="col">Industri</th><th scope="col">Masalah utama</th><th scope="col">Transaksi</th><th scope="col">Stok</th><th scope="col">Pelanggan</th><th scope="col">Keuangan</th></tr></thead>
          <tbody>
            {industries.map((industry) => {
              const profile = industryProfiles[industry.slug];
              return <tr><th scope="row"><a href={`/industri/${industry.slug}/`}>{industry.title}</a></th><td>{profile.problem}</td><td>{profile.rhythm}</td><td>{profile.stock}</td><td>{profile.customer}</td><td>{profile.finance}</td></tr>;
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section industry-hub-usecase" id="contoh-alur" aria-labelledby="usecase-title">
    <div class="container industry-hub-usecase__layout">
      <div class="industry-hub-usecase__copy reveal">
        <h2 id="usecase-title">Satu hari kerja, satu urutan pemeriksaan.</h2>
        <p>Contoh retail ini menunjukkan bagaimana RAMUNI menyusun pertanyaan dari buka toko sampai tutup shift. Industri lain memakai urutan yang berbeda, tetapi keputusan tetap berangkat dari data yang dapat diperiksa.</p>
        <ol>
          {exampleFlow.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><strong>{step.label}</strong><p>{step.text}</p></div></li>)}
        </ol>
      </div>
      <figure class="industry-hub-usecase__visual reveal">
        <img src={industryCloseVisual.src} width={industryCloseVisual.width} height={industryCloseVisual.height} alt={industryCloseVisual.alt} loading="lazy" decoding="async" />
        <figcaption><strong>Contoh ruang kerja operasional</strong><span>{industryCloseVisual.note}</span></figcaption>
      </figure>
    </div>
    <div class="container industry-hub-usecase__modules reveal">
      <strong>Fondasi lintas industri</strong>
      <div>{sharedModules.map((product) => <a href={`/produk/${product.slug}/`}>{product.title}</a>)}</div>
    </div>
  </section>

  <section class="section industry-hub-cta" id="cta" aria-labelledby="industry-cta-title">
    <div class="container reveal">
      <TourEvidenceCTA
        headingId="industry-cta-title"
        eyebrow="Langkah berikutnya"
        title="Bawa satu masalah yang ingin Anda periksa."
        body="Kami bantu memetakan data, urutan kerja, dan modul yang relevan tanpa meminta data usaha sensitif."
        primaryLabel="Konsultasi"
        primaryHref="/tour-produk-gratis/?flow=consultation&intent=overview"
        secondaryLabel="Baca Panduan"
        secondaryHref="/panduan/"
        theme="ink"
        visual={industryCloseVisual}
        visualBadge="Ilustrasi ruang kerja operasional"
        points={['Pilih konteks usaha', 'Cocokkan masalah utama', 'Bahas langkah pemeriksaannya']}
      />
    </div>
  </section>
</BaseLayout>

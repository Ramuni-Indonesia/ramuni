      { label: 'Biaya pendukung contoh', value: 'Rp1,6 juta', note: 'Dikelompokkan pada periode yang sama.' },
      { label: 'Pesanan berulang contoh', value: '3 pesanan', note: 'Ditinjau tanpa mengirim tindak lanjut otomatis.' },
    ],
  },
  'manufaktur-kecil': {

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MascotDecisionCTA from '../../components/MascotDecisionCTA.astro';
import PageHero from '../../components/PageHero.astro';
import ProductScreenshotRail from '../../components/ProductScreenshotRail.astro';
import { industries, products, resources, roles, solutions } from '../../data/site';
import { getIndustryDriveVisuals, toProductScreen } from '../../data/driveVisuals';
import { releaseGates } from '../../config/release';
import { pageLastmods } from '../../data/pageLastmods';
import '../../styles/industry-pages.css';

type IndustryBrief = {
  fit: string[];
  boundaries: string[];
  workflow: string[];
  pains: string[];
  dataNeeds: string[];
  modules: string[];
  questions: string[];
  scenario: string;
  onboarding: { title: string; text: string }[];
  faq: { question: string; answer: string }[];
  privacy: string;
  roleSlugs: string[];
  solutionSlugs: string[];
  resourceHrefs: string[];
  exampleMetrics: { label: string; value: string; note: string }[];
};


      { label: 'Penjualan contoh hari ini', value: '12 unit', note: 'Dipakai untuk membaca kecepatan stok, bukan proyeksi.' },
      { label: 'Selisih yang perlu dicek', value: '2 unit', note: 'Memicu pemeriksaan catatan dan stok fisik.' },

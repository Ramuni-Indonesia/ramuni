export function getStaticPaths() {
  return industries.map((industry) => ({ params: { slug: industry.slug }, props: { industry } }));
}

const { industry } = Astro.props;
const brief = industryBriefs[industry.slug];
const industryHeadings: Record<string, { hero: string; fit: string; workflow: string; signals: string; modules: string }> = {
  retail: { hero: 'Jangan tunggu rak kosong untuk mengecek stok.', fit: 'Toko ramai butuh catatan produk yang tetap rapi.', workflow: 'Mulai pagi dari stok kritis dan produk yang sedang laris.', signals: 'Bedakan produk laris, stok lambat, dan selisih catatan.', modules: 'Penjualan dan inventori dibaca dalam satu alur.' },
  fnb: { hero: 'Baca menu laris bersama bahan dan jam ramai.', fit: 'Menu, bahan, dan biaya perlu bertemu di periode yang sama.', workflow: 'Siapkan bahan sebelum jam ramai, bukan setelah menu habis.', signals: 'Lihat menu, bahan, waktu, dan biaya sebagai satu cerita.', modules: 'Hubungkan penjualan menu dengan stok serta biaya.' },
  distributor: { hero: 'Pesanan besar belum tentu membuat kas longgar.', fit: 'Pesanan ulang, stok, dan pembayaran perlu dibaca bersama.', workflow: 'Mulai dari pesanan aktif dan pelanggan yang biasa membeli ulang.', signals: 'Temukan produk yang bergerak dan pembayaran yang tertunda.', modules: 'Jaga pesanan, pelanggan, stok, dan kas tetap terhubung.' },
  'reseller-online': { hero: 'Produk ramai belum tentu memberi margin sehat.', fit: 'Catatan beberapa kanal perlu memakai kode produk yang sama.', workflow: 'Satukan penjualan sebelum membandingkan produk dan margin.', signals: 'Pisahkan produk ramai, produk untung, dan kanal yang perlu dicek.', modules: 'Katalog yang rapi membuat perbandingan kanal lebih masuk akal.' },
  jasa: { hero: 'Layanan laris perlu dibaca bersama biaya pengerjaan.', fit: 'Pendapatan per layanan baru berarti setelah biayanya terlihat.', workflow: 'Tutup minggu dengan pendapatan dan biaya per layanan.', signals: 'Lihat layanan berulang, biaya naik, dan pelanggan yang kembali.', modules: 'Keuangan dan pelanggan menjelaskan kesehatan setiap layanan.' },
  'manufaktur-kecil': { hero: 'Pisahkan bahan menipis dari barang jadi yang laku.', fit: 'Bahan, barang jadi, penjualan, dan biaya perlu satu urutan.', workflow: 'Cek bahan utama sebelum menentukan produksi berikutnya.', signals: 'Baca stok bahan, barang jadi, biaya, dan penjualan bersama.', modules: 'Inventori dan penjualan memberi dasar sebelum produksi.' },
};
const headings = industryHeadings[industry.slug];
const industryDayScenes: Record<string, string> = {
  retail: 'Buka toko → stok kritis → transaksi → tutup shift',
  fnb: 'Persiapan bahan → jam ramai → menu habis → food cost',
  distributor: 'Pesanan → alokasi stok → pengiriman → invoice tertunda',
  'reseller-online': 'Kanal → order → fee kanal → margin → stok',
  jasa: 'Booking → pengerjaan → biaya → pembayaran → repeat',
  'manufaktur-kecil': 'Bahan → produksi → barang jadi → biaya → reorder',
};
const industryIntentBySlug: Record<string, string> = {
  retail: 'stock',
  fnb: 'finance',
  distributor: 'customer',
  'reseller-online': 'sales',
  jasa: 'finance',
  'manufaktur-kecil': 'stock',
};
const industryTourHref = `/tour-produk-gratis/?flow=consultation&intent=${industryIntentBySlug[industry.slug] || 'overview'}`;
const industryTourLabel = `Bahas alur ${industry.title}`;
const supportingProducts = products.filter((product) => brief.modules.includes(product.title));
const relevantRoles = roles.filter((role) => brief.roleSlugs.includes(role.slug));
const relatedSolutions = solutions.filter((solution) => brief.solutionSlugs.includes(solution.slug));
const relatedResources = resources.filter((resource) => brief.resourceHrefs.includes(resource.href));
const industryDriveSet = getIndustryDriveVisuals(industry.slug);
const industryScreens = [industryDriveSet.primary, ...industryDriveSet.supporting.slice(0, 1)].map(toProductScreen);
const canonicalPath = `/industri/${industry.slug}/`;
const industryUrl = new URL(canonicalPath, Astro.site || Astro.url.origin).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': industryUrl,
  url: industryUrl,
  name: `RAMUNI untuk ${industry.title}`,
  description: `RAMUNI untuk ${industry.title}: alur harian, data yang dibutuhkan, fitur terkait, dan pertanyaan operasional.`,
  dateModified: pageLastmods.industry,
  inLanguage: 'id-ID',
};
---
<BaseLayout title={'RAMUNI untuk ' + industry.title} description={'RAMUNI untuk ' + industry.title + ': alur harian, data yang dibutuhkan, fitur terkait, dan pertanyaan operasional.'} canonical={canonicalPath} noindex={!releaseGates.claimPagesIndexable} schema={structuredData}>
  <div class="container audience-breadcrumb"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Beranda</a><span aria-hidden="true">/</span><a href="/industri/">Industri</a><span aria-hidden="true">/</span><span aria-current="page">{industry.title}</span></nav></div>
  <PageHero compact eyebrow={`RAMUNI untuk ${industry.title}`} title={headings.hero} description={industry.question} primaryLabel={industryTourLabel} primaryHref={industryTourHref} secondaryLabel="Semua Industri" secondaryHref="/industri/" />

  <ProductScreenshotRail
    id={`industry-${industry.slug}-screens`}
    eyebrow="Tampilan produk"
    heading={`Satu layar untuk memeriksa ${industry.title.toLowerCase()}.`}
    body="Capture workspace RAMUNI memakai data demo terkontrol. Gunakan ini untuk melihat bentuk pemeriksaan sebelum membahas modul."
    items={industryScreens}
    compact
  />

  <section class="section industry-detail-day" id="alur-harian" aria-labelledby="daily-title">
    <div class="container">
      <div class="industry-detail-section-head reveal"><div><p class="eyebrow">Satu hari kerja</p><h2 id="daily-title">{headings.workflow}</h2></div><p class="lede">{industryDayScenes[industry.slug]}</p></div>
      <div class="industry-detail-day__layout">
        <ol class="industry-detail-day__steps">{brief.workflow.map((step, index) => <li class="reveal"><span>{String(index + 1).padStart(2, '0')}</span><div><strong>{step}</strong><p>{brief.questions[index % brief.questions.length]}</p></div></li>)}</ol>
        <aside class="industry-detail-fit reveal">
          <div><strong>Cocok untuk</strong><ul>{brief.fit.map((item) => <li>{item}</li>)}</ul></div>
          <div><strong>Batas saat ini</strong><ul>{brief.boundaries.map((item) => <li>{item}</li>)}</ul></div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section surface industry-detail-modules" id="modul-peran" aria-labelledby="modules-title">
    <div class="container">
      <div class="industry-detail-section-head reveal"><div><h2 id="modules-title">{headings.modules}</h2></div><p class="lede">Pilih modul dari kejadian yang perlu diperiksa, bukan dari daftar fitur yang panjang.</p></div>
      <div class="industry-detail-modules__layout">
        <div class="industry-detail-module-list">{supportingProducts.map((product) => <a class="industry-detail-module reveal" href={'/produk/' + product.slug + '/'}><strong>{product.title}</strong><span>{product.safety}</span><b aria-hidden="true">Buka</b></a>)}</div>
        <aside class="industry-detail-exceptions reveal">
          <strong>Pengecualian yang perlu dibuka</strong>
          <ul>{brief.pains.map((pain) => <li>{pain}</li>)}</ul>
          <p>Contoh pertanyaan</p>
          <blockquote>“{brief.questions[0]}”</blockquote>
        </aside>
      </div>
      <div class="industry-detail-metrics reveal" aria-label="Contoh metrik usaha">
        {brief.exampleMetrics.map((metric) => <div><span>{metric.label}</span><strong>{metric.value}</strong><small>{metric.note}</small></div>)}
      </div>
      <nav class="industry-detail-links reveal" aria-label={`Tautan lanjutan untuk ${industry.title}`}>
        <div><strong>Peran yang biasanya terlibat</strong>{relevantRoles.map((role) => <a href={'/untuk/' + role.slug + '/'}>{role.title}</a>)}</div>
        <div><strong>Lanjutkan membaca</strong>{relatedSolutions.map((solution) => <a href={'/solusi/' + solution.slug + '/'}>{solution.title}</a>)}{relatedResources.map((resource) => <a href={resource.href}>{resource.title}</a>)}</div>
      </nav>
    </div>
  </section>

  <section class="section industry-detail-setup" id="siapkan" aria-labelledby="setup-title">
    <div class="container industry-detail-setup__layout">
      <div class="industry-detail-section-head reveal"><div><p class="eyebrow">Siapkan data</p><h2 id="setup-title">Mulai dari data yang paling dekat dengan pekerjaan harian.</h2></div><p class="lede">{brief.privacy}</p></div>
      <ol class="industry-detail-setup__steps">{brief.onboarding.map((item, index) => <li class="reveal"><span>{String(index + 1).padStart(2, '0')}</span><div><strong>{item.title}</strong><p>{item.text}</p></div></li>)}</ol>
      <aside class="industry-detail-data-note reveal"><strong>Data yang perlu disiapkan</strong><ul>{brief.dataNeeds.map((item) => <li>{item}</li>)}</ul><p>Gunakan skenario demo bila Anda belum siap membagikan data usaha.</p></aside>
    </div>
  </section>

  <section class="section surface industry-detail-close" id="faq" aria-labelledby="faq-title">
    <div class="container industry-detail-close__layout">
      <div class="industry-detail-faq reveal"><p class="eyebrow">Pertanyaan umum</p><h2 id="faq-title">Sebelum membahas alurnya.</h2><div class="faq-list">{brief.faq.slice(0, 2).map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}<details><summary>Apakah saya perlu mengirim data bisnis untuk mencoba?</summary><p>Tidak. Kami menyiapkan skenario awal agar Anda dapat memahami alurnya dengan aman.</p></details></div></div>
      <div class="industry-detail-close__cta reveal">
      <MascotDecisionCTA
        headingId="cta-title"
        eyebrow={'Langkah berikutnya untuk ' + industry.title}
        title="Bawa satu pertanyaan, lalu periksa alurnya bersama."
        body="Lihat contoh data dan batas fitur sebelum menentukan langkah yang sesuai dengan usaha Anda."
        primaryLabel={industryTourLabel}
        primaryHref={industryTourHref}
        secondaryLabel="Lihat Solusi"
        secondaryHref="/solusi/"
        theme="teal"
        mascot="evidence3d"
      />
      </div>
    </div>
  </section>
</BaseLayout>

    resourceHrefs: ['/panduan', '/template'],
    exampleMetrics: [
      { label: 'Barang jadi contoh', value: '26 unit', note: 'Saldo sintetis sebelum jadwal produksi berikutnya.' },
      { label: 'Penjualan contoh', value: '19 unit', note: 'Dicatat untuk periode tujuh hari.' },
      { label: 'Bahan utama contoh', value: '42 kg', note: 'Perlu dibandingkan dengan kebutuhan produksi secara manual.' },
    ],
  },
};

export function getStaticPaths() {
  return industries.map((industry) => ({ params: { slug: industry.slug }, props: { industry } }));
}

const { industry } = Astro.props;
const brief = industryBriefs[industry.slug];
const industryHeadings: Record<string, { hero: string; fit: string; workflow: string; signals: string; modules: string }> = {
  retail: { hero: 'Jangan tunggu rak kosong untuk mengecek stok.', fit: 'Toko ramai butuh catatan produk yang tetap rapi.', workflow: 'Mulai pagi dari stok kritis dan produk yang sedang laris.', signals: 'Bedakan produk laris, stok lambat, dan selisih catatan.', modules: 'Penjualan dan inventori dibaca dalam satu alur.' },
  fnb: { hero: 'Baca menu laris bersama bahan dan jam ramai.', fit: 'Menu, bahan, dan biaya perlu bertemu di periode yang sama.', workflow: 'Siapkan bahan sebelum jam ramai, bukan setelah menu habis.', signals: 'Lihat menu, bahan, waktu, dan biaya sebagai satu cerita.', modules: 'Hubungkan penjualan menu dengan stok serta biaya.' },
  distributor: { hero: 'Pesanan besar belum tentu membuat kas longgar.', fit: 'Pesanan ulang, stok, dan pembayaran perlu dibaca bersama.', workflow: 'Mulai dari pesanan aktif dan pelanggan yang biasa membeli ulang.', signals: 'Temukan produk yang bergerak dan pembayaran yang tertunda.', modules: 'Jaga pesanan, pelanggan, stok, dan kas tetap terhubung.' },
  'reseller-online': { hero: 'Produk ramai belum tentu memberi margin sehat.', fit: 'Catatan beberapa kanal perlu memakai kode produk yang sama.', workflow: 'Satukan penjualan sebelum membandingkan produk dan margin.', signals: 'Pisahkan produk ramai, produk untung, dan kanal yang perlu dicek.', modules: 'Katalog yang rapi membuat perbandingan kanal lebih masuk akal.' },
  jasa: { hero: 'Layanan laris perlu dibaca bersama biaya pengerjaan.', fit: 'Pendapatan per layanan baru berarti setelah biayanya terlihat.', workflow: 'Tutup minggu dengan pendapatan dan biaya per layanan.', signals: 'Lihat layanan berulang, biaya naik, dan pelanggan yang kembali.', modules: 'Keuangan dan pelanggan menjelaskan kesehatan setiap layanan.' },
  'manufaktur-kecil': { hero: 'Pisahkan bahan menipis dari barang jadi yang laku.', fit: 'Bahan, barang jadi, penjualan, dan biaya perlu satu urutan.', workflow: 'Cek bahan utama sebelum menentukan produksi berikutnya.', signals: 'Baca stok bahan, barang jadi, biaya, dan penjualan bersama.', modules: 'Inventori dan penjualan memberi dasar sebelum produksi.' },
};
const headings = industryHeadings[industry.slug];
const supportingProducts = products.filter((product) => brief.modules.includes(product.title));
const relevantRoles = roles.filter((role) => brief.roleSlugs.includes(role.slug));
const relatedSolutions = solutions.filter((solution) => brief.solutionSlugs.includes(solution.slug));
const relatedResources = resources.filter((resource) => brief.resourceHrefs.includes(resource.href));
---
<BaseLayout title={'RAMUNI untuk ' + industry.title} description={'Concept Preview RAMUNI untuk konteks ' + industry.title + ': alur harian, data yang dibutuhkan, batas klaim, dan pertanyaan operasional.'} noindex={!releaseGates.claimPagesIndexable}>
  <div class="container audience-breadcrumb"><nav class="breadcrumbs"><a href="/">Beranda</a><span>/</span><a href="/industri">Industri</a><span>/</span><span>{industry.title}</span></nav></div>
  <PageHero eyebrow={`RAMUNI untuk ${industry.title}`} title={headings.hero} description={industry.question} primaryLabel="Lihat Demo" primaryHref="/demo" secondaryLabel="Semua Industri" secondaryHref="/industri" />

  <section class="section surface" id="kecocokan" aria-labelledby="fit-title">
    <div class="container audience-split">
      <div class="audience-section-heading reveal">
        <h2 id="fit-title">{headings.fit}</h2>
        <p class="lede">Gunakan halaman ini untuk menilai kecocokan alur. Fitur final mengikuti hasil pengujian RAMUNI.</p>
      </div>
      <div class="audience-boundary-ledger reveal">
        <div><strong>Cocok untuk</strong><ul>{brief.fit.map((item) => <li>{item}</li>)}</ul></div>
        <div><strong>Batas saat ini</strong><ul>{brief.boundaries.map((item) => <li>{item}</li>)}</ul></div>
      </div>
    </div>
  </section>

  <section class="section" id="alur-harian" aria-labelledby="daily-title">
    <div class="container audience-day">
      <div class="audience-section-heading reveal"><h2 id="daily-title">{headings.workflow}</h2></div>
      <ol class="audience-timeline industry-timeline">{brief.workflow.map((step, index) => <li class="reveal" data-observe-active><span>{String(index + 1).padStart(2, '0')}</span><p>{step}</p></li>)}</ol>
    </div>
  </section>

  <section class="section surface" id="sinyal" aria-labelledby="signals-title">
    <div class="container audience-dashboard">
      <div class="audience-section-heading reveal"><h2 id="signals-title">{headings.signals}</h2></div>
      <div class="audience-signal-board reveal">
        <div><strong>Masalah sehari-hari</strong>{brief.pains.map((pain) => <p>{pain}</p>)}</div>
        <div><strong>Data yang dibutuhkan</strong>{brief.dataNeeds.map((need) => <p>{need}</p>)}</div>
        <div><strong>Contoh pertanyaan AI</strong>{brief.questions.map((question) => <p>{question}</p>)}</div>
      </div>
    </div>
  </section>

  <section class="section" id="skenario" aria-labelledby="scenario-title">
    <div class="container audience-scenario reveal"><h2 id="scenario-title">Satu hari dalam konteks {industry.title}.</h2><p>{brief.scenario}</p></div>
  </section>

  <section class="section surface" id="metrik-contoh" aria-labelledby="metrics-title">
    <div class="container audience-split">
      <div class="audience-section-heading reveal"><p class="eyebrow">Data sintetis</p><h2 id="metrics-title">Angka contoh untuk membaca skenario, bukan hasil pelanggan.</h2><p class="lede">Nilai ini hanya memperlihatkan hubungan antarcatatan. RAMUNI tidak mengklaim hasil usaha dari angka berikut.</p></div>
      <dl class="audience-permission-ledger reveal">{brief.exampleMetrics.map((metric) => <div><dt>{metric.label}</dt><dd><strong>{metric.value}</strong><span>{metric.note}</span></dd></div>)}</dl>
    </div>
  </section>

  <section class="section" id="modul-peran" aria-labelledby="modules-title">
    <div class="container audience-split">
      <div class="audience-section-heading reveal"><h2 id="modules-title">{headings.modules}</h2><p class="lede">Mulai dari catatan yang paling sering dipakai tim.</p></div>
      <div class="audience-module-list">{supportingProducts.map((product) => <a class="audience-module-row reveal" href={'/produk/' + product.slug}><strong>{product.title}</strong><span>{product.safety}</span></a>)}</div>
    </div>
    <div class="container audience-related reveal"><strong>Peran yang biasanya terlibat</strong><div>{relevantRoles.map((role) => <a href={'/untuk/' + role.slug}>{role.title}</a>)}</div></div>
    <nav class="container audience-related reveal" aria-label={`Tautan lanjutan untuk ${industry.title}`}>
      <strong>Lanjutkan dari kebutuhan usaha</strong>
      <div>{relatedSolutions.map((solution) => <a href={'/solusi/' + solution.slug}>{solution.title}</a>)}</div>
      <strong>Sumber daya terkait</strong>
      <div>{relatedResources.map((resource) => <a href={resource.href}>{resource.title}</a>)}</div>
    </nav>
  </section>

  <section class="section" id="onboarding" aria-labelledby="onboarding-title">
    <div class="container audience-split">
      <div class="audience-section-heading reveal"><h2 id="onboarding-title">Siapkan data yang paling dekat dengan pekerjaan harian.</h2></div>
      <ol class="audience-ledger">{brief.onboarding.map((item, index) => <li class="reveal"><span>{String(index + 1).padStart(2, '0')}</span><div><strong>{item}</strong><p>{index === 0 ? 'Mulai dari data yang paling sering dipakai tim.' : 'Gunakan definisi sederhana agar mudah dicek ulang.'}</p></div></li>)}</ol>
    </div>
  </section>

  <section class="section surface" id="privasi-faq" aria-labelledby="privacy-title">
    <div class="container audience-split">
      <div class="audience-section-heading reveal"><p class="eyebrow">Privasi</p><h2 id="privacy-title">Batas data tetap dijaga.</h2><p class="lede">{brief.privacy}</p></div>
      <div class="faq-list reveal">
        <details><summary>Apakah RAMUNI sudah punya paket khusus {industry.title}?</summary><p>Belum tentu. Halaman ini masih berupa gambaran awal, bukan paket industri yang sudah tersedia.</p></details>
        <details><summary>Apakah saya perlu mengirim data bisnis untuk demo?</summary><p>Tidak. Demo publik memakai data sintetis dan formulir tidak boleh menerima data pelanggan atau transaksi sensitif.</p></details>
      </div>
    </div>
  </section>

  <section class="section" id="cta" aria-labelledby="cta-title">
    <div class="container audience-closing reveal"><div><h2 id="cta-title">Cocokkan kebutuhan usaha {industry.title} dengan alur RAMUNI.</h2><p>Bawa pertanyaan utama, cara menyiapkan data, dan batas fitur yang perlu dikonfirmasi.</p></div><a class="button button--primary" href="/demo">Konsultasikan Kebutuhan</a></div>
  </section>
</BaseLayout>

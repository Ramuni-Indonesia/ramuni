    ],
    privacy: 'Demo dan contoh F&B memakai data sintetis. Jangan memasukkan data pelanggan atau transaksi sensitif ke formulir publik.',
    roleSlugs: ['pemilik-usaha', 'admin-toko', 'kasir', 'supervisor'],
    solutionSlugs: ['kelola-stok', 'pantau-laba-dan-arus-kas'],
    resourceHrefs: ['/panduan/', '/kalkulator/'],
    exampleMetrics: [
      { label: 'Pesanan menu contoh', value: '18 porsi', note: 'Dicatat pada periode makan siang.' },
      { label: 'Stok bahan contoh', value: '11 porsi', note: 'Menunjukkan kebutuhan pemeriksaan sebelum jam ramai.' },

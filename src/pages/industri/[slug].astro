---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AudienceContextBoard from '../../components/AudienceContextBoard.astro';
import MascotDecisionCTA from '../../components/MascotDecisionCTA.astro';
import PageHero from '../../components/PageHero.astro';
import type { HeroContextScene } from '../../components/HeroContextVisual.astro';
import { industries, products, resources, roles, solutions } from '../../data/site';
import { releaseGates } from '../../config/release';

type IndustryBrief = {
  fit: string[];
  boundaries: string[];
  workflow: string[];
  pains: string[];
  dataNeeds: string[];
  modules: string[];
  questions: string[];
  scenario: string;
  onboarding: { title: string; text: string }[];
  faq: { question: string; answer: string }[];
  privacy: string;
  roleSlugs: string[];
  solutionSlugs: string[];
  resourceHrefs: string[];
  exampleMetrics: { label: string; value: string; note: string }[];
};

const industryBriefs: Record<string, IndustryBrief> = {
  retail: {
    fit: ['Toko dengan banyak SKU aktif', 'Pemilik yang perlu memantau stok cepat bergerak', 'Tim kasir dan admin yang berbagi catatan'],
    boundaries: ['Tidak menyiratkan multi-gudang lanjutan', 'Tidak menjanjikan POS enterprise lengkap', 'Integrasi perangkat mengikuti status rilis'],
    workflow: ['Cek stok kritis sebelum toko ramai', 'Catat penjualan dan koreksi dengan jejak', 'Bandingkan produk laris dengan saldo stok', 'Tentukan restock atau pemeriksaan fisik'],
    pains: ['Produk laris habis tanpa peringatan', 'Barang lambat menumpuk', 'Selisih catatan kasir dan stok sulit ditelusuri'],
    dataNeeds: ['Katalog produk dan SKU', 'Transaksi penjualan', 'Saldo dan pergerakan stok', 'Batas stok minimum'],
    modules: ['Katalog Produk', 'Penjualan', 'Inventori', 'Dashboard Bisnis'],

    pains: ['Bahan terlihat cukup tetapi barang jadi menipis', 'Biaya produksi tidak terbaca bersama penjualan', 'Keputusan dibuat dari ingatan'],
    dataNeeds: ['Produk jadi', 'Bahan atau item stok utama', 'Transaksi penjualan', 'Pengeluaran produksi sederhana'],
    modules: ['Inventori', 'Penjualan', 'Keuangan', 'Dashboard Bisnis'],
    questions: ['Produk mana yang membutuhkan perhatian stok?', 'Bahan apa yang perlu dicek sebelum produksi?', 'Biaya apa yang berubah minggu ini?'],
    scenario: 'Sebelum produksi berikutnya, pemilik melihat barang jadi tertentu menipis. RAMUNI membantu mengecek penjualan, stok, dan biaya terkait tanpa menjanjikan perencanaan produksi lengkap.',
    onboarding: ['Pisahkan bahan dan barang jadi', 'Tentukan unit stok', 'Catat biaya utama secara konsisten'],
    privacy: 'Data produksi sensitif tidak perlu dimasukkan ke formulir publik atau demo website.',
    roleSlugs: ['pemilik-usaha', 'admin-toko', 'supervisor'],

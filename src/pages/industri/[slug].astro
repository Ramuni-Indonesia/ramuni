      { label: 'Stok produk utama', value: '32 karton', note: 'Dibandingkan dengan pesanan yang sudah tercatat.' },
      { label: 'Pelanggan ulang contoh', value: '4 akun', note: 'Hanya menjadi daftar tinjauan, tanpa pesan otomatis.' },
    ],
  },
  'reseller-online': {
    fit: ['Reseller dengan beberapa kanal catatan', 'Produk dan margin sering berubah', 'Pemilik yang perlu melihat produk bernilai tinggi'],

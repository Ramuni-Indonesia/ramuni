    solutionSlugs: ['naikkan-omzet', 'pahami-pelanggan'],
    resourceHrefs: ['/kalkulator', '/template'],
    exampleMetrics: [
      { label: 'Penjualan produk contoh', value: '24 unit', note: 'Gabungan catatan dari kanal yang sudah dimasukkan.' },
      { label: 'Harga jual contoh', value: 'Rp85 ribu', note: 'Dibandingkan dengan HPP yang diketahui.' },
      { label: 'HPP contoh', value: 'Rp58 ribu', note: 'Belum memasukkan biaya kanal yang datanya belum tersedia.' },
    ],
  },
  jasa: {
    fit: ['Usaha jasa dengan pendapatan per layanan', 'Pemilik yang memantau biaya dan pelanggan', 'Tim yang perlu melihat layanan mana yang konsisten'],
    boundaries: ['RAMUNI bukan alat pengelolaan proyek lengkap', 'Pencatatan waktu dan perencanaan tenaga kerja mengikuti status fitur', 'Konteks proyek hanya sejauh data operasional tersedia'],
    workflow: ['Catat pendapatan layanan', 'Kelompokkan biaya', 'Lihat pelanggan atau layanan berulang', 'Tentukan layanan yang perlu diprioritaskan'],
    pains: ['Pendapatan terlihat naik tetapi biaya ikut naik', 'Layanan laris belum tentu sehat', 'Konteks pelanggan tersebar'],
    dataNeeds: ['Jenis layanan', 'Pendapatan', 'Pengeluaran', 'Pelanggan atau sumber pesanan bila sesuai izin'],
    modules: ['Keuangan', 'Pelanggan', 'Dashboard Bisnis', 'Laporan & Insight'],
    questions: ['Layanan mana yang paling konsisten menghasilkan pendapatan?', 'Biaya apa yang naik bersama pekerjaan?', 'Pelanggan mana yang perlu ditindaklanjuti secara aman?'],
    scenario: 'Akhir minggu, pemilik melihat satu layanan sering dipesan tetapi biaya pendukung ikut naik. RAMUNI membantu membaca pendapatan dan pengeluaran bersama.',
    onboarding: ['Kelompokkan layanan', 'Pisahkan biaya utama', 'Tentukan periode laporan yang konsisten'],
    privacy: 'Informasi pelanggan tidak boleh masuk URL, formulir publik, atau catatan yang dapat dilihat umum.',

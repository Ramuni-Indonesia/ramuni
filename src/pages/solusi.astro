---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { industries, solutions } from '../data/site';
import '../styles/other-pages-refinement.css';

const painClusters = [
  { label: 'Penjualan', text: 'Omzet berubah, tetapi pemicunya belum jelas.', prompt: 'Bandingkan produk dan waktu sebelum mengubah promosi.', bars: [42, 66, 51, 82, 57] },
  { label: 'Stok', text: 'Barang cepat laku dan saldo stok perlu dibaca bersama.', prompt: 'Periksa laju jual, sisa stok, dan jejak koreksi.', bars: [78, 54, 88, 47, 63] },
  { label: 'Keuangan', text: 'Omzet, biaya, laba, dan kas masih dibaca terpisah.', prompt: 'Pisahkan aliran uang sebelum menilai kondisi usaha.', bars: [86, 69, 48, 61, 44] },
  { label: 'Pelanggan', text: 'Riwayat ada, pola pembelian belum terlihat.', prompt: 'Lihat pembelian ulang tanpa mengirim pesan otomatis.', bars: [38, 52, 47, 72, 81] },
];

const solutionFaq = [
  { question: 'Bagaimana memilih solusi yang tepat?', answer: 'Mulai dari gejala yang paling sering menghambat keputusan, lalu periksa modul dan data yang dibutuhkan.' },
  { question: 'Apakah RAMUNI menjamin hasil bisnis?', answer: 'Tidak. RAMUNI membantu membaca pola dan bukti. Hasil tetap dipengaruhi keputusan dan kondisi usaha.' },
  { question: 'Data apa yang dibutuhkan untuk mulai?', answer: 'Tergantung masalahnya. Demo memetakan catatan minimum tanpa meminta data sensitif.' },
];
---
<BaseLayout title="Solusi Bisnis RAMUNI" description="Mulai dari masalah penjualan, stok, laba, pelanggan, atau laporan dan lihat bagaimana RAMUNI membantu menyusun konteksnya.">
  <main class="solution-hub">
    <section class="solution-hub-hero">
      <div class="container solution-hub-hero__layout">
        <div><Breadcrumbs items={[{ label: 'Beranda', href: '/' }, { label: 'Solusi' }]} /><p class="section-kicker">Solusi bisnis</p><h1>Pilih masalahnya, bukan modulnya.</h1></div>
        <div><p class="lede">RAMUNI menghubungkan gejala, bukti, dan langkah yang tetap Anda kendalikan.</p><a class="button button--primary" href="/demo">Jadwalkan Demo</a></div>
      </div>
    </section>

    <section class="section pain-clusters" aria-labelledby="pain-clusters-title">
      <div class="container">
        <h2 id="pain-clusters-title">Di mana keputusan mulai tersendat?</h2>
        <p class="pain-clusters__intro">Pilih satu gejala. Lihat urutan yang perlu diperiksa sebelum menentukan langkah.</p>
        <fieldset class="solution-problem-lab reveal">
          <legend class="sr-only">Pilih masalah bisnis</legend>
          <div class="solution-problem-lab__choices">
            {painClusters.map((cluster, index) => (
              <label>
                <input type="radio" name="solution-problem" value={index} checked={index === 0} />
                <span>{cluster.label}</span>
                <small>{cluster.text}</small>
              </label>
            ))}
          </div>
          <div class="solution-problem-lab__stage" aria-live="polite">
            {painClusters.map((cluster, index) => (
              <article class="solution-problem-lab__panel" data-panel={index}>
                <header><span>Contoh pola sintetis</span><strong>{cluster.label}</strong></header>
                <div class="solution-problem-lab__bars" aria-hidden="true">
                  {cluster.bars.map((bar, barIndex) => <i style={`--bar:${bar}%;--delay:${barIndex * 55}ms`}></i>)}
                </div>
                <p>{cluster.prompt}</p>
                <a href={`/solusi/${solutions[index].slug}`}>Buka alur {cluster.label.toLowerCase()}</a>
              </article>
            ))}
          </div>
        </fieldset>
      </div>
    </section>

    <section class="section surface solution-directory" aria-labelledby="solution-directory-title">
      <div class="container solution-directory__layout">
        <header><p class="section-kicker">Lima konteks</p><h2 id="solution-directory-title">Mulai dari gejala yang paling dekat.</h2><p>Buka alur untuk melihat dampak, modul terkait, dan tindakan yang aman.</p></header>
        <div class="solution-stories">
          {solutions.map((solution, index) => (
            <a class="solution-story reveal" style={`--i:${index}`} href={`/solusi/${solution.slug}`}>
              <span class="solution-story__count">{String(index + 1).padStart(2, '0')}</span>
              <div><h3>{solution.title}</h3><p>{solution.symptoms[0]}</p></div>
              <dl><div><dt>Jika dibiarkan</dt><dd>Keputusan mengandalkan asumsi atau catatan yang terlambat.</dd></div><div><dt>Arah yang dicari</dt><dd>{solution.outcome}</dd></div></dl>
              <strong>Lihat alur</strong>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section solution-principle" aria-labelledby="solution-principle-title">
      <div class="container"><h2 id="solution-principle-title">Satu masalah dibaca lintas modul.</h2><div class="solution-principle__rail"><article><strong>Kenali gejala</strong><p>Mulai dari perubahan yang terlihat.</p></article><article><strong>Hubungkan konteks</strong><p>Pilih modul dan periode yang relevan.</p></article><article><strong>Periksa bukti</strong><p>Telusuri angka sebelum menyimpulkan.</p></article><article><strong>Tentukan langkah</strong><p>Pengguna tetap memegang keputusan.</p></article></div></div>
    </section>

    <section class="section solution-combinations" aria-labelledby="solution-combinations-title">
      <div class="container solution-combinations__layout">
        <header><p class="section-kicker">Modul bekerja bersama</p><h2 id="solution-combinations-title">Tidak ada satu modul untuk semua masalah.</h2></header>
        <div class="combination-lines">
          {solutions.map((solution) => <a href={`/solusi/${solution.slug}`}><strong>{solution.title}</strong><span>{solution.modules.join(' + ')}</span></a>)}
        </div>
      </div>
    </section>

    <section class="section synthetic-decisions" aria-labelledby="synthetic-title">
      <div class="container synthetic-decisions__layout">
        <div><p class="section-kicker">Contoh data sintetis</p><h2 id="synthetic-title">Bukan sekadar angka. Ada pemeriksaan berikutnya.</h2><p>Contoh ini menjelaskan bentuk keputusan, bukan hasil pelanggan nyata.</p></div>
        <div class="decision-notes">
          {solutions.slice(0,3).map((solution) => <article><span>{solution.comparison}</span><strong>{solution.nextAction}</strong><small>Sumber yang diperiksa: {solution.modules.slice(0,2).join(' dan ')}</small></article>)}
        </div>
      </div>
    </section>

    <section class="section industry-crosslinks" aria-labelledby="industry-crosslinks-title">
      <div class="container industry-crosslinks__layout">
        <header><h2 id="industry-crosslinks-title">Masalah yang sama, konteks yang berbeda.</h2><p>Lihat pertanyaan awal berdasarkan ritme operasional usaha Anda.</p></header>
        <nav aria-label="Solusi berdasarkan industri">{industries.map((industry) => <a href={`/industri/${industry.slug}`}><strong>{industry.title}</strong><span>{industry.question}</span></a>)}</nav>
      </div>
    </section>

    <section class="section solution-faq" aria-labelledby="solution-faq-title">
      <div class="container solution-faq__layout">
        <h2 id="solution-faq-title">Sebelum menentukan titik awal.</h2>
        <div>{solutionFaq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
      </div>
    </section>

    <section class="section surface solution-hub-close"><div class="container solution-hub-close__layout"><div><h2>Petakan masalah tanpa membuka data sensitif.</h2></div><div><p>Demo memakai data sintetis untuk memilih alur dan modul awal yang relevan.</p><a class="button button--primary" href="/demo">Jadwalkan Demo</a></div></div></section>
  </main>
</BaseLayout>

<style>
  .solution-hub .solution-hub-hero h1{max-width:12ch}
  .pain-clusters{background:var(--white)}.pain-clusters h2{max-width:13ch}
  .pain-clusters__track{display:grid;grid-template-columns:1.2fr .8fr .8fr 1.2fr;margin-top:clamp(42px,6vw,72px);border-block:1px solid var(--ink)}
  .pain-clusters__track article{min-height:220px;padding:24px;border-right:1px solid var(--ink-10);display:flex;flex-direction:column}.pain-clusters__track article:last-child{border-right:0}
  .pain-clusters__track span{color:var(--teal);font-size:.76rem;font-weight:800}.pain-clusters__track p{margin-top:auto;font-size:1.08rem}
  .solution-stories{display:grid;gap:18px}
  .solution-story{position:relative;display:grid;grid-template-columns:44px .75fr 1.1fr auto;gap:22px;align-items:start;padding:28px;border:1px solid var(--ink-10);background:var(--white);text-decoration:none;overflow:hidden;transition:transform .35s cubic-bezier(.16,1,.3,1),border-color .35s ease}
  .solution-story:nth-child(even){margin-left:clamp(0px,4vw,54px)}.solution-story:hover,.solution-story:focus-visible{transform:translateY(-5px);border-color:var(--teal)}
  .solution-story::after{content:"";position:absolute;right:-45px;bottom:-55px;width:110px;height:110px;background:var(--yellow);opacity:.15;transform:rotate(38deg);transition:transform .5s cubic-bezier(.16,1,.3,1)}.solution-story:hover::after{transform:rotate(28deg) translate(-8px,-8px)}
  .solution-story__count{color:var(--teal);font-size:.72rem;font-weight:800}.solution-story h3{font-size:clamp(1.2rem,2vw,1.55rem)}.solution-story>div>p{margin-top:10px;color:var(--ink-72)}
  .solution-story dl{margin:0}.solution-story dl>div+div{margin-top:15px}.solution-story dt{font-size:.72rem;font-weight:800;color:var(--teal)}.solution-story dd{margin:4px 0 0;color:var(--ink-72)}.solution-story>strong{color:var(--teal);font-size:.8rem}
  .solution-combinations{background:var(--ink);color:var(--white)}
  .solution-combinations__layout{display:grid;grid-template-columns:.72fr 1.28fr;gap:clamp(48px,8vw,120px)}.solution-combinations .section-kicker{color:var(--yellow)}
  .combination-lines{border-top:1px solid rgb(255 255 255/.28)}.combination-lines a{display:grid;grid-template-columns:.9fr 1.1fr;gap:24px;padding:23px 0;border-bottom:1px solid rgb(255 255 255/.18);color:var(--white);text-decoration:none;transition:padding .3s ease}.combination-lines a:hover{padding-left:12px}.combination-lines span{color:rgb(255 255 255/.68)}
  .synthetic-decisions{background:var(--teal);color:var(--white)}
  .synthetic-decisions__layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(48px,9vw,132px)}.synthetic-decisions .section-kicker{color:var(--yellow)}.synthetic-decisions__layout>div:first-child>p:last-child{max-width:38ch;margin-top:22px;color:rgb(255 255 255/.72)}
  .decision-notes{display:grid;gap:14px}.decision-notes article{padding:26px;border:1px solid rgb(255 255 255/.24)}.decision-notes span,.decision-notes strong,.decision-notes small{display:block}.decision-notes span{color:var(--yellow);font-size:.78rem;font-weight:800}.decision-notes strong{margin-top:18px;font-size:1.14rem}.decision-notes small{margin-top:18px;color:rgb(255 255 255/.68)}
  .industry-crosslinks{background:var(--rice)}.industry-crosslinks__layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(48px,9vw,132px)}.industry-crosslinks header p{max-width:38ch;margin-top:22px;color:var(--ink-72)}
  .industry-crosslinks nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--ink-10)}.industry-crosslinks nav a{min-height:155px;padding:24px;background:var(--rice);text-decoration:none;transition:background .3s ease,transform .3s ease}.industry-crosslinks nav a:hover,.industry-crosslinks nav a:focus-visible{background:var(--white);transform:translateY(-4px)}.industry-crosslinks nav strong,.industry-crosslinks nav span{display:block}.industry-crosslinks nav span{margin-top:24px;color:var(--ink-72)}
  .solution-faq{background:var(--white)}.solution-faq__layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(48px,9vw,132px)}.solution-faq details{padding:22px 0;border-top:1px solid var(--ink-10)}.solution-faq details:last-child{border-bottom:1px solid var(--ink-10)}.solution-faq summary{cursor:pointer;font-weight:800}.solution-faq details p{max-width:58ch;margin-top:14px;color:var(--ink-72)}
  @media(prefers-reduced-motion:no-preference){.pain-clusters__track article{animation:solution-rise .7s both;animation-delay:calc(var(--i,0)*70ms)}@keyframes solution-rise{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}}
  @media(max-width:960px){.pain-clusters__track{grid-template-columns:repeat(2,1fr)}.pain-clusters__track article:nth-child(2){border-right:0}.pain-clusters__track article:nth-child(n+3){border-top:1px solid var(--ink-10)}.solution-combinations__layout,.synthetic-decisions__layout,.industry-crosslinks__layout,.solution-faq__layout{grid-template-columns:1fr}.solution-story{grid-template-columns:36px 1fr}.solution-story dl,.solution-story>strong{grid-column:2}.solution-story:nth-child(even){margin-left:0}}
  @media(max-width:740px){.pain-clusters__track,.industry-crosslinks nav{grid-template-columns:1fr}.pain-clusters__track article{min-height:155px;border-right:0;border-top:1px solid var(--ink-10)}.solution-story{padding:22px}.combination-lines a{grid-template-columns:1fr;gap:8px}.industry-crosslinks nav a{min-height:135px}}
  @media(prefers-reduced-motion:reduce){.pain-clusters__track article,.solution-story,.solution-story::after,.combination-lines a,.industry-crosslinks nav a{animation:none;transition:none}}
</style>

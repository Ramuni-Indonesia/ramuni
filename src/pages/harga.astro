---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = [
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'RAMUNI', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', description: 'AI Business Companion untuk membantu UMKM memahami kondisi bisnis.' },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: new URL('/', Astro.site || Astro.url.origin).toString() },
    { '@type': 'ListItem', position: 2, name: 'Harga', item: new URL('/harga/', Astro.site || Astro.url.origin).toString() },
  ] },
];
---
<BaseLayout title="Harga RAMUNI" description="Harga RAMUNI sedang disiapkan. Pelajari faktor paket, ruang lingkup, dan cara membahas kebutuhan early access tanpa angka yang belum disetujui." schema={schema}>
  <header class="price-hero">
    <div class="container price-hero-layout">
      <div class="reveal is-visible"><h1>Pilih paket nanti, pahami kebutuhannya dulu.</h1><p class="lede">Harga publik belum kami buka karena paket harus jelas: modul apa yang dipakai, batasnya di mana, dan dukungan apa yang termasuk.</p><div class="button-row"><a class="button button--primary" href="/early-access">Ajukan Early Access</a><a class="button button--secondary" href="/demo">Bahas Kebutuhan</a></div></div>
      <aside class="price-status reveal is-visible" aria-label="Status harga"><span>Status harga</span><strong>Dalam validasi</strong><p>Angka akan ditampilkan setelah ruang lingkup, batas penggunaan, pajak, dukungan, dan ketentuan komersial disetujui.</p></aside>
    </div>
  </header>

  <section class="section surface" aria-labelledby="price-factors">
    <div class="container price-factor-layout"><div class="price-sticky reveal"><p class="section-kicker">Dasar penawaran</p><h2 id="price-factors">Paket yang baik tidak dimulai dari angka.</h2><p>Ia dimulai dari cara usaha Anda bekerja hari ini.</p></div><div class="price-factor-list">
      <article class="price-factor-row reveal"><span>01</span><div><h3>Skala operasional</h3><p>Jumlah outlet, pengguna, transaksi, dan kanal jual menentukan beban setup.</p></div></article>
      <article class="price-factor-row reveal"><span>02</span><div><h3>Modul yang dipakai</h3><p>Tidak semua usaha perlu langsung memakai penjualan, stok, kas, pelanggan, laporan, dan AI sekaligus.</p></div></article>
      <article class="price-factor-row reveal"><span>03</span><div><h3>Kondisi data</h3><p>Catatan rapi, spreadsheet campur, atau data dari POS membutuhkan pendekatan berbeda.</p></div></article>
      <article class="price-factor-row reveal"><span>04</span><div><h3>Dukungan awal</h3><p>Onboarding, pelatihan, dan bantuan impor perlu disebut jelas sebelum ada komitmen.</p></div></article>
    </div></div>
  </section>

  <section class="section price-contract-stage" aria-labelledby="price-contract">
    <div class="container price-contract-layout"><div><p class="section-kicker">Yang harus jelas</p><h2 id="price-contract">Ketika harga tampil, batasnya ikut tampil.</h2><p>Kami tidak ingin calon pengguna menebak apa yang termasuk dan apa yang dikenakan biaya tambahan.</p></div><ul><li>Versi paket dan tanggal berlaku</li><li>Fitur inti serta status ketersediaannya</li><li>Batas pengguna, outlet, transaksi, ekspor, dan penyimpanan</li><li>Kuota AI dan perlakuan saat batas tercapai</li><li>Setup, dukungan, pajak, pembayaran, dan pembatalan</li></ul></div>
  </section>

  <section class="section surface" aria-labelledby="price-process">
    <div class="container price-process"><div><p class="section-kicker">Alur diskusi</p><h2 id="price-process">Cara membahas kebutuhan tanpa membocorkan data.</h2></div><ol><li><span>1</span><div><strong>Ceritakan masalah utama</strong><p>Misalnya stok sering selisih, margin sulit dibaca, atau laporan terlambat.</p></div></li><li><span>2</span><div><strong>Petakan ruang lingkup</strong><p>Tim melihat modul, skala, dan kesiapan data yang relevan.</p></div></li><li><span>3</span><div><strong>Terima opsi lanjut</strong><p>Jika sesuai, Anda mendapat arahan early access, demo, atau diskusi setup.</p></div></li></ol></div>
  </section>

  <section class="section price-faq-stage" aria-labelledby="price-faq"><div class="container faq-composition"><div class="faq-heading"><p class="section-kicker">Pertanyaan harga</p><h2 id="price-faq">Yang perlu diketahui sekarang.</h2></div><div class="faq-list">
    <details><summary>Apakah RAMUNI sudah memiliki harga publik?</summary><p>Harga publik belum dirilis. Paket masih divalidasi bersama ruang lingkup produk dan kebutuhan pengguna awal.</p></details>
    <details><summary>Apakah early access berarti gratis?</summary><p>Tidak selalu. Jika ada biaya atau syarat komersial, informasinya harus jelas sebelum Anda berkomitmen.</p></details>
    <details><summary>Apakah ada paket yang direkomendasikan?</summary><p>Belum ada paket publik yang bisa direkomendasikan. Label seperti "populer" tidak dipakai sebelum ada dasar yang valid.</p></details>
    <details><summary>Kapan angka harga akan tampil?</summary><p>Setelah paket, batas, dukungan, dan ketentuan komersial disetujui. Tanggal publik belum diumumkan.</p></details>
  </div></div></section>

  <section class="section price-close-stage"><div class="container price-close"><div><p class="section-kicker">Langkah berikutnya</p><h2>Ingin tahu RAMUNI cocok untuk usaha Anda?</h2><p>Ajukan early access atau minta demo dengan konteks operasional yang aman dibagikan.</p></div><div class="button-row"><a class="button button--primary" href="/early-access">Ajukan Early Access</a><a class="button button--secondary" href="/demo">Bahas Kebutuhan</a></div></div></section>
</BaseLayout>

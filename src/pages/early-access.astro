---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import '../styles/forms-conversion.css';
---
<BaseLayout title="Akses Coba RAMUNI" description="Ajukan akses coba RAMUNI dan ceritakan satu masalah penjualan, stok, keuangan, pelanggan, atau laporan yang ingin dipahami.">
  <section class="early-access-form-page" aria-labelledby="early-access-title">
    <div class="container early-access-form-page__layout">
      <div class="early-access-form-page__intro reveal is-visible">
        <a class="text-link" href="/">Kembali ke beranda</a>
        <p class="section-kicker">Ajukan akses coba</p>
        <h1 id="early-access-title">Ceritakan satu masalah usaha yang ingin Anda pahami.</h1>
        <p class="lede">Isi data dasar berikut. Kami akan menghubungi Anda bila kebutuhan usaha Anda sesuai dengan cakupan yang sedang kami buka.</p>
        <ul>
          <li>Tidak perlu mengirim data transaksi atau data pelanggan.</li>
          <li>AI tidak menjalankan tindakan otomatis.</li>
          <li>Cakupan akses dijelaskan sebelum Anda mulai.</li>
        </ul>
      </div>
      <div class="early-access-form-page__panel reveal is-visible">
        <LeadForm kind="early-access" />
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
---
<BaseLayout title="Early Access RAMUNI" description="Daftar early access RAMUNI dan ceritakan satu masalah penjualan, stok, keuangan, pelanggan, atau laporan yang ingin dibaca lebih jelas.">
  <section class="early-access-form-page" aria-labelledby="early-access-title">
    <div class="container early-access-form-page__layout">
      <div class="early-access-form-page__intro reveal is-visible">
        <a class="text-link" href="/">Kembali ke beranda</a>
        <p class="section-kicker">Daftar Early Access</p>
        <h1 id="early-access-title">Mulai dari satu masalah usaha.</h1>
        <p class="lede">Isi data dasar dan pilih hal yang paling ingin Anda pahami. Tim RAMUNI meninjau setiap pendaftaran secara manual.</p>
        <ul>
          <li>Tidak perlu mengirim data transaksi.</li>
          <li>Keputusan tetap di tangan Anda.</li>
          <li>Ruang lingkup akses dijelaskan sebelum setup.</li>
        </ul>
      </div>
      <div class="early-access-form-page__panel reveal is-visible">
        <LeadForm kind="early-access" />
      </div>
    </div>
  </section>
</BaseLayout>

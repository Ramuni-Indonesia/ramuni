---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import '../styles/system-status-visuals.css';

const components = [
  ['Website marketing', 'Tidak dipantau melalui halaman ini', 'Tampilan halaman bukan bukti uptime atau kondisi layanan produksi.'],
  ['Aplikasi produk', 'Status tidak dipublikasikan di sini', 'Runtime produk dikelola terpisah dan perlu sumber operasional terverifikasi.'],
  ['API dan background jobs', 'Status tidak tersedia', 'Tidak ada feed health publik yang dapat dirujuk.'],
  ['Notifikasi dan integrasi', 'Mengikuti status rilis', 'Tidak diasumsikan aktif sebelum dukungan operasionalnya terbukti.'],
];
---
<BaseLayout title="Status RAMUNI" description="Informasi status RAMUNI dan jalur konfirmasi operasional tanpa klaim uptime yang tidak memiliki sumber terverifikasi." noindex={true}>
  <PageHero eyebrow="Status" title="Status harus datang dari data operasional." description="Halaman ini tidak terhubung ke monitor atau penyedia status terverifikasi. Karena itu, RAMUNI tidak menampilkan klaim kondisi sistem tanpa bukti operasional." primaryLabel="Hubungi Dukungan" primaryHref="https://wa.me/message/K35W6X6WT7YMJ1" secondaryLabel="Baca Keamanan" secondaryHref="/keamanan/" />

  <section class="section status-page__overall" id="status-saat-ini" aria-labelledby="overall-title">
    <div class="container status-page__overall-layout">
      <div class="status-page__heading reveal"><p class="eyebrow">Status saat ini</p><h2 id="overall-title">Konfirmasi melalui kanal dukungan.</h2><p>Halaman publik ini tidak menerima telemetri, health endpoint, atau feed status penyedia.</p></div>
      <div class="status-page__stamp reveal" role="status"><span>STATUS FEED</span><div class="status-feed-visual" aria-hidden="true"><i></i><i></i><i></i><i></i><b>?</b></div><strong>Konfirmasi manual</strong><p>Gunakan kanal dukungan untuk memeriksa kondisi operasional yang relevan dengan kebutuhan Anda.</p></div>
    </div>
  </section>

  <section class="section surface status-page__components" id="komponen" aria-labelledby="components-title">
    <div class="container">
      <div class="status-page__heading reveal"><h2 id="components-title">Tidak ada indikator hijau tanpa sumber bukti.</h2></div>
      <div class="status-page__component-list">{components.map((component, index) => <article class="reveal"><div class="status-component-signal" aria-hidden="true"><span>{String(index + 1).padStart(2, '0')}</span><i></i><i></i><i></i></div><strong>{component[0]}</strong><span>{component[1]}</span><p>{component[2]}</p></article>)}</div>
    </div>
  </section>

  <section class="section dark-surface status-page__incidents" id="insiden" aria-labelledby="incidents-title">
    <div class="container status-page__split">
      <div class="status-page__heading reveal"><p class="eyebrow">Insiden aktif</p><h2 id="incidents-title">Feed insiden tidak tersedia di halaman ini.</h2><p>Ketiadaan feed bukan bukti bahwa layanan bebas gangguan. Konfirmasi kondisi operasional melalui dukungan.</p></div>
      <div class="status-page__empty-state reveal"><span>Konfirmasi diperlukan</span><strong>Informasi insiden harus berasal dari proses respons yang terverifikasi.</strong><p>Komunikasi gangguan tidak boleh membuka data pribadi, kredensial, stack trace, atau detail eksploitasi.</p></div>
    </div>
  </section>

  <section class="section status-page__maintenance" id="maintenance" aria-labelledby="maintenance-title">
    <div class="container status-page__split">
      <div class="status-page__heading reveal"><h2 id="maintenance-title">Jadwal pemeliharaan tidak ditampilkan di halaman ini.</h2></div>
      <ol class="status-page__process">
        <li class="reveal"><span>01</span><div><strong>Konfirmasi cakupan</strong><p>Tentukan layanan, waktu, dan dampak pengguna.</p></div></li>
        <li class="reveal"><span>02</span><div><strong>Publikasikan jadwal</strong><p>Tampilkan zona waktu dan kanal pembaruan.</p></div></li>
        <li class="reveal"><span>03</span><div><strong>Verifikasi pemulihan</strong><p>Uji layanan sebelum menutup maintenance.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section surface status-page__history" id="riwayat" aria-labelledby="history-title">
    <div class="container status-page__split">
      <div class="status-page__heading reveal"><h2 id="history-title">Riwayat status tidak dipublikasikan di halaman ini.</h2><p>Catatan yang layak dipublikasikan harus memuat waktu, cakupan dampak, pembaruan, dan resolusi yang dapat diverifikasi.</p></div>
      <div class="status-page__history-rule reveal"><strong>Pembaruan otomatis tidak tersedia dari halaman ini.</strong><p>RAMUNI tidak meminta email atau nomor WhatsApp untuk langganan status melalui halaman ini.</p></div>
    </div>
  </section>

  <section class="section status-page__close"><div class="container status-page__closing reveal"><div><h2>Gunakan kanal dukungan dengan informasi minimum.</h2><p>Jangan kirim password, token, data pelanggan, atau transaksi sensitif.</p></div><div class="button-row"><a class="button button--primary" href="https://wa.me/message/K35W6X6WT7YMJ1">Hubungi Dukungan</a><a class="button button--secondary" href="/bantuan/">Pusat Bantuan</a></div></div></section>
</BaseLayout>

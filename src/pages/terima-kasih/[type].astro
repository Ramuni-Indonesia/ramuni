---
import BaseLayout from '../../layouts/BaseLayout.astro';
export function getStaticPaths(){
const messages={
  'early-access':{title:'Pendaftaran sudah diterima.',text:'Tim RAMUNI akan memeriksa konteks usaha dan menghubungi Anda melalui kanal yang diberikan.'},
  demo:{title:'Permintaan demo sudah diterima.',text:'Kami akan meninjau kebutuhan utama sebelum mengatur jadwal yang sesuai.'},
  kontak:{title:'Pesan sudah diterima.',text:'Tim RAMUNI akan membaca konteksnya dan menindaklanjuti bila diperlukan.'},
  template:{title:'Permintaan template sudah diterima.',text:'Pengiriman hanya dilakukan setelah file dan alur persetujuan tersedia.'},
};
return Object.entries(messages).map(([type,message])=>({params:{type},props:{message}}));
}
const {message}=Astro.props;
---
<BaseLayout title="Terima Kasih" description="Konfirmasi kiriman formulir RAMUNI." noindex>
  <section class="success-stage"><div class="container success-composition"><div class="success-mark" aria-hidden="true"><span></span></div><div><p class="eyebrow">Terima kasih</p><h1>{message.title}</h1><p class="lede">{message.text}</p><p class="success-note">Jangan kirim data pelanggan atau transaksi melalui balasan yang tidak terenkripsi.</p><div class="button-row"><a class="button button--primary" href="/">Kembali ke beranda</a><a class="text-link" href="/blog">Baca panduan bisnis</a></div></div></div></section>
</BaseLayout>

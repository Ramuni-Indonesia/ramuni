---
import BaseLayout from '../../layouts/BaseLayout.astro';
export function getStaticPaths(){
const messages={
  'early-access':{title:'Pendaftaran sudah diterima.',metaTitle:'Pendaftaran Akses Diterima',description:'Konfirmasi pendaftaran akses RAMUNI dan langkah tindak lanjut yang aman.',text:'Tim RAMUNI akan memeriksa konteks usaha dan menghubungi Anda melalui kanal yang diberikan.'},
  demo:{title:'Permintaan konsultasi sudah diterima.',metaTitle:'Permintaan Konsultasi Diterima',description:'Konfirmasi permintaan konsultasi RAMUNI dan pengingat untuk tidak mengirim data bisnis sensitif.',text:'Kami akan meninjau kebutuhan utama dan menghubungi Anda melalui kanal yang diberikan.'},
  kontak:{title:'Pesan sudah diterima.',metaTitle:'Pesan Kontak Diterima',description:'Konfirmasi pesan kontak RAMUNI dan jalur tindak lanjut dari tim.',text:'Tim RAMUNI akan membaca konteksnya dan menindaklanjuti bila diperlukan.'},
  template:{title:'Permintaan template sudah diterima.',metaTitle:'Permintaan Template Diterima',description:'Konfirmasi permintaan template RAMUNI dan langkah berikutnya untuk mengakses file.',text:'Tim RAMUNI akan mengarahkan Anda ke template yang sesuai melalui kanal yang diberikan.'},
};
return Object.entries(messages).map(([type,message])=>({params:{type},props:{message}}));
}
const {message}=Astro.props;
---
<BaseLayout title={message.metaTitle} description={message.description} noindex>
  <section class="success-stage"><div class="container success-composition"><div class="success-mark" aria-hidden="true"><span></span></div><div><p class="eyebrow">Terima kasih</p><h1>{message.title}</h1><p class="lede">{message.text}</p><p class="success-note">Jangan kirim data pelanggan atau transaksi melalui balasan yang tidak terenkripsi.</p><div class="button-row"><a class="button button--primary" href="/">Kembali ke beranda</a><a class="text-link" href="/blog/">Baca panduan bisnis</a></div></div></div></section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CommercialAnalytics from '../components/CommercialAnalytics.astro';
import CommercialProofShowcase from '../components/CommercialProofShowcase.astro';
import { capabilityStatusLabel, pricingPlans, pricingRows } from '../data/commercial';
import { appCta, consultationCta } from '../data/site';
import { pageLastmods } from '../data/pageLastmods';
import { releaseGates } from '../config/release';
import '../styles/commercial-pages.css';

const siteOrigin = new URL('/', Astro.site || Astro.url.origin).origin;
const canonical = new URL('/pricing/', siteOrigin).toString();
const priceLabel = (value: number | null, annual = false) => {
  if (!releaseGates.pricingPublic) return 'Harga sedang divalidasi';
  if (value === null) return 'Hubungi kami';
  if (value === 0) return 'Rp0';
  return `Rp${new Intl.NumberFormat('id-ID').format(value)}${annual ? ' / tahun' : ' / bulan'}`;
};
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', '@id': canonical, url: canonical, name: 'Harga RAMUNI: Platform Bisnis dan AI untuk UMKM', description: 'Pilih paket RAMUNI untuk mengelola operasional, pengetahuan, website, pelanggan, dan analisis bisnis UMKM dalam satu platform.', dateModified: pageLastmods.commercial, inLanguage: 'id-ID' },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Beranda', item: siteOrigin + '/' }, { '@type': 'ListItem', position: 2, name: 'Harga', item: canonical }] },
  ...(releaseGates.pricingPublic ? [{ '@context': 'https://schema.org', '@type': 'OfferCatalog', name: 'Paket RAMUNI', url: canonical, itemListElement: pricingPlans.filter((plan) => plan.monthly !== null).map((plan) => ({ '@type': 'Offer', name: plan.name, priceCurrency: 'IDR', price: plan.monthly, url: `${canonical}#${plan.key}` })) }] : []),
];
const limitRows = [
  { label: 'Pengguna workspace', values: pricingPlans.map((plan) => plan.limits[0]) },
  { label: 'Outlet aktif', values: pricingPlans.map((plan) => plan.limits[1]) },
  { label: 'Budget AI bulanan', values: pricingPlans.map((plan) => plan.limits[2]) },
];
---
<BaseLayout title="Harga RAMUNI: Platform Bisnis dan AI untuk UMKM" description="Pilih paket RAMUNI untuk mengelola operasional, pengetahuan, website, pelanggan, dan analisis bisnis UMKM dalam satu platform." canonical="/pricing/" schema={schema} pageType="WebPage">
  <div class="commercial-page" data-commercial-page="pricing" data-pricing-public={String(releaseGates.pricingPublic)}>
    <section class="commercial-hero">
      <div class="container commercial-hero__grid">
        <div><Breadcrumbs items={[{ label: 'Beranda', href: '/' }, { label: 'Harga' }]} /><p class="section-kicker">Paket RAMUNI</p><h1>Pilih paket berdasarkan cara tim Anda bekerja.</h1></div>
        <div class="commercial-hero__aside"><p>Bandingkan harga, pengguna, fitur, dan batasnya sebelum mulai. RAMUNI membantu Anda memilih ruang kerja yang sesuai dengan tahap usaha.</p><div class="button-row"><a class="button button--primary" href={appCta.href} data-analytics-event="free_trial_click" data-analytics-location="pricing_hero" data-destination="app">{appCta.label}</a><a class="button button--secondary" href={consultationCta.href} data-analytics-event="demo_request" data-analytics-location="pricing_hero" data-destination="consultation">Lihat demo</a></div><p class="commercial-hero__note">Tidak perlu kartu kredit untuk membuka workspace. Harga dan batas paket mengikuti konfigurasi komersial RAMUNI.</p></div>
      </div>
    </section>

    <CommercialProofShowcase
      id="pricing-product-proof"
      eyebrow="Bukti sebelum paket"
      heading="Lihat pekerjaan yang Anda dapat sebelum membandingkan harga."
      body="Harga menjawab akses. Tampilan di bawah memperlihatkan bentuk pekerjaan yang dapat dibaca bersama tim Anda."
      focus="overview"
      location="pricing_product_proof"
    />

    <section class="commercial-section commercial-section--white" aria-labelledby="plans-title">
      <div class="container">
          <div class="commercial-section__head"><div><p class="section-kicker">Bandingkan paket</p><h2 id="plans-title">Pilih paket sesuai jumlah orang dan modul.</h2></div><p>Bandingkan harga, pengguna, fitur, kapasitas, dan dukungan. Mulai dari paket yang paling dekat dengan pekerjaan Anda hari ini.</p></div>
        <div class="commercial-disclaimer" role="note"><strong>Transparan sejak awal.</strong><span>Harga publik dan batas paket mengikuti konfigurasi komersial RAMUNI.</span></div>
        <div class="pricing-controls"><p>Perbandingan harga mengikuti periode yang dipilih.</p><div class="billing-toggle" role="group" aria-label="Periode harga"><button type="button" data-billing="monthly" aria-pressed="true">Bulanan</button><button type="button" data-billing="annual" aria-pressed="false" data-analytics-event="annual_toggle" data-analytics-location="pricing_controls">Tahunan <small>{releaseGates.pricingPublic ? 'hemat 15-20%' : 'hemat setelah disetujui'}</small></button></div></div>
        <div class="plan-grid" data-plan-grid>
          {pricingPlans.map((plan) => <article id={plan.key} class:list={['plan-card', { 'plan-card--featured': plan.key === 'growth' }]}>
            {plan.eyebrow && <span class="plan-card__badge">{plan.eyebrow}</span>}
            <span class="plan-card__eyebrow">Untuk tahap kerja</span><h3>{plan.name}</h3><p class="plan-card__fit">{plan.fit}</p>
            <div class="plan-card__price"><strong data-price-monthly={releaseGates.pricingPublic ? (plan.monthly === null ? 'contact' : String(plan.monthly)) : 'pending'} data-price-annual={releaseGates.pricingPublic ? (plan.annual === null ? 'contact' : String(plan.annual)) : 'pending'}>{priceLabel(plan.monthly)}</strong><small data-price-note>{plan.monthly === null ? 'Konfigurasi khusus' : releaseGates.pricingPublic ? 'per bulan' : 'menunggu persetujuan harga'}</small></div>
            <ul class="plan-card__list">{plan.features.map((feature) => <li>{feature}</li>)}</ul>
            <div class="plan-card__limits"><strong>Batas yang perlu dipahami</strong>{plan.limits.map((limit) => <span>{limit}</span>)}</div>
            <a class="button button--primary" href={plan.flow === 'trial' ? appCta.href : `${consultationCta.href}&plan=${plan.key}`} data-analytics-event={plan.flow === 'consultation' ? 'contact_sales' : 'pricing_plan_click'} data-analytics-location="pricing_plan" data-plan={plan.key} data-billing-period="monthly" data-destination={plan.flow === 'trial' ? 'app' : 'consultation'}>{plan.cta}</a>
          </article>)}
        </div>
      </div>
    </section>

    <section class="commercial-section" aria-labelledby="matrix-title">
        <div class="container"><div class="commercial-section__head"><div><p class="section-kicker">Bandingkan fitur</p><h2 id="matrix-title">Lihat akses dan batas setiap paket.</h2></div><p>Kapabilitas inti RAMUNI tersedia di semua paket. Perbedaannya dibuat transparan lewat jumlah pengguna, outlet, dan budget AI - bukan fitur yang dijanjikan tetapi belum aktif.</p></div><div class="matrix-legend" aria-label="Keterangan status"><span><i class="matrix-legend__icon is-available" aria-hidden="true">✓</i> Tersedia</span><span><i class="matrix-legend__icon is-limited" aria-hidden="true">•</i> Terbatas oleh paket</span><span><i class="matrix-legend__icon is-unavailable" aria-hidden="true">×</i> Belum tersedia</span></div><p class="matrix-scroll-hint" aria-hidden="true">Geser tabel ke kiri atau kanan untuk melihat semua paket.</p><div class="matrix-wrap" tabindex="0" role="region" aria-label="Tabel perbandingan fitur dan paket"><table class="feature-matrix"><thead><tr><th scope="col">Area kerja</th>{pricingPlans.map((plan) => <th scope="col">{plan.name}</th>)}</tr></thead><tbody>{pricingRows.map((row, index) => <>{(index === 0 || pricingRows[index - 1].group !== row.group) && <tr class="group-row"><td colspan={pricingPlans.length + 1}>{row.group}</td></tr>}<tr><th scope="row">{row.label}</th>{pricingPlans.map((plan) => { const status = row.statuses[plan.key]; const symbol = status === 'Unavailable' ? '×' : status === 'Limited' || status === 'Beta' ? '•' : '✓'; return <td><span class="matrix-status" data-status={status}><i aria-hidden="true">{symbol}</i><b>{capabilityStatusLabel(status)}</b></span></td>; })}</tr></>)}<tr class="group-row"><td colspan={pricingPlans.length + 1}>Batas paket</td></tr>{limitRows.map((row) => <tr class="limit-row"><th scope="row">{row.label}</th>{row.values.map((value) => <td><span class="matrix-limit-value">{value}</span></td>)}</tr>)}</tbody></table></div></div>
    </section>

    <section class="commercial-section commercial-section--white" aria-labelledby="pricing-next-title"><div class="container"><div class="commercial-cta"><div><p class="section-kicker">Butuh bantuan memilih</p><h2 id="pricing-next-title">Cocokkan paket dengan cara tim Anda bekerja.</h2><p>Isi kontak singkat. Tim akan mencocokkan jumlah pengguna, kebutuhan modul, dan batas akses tanpa meminta data sensitif.</p></div><div class="commercial-cta__actions"><a class="button button--primary" href={appCta.href} data-analytics-event="free_trial_click" data-analytics-location="pricing_final" data-destination="app">{appCta.label}</a><a class="button button--secondary" href={consultationCta.href} data-analytics-event="demo_request" data-analytics-location="pricing_final" data-destination="consultation">Konsultasi</a></div></div></div></section>
  </div>
  <CommercialAnalytics />
  <script is:inline>
    (() => {
      const buttons = [...document.querySelectorAll('[data-billing]')];
      const price = (value, period) => { if (value === 'contact') return 'Hubungi kami'; if (value === '0') return 'Rp0'; return `Rp${new Intl.NumberFormat('id-ID').format(Number(value))}${period === 'annual' ? ' / tahun' : ' / bulan'}`; };
      buttons.forEach((button) => button.addEventListener('click', () => {
        const period = button.dataset.billing;
        buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        document.querySelectorAll('[data-price-monthly]').forEach((node) => { const value = node.dataset[`price${period[0].toUpperCase()}${period.slice(1)}`]; if (value) node.textContent = document.querySelector('.commercial-page')?.dataset.pricingPublic === 'true' ? price(value, period) : 'Harga sedang divalidasi'; const note = node.parentElement?.querySelector('[data-price-note]'); if (note && document.querySelector('.commercial-page')?.dataset.pricingPublic === 'true' && value !== 'contact') note.textContent = period === 'annual' ? 'per tahun' : 'per bulan'; });
        document.querySelectorAll('[data-analytics-event="pricing_plan_click"]').forEach((link) => { link.dataset.billingPeriod = period; });
      }));
    })();
  </script>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CommercialAnalytics from '../components/CommercialAnalytics.astro';
import { pricingPlans, pricingRows } from '../data/commercial';
import { appCta, consultationCta } from '../data/site';
import { pageLastmods } from '../data/pageLastmods';
import { releaseGates } from '../config/release';
import '../styles/commercial-pages.css';

const siteOrigin = new URL('/', Astro.site || Astro.url.origin).origin;
const canonical = new URL('/pricing/', siteOrigin).toString();
const pricesVisible = releaseGates.pricingPublic;
const priceLabel = (value: number | null, annual = false) => {
  if (value === null) return 'Hubungi kami';
  if (value === 0) return 'Rp0';
  return `Rp${new Intl.NumberFormat('id-ID').format(value)}${annual ? ' / tahun' : ' / bulan'}`;
};
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', '@id': canonical, url: canonical, name: 'Harga RAMUNI: Platform Bisnis dan AI untuk UMKM', description: 'Pilih paket RAMUNI untuk mengelola operasional, pengetahuan, website, pelanggan, dan analisis bisnis UMKM dalam satu platform.', dateModified: pageLastmods.commercial, inLanguage: 'id-ID' },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Beranda', item: siteOrigin + '/' }, { '@type': 'ListItem', position: 2, name: 'Harga', item: canonical }] },
  ...(releaseGates.pricingPublic ? [{ '@context': 'https://schema.org', '@type': 'OfferCatalog', name: 'Paket RAMUNI', url: canonical, itemListElement: pricingPlans.filter((plan) => plan.monthly !== null).map((plan) => ({ '@type': 'Offer', name: plan.name, priceCurrency: 'IDR', price: plan.monthly, url: `${canonical}#${plan.key}` })) }] : []),
];
const limitRows = [
  { label: 'Pengguna workspace', values: pricingPlans.map((plan) => plan.limits[0]) },
  { label: 'Outlet aktif', values: pricingPlans.map((plan) => plan.limits[1]) },
  { label: 'Budget AI bulanan', values: pricingPlans.map((plan) => plan.limits[2]) },
];
const statusSymbol = (status: string) => ['Unavailable', 'Coming soon'].includes(status) ? '×' : '✓';
const statusLabel = (status: string) => ['Unavailable', 'Coming soon'].includes(status) ? 'Naik paket untuk akses' : 'Termasuk paket';
const mobilePlanGuidance: Record<string, string> = {
  free: 'Mulai sendiri dengan 1 pengguna dan 1 outlet.',
  starter: 'Untuk tim kecil yang mulai merapikan cara kerja digital.',
  growth: 'Pilihan utama untuk tim 3 sampai 10 orang yang membaca banyak sumber.',
  pro: 'Untuk bisnis dengan lebih banyak pengguna, proses, atau outlet.',
  business: 'Untuk konfigurasi khusus, migrasi, atau kebutuhan jaringan outlet.',
};
---
<BaseLayout title="Harga RAMUNI: Platform Bisnis dan AI untuk UMKM" description="Pilih paket RAMUNI untuk mengelola operasional, pengetahuan, website, pelanggan, dan analisis bisnis UMKM dalam satu platform." canonical="/pricing/" schema={schema} pageType="WebPage">
  <div class="commercial-page" data-commercial-page="pricing" data-pricing-public={String(releaseGates.pricingPublic)}>
    <section class="commercial-hero">
      <div class="container commercial-hero__grid">
        <div><Breadcrumbs items={[{ label: 'Beranda', href: '/' }, { label: 'Harga' }]} /><p class="section-kicker">Paket RAMUNI</p><h1>Pilih paket berdasarkan cara tim Anda bekerja.</h1></div>
        <div class="commercial-hero__aside"><p>Mulai dari kebutuhan tim, bukan daftar fitur yang panjang. Bandingkan kapasitas dan akses lalu pilih ruang kerja yang siap dipakai hari ini.</p><div class="button-row"><a class="button button--primary" href="#plans-title" data-analytics-event="pricing_scan" data-analytics-location="pricing_hero">Lihat paket</a><a class="text-link" href={consultationCta.href} data-analytics-event="demo_request" data-analytics-location="pricing_hero" data-destination="consultation">Butuh bantuan memilih?</a></div><p class="commercial-hero__note">{pricesVisible ? 'Tidak perlu kartu kredit untuk membuka workspace. Harga dan batas paket ditampilkan transparan di halaman ini.' : 'Paket dan batas tersedia untuk dibaca. Harga sedang divalidasi oleh tim Finance/Product.'}</p><figure class="pricing-hero__visual"><img src="/website-original/ramuni-mascot-muni-manyar.webp" width="720" height="720" alt="Mascot RAMUNI membantu meninjau pilihan paket dan bukti data." loading="eager" decoding="async" /><figcaption><span>Pilih dengan tenang</span><strong>Satu paket untuk pekerjaan yang benar-benar ingin selesai.</strong></figcaption></figure></div>
      </div>
    </section>

    <section class="commercial-section commercial-section--white" aria-labelledby="plans-title">
      <div class="container">
          <div class="commercial-section__head"><div><p class="section-kicker">Bandingkan paket</p><h2 id="plans-title">Pilih paket sesuai jumlah orang dan modul.</h2></div><p>Bandingkan harga, pengguna, fitur, kapasitas, dan dukungan. Mulai dari paket yang paling dekat dengan pekerjaan Anda hari ini.</p></div>
        <div class="commercial-disclaimer" role="note"><strong>Mulai dari yang pas.</strong><span>Naik paket saat jumlah orang, outlet, atau kebutuhan analisis bertambah. Data dan pekerjaan tetap berada di workspace yang sama.</span></div>
        {pricesVisible ? <div class="pricing-controls"><p>Perbandingan harga mengikuti periode yang dipilih.</p><div class="billing-toggle" role="group" aria-label="Periode harga"><button type="button" data-billing="monthly" aria-pressed="true">Bulanan</button><button type="button" data-billing="annual" aria-pressed="false" data-analytics-event="annual_toggle" data-analytics-location="pricing_controls">Tahunan <small>hemat 15 sampai 20%</small></button></div></div> : <p class="pricing-pending" role="status"><strong>Harga sedang divalidasi.</strong> Batas, isi paket, dan jalur konsultasi tetap dapat Anda bandingkan.</p>}
        <div class="pricing-mobile-guide">
          <label for="pricing-plan-select">Pilih ukuran tim</label>
          <select id="pricing-plan-select" data-plan-select>
            {pricingPlans.map((plan) => <option value={plan.key} data-guidance={mobilePlanGuidance[plan.key]} selected={plan.key === 'growth'}>{plan.name}</option>)}
          </select>
          <p data-plan-guidance aria-live="polite">{mobilePlanGuidance.growth}</p>
        </div>
        <div class="plan-grid" data-plan-grid>
          {pricingPlans.map((plan) => <article id={plan.key} data-plan-card={plan.key} class:list={['plan-card', { 'plan-card--featured': plan.key === 'growth', 'is-mobile-selected': plan.key === 'growth' }]}>
            {plan.eyebrow && <span class="plan-card__badge">{plan.eyebrow}</span>}
            <span class="plan-card__eyebrow">Untuk tahap kerja</span><h3>{plan.name}</h3><p class="plan-card__fit">{plan.fit}</p>
            <div class="plan-card__price"><strong data-price-monthly={!pricesVisible ? 'pending' : plan.monthly === null ? 'contact' : String(plan.monthly)} data-price-annual={!pricesVisible ? 'pending' : plan.annual === null ? 'contact' : String(plan.annual)}>{pricesVisible ? priceLabel(plan.monthly) : 'Harga sedang divalidasi'}</strong><small data-price-note>{pricesVisible ? (plan.monthly === null ? 'Konfigurasi khusus' : 'per bulan') : 'Ditampilkan setelah disetujui'}</small></div>
            <ul class="plan-card__list">{plan.features.map((feature) => <li>{feature}</li>)}</ul>
            <div class="plan-card__limits"><strong>Batas yang perlu dipahami</strong>{plan.limits.map((limit) => <span>{limit}</span>)}</div>
            <a class="button button--primary" href={plan.flow === 'trial' ? appCta.href : `${consultationCta.href}&plan=${plan.key}`} data-analytics-event={plan.flow === 'consultation' ? 'contact_sales' : 'pricing_plan_click'} data-analytics-location="pricing_plan" data-plan={plan.key} data-billing-period="monthly" data-destination={plan.flow === 'trial' ? 'app' : 'consultation'}>{plan.cta}</a>
          </article>)}
        </div>
      </div>
    </section>

    <section class="commercial-section" aria-labelledby="matrix-title">
        <div class="container"><div class="commercial-section__head"><div><p class="section-kicker">Bandingkan akses</p><h2 id="matrix-title">Lihat apa yang masuk di tiap paket.</h2></div><p>Semua kemampuan inti tersedia di RAMUNI. Perbedaannya ada pada jumlah pengguna, kuota, dan paket tempat fitur dibuka.</p></div><details class="pricing-matrix-disclosure" data-pricing-matrix open><summary>Lihat perbandingan lengkap <span aria-hidden="true">＋</span></summary><div class="matrix-legend" aria-label="Keterangan status"><span class="matrix-legend__item is-available"><i aria-hidden="true">✓</i><span>Termasuk paket</span></span><span class="matrix-legend__item is-unavailable"><i aria-hidden="true">×</i><span>Naik paket untuk akses</span></span></div><p class="matrix-scroll-hint">Geser tabel ke kiri atau kanan untuk melihat semua paket.</p><div class="matrix-wrap" tabindex="0" role="region" aria-label="Tabel perbandingan fitur dan paket"><table class="feature-matrix"><thead><tr><th scope="col">Area kerja</th>{pricingPlans.map((plan) => <th scope="col">{plan.name}{plan.key === 'growth' && <small class="matrix-plan-note">Pilihan utama</small>}</th>)}</tr></thead><tbody>{pricingRows.map((row, index) => <>{(index === 0 || pricingRows[index - 1].group !== row.group) && <tr class="group-row"><td colspan={pricingPlans.length + 1}>{row.group}</td></tr>}<tr><th scope="row">{row.label}</th>{pricingPlans.map((plan) => { const status = row.statuses[plan.key]; const label = statusLabel(status); return <td><span class="matrix-status" data-status={status} role="img" aria-label={label} title={label}>{statusSymbol(status)}</span></td>; })}</tr></>)}<tr class="group-row"><td colspan={pricingPlans.length + 1}>Batas paket</td></tr>{limitRows.map((row) => <tr class="limit-row"><th scope="row">{row.label}</th>{row.values.map((value) => <td><span class="matrix-limit-value">{value}</span></td>)}</tr>)}</tbody></table></div></details></div>
    </section>

    <section class="commercial-section commercial-section--white" aria-labelledby="pricing-next-title"><div class="container"><div class="commercial-cta"><div><p class="section-kicker">Butuh bantuan memilih</p><h2 id="pricing-next-title">Cocokkan paket dengan cara tim Anda bekerja.</h2><p>Isi kontak singkat. Tim akan mencocokkan jumlah pengguna, kebutuhan modul, dan batas akses tanpa meminta data sensitif.</p></div><div class="commercial-cta__actions"><a class="button button--primary" href={appCta.href} data-analytics-event="free_trial_click" data-analytics-location="pricing_final" data-destination="app">{appCta.label}</a><a class="button button--secondary" href={consultationCta.href} data-analytics-event="demo_request" data-analytics-location="pricing_final" data-destination="consultation">Konsultasi</a></div></div></div></section>
  </div>
  <CommercialAnalytics />
  <script is:inline>
    (() => {
      const buttons = [...document.querySelectorAll('[data-billing]')];
      const price = (value, period) => { if (value === 'pending') return 'Harga sedang divalidasi'; if (value === 'contact') return 'Hubungi kami'; if (value === '0') return 'Rp0'; return `Rp${new Intl.NumberFormat('id-ID').format(Number(value))}${period === 'annual' ? ' / tahun' : ' / bulan'}`; };
      buttons.forEach((button) => button.addEventListener('click', () => {
        const period = button.dataset.billing;
        buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        document.querySelectorAll('[data-price-monthly]').forEach((node) => { const value = node.dataset[`price${period[0].toUpperCase()}${period.slice(1)}`]; if (value) node.textContent = price(value, period); const note = node.parentElement?.querySelector('[data-price-note]'); if (note && value !== 'contact') note.textContent = period === 'annual' ? 'per tahun' : 'per bulan'; });
        document.querySelectorAll('[data-analytics-event="pricing_plan_click"]').forEach((link) => { link.dataset.billingPeriod = period; });
      }));

      const planSelect = document.querySelector('[data-plan-select]');
      const planCards = [...document.querySelectorAll('[data-plan-card]')];
      const planGuidance = document.querySelector('[data-plan-guidance]');
      const selectPlan = (key) => {
        planCards.forEach((card) => card.classList.toggle('is-mobile-selected', card.dataset.planCard === key));
        const option = planSelect?.querySelector(`option[value="${key}"]`);
        if (planGuidance) planGuidance.textContent = option?.dataset.guidance || '';
      };
      planSelect?.addEventListener('change', () => selectPlan(planSelect.value));
      if (planSelect) selectPlan(planSelect.value);

      const matrix = document.querySelector('[data-pricing-matrix]');
      const compact = window.matchMedia('(max-width: 700px)');
      const syncMatrix = () => { if (matrix) matrix.open = !compact.matches; };
      syncMatrix();
      compact.addEventListener?.('change', syncMatrix);
    })();
  </script>
  <style is:inline>
    .pricing-pending{display:flex;gap:10px;align-items:baseline;margin:22px 0 28px;padding:14px 16px;border-left:3px solid var(--yellow);background:var(--yellow-18);color:var(--ink);font-size:.82rem;line-height:1.5}.pricing-pending strong{font-weight:900}
    .pricing-mobile-guide{display:none}
    .pricing-matrix-disclosure>summary{display:none}
    @media(max-width:700px){
      .pricing-mobile-guide{display:grid;gap:8px;margin:26px 0 18px;padding:16px;background:var(--rice)}
      .pricing-mobile-guide label{color:var(--teal);font-size:.68rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}
      .pricing-mobile-guide select{width:100%;min-height:48px;border:1px solid var(--ink-20);background:var(--white);padding:0 12px;color:var(--ink);font:inherit;font-weight:800}
      .pricing-mobile-guide select:focus-visible{outline:3px solid var(--teal);outline-offset:2px}
      .pricing-mobile-guide p{color:var(--ink-72);font-size:.78rem;line-height:1.45}
      .plan-grid[data-plan-grid]{grid-template-columns:1fr}
      .plan-grid[data-plan-grid] .plan-card{display:none}
      .plan-grid[data-plan-grid] .plan-card.is-mobile-selected{display:flex}
      .pricing-matrix-disclosure>summary{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:52px;padding:0 14px;border:1px solid var(--ink-20);background:var(--white);color:var(--ink);font-size:.84rem;font-weight:900;cursor:pointer;list-style:none}
      .pricing-matrix-disclosure>summary::-webkit-details-marker{display:none}
      .pricing-matrix-disclosure>summary span{color:var(--teal);font-size:1.2rem;font-weight:400}
      .pricing-matrix-disclosure[open]>summary span{transform:rotate(45deg)}
      .pricing-matrix-disclosure[open] .matrix-legend{margin-top:20px}
    }
    @media(max-width:430px){.pricing-pending{display:grid;gap:4px}.pricing-mobile-guide{margin-inline:0}}
  </style>
</BaseLayout>

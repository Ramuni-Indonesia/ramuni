---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import StoryMicroVisual from '../../components/blog/StoryMicroVisual.astro';
import '../../styles/blog.css';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const featured = posts.find((post) => post.data.featured) || posts[0];
const latest = posts.filter((post) => post.id !== featured?.id);
const formatDate = (value: Date) => new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(value);
const publishedCategories = new Set(posts.map((post) => post.data.categorySlug));

const categoryCatalog = [
  { slug: 'penjualan-omzet', name: 'Penjualan & Omzet', description: 'Baca pola transaksi, produk terlaris, dan waktu ramai tanpa laporan yang rumit.', question: 'Produk mana yang mendorong omzet minggu ini?' },
  { slug: 'stok-inventori', name: 'Stok & Inventori', description: 'Pahami stok bergerak dan risiko kosong sebelum terlambat.', question: 'Barang mana yang perlu dicek hari ini?' },
  { slug: 'keuangan-umkm', name: 'Keuangan UMKM', description: 'Baca arus kas, biaya, dan margin dengan bahasa yang lebih ringan.', question: 'Mengapa kas terasa turun?' },
  { slug: 'pelanggan-crm', name: 'Pelanggan & CRM', description: 'Kenali pelanggan yang kembali belanja dan yang mulai pasif.', question: 'Siapa yang belum kembali belanja?' },
  { slug: 'operasional-bisnis', name: 'Operasional Bisnis', description: 'Rapikan cara melihat aktivitas harian, laporan, dan keputusan tim.', question: 'Pekerjaan mana yang sering berulang?' },
  { slug: 'ai-untuk-umkm', name: 'AI untuk UMKM', description: 'Pakai AI sebagai pendamping baca konteks, bukan pengganti keputusan.', question: 'Kapan hasil AI perlu dicek manusia?' },
  { slug: 'strategi-per-industri', name: 'Strategi per Industri', description: 'Temukan pertanyaan yang relevan untuk ritme usaha yang berbeda.', question: 'Apa sinyal penting di jenis usaha saya?' },
  { slug: 'panduan-ramuni', name: 'Panduan RAMUNI', description: 'Pelajari konsep RAMUNI dengan status fitur yang jelas.', question: 'Apa yang sudah tersedia dan apa yang belum?' },
];

const categories = categoryCatalog
  .map((category) => ({ ...category, count: posts.filter((post) => post.data.categorySlug === category.slug).length }))
  .filter((category) => category.count > 0);

const problems = [
  { label: 'Stok sering meleset', question: 'Barang mana yang perlu perhatian sebelum habis?', slug: 'stok-inventori' },
  { label: 'Kas terasa tidak jelas', question: 'Uang masuk dan keluar berubah karena apa?', slug: 'keuangan-umkm' },
  { label: 'AI untuk usaha', question: 'Apa yang boleh dibantu AI, dan apa yang tetap harus dicek manusia?', slug: 'ai-untuk-umkm' },
];

const readingPaths = [
  { title: 'Rapikan catatan', text: 'Mulai dari istilah, periode, dan angka yang paling sering membingungkan.', href: '/blog/kategori/operasional-bisnis' },
  { title: 'Baca perubahan', text: 'Bandingkan penjualan, stok, atau kas dengan periode yang setara.', href: '/blog/kategori/stok-inventori' },
  { title: 'Periksa sebelum bertindak', text: 'Gunakan bukti dan batas AI sebelum memilih langkah berikutnya.', href: '/blog/kategori/ai-untuk-umkm' },
].filter((item) => publishedCategories.has(item.href.split('/').pop() || ''));

const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Blog RAMUNI', url: new URL('/blog/', Astro.site || Astro.url.origin).toString(), description: 'Panduan praktis untuk membaca penjualan, stok, keuangan, pelanggan, dan AI untuk UMKM.' },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: new URL('/', Astro.site || Astro.url.origin).toString() },
    { '@type': 'ListItem', position: 2, name: 'Blog RAMUNI', item: new URL('/blog/', Astro.site || Astro.url.origin).toString() },
  ] },
];
---
<BaseLayout title="Blog Bisnis UMKM | RAMUNI" description="Panduan praktis untuk memahami penjualan, stok, keuangan, pelanggan, dan penggunaan AI yang aman untuk UMKM." schema={schema}>
  <section class="blog-hero">
    <div class="container blog-hero-grid">
      <div class="reveal is-visible">
        <div class="blog-issue-line"><span>Catatan usaha</span><span>Edisi awal / 2026</span></div>
        <p class="eyebrow">Blog RAMUNI</p>
        <h1>Angka usaha punya cerita.</h1>
        <p class="lede">Kami membantu Anda menemukan ceritanya: stok mana yang perlu dicek, ke mana kas bergerak, dan kapan jawaban AI harus diperiksa lagi.</p>
        <nav class="blog-hero-topics" aria-label="Topik utama blog RAMUNI">
          <a href="/blog/kategori/stok-inventori">Stok</a>
          <a href="/blog/kategori/keuangan-umkm">Arus kas</a>
          <a href="/blog/kategori/ai-untuk-umkm">AI untuk UMKM</a>
        </nav>
      </div>
      <div class="blog-hero-side reveal is-visible">
        <p class="blog-hero-note"><span>Untuk pemilik usaha</span> Baca satu topik, cek angkanya, lalu tentukan langkah kecil berikutnya.</p>
        <form class="blog-search" action="/blog/cari" method="get" role="search">
          <label for="blog-query">Apa yang ingin Anda pahami?</label>
          <div class="search-line"><input id="blog-query" name="q" type="search" placeholder="Coba cari: stok menipis" /><button type="submit">Cari</button></div>
          <small>Hindari nama pelanggan dan data transaksi.</small>
        </form>
      </div>
    </div>
  </section>

  {featured && <section class="section surface blog-featured-stage" aria-labelledby="featured-heading">
    <a class="container featured-story reveal" href={`/blog/${featured.id}`} aria-labelledby="featured-heading">
      <div class="featured-visual"><img src={featured.data.cover} width="1200" height="720" alt={featured.data.coverAlt} fetchpriority="high" /><StoryMicroVisual categorySlug={featured.data.categorySlug} /></div>
      <div class="featured-copy">
        <div class="featured-index"><span>Pilihan editor</span><b>01</b></div>
        <span class="blog-category-label">{featured.data.category}</span>
        <h2 id="featured-heading">{featured.data.title}</h2>
        <p>{featured.data.dek}</p>
        <span class="featured-read">Baca artikel <i aria-hidden="true">&rarr;</i></span>
        <div class="featured-meta"><span>{featured.data.authorName}</span><span>{formatDate(featured.data.updatedAt || featured.data.publishedAt)}</span><span>{featured.data.readingTime}</span></div>
      </div>
    </a>
  </section>}

  {readingPaths.length > 0 && <section class="section blog-reading-path" aria-labelledby="reading-path-heading">
    <div class="container blog-index-layout">
      <div class="blog-section-lead reveal"><p class="section-kicker">Jalur membaca</p><h2 id="reading-path-heading">Mulai dari dasar, lalu buka konteksnya.</h2><p>Urutan singkat untuk pembaca yang baru mulai merapikan data usaha.</p></div>
      <ol class="blog-reading-path__list">
        {readingPaths.map((path, index) => <li class="reveal"><a href={path.href}><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{path.title}</h3><p>{path.text}</p></div><b aria-hidden="true">Baca topik</b></a></li>)}
      </ol>
    </div>
  </section>}

  <section class="section blog-problem-stage" aria-labelledby="problem-heading">
    <div class="container blog-problem-layout">
      <div class="blog-section-lead reveal"><h2 id="problem-heading">Pertanyaan bisnis yang dekat dengan keseharian.</h2><p>Pilih masalah yang ingin Anda pahami lebih dulu.</p></div>
      <div class="blog-question-deck" aria-label="Pilih pertanyaan bisnis">
        {problems.map((problem, index) => <a class="blog-question-card reveal" href={`/blog/kategori/${problem.slug}`} style={`--i:${index}`}><span>0{index + 1}</span><strong>{problem.question}</strong><small>{problem.label}</small></a>)}
      </div>
    </div>
  </section>

  <section class="section surface" aria-labelledby="category-heading">
    <div class="container blog-index-layout">
      <div class="blog-section-lead reveal"><h2 id="category-heading">Pilih topik yang ingin dirapikan.</h2><p>Tiga topik awal dibuat untuk masalah yang paling sering muncul di usaha kecil.</p></div>
      <div class="category-index">
        {categories.map((category) => <a class="category-index-row reveal" href={`/blog/kategori/${category.slug}`}><div><h3>{category.name}</h3><p>{category.description}</p></div><div><span>{category.question}</span><small>{category.count} artikel</small></div></a>)}
      </div>
    </div>
  </section>

  <section class="section blog-latest-stage" aria-labelledby="latest-heading">
    <div class="container blog-index-layout">
      <div class="blog-section-lead reveal"><h2 id="latest-heading">Artikel untuk dibaca berikutnya.</h2><p>Pilih satu langkah yang paling dekat dengan masalah Anda.</p></div>
      <div class="editorial-cards">
        {latest.length ? latest.map((post, index) => <a class="editorial-card reveal" href={`/blog/${post.id}`} style={`--i:${index}`}><figure><img src={post.data.cover} width="1200" height="720" alt={post.data.coverAlt} loading="lazy" /><StoryMicroVisual categorySlug={post.data.categorySlug} compact /></figure><div><div class="editorial-card__top"><span>{post.data.category}</span><b>0{index + 2}</b></div><h3>{post.data.title}</h3><p>{post.data.dek}</p><small><span>{post.data.readingTime}</span><span>{formatDate(post.data.updatedAt || post.data.publishedAt)}</span></small><i class="editorial-card__read">Baca artikel &rarr;</i></div></a>) : <p class="blog-empty">Artikel berikutnya sedang disiapkan. Mulai dari kategori utama dulu.</p>}
      </div>
    </div>
  </section>

  <section class="section editorial-trust-stage" aria-labelledby="trust-heading">
    <div class="container editorial-trust-layout">
      <div class="reveal"><p class="section-kicker">Kepercayaan editorial</p><h2 id="trust-heading">Cara kami menjaga artikel tetap berguna.</h2><p>Topik sensitif harus punya sumber, batas yang jelas, dan peninjau yang sesuai sebelum dipublikasikan.</p></div>
      <nav class="editorial-policy-links" aria-label="Kebijakan editorial blog">
        <a href="/blog/kebijakan-editorial">Kebijakan editorial</a>
        <a href="/blog/metodologi-fact-check">Metodologi pengecekan fakta</a>
        <a href="/blog/kebijakan-sumber">Kebijakan sumber</a>
        <a href="/blog/kebijakan-pembaruan">Kebijakan pembaruan</a>
        <a href="/blog/koreksi">Koreksi</a>
      </nav>
    </div>
  </section>

  <section class="section blog-close-stage"><div class="container blog-close reveal"><div><h2>Punya satu angka usaha yang membingungkan?</h2><p>Lihat contoh cara RAMUNI mengubah catatan menjadi pertanyaan yang bisa diperiksa.</p></div><div class="button-row"><a class="button button--primary" href="/tour-produk-gratis">Coba Simulasi Gratis</a><a class="button button--secondary" href="/produk">Pelajari Produk</a></div></div></section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogDecisionCTA from '../../components/blog/BlogDecisionCTA.astro';
import BlogArticleGrid from '../../components/blog/BlogArticleGrid.astro';
import BlogPagination from '../../components/blog/BlogPagination.astro';
import { releaseGates } from '../../config/release';
import { blogCategories } from '../../data/blogTaxonomy';
import { getBlogPageHref, getBlogPosts, getVisibleBlogPosts, paginateBlogPosts } from '../../lib/blog';
import '../../styles/blog.css';

const posts = getVisibleBlogPosts(await getBlogPosts(), !releaseGates.siteIndexable);
const featured = posts.find((post) => post.data.featured) || posts[0];
const page = paginateBlogPosts(posts, 1);
const latest = page.items.filter((post) => post.id !== featured?.id);
const formatDate = (value: Date) => new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(value);
const categories = blogCategories
  .map((category) => ({ ...category, count: posts.filter((post) => post.data.categorySlug === category.slug).length }))
  .filter((category) => category.count > 0);

const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Blog RAMUNI', url: new URL('/blog/', Astro.site || Astro.url.origin).toString(), description: 'Panduan bisnis UMKM tentang HPP, stok, omzet, laba, arus kas, pelanggan, dan penggunaan AI dengan konteks yang jelas.' },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: new URL('/', Astro.site || Astro.url.origin).toString() },
    { '@type': 'ListItem', position: 2, name: 'Blog RAMUNI', item: new URL('/blog/', Astro.site || Astro.url.origin).toString() },
  ] },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Artikel terbaru RAMUNI', numberOfItems: page.totalItems, itemListElement: page.items.map((post, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: post.data.title,
    url: new URL(`/blog/${post.id}/`, Astro.site || Astro.url.origin).toString(),
  })) },
];
---
<BaseLayout
  title="Panduan Bisnis UMKM: Stok, Penjualan, dan Keuangan | RAMUNI"
  description="Pelajari HPP, stok, omzet, laba, arus kas, dan pelanggan melalui panduan praktis, contoh, template, serta kalkulator bisnis gratis dari RAMUNI."
  pageType="CollectionPage"
  noindex={releaseGates.siteIndexable && page.totalItems === 0}
  schema={schema}
  nextPage={page.totalPages > 1 ? getBlogPageHref(2) : undefined}
>
  <header class="blog-archive-hero">
    <div class="container blog-archive-hero__layout">
      <div>
        <p class="eyebrow">Blog RAMUNI</p>
        <h1>Panduan bisnis UMKM yang bisa langsung diperiksa.</h1>
        <p class="lede">Temukan cara menghitung HPP, membaca omzet dan laba, mengelola stok, memahami pelanggan, serta memakai AI dengan konteks yang jelas.</p>
      </div>
      <form class="blog-search blog-search--archive" action="/blog/cari/" method="get" role="search">
        <label for="blog-query">Cari artikel</label>
        <div class="search-line"><input id="blog-query" name="q" type="search" placeholder="Contoh: cara menghitung omzet" /><button type="submit">Cari</button></div>
        <small>Cari berdasarkan masalah, istilah, atau pekerjaan yang sedang Anda lakukan.</small>
      </form>
    </div>
    {categories.length > 0 && <nav class="container blog-category-strip" aria-label="Kategori artikel">
      <a class="is-active" href="/blog/">Semua artikel</a>
      {categories.map((category) => <a href={`/blog/kategori/${category.slug}/`}>{category.name}<span>{category.count}</span></a>)}
    </nav>}
  </header>

  {featured && <section class="section blog-featured-simple" aria-labelledby="featured-heading">
    <div class="container">
      <a class="blog-featured-simple__card" href={`/blog/${featured.id}/`} aria-labelledby="featured-heading">
        <figure><img src={featured.data.cover} width={featured.data.coverWidth} height={featured.data.coverHeight} alt={featured.data.coverAlt} fetchpriority="high" /></figure>
        <div>
          <span class="blog-featured-simple__label">Mulai di sini · {featured.data.category}</span>
          <h2 id="featured-heading">{featured.data.title}</h2>
          <p>{featured.data.dek}</p>
          <small>{formatDate(featured.data.updatedAt || featured.data.publishedAt)} · {featured.data.readingTime}</small>
          <strong>Baca artikel <i aria-hidden="true">&rarr;</i></strong>
        </div>
      </a>
    </div>
  </section>}

  <section class="section blog-archive-list" aria-labelledby="latest-heading">
    <div class="container">
      <div class="blog-archive-list__head">
        <div><p class="section-kicker">Artikel terbaru</p><h2 id="latest-heading">Mulai dari pertanyaan yang paling dekat.</h2></div>
        <a href="/blog/cari/">Cari semua artikel <span aria-hidden="true">&rarr;</span></a>
      </div>
      <BlogArticleGrid posts={latest} startPosition={featured ? 2 : 1} variant="archive" />
      <BlogPagination currentPage={page.currentPage} totalPages={page.totalPages} />
    </div>
  </section>

  <section class="blog-editorial-links" aria-label="Informasi editorial blog">
    <div class="container">
      <span>Transparansi editorial</span>
      <nav>
        <a href="/blog/penulis/">Penulis RAMUNI</a>
        <a href="/blog/kebijakan-editorial/">Kebijakan editorial</a>
        <a href="/blog/metodologi-fact-check/">Pengecekan fakta</a>
        <a href="/blog/kebijakan-sumber/">Kebijakan sumber</a>
        <a href="/blog/koreksi/">Koreksi artikel</a>
      </nav>
    </div>
  </section>

  <section class="section blog-close-stage" aria-labelledby="blog-final-cta-heading">
    <div class="container">
      <BlogDecisionCTA
        id="blog-final-cta"
        title="Sudah menemukan masalahnya? Lihat alurnya."
        text="Pilih satu kebutuhan usaha dan lihat contoh bagaimana RAMUNI menghubungkan catatan, bukti, dan langkah berikutnya sebelum Anda memutuskan."
        primaryLabel="Konsultasi"
        secondaryLabel="Pelajari Produk"
        secondaryHref="/produk/"
      />
    </div>
  </section>
</BaseLayout>

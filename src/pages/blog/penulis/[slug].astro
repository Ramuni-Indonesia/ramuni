---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getEditorialPerson } from '../../../data/editorialPeople';
import { releaseGates } from '../../../config/release';
import '../../../styles/blog.css';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  const authors = [...new Set(posts.map((post) => post.data.authorSlug))];
  return authors.map((slug) => ({ params: { slug }, props: { posts: posts.filter((post) => post.data.authorSlug === slug) } }));
}

const { posts } = Astro.props;
const author = getEditorialPerson(posts[0]?.data.authorSlug || 'tim-editorial-ramuni');
const authorName = author.name;
const sortedPosts = [...posts].sort((a, b) => (b.data.updatedAt || b.data.publishedAt).valueOf() - (a.data.updatedAt || a.data.publishedAt).valueOf());
const categories = [...new Set(sortedPosts.map((post) => post.data.category))];
const latestUpdate = sortedPosts[0]?.data.updatedAt || sortedPosts[0]?.data.publishedAt;
const formatDate = (value: Date) => new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(value);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': author.profileType === 'person' ? 'Person' : 'Organization',
    name: author.name,
    description: author.shortBio,
    memberOf: author.profileType === 'person' ? { '@type': 'Organization', name: author.organization } : undefined,
  },
};
---
<BaseLayout title={`${authorName} | Blog RAMUNI`} description="Profil Tim Editorial RAMUNI dan artikel yang disusun untuk membantu UMKM membaca konteks bisnis." noindex={!releaseGates.resourcePagesIndexable} schema={schema}>
  <header class="author-hero"><div class="container author-profile">
    <div class="author-mark"><img src={author.photo} width="160" height="160" alt={author.photoAlt} /></div>
    <div><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Beranda</a><span>/</span><a href="/blog/">Blog</a><span>/</span><span>Penulis</span></nav><p class="eyebrow">Profil Editorial</p><h1>{authorName}</h1><p class="author-role">{author.role} · {author.organization}</p><p class="lede">{author.shortBio}</p><div class="author-stats" aria-label="Ringkasan profil editorial"><span>{sortedPosts.length} artikel terbit</span><span>{categories.length} topik</span>{latestUpdate && <span>Diperbarui {formatDate(latestUpdate)}</span>}</div></div>
  </div></header>

  <section class="section author-about-stage" aria-labelledby="author-about-title"><div class="container author-about">
    <div><p class="section-kicker">Tentang tim</p><h2 id="author-about-title">Tulisan yang bisa dibaca, diuji, dan dikoreksi.</h2></div>
    <div class="author-about__body"><p>{author.fullBio}</p><div class="author-expertise" aria-label="Topik yang ditulis">{author.expertise.map((item) => <span>{item}</span>)}</div><p class="author-disclosure"><strong>Hubungan dengan RAMUNI:</strong> {author.disclosure}</p></div>
  </div></section>

  <section class="section surface author-articles-stage"><div class="container author-reading-layout"><div class="category-reading-head"><div><p class="section-kicker">Artikel</p><h2>Ditulis oleh tim ini.</h2></div><p>Urutan mengikuti pembaruan terakhir.</p></div><div class="reading-list reading-list--visual author-reading-list">{sortedPosts.map((post) => <a class="reading-row" href={`/blog/${post.id}/`}><figure><img src={post.data.cover} width="1200" height="720" alt={post.data.coverAlt} loading="lazy" /></figure><div><span>{post.data.category}</span><h3>{post.data.title}</h3><p>{post.data.dek}</p><small>{post.data.readingTime}</small></div><small aria-hidden="true">Baca &rarr;</small></a>)}</div></div></section>

  <section class="section editorial-trust-stage"><div class="container editorial-trust-layout"><div><p class="section-kicker">Akuntabilitas</p><h2>Cara kerja editorial kami.</h2><p>Setiap artikel mencantumkan tanggal pembaruan, cara contoh disusun, batas penggunaan, dan jalur koreksi yang dapat diakses pembaca.</p><ul class="editorial-checklist" aria-label="Bukti editorial"><li>Contoh dan catatan metode</li><li>Status fitur yang disebutkan</li><li>Riwayat pembaruan artikel</li></ul></div><nav class="editorial-policy-links" aria-label="Kebijakan editorial"><a href="/blog/kebijakan-editorial/">Kebijakan editorial</a><a href="/blog/metodologi-fact-check/">Metodologi pengecekan fakta</a><a href="/blog/kebijakan-sumber/">Kebijakan sumber</a><a href="/blog/koreksi/">Kirim koreksi</a></nav></div></section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import ArticleContextVisual from '../../components/blog/ArticleContextVisual.astro';
import ArticleBodyBlocks from '../../components/blog/ArticleBodyBlocks.astro';
import ArticleProductBridge from '../../components/blog/ArticleProductBridge.astro';
import { getArticleHeadings, getBlogPosts, getRelatedBlogPosts } from '../../lib/blog';
import { getEditorialPerson } from '../../data/editorialPeople';
import { getArticleCalculator } from '../../data/articleCalculators';
import { getArticleJourney } from '../../data/articleJourneys';
import { getArticleCtaCopy, getArticleCtaVisual } from '../../data/articleCtaVisuals';
import { getArticleVisualPlacement } from '../../data/articleVisualPlacement';
import calculatorWidgetStyles from '../../styles/calculator-widget.css?inline';
import '../../styles/blog.css';

export async function getStaticPaths() {
  const posts = (await getBlogPosts()).filter((post) => !post.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const renderedLocal = post.localEntry ? await render(post.localEntry) : undefined;
const Content = renderedLocal?.Content;
const headings = renderedLocal?.headings || getArticleHeadings(post);
const formatDate = (value: Date) => new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(value);
const updatedAt = post.data.updatedAt || post.data.publishedAt;
const hasMaterialUpdate = Boolean(post.data.updatedAt);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const relatedPosts = getRelatedBlogPosts(post, posts);
const articleJourney = getArticleJourney(post.data.categorySlug, post.id);
const articleCtaVisual = getArticleCtaVisual(post.data.categorySlug, post.data.title, post.data.cover);
const articleCtaCopy = getArticleCtaCopy(post.data.title, articleJourney);
const author = getEditorialPerson(post.data.authorSlug);
const embeddedCalculator = getArticleCalculator(post.id);
const CalculatorWidget = embeddedCalculator ? (await import('../../components/CalculatorWidget.astro')).default : undefined;
const articleResources = {
  'ai-business-companion-umkm': {
    title: 'Uji jawaban AI sebelum dipakai.',
    text: 'Gunakan panduan pemeriksaan untuk melihat pertanyaan, bukti, periode, konteks, dan persetujuan manusia.',
    primary: { label: 'Buka panduan menilai insight AI', href: '/panduan/menilai-insight-ai/' },
    secondary: { label: 'Kenali Asisten AI RAMUNI', href: '/produk/asisten-ai/' },
  },
  'arus-kas-umkm-ringan': {
    title: 'Buka catatan.',
    text: 'Hitung selisih kas di artikel, lalu gunakan template agar tanggal uang masuk dan keluar tetap dapat diperiksa.',
    primary: { label: 'Template arus kas', href: '/template/arus-kas-sederhana/' },
    secondary: { label: 'Pelajari modul keuangan', href: '/produk/keuangan/' },
  },
  'panduan-membaca-stok-harian': {
    title: 'Bawa urutan cek ke pekerjaan harian.',
    text: 'Perkirakan titik pemeriksaan di artikel, lalu simpan saldo, koreksi, dan waktu pembaruan dalam format yang konsisten.',
    primary: { label: 'Gunakan kalkulator reorder stok', href: '/kalkulator/reorder-stok/' },
    secondary: { label: 'Pelajari modul inventori', href: '/produk/inventori/' },
  },
  'cara-menentukan-stok-minimum-umkm': {
    title: 'Periksa stok minimum sebelum dipakai tim.',
    text: 'Hitung perkiraan reorder, lalu bawa hasilnya ke pemeriksaan saldo fisik dan waktu tunggu pemasok.',
    primary: { label: 'Gunakan kalkulator reorder stok', href: '/kalkulator/reorder-stok/' },
    secondary: { label: 'Pelajari modul inventori', href: '/produk/inventori/' },
  },
  'laporan-laba-rugi-sederhana-umkm': {
    title: 'Rapikan komponen laporan sebelum menilai hasil.',
    text: 'Susun pendapatan, HPP, dan biaya operasional dengan template agar sumber angka lebih mudah diperiksa.',
    primary: { label: 'Buka template HPP produk', href: '/template/hpp-produk/' },
    secondary: { label: 'Pelajari modul keuangan', href: '/produk/keuangan/' },
  },
  'contoh-laporan-penjualan-harian': {
    title: 'Mulai dari format yang bisa dipakai setiap hari.',
    text: 'Gunakan template rekap untuk memisahkan transaksi, diskon, retur, dan penjualan bersih sebelum menilai perubahan omzet.',
    primary: { label: 'Buka template penjualan harian', href: '/template/penjualan-harian/' },
    secondary: { label: 'Pelajari modul penjualan', href: '/produk/penjualan/' },
  },
  'biaya-tetap-dan-biaya-variabel': {
    title: 'Uji asumsi biaya dengan satu perhitungan sederhana.',
    text: 'Masukkan harga, biaya variabel, dan biaya periode untuk melihat batas penjualan yang perlu diperiksa bersama kapasitas usaha.',
    primary: { label: 'Gunakan kalkulator titik impas', href: '/kalkulator/titik-impas/' },
    secondary: { label: 'Pelajari modul keuangan', href: '/produk/keuangan/' },
  },
  'cara-membuat-laporan-penjualan-bulanan': {
    title: 'Mulai dari rekap yang dapat dibandingkan.',
    text: 'Gunakan format harian yang konsisten sebelum merangkum transaksi, diskon, retur, kanal, dan temuan bulan berjalan.',
    primary: { label: 'Buka template penjualan harian', href: '/template/penjualan-harian/' },
    secondary: { label: 'Pelajari modul penjualan', href: '/produk/penjualan/' },
  },
  'cara-menghitung-laba-bersih-usaha': {
    title: 'Uji hubungan penjualan, HPP, dan biaya.',
    text: 'Gunakan perhitungan awal untuk memeriksa komponen laba usaha sebelum membaca hasilnya bersama kas dan kewajiban periode.',
    primary: { label: 'Gunakan kalkulator laba usaha', href: '/kalkulator/laba-usaha/' },
    secondary: { label: 'Pelajari modul keuangan', href: '/produk/keuangan/' },
  },
  'contoh-laporan-stok-barang-untuk-toko': {
    title: 'Bawa ringkasan ke pemeriksaan stok berikutnya.',
    text: 'Catat saldo, status barang, fisik, selisih, dan tindak lanjut agar laporan tidak menggantikan kartu stok atau opname.',
    primary: { label: 'Buka template stok harian', href: '/template/stok-harian/' },
    secondary: { label: 'Pelajari modul inventori', href: '/produk/inventori/' },
  },
} as const;
const articleResource = articleResources[post.id as keyof typeof articleResources];
const visualPlacement = getArticleVisualPlacement(post.id, post.data.title, headings);
const reviewerProfile = post.data.reviewerSlug ? getEditorialPerson(post.data.reviewerSlug) : undefined;
const hasVerifiedReviewer = Boolean(
  post.data.reviewStatus === 'reviewed'
  && post.data.reviewerName
  && post.data.reviewerSlug
  && post.data.reviewerSlug !== post.data.authorSlug
  && reviewerProfile
  && reviewerProfile.slug === post.data.reviewerSlug
  && reviewerProfile.name === post.data.reviewerName,
);
const reviewer = hasVerifiedReviewer ? reviewerProfile : undefined;

const articleUrl = new URL(`/blog/${post.id}/`, Astro.site || Astro.url.origin).toString();
const siteOrigin = new URL('/', Astro.site || Astro.url.origin).origin;
const organizationId = `${siteOrigin}/#organization`;
const authorUrl = new URL(`/blog/penulis/${author.slug}/`, Astro.site || Astro.url.origin).toString();
const articleImage = new URL(post.data.cover, Astro.site || Astro.url.origin).toString();
const coverWidth = post.data.coverWidth;
const coverHeight = post.data.coverHeight;
const articleIndexable = post.data.reviewStatus === 'reviewed' && !post.data.noindex;
const faqSchema = post.data.faqs.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.data.faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
} : undefined;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${articleUrl}#article`,
    url: articleUrl,
    headline: post.data.title,
    description: post.data.description,
    image: articleImage,
    inLanguage: 'id-ID',
    articleSection: post.data.category,
    keywords: post.data.tags,
    ...(post.data.createdAt ? { dateCreated: post.data.createdAt.toISOString() } : {}),
    datePublished: post.data.publishedAt.toISOString(),
    dateModified: updatedAt.toISOString(),
    author: { '@type': author.profileType === 'person' ? 'Person' : 'Organization', '@id': `${authorUrl}#author`, name: author.name, url: authorUrl },
    publisher: { '@type': 'Organization', '@id': organizationId, name: 'RAMUNI', logo: { '@type': 'ImageObject', url: new URL('/brand/ramuni-mark-color.webp', Astro.site || Astro.url.origin).toString() } },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': articleUrl,
      ...(reviewer ? {
        reviewedBy: {
          '@type': reviewer.profileType === 'person' ? 'Person' : 'Organization',
          name: reviewer.name,
          url: new URL(`/blog/penulis/${reviewer.slug}/`, Astro.site || Astro.url.origin).toString(),
        },
        ...(post.data.reviewedAt ? { lastReviewed: post.data.reviewedAt.toISOString() } : {}),
      } : {}),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: new URL('/', Astro.site || Astro.url.origin).toString() },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site || Astro.url.origin).toString() },
      { '@type': 'ListItem', position: 3, name: post.data.category, item: new URL(`/blog/kategori/${post.data.categorySlug}/`, Astro.site || Astro.url.origin).toString() },
      { '@type': 'ListItem', position: 4, name: post.data.title, item: articleUrl },
    ],
  },
  ...(faqSchema ? [faqSchema] : []),
];
---
<BaseLayout title={post.data.title} description={post.data.description} image={post.data.cover} imageAlt={post.data.coverAlt} imageWidth={coverWidth} imageHeight={coverHeight} noindex={!articleIndexable} schema={schema} ogType="article" keywords={post.data.tags}>
  {embeddedCalculator && <style is:inline set:html={calculatorWidgetStyles} />}
  <div class="article-reading-progress" aria-hidden="true"><i></i></div>
  <article data-cms-snapshot={post.snapshotId}>
    <header class="article-hero">
      <div class="container article-head">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Beranda</a><span>/</span><a href="/blog/">Blog</a><span>/</span><a href={`/blog/kategori/${post.data.categorySlug}/`}>{post.data.category}</a><span>/</span><span aria-current="page">Artikel</span></nav>
        <a class="article-category" href={`/blog/kategori/${post.data.categorySlug}/`}>{post.data.category}</a>
        <h1>{post.data.title}</h1>
        <p class="article-dek">{post.data.dek}</p>
        <div class="article-trust-row" aria-label="Akuntabilitas artikel">
          <div><span>Ditulis oleh</span><a href={`/blog/penulis/${post.data.authorSlug}/`}>{post.data.authorName}</a></div>
          {hasVerifiedReviewer && <div><span>Ditinjau oleh</span><strong>{post.data.reviewerName}</strong></div>}
          <div><span>Koreksi</span><a href="/blog/koreksi/">Sampaikan perbaikan</a></div>
        </div>
        <div class="article-date-row"><span>Diterbitkan {formatDate(post.data.publishedAt)}</span>{hasMaterialUpdate && <span>Diperbarui {formatDate(updatedAt)}</span>}<span>Waktu baca {post.data.readingTime}</span></div>
        <div class="article-tags" aria-label="Topik artikel">{post.data.tags.map((tag) => <span>{tag}</span>)}</div>
        <figure class="article-cover" style={`--article-cover-ratio:${coverWidth}/${coverHeight}`}><div><img src={post.data.cover} width={coverWidth} height={coverHeight} alt={post.data.coverAlt} fetchpriority="high" /></div><figcaption>Visual ringkas untuk membantu membaca isi artikel.</figcaption></figure>
      </div>
    </header>

    <section class="article-reading-stage">
      <div class="container article-reading-grid">
        <div class="article-main">
          <section class="article-short-answer" aria-labelledby="short-answer"><span>Ringkasan / 30 detik</span><h2 id="short-answer">Yang perlu diingat</h2><ol>{post.data.takeaways.map((item, index) => <li><b>0{index + 1}</b><p>{item}</p></li>)}</ol><a class="article-short-answer__next" href={articleJourney.tourHref}>Coba alur {articleJourney.label.toLocaleLowerCase('id-ID')} gratis <i aria-hidden="true">&rarr;</i></a></section>

          {toc.length > 0 && <details class="article-toc-mobile" data-article-toc>
            <summary><span>Lihat isi artikel</span><i aria-hidden="true">+</i></summary>
            <ol>{toc.map((heading) => <li class={heading.depth === 3 ? 'toc-sub' : ''}><a href={`#${heading.slug}`} data-toc-link>{heading.text}</a></li>)}</ol>
          </details>}

          <div class="article-content" data-visual-placement={visualPlacement.mode} data-visual-anchor={visualPlacement.anchor}>
            {Content ? <Content /> : <ArticleBodyBlocks blocks={post.bodyBlocks || []} />}
            <ArticleContextVisual articleId={post.id} articleTitle={post.data.title} articleDescription={post.data.description} />
          </div>

          {embeddedCalculator && CalculatorWidget && <CalculatorWidget kind={embeddedCalculator} embedded />}

          {articleResource && !embeddedCalculator && <aside class="article-resource-bridge" aria-labelledby="article-resource-title">
            <div><span>Gunakan bersama artikel</span><h2 id="article-resource-title">{articleResource.title}</h2><p>{articleResource.text}</p></div>
            <nav aria-label="Sumber daya kontekstual"><a href={articleResource.primary.href}>{articleResource.primary.label}<i aria-hidden="true">&rarr;</i></a><a href={articleResource.secondary.href}>{articleResource.secondary.label}<i aria-hidden="true">&rarr;</i></a></nav>
          </aside>}

          <ArticleProductBridge categorySlug={post.data.categorySlug} articleId={post.id} articleTitle={post.data.title} articleCover={post.data.cover} />

          {post.data.faqs.length > 0 && <section class="article-faq" aria-labelledby="article-faq-heading">
            <p class="section-kicker">FAQ</p>
            <h2 id="article-faq-heading">Pertanyaan yang sering muncul</h2>
            <div class="article-faq__list">{post.data.faqs.map((item, index) => <details class="article-faq__item">
              <summary><span class="article-faq__index">{String(index + 1).padStart(2, '0')}</span><strong>{item.question}</strong><i aria-hidden="true">+</i></summary>
              <div class="article-faq__answer"><p>{item.answer}</p></div>
            </details>)}</div>
          </section>}

          <section class="article-method" aria-labelledby="source-heading"><h2 id="source-heading">Sumber dan catatan metode</h2>
            {post.data.sources.length ? <ol class="source-list">{post.data.sources.map((source) => <li><strong>{source.url ? <a href={source.url} rel="noreferrer">{source.title}</a> : source.title}</strong><span>{source.publisher}</span><p>{source.note}</p></li>)}</ol> : <p class="source-empty"><strong>Tidak ada statistik eksternal dalam artikel ini.</strong> Angka dan nama usaha pada skenario dibuat untuk menjelaskan cara membaca catatan. Definisi, asumsi, dan konteks penggunaan ditulis langsung pada bagian yang relevan.</p>}
            {post.data.disclaimer && <p class="article-disclaimer">{post.data.disclaimer}</p>}
          </section>

          {hasMaterialUpdate && <section class="article-update" aria-labelledby="update-heading"><h2 id="update-heading">Riwayat pembaruan</h2><div><time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time><p>{post.data.updateSummary}</p></div></section>}

          <section class="article-people" aria-labelledby="author-heading"><img src={author.photo} width="96" height="96" alt={author.photoAlt} /><div><span class="article-people__role">Penulis</span><h2 id="author-heading">{author.name}</h2><p>{author.shortBio}</p><a class="text-link" href={`/blog/penulis/${author.slug}/`}>Lihat profil editorial</a></div></section>

        </div>

        <aside class="article-rail" aria-label="Navigasi artikel">
          {toc.length > 0 && <nav><strong>Isi artikel</strong><ol>{toc.map((heading) => <li class={heading.depth === 3 ? 'toc-sub' : ''}><a href={`#${heading.slug}`} data-toc-link>{heading.text}</a></li>)}</ol></nav>}
          <section class="article-rail-cta" aria-labelledby="article-rail-cta-title">
            <a class="article-rail-cta__card" href={articleJourney.tourHref} aria-labelledby="article-rail-cta-title">
              <img class="article-rail-cta__banner" src={articleCtaVisual.src} width={articleCtaVisual.width} height={articleCtaVisual.height} alt={articleCtaVisual.alt} loading="lazy" decoding="async" />
              <span class="article-rail-cta__shade" aria-hidden="true"></span>
              <span class="article-rail-cta__content">
                <span class="article-rail-cta__eyebrow">Lanjut ke {articleJourney.label}</span>
                <strong id="article-rail-cta-title">{articleCtaCopy.title}</strong>
                <span class="article-rail-cta__text">{articleCtaCopy.text}</span>
                <span class="article-rail-cta__action">Lihat alur <i aria-hidden="true">&rarr;</i></span>
              </span>
            </a>
          </section>
        </aside>
      </div>
    </section>
  </article>

  {relatedPosts.length > 0 && <section class="section article-related-stage" aria-labelledby="related-heading"><div class="container article-related-layout"><div class="article-related-head"><p class="section-kicker">Bacaan terkait</p><h2 id="related-heading">Lihat angka dari sisi lain.</h2><p>Pilih satu topik untuk melanjutkan, tanpa mengulang seluruh artikel.</p></div><div class="editorial-cards editorial-cards--compact">{relatedPosts.map((related, index) => <a class="editorial-card" href={`/blog/${related.id}/`}><figure><img src={related.data.cover} width={related.data.coverWidth} height={related.data.coverHeight} alt={related.data.coverAlt} loading="lazy" /></figure><div><div class="editorial-card__top"><span>{related.data.category}</span><b>0{index + 1}</b></div><h3>{related.data.title}</h3><p>{related.data.dek}</p><small>{related.data.readingTime}</small><i class="editorial-card__read">Baca artikel &rarr;</i></div></a>)}</div></div></section>}

  <script>
    const placeArticleVisual = () => {
      const content = document.querySelector('.article-content');
      const visual = content?.querySelector('.article-context-visual');
      if (!(content instanceof HTMLElement) || !(visual instanceof HTMLElement) || visual.dataset.placed === 'true') return;
      const placement = content.dataset.visualPlacement;
      const anchor = content.dataset.visualAnchor;
      const headings = Array.from(content.querySelectorAll(':scope > h2'));
      const target = placement === 'heading' && anchor
        ? headings.find((heading) => heading.id === anchor)
        : content.querySelector(':scope > table');
      if (target instanceof HTMLElement) target.before(visual);
      visual.dataset.placed = 'true';
    };
    placeArticleVisual();
    document.addEventListener('astro:page-load', placeArticleVisual);

    const enhanceArticleTables = () => {
      document.querySelectorAll('.article-content table').forEach((table) => {
        if (!(table instanceof HTMLTableElement) || table.parentElement?.classList.contains('article-table-scroll')) return;
        const wrapper = document.createElement('div');
        wrapper.className = 'article-table-scroll';
        wrapper.setAttribute('role', 'region');
        wrapper.setAttribute('tabindex', '0');
        wrapper.setAttribute('aria-label', 'Tabel artikel; geser horizontal untuk melihat kolom lain');
        table.parentNode?.insertBefore(wrapper, table);
        wrapper.append(table);
      });
    };
    enhanceArticleTables();
    document.addEventListener('astro:page-load', enhanceArticleTables);

    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    const tocTargets = tocLinks
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((node): node is HTMLElement => node instanceof HTMLElement);
    const setActiveToc = (id: string) => {
      tocLinks.forEach((link) => {
        const active = decodeURIComponent(link.hash.slice(1)) === id;
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };
    document.querySelectorAll<HTMLAnchorElement>('[data-article-toc] [data-toc-link]').forEach((link) => {
      link.addEventListener('click', () => {
        const toc = link.closest('[data-article-toc]');
        if (toc instanceof HTMLDetailsElement) window.requestAnimationFrame(() => { toc.open = false; });
      });
    });
    if (tocTargets.length) {
      setActiveToc(tocTargets[0].id);
      if ('IntersectionObserver' in window) {
        const tocObserver = new IntersectionObserver((entries) => {
          const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (visible?.target instanceof HTMLElement) setActiveToc(visible.target.id);
        }, { rootMargin: '-18% 0px -68% 0px', threshold: 0 });
        tocTargets.forEach((target) => tocObserver.observe(target));
      }
    }
  </script>

</BaseLayout>

<style is:global>
  .article-faq__list{display:grid;gap:10px;margin-top:24px;border-top:0}.article-faq__item{padding:0!important;border:1px solid var(--ink-10);background:var(--white);transition:border-color var(--fast),background var(--fast),box-shadow var(--fast)}.article-faq__item[open]{border-color:var(--teal);background:var(--rice);box-shadow:0 12px 32px rgb(11 48 69/.07)}.article-faq__item summary{display:grid;grid-template-columns:38px minmax(0,1fr) 28px;gap:14px;align-items:center;padding:20px 22px;cursor:pointer;list-style:none;font-weight:400}.article-faq__item summary::-webkit-details-marker{display:none}.article-faq__index{display:grid;width:30px;height:30px;place-items:center;border-radius:50%;background:var(--yellow);color:var(--ink);font-size:.68rem;font-weight:900;font-variant-numeric:tabular-nums}.article-faq__item summary strong{font-size:.98rem;line-height:1.4}.article-faq__item summary i{display:grid;width:26px;height:26px;place-items:center;border:1px solid var(--ink-20);border-radius:50%;color:var(--teal);font-size:1.1rem;font-style:normal;line-height:1;transition:transform var(--fast),background var(--fast),color var(--fast)}.article-faq__item[open] summary i{transform:rotate(45deg);background:var(--teal);color:var(--white)}.article-faq__answer{padding:0 64px 22px 74px}.article-faq__answer p{max-width:64ch;margin:0;color:var(--ink-72);line-height:1.7}.article-faq__item summary:focus-visible{outline:3px solid var(--teal-12);outline-offset:-3px}
  @media(max-width:1200px){.article-toc-mobile[data-article-toc]{position:sticky;bottom:max(74px,calc(env(safe-area-inset-bottom) + 68px));z-index:30;display:block;margin:0 0 30px;padding:0;border:1px solid var(--ink-20);border-radius:14px;background:rgb(255 255 255/.96);box-shadow:0 12px 34px rgb(11 48 69/.14);backdrop-filter:blur(12px)}.article-toc-mobile[data-article-toc] summary{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:15px 17px;list-style:none;color:var(--ink)}.article-toc-mobile[data-article-toc] summary::-webkit-details-marker{display:none}.article-toc-mobile[data-article-toc] summary i{display:grid;width:26px;height:26px;place-items:center;border:1px solid var(--ink-20);border-radius:50%;color:var(--teal);font-size:1.15rem;font-style:normal;line-height:1;transition:transform var(--fast),background var(--fast),color var(--fast)}.article-toc-mobile[data-article-toc][open] summary i{transform:rotate(45deg);background:var(--teal);color:var(--white)}.article-toc-mobile[data-article-toc] ol{max-height:min(48dvh,390px);overflow:auto;margin:0;padding:0 17px 14px;gap:4px}.article-toc-mobile[data-article-toc] summary:focus-visible{outline:3px solid var(--teal-12);outline-offset:-3px}}

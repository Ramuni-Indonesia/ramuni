---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import StoryMicroVisual from '../../components/blog/StoryMicroVisual.astro';
import { getEditorialPerson } from '../../data/editorialPeople';
import type { CalculatorKey } from '../../data/calculators';
import calculatorWidgetStyles from '../../styles/calculator-widget.css?inline';
import '../../styles/blog.css';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const formatDate = (value: Date) => new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(value);
const updatedAt = post.data.updatedAt || post.data.publishedAt;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const relatedPosts = post.data.related.flatMap((id) => {
  const related = posts.find((entry) => entry.id === id);
  return related ? [related] : [];
}).slice(0, 4);
const author = getEditorialPerson(post.data.authorSlug);
const embeddedCalculator: CalculatorKey | undefined = post.id === 'panduan-membaca-stok-harian' ? 'reorder-stok' : undefined;
const CalculatorWidget = embeddedCalculator ? (await import('../../components/CalculatorWidget.astro')).default : undefined;
const hasVerifiedReviewer = Boolean(
  post.data.reviewStatus === 'reviewed'
  && post.data.reviewerName
  && post.data.reviewerSlug
  && post.data.reviewerSlug !== post.data.authorSlug,
);

const cta = {
  'early-access': { title: 'Coba cara membaca masalah usaha ini.', text: 'Gunakan data contoh tanpa membuat akun.', label: 'Coba langkahnya', href: '/tour-produk-gratis' },
  demo: { title: 'Lihat cara RAMUNI membaca angka usaha.', text: 'Simulasi memakai data contoh, bukan data bisnis Anda.', label: 'Coba simulasi', href: '/tour-produk-gratis' },
  product: { title: 'Pilih area kerja yang ingin Anda pelajari.', text: 'Lihat modul yang membantu membaca data usaha dengan lebih jelas.', label: 'Pelajari Produk', href: '/produk' },
}[post.data.ctaType];

const articleUrl = new URL(`/blog/${post.id}/`, Astro.site || Astro.url.origin).toString();
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    image: new URL(post.data.cover, Astro.site || Astro.url.origin).toString(),
    datePublished: post.data.publishedAt.toISOString(),
    dateModified: updatedAt.toISOString(),
    author: { '@type': author.profileType === 'person' ? 'Person' : 'Organization', name: author.name, url: new URL(`/blog/penulis/${author.slug}/`, Astro.site || Astro.url.origin).toString() },
    publisher: { '@type': 'Organization', name: 'RAMUNI', logo: { '@type': 'ImageObject', url: new URL('/brand/ramuni-mark-color.webp', Astro.site || Astro.url.origin).toString() } },
    mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: new URL('/', Astro.site || Astro.url.origin).toString() },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site || Astro.url.origin).toString() },
      { '@type': 'ListItem', position: 3, name: post.data.category, item: new URL(`/blog/kategori/${post.data.categorySlug}/`, Astro.site || Astro.url.origin).toString() },
      { '@type': 'ListItem', position: 4, name: post.data.title, item: articleUrl },
    ],
  },
];
---
<BaseLayout title={post.data.title} description={post.data.description} image={post.data.cover} imageAlt={post.data.coverAlt} imageWidth={1200} imageHeight={720} noindex={post.data.noindex} schema={schema} ogType="article">
  {embeddedCalculator && <style is:inline set:html={calculatorWidgetStyles} />}
  <div class="article-reading-progress" role="progressbar" aria-label="Progres membaca artikel" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-reading-progress><i></i></div>
  <article>
    <header class="article-hero">
      <div class="container article-head">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Beranda</a><span>/</span><a href="/blog">Blog</a><span>/</span><a href={`/blog/kategori/${post.data.categorySlug}`}>{post.data.category}</a><span>/</span><span aria-current="page">Artikel</span></nav>
        <a class="article-category" href={`/blog/kategori/${post.data.categorySlug}`}>{post.data.category}</a>
        <h1>{post.data.title}</h1>
        <p class="article-dek">{post.data.dek}</p>
        <div class="article-trust-row" aria-label="Akuntabilitas artikel">
          <div><span>Ditulis oleh</span><a href={`/blog/penulis/${post.data.authorSlug}`}>{post.data.authorName}</a></div>
          {hasVerifiedReviewer && <div><span>Ditinjau oleh</span><a href={`/blog/penulis/${post.data.reviewerSlug}`}>{post.data.reviewerName}</a></div>}
          {!hasVerifiedReviewer && <div><span>Cara disusun</span><strong>{post.data.editorialStatus}</strong></div>}
          <div><span>Koreksi</span><a href="/blog/koreksi">Sampaikan perbaikan</a></div>
        </div>
        <div class="article-date-row"><span>Diterbitkan {formatDate(post.data.publishedAt)}</span><span>Diperbarui {formatDate(updatedAt)}</span><span>Waktu baca {post.data.readingTime}</span></div>
        <div class="article-tags" aria-label="Topik artikel">{post.data.tags.map((tag) => <span>{tag}</span>)}</div>
        <figure class="article-cover"><div><img src={post.data.cover} width="1200" height="720" alt={post.data.coverAlt} fetchpriority="high" /><StoryMicroVisual categorySlug={post.data.categorySlug} /></div><figcaption>Visual ringkas memakai data contoh untuk membantu membaca isi artikel.</figcaption></figure>
      </div>
    </header>

    <section class="article-reading-stage">
      <div class="container article-reading-grid">
        <div class="article-main">
          <section class="article-short-answer" aria-labelledby="short-answer"><span>Ringkasan / 30 detik</span><h2 id="short-answer">Yang perlu diingat</h2><ol>{post.data.takeaways.map((item, index) => <li><b>0{index + 1}</b><p>{item}</p></li>)}</ol></section>

          {toc.length > 0 && <details class="article-toc-mobile"><summary>Lihat isi artikel</summary><ol>{toc.map((heading) => <li class={heading.depth === 3 ? 'toc-sub' : ''}><a href={`#${heading.slug}`} data-toc-link>{heading.text}</a></li>)}</ol></details>}

          <div class="article-content"><Content /></div>

          {embeddedCalculator && CalculatorWidget && <CalculatorWidget kind={embeddedCalculator} embedded />}

          <aside class="article-inline-cta" aria-label="Langkah berikutnya"><div><h2>{cta.title}</h2><p>{cta.text}</p></div><a class="button button--primary" href={cta.href}>{cta.label}</a></aside>

          <section class="article-method" aria-labelledby="source-heading"><h2 id="source-heading">Sumber dan catatan metode</h2>
            {post.data.sources.length ? <ol class="source-list">{post.data.sources.map((source) => <li><strong>{source.url ? <a href={source.url} rel="noreferrer">{source.title}</a> : source.title}</strong><span>{source.publisher}</span><p>{source.note}</p></li>)}</ol> : <p class="source-empty"><strong>Tidak ada statistik eksternal dalam artikel ini.</strong> Contoh angka dan nama usaha dibuat sintetis untuk menjelaskan cara membaca data. Definisi, asumsi, dan batas penggunaan ditulis langsung pada bagian yang relevan.</p>}
            {post.data.disclaimer && <p class="article-disclaimer">{post.data.disclaimer}</p>}
          </section>

          <section class="article-update" aria-labelledby="update-heading"><h2 id="update-heading">Riwayat pembaruan</h2><div><time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time><p>{post.data.updateSummary}</p></div></section>

          <section class="article-people" aria-labelledby="author-heading"><img src={author.photo} width="96" height="96" alt="" /><div><span class="article-people__role">Penulis</span><h2 id="author-heading">{author.name}</h2><p>{author.shortBio}</p><a class="text-link" href={`/blog/penulis/${author.slug}`}>Lihat profil editorial</a></div>
            <div class="article-review-state"><span>Peninjauan</span>{hasVerifiedReviewer ? <><strong>{post.data.reviewerName}</strong><p>Revisi yang sedang dibaca telah disetujui oleh peninjau tersebut.</p></> : <><strong>Peninjau ahli belum ditampilkan</strong><p>Artikel ini menggunakan contoh sintetis dan bukan nasihat profesional.</p></>}</div>
          </section>

        </div>

        <aside class="article-rail" aria-label="Navigasi artikel">
          {toc.length > 0 && <nav><strong>Isi artikel</strong><small>Pilih bagian yang paling Anda butuhkan.</small><ol>{toc.map((heading) => <li class={heading.depth === 3 ? 'toc-sub' : ''}><a href={`#${heading.slug}`} data-toc-link>{heading.text}</a></li>)}</ol></nav>}
          <div class="article-rail-note"><span>Cara artikel disusun</span><p>{post.data.editorialStatus}</p><a href="/blog/kebijakan-editorial">Lihat standar editorial</a></div>
          <div class="article-rail-cta"><strong>Ingin coba alurnya?</strong><p>Pilih stok, penjualan, atau kas. Kami siapkan data contohnya.</p><a class="button button--primary" href="/tour-produk-gratis">Coba Simulasi Gratis</a></div>
        </aside>
      </div>
    </section>
  </article>

  {relatedPosts.length > 0 && <section class="section article-related-stage" aria-labelledby="related-heading"><div class="container article-related-layout"><div class="article-related-head"><p class="section-kicker">Bacaan terkait</p><h2 id="related-heading">Lihat angka dari sisi lain.</h2><p>Pilih satu topik untuk melanjutkan, tanpa mengulang seluruh artikel.</p></div><div class="editorial-cards editorial-cards--compact">{relatedPosts.map((related, index) => <a class="editorial-card" href={`/blog/${related.id}`}><figure><img src={related.data.cover} width="1200" height="720" alt={related.data.coverAlt} loading="lazy" /><StoryMicroVisual categorySlug={related.data.categorySlug} compact /></figure><div><div class="editorial-card__top"><span>{related.data.category}</span><b>0{index + 1}</b></div><h3>{related.data.title}</h3><p>{related.data.dek}</p><small>{related.data.readingTime}</small><i class="editorial-card__read">Baca artikel &rarr;</i></div></a>)}</div></div></section>}

  <section class="section blog-close-stage" aria-labelledby="article-final-cta"><div class="container blog-close reveal"><div><h2 id="article-final-cta">Bawa satu pertanyaan usaha.</h2><p>Lihat cara RAMUNI membaca konteksnya dengan data contoh.</p></div><a class="button button--primary" href="/tour-produk-gratis">Coba Simulasi Gratis</a></div></section>

  <script>
    const readingProgress = document.querySelector<HTMLElement>('[data-reading-progress]');
    const updateReadingProgress = () => {
      if (!readingProgress) return;
      const article = document.querySelector('article');
      if (!article) return;
      const start = article.offsetTop;
      const distance = Math.max(article.offsetHeight - window.innerHeight, 1);
      const value = Math.min(100, Math.max(0, ((window.scrollY - start) / distance) * 100));
      readingProgress.style.setProperty('--reading-progress', `${value}%`);
      readingProgress.setAttribute('aria-valuenow', String(Math.round(value)));
    };
    updateReadingProgress();
    window.addEventListener('scroll', updateReadingProgress, { passive: true });
    window.addEventListener('resize', updateReadingProgress, { passive: true });

    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    const tocTargets = tocLinks
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((node): node is HTMLElement => node instanceof HTMLElement);
    const setActiveToc = (id: string) => {
      tocLinks.forEach((link) => {
        const active = decodeURIComponent(link.hash.slice(1)) === id;
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };
    if (tocTargets.length) {
      setActiveToc(tocTargets[0].id);
      if ('IntersectionObserver' in window) {
        const tocObserver = new IntersectionObserver((entries) => {
          const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (visible?.target instanceof HTMLElement) setActiveToc(visible.target.id);
        }, { rootMargin: '-18% 0px -68% 0px', threshold: 0 });
        tocTargets.forEach((target) => tocObserver.observe(target));
      }
    }
  </script>

</BaseLayout>

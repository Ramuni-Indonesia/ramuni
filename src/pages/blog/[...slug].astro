---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import BlogDecisionCTA from '../../components/blog/BlogDecisionCTA.astro';
import ArticleContextVisual from '../../components/blog/ArticleContextVisual.astro';
import { getEditorialPerson } from '../../data/editorialPeople';
import { getArticleCalculator } from '../../data/articleCalculators';
import calculatorWidgetStyles from '../../styles/calculator-widget.css?inline';
import '../../styles/blog.css';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const formatDate = (value: Date) => new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(value);
const updatedAt = post.data.updatedAt || post.data.publishedAt;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const relatedPosts = post.data.related.flatMap((id) => {
  const related = posts.find((entry) => entry.id === id);
  return related ? [related] : [];
}).slice(0, 4);
const author = getEditorialPerson(post.data.authorSlug);
const embeddedCalculator = getArticleCalculator(post.id);
const CalculatorWidget = embeddedCalculator ? (await import('../../components/CalculatorWidget.astro')).default : undefined;
const articleResources = {
  'ai-business-companion-umkm': {
    title: 'Uji jawaban AI sebelum dipakai.',
    text: 'Gunakan panduan pemeriksaan untuk melihat pertanyaan, bukti, periode, batas, dan persetujuan manusia.',
    primary: { label: 'Buka panduan menilai insight AI', href: '/panduan/menilai-insight-ai/' },
    secondary: { label: 'Kenali Asisten AI RAMUNI', href: '/produk/asisten-ai/' },
  },
  'arus-kas-umkm-ringan': {
    title: 'Buka catatan.',
    text: 'Hitung selisih kas di artikel, lalu gunakan template agar tanggal uang masuk dan keluar tetap dapat diperiksa.',
    primary: { label: 'Template arus kas', href: '/template/arus-kas-sederhana/' },
    secondary: { label: 'Pelajari modul keuangan', href: '/produk/keuangan/' },
  },
  'panduan-membaca-stok-harian': {
    title: 'Bawa urutan cek ke pekerjaan harian.',
    text: 'Perkirakan titik pemeriksaan di artikel, lalu simpan saldo, koreksi, dan waktu pembaruan dalam format yang konsisten.',
    primary: { label: 'Gunakan kalkulator reorder stok', href: '/kalkulator/reorder-stok/' },
    secondary: { label: 'Pelajari modul inventori', href: '/produk/inventori/' },
  },
} as const;
const articleResource = articleResources[post.id as keyof typeof articleResources];
const hasVerifiedReviewer = Boolean(
  post.data.reviewStatus === 'reviewed'
  && post.data.reviewerName
  && post.data.reviewerSlug
  && post.data.reviewerSlug !== post.data.authorSlug,
);

const cta = {
  'early-access': { title: 'Coba cara membaca masalah usaha ini.', text: 'Gunakan data contoh tanpa membuat akun.', label: 'Coba langkahnya', href: '/tour-produk-gratis/' },
  demo: { title: 'Lihat cara RAMUNI membaca angka usaha.', text: 'Simulasi memakai data contoh, bukan data bisnis Anda.', label: 'Coba simulasi', href: '/tour-produk-gratis/' },
  product: { title: 'Pilih area kerja yang ingin Anda pelajari.', text: 'Lihat modul yang membantu membaca data usaha dengan lebih jelas.', label: 'Pelajari Produk', href: '/produk/' },
}[post.data.ctaType];

const articleUrl = new URL(`/blog/${post.id}/`, Astro.site || Astro.url.origin).toString();
const siteOrigin = new URL('/', Astro.site || Astro.url.origin).origin;
const organizationId = `${siteOrigin}/#organization`;
const authorUrl = new URL(`/blog/penulis/${author.slug}/`, Astro.site || Astro.url.origin).toString();
const articleImage = new URL(post.data.cover, Astro.site || Astro.url.origin).toString();
const articleIndexable = post.data.reviewStatus === 'reviewed' && !post.data.noindex;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${articleUrl}#article`,
    url: articleUrl,
    headline: post.data.title,
    description: post.data.description,
    image: articleImage,
    inLanguage: 'id-ID',
    articleSection: post.data.category,
    keywords: post.data.tags,
    datePublished: post.data.publishedAt.toISOString(),
    dateModified: updatedAt.toISOString(),
    author: { '@type': author.profileType === 'person' ? 'Person' : 'Organization', '@id': `${authorUrl}#author`, name: author.name, url: authorUrl },
    publisher: { '@type': 'Organization', '@id': organizationId, name: 'RAMUNI', logo: { '@type': 'ImageObject', url: new URL('/brand/ramuni-mark-color.webp', Astro.site || Astro.url.origin).toString() } },
    mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: new URL('/', Astro.site || Astro.url.origin).toString() },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site || Astro.url.origin).toString() },
      { '@type': 'ListItem', position: 3, name: post.data.category, item: new URL(`/blog/kategori/${post.data.categorySlug}/`, Astro.site || Astro.url.origin).toString() },
      { '@type': 'ListItem', position: 4, name: post.data.title, item: articleUrl },
    ],
  },
];
---
<BaseLayout title={post.data.title} description={post.data.description} image={post.data.cover} imageAlt={post.data.coverAlt} imageWidth={1200} imageHeight={720} noindex={!articleIndexable} schema={schema} ogType="article" keywords={post.data.tags}>
  {embeddedCalculator && <style is:inline set:html={calculatorWidgetStyles} />}
  <div class="article-reading-progress" role="progressbar" aria-label="Progres membaca artikel" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-reading-progress><i></i></div>
  <article>
    <header class="article-hero">
      <div class="container article-head">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Beranda</a><span>/</span><a href="/blog/">Blog</a><span>/</span><a href={`/blog/kategori/${post.data.categorySlug}/`}>{post.data.category}</a><span>/</span><span aria-current="page">Artikel</span></nav>
        <a class="article-category" href={`/blog/kategori/${post.data.categorySlug}/`}>{post.data.category}</a>
        <h1>{post.data.title}</h1>
        <p class="article-dek">{post.data.dek}</p>
        <div class="article-trust-row" aria-label="Akuntabilitas artikel">
          <div><span>Ditulis oleh</span><a href={`/blog/penulis/${post.data.authorSlug}/`}>{post.data.authorName}</a></div>
          {hasVerifiedReviewer && <div><span>Ditinjau oleh</span><a href={`/blog/penulis/${post.data.reviewerSlug}/`}>{post.data.reviewerName}</a></div>}
          <div><span>Koreksi</span><a href="/blog/koreksi/">Sampaikan perbaikan</a></div>
        </div>
        <div class="article-date-row"><span>Diterbitkan {formatDate(post.data.publishedAt)}</span><span>Diperbarui {formatDate(updatedAt)}</span><span>Waktu baca {post.data.readingTime}</span></div>
        <div class="article-tags" aria-label="Topik artikel">{post.data.tags.map((tag) => <span>{tag}</span>)}</div>
        <figure class="article-cover"><div><img src={post.data.cover} width="1200" height="720" alt={post.data.coverAlt} fetchpriority="high" /></div><figcaption>Visual ringkas memakai data contoh untuk membantu membaca isi artikel.</figcaption></figure>
      </div>
    </header>

    <section class="article-reading-stage">
      <div class="container article-reading-grid">
        <div class="article-main">
          <section class="article-short-answer" aria-labelledby="short-answer"><span>Ringkasan / 30 detik</span><h2 id="short-answer">Yang perlu diingat</h2><ol>{post.data.takeaways.map((item, index) => <li><b>0{index + 1}</b><p>{item}</p></li>)}</ol></section>

          {toc.length > 0 && <details class="article-toc-mobile"><summary>Lihat isi artikel</summary><ol>{toc.map((heading) => <li class={heading.depth === 3 ? 'toc-sub' : ''}><a href={`#${heading.slug}`} data-toc-link>{heading.text}</a></li>)}</ol></details>}

          <ArticleContextVisual articleId={post.id} />

          <div class="article-content"><Content /></div>

          {embeddedCalculator && CalculatorWidget && <CalculatorWidget kind={embeddedCalculator} embedded />}

          {articleResource && <aside class="article-resource-bridge" aria-labelledby="article-resource-title">
            <div><span>Gunakan bersama artikel</span><h2 id="article-resource-title">{articleResource.title}</h2><p>{articleResource.text}</p></div>
            <nav aria-label="Sumber daya kontekstual"><a href={articleResource.primary.href}>{articleResource.primary.label}<i aria-hidden="true">&rarr;</i></a><a href={articleResource.secondary.href}>{articleResource.secondary.label}<i aria-hidden="true">&rarr;</i></a></nav>
          </aside>}

          <aside class="article-inline-cta" aria-label="Langkah berikutnya"><div><h2>{cta.title}</h2><p>{cta.text}</p></div><a class="button button--primary" href={cta.href}>{cta.label}</a></aside>

          <section class="article-method" aria-labelledby="source-heading"><h2 id="source-heading">Sumber dan catatan metode</h2>
            {post.data.sources.length ? <ol class="source-list">{post.data.sources.map((source) => <li><strong>{source.url ? <a href={source.url} rel="noreferrer">{source.title}</a> : source.title}</strong><span>{source.publisher}</span><p>{source.note}</p></li>)}</ol> : <p class="source-empty"><strong>Tidak ada statistik eksternal dalam artikel ini.</strong> Contoh angka dan nama usaha dibuat sintetis untuk menjelaskan cara membaca data. Definisi, asumsi, dan batas penggunaan ditulis langsung pada bagian yang relevan.</p>}
            {post.data.disclaimer && <p class="article-disclaimer">{post.data.disclaimer}</p>}
          </section>

          <section class="article-update" aria-labelledby="update-heading"><h2 id="update-heading">Riwayat pembaruan</h2><div><time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time><p>{post.data.updateSummary}</p></div></section>

          <section class="article-people" aria-labelledby="author-heading"><img src={author.photo} width="96" height="96" alt="" /><div><span class="article-people__role">Penulis</span><h2 id="author-heading">{author.name}</h2><p>{author.shortBio}</p><a class="text-link" href={`/blog/penulis/${author.slug}/`}>Lihat profil editorial</a></div></section>

        </div>

        <aside class="article-rail" aria-label="Navigasi artikel">
          {toc.length > 0 && <nav><strong>Isi artikel</strong><ol>{toc.map((heading) => <li class={heading.depth === 3 ? 'toc-sub' : ''}><a href={`#${heading.slug}`} data-toc-link>{heading.text}</a></li>)}</ol></nav>}
        </aside>
      </div>
    </section>
  </article>

  {relatedPosts.length > 0 && <section class="section article-related-stage" aria-labelledby="related-heading"><div class="container article-related-layout"><div class="article-related-head"><p class="section-kicker">Bacaan terkait</p><h2 id="related-heading">Lihat angka dari sisi lain.</h2><p>Pilih satu topik untuk melanjutkan, tanpa mengulang seluruh artikel.</p></div><div class="editorial-cards editorial-cards--compact">{relatedPosts.map((related, index) => <a class="editorial-card" href={`/blog/${related.id}/`}><figure><img src={related.data.cover} width="1200" height="720" alt={related.data.coverAlt} loading="lazy" /></figure><div><div class="editorial-card__top"><span>{related.data.category}</span><b>0{index + 1}</b></div><h3>{related.data.title}</h3><p>{related.data.dek}</p><small>{related.data.readingTime}</small><i class="editorial-card__read">Baca artikel &rarr;</i></div></a>)}</div></div></section>}

  <section class="section blog-close-stage" aria-labelledby="article-next-step-heading">
    <div class="container reveal">
      <BlogDecisionCTA
        id="article-next-step"
        variant="article"
        eyebrow="Langkah setelah membaca"
        title="Bawa satu pertanyaan usaha."
        text="Lihat cara RAMUNI membaca konteksnya dengan data contoh."
      />
    </div>
  </section>

  <script>
    const readingProgress = document.querySelector<HTMLElement>('[data-reading-progress]');
    const updateReadingProgress = () => {
      if (!readingProgress) return;
      const article = document.querySelector('article');
      if (!article) return;
      const start = article.offsetTop;
      const distance = Math.max(article.offsetHeight - window.innerHeight, 1);
      const value = Math.min(100, Math.max(0, ((window.scrollY - start) / distance) * 100));
      readingProgress.style.setProperty('--reading-progress', `${value}%`);
      readingProgress.setAttribute('aria-valuenow', String(Math.round(value)));
    };
    updateReadingProgress();
    window.addEventListener('scroll', updateReadingProgress, { passive: true });
    window.addEventListener('resize', updateReadingProgress, { passive: true });

    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    const tocTargets = tocLinks
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((node): node is HTMLElement => node instanceof HTMLElement);
    const setActiveToc = (id: string) => {
      tocLinks.forEach((link) => {
        const active = decodeURIComponent(link.hash.slice(1)) === id;
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };
    if (tocTargets.length) {
      setActiveToc(tocTargets[0].id);
      if ('IntersectionObserver' in window) {
        const tocObserver = new IntersectionObserver((entries) => {
          const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (visible?.target instanceof HTMLElement) setActiveToc(visible.target.id);
        }, { rootMargin: '-18% 0px -68% 0px', threshold: 0 });
        tocTargets.forEach((target) => tocObserver.observe(target));
      }
    }
  </script>

</BaseLayout>

<style is:global>
  .article-resource-bridge{display:grid;grid-template-columns:1fr minmax(260px,.72fr);gap:clamp(26px,5vw,58px);margin:clamp(48px,7vw,76px) 0;padding:clamp(26px,4vw,42px);background:var(--rice);border-top:4px solid var(--teal)}
  .article-resource-bridge>div>span{color:var(--teal);font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.article-resource-bridge h2{max-width:16ch;margin-top:10px;font-size:clamp(1.65rem,3vw,2.8rem)}.article-resource-bridge>div>p{max-width:48ch;margin-top:14px;color:var(--ink-72)}.article-resource-bridge nav{border-top:1px solid var(--ink)}.article-resource-bridge nav a{display:grid;grid-template-columns:1fr auto;gap:16px;padding:17px 0;border-bottom:1px solid var(--ink-10);color:var(--ink);font-size:.82rem;font-weight:800;text-decoration:none}.article-resource-bridge nav i{color:var(--teal);font-style:normal}.article-rail-tool{display:grid;gap:9px;margin-top:28px;padding:18px;background:var(--rice);border-left:3px solid var(--teal)}.article-rail-tool span{color:var(--teal);font-size:.66rem;font-weight:800;text-transform:uppercase}.article-rail-tool strong{font-size:.9rem;line-height:1.4}.article-rail-tool a{color:var(--ink);font-size:.78rem;font-weight:800;text-decoration:none}
  @media(max-width:960px){.article-resource-bridge{grid-template-columns:1fr}}
</style>

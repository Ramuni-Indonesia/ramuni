---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const formatDate = (value: Date) => new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(value);
const updatedAt = post.data.updatedAt || post.data.publishedAt;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const relatedPosts = post.data.related.flatMap((id) => {
  const related = posts.find((entry) => entry.id === id);
  return related ? [related] : [];
}).slice(0, 4);
const hasVerifiedReviewer = post.data.reviewStatus === 'reviewed' && post.data.reviewerName && post.data.reviewerSlug;

const cta = {
  'early-access': { title: 'Ceritakan satu masalah usaha yang ingin Anda rapikan.', text: 'Bagikan konteks awal tanpa mengirim data sensitif.', label: 'Daftar Early Access', href: '/early-access' },
  demo: { title: 'Lihat contoh alur RAMUNI dengan data sintetis.', text: 'Demo memakai contoh data, bukan data bisnis Anda.', label: 'Lihat Demo', href: '/demo' },
  product: { title: 'Pilih area kerja yang ingin Anda pelajari.', text: 'Lihat modul yang membantu membaca data usaha dengan lebih jelas.', label: 'Pelajari Produk', href: '/produk' },
}[post.data.ctaType];

const articleUrl = new URL(`/blog/${post.id}/`, Astro.site || Astro.url.origin).toString();
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    image: new URL(post.data.cover, Astro.site || Astro.url.origin).toString(),
    datePublished: post.data.publishedAt.toISOString(),
    dateModified: updatedAt.toISOString(),
    author: { '@type': 'Organization', name: post.data.authorName, url: new URL(`/blog/penulis/${post.data.authorSlug}/`, Astro.site || Astro.url.origin).toString() },
    publisher: { '@type': 'Organization', name: 'RAMUNI', logo: { '@type': 'ImageObject', url: new URL('/brand/ramuni-mark-color.webp', Astro.site || Astro.url.origin).toString() } },
    mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: new URL('/', Astro.site || Astro.url.origin).toString() },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site || Astro.url.origin).toString() },
      { '@type': 'ListItem', position: 3, name: post.data.category, item: new URL(`/blog/kategori/${post.data.categorySlug}/`, Astro.site || Astro.url.origin).toString() },
      { '@type': 'ListItem', position: 4, name: post.data.title, item: articleUrl },
    ],
  },
];
---
<BaseLayout title={post.data.title} description={post.data.description} image={post.data.cover} imageAlt={post.data.coverAlt} imageWidth={1080} imageHeight={1350} noindex={post.data.noindex} schema={schema} ogType="article">
  <article>
    <header class="article-hero">
      <div class="container article-head">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Beranda</a><span>/</span><a href="/blog">Blog</a><span>/</span><a href={`/blog/kategori/${post.data.categorySlug}`}>{post.data.category}</a><span>/</span><span aria-current="page">Artikel</span></nav>
        <a class="article-category" href={`/blog/kategori/${post.data.categorySlug}`}>{post.data.category}</a>
        <h1>{post.data.title}</h1>
        <p class="article-dek">{post.data.dek}</p>
        <div class="article-trust-row">
          <div><span>Ditulis oleh</span><a href={`/blog/penulis/${post.data.authorSlug}`}>{post.data.authorName}</a></div>
          {hasVerifiedReviewer && <div><span>Ditinjau oleh</span><a href={`/blog/reviewer/${post.data.reviewerSlug}`}>{post.data.reviewerName}</a></div>}
          {!hasVerifiedReviewer && <div><span>Status editorial</span><strong>{post.data.editorialStatus}</strong></div>}
        </div>
        <div class="article-date-row"><span>Diterbitkan {formatDate(post.data.publishedAt)}</span><span>Diperbarui {formatDate(updatedAt)}</span><span>Waktu baca {post.data.readingTime}</span></div>
        <figure class="article-cover"><img src={post.data.cover} width="1080" height="1350" alt={post.data.coverAlt} /></figure>
      </div>
    </header>

    <section class="article-reading-stage">
      <div class="container article-reading-grid">
        <div class="article-main">
          <section class="article-short-answer" aria-labelledby="short-answer"><h2 id="short-answer">Inti artikel</h2><ul>{post.data.takeaways.map((item) => <li>{item}</li>)}</ul></section>

          {toc.length > 0 && <details class="article-toc-mobile"><summary>Lihat isi artikel</summary><ol>{toc.map((heading) => <li class={heading.depth === 3 ? 'toc-sub' : ''}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></details>}

          <div class="article-content"><Content /></div>

          <aside class="article-inline-cta" aria-label="Langkah berikutnya"><div><h2>{cta.title}</h2><p>{cta.text}</p></div><a class="button button--primary" href={cta.href}>{cta.label}</a></aside>

          <section class="article-method" aria-labelledby="source-heading"><h2 id="source-heading">Sumber dan catatan metode</h2>
            {post.data.sources.length ? <ol class="source-list">{post.data.sources.map((source) => <li><strong>{source.url ? <a href={source.url} rel="noreferrer">{source.title}</a> : source.title}</strong><span>{source.publisher}</span><p>{source.note}</p></li>)}</ol> : <p>Contoh artikel ini belum memakai sumber eksternal dan belum dapat dijadikan rujukan final.</p>}
            {post.data.disclaimer && <p class="article-disclaimer">{post.data.disclaimer}</p>}
          </section>

          <section class="article-update" aria-labelledby="update-heading"><h2 id="update-heading">Riwayat pembaruan</h2><div><time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time><p>{post.data.updateSummary}</p></div></section>

          <section class="article-people" aria-labelledby="author-heading"><img src="/brand/ramuni-mark-color.webp" width="96" height="96" alt="" /><div><h2 id="author-heading">{post.data.authorName}</h2><p>Tim Editorial RAMUNI menyusun panduan praktis untuk membantu UMKM membaca angka usaha sehari-hari.</p><a class="text-link" href={`/blog/penulis/${post.data.authorSlug}`}>Lihat profil editorial</a>
            {!hasVerifiedReviewer && <p class="reviewer-note">Artikel ini belum memiliki peninjau final. Nama peninjau hanya akan ditampilkan setelah proses editorial tercatat.</p>}
          </div></section>

        </div>

        <aside class="article-rail" aria-label="Navigasi artikel">
          {toc.length > 0 && <nav><strong>Isi artikel</strong><ol>{toc.map((heading) => <li class={heading.depth === 3 ? 'toc-sub' : ''}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav>}
          <div class="article-rail-note"><span>Status</span><p>{post.data.editorialStatus}</p></div>
        </aside>
      </div>
    </section>
  </article>

  {relatedPosts.length > 0 && <section class="section article-related-stage" aria-labelledby="related-heading"><div class="container blog-index-layout"><div class="blog-section-lead"><h2 id="related-heading">Baca topik yang berdekatan.</h2><p>Pilih satu artikel untuk melengkapi gambaran.</p></div><div class="editorial-cards editorial-cards--compact">{relatedPosts.map((related) => <a class="editorial-card" href={`/blog/${related.id}`}><figure><img src={related.data.cover} width="1080" height="1350" alt={related.data.coverAlt} loading="lazy" /></figure><div><span>{related.data.category}</span><h3>{related.data.title}</h3><p>{related.data.dek}</p><small>{related.data.readingTime}</small></div></a>)}</div></div></section>}

</BaseLayout>

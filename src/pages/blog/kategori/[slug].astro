---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import '../../../styles/blog.css';

const catalog = {
  'stok-inventori': {
    name: 'Stok & Inventori',
    introduction: 'Stok bukan hanya angka sisa. Pelajari saldo, laju keluar, koreksi, dan waktu pembaruan secara bersamaan agar barang yang perlu dicek terlihat lebih awal.',
    question: 'Barang mana yang perlu diperiksa hari ini?',
    topics: ['Stok minimum', 'Pergerakan barang', 'Stock opname'],
    start: 'Mulai dari saldo terakhir dan tanggal pemeriksaan fisik. Lalu bandingkan dengan penjualan pada periode yang sama.',
    cta: ['Ingin melihat alur pemeriksaan stok?', 'Lihat Inventori', '/produk/inventori'],
  },
  'keuangan-umkm': {
    name: 'Keuangan UMKM',
    introduction: 'Pisahkan omzet, biaya, laba, dan kas sebelum menarik kesimpulan. Setiap contoh memakai periode yang jelas dan tidak menggantikan saran akuntansi atau pajak.',
    question: 'Mengapa kas berubah dan apa yang perlu diperiksa?',
    topics: ['Arus kas', 'Biaya usaha', 'Laba dan margin'],
    start: 'Catat uang yang benar-benar masuk dan keluar. Jangan campur dengan penjualan yang belum dibayar.',
    cta: ['Baca perjalanan uang dalam satu alur.', 'Pelajari Keuangan', '/produk/keuangan'],
  },
  'ai-untuk-umkm': {
    name: 'AI untuk UMKM',
    introduction: 'Pakai AI untuk membantu membaca catatan bisnis, bukan menggantikan keputusan. Pelajari kualitas input, bukti, ketidakpastian, izin akses, dan pemeriksaan manusia.',
    question: 'Kapan hasil AI perlu diperiksa manusia?',
    topics: ['Batas AI', 'Kualitas data', 'Pemeriksaan manusia'],
    start: 'Mulai dari pertanyaan yang sempit, sebutkan periode, lalu buka angka yang dipakai untuk menyusun jawaban.',
    cta: ['Lihat cara AI menjelaskan, bukan bertindak.', 'Pelajari Asisten AI', '/produk/asisten-ai'],
  },
} as const;

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  const slugs = [...new Set(posts.map((post) => post.data.categorySlug))];
  return slugs.map((slug) => ({ params: { slug }, props: { posts: posts.filter((post) => post.data.categorySlug === slug) } }));
}

const { slug } = Astro.params;
const { posts } = Astro.props;
const key = slug as keyof typeof catalog;
const meta = catalog[key] || {
  name: posts[0]?.data.category || 'Kategori Blog',
  introduction: 'Artikel praktis untuk membaca satu masalah bisnis secara bertahap.',
  question: 'Apa yang ingin Anda pahami lebih dulu?',
  topics: [],
  start: 'Pilih artikel yang paling dekat dengan pekerjaan Anda hari ini.',
  cta: ['Lihat cara RAMUNI membaca konteks bisnis.', 'Lihat Demo', '/demo'],
};
const sortedPosts = [...posts].sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featured = sortedPosts[0];
const articleList = sortedPosts.slice(1);
const isThin = sortedPosts.length < 3;
const formatDate = (value: Date) => new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(value);
const categoryUrl = new URL(`/blog/kategori/${slug}/`, Astro.site || Astro.url.origin).toString();
const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: meta.name, description: meta.introduction, url: categoryUrl },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: new URL('/', Astro.site || Astro.url.origin).toString() },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site || Astro.url.origin).toString() },
    { '@type': 'ListItem', position: 3, name: meta.name, item: categoryUrl },
  ] },
];
---
<BaseLayout title={`${meta.name} | Blog RAMUNI`} description={meta.introduction} noindex={isThin} schema={schema}>
  <header class="category-hero"><div class="container category-hero__layout">
    <div><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Beranda</a><span>/</span><a href="/blog">Blog</a><span>/</span><span>{meta.name}</span></nav><p class="eyebrow">Kategori Blog</p><h1>{meta.name}</h1></div>
    <div class="category-hero__copy"><p class="lede">{meta.introduction}</p><p class="category-question">Mulai dari: {meta.question}</p><div class="category-topics">{meta.topics.map((topic) => <span>{topic}</span>)}</div></div>
  </div></header>
  {isThin && <div class="container"><p class="taxonomy-status taxonomy-status--standalone"><strong>Edisi awal.</strong> Kategori ini tetap noindex sampai memiliki tiga artikel yang lolos review.</p></div>}
  {featured && <section class="section surface category-featured"><div class="container category-featured__layout">
    <div class="category-featured__copy"><p class="section-kicker">Mulai dari sini</p><h2><a href={`/blog/${featured.id}`}>{featured.data.title}</a></h2><p>{featured.data.dek}</p><div class="category-featured__meta"><span>{featured.data.authorName}</span><span>{featured.data.readingTime}</span><span>{formatDate(featured.data.updatedAt || featured.data.publishedAt)}</span></div><a class="text-link" href={`/blog/${featured.id}`}>Baca artikel</a></div>
    <figure><img src={featured.data.cover} width="1080" height="1350" alt={featured.data.coverAlt} loading="lazy" /></figure>
  </div></section>}
  <section class="section category-start"><div class="container blog-index-layout"><div class="blog-section-lead"><p class="section-kicker">Jalur pemula</p><h2>Langkah pertama yang masuk akal.</h2></div><div class="category-start__note"><span>01</span><p>{meta.start}</p></div></div></section>
  {articleList.length > 0 && <section class="section surface"><div class="container blog-index-layout"><div class="blog-section-lead"><p class="section-kicker">Artikel terbaru</p><h2>Lanjutkan dari kebutuhan Anda.</h2><p>Urutan mengikuti pembaruan terakhir.</p></div><div class="reading-list">{articleList.map((post) => <a class="reading-row" href={`/blog/${post.id}`}><span>{post.data.category}</span><div><h3>{post.data.title}</h3><p>{post.data.dek}</p><small>{post.data.authorName} · {post.data.readingTime}</small></div><small>{formatDate(post.data.updatedAt || post.data.publishedAt)}</small></a>)}</div></div></section>}
  <section class="section category-close-stage"><div class="container category-close"><div><p class="section-kicker">Langkah berikutnya</p><h2>{meta.cta[0]}</h2><p>Gunakan data sintetis tanpa mengirim catatan usaha.</p></div><div class="category-close__actions"><a class="button button--primary" href={meta.cta[2]}>{meta.cta[1]}</a><a class="button button--secondary" href="/blog">Kembali ke Blog</a></div></div></section>
</BaseLayout>

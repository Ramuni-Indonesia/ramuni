---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import StoryMicroVisual from '../../../components/blog/StoryMicroVisual.astro';
import { getBlogCategory, type BlogCategoryMeta } from '../../../data/blogTaxonomy';
import { getVisibleBlogPosts, isBlogCategoryIndexable } from '../../../lib/blog';
import { releaseGates } from '../../../config/release';
import '../../../styles/blog.css';

export async function getStaticPaths() {
  const collection = await getCollection('blog');
  const routePosts = getVisibleBlogPosts(collection);
  const archivePosts = getVisibleBlogPosts(collection, !releaseGates.siteIndexable);
  const slugs = [...new Set(routePosts.map((post) => post.data.categorySlug))];
  return slugs.map((slug) => ({
    params: { slug },
    props: { posts: archivePosts.filter((post) => post.data.categorySlug === slug) },
  }));
}

const { slug } = Astro.params;
const { posts } = Astro.props;
const meta: BlogCategoryMeta = getBlogCategory(slug || '') || {
  slug: slug || 'kategori',
  name: posts[0]?.data.category || 'Kategori Blog',
  description: 'Artikel praktis untuk membaca satu masalah bisnis secara bertahap.',
  introduction: 'Artikel praktis untuk membaca satu masalah bisnis secara bertahap.',
  question: 'Apa yang ingin Anda pahami lebih dulu?',
  topics: [],
  start: 'Pilih artikel yang paling dekat dengan pekerjaan Anda hari ini.',
  steps: ['Pilih satu masalah', 'Baca konteksnya', 'Periksa langkah berikutnya'],
  cta: { title: 'Lihat cara RAMUNI membaca konteks bisnis.', label: 'Coba Simulasi Gratis', href: '/tour-produk-gratis/' },
};
const sortedPosts = getVisibleBlogPosts(posts);
const featured = sortedPosts[0];
const articleList = sortedPosts.slice(1);
const isThin = !isBlogCategoryIndexable(sortedPosts);
const formatDate = (value: Date) => new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(value);
const categoryUrl = new URL(`/blog/kategori/${slug}/`, Astro.site || Astro.url.origin).toString();
const schema = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: meta.name, description: meta.introduction, url: categoryUrl },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: new URL('/', Astro.site || Astro.url.origin).toString() },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site || Astro.url.origin).toString() },
    { '@type': 'ListItem', position: 3, name: meta.name, item: categoryUrl },
  ] },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: `Artikel ${meta.name}`, numberOfItems: sortedPosts.length, itemListElement: sortedPosts.map((post, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: post.data.title,
    url: new URL(`/blog/${post.id}/`, Astro.site || Astro.url.origin).toString(),
  })) },
];
---
<BaseLayout title={`${meta.name} | Blog RAMUNI`} description={meta.introduction} pageType="CollectionPage" noindex={isThin} schema={schema}>
  <header class="category-hero"><div class="container category-masthead">
    <div class="category-masthead__top"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Beranda</a><span>/</span><a href="/blog/">Blog</a><span>/</span><span>{meta.name}</span></nav><span class="category-masthead__edition">Panduan praktis / 2026</span></div>
    <div class="category-masthead__title"><p class="eyebrow">Kategori Blog</p><h1>{meta.name}</h1></div>
    <div class="category-masthead__brief"><p class="lede">{meta.introduction}</p><blockquote><span>Mulai dari satu pertanyaan</span><strong>{meta.question}</strong></blockquote></div>
    <div class="category-topics" aria-label="Cakupan topik">{meta.topics.map((topic) => <span>{topic}</span>)}</div>
  </div></header>
  {isThin && <div class="container"><p class="taxonomy-status taxonomy-status--standalone"><strong>Koleksi sedang bertambah.</strong> Kami menampilkan bacaan yang sudah tersedia sambil melengkapi artikel pendukung.</p></div>}
  {featured && <section class="section surface category-featured"><div class="container category-featured__layout">
    <div class="category-featured__copy"><p class="section-kicker">Mulai dari sini</p><h2><a href={`/blog/${featured.id}/`}>{featured.data.title}</a></h2><p>{featured.data.dek}</p><div class="category-featured__meta"><span>{featured.data.authorName}</span><span>{featured.data.readingTime}</span><span>{formatDate(featured.data.updatedAt || featured.data.publishedAt)}</span></div><a class="text-link" href={`/blog/${featured.id}/`}>Baca artikel</a></div>
    <figure><img src={featured.data.cover} width="1200" height="720" alt={featured.data.coverAlt} fetchpriority="high" /><StoryMicroVisual categorySlug={featured.data.categorySlug} /></figure>
  </div></section>}
  <section class="section category-start"><div class="container category-route"><div class="category-route__head"><p class="section-kicker">Jalur pemula</p><h2>Mulai dengan urutan yang bisa diperiksa.</h2><p>{meta.start}</p></div><ol class="category-route__track">{meta.steps.map((step, index) => <li><span>0{index + 1}</span><strong>{step}</strong></li>)}</ol></div></section>
  {articleList.length > 0 && <section class="section surface"><div class="container category-reading-layout"><div class="category-reading-head"><p class="section-kicker">Artikel terbaru</p><h2>Lanjutkan dari kebutuhan Anda.</h2><p>Urutan mengikuti pembaruan terakhir.</p></div><div class="reading-list reading-list--visual">{articleList.map((post) => <a class="reading-row" href={`/blog/${post.id}/`}><figure><img src={post.data.cover} width="1200" height="720" alt={post.data.coverAlt} loading="lazy" /></figure><div><span>{post.data.category}</span><h3>{post.data.title}</h3><p>{post.data.dek}</p><small>{post.data.authorName} · {post.data.readingTime}</small></div><small>{formatDate(post.data.updatedAt || post.data.publishedAt)}</small></a>)}</div></div></section>}
  <section class="section category-close-stage"><div class="container category-close"><div><p class="section-kicker">Langkah berikutnya</p><h2>{meta.cta.title}</h2><p>Gunakan data sintetis tanpa mengirim catatan usaha.</p></div><div class="category-close__actions"><a class="button button--primary" href={meta.cta.href}>{meta.cta.label}</a><a class="button button--secondary" href="/blog/">Kembali ke Blog</a></div></div></section>
</BaseLayout>

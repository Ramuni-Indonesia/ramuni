---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import '../styles/product-tour.css';

const siteOrigin = new URL('/', Astro.site || Astro.url.origin).origin;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Minta tour RAMUNI sesuai kebutuhan usaha Anda',
  url: new URL('/tour-produk-gratis/', siteOrigin).toString(),
  description: 'Ceritakan satu masalah bisnis untuk mendapatkan contoh alur RAMUNI yang relevan.',
  inLanguage: 'id-ID',
};
---
<BaseLayout
  title="Minta Tour RAMUNI untuk Usaha Anda"
  description="Ceritakan satu masalah penjualan, stok, keuangan, pelanggan, atau laporan yang ingin Anda pahami bersama RAMUNI."
  schema={schema}
  chrome={false}
>
  <section class="tour-form-page">
    <div class="tour-form-shell">
      <header class="tour-minimal-head">
        <a href="/" aria-label="RAMUNI, kembali ke beranda"><img src="/brand/ramuni-lockup-horizontal-color-tight.webp" width="1187" height="355" alt="RAMUNI" /></a>
        <a href="/">Kembali ke beranda</a>
      </header>

      <div class="tour-form-layout">
        <div class="tour-form-card reveal is-visible" aria-labelledby="tour-form-title">
          <div class="tour-form-card__head">
            <span>Tour dengan data demo</span>
            <h1 id="tour-form-title">Ceritakan satu hal yang ingin Anda pahami dari bisnis.</h1>
            <p>Pilih satu masalah, lihat contoh alur dengan data demo, lalu bahas batas dan status fiturnya lewat WhatsApp. Jangan mengirim data pelanggan atau transaksi.</p>
          </div>
          <LeadForm kind="early-access" submitLabel="Kirim permintaan tour" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { pageLastmods } from '../data/pageLastmods';
import '../styles/product-tour.css';

const siteOrigin = new URL('/', Astro.site || Astro.url.origin).origin;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Coba alur RAMUNI gratis sesuai kebutuhan usaha Anda',
  url: new URL('/tour-produk-gratis/', siteOrigin).toString(),
  description: 'Pilih satu masalah bisnis untuk mendapatkan contoh alur RAMUNI yang relevan tanpa menyiapkan data bisnis.',
  dateModified: pageLastmods.tour,
  inLanguage: 'id-ID',
};
---
<BaseLayout
  title="Coba Alur RAMUNI Gratis untuk Usaha Anda"
  description="Pilih satu masalah penjualan, stok, keuangan, pelanggan, atau laporan untuk melihat contoh alur RAMUNI tanpa menyiapkan data bisnis Anda."
  schema={schema}
  chrome={false}
>
  <section class="tour-form-page">
    <div class="tour-form-shell">
      <header class="tour-minimal-head">
        <a href="/" aria-label="RAMUNI, kembali ke beranda"><img src="/brand/ramuni-lockup-horizontal-color-tight.webp" width="1187" height="355" alt="RAMUNI" /></a>
        <a href="/">Kembali ke beranda</a>
      </header>

      <div class="tour-form-layout">
        <figure class="tour-form-visual">
          <div class="tour-form-visual__image" role="img" aria-label="Pemilik usaha mengikuti demo RAMUNI bersama pemandu" style="--tour-visual-image: url('/website-original/context/ramuni-lead-free-demo.webp')"></div>
          <figcaption>
            <span>Demo yang relevan</span>
            <strong>Lihat alur RAMUNI sebelum memilih langkah.</strong>
            <small>Mulai dari pertanyaan usaha Anda. Tim akan mengarahkan contoh yang paling dekat, tanpa meminta data sensitif.</small>
          </figcaption>
        </figure>
        <div class="tour-form-card reveal is-visible" aria-labelledby="tour-form-title">
          <div class="tour-form-card__head">
            <span>Mulai coba gratis</span>
            <h1 id="tour-form-title">Mulai dari satu masalah usaha. Lihat alur RAMUNI yang relevan.</h1>
            <p>Pilih penjualan, stok, keuangan, pelanggan, atau laporan. Isi kontak singkat, lalu lanjutkan bersama tim RAMUNI lewat WhatsApp. Anda tidak perlu menyiapkan data bisnis untuk memulai.</p>
          </div>
          <LeadForm kind="demo" handoff="whatsapp" submitLabel="Mulai coba gratis" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

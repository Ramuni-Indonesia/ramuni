---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedMuniWork from '../components/AnimatedMuniWork.astro';
import DriveVideo from '../components/DriveVideo.astro';
import HomeScrollMotion from '../components/HomeScrollMotion.astro';
import HomepageProblemProof from '../components/HomepageProblemProof.astro';
import RamuniHeroVisual from '../components/RamuniHeroVisual.astro';
import { industries, launchCta, solutions } from '../data/site';
import { homepageIndustryVisuals } from '../data/homepageVisuals';
import { pageLastmods } from '../data/pageLastmods';
import { driveVideos } from '../data/driveVideos';
import '../styles/home-base.css';
import '../styles/home-refinement.css';

const firstIndustryVisual = homepageIndustryVisuals.find((visual) => visual.slug === industries[0].slug) || homepageIndustryVisuals[0];
const prioritySolutions = solutions.slice(0, 4);
const priorityIndustries = industries.slice(0, 4);
const homepageModulePaths = [
  {
    label: 'Operasional',
    title: 'Catat penjualan, cek stok.',
    text: 'Mulai dari transaksi dan saldo barang yang paling sering berubah di hari kerja.',
    href: '/produk/penjualan/',
    action: 'Buka alur operasional',
  },
  {
    label: 'Kesehatan uang',
    title: 'Pisahkan omzet, biaya, dan kas.',
    text: 'Gunakan periode yang sama agar ramainya penjualan tidak disalahartikan sebagai kas longgar.',
    href: '/produk/keuangan/',
    action: 'Baca alur keuangan',
  },
  {
    label: 'Tim & laporan',
    title: 'Tutup minggu dengan sumber yang sama.',
    text: 'Ringkas perubahan dan buka angka pendukungnya sebelum rapat dimulai.',
    href: '/produk/laporan-insight/',
    action: 'Lihat cara laporan bekerja',
  },
] as const;

const faq = [
  ['Apakah RAMUNI adalah ERP?', 'RAMUNI menyatukan penjualan, stok, kas, pelanggan, dan laporan untuk membantu UMKM membaca perubahan usaha. Anda tetap dapat memakai software lain yang sudah dibutuhkan.'],
  ['Apakah AI menjalankan transaksi otomatis?', 'Tidak. AI membantu membaca data dan menyiapkan rekomendasi. Transaksi, perubahan data, dan keputusan tetap memerlukan persetujuan pengguna.'],
  ['Data apa yang dibutuhkan?', 'Mulai dari data yang sudah tersedia, seperti transaksi, produk, stok, biaya, atau catatan pelanggan. Setiap alur menjelaskan kolom dan periode yang diperlukan.'],
  ['Apakah saya bisa langsung mencoba?', 'Ya. Coba workspace Free langsung di app RAMUNI. Jika ingin membahas alur terlebih dahulu, Anda juga dapat mengajukan konsultasi singkat.'],
];

const answerLayers = [
  { label: 'Kesimpulan', title: 'Omzet berubah dibanding pekan lalu.', text: 'Periode pembanding tetap terlihat.' },
  { label: 'Bukti', title: 'Transaksi sore perlu dibuka lebih dulu.', text: 'Jumlah transaksi dipisahkan dari nilai belanja.' },
  { label: 'Periksa', title: 'Cek stok dan jadwal sebelum bertindak.', text: 'Keputusan tetap berada di tangan Anda.' },
];

const workflowStages = [
  'Catat',
  'Satukan',
  'Baca',
  'Putuskan',
];

const siteOrigin = new URL('/', Astro.site || Astro.url.origin).origin;
const organizationId = `${siteOrigin}/#organization`;
const schema = [
  { '@context': 'https://schema.org', '@type': 'Organization', '@id': organizationId, name: 'RAMUNI', url: siteOrigin, logo: `${siteOrigin}/brand/ramuni-mark-color.webp`, description: 'Aplikasi bisnis untuk membantu UMKM memahami penjualan, stok, keuangan, dan pelanggan.' },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${siteOrigin}/#website`, url: siteOrigin, name: 'RAMUNI', inLanguage: 'id-ID', publisher: { '@id': organizationId } },
  { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${siteOrigin}/#webpage`, url: siteOrigin, name: 'Aplikasi Bisnis UMKM untuk Penjualan, Stok, Keuangan | RAMUNI', dateModified: pageLastmods.homepage, inLanguage: 'id-ID' },
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'RAMUNI', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', description: 'Aplikasi bisnis UMKM untuk membaca perubahan penjualan, stok, keuangan, dan pelanggan dengan bukti yang dapat diperiksa.', offers: undefined },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) },
];
---
<BaseLayout title="Aplikasi Bisnis UMKM untuk Penjualan, Stok, Keuangan | RAMUNI" description="RAMUNI membantu UMKM membaca penjualan, stok, kas, pelanggan, dan laporan dalam satu workspace yang bisa diperiksa. Mulai dari demo gratis." schema={schema}>
  <!-- H01 · Hero: one promise, one primary action, one supporting link. -->
  <section class="home-hero chapter" data-home-motion>
    <div class="container hero-composition">
      <div class="hero-copy reveal is-visible">
        <p class="eyebrow">AI Business Companion untuk UMKM Indonesia</p>
        <h1>Lihat penjualan, stok, dan kas sebelum masalah membesar.</h1>
        <p class="lede">RAMUNI menyatukan penjualan, stok, biaya, dan pelanggan agar Anda tahu apa yang berubah dan perlu diperiksa.</p>
        <div class="button-row hero-cta-row"><a class="button button--primary" href={launchCta.href} data-analytics-event="free_trial_click" data-analytics-location="homepage_hero" data-destination="app">Coba gratis</a><a class="hero-dashboard-link" href="#homepage-proof"><span>Lihat cara kerja</span><b aria-hidden="true">↗</b></a></div>
      </div>
      <div class="reveal is-visible"><RamuniHeroVisual /></div>
    </div>
    <div class="hero-rule" aria-hidden="true"><span></span></div>
  </section>

  <aside class="home-status-strip" aria-label="Batas dan status contoh workspace">
    <div class="container home-status-strip__inner">
      <span><i aria-hidden="true">01</i><strong>Workspace contoh</strong><small>Angka pada tampilan adalah data demo.</small></span>
      <span><i aria-hidden="true">02</i><strong>AI read-only</strong><small>Jawaban menunjukkan konteks dan sumber.</small></span>
      <span><i aria-hidden="true">03</i><strong>Anda tetap memutuskan</strong><small>Tindakan penting memerlukan persetujuan manusia.</small></span>
    </div>
  </aside>

  <!-- H02 · Workflow: input, context, evidence, decision in one compact explorer. -->
  <section id="homepage-workflow" class="section workflow-stage chapter">
    <div class="container">
      <div class="section-intro reveal"><h2>Data masuk, konteks terbaca, langkah jadi jelas.</h2><p>Pilih satu tahap untuk melihat pekerjaan yang dibantu RAMUNI.</p></div>
      <div class="workflow-explorer reveal" data-workflow-explorer>
        <div class="workflow-track" role="group" aria-label="Alur RAMUNI">
          {workflowStages.map((title, i) => <button type="button" class="workflow-node" aria-pressed={i === 0 ? 'true' : 'false'} data-workflow-tab={String(i)}><span>0{i + 1}</span><h3>{title}</h3></button>)}
        </div>
        <div class="workflow-focus" aria-live="polite">
          <div class="workflow-focus__signal" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
          <div><span data-workflow-label>Catatan masuk</span><strong data-workflow-title>Empat sumber dibaca bersama.</strong><p data-workflow-copy>RAMUNI menyatukan konteks tanpa menyembunyikan data yang belum lengkap.</p></div>
          <div class="workflow-focus__route" aria-hidden="true"><span>Catatan</span><i></i><span>Bukti</span><i></i><span>Arah</span></div>
          <AnimatedMuniWork class="workflow-focus__mascot" label="Muni bergerak mengikuti alur dari catatan menuju bukti dan arah keputusan" />
          <b data-workflow-state>01 / 04</b>
        </div>
      </div>
    </div>
  </section>

  <!-- H03 · Symptoms and solutions: a single chooser instead of two catalog sections. -->
  <section class="section problem-chapter chapter">
    <div class="container problem-landscape">
      <header class="problem-landscape__head reveal">
        <h2>Mulai dari masalah yang sedang Anda lihat.</h2>
        <p>Pilih gejala terdekat. RAMUNI menunjukkan data yang perlu dibuka, lalu mengarahkannya ke solusi terkait.</p>
      </header>
      <HomepageProblemProof />
      <div class="home-solution-chooser">
        <div><span class="home-inline-label">Jalur solusi</span><h3>Pilih hasil yang ingin dipahami.</h3></div>
        <div class="solution-paths">
          {prioritySolutions.map((solution, i) => <a href={`/solusi/${solution.slug}/`} class="solution-path reveal" style={`--i:${i}`}><span>0{i + 1}</span><div><h3>{solution.title}</h3><p>{solution.summary}</p></div><b aria-hidden="true">↗</b></a>)}
        </div>
      </div>
    </div>
  </section>

  <!-- H04 · Product proof: one authentic dashboard plus concise answer layers. -->
  <section id="homepage-proof" class="section dashboard-stage dashboard-stage--editorial chapter">
    <div class="container dashboard-gallery">
      <header class="dashboard-gallery__head reveal">
        <div><h2>Pertanyaan datang dulu. Bukti mengikuti.</h2></div>
        <div><p>Dashboard RAMUNI menempatkan perubahan penting di depan, lalu membuka periode dan angka asalnya.</p><a class="text-link" href="/produk/dashboard-bisnis/">Lihat Dashboard Bisnis</a></div>
      </header>
      <figure class="dashboard-product-shot reveal">
        <DriveVideo class="homepage-product-proof-video" {...driveVideos.productProof} />
        <figcaption><AnimatedMuniWork static /><div><span>Contoh tampilan</span><strong>Satu ringkasan untuk penjualan, kas, stok, pelanggan, dan laporan.</strong><small>Angka pada tampilan adalah data contoh.</small></div></figcaption>
      </figure>
      <div class="dashboard-proof-notes" role="list" aria-label="Cara membaca bukti di dashboard">
        {answerLayers.map((item, i) => <article class="dashboard-proof-note reveal" role="listitem" style={`--i:${i}`}><span>0{i + 1} / {item.label}</span><strong>{item.title}</strong><p>{item.text}</p></article>)}
      </div>
    </div>
  </section>

  <!-- H05 · Product chooser: three priority work paths, with the full catalogue one click away. -->
  <section class="section modules-stage chapter">
    <div class="container module-atlas">
      <header class="module-atlas__head reveal"><h2>Buka modul sesuai pekerjaan hari ini.</h2><p>Mulai dari pertanyaan yang paling sering muncul, lalu telusuri alur yang menjawabnya.</p></header>
      <div class="module-map">
        {homepageModulePaths.map((path, i) => <a class:list={['module-cell', 'reveal', { 'module-cell--path-featured': i === 0 }]} href={path.href} style={`--i:${i}`}><span>{String(i + 1).padStart(2, '0')} · {path.label}</span><h3>{path.title}</h3><p>{path.text}</p><small>{path.action} ↗</small></a>)}
      </div>
      <a class="text-link home-section-link" href="/produk/">Lihat semua produk</a>
    </div>
  </section>

  <!-- H06 · Context: keep the interactive industry switcher, shorten the surrounding copy. -->
  <section class="section industry-stage chapter">
    <div class="container industry-room" data-industry-room>
      <header class="industry-room__head reveal"><h2>Data yang penting mengikuti jenis usaha.</h2><p>Pilih konteks terdekat untuk melihat contoh pertanyaan dan alur yang relevan.</p></header>
      <div class="industry-room__stage reveal">
        <div class="industry-room__visual">
          <img data-industry-image src={firstIndustryVisual.image} width="1200" height="800" alt={firstIndustryVisual.alt} loading="lazy" decoding="async" />
          <span class="industry-room__visual-shade" aria-hidden="true"></span>
          <em data-industry-code>{firstIndustryVisual.title}</em>
          <small data-industry-credit>{firstIndustryVisual.credit}</small>
        </div>
        <div class="industry-room__question"><span>Pertanyaan contoh</span><h3 data-industry-question>{industries[0].question}</h3><a data-industry-link href={`/industri/${industries[0].slug}/`}>Lihat contoh untuk <b data-industry-name>{industries[0].title}</b></a></div>
      </div>
      <div class="industry-switcher" role="group" aria-label="Pilih jenis usaha">
        {priorityIndustries.map((industry, i) => {
          const visual = homepageIndustryVisuals.find((item) => item.slug === industry.slug) || homepageIndustryVisuals[0];
          return <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-industry-tab data-name={industry.title} data-scene={industry.slug} data-code={industry.title} data-question={industry.question} data-href={`/industri/${industry.slug}/`} data-image={visual.image} data-image-alt={visual.alt} data-image-credit={visual.credit}>{industry.title}</button>;
        })}
      </div>
      <a class="text-link home-industry-link" href="/industri/">Lihat semua jenis usaha</a>
    </div>
  </section>

  <!-- H07 · Trust and FAQ: one compact boundary section, no second sales pitch. -->
  <section class="section trust-stage chapter">
    <div class="container home-trust-faq">
      <div class="trust-manifesto">
        <div class="trust-manifesto__mark reveal"><img src="/brand/ramuni-mark-white.webp" width="160" height="160" alt="Logo simbol RAMUNI" /><span>Prinsip kerja RAMUNI</span></div>
        <h2 class="reveal">AI membantu membaca. Anda tetap memutuskan.</h2>
        <p class="trust-manifesto__lede reveal">Periode, sumber angka, dan data yang belum lengkap tetap terlihat sebelum tindakan dipilih.</p>
        <div class="trust-principles">{['Akses mengikuti peran yang diberi wewenang', 'Jawaban menunjukkan periode dan sumber', 'Perubahan penting memerlukan jejak manusia'].map((item, i) => <div class="trust-principle reveal"><span>0{i + 1}</span><p>{item}</p></div>)}</div>
        <a class="text-link home-trust-link reveal" href="/keamanan/">Pelajari keamanan</a>
      </div>
      <div class="home-faq">
        <div class="home-faq__head"><h2>Yang sering ditanyakan sebelum mulai.</h2><a class="text-link" href="/faq/">Buka semua FAQ</a></div>
        <div class="faq-list">{faq.map(([question, answer]) => <details class="reveal"><summary>{question}</summary><p>{answer}</p></details>)}</div>
      </div>
    </div>
  </section>

  <!-- H08 · Closing: one clear next action after the argument is complete. -->
  <section class="section closing-stage chapter">
    <div class="container closing-composition reveal">
      <p>Meramu insight. Memberi arah.</p>
      <h2>Mulai dari satu pertanyaan usaha.</h2>
      <p class="closing-composition__lede">Buka workspace RAMUNI, lihat data contoh, dan tentukan alur yang ingin Anda periksa.</p>
      <div class="button-row"><a class="button button--primary" href={launchCta.href} data-analytics-event="free_trial_click" data-analytics-location="homepage_close" data-destination="app">Coba gratis</a><a class="text-link" href="/tour-produk-gratis/?flow=consultation" data-analytics-event="demo_request" data-analytics-location="homepage_close" data-destination="consultation">Lihat demo produk</a></div>
    </div>
  </section>
  <script is:inline type="module" src="/scripts/home-interactions.js"></script>
  <HomeScrollMotion />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedMuniWork from '../components/AnimatedMuniWork.astro';
import MuniMascot3D from '../components/MuniMascot3D.astro';
import RamuniHeroVisual from '../components/RamuniHeroVisual.astro';
import { industries, launchCta, products, solutions } from '../data/site';
import { dashboardVisuals } from '../data/dashboardVisuals';
import '../styles/home-base.css';
import '../styles/home-refinement.css';

const homepagePains = [
  { text: 'Omzet berubah tanpa alasan yang terlihat', href: '/solusi/naikkan-omzet/' },
  { text: 'Stok habis saat permintaan naik', href: '/solusi/kelola-stok/' },
  { text: 'Laba terasa berbeda dari kas', href: '/solusi/pantau-laba-dan-arus-kas/' },
  { text: 'Pelanggan lama tidak kembali', href: '/solusi/pahami-pelanggan/' },
  { text: 'Rekap datang setelah keputusan dibuat', href: '/solusi/laporan-bisnis-otomatis/' },
];
const companionSteps = [
  ['Catatan', 'Sumber usaha dikumpulkan tanpa menutupi data yang belum lengkap.'],
  ['Bukti', 'Periode, perubahan, dan angka pendukung tetap bisa ditelusuri.'],
  ['Arah', 'RAMUNI membantu memilih perhatian berikutnya. Keputusan tetap milik Anda.'],
];
const productDashboard = dashboardVisuals.productOverview;

const faq = [
  ['Apakah RAMUNI adalah ERP?', 'RAMUNI adalah AI Business Companion. Fokus awalnya membantu UMKM membaca kondisi bisnis dan menentukan perhatian berikutnya.'],
  ['Apakah AI menjalankan transaksi otomatis?', 'Tidak pada versi awal. AI hanya membaca dan menjelaskan. Tindakan berisiko tetap membutuhkan persetujuan manusia.'],
  ['Data apa yang dibutuhkan?', 'Mulai dari data operasional yang tersedia. Jalur input dan ketersediaannya akan dijelaskan sebelum proses dimulai.'],
  ['Apakah saya bisa langsung mencoba?', 'Ya. Gunakan simulasi gratis dengan data contoh. Untuk mencoba sesuai kebutuhan usaha, ajukan akses coba.'],
  ['Apakah harga sudah tersedia?', 'Harga belum diumumkan. Kami akan menampilkannya setelah isi setiap paket ditetapkan.'],
  ['Apakah RAMUNI cocok untuk semua industri?', 'Kami cocokkan dulu cara kerja usaha Anda dengan fitur yang sudah siap. Contoh awal tersedia untuk enam jenis usaha.'],
  ['Bagaimana keamanan data dijaga?', 'RAMUNI membatasi akses berdasarkan peran. Detail keamanan akan dipublikasikan setelah pengujian selesai.'],
  ['Apakah demo memakai data asli?', 'Tidak. Demo publik memakai data sintetis dan tidak meminta data bisnis sensitif.'],
];

const answerLayers = [
  { label: 'Kesimpulan', title: 'Omzet contoh turun dibanding pekan lalu.', text: 'Perubahan dibaca pada periode Senin sampai Jumat.' },
  { label: 'Alasan utama', title: 'Transaksi sore berkurang pada dua hari kerja.', text: 'RAMUNI memisahkan jumlah transaksi dari nilai belanja.' },
  { label: 'Bukti', title: 'Bandingkan periode dan transaksi pendukung.', text: 'Waktu pembaruan serta data yang belum lengkap tetap terlihat.' },
  { label: 'Produk terdampak', title: 'Kopi Susu dan Roti Panggang perlu ditelusuri.', text: 'Nama produk dan angkanya hanya contoh.' },
  { label: 'Pemeriksaan berikutnya', title: 'Cek stok dan jadwal sebelum mengubah harga.', text: 'Saran menjadi bahan keputusan, bukan tindakan otomatis.' },
];

const workflowStages = [
  ['Catat', 'Penjualan, stok, biaya, dan pelanggan.'],
  ['Hitung', 'Metrik memakai definisi dan periode yang sama.'],
  ['Baca', 'Perubahan penting naik ke urutan teratas.'],
  ['Telusuri', 'Periode dan bukti tetap bisa dibuka.'],
  ['Putuskan', 'Manusia menentukan tindakan berikutnya.'],
];

const siteOrigin = new URL('/', Astro.site || Astro.url.origin).origin;
const organizationId = `${siteOrigin}/#organization`;
const schema = [
  { '@context': 'https://schema.org', '@type': 'Organization', '@id': organizationId, name: 'RAMUNI', url: siteOrigin, logo: `${siteOrigin}/brand/ramuni-mark-color.webp`, description: 'AI Business Companion untuk UMKM Indonesia.' },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${siteOrigin}/#website`, url: siteOrigin, name: 'RAMUNI', inLanguage: 'id-ID', publisher: { '@id': organizationId } },
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'RAMUNI', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', description: 'AI Business Companion untuk membantu UMKM memahami kondisi bisnis.', offers: undefined },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) },
];
---
<BaseLayout title="RAMUNI | AI Business Companion untuk UMKM Indonesia" description="Pahami kondisi bisnis dan tentukan perhatian berikutnya bersama RAMUNI, AI Business Companion untuk UMKM Indonesia." schema={schema}>
  <section class="home-hero chapter" data-chapter="Pembuka">
    <div class="container hero-composition">
      <div class="hero-copy reveal is-visible">
        <p class="eyebrow">AI Business Companion untuk UMKM Indonesia</p>
        <h1>Pahami bisnis Anda. Tahu langkah berikutnya.</h1>
        <p class="lede">RAMUNI membantu Anda membaca catatan usaha dan melihat hal yang perlu diperiksa.</p>
        <div class="button-row"><a class="button button--primary" href={launchCta.href}>{launchCta.label}</a><a class="text-link text-link--large" href="/tour-produk-gratis/">Lihat cara kerjanya</a></div>
      </div>
      <div class="reveal is-visible"><RamuniHeroVisual /></div>
    </div>
    <div class="hero-rule" aria-hidden="true"><span></span></div>
  </section>

  <section class="section problem-chapter chapter" data-chapter="Masalah">
    <div class="container problem-landscape">
      <header class="problem-landscape__head reveal">
        <p class="section-kicker">Masalahnya bukan kekurangan data.</p>
        <h2>Catatan ada di mana-mana. Masalahnya bersembunyi di antaranya.</h2>
        <p>Penjualan, stok, biaya, dan pelanggan sering dibaca terpisah. RAMUNI membantu melihat hubungan yang perlu diperiksa.</p>
      </header>
      <div class="problem-canvas" aria-label="Lima masalah usaha yang bisa ditelusuri">
        <div class="problem-canvas__core" data-problem-mascot>
          <span>Catatan yang terhubung</span>
          <MuniMascot3D
            class="problem-canvas__mascot-model"
            posterSrc="/website-original/mascot/ramuni-mascot-dashboard-guide-hashmicro.webp"
            label="Interpretasi 3D Muni yang menghubungkan catatan usaha"
          />
          <i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i>
        </div>
        <nav class="problem-constellation">
          {homepagePains.map((pain, i) => <a class="problem-point reveal" href={pain.href} style={`--i:${i}`}><span>0{i + 1}</span><p>{pain.text}</p><b>Telusuri</b></a>)}
        </nav>
        <div class="problem-canvas__axis" aria-hidden="true"><span>Terlihat di catatan</span><span>Perlu ditelusuri</span></div>
      </div>
    </div>
  </section>

  <section class="section answer-stage chapter" data-chapter="Insight">
    <div class="container answer-theatre">
      <header class="answer-theatre__question reveal">
        <p class="section-kicker">Contoh jawaban AI</p>
        <span>Pertanyaan pemilik usaha</span>
        <h2>“Kenapa omzet saya turun minggu ini?”</h2>
        <p>Angka di bawah hanya contoh untuk memperlihatkan cara membaca jawabannya.</p>
      </header>
      <div class="answer-console reveal">
        <div class="answer-console__rail" aria-hidden="true"><span>Jawaban dirangkai</span><i></i><b>05 lapis</b></div>
        <div class="answer-mosaic">
          {answerLayers.map((item, i) => <article class="answer-tile" style={`--i:${i}`}><span>0{i + 1} / {item.label}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}
        </div>
        <footer class="answer-console__foot"><span>Data contoh</span><span>Periode dan bukti tetap terbuka</span><strong>Keputusan tetap di tangan Anda</strong></footer>
      </div>
    </div>
  </section>

  <section class="section workflow-stage chapter" data-chapter="Alur">
    <div class="container">
      <div class="section-intro reveal"><h2>Kumpulkan angka, pahami perubahan, lalu tentukan langkah.</h2><p>Pilih satu tahap untuk melihat apa yang terjadi di dalamnya.</p></div>
      <div class="workflow-explorer reveal" data-workflow-explorer>
        <div class="workflow-track" role="tablist" aria-label="Alur RAMUNI">
          {workflowStages.map(([title, text], i) => <button type="button" class="workflow-node" role="tab" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-workflow-tab={String(i)}><span>0{i + 1}</span><h3>{title}</h3><p>{text}</p></button>)}
        </div>
        <div class="workflow-focus" aria-live="polite">
          <div class="workflow-focus__signal" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
          <div><span data-workflow-label>Catatan masuk</span><strong data-workflow-title>Empat sumber dibaca bersama.</strong><p data-workflow-copy>RAMUNI menyatukan konteks tanpa menyembunyikan data yang belum lengkap.</p></div>
          <b data-workflow-state>01 / 05</b>
        </div>
      </div>
    </div>
  </section>

  <section class="section companion-stage chapter" data-chapter="Arah keputusan" aria-labelledby="companion-title">
    <div class="container companion-stage__layout">
      <div class="companion-stage__copy reveal">
        <p class="section-kicker">Dari data menuju perhatian</p>
        <h2 id="companion-title">Catatan yang tersebar diramu menjadi arah yang lebih jelas.</h2>
        <p>Visual ini menggambarkan cara RAMUNI menyusun sinyal usaha. Bukan aksi otomatis, melainkan bahan yang lebih rapi untuk keputusan manusia.</p>
      </div>
      <figure class="companion-journey reveal">
        <img class="companion-journey__art" src="/website-original/ramuni-catatan-bukti-arah.webp" width="1280" height="720" alt="Ilustrasi catatan usaha yang dirapikan menjadi bukti dan arah keputusan" loading="lazy" decoding="async" />
      </figure>
      <ol class="companion-stage__steps" aria-label="Alur catatan, bukti, dan arah">
        {companionSteps.map(([title, text], index) => <li class="reveal" style={`--i:${index}`}><h3>{title}</h3><p>{text}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section dashboard-stage dashboard-stage--editorial chapter" data-chapter="Dashboard">
    <div class="container dashboard-gallery">
      <header class="dashboard-gallery__head reveal">
        <div><p class="section-kicker">Bukan sekadar grafik</p><h2>Pertanyaan datang dulu.</h2></div>
        <div><strong>Angka menjelaskan setelahnya.</strong><p>RAMUNI merangkum perubahan dalam bahasa sehari-hari, lalu membuka konteks yang perlu Anda periksa.</p><a class="text-link" href="/produk/dashboard-bisnis/">Pelajari Dashboard Bisnis</a></div>
      </header>
      <figure class="dashboard-product-shot reveal">
        <picture>
          <source media="(max-width: 620px)" srcset={productDashboard.mobileSrc} width={productDashboard.mobileWidth} height={productDashboard.mobileHeight} />
          <img src={productDashboard.src} width={productDashboard.width} height={productDashboard.height} alt={productDashboard.alt} loading="lazy" decoding="async" />
        </picture>
        <figcaption>
          <AnimatedMuniWork />
          <div><span>Tampilan produk · data demo</span><strong>Satu ringkasan untuk penjualan, kas, stok, pelanggan, aktivitas, dan wawasan.</strong><small>Angka di layar adalah fixture pengujian, bukan data pelanggan.</small></div>
        </figcaption>
      </figure>
      <div class="signal-spread" role="group" aria-label="Contoh tema insight RAMUNI">
        <figure class="signal-story signal-story--lead reveal" style="--i:0">
          <div class="signal-story__frame signal-visual signal-visual--stock" role="img" aria-label="Ilustrasi laju penjualan dibandingkan dengan sisa stok">
            <div class="signal-visual__head"><span>Stok vs laju jual</span><b>09.15</b></div>
            <div class="stock-gauge" aria-hidden="true"><span></span><i>24 porsi</i></div>
            <div class="stock-bars" aria-hidden="true">
              <span style="--level:44%"></span><span style="--level:58%"></span><span style="--level:69%"></span><span style="--level:84%"></span><span style="--level:72%"></span><span style="--level:93%"></span>
            </div>
            <div class="signal-visual__verdict"><span>Perlu diperiksa</span><strong>Stok berpotensi menipis sebelum jam makan siang.</strong></div>
          </div>
          <figcaption><strong>Stok menipis sebelum terlihat</strong><span>Periksa laju penjualan, bukan sisa stok saja.</span></figcaption>
        </figure>
        <div class="signal-spread__notes">
          <figure class="signal-story reveal" style="--i:1">
            <div class="signal-story__frame signal-visual signal-visual--cash" role="img" aria-label="Ilustrasi yang memisahkan omzet, laba, dan arus kas">
              <div class="signal-visual__head"><span>Konteks kas</span><b>7 hari</b></div>
              <div class="cash-lines" aria-hidden="true"><span><i style="--value:88%"></i></span><span><i style="--value:62%"></i></span><span><i style="--value:39%"></i></span></div>
              <div class="cash-legend"><span>Omzet</span><span>Laba</span><span>Kas</span></div>
              <strong class="signal-visual__short">Tiga angka, tiga arti.</strong>
            </div>
            <figcaption><strong>Ramai belum tentu untung</strong><span>Pisahkan omzet, laba, dan kas.</span></figcaption>
          </figure>
          <figure class="signal-story reveal" style="--i:2">
            <div class="signal-story__frame signal-visual signal-visual--evidence" role="img" aria-label="Ilustrasi struktur jawaban RAMUNI dari kesimpulan hingga bukti">
              <div class="signal-visual__head"><span>Anatomi jawaban</span><b>04 lapis</b></div>
              <ol class="evidence-stack">
                <li><span>01</span><strong>Kesimpulan</strong></li>
                <li><span>02</span><strong>Alasan</strong></li>
                <li><span>03</span><strong>Bukti</strong></li>
                <li><span>04</span><strong>Pemeriksaan</strong></li>
              </ol>
            </div>
            <figcaption><strong>Data masuk. Insight muncul.</strong><span>Setiap kesimpulan tetap punya konteks.</span></figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="section modules-stage chapter" data-chapter="Produk">
    <div class="container module-atlas">
      <header class="module-atlas__head reveal"><p class="section-kicker">Satu usaha, beberapa sudut pandang</p><h2>Pilih bagian usaha yang ingin Anda pahami.</h2><p>Mulai dari pertanyaan yang paling dekat dengan pekerjaan hari ini.</p></header>
      <div class="module-map">
        {products.map((product, i) => <a class="module-cell reveal" href={`/produk/${product.slug}/`} style={`--i:${i}`}><span>{String(i + 1).padStart(2, '0')}</span><h3>{product.title}</h3><p>{product.question}</p><small>Pelajari modul</small></a>)}
      </div>
    </div>
  </section>

  <section class="section solutions-stage chapter" data-chapter="Solusi">
    <div class="container solution-field">
      <div class="solution-field__statement reveal"><p class="section-kicker">Mulai dari masalah</p><h2>Tidak perlu mengubah semuanya sekaligus.</h2><p>Pilih satu masalah yang paling mengganggu, lalu lihat data dan modul yang berkaitan.</p></div>
      <div class="solution-paths">
        {solutions.map((solution, i) => <a href={`/solusi/${solution.slug}/`} class="solution-path reveal" style={`--i:${i}`}><span>0{i + 1}</span><div><h3>{solution.title}</h3><p>{solution.summary}</p></div><b aria-hidden="true">↗</b></a>)}
      </div>
    </div>
  </section>

  <section class="section industry-stage chapter" data-chapter="Industri">
    <div class="container industry-room" data-industry-room>
      <header class="industry-room__head reveal"><p class="section-kicker">Konteks usaha</p><h2>Satu pertanyaan bisa berarti hal berbeda di setiap usaha.</h2></header>
      <div class="industry-room__stage reveal">
        <div class="industry-room__visual" aria-hidden="true"><div class="industry-room__chart" data-industry-scene data-scene="retail"><span></span><span></span><span></span><span></span></div><em data-industry-code>Retail</em><i></i><i></i><i></i><i></i><i></i></div>
        <div class="industry-room__question"><span>Pertanyaan contoh</span><h3 data-industry-question>{industries[0].question}</h3><a data-industry-link href={`/industri/${industries[0].slug}/`}>Lihat konteks <b data-industry-name>{industries[0].title}</b></a></div>
      </div>
      <div class="industry-switcher" role="tablist" aria-label="Pilih jenis usaha">
        {industries.map((industry, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-industry-tab data-name={industry.title} data-scene={industry.slug} data-code={industry.title} data-question={industry.question} data-href={`/industri/${industry.slug}/`}>{industry.title}</button>)}
      </div>
    </div>
  </section>

  <section class="section start-stage chapter" data-chapter="Mulai">
    <div class="container start-journey">
      <header class="start-journey__head reveal"><p class="section-kicker">Cara mulai</p><h2>Mulai kecil. Rapikan yang paling mendesak.</h2><p>Empat langkah yang bisa ditelusuri, tanpa melompati validasi data.</p></header>
      <ol class="start-steps start-steps--horizontal">
        <li class="reveal"><span>01</span><div><h3>Buat ruang kerja</h3><p>Tentukan usaha, peran, dan konteks yang akan dibaca.</p></div></li>
        <li class="reveal"><span>02</span><div><h3>Tambah atau impor data</h3><p>Gunakan jalur input yang benar-benar tersedia dan sudah diperiksa.</p></div></li>
        <li class="reveal"><span>03</span><div><h3>Validasi insight pertama</h3><p>Pastikan periode, pembaruan, dan data pendukungnya terlihat.</p></div></li>
        <li class="reveal"><span>04</span><div><h3>Ajukan pertanyaan</h3><p>Baca jawaban lalu buka bukti sebelum menentukan tindakan.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section report-stage chapter" data-chapter="Laporan">
    <div class="container report-layout">
      <div class="report-lead reveal">
        <p class="section-kicker">Ringkasan untuk menutup hari</p>
        <h2>Ringkasan harian. Laporan mingguan.</h2>
        <p>Lihat perubahan utama, sumber data, dan pemeriksaan berikutnya dalam satu ringkasan.</p>
        <a href="/produk/laporan-insight/" class="text-link">Lihat Laporan & Insight</a>
      </div>
      <div class="report-signals" aria-label="Contoh ringkasan laporan RAMUNI">
        <article class="report-signal report-signal--large reveal" style="--i:0"><span>Ringkasan harian</span><strong>Produk cepat mulai menipis.</strong><p>Bandingkan sisa stok dengan laju penjualan sore.</p></article>
        <article class="report-signal reveal" style="--i:1"><span>Laporan mingguan</span><strong>Biaya operasional berubah.</strong><p>Cek kategori biaya dan periode sebelum menilai margin.</p></article>
        <article class="report-signal report-signal--accent reveal" style="--i:2"><span>Pemeriksaan tim</span><strong>Tentukan siapa yang menindaklanjuti.</strong><p>Catatan keputusan tetap berada di tangan orang yang bertanggung jawab.</p></article>
      </div>
    </div>
  </section>

  <section class="section trust-stage chapter" data-chapter="Keamanan">
    <div class="container trust-manifesto">
      <div class="trust-manifesto__mark reveal"><img src="/brand/ramuni-mark-white.webp" width="160" height="160" alt="" /><span>Prinsip kerja RAMUNI</span></div>
      <h2 class="reveal">Jawaban tidak berhenti pada kesimpulan.</h2>
      <p class="trust-manifesto__lede reveal">Periode, sumber angka, dan batas data tetap terlihat sebelum Anda menentukan langkah.</p>
      <div class="trust-principles">{['Akses mengikuti peran yang diberi wewenang', 'AI hanya membaca pada versi awal', 'Jawaban menunjukkan periode dan bukti pendukung', 'Perubahan penting memerlukan jejak dan persetujuan manusia'].map((item, i) => <div class="trust-principle reveal"><span>0{i + 1}</span><p>{item}</p></div>)}</div>
      <a class="button button--light reveal" href="/keamanan/">Pelajari keamanan</a>
    </div>
  </section>

  <section class="section pricing-stage chapter" data-chapter="Akses">
    <div class="container pricing-composition">
      <div class="pricing-word reveal">Akses<br />Coba</div>
      <div class="pricing-copy reveal"><h2>Mulai dari simulasi, lanjut jika cocok.</h2><p>Coba alur RAMUNI dengan data contoh. Harga dan cakupan akses akan dijelaskan sebelum Anda membuat keputusan.</p><div class="button-row"><a class="button button--primary" href="/tour-produk-gratis/">Coba Simulasi Gratis</a></div></div>
    </div>
  </section>

  <section class="section faq-stage chapter" data-chapter="FAQ">
    <div class="container faq-library">
      <div class="faq-library__head reveal"><p class="section-kicker">Sebelum mencoba</p><h2>Pertanyaan yang perlu dijawab sebelum mulai.</h2><p>Jawaban singkat, tanpa menyembunyikan batas produk yang sedang disiapkan.</p></div>
      <div class="faq-list">{faq.map(([question, answer]) => <details class="reveal"><summary>{question}</summary><p>{answer}</p></details>)}</div>
    </div>
  </section>

  <section class="section closing-stage chapter" data-chapter="Penutup">
    <div class="container closing-composition reveal">
      <p>Meramu insight. Memberi arah.</p>
      <h2>Pilih satu masalah. Mulai dari sana.</h2>
      <a class="button button--primary" href="/tour-produk-gratis/">Coba Simulasi Gratis</a>
    </div>
  </section>
  <script is:inline type="module" src="/scripts/home-interactions.js"></script>
</BaseLayout>

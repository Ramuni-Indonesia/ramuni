---
import BaseLayout from '../layouts/BaseLayout.astro';
import RamuniHeroVisual from '../components/RamuniHeroVisual.astro';
import { industries, launchCta, products, solutions } from '../data/site';
import '../styles/home-refinement.css';

const homepagePains = [
  { text: 'Omzet berubah tanpa alasan yang terlihat', href: '/solusi/naikkan-omzet' },
  { text: 'Stok habis saat permintaan naik', href: '/solusi/kelola-stok' },
  { text: 'Laba terasa berbeda dari kas', href: '/solusi/pantau-laba-dan-arus-kas' },
  { text: 'Pelanggan lama tidak kembali', href: '/solusi/pahami-pelanggan' },
  { text: 'Rekap datang setelah keputusan dibuat', href: '/solusi/laporan-bisnis-otomatis' },
];

const faq = [
  ['Apakah RAMUNI adalah ERP?', 'RAMUNI adalah AI Business Companion. Fokus awalnya membantu UMKM membaca kondisi bisnis dan menentukan perhatian berikutnya.'],
  ['Apakah AI menjalankan transaksi otomatis?', 'Tidak pada versi awal. AI hanya membaca dan menjelaskan. Tindakan berisiko tetap membutuhkan persetujuan manusia.'],
  ['Data apa yang dibutuhkan?', 'Mulai dari data operasional yang tersedia. Jalur input dan ketersediaannya akan dijelaskan sebelum proses dimulai.'],
  ['Apakah saya bisa langsung mencoba?', 'Akses saat ini dibuka bertahap melalui program early access.'],
  ['Apakah harga sudah tersedia?', 'Harga belum diumumkan. Kami akan menampilkannya setelah isi setiap paket ditetapkan.'],
  ['Apakah RAMUNI cocok untuk semua industri?', 'Kami cocokkan dulu cara kerja usaha Anda dengan fitur yang sudah siap. Contoh awal tersedia untuk enam jenis usaha.'],
  ['Bagaimana keamanan data dijaga?', 'RAMUNI membatasi akses berdasarkan peran. Detail keamanan akan dipublikasikan setelah pengujian selesai.'],
  ['Apakah demo memakai data asli?', 'Tidak. Demo publik memakai data sintetis dan tidak meminta data bisnis sensitif.'],
];

const siteOrigin = new URL('/', Astro.site || Astro.url.origin).origin;
const organizationId = `${siteOrigin}/#organization`;
const schema = [
  { '@context': 'https://schema.org', '@type': 'Organization', '@id': organizationId, name: 'RAMUNI', url: siteOrigin, logo: `${siteOrigin}/brand/ramuni-mark-color.webp`, description: 'AI Business Companion untuk UMKM Indonesia.' },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${siteOrigin}/#website`, url: siteOrigin, name: 'RAMUNI', inLanguage: 'id-ID', publisher: { '@id': organizationId } },
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'RAMUNI', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', description: 'AI Business Companion untuk membantu UMKM memahami kondisi bisnis.', offers: undefined },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) },
];
---
<BaseLayout title="RAMUNI | AI Business Companion untuk UMKM Indonesia" description="Pahami kondisi bisnis dan tentukan perhatian berikutnya bersama RAMUNI, AI Business Companion untuk UMKM Indonesia." schema={schema}>
  <section class="home-hero chapter" data-chapter="Pembuka">
    <div class="container hero-composition">
      <div class="hero-copy reveal is-visible">
        <p class="eyebrow">AI Business Companion untuk UMKM Indonesia</p>
        <h1>Pahami bisnis Anda. Tahu langkah berikutnya.</h1>
        <p class="lede">RAMUNI membantu Anda membaca catatan usaha dan melihat hal yang perlu diperiksa.</p>
        <div class="button-row"><a class="button button--primary" href={launchCta.href}>{launchCta.label}</a><a class="text-link text-link--large" href="/demo">Lihat cara kerjanya</a></div>
      </div>
      <div class="reveal is-visible"><RamuniHeroVisual /></div>
    </div>
    <div class="hero-rule" aria-hidden="true"><span></span></div>
  </section>

  <section class="section problem-chapter chapter" data-chapter="Masalah">
    <div class="container problem-editorial">
      <div class="problem-lead reveal"><p class="section-kicker">Masalahnya bukan kekurangan data.</p><h2>Catatan ada. Yang perlu diperiksa belum terlihat.</h2></div>
      <div class="problem-rail">
        {homepagePains.map((pain, i) => <a class="problem-line reveal" href={pain.href} style={`--i:${i}`}><span>0{i + 1}</span><p>{pain.text}</p><b>Telusuri</b></a>)}
      </div>
    </div>
  </section>

  <section class="section answer-stage chapter" data-chapter="Insight">
    <div class="container answer-layout">
      <div class="answer-sticky reveal"><p class="section-kicker">Contoh jawaban AI</p><h2>Kenapa omzet saya turun minggu ini?</h2><p>Angka di bawah hanya contoh untuk memperlihatkan cara membaca jawabannya.</p></div>
      <div class="answer-sequence">
        <article class="answer-step reveal"><span>Kesimpulan</span><h3>Omzet contoh turun dibanding pekan lalu.</h3><p>Perubahan dibaca pada periode Senin sampai Jumat.</p></article>
        <article class="answer-step reveal"><span>Alasan utama</span><h3>Transaksi sore berkurang pada dua hari kerja.</h3><p>RAMUNI memisahkan perubahan jumlah transaksi dari nilai belanja.</p></article>
        <article class="answer-step reveal"><span>Bukti</span><h3>Bandingkan periode dan transaksi pendukung.</h3><p>Waktu pembaruan serta data yang belum lengkap tetap terlihat.</p></article>
        <article class="answer-step reveal"><span>Produk terdampak</span><h3>Kopi Susu dan Roti Panggang perlu ditelusuri.</h3><p>Nama produk dan angkanya hanya contoh.</p></article>
        <article class="answer-step reveal"><span>Pemeriksaan berikutnya</span><h3>Cek stok dan jadwal sebelum mengubah harga.</h3><p>Saran menjadi bahan keputusan, bukan tindakan otomatis.</p></article>
      </div>
    </div>
  </section>

  <section class="section workflow-stage chapter" data-chapter="Alur">
    <div class="container">
      <div class="section-intro reveal"><h2>Dari catatan ke keputusan yang bisa dijelaskan.</h2><p>Pilih satu tahap untuk melihat apa yang terjadi di dalamnya.</p></div>
      <div class="workflow-explorer reveal" data-workflow-explorer>
        <div class="workflow-track" role="tablist" aria-label="Alur RAMUNI">
          {[['Catat', 'Penjualan, stok, biaya, dan pelanggan.'], ['Hitung', 'Metrik memakai definisi dan periode yang sama.'], ['Baca', 'Perubahan penting naik ke urutan teratas.'], ['Telusuri', 'Periode dan bukti tetap bisa dibuka.'], ['Putuskan', 'Manusia menentukan tindakan berikutnya.']].map(([title, text], i) => <button type="button" class="workflow-node" role="tab" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-workflow-tab={String(i)}><span>0{i + 1}</span><h3>{title}</h3><p>{text}</p></button>)}
        </div>
        <div class="workflow-focus" aria-live="polite">
          <div class="workflow-focus__signal" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
          <div><span data-workflow-label>Catatan masuk</span><strong data-workflow-title>Empat sumber dibaca bersama.</strong><p data-workflow-copy>RAMUNI menyatukan konteks tanpa menyembunyikan data yang belum lengkap.</p></div>
          <b data-workflow-state>01 / 05</b>
        </div>
      </div>
    </div>
  </section>

  <section class="section dashboard-stage dashboard-stage--editorial chapter" data-chapter="Dashboard">
    <div class="container dashboard-layout">
      <div class="dashboard-copy reveal">
        <p class="section-kicker">Bukan sekadar grafik</p>
        <h2>Pertanyaan datang dulu. Angka menjelaskan setelahnya.</h2>
        <p>RAMUNI merangkum perubahan dalam bahasa sehari-hari, lalu membuka konteks yang perlu Anda periksa.</p>
        <a class="text-link" href="/produk/dashboard-bisnis">Pelajari Dashboard Bisnis</a>
      </div>
      <div class="signal-spread" role="group" aria-label="Contoh tema insight RAMUNI">
        <figure class="signal-story signal-story--lead reveal" style="--i:0">
          <div class="signal-story__frame signal-visual signal-visual--stock" role="img" aria-label="Ilustrasi laju penjualan dibandingkan dengan sisa stok">
            <div class="signal-visual__head"><span>Stok vs laju jual</span><b>09.15</b></div>
            <div class="stock-gauge" aria-hidden="true"><span></span><i>24 porsi</i></div>
            <div class="stock-bars" aria-hidden="true">
              <span style="--level:44%"></span><span style="--level:58%"></span><span style="--level:69%"></span><span style="--level:84%"></span><span style="--level:72%"></span><span style="--level:93%"></span>
            </div>
            <div class="signal-visual__verdict"><span>Perlu diperiksa</span><strong>Stok berpotensi menipis sebelum jam makan siang.</strong></div>
          </div>
          <figcaption><strong>Stok menipis sebelum terlihat</strong><span>Periksa laju penjualan, bukan sisa stok saja.</span></figcaption>
        </figure>
        <div class="signal-spread__notes">
          <figure class="signal-story reveal" style="--i:1">
            <div class="signal-story__frame signal-visual signal-visual--cash" role="img" aria-label="Ilustrasi yang memisahkan omzet, laba, dan arus kas">
              <div class="signal-visual__head"><span>Konteks kas</span><b>7 hari</b></div>
              <div class="cash-lines" aria-hidden="true"><span><i style="--value:88%"></i></span><span><i style="--value:62%"></i></span><span><i style="--value:39%"></i></span></div>
              <div class="cash-legend"><span>Omzet</span><span>Laba</span><span>Kas</span></div>
              <strong class="signal-visual__short">Tiga angka, tiga arti.</strong>
            </div>
            <figcaption><strong>Ramai belum tentu untung</strong><span>Pisahkan omzet, laba, dan kas.</span></figcaption>
          </figure>
          <figure class="signal-story reveal" style="--i:2">
            <div class="signal-story__frame signal-visual signal-visual--evidence" role="img" aria-label="Ilustrasi struktur jawaban RAMUNI dari kesimpulan hingga bukti">
              <div class="signal-visual__head"><span>Anatomi jawaban</span><b>04 lapis</b></div>
              <ol class="evidence-stack">
                <li><span>01</span><strong>Kesimpulan</strong></li>
                <li><span>02</span><strong>Alasan</strong></li>
                <li><span>03</span><strong>Bukti</strong></li>
                <li><span>04</span><strong>Pemeriksaan</strong></li>
              </ol>
            </div>
            <figcaption><strong>Data masuk. Insight muncul.</strong><span>Setiap kesimpulan tetap punya konteks.</span></figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="section modules-stage chapter" data-chapter="Produk">
    <div class="container">
      <div class="section-intro reveal"><h2>Pilih bagian usaha yang ingin Anda pahami.</h2><p>Mulai dari penjualan, stok, keuangan, pelanggan, atau laporan.</p></div>
      <div class="module-slices">
        {products.map((product, i) => <a class="module-slice reveal" href={`/produk/${product.slug}`} style={`--i:${i}`}><span>{String(i + 1).padStart(2, '0')}</span><div><div><h3>{product.title}</h3><small>Early access</small></div><p>{product.outcome} Contoh pertanyaan: {product.question}</p></div><b>Buka</b></a>)}
      </div>
    </div>
  </section>

  <section class="section solutions-stage chapter" data-chapter="Solusi">
    <div class="container solution-composition">
      <div class="solution-title reveal"><p class="section-kicker">Mulai dari masalah</p><h2>Masalah mana yang paling mengganggu usaha Anda?</h2></div>
      <div class="solution-orbit">
        {solutions.map((solution, i) => <a href={`/solusi/${solution.slug}`} class="solution-link reveal" style={`--i:${i}`}><span>0{i + 1}</span><h3>{solution.title}</h3><p>{solution.summary}</p></a>)}
      </div>
    </div>
  </section>

  <section class="section industry-stage chapter" data-chapter="Industri">
    <div class="container industry-composition">
      <div class="industry-copy reveal"><p class="section-kicker">Konteks usaha</p><h2>Setiap jenis usaha punya titik perhatian yang berbeda.</h2><p>Lihat contoh pertanyaan sesuai cara kerja usaha Anda.</p></div>
      <div class="industry-accordion">{industries.map((industry, i) => <a href={`/industri/${industry.slug}`} class="industry-slice reveal" style={`--i:${i}`}><span>{industry.title}</span><p>{industry.question}</p><b>Pelajari</b></a>)}</div>
    </div>
  </section>

  <section class="section start-stage chapter" data-chapter="Mulai">
    <div class="container start-layout">
      <div class="start-statement reveal"><h2>Mulai kecil. Rapikan yang paling mendesak.</h2></div>
      <ol class="start-steps">
        <li class="reveal"><span>01</span><div><h3>Buat ruang kerja</h3><p>Tentukan usaha, peran, dan konteks yang akan dibaca.</p></div></li>
        <li class="reveal"><span>02</span><div><h3>Tambah atau impor data</h3><p>Gunakan jalur input yang benar-benar tersedia dan sudah diperiksa.</p></div></li>
        <li class="reveal"><span>03</span><div><h3>Validasi insight pertama</h3><p>Pastikan periode, pembaruan, dan data pendukungnya terlihat.</p></div></li>
        <li class="reveal"><span>04</span><div><h3>Ajukan pertanyaan</h3><p>Baca jawaban lalu buka bukti sebelum menentukan tindakan.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section report-stage chapter" data-chapter="Laporan">
    <div class="container report-layout">
      <div class="report-lead reveal">
        <p class="section-kicker">Ringkasan untuk menutup hari</p>
        <h2>Ringkasan harian. Laporan mingguan.</h2>
        <p>Lihat perubahan utama, sumber data, dan pemeriksaan berikutnya dalam satu ringkasan.</p>
        <a href="/produk/laporan-insight" class="text-link">Lihat Laporan & Insight</a>
      </div>
      <div class="report-signals" aria-label="Contoh ringkasan laporan RAMUNI">
        <article class="report-signal report-signal--large reveal" style="--i:0"><span>Ringkasan harian</span><strong>Produk cepat mulai menipis.</strong><p>Bandingkan sisa stok dengan laju penjualan sore.</p></article>
        <article class="report-signal reveal" style="--i:1"><span>Laporan mingguan</span><strong>Biaya operasional berubah.</strong><p>Cek kategori biaya dan periode sebelum menilai margin.</p></article>
        <article class="report-signal report-signal--accent reveal" style="--i:2"><span>Pemeriksaan tim</span><strong>Tentukan siapa yang menindaklanjuti.</strong><p>Catatan keputusan tetap berada di tangan orang yang bertanggung jawab.</p></article>
      </div>
    </div>
  </section>

  <section class="section trust-stage chapter" data-chapter="Keamanan">
    <div class="container trust-composition">
      <div class="trust-mark reveal"><img src="/brand/ramuni-mark-white.webp" width="160" height="160" alt="" /></div>
      <div class="trust-copy reveal"><h2>Jawaban tidak berhenti pada kesimpulan.</h2><p>Periksa periode dan sumber angka sebelum menentukan langkah.</p><a class="button button--light" href="/keamanan">Pelajari keamanan</a></div>
      <div class="trust-list">{['Akses mengikuti peran yang diberi wewenang', 'AI hanya membaca pada versi awal', 'Jawaban menunjukkan periode dan bukti pendukung', 'Perubahan penting memerlukan jejak dan persetujuan manusia'].map((item, i) => <div class="trust-row reveal"><span>0{i + 1}</span><p>{item}</p></div>)}</div>
    </div>
  </section>

  <section class="section pricing-stage chapter" data-chapter="Akses">
    <div class="container pricing-composition">
      <div class="pricing-word reveal">Early<br />Access</div>
      <div class="pricing-copy reveal"><h2>Paket sedang divalidasi.</h2><p>Kami akan menampilkan harga setelah isi paket dan batas penggunaannya disetujui.</p><div class="button-row"><a class="button button--primary" href="/early-access">Daftar Early Access</a><a class="text-link" href="/harga">Status harga</a></div></div>
    </div>
  </section>

  <section class="section faq-stage chapter" data-chapter="FAQ">
    <div class="container faq-composition">
      <div class="faq-heading reveal"><h2>Pertanyaan yang perlu dijawab sebelum mulai.</h2><p>Temukan jawaban singkat sebelum Anda mencoba.</p></div>
      <div class="faq-list">{faq.map(([question, answer]) => <details class="reveal"><summary>{question}</summary><p>{answer}</p></details>)}</div>
    </div>
  </section>

  <section class="section closing-stage chapter" data-chapter="Penutup">
    <div class="container closing-composition reveal">
      <p>Meramu insight. Memberi arah.</p>
      <h2>Pilih satu masalah. Mulai dari sana.</h2>
      <a class="button button--primary" href="/early-access">Daftar Early Access</a>
    </div>
  </section>
  <script>
    const workflowCopy = [
      ['Catatan masuk', 'Empat sumber dibaca bersama.', 'RAMUNI menyatukan konteks tanpa menyembunyikan data yang belum lengkap.'],
      ['Metrik dihitung', 'Periode yang sama mencegah salah banding.', 'Definisi omzet, stok, biaya, dan kas tetap konsisten saat dibaca.'],
      ['Sinyal disusun', 'Perubahan penting muncul lebih dulu.', 'Urutan membantu Anda memilih apa yang perlu diperiksa, bukan langsung bertindak.'],
      ['Bukti dibuka', 'Kesimpulan tetap punya jejak.', 'Periode, sumber, dan data pendukung tersedia untuk ditelusuri.'],
      ['Keputusan manusia', 'Anda menentukan langkah akhirnya.', 'RAMUNI memberi bahan pertimbangan. Tindakan tetap membutuhkan keputusan manusia.'],
    ];

    document.querySelectorAll<HTMLElement>('[data-workflow-explorer]').forEach((explorer) => {
      const tabs = Array.from(explorer.querySelectorAll<HTMLButtonElement>('[data-workflow-tab]'));
      const focus = explorer.querySelector<HTMLElement>('.workflow-focus');
      const label = explorer.querySelector<HTMLElement>('[data-workflow-label]');
      const title = explorer.querySelector<HTMLElement>('[data-workflow-title]');
      const copy = explorer.querySelector<HTMLElement>('[data-workflow-copy]');
      const state = explorer.querySelector<HTMLElement>('[data-workflow-state]');
      const activate = (tab: HTMLButtonElement) => {
        const index = Number(tab.dataset.workflowTab || 0);
        tabs.forEach((item) => {
          const active = item === tab;
          item.setAttribute('aria-selected', String(active));
          item.tabIndex = active ? 0 : -1;
        });
        if (!focus || !label || !title || !copy || !state) return;
        focus.dataset.changing = 'false';
        void focus.offsetWidth;
        [label.textContent, title.textContent, copy.textContent] = workflowCopy[index];
        state.textContent = `${String(index + 1).padStart(2, '0')} / 05`;
        focus.dataset.changing = 'true';
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => activate(tab));
        tab.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          event.preventDefault();
          const next = event.key === 'ArrowRight' ? (index + 1) % tabs.length : (index - 1 + tabs.length) % tabs.length;
          tabs[next].focus();
          activate(tabs[next]);
        });
      });
    });
  </script>
</BaseLayout>

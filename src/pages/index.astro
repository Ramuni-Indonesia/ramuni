---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomepageIndustryStories from '../components/HomepageIndustryStories.astro';
import HomepageProductProof from '../components/HomepageProductProof.astro';
import { launchCta, products, solutions } from '../data/site';
import { homepageScreenshotVisuals } from '../data/homepageVisuals';
import { pageLastmods } from '../data/pageLastmods';
import '../styles/home-v2.css';

const faq = [
  ['Apa yang bisa saya lihat di RAMUNI?', 'RAMUNI menyatukan penjualan, stok, kas, pelanggan, dan laporan agar perubahan usaha dapat dibuka dari sumbernya.'],
  ['Apakah screenshot di halaman ini data saya?', 'Tidak. Screenshot berasal dari workspace SaaS RAMUNI dengan data demo terkontrol. Data Anda hanya masuk setelah Anda memilih alur dan memberi persetujuan.'],
  ['Apakah AI menjalankan transaksi otomatis?', 'Tidak. AI membantu membaca data dan menyusun rekomendasi. Perubahan transaksi dan keputusan tetap memerlukan persetujuan pengguna.'],
  ['Bagaimana cara mulai?', 'Mulai dari demo gratis atau coba alur yang paling dekat dengan pekerjaan Anda. Tim akan membantu tanpa meminta data bisnis sensitif.'],
];

const siteOrigin = new URL('/', Astro.site || Astro.url.origin).origin;
const organizationId = `${siteOrigin}/#organization`;
const schema = [
  { '@context': 'https://schema.org', '@type': 'Organization', '@id': organizationId, name: 'RAMUNI', url: siteOrigin, logo: `${siteOrigin}/brand/ramuni-mark-color.webp`, description: 'Workspace bisnis untuk membantu UMKM memahami penjualan, stok, keuangan, dan pelanggan.' },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${siteOrigin}/#website`, url: siteOrigin, name: 'RAMUNI', inLanguage: 'id-ID', publisher: { '@id': organizationId } },
  { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${siteOrigin}/#webpage`, url: siteOrigin, name: 'Aplikasi Bisnis UMKM untuk Penjualan, Stok, Keuangan | RAMUNI', dateModified: pageLastmods.homepage, inLanguage: 'id-ID' },
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'RAMUNI', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', description: 'Workspace bisnis UMKM untuk membaca perubahan penjualan, stok, keuangan, dan pelanggan dengan bukti yang dapat diperiksa.' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) },
];

const moduleHighlights = products.slice(0, 8);
---

<BaseLayout
  title="Aplikasi Bisnis UMKM untuk Penjualan, Stok, Keuangan | RAMUNI"
  description="RAMUNI membantu UMKM membaca penjualan, stok, kas, pelanggan, dan laporan dari satu workspace yang bisa diperiksa. Mulai dari demo gratis."
  schema={schema}
>
  <section class="home-v2-hero" aria-labelledby="home-v2-hero-title">
    <div class="container home-v2-hero__layout">
      <div class="home-v2-hero__copy reveal is-visible">
        <p class="home-v2-kicker">AI Business Companion untuk UMKM</p>
        <h1 id="home-v2-hero-title">Angka usaha terlihat. Langkah berikutnya lebih jelas.</h1>
        <p class="home-v2-hero__lede">Catat penjualan, stok, kas, dan pelanggan dalam satu alur yang bisa diperiksa.</p>
        <div class="home-v2-actions">
          <a class="button button--primary" href={launchCta.href} data-analytics-event="free_trial_click" data-analytics-location="homepage_hero" data-destination="trial">Coba RAMUNI gratis</a>
          <a class="home-v2-text-link" href="/pricing/" data-analytics-event="pricing_plan_click" data-analytics-location="homepage_hero" data-destination="pricing">Lihat harga <span aria-hidden="true">↗</span></a>
        </div>
        <p class="home-v2-hero__note"><span aria-hidden="true">01</span> Mulai dari satu masalah yang ingin Anda pahami minggu ini.</p>
      </div>
      <div class="home-v2-hero__visual reveal is-visible">
        <div class="home-v2-hero__chrome"><span>RAMUNI / Ringkasan</span><b>Workspace SaaS</b></div>
        <picture>
          <source media="(max-width: 620px)" srcset={homepageScreenshotVisuals[0].mobile} />
          <source media="(max-width: 1024px)" srcset={homepageScreenshotVisuals[0].tablet} />
          <img src={homepageScreenshotVisuals[0].desktop} width={homepageScreenshotVisuals[0].width} height={homepageScreenshotVisuals[0].height} alt={homepageScreenshotVisuals[0].alt} fetchpriority="high" decoding="async" />
        </picture>
        <div class="home-v2-hero__caption"><span>Capture produk aktual</span><strong>Ringkasan, onboarding, dan status data dalam satu layar.</strong></div>
      </div>
    </div>
  </section>

  <section class="home-v2-trust-strip" aria-label="Cara kerja RAMUNI">
    <div class="container home-v2-trust-strip__inner">
      <span>RAMUNI membantu Anda</span>
      <strong>mencatat</strong><i aria-hidden="true">→</i><strong>membaca</strong><i aria-hidden="true">→</i><strong>memeriksa</strong><i aria-hidden="true">→</i><strong>memutuskan</strong>
    </div>
  </section>

  <HomepageProductProof items={homepageScreenshotVisuals} />

  <section class="home-v2-solutions" aria-labelledby="home-v2-solutions-title">
    <div class="container">
      <div class="home-v2-solutions__intro reveal">
        <h2 id="home-v2-solutions-title">Mulai dari pekerjaan yang sedang mengganggu.</h2>
        <p>Anda tidak perlu memindahkan seluruh cara kerja. Pilih satu alur, lalu lihat modul yang membantu.</p>
      </div>
      <div class="home-v2-solutions__list">
        {solutions.map((solution, index) => <a href={`/solusi/${solution.slug}/`} class="home-v2-solution reveal" style={`--solution-index:${index};--i:${index}`}>
          <span>0{index + 1}</span>
          <div><h3>{solution.title}</h3><p>{solution.summary}</p></div>
          <b aria-hidden="true">↗</b>
        </a>)}
      </div>
      <a class="home-v2-outline-link" href="/solusi/">Bandingkan semua solusi <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <HomepageIndustryStories />

  <section class="home-v2-modules" aria-labelledby="home-v2-modules-title">
    <div class="container">
      <header class="home-v2-modules__head reveal">
        <h2 id="home-v2-modules-title">Satu workspace, delapan pekerjaan utama.</h2>
        <p>Masuk melalui pertanyaan yang paling dekat dengan peran Anda. Modul tetap saling terhubung.</p>
      </header>
      <div class="home-v2-module-grid">
        {moduleHighlights.map((product, index) => <a class:list={['home-v2-module', 'reveal', { 'home-v2-module--accent': index === 2, 'home-v2-module--dark': index === 0 }]} style={`--i:${index}`} href={`/produk/${product.slug}/`}>
          <span>0{index + 1}</span>
          <h3>{product.title}</h3>
          <p>{product.question}</p>
          <small>{product.outcome}</small>
        </a>)}
      </div>
      <a class="home-v2-outline-link" href="/produk/">Lihat semua produk <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="home-v2-start" aria-labelledby="home-v2-start-title">
    <div class="container home-v2-start__layout">
      <div class="reveal">
        <h2 id="home-v2-start-title">Mulai dengan data yang sudah Anda punya.</h2>
        <p>Tim RAMUNI menunjukkan input dan hasilnya sebelum Anda memilih paket atau menyiapkan migrasi.</p>
        <a class="button button--primary" href="/tour-produk-gratis/" data-analytics-event="demo_request" data-analytics-location="homepage_start" data-destination="demo">Lihat demo gratis</a>
      </div>
      <ol class="home-v2-start__steps reveal">
        <li><span>01</span><div><strong>Pilih satu masalah</strong><p>Penjualan, stok, kas, pelanggan, atau laporan.</p></div></li>
        <li><span>02</span><div><strong>Lihat alur dan bukti</strong><p>Periode, input, hasil, dan batas akses tetap terlihat.</p></div></li>
        <li><span>03</span><div><strong>Tentukan langkah berikutnya</strong><p>Mulai gratis, lihat harga, atau bahas kebutuhan tim.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="home-v2-faq" aria-labelledby="home-v2-faq-title">
    <div class="container home-v2-faq__layout">
      <div class="reveal"><h2 id="home-v2-faq-title">Pertanyaan sebelum mencoba.</h2><p>Jawaban singkat tentang data, AI, screenshot produk, dan cara mulai.</p></div>
      <div class="home-v2-faq__list reveal">
        {faq.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}
      </div>
    </div>
  </section>
</BaseLayout>

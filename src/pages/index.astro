---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedMuniWork from '../components/AnimatedMuniWork.astro';
import DashboardMotion from '../components/DashboardMotion.astro';
import HomeScrollMotion from '../components/HomeScrollMotion.astro';
import HomepageProblemProof from '../components/HomepageProblemProof.astro';
import RamuniHeroVisual from '../components/RamuniHeroVisual.astro';
import { industries, launchCta, products, solutions } from '../data/site';
import { dashboardVisuals } from '../data/dashboardVisuals';
import { pageLastmods } from '../data/pageLastmods';
import '../styles/home-base.css';
import '../styles/home-refinement.css';

const productDashboard = dashboardVisuals.productOverview;

const faq = [
  ['Apakah RAMUNI adalah ERP?', 'RAMUNI membantu UMKM membaca kondisi bisnis dan memilih langkah berikutnya. Fokusnya ada pada penjualan, stok, kas, pelanggan, serta bukti di balik perubahan angka.'],
  ['Apakah AI menjalankan transaksi otomatis?', 'Tidak. AI menjelaskan konteks. Tindakan tetap diputuskan manusia.'],
  ['Data apa yang dibutuhkan?', 'Mulai dari catatan operasional yang tersedia. Jalur input dijelaskan sebelum proses dimulai.'],
  ['Apakah saya bisa langsung mencoba?', 'Ya. Ajukan sesi coba gratis, lalu tim kami akan membantu menyiapkan akses yang sesuai.'],
  ['Bagaimana mengetahui paket dan harga?', 'Paket dan harga disesuaikan dengan kebutuhan usaha. Tim kami membantu membahas pilihan yang paling relevan.'],
  ['Apakah RAMUNI cocok untuk semua industri?', 'Kami mencocokkan cara kerja usaha dengan fitur RAMUNI yang relevan. Lihat penerapannya untuk enam jenis usaha.'],
  ['Bagaimana keamanan data dijaga?', 'Akses mengikuti peran, perubahan penting tercatat, dan keputusan tetap berada pada pengguna.'],
];

const answerLayers = [
  { label: 'Kesimpulan', title: 'Omzet berubah dibanding pekan lalu.', text: 'Periode pembanding tetap terlihat.' },
  { label: 'Bukti', title: 'Transaksi sore perlu dibuka lebih dulu.', text: 'Jumlah transaksi dipisahkan dari nilai belanja.' },
  { label: 'Periksa', title: 'Cek stok dan jadwal sebelum bertindak.', text: 'Keputusan tetap berada di tangan Anda.' },
];

const workflowStages = [
  'Catat',
  'Satukan',
  'Baca',
  'Putuskan',
];

const siteOrigin = new URL('/', Astro.site || Astro.url.origin).origin;
const organizationId = `${siteOrigin}/#organization`;
const schema = [
  { '@context': 'https://schema.org', '@type': 'Organization', '@id': organizationId, name: 'RAMUNI', url: siteOrigin, logo: `${siteOrigin}/brand/ramuni-mark-color.webp`, description: 'Aplikasi bisnis untuk membantu UMKM memahami penjualan, stok, keuangan, dan pelanggan.' },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${siteOrigin}/#website`, url: siteOrigin, name: 'RAMUNI', inLanguage: 'id-ID', publisher: { '@id': organizationId } },
  { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${siteOrigin}/#webpage`, url: siteOrigin, name: 'Aplikasi Bisnis UMKM: Penjualan, Stok, dan Keuangan | RAMUNI', dateModified: pageLastmods.homepage, inLanguage: 'id-ID' },
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'RAMUNI', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', description: 'Aplikasi bisnis UMKM untuk membaca perubahan penjualan, stok, keuangan, dan pelanggan dengan bukti yang dapat diperiksa.', offers: undefined },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) },
];
---
<BaseLayout title="Aplikasi Bisnis UMKM: Penjualan, Stok, dan Keuangan | RAMUNI" description="RAMUNI membantu UMKM membaca penjualan, stok, kas, dan pelanggan dalam satu alur, lalu membuka bukti sebelum menentukan langkah bisnis berikutnya." schema={schema}>
  <section class="home-hero chapter" data-chapter="Pembuka" data-home-motion>
    <div class="container hero-composition">
      <div class="hero-copy reveal is-visible">
        <p class="eyebrow">AI Business Companion untuk UMKM Indonesia</p>
        <h1>Angka usaha berubah. Cari tahu apa yang menggerakkannya.</h1>
        <p class="lede">RAMUNI menyatukan penjualan, stok, kas, dan pelanggan, lalu membantu Anda membuka penyebabnya sebelum memilih langkah.</p>
        <div class="button-row"><a class="button button--primary" href={launchCta.href}>{launchCta.label}</a><a class="text-link text-link--large" href="#dashboard-product-proof">Lihat dashboard RAMUNI</a></div>
        <p class="hero-cta-note">Pilih satu masalah dan isi kontak singkat. Tim RAMUNI akan menunjukkan contoh alur yang relevan lewat WhatsApp, tanpa meminta data bisnis Anda.</p>
      </div>
      <div class="reveal is-visible"><RamuniHeroVisual /></div>
    </div>
    <div class="hero-rule" aria-hidden="true"><span></span></div>
  </section>

  <section class="section problem-chapter chapter" data-chapter="Masalah">
    <div class="container problem-landscape">
      <header class="problem-landscape__head reveal">
        <p class="section-kicker">Satu angka tidak pernah bercerita sendirian.</p>
        <h2>Saat penjualan berubah, buka penyebabnya, bukan sekadar grafik.</h2>
        <p>Pilih situasi yang paling dekat dengan pekerjaan Anda. Kami tunjukkan catatan mana yang perlu dibaca bersama dan mana yang masih perlu dicek.</p>
      </header>
      <HomepageProblemProof />
    </div>
  </section>

  <section class="section solutions-stage chapter" data-chapter="Solusi">
    <div class="container solution-field">
      <div class="solution-field__statement reveal"><p class="section-kicker">Mulai dari masalah</p><h2>Mulai dari hal yang sedang mengganggu pekerjaan.</h2><p>Anda tidak perlu merapikan semuanya sekaligus. Buka satu masalah, lalu lihat data dan modul yang memang berkaitan.</p></div>
      <div class="solution-paths">
        {solutions.map((solution, i) => <a href={`/solusi/${solution.slug}/`} class="solution-path reveal" style={`--i:${i}`}><span>0{i + 1}</span><div><h3>{solution.title}</h3><p>{solution.summary}</p></div><b aria-hidden="true">↗</b></a>)}
      </div>
    </div>
  </section>

  <section class="section answer-stage chapter" data-chapter="Insight">
    <div class="container answer-theatre">
      <header class="answer-theatre__question reveal">
        <p class="section-kicker">Contoh jawaban AI</p>
        <span>Pertanyaan pemilik usaha</span>
        <h2>“Kenapa omzet saya turun minggu ini?”</h2>
        <p>Angka di bawah hanya contoh untuk memperlihatkan cara membaca jawabannya.</p>
      </header>
      <div class="answer-console reveal">
        <div class="answer-console__rail" aria-hidden="true"><span>Jawaban dirangkai</span><i></i><b>03 bagian</b></div>
        <div class="answer-mosaic">
          {answerLayers.map((item, i) => <article class="answer-tile" style={`--i:${i}`}><span>0{i + 1} / {item.label}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}
        </div>
        <footer class="answer-console__foot"><span>Contoh pembacaan</span><span>Periode dan bukti tetap terbuka</span><strong>Keputusan tetap di tangan Anda</strong></footer>
      </div>
    </div>
  </section>

  <section class="section workflow-stage chapter" data-chapter="Alur">
    <div class="container">
      <div class="section-intro reveal"><h2>Kumpulkan angka, pahami perubahan, lalu tentukan langkah.</h2><p>Pilih satu tahap untuk melihat apa yang terjadi di dalamnya.</p></div>
      <div class="workflow-explorer reveal" data-workflow-explorer>
        <div class="workflow-track" role="group" aria-label="Alur RAMUNI">
          {workflowStages.map((title, i) => <button type="button" class="workflow-node" aria-pressed={i === 0 ? 'true' : 'false'} data-workflow-tab={String(i)}><span>0{i + 1}</span><h3>{title}</h3></button>)}
        </div>
        <div class="workflow-focus" aria-live="polite">
          <div class="workflow-focus__signal" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
          <div><span data-workflow-label>Catatan masuk</span><strong data-workflow-title>Empat sumber dibaca bersama.</strong><p data-workflow-copy>RAMUNI menyatukan konteks tanpa menyembunyikan data yang belum lengkap.</p></div>
          <div class="workflow-focus__route" aria-hidden="true"><span>Catatan</span><i></i><span>Bukti</span><i></i><span>Arah</span></div>
          <AnimatedMuniWork class="workflow-focus__mascot" label="Muni bergerak mengikuti alur dari catatan menuju bukti dan arah keputusan" />
          <b data-workflow-state>01 / 04</b>
        </div>
      </div>
    </div>
  </section>

  <section id="dashboard-product-proof" class="section dashboard-stage dashboard-stage--editorial chapter" data-chapter="Dashboard">
    <div class="container dashboard-gallery">
      <header class="dashboard-gallery__head reveal">
        <div><p class="section-kicker">Mulai dari pertanyaan usaha</p><h2>Pertanyaan datang dulu.</h2></div>
        <div><strong>Angka menjelaskan setelahnya.</strong><p>RAMUNI merangkum perubahan dalam bahasa sehari-hari, lalu membuka konteks yang perlu Anda periksa.</p><a class="text-link" href="/produk/dashboard-bisnis/">Pelajari Dashboard Bisnis</a></div>
      </header>
      <figure class="dashboard-product-shot reveal">
        <DashboardMotion focus="full" label={productDashboard.alt} {...productDashboard} />
        <figcaption>
          <AnimatedMuniWork />
          <div><span>Contoh tampilan</span><strong>Satu ringkasan untuk penjualan, kas, stok, pelanggan, aktivitas, dan wawasan.</strong><small>Angka pada tampilan digunakan untuk menjelaskan alur.</small></div>
        </figcaption>
      </figure>
      <div class="signal-spread" role="group" aria-label="Contoh tema insight RAMUNI">
        <figure class="signal-story signal-story--lead reveal" style="--i:0">
          <div class="signal-story__frame signal-visual signal-visual--stock" role="img" aria-label="Ilustrasi laju penjualan dibandingkan dengan sisa stok">
            <div class="signal-visual__head"><span>Stok vs laju jual</span><b>09.15</b></div>
            <div class="stock-gauge" aria-hidden="true"><span></span><i>24 porsi</i></div>
            <div class="stock-bars" aria-hidden="true">
              <span style="--level:44%"></span><span style="--level:58%"></span><span style="--level:69%"></span><span style="--level:84%"></span><span style="--level:72%"></span><span style="--level:93%"></span>
            </div>
            <div class="signal-visual__verdict"><span>Perlu diperiksa</span><strong>Stok berpotensi menipis sebelum jam makan siang.</strong></div>
          </div>
          <figcaption><strong>Stok menipis sebelum terlihat</strong><span>Periksa laju penjualan, bukan sisa stok saja.</span></figcaption>
        </figure>
        <div class="signal-spread__notes">
          <figure class="signal-story reveal" style="--i:1">
            <div class="signal-story__frame signal-visual signal-visual--cash" role="img" aria-label="Ilustrasi yang memisahkan omzet, laba, dan arus kas">
              <div class="signal-visual__head"><span>Konteks kas</span><b>7 hari</b></div>
              <div class="cash-lines" aria-hidden="true"><span><i style="--value:88%"></i></span><span><i style="--value:62%"></i></span><span><i style="--value:39%"></i></span></div>
              <div class="cash-legend"><span>Omzet</span><span>Laba</span><span>Kas</span></div>
              <strong class="signal-visual__short">Tiga angka, tiga arti.</strong>
            </div>
            <figcaption><strong>Ramai belum tentu untung</strong><span>Pisahkan omzet, laba, dan kas.</span></figcaption>
          </figure>
          <figure class="signal-story reveal" style="--i:2">
            <div class="signal-story__frame signal-visual signal-visual--evidence" role="img" aria-label="Ilustrasi struktur jawaban RAMUNI dari kesimpulan hingga bukti">
              <div class="signal-visual__head"><span>Anatomi jawaban</span><b>04 lapis</b></div>
              <ol class="evidence-stack">
                <li><span>01</span><strong>Kesimpulan</strong></li>
                <li><span>02</span><strong>Alasan</strong></li>
                <li><span>03</span><strong>Bukti</strong></li>
                <li><span>04</span><strong>Pemeriksaan</strong></li>
              </ol>
            </div>
            <figcaption><strong>Jawaban menunjukkan dasar bacanya.</strong><span>Setiap kesimpulan tetap punya konteks.</span></figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="section modules-stage chapter" data-chapter="Produk">
    <div class="container module-atlas">
      <header class="module-atlas__head reveal"><p class="section-kicker">Satu usaha, beberapa sudut pandang</p><h2>Buka angka yang paling sering Anda cari.</h2><p>Mulai dari pertanyaan yang muncul di pekerjaan hari ini, lalu telusuri modul yang bisa menjawabnya.</p></header>
      <div class="module-map">
        {products.map((product, i) => <a class="module-cell reveal" href={`/produk/${product.slug}/`} style={`--i:${i}`}><span>{String(i + 1).padStart(2, '0')}</span><h3>{product.title}</h3><p>{product.question}</p><small>Pelajari modul</small></a>)}
      </div>
    </div>
  </section>

  <section class="section industry-stage chapter" data-chapter="Industri">
    <div class="container industry-room" data-industry-room>
      <header class="industry-room__head reveal"><p class="section-kicker">Konteks usaha</p><h2>Satu pertanyaan bisa berarti hal berbeda di setiap usaha.</h2></header>
      <div class="industry-room__stage reveal">
        <div class="industry-room__visual" aria-hidden="true"><div class="industry-room__chart" data-industry-scene data-scene="retail"><span></span><span></span><span></span><span></span></div><em data-industry-code>Retail</em><i></i><i></i><i></i><i></i><i></i></div>
        <div class="industry-room__question"><span>Pertanyaan contoh</span><h3 data-industry-question>{industries[0].question}</h3><a data-industry-link href={`/industri/${industries[0].slug}/`}>Lihat konteks <b data-industry-name>{industries[0].title}</b></a></div>
      </div>
      <div class="industry-switcher" role="group" aria-label="Pilih jenis usaha">
        {industries.map((industry, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-industry-tab data-name={industry.title} data-scene={industry.slug} data-code={industry.title} data-question={industry.question} data-href={`/industri/${industry.slug}/`}>{industry.title}</button>)}
      </div>
    </div>
  </section>

  <section class="section start-stage chapter" data-chapter="Mulai">
    <div class="container start-journey">
      <header class="start-journey__head reveal"><p class="section-kicker">Cara mulai</p><h2>Mulai kecil. Rapikan yang paling mendesak.</h2><p>Empat langkah yang bisa ditelusuri, tanpa melompati validasi data.</p></header>
      <ol class="start-steps start-steps--horizontal">
        <li class="reveal"><span>01</span><div><h3>Buat ruang kerja</h3><p>Tentukan usaha, peran, dan konteks yang akan dibaca.</p></div></li>
        <li class="reveal"><span>02</span><div><h3>Tambah atau impor data</h3><p>Gunakan jalur input yang benar-benar tersedia dan sudah diperiksa.</p></div></li>
        <li class="reveal"><span>03</span><div><h3>Validasi insight pertama</h3><p>Pastikan periode, pembaruan, dan data pendukungnya terlihat.</p></div></li>
        <li class="reveal"><span>04</span><div><h3>Ajukan pertanyaan</h3><p>Baca jawaban lalu buka bukti sebelum menentukan tindakan.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section report-stage chapter" data-chapter="Laporan">
    <div class="container report-layout">
      <div class="report-lead reveal">
        <p class="section-kicker">Ringkasan untuk menutup hari</p>
        <h2>Ringkasan harian. Laporan mingguan.</h2>
        <p>Lihat perubahan utama, sumber data, dan pemeriksaan berikutnya dalam satu ringkasan.</p>
        <a href="/produk/laporan-insight/" class="text-link">Lihat Laporan & Insight</a>
      </div>
      <div class="report-signals" aria-label="Contoh ringkasan laporan RAMUNI">
        <article class="report-signal report-signal--large reveal" style="--i:0"><span>Ringkasan harian</span><strong>Produk cepat mulai menipis.</strong><p>Bandingkan sisa stok dengan laju penjualan sore.</p></article>
        <article class="report-signal reveal" style="--i:1"><span>Laporan mingguan</span><strong>Biaya operasional berubah.</strong><p>Cek kategori biaya dan periode sebelum menilai margin.</p></article>
        <article class="report-signal report-signal--accent reveal" style="--i:2"><span>Pemeriksaan tim</span><strong>Tentukan siapa yang menindaklanjuti.</strong><p>Catatan keputusan tetap berada di tangan orang yang bertanggung jawab.</p></article>
      </div>
    </div>
  </section>

  <section class="section trust-stage chapter" data-chapter="Keamanan">
    <div class="container trust-manifesto">
      <div class="trust-manifesto__mark reveal"><img src="/brand/ramuni-mark-white.webp" width="160" height="160" alt="Logo simbol RAMUNI" /><span>Prinsip kerja RAMUNI</span></div>
      <h2 class="reveal">Jawaban tidak berhenti pada kesimpulan.</h2>
      <p class="trust-manifesto__lede reveal">Periode, sumber angka, dan konteks data tetap terlihat sebelum Anda menentukan langkah.</p>
      <div class="trust-principles">{['Akses mengikuti peran yang diberi wewenang', 'AI membantu membaca konteks dan bukti', 'Jawaban menunjukkan periode dan sumber pendukung', 'Perubahan penting memerlukan jejak dan persetujuan manusia'].map((item, i) => <div class="trust-principle reveal"><span>0{i + 1}</span><p>{item}</p></div>)}</div>
      <a class="button button--light reveal" href="/keamanan/">Pelajari keamanan</a>
    </div>
  </section>

  <section class="section pricing-stage chapter" data-chapter="Coba gratis">
    <div class="container pricing-composition">
      <div class="pricing-word reveal">Coba<br />Gratis</div>
      <div class="pricing-copy reveal">
        <p class="section-kicker">Yang Anda dapat saat memulai</p>
        <h2>Lihat cara RAMUNI membaca satu masalah usaha Anda.</h2>
        <p>Pilih penjualan, stok, keuangan, pelanggan, atau laporan. Anda akan melihat data yang perlu diperiksa dan modul yang relevan sebelum memutuskan.</p>
        <ol class="pricing-steps">
          <li><span>01</span><strong>Pilih satu masalah yang paling mendesak.</strong></li>
          <li><span>02</span><strong>Lihat contoh data, bukti, dan alur pemeriksaannya.</strong></li>
          <li><span>03</span><strong>Bahas modul dan langkah lanjutan lewat WhatsApp.</strong></li>
        </ol>
        <div class="button-row"><a class="button button--primary" href="/tour-produk-gratis/">Mulai coba gratis</a></div>
        <small>Tanpa perlu menyiapkan data bisnis untuk memulai.</small>
      </div>
    </div>
  </section>

  <section class="section faq-stage chapter" data-chapter="FAQ">
    <div class="container faq-library">
      <div class="faq-library__head reveal"><p class="section-kicker">Sebelum mencoba</p><h2>Pertanyaan yang membantu Anda memulai.</h2><p>Jawaban singkat tentang cara kerja, data, dan langkah yang dapat dilakukan bersama RAMUNI.</p></div>
      <div class="faq-list">{faq.map(([question, answer]) => <details class="reveal"><summary>{question}</summary><p>{answer}</p></details>)}</div>
    </div>
  </section>

  <section class="section closing-stage chapter" data-chapter="Penutup">
    <div class="container closing-composition reveal">
      <p>Meramu insight. Memberi arah.</p>
      <h2>Siap melihat masalah usaha dengan lebih jelas?</h2>
      <div class="button-row"><a class="button button--primary" href="/tour-produk-gratis/">Mulai coba gratis</a><a class="text-link text-link--large" href="/solusi/">Lihat semua solusi</a></div>
    </div>
  </section>
  <script is:inline type="module" src="/scripts/home-interactions.js"></script>
  <HomeScrollMotion />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { releaseGates } from '../../config/release';
import { glossaryTerms } from '../../data/glossaryTerms';
import '../../styles/learning-resource-pages.css';

const terms = glossaryTerms;
const categories = [...new Set(terms.map((term) => term.category))];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTermSet',
    name: 'Kamus Bisnis RAMUNI',
    description: 'Kumpulan istilah bisnis untuk membantu UMKM memahami penjualan, stok, pelanggan, dan keuangan.',
    url: new URL('/kamus-bisnis/', Astro.site || Astro.url.origin).toString(),
    inLanguage: 'id-ID',
    hasDefinedTerm: terms.map((term) => ({ '@type': 'DefinedTerm', name: term.title, alternateName: term.short, url: new URL(`/kamus-bisnis/${term.slug}/`, Astro.site || Astro.url.origin).toString() })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: terms.map((term, index) => ({ '@type': 'ListItem', position: index + 1, name: term.title, url: new URL(`/kamus-bisnis/${term.slug}/`, Astro.site || Astro.url.origin).toString() })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: new URL('/', Astro.site || Astro.url.origin).toString() },
      { '@type': 'ListItem', position: 2, name: 'Kamus Bisnis', item: new URL('/kamus-bisnis/', Astro.site || Astro.url.origin).toString() },
    ],
  },
];
---

<BaseLayout
  title="Kamus Bisnis untuk UMKM"
  description="Cari arti omzet, laba, biaya, margin, arus kas, SKU, lead time, stok, penjualan, dan pelanggan dalam bahasa sederhana untuk UMKM."
  noindex={!releaseGates.resourcePagesIndexable}
  schema={schema}
  keywords={['kamus bisnis UMKM', 'arti omzet', 'arti laba', 'arti HPP', 'biaya tetap dan variabel', 'margin kontribusi', 'arti SKU', 'lead time stok', 'RAMUNI']}
>
  <div class="learning-page learning-page--glossary">
    <header class="learning-hero learning-glossary-hero">
      <div class="container learning-hero__grid">
        <div class="learning-hero__copy reveal is-visible">
          <nav class="breadcrumbs" aria-label="Jejak navigasi"><a href="/">Beranda</a><span>/</span><a href="/sumber-daya/">Sumber Daya</a><span>/</span><span aria-current="page">Kamus Bisnis</span></nav>
          <p class="eyebrow">Kamus bisnis UMKM</p>
          <h1>Pahami istilah sebelum membandingkan angkanya.</h1>
          <p class="lede">Cari arti singkat, lihat contoh, baca rumus bila ada, lalu hubungkan istilah itu dengan catatan usaha yang tepat.</p>
          <a class="button button--primary" href="#cari-istilah">Cari istilah</a>
        </div>

        <div class="glossary-map reveal is-visible" aria-label="Peta hubungan istilah bisnis">
          <header><span>Peta istilah</span><small>Angka saling terhubung</small></header>
          <div class="glossary-map__stage">
            <div class="glossary-map__orbit" aria-hidden="true"><i></i><i></i><i></i></div>
            <a href="/kamus-bisnis/omzet/" class="glossary-map__node glossary-map__node--revenue"><small>Penjualan</small><strong>Omzet</strong></a>
            <a href="/kamus-bisnis/hpp/" class="glossary-map__node glossary-map__node--cost"><small>Biaya barang</small><strong>HPP</strong></a>
            <a href="/kamus-bisnis/arus-kas/" class="glossary-map__node glossary-map__node--cash"><small>Waktu uang</small><strong>Arus kas</strong></a>
            <a href="/kamus-bisnis/stok-pengaman/" class="glossary-map__node glossary-map__node--stock"><small>Cadangan</small><strong>Stok pengaman</strong></a>
            <img src="/website-original/ramuni-mascot-muni-manyar.webp" width="720" height="720" alt="Muni membantu menghubungkan istilah bisnis" decoding="async" />
          </div>
          <footer><span>Definisi</span><strong>→</strong><span>Contoh</span><strong>→</strong><span>Penggunaan</span></footer>
        </div>
      </div>
    </header>

    <section class="section surface glossary-catalog" id="cari-istilah" aria-labelledby="glossary-list-title" data-glossary-search>
      <div class="container">
        <div class="learning-section-head reveal"><div><p class="section-kicker">Cari istilah</p><h2 id="glossary-list-title">Mulai dari kata yang muncul di catatan Anda.</h2></div><p>Definisi dibuat ringkas dan dihubungkan ke keputusan harian. Kamus ini belum menggantikan penjelasan akuntansi atau nasihat profesional.</p></div>
        <div class="glossary-search-panel reveal">
          <label for="glossary-search-input">Ketik istilah atau kegunaannya</label>
          <div class="glossary-search-panel__input"><span aria-hidden="true">⌕</span><input id="glossary-search-input" type="search" placeholder="Contoh: omzet, biaya, stok" autocomplete="off" data-glossary-input /><button type="button" data-glossary-clear hidden>Hapus</button></div>
          <div class="glossary-search-panel__filters" role="group" aria-label="Filter kategori istilah"><button type="button" aria-pressed="true" data-glossary-filter="all">Semua</button>{categories.map((category) => <button type="button" aria-pressed="false" data-glossary-filter={category.toLowerCase()}>{category}</button>)}</div>
          <p aria-live="polite" data-glossary-status>{terms.length} istilah tersedia.</p>
        </div>
        <div class="glossary-ledger">
          {terms.map((term, index) => <a class="glossary-ledger__row reveal" href={`/kamus-bisnis/${term.slug}/`} data-glossary-term data-category={term.category.toLowerCase()} data-search={`${term.title} ${term.short} ${term.category} ${term.definition} ${term.use} ${term.links.join(' ')}`.toLowerCase()} style={`--i:${index}`}>
            <span>{String(index + 1).padStart(2, '0')}</span><div><small>{term.category}</small><h3>{term.title}</h3></div><div><p>{term.definition}</p><strong>{term.use}</strong></div><b>Baca arti <i aria-hidden="true">→</i></b>
          </a>)}
        </div>
        <div class="glossary-empty" data-glossary-empty hidden><strong>Istilah belum ditemukan.</strong><p>Coba kata yang lebih singkat, atau buka seluruh sumber daya untuk mencari konteks yang lebih luas.</p><a class="text-link" href="/sumber-daya/">Buka Sumber Daya</a></div>
      </div>
    </section>

    <section class="section learning-method glossary-connections" aria-labelledby="glossary-bridge-title">
      <div class="container learning-method__grid">
        <div class="learning-method__copy reveal"><p class="section-kicker">Hubungkan istilah</p><h2 id="glossary-bridge-title">Satu angka jarang berdiri sendiri.</h2><p>Omzet perlu dibaca bersama biaya. Stok perlu dibaca bersama laju penjualan. Arus kas perlu dibaca bersama waktu pembayaran.</p></div>
        <div class="glossary-connection-rail">
          <a href="/panduan/memahami-arus-kas/"><span>01</span><div><small>Arus kas + waktu</small><strong>Lihat kenapa uang belum tentu sudah tersedia.</strong></div><i aria-hidden="true">→</i></a>
          <a href="/kalkulator/hpp/"><span>02</span><div><small>HPP + persediaan</small><strong>Periksa biaya barang dalam periode yang sama.</strong></div><i aria-hidden="true">→</i></a>
          <a href="/panduan/membaca-stok-harian/"><span>03</span><div><small>Stok + penjualan</small><strong>Hubungkan saldo dengan laju barang keluar.</strong></div><i aria-hidden="true">→</i></a>
        </div>
      </div>
    </section>

    <section class="section learning-close-stage">
      <div class="container learning-close learning-close--compact reveal">
        <div class="learning-close__mascot" aria-hidden="true"><span></span><img src="/website-original/ramuni-mascot-muni-manyar.webp" width="720" height="720" alt="Maskot Muni Manyar RAMUNI" loading="lazy" decoding="async" /></div>
        <div><p class="section-kicker">Sudah paham istilahnya?</p><h2>Coba istilah itu dengan angka contoh.</h2><p>Buka kalkulator untuk melihat rumusnya atau panduan untuk mengikuti urutan pemeriksaan.</p><div class="button-row"><a class="button button--primary" href="/kalkulator/">Buka kalkulator</a><a class="button button--secondary" href="/panduan/">Baca panduan</a></div></div>
      </div>
    </section>
  </div>

  <script>
    document.querySelectorAll<HTMLElement>('[data-glossary-search]').forEach((root) => {
      const input = root.querySelector<HTMLInputElement>('[data-glossary-input]');
      const clear = root.querySelector<HTMLButtonElement>('[data-glossary-clear]');
      const status = root.querySelector<HTMLElement>('[data-glossary-status]');
      const empty = root.querySelector<HTMLElement>('[data-glossary-empty]');
      const filters = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-glossary-filter]'));
      const terms = Array.from(root.querySelectorAll<HTMLElement>('[data-glossary-term]'));
      if (!input || !status || !empty) return;
      let category = 'all';
      const update = () => {
        const query = input.value.trim().toLocaleLowerCase('id-ID');
        let visible = 0;
        terms.forEach((term) => {
          const matchesQuery = !query || (term.dataset.search || '').includes(query);
          const matchesCategory = category === 'all' || term.dataset.category === category;
          term.hidden = !(matchesQuery && matchesCategory);
          if (!term.hidden) visible += 1;
        });
        clear?.toggleAttribute('hidden', !query);
        empty.hidden = visible !== 0;
        status.textContent = `${visible} istilah ditemukan.`;
      };
      input.addEventListener('input', update);
      clear?.addEventListener('click', () => { input.value = ''; input.focus(); update(); });
      filters.forEach((filter) => filter.addEventListener('click', () => {
        category = filter.dataset.glossaryFilter || 'all';
        filters.forEach((item) => item.setAttribute('aria-pressed', String(item === filter)));
        update();
      }));
    });
  </script>
</BaseLayout>

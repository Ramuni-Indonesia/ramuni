---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CommercialAnalytics from '../../components/CommercialAnalytics.astro';
import ProductScreenshotRail from '../../components/ProductScreenshotRail.astro';
import { featureDetails } from '../../data/commercial';
import { productScreenSets } from '../../data/productScreens';
import { pageLastmods } from '../../data/pageLastmods';
import '../../styles/commercial-pages.css';

const origin = new URL('/', Astro.site || Astro.url.origin).origin;
const canonical = new URL('/features/', origin).toString();
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', '@id': canonical, url: canonical, name: 'Fitur RAMUNI: AI Copilot, Profit Intelligence, dan Knowledge OS', description: 'Kenali fitur RAMUNI untuk membantu UMKM bekerja lebih rapi, memahami keuntungan, dan mengambil keputusan bisnis dengan lebih cepat.', dateModified: pageLastmods.commercial, inLanguage: 'id-ID' },
  { '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': `${canonical}#collection`, url: canonical, name: 'Katalog fitur RAMUNI', description: 'Katalog fitur RAMUNI dengan status ketersediaan yang transparan.', dateModified: pageLastmods.commercial, inLanguage: 'id-ID' },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Beranda', item: origin + '/' }, { '@type': 'ListItem', position: 2, name: 'Fitur', item: canonical }] },
];
---
<BaseLayout title="Fitur RAMUNI: AI Copilot, Profit Intelligence, dan Knowledge OS" description="Kenali fitur RAMUNI untuk membantu UMKM bekerja lebih rapi, memahami keuntungan, dan mengambil keputusan bisnis dengan lebih cepat." canonical="/features/" schema={schema} pageType="WebPage">
  <div class="commercial-page" data-commercial-page="features">
    <section class="commercial-hero"><div class="container commercial-hero__grid"><div><Breadcrumbs items={[{ label: 'Beranda', href: '/' }, { label: 'Fitur' }]} /><p class="section-kicker">Fitur RAMUNI</p><h1>Semua hal penting tentang bisnis, tersusun dalam satu ruang kerja.</h1></div><div class="commercial-hero__aside"><p>RAMUNI membantu Anda mencatat, memahami, dan menjalankan bisnis tanpa berpindah-pindah banyak aplikasi.</p><div class="button-row"><a class="button button--primary" href="/tour-produk-gratis/?flow=trial" data-analytics-event="free_trial_click" data-analytics-location="features_hero" data-destination="tour">Coba gratis</a><a class="button button--secondary" href="/pricing/">Bandingkan paket</a></div><p class="commercial-hero__note">Setiap fitur menjelaskan scope, batas, dan akses paketnya.</p></div></div></section>
    <section class="commercial-section commercial-section--white" aria-labelledby="feature-list-title"><div class="container"><div class="commercial-section__head"><div><p class="section-kicker">Peta fitur</p><h2 id="feature-list-title">Mulai dari kemampuan yang ingin Anda pahami.</h2></div><p>Halaman detail menjelaskan contoh penggunaan, batasan, serta jalur publik yang sudah tersedia saat ini.</p></div><div class="feature-index">{featureDetails.map((feature) => <a class="feature-card" href={`/features/${feature.slug}/`} data-analytics-event="feature_view" data-analytics-location="features_index" data-feature={feature.slug}><span class="feature-card__status">{feature.status}</span><h3>{feature.name}</h3><p>{feature.summary}</p><b>Lihat detail →</b></a>)}</div></div></section>
    <ProductScreenshotRail
      id="features-product-screens"
      eyebrow="Bukti visual produk"
      heading="Mulai dari screen yang sudah tersedia, lalu pahami status fiturnya."
      body="Screen produk di bawah menunjukkan workspace RAMUNI yang sudah tersedia dan area kerja yang dapat langsung dicoba."
      items={productScreenSets.overview}
      compact
    />
    <section class="commercial-section"><div class="container"><div class="commercial-cta"><div><p class="section-kicker">Kendali manusia</p><h2>Fitur membantu membaca. Keputusan tetap berada pada pemilik usaha.</h2><p>Gunakan data dan rekomendasi sebagai bahan kerja; keputusan tetap berada pada pemilik usaha dan timnya.</p></div><div class="commercial-cta__actions"><a class="button button--primary" href="/tour-produk-gratis/?flow=consultation" data-analytics-event="demo_request" data-analytics-location="features_final" data-destination="tour">Lihat demo</a><a class="button button--secondary" href="/roadmap/">Lihat roadmap</a></div></div></div></section>
  </div>
  <CommercialAnalytics />
</BaseLayout>

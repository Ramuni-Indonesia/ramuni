---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CommercialAnalytics from '../../components/CommercialAnalytics.astro';
import { marketingFeatureCards, marketingProductCards, marketingSolutionCards, marketingIndustryLinks, marketingRoleLinks } from '../../data/marketingFeatureCards';
import { appCta, consultationCta } from '../../data/site';
import { capabilityStatusLabel } from '../../data/commercial';
import { pageLastmods } from '../../data/pageLastmods';
import '../../styles/commercial-pages.css';

const origin = new URL('/', Astro.site || Astro.url.origin).origin;
const canonical = new URL('/features/', origin).toString();
const catalogCards = [...marketingFeatureCards, ...marketingProductCards, ...marketingSolutionCards];
const catalogFilters = [
  { label: 'Fitur utama', value: 'feature' },
  { label: 'Produk', value: 'product' },
  { label: 'Solusi', value: 'solution' },
  { label: 'Semua', value: 'all' },
] as const;
const statusSummary = [
  { label: 'Live / terbatas', value: catalogCards.filter((card) => card.status === 'Available' || card.status === 'Limited' || card.family !== 'feature').length },
  { label: 'Segera hadir', value: catalogCards.filter((card) => card.status === 'Coming soon').length },
  { label: 'Jalur kerja', value: catalogCards.length },
];
const jobHighlights = [
  { label: 'Baca kondisi usaha', href: '/features/ai-copilot/', text: 'Tanya data dan dokumen dengan jawaban yang tetap bisa ditelusuri.' },
  { label: 'Pisahkan laba dan kas', href: '/features/profit-intelligence/', text: 'Lihat pendapatan, biaya, margin, dan periode sebelum mengambil keputusan.' },
  { label: 'Rapikan kanal pelanggan', href: '/features/omnichannel/', text: 'Tandai percakapan dan follow-up yang perlu diurus saat kanal dibuka.' },
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', '@id': canonical, url: canonical, name: 'Fitur RAMUNI untuk Operasional, AI & Knowledge OS', description: 'Bandingkan fitur dan produk RAMUNI untuk penjualan, stok, keuangan, pelanggan, laporan, dan pengetahuan bisnis.', dateModified: pageLastmods.commercial, inLanguage: 'id-ID' },
  { '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': `${canonical}#collection`, url: canonical, name: 'Katalog fitur RAMUNI', description: 'Katalog fitur RAMUNI dengan status ketersediaan yang transparan.', dateModified: pageLastmods.commercial, inLanguage: 'id-ID' },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Beranda', item: origin + '/' }, { '@type': 'ListItem', position: 2, name: 'Fitur', item: canonical }] },
];
---
<BaseLayout title="Fitur RAMUNI untuk Operasional, AI & Knowledge OS" description="Bandingkan fitur RAMUNI untuk penjualan, stok, keuangan, pelanggan, laporan, dan pengetahuan bisnis. Lihat input, hasil, dan batas tiap fitur." canonical="/features/" schema={schema} pageType="WebPage">
  <div class="commercial-page" data-commercial-page="features">
    <section class="commercial-hero commercial-hero--utility utility-masthead feature-command-hero">
      <div class="container commercial-hero__grid">
        <div>
          <Breadcrumbs items={[{ label: 'Beranda', href: '/' }, { label: 'Fitur' }]} />
          <p class="section-kicker">Fitur RAMUNI</p>
          <h1>Temukan pekerjaan yang ingin diselesaikan.</h1>
        </div>
        <div class="commercial-hero__aside">
          <p>Halaman ini dibuat sebagai indeks kerja: pilih kebutuhan, lihat statusnya, lalu buka detail yang menjelaskan input, hasil, dan batas penggunaan.</p>
          <div class="button-row"><a class="button button--primary" href="#feature-card-library" data-analytics-event="feature_index_scan" data-analytics-location="features_hero">Lihat indeks</a><a class="text-link" href="/roadmap/">Cek roadmap</a></div>
          <p class="commercial-hero__note">Status fitur mengikuti workspace dan paket. Fitur “segera hadir” tidak ditawarkan sebagai kemampuan live.</p>
        </div>
      </div>
    </section>
    <section id="feature-card-library" class="commercial-section commercial-section--white feature-command" aria-labelledby="feature-library-title">
      <div class="container feature-command__layout">
        <aside class="feature-command__panel">
          <p class="section-kicker">Peta kemampuan</p>
          <h2 id="feature-library-title">Mulai dari pekerjaan, bukan dari nama fitur.</h2>
          <p>Pakai pencarian atau filter singkat untuk menemukan halaman yang paling dekat dengan tugas hari ini.</p>
          <div class="feature-command__stats" aria-label="Ringkasan fitur">
            {statusSummary.map((item) => <span><strong>{item.value}</strong>{item.label}</span>)}
          </div>
        </aside>
        <div class="feature-command__workspace" data-feature-index>
          <label class="feature-search" for="feature-search-input">
            <span>Cari pekerjaan</span>
            <input id="feature-search-input" type="search" placeholder="Contoh: stok, laba, pelanggan" data-feature-search />
          </label>
          <div class="marketing-card-filters" role="tablist" aria-label="Pilih jenis katalog">
            {catalogFilters.map((filter, index) => <button type="button" class="marketing-card-filter" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-feature-filter={filter.value}>{filter.label}</button>)}
          </div>
          <div class="feature-command__list" aria-live="polite">
            {catalogCards.map((card, index) => (
              <a class="feature-command__row" href={card.href} data-feature-card data-card-family={card.family} data-search-text={`${card.title} ${card.eyebrow} ${card.summary} ${card.action}`}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <div><strong>{card.title}</strong><p>{card.summary}</p></div>
                <small data-status={card.status || 'module'}>{card.status ? capabilityStatusLabel(card.status) : 'Modul RAMUNI'}</small>
              </a>
            ))}
          </div>
          <p class="feature-command__empty" data-feature-empty hidden>Tidak ada hasil yang cocok. Coba kata “stok”, “laba”, “pelanggan”, atau pilih Semua.</p>
        </div>
      </div>
    </section>
    <section class="commercial-section feature-jobs" aria-labelledby="feature-jobs-title">
      <div class="container">
        <div class="commercial-section__head"><div><p class="section-kicker">Prioritas kerja</p><h2 id="feature-jobs-title">Tiga pintu masuk yang paling sering dibutuhkan.</h2></div><p>Ini mengganti rail visual panjang: bukti dan screenshot besar dibuka di halaman detail yang relevan.</p></div>
        <div class="feature-jobs__grid">{jobHighlights.map((item) => <a href={item.href}><span>{item.label}</span><strong>{item.text}</strong><b>Lihat detail →</b></a>)}</div>
      </div>
    </section>
    <section class="commercial-section commercial-section--white feature-context-directory" aria-labelledby="feature-context-title"><div class="container"><div class="commercial-section__head"><div><p class="section-kicker">Cari jalur yang cocok</p><h2 id="feature-context-title">Pilih menurut industri atau peran.</h2></div><p>Gunakan jalur ini saat pekerjaan Anda lebih spesifik daripada nama modul.</p></div><div class="feature-context-directory__grid"><div><h3>Industri</h3><nav aria-label="Fitur berdasarkan industri">{marketingIndustryLinks.map((item) => <a href={item.href}><strong>{item.title}</strong><span>{item.text}</span></a>)}</nav></div><div><h3>Peran</h3><nav aria-label="Fitur berdasarkan peran">{marketingRoleLinks.map((item) => <a href={item.href}><strong>{item.title}</strong><span>{item.text}</span></a>)}</nav></div></div></div></section>
    <section class="commercial-section"><div class="container"><div class="commercial-cta"><div><p class="section-kicker">Coba dengan contoh alur</p><h2>Lihat fitur yang paling dekat dengan pekerjaan Anda.</h2><p>Periksa sumber, periode, dan batas penggunaan sebelum tim menentukan tindakan.</p></div><div class="commercial-cta__actions"><a class="button button--primary" href={consultationCta.href} data-analytics-event="demo_request" data-analytics-location="features_final" data-destination="consultation">Konsultasi</a><a class="text-link" href={appCta.href} data-analytics-event="free_trial_click" data-analytics-location="features_final" data-destination="app">{appCta.label}</a></div></div></div></section>
  </div>
  <CommercialAnalytics />
  <script is:inline>
    (() => {
      const root = document.querySelector('[data-feature-index]');
      if (!root) return;
      const input = root.querySelector('[data-feature-search]');
      const buttons = [...root.querySelectorAll('[data-feature-filter]')];
      const cards = [...root.querySelectorAll('[data-feature-card]')];
      const empty = root.querySelector('[data-feature-empty]');
      let activeFilter = buttons.find((button) => button.getAttribute('aria-selected') === 'true')?.dataset.featureFilter || 'feature';
      const apply = () => {
        const query = String(input?.value || '').trim().toLowerCase();
        let visibleCount = 0;
        cards.forEach((card) => {
          const familyMatch = activeFilter === 'all' || card.dataset.cardFamily === activeFilter;
          const searchMatch = !query || String(card.dataset.searchText || '').toLowerCase().includes(query);
          const visible = familyMatch && searchMatch;
          card.hidden = !visible;
          if (visible) visibleCount += 1;
        });
        if (empty) empty.hidden = visibleCount > 0;
      };
      buttons.forEach((button) => button.addEventListener('click', () => {
        activeFilter = button.dataset.featureFilter || 'all';
        buttons.forEach((item) => item.setAttribute('aria-selected', String(item === button)));
        apply();
      }));
      input?.addEventListener('input', apply);
      apply();
    })();
  </script>
</BaseLayout>

<style is:inline>
  .feature-command-hero .button-row{align-items:center}
  .feature-command__layout{display:grid;grid-template-columns:minmax(260px,.55fr) minmax(0,1.45fr);gap:clamp(28px,6vw,88px);align-items:start}
  .feature-command__panel{position:sticky;top:108px;display:grid;gap:18px}
  .feature-command__panel h2{max-width:14ch}.feature-command__panel>p:last-of-type{max-width:42ch;color:var(--ink-72);line-height:1.62}
  .feature-command__stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--ink-10)}
  .feature-command__stats span{display:grid;gap:5px;min-height:88px;padding:14px;background:var(--rice);color:var(--ink-64);font-size:.68rem;font-weight:800;text-transform:uppercase;letter-spacing:.05em}
  .feature-command__stats strong{color:var(--ink);font-size:1.35rem;letter-spacing:-.04em}
  .feature-command__workspace{min-width:0}
  .feature-search{display:grid;gap:8px;margin-bottom:14px}.feature-search span{color:var(--teal);font-size:.68rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.feature-search input{width:100%;min-height:52px;border:1px solid var(--ink-20);background:var(--rice);padding:0 16px;color:var(--ink);font:inherit}.feature-search input:focus-visible{outline:3px solid var(--teal);outline-offset:2px}
  .feature-command__list{border-top:1px solid var(--ink)}
  .feature-command__row{display:grid;grid-template-columns:46px minmax(0,1fr) auto;gap:18px;align-items:center;min-height:112px;padding:18px 0;border-bottom:1px solid var(--ink-10);color:inherit;text-decoration:none;transition:padding .25s var(--ease),background .25s ease}
  .feature-command__row:hover,.feature-command__row:focus-visible{padding-inline:14px;background:var(--rice)}
  .feature-command__row>span{color:var(--teal);font-size:.68rem;font-weight:900}.feature-command__row strong{font-size:1.02rem}.feature-command__row p{max-width:62ch;margin-top:5px;color:var(--ink-72);font-size:.82rem;line-height:1.45}.feature-command__row small{justify-self:end;padding:6px 8px;border:1px solid var(--ink-20);color:var(--ink-56);font-size:.62rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap}.feature-command__row small[data-status='Limited']{border-color:var(--yellow);background:var(--yellow-18);color:var(--ink)}.feature-command__row small[data-status='Coming soon']{border-style:dashed}.feature-command__empty{margin-top:16px;color:var(--ink-64);font-size:.86rem}
  .feature-jobs__grid{display:grid;grid-template-columns:1.15fr .85fr 1fr;gap:12px}.feature-jobs__grid a{display:grid;gap:18px;min-height:210px;padding:24px;border:1px solid var(--ink-10);background:var(--white);color:inherit;text-decoration:none}.feature-jobs__grid a:nth-child(2){margin-top:34px;background:var(--rice)}.feature-jobs__grid span{color:var(--teal);font-size:.68rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.feature-jobs__grid strong{font-size:clamp(1.05rem,1.6vw,1.35rem);line-height:1.22}.feature-jobs__grid b{align-self:end;color:var(--teal);font-size:.76rem}
  .feature-context-directory__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(22px,5vw,64px)}
  .feature-context-directory__grid h3{margin-bottom:16px;font-size:1.15rem}
  .feature-context-directory__grid nav{display:grid;border-top:1px solid var(--ink-10)}
  .feature-context-directory__grid nav a{display:grid;gap:6px;padding:14px 0;border-bottom:1px solid var(--ink-10);text-decoration:none;transition:padding .25s ease,background .25s ease}
  .feature-context-directory__grid nav a:hover,.feature-context-directory__grid nav a:focus-visible{padding-inline:12px;background:var(--rice)}
  .feature-context-directory__grid nav strong{font-size:.9rem}.feature-context-directory__grid nav span{color:var(--ink-72);font-size:.78rem;line-height:1.45}
  @media(max-width:960px){.feature-command__layout{grid-template-columns:1fr}.feature-command__panel{position:static}.feature-jobs__grid{grid-template-columns:1fr}.feature-jobs__grid a:nth-child(2){margin-top:0}.feature-command__row:hover,.feature-command__row:focus-visible{padding-inline:8px}}
  @media(max-width:700px){.feature-context-directory__grid{grid-template-columns:1fr}.feature-context-directory__grid nav a:hover,.feature-context-directory__grid nav a:focus-visible{padding-inline:8px}.feature-command__stats{grid-template-columns:1fr 1fr}.feature-command__row{grid-template-columns:34px minmax(0,1fr);gap:12px;align-items:start}.feature-command__row small{grid-column:2;justify-self:start}.feature-search input{min-height:50px}}
  @media(prefers-reduced-motion:reduce){.feature-command__row,.feature-context-directory__grid nav a{transition:none}}
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CommercialAnalytics from '../../components/CommercialAnalytics.astro';
import MarketingFeatureCardGrid from '../../components/MarketingFeatureCardGrid.astro';
import ProductScreenshotRail from '../../components/ProductScreenshotRail.astro';
import { featureDetails } from '../../data/commercial';
import { marketingFeatureCards } from '../../data/marketingFeatureCards';
import { productScreenSets } from '../../data/productScreens';
import { pageLastmods } from '../../data/pageLastmods';
import '../../styles/commercial-pages.css';

export function getStaticPaths() {
  return featureDetails.map((feature) => ({ params: { slug: feature.slug }, props: { feature } }));
}
const { feature } = Astro.props;
const origin = new URL('/', Astro.site || Astro.url.origin).origin;
const canonical = new URL(`/features/${feature.slug}/`, origin).toString();
const screenSet = feature.slug === 'profit-intelligence'
  ? productScreenSets.performance
  : feature.slug === 'omnichannel'
    ? productScreenSets.operations
    : productScreenSets.overview;
const featureFlow: Record<string, Array<{ label: string; title: string; text: string }>> = {
  'ai-copilot': [
    { label: '01 · Input', title: 'Pertanyaan dan periode', text: 'Tulis kebutuhan dengan bahasa sehari-hari dan pilih rentang data yang ingin dibaca.' },
    { label: '02 · Proses', title: 'Data dan sumber', text: 'RAMUNI menghubungkan jawaban ke data, dokumen, atau SOP yang diizinkan.' },
    { label: '03 · Output', title: 'Jawaban yang bisa diperiksa', text: 'Lihat ringkasan, bukti pendukung, dan bagian yang masih perlu diverifikasi.' },
  ],
  'profit-intelligence': [
    { label: '01 · Input', title: 'Pendapatan dan biaya', text: 'Masukkan sumber pemasukan, biaya, periode, dan definisi HPP yang digunakan.' },
    { label: '02 · Proses', title: 'Pisahkan arti angka', text: 'RAMUNI membandingkan omzet, biaya, margin, dan kas pada periode yang setara.' },
    { label: '03 · Output', title: 'Titik pemeriksaan margin', text: 'Temukan produk atau kategori biaya yang layak dibahas sebelum mengubah harga.' },
  ],
  omnichannel: [
    { label: '01 · Input', title: 'Kanal yang terhubung', text: 'Pilih kanal resmi dan catatan pelanggan yang memang boleh dibaca oleh tim.' },
    { label: '02 · Proses', title: 'Riwayat dan status', text: 'Percakapan, tag, dan tindak lanjut disusun agar alasan dan statusnya tidak hilang.' },
    { label: '03 · Output', title: 'Follow-up yang disetujui', text: 'Tim melihat prioritas dan menyiapkan balasan sebelum mengirim apa pun.' },
  ],
  'web-builder': [
    { label: '01 · Input', title: 'Profil usaha dan konten', text: 'Siapkan informasi usaha, produk, layanan, dan jalur kontak yang ingin ditampilkan.' },
    { label: '02 · Proses', title: 'Susun halaman', text: 'Pilih struktur halaman, atur hierarki konten, dan cek SEO dasar sebelum publikasi.' },
    { label: '03 · Output', title: 'Halaman yang siap ditemukan', text: 'Bagikan satu alamat yang menjelaskan usaha dan mengarahkan pengunjung ke CTA.' },
  ],
  'knowledge-os': [
    { label: '01 · Input', title: 'SOP dan keputusan', text: 'Simpan dokumen, catatan rapat, dan aturan kerja pada folder yang disepakati.' },
    { label: '02 · Proses', title: 'Struktur dan izin', text: 'Atur kategori dan hak akses agar pengetahuan mudah ditemukan tim.' },
    { label: '03 · Output', title: 'Jawaban dari sumber resmi', text: 'Cari dokumen, ringkas keputusan, dan tandai halaman yang perlu diperbarui.' },
  ],
};
const flow = featureFlow[feature.slug] || featureFlow['ai-copilot'];
const featureCard = marketingFeatureCards.filter((card) => card.slug === feature.slug);
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', '@id': canonical, url: canonical, name: `${feature.name} | Fitur RAMUNI`, description: feature.summary, dateModified: pageLastmods.commercial, inLanguage: 'id-ID' },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Beranda', item: origin + '/' }, { '@type': 'ListItem', position: 2, name: 'Fitur', item: origin + '/features/' }, { '@type': 'ListItem', position: 3, name: feature.name, item: canonical }] },
];
---
<BaseLayout title={`${feature.name} | Fitur RAMUNI`} description={feature.summary} canonical={`/features/${feature.slug}/`} schema={schema} pageType="WebPage">
  <div class="commercial-page" data-commercial-page="feature" data-feature-slug={feature.slug}>
    <section class="feature-detail-hero"><div class="container feature-detail-hero__grid"><div><Breadcrumbs items={[{ label: 'Beranda', href: '/' }, { label: 'Fitur', href: '/features/' }, { label: feature.name }]} /><p class="section-kicker">{feature.eyebrow}</p><h1>{feature.name}</h1></div><div class="feature-detail-hero__aside"><span class="status-chip">{feature.status}</span><p>{feature.statusNote}</p><div class="button-row"><a class="button button--primary" href="/tour-produk-gratis/?flow=trial" data-analytics-event="free_trial_click" data-analytics-location="feature_hero" data-feature={feature.slug} data-destination="tour">Coba gratis</a><a class="button button--secondary" href={feature.relatedHref}>{feature.relatedLabel}</a></div></div></div></section>
    <ProductScreenshotRail
      id={`feature-${feature.slug}-screens`}
      eyebrow="Screen pembanding"
      heading={`Lihat ${feature.name} di dalam workspace RAMUNI.`}
      body="Lihat area kerja yang relevan untuk fitur ini, lalu coba alurnya dengan data usaha Anda."
      items={screenSet}
      compact
    />
    <section class="feature-detail-flow commercial-section commercial-section--white" aria-labelledby="feature-flow-title">
      <div class="container">
        <div class="commercial-section__head"><div><p class="section-kicker">Input sampai hasil</p><h2 id="feature-flow-title">Lihat apa yang masuk dan apa yang keluar.</h2></div><p>Setiap fitur dimulai dari bahan yang jelas, proses yang dapat diterangkan, lalu hasil yang membantu tim menentukan pemeriksaan.</p></div>
        <div class="feature-detail-flow__grid">
          {flow.map((item, index) => <article class="feature-detail-flow__item" style={`--flow-index:${index}`}><span>{item.label}</span><h3>{item.title}</h3><p>{item.text}</p><i aria-hidden="true">{index === flow.length - 1 ? '✓' : '→'}</i></article>)}
        </div>
      </div>
    </section>
    <MarketingFeatureCardGrid
      id={`feature-${feature.slug}-component-preview`}
      eyebrow="Komponen siap pakai"
      heading={`Contoh visual ${feature.name} untuk halaman marketing.`}
      body="Kartu ini memakai bahasa visual dashboard RAMUNI dan data simulasi yang diberi label. Tim marketing dapat menyalin pola ini ke homepage, pricing, atau kampanye produk."
      cards={featureCard}
    />
    <section class="commercial-section commercial-section--white"><div class="container feature-detail-layout"><aside><p class="section-kicker">Ringkasan</p><h2>{feature.summary}</h2><p>Fitur ini tersedia di workspace RAMUNI; batas akses mengikuti paket dan role pengguna.</p></aside><div class="feature-detail-content"><section aria-labelledby="highlights-title"><p class="section-kicker">Yang tersedia</p><h2 id="highlights-title">Baca cara kerjanya, lalu langsung coba.</h2><ul>{feature.highlights.map((item) => <li>{item}</li>)}</ul></section><section aria-labelledby="examples-title"><p class="section-kicker">Contoh pertanyaan</p><h2 id="examples-title">Pertanyaan yang bisa membantu tim mulai memeriksa.</h2><div class="feature-example-grid">{feature.examples.map((item) => <p>{item}</p>)}</div></section><section aria-labelledby="limits-title"><p class="section-kicker">Batas penggunaan</p><h2 id="limits-title">Transparansi lebih penting daripada daftar panjang.</h2><ul>{feature.limitations.map((item) => <li>{item}</li>)}</ul></section><div class="feature-related"><span>Jalur terkait: <strong>{feature.relatedLabel}</strong></span><a class="text-link" href={feature.relatedHref}>Buka halaman terkait →</a></div></div></div></section>
    <section class="commercial-section"><div class="container"><div class="commercial-cta"><div><p class="section-kicker">Coba fitur ini</p><h2>Lihat apakah alurnya cocok untuk tim Anda.</h2><p>Tim RAMUNI dapat membantu memilih jalur demo tanpa meminta data sensitif.</p></div><div class="commercial-cta__actions"><a class="button button--primary" href="/tour-produk-gratis/?flow=trial" data-analytics-event="free_trial_click" data-analytics-location="feature_final" data-feature={feature.slug} data-destination="tour">Coba gratis</a><a class="button button--secondary" href="/features/">Semua fitur</a></div></div></div></section>
  </div>
  <CommercialAnalytics />
</BaseLayout>

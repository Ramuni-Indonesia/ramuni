---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CommercialAnalytics from '../../components/CommercialAnalytics.astro';
import { featureDetails } from '../../data/commercial';
import { pageLastmods } from '../../data/pageLastmods';
import '../../styles/commercial-pages.css';

export function getStaticPaths() {
  return featureDetails.map((feature) => ({ params: { slug: feature.slug }, props: { feature } }));
}
const { feature } = Astro.props;
const origin = new URL('/', Astro.site || Astro.url.origin).origin;
const canonical = new URL(`/features/${feature.slug}/`, origin).toString();
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', '@id': canonical, url: canonical, name: `${feature.name} | Fitur RAMUNI`, description: feature.summary, dateModified: pageLastmods.commercial, inLanguage: 'id-ID' },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Beranda', item: origin + '/' }, { '@type': 'ListItem', position: 2, name: 'Fitur', item: origin + '/features/' }, { '@type': 'ListItem', position: 3, name: feature.name, item: canonical }] },
];
---
<BaseLayout title={`${feature.name} | Fitur RAMUNI`} description={feature.summary} canonical={`/features/${feature.slug}/`} schema={schema} pageType="WebPage">
  <div class="commercial-page" data-commercial-page="feature" data-feature-slug={feature.slug}>
    <section class="feature-detail-hero"><div class="container feature-detail-hero__grid"><div><Breadcrumbs items={[{ label: 'Beranda', href: '/' }, { label: 'Fitur', href: '/features/' }, { label: feature.name }]} /><p class="section-kicker">{feature.eyebrow}</p><h1>{feature.name}</h1></div><div class="feature-detail-hero__aside"><span class="status-chip">{feature.status}</span><p>{feature.statusNote}</p><div class="button-row"><a class="button button--primary" href="/tour-produk-gratis/?flow=consultation" data-analytics-event="demo_request" data-analytics-location="feature_hero" data-feature={feature.slug} data-destination="tour">Minta akses awal</a><a class="button button--secondary" href={feature.relatedHref}>{feature.relatedLabel}</a></div></div></div></section>
    <section class="commercial-section commercial-section--white"><div class="container feature-detail-layout"><aside><p class="section-kicker">Ringkasan</p><h2>{feature.summary}</h2><p>Status dan contoh di halaman ini sengaja dipisahkan dari fitur produk yang sudah terverifikasi.</p></aside><div class="feature-detail-content"><section aria-labelledby="highlights-title"><p class="section-kicker">Yang dirancang</p><h2 id="highlights-title">Baca cara kerjanya sebelum memutuskan.</h2><ul>{feature.highlights.map((item) => <li>{item}</li>)}</ul></section><section aria-labelledby="examples-title"><p class="section-kicker">Contoh pertanyaan</p><h2 id="examples-title">Pertanyaan yang bisa membantu tim mulai memeriksa.</h2><div class="feature-example-grid">{feature.examples.map((item) => <p>{item}</p>)}</div></section><section aria-labelledby="limits-title"><p class="section-kicker">Batas penggunaan</p><h2 id="limits-title">Transparansi lebih penting daripada daftar panjang.</h2><ul>{feature.limitations.map((item) => <li>{item}</li>)}</ul></section><div class="feature-related"><span>Jalur terkait: <strong>{feature.relatedLabel}</strong></span><a class="text-link" href={feature.relatedHref}>Buka halaman terkait →</a></div></div></div></section>
    <section class="commercial-section"><div class="container"><div class="commercial-cta"><div><p class="section-kicker">Langkah berikutnya</p><h2>Mulai dari kebutuhan yang bisa dijelaskan hari ini.</h2><p>Tim RAMUNI dapat membantu memilih jalur validasi tanpa meminta data sensitif.</p></div><div class="commercial-cta__actions"><a class="button button--primary" href="/tour-produk-gratis/?flow=trial" data-analytics-event="free_trial_click" data-analytics-location="feature_final" data-feature={feature.slug} data-destination="tour">Coba gratis</a><a class="button button--secondary" href="/features/">Semua fitur</a></div></div></div></section>
  </div>
  <CommercialAnalytics />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CommercialAnalytics from '../../components/CommercialAnalytics.astro';
import ProductScreenshotRail from '../../components/ProductScreenshotRail.astro';
import { capabilityStatusLabel, featureDetails } from '../../data/commercial';
import { appCta, consultationCta } from '../../data/site';
import { getFeatureDriveVisuals, toProductScreen } from '../../data/driveVisuals';
import { pageLastmods } from '../../data/pageLastmods';
import '../../styles/commercial-pages.css';

export function getStaticPaths() {
  return featureDetails.map((feature) => ({ params: { slug: feature.slug }, props: { feature } }));
}
const { feature } = Astro.props;
const featureIsComingSoon = feature.status === 'Coming soon';
const featureIntentBySlug: Record<string, string> = {
  'ai-copilot': 'overview',
  'profit-intelligence': 'finance',
  omnichannel: 'customer',
  'web-builder': 'overview',
  'knowledge-os': 'report',
};
const featureConsultationHref = `${consultationCta.href}&intent=${featureIntentBySlug[feature.slug] || 'overview'}&feature=${feature.slug}`;
const featurePrimaryCta = featureIsComingSoon ? { ...consultationCta, href: featureConsultationHref } : appCta;
const featurePrimaryLabel = featureIsComingSoon ? 'Konsultasikan kebutuhan' : appCta.label;
const featurePrimaryEvent = featureIsComingSoon ? 'demo_request' : 'free_trial_click';
const featurePrimaryDestination = featureIsComingSoon ? 'consultation' : 'app';
const origin = new URL('/', Astro.site || Astro.url.origin).origin;
const canonical = new URL(`/features/${feature.slug}/`, origin).toString();
const featureDriveSet = getFeatureDriveVisuals(feature.slug);
const screenSet = [featureDriveSet.primary, ...featureDriveSet.supporting.slice(0, 1)].map(toProductScreen);
const featureFlow: Record<string, Array<{ label: string; title: string; text: string }>> = {
  'ai-copilot': [
    { label: '01 · Input', title: 'Pertanyaan dan periode', text: 'Tulis kebutuhan dengan bahasa sehari-hari dan pilih rentang data yang ingin dibaca.' },
    { label: '02 · Proses', title: 'Data dan sumber', text: 'RAMUNI menghubungkan jawaban ke data, dokumen, atau SOP yang diizinkan.' },
    { label: '03 · Output', title: 'Jawaban yang bisa diperiksa', text: 'Lihat ringkasan, bukti pendukung, dan bagian yang masih perlu diverifikasi.' },
  ],
  'profit-intelligence': [
    { label: '01 · Input', title: 'Pendapatan dan biaya', text: 'Masukkan sumber pemasukan, biaya, periode, dan definisi HPP yang digunakan.' },
    { label: '02 · Proses', title: 'Pisahkan arti angka', text: 'RAMUNI membandingkan omzet, biaya, margin, dan kas pada periode yang setara.' },
    { label: '03 · Output', title: 'Titik pemeriksaan margin', text: 'Temukan produk atau kategori biaya yang layak dibahas sebelum mengubah harga.' },
  ],
  omnichannel: [
    { label: '01 · Input', title: 'Kanal yang terhubung', text: 'Pilih kanal resmi dan catatan pelanggan yang memang boleh dibaca oleh tim.' },
    { label: '02 · Proses', title: 'Riwayat dan status', text: 'Percakapan, tag, dan tindak lanjut disusun agar alasan dan statusnya tidak hilang.' },
    { label: '03 · Output', title: 'Follow-up yang disetujui', text: 'Tim melihat prioritas dan menyiapkan balasan sebelum mengirim apa pun.' },
  ],
  'web-builder': [
    { label: '01 · Input', title: 'Profil usaha dan konten', text: 'Siapkan informasi usaha, produk, layanan, dan jalur kontak yang ingin ditampilkan.' },
    { label: '02 · Proses', title: 'Susun halaman', text: 'Pilih struktur halaman, atur hierarki konten, dan cek SEO dasar sebelum publikasi.' },
    { label: '03 · Output', title: 'Halaman yang siap ditemukan', text: 'Bagikan satu alamat yang menjelaskan usaha dan mengarahkan pengunjung ke CTA.' },
  ],
  'knowledge-os': [
    { label: '01 · Input', title: 'SOP dan keputusan', text: 'Simpan dokumen, catatan rapat, dan aturan kerja pada folder yang disepakati.' },
    { label: '02 · Proses', title: 'Struktur dan izin', text: 'Atur kategori dan hak akses agar pengetahuan mudah ditemukan tim.' },
    { label: '03 · Output', title: 'Jawaban dari sumber resmi', text: 'Cari dokumen, ringkas keputusan, dan tandai halaman yang perlu diperbarui.' },
  ],
};
const flow = featureFlow[feature.slug] || featureFlow['ai-copilot'];
const featureSectionCopy: Record<string, { flow: string; capabilities: string; examples: string; limits: string }> = {
  'ai-copilot': {
    flow: 'Pertanyaan berubah menjadi jawaban yang bisa diperiksa.',
    capabilities: 'Yang dibantu AI saat membaca usaha.',
    examples: 'Mulai dengan pertanyaan yang punya konteks.',
    limits: 'Batas AI yang perlu Anda tahu.',
  },
  'profit-intelligence': {
    flow: 'Definisi metrik datang sebelum tafsir laba.',
    capabilities: 'Cara angka keuangan disusun.',
    examples: 'Uji pertanyaan margin dengan periode yang sama.',
    limits: 'Batas pembacaan profit dan kas.',
  },
  omnichannel: {
    flow: 'Inbox, pemilik tugas, izin, lalu status follow-up.',
    capabilities: 'Bagian yang membantu tim menindaklanjuti.',
    examples: 'Pertanyaan untuk menemukan percakapan yang tertinggal.',
    limits: 'Batas kanal dan persetujuan pesan.',
  },
  'web-builder': {
    flow: 'Susun halaman, preview hasilnya, cek batas publikasi.',
    capabilities: 'Bagian dasar sebuah halaman bisnis.',
    examples: 'Contoh brief sebelum halaman disusun.',
    limits: 'Batas domain, form, dan publikasi.',
  },
  'knowledge-os': {
    flow: 'Tangkap SOP, atur izin, lalu temukan rujukan lagi.',
    capabilities: 'Cara pengetahuan tim tetap mudah ditemukan.',
    examples: 'Pertanyaan untuk mencari keputusan dan SOP.',
    limits: 'Batas sumber, izin, dan status rilis.',
  },
};
const sectionCopy = featureSectionCopy[feature.slug] || featureSectionCopy['ai-copilot'];
const closingCopy: Record<string, string> = {
  'ai-copilot': 'Tanyakan satu kondisi usaha, lalu periksa jawabannya.',
  'profit-intelligence': 'Mulai dari definisi angka yang ingin Anda bandingkan.',
  omnichannel: 'Siapkan alur inbox dan izin sebelum kanal dibuka.',
  'web-builder': 'Susun halaman yang sesuai dengan batas publikasi Anda.',
  'knowledge-os': 'Bawa satu SOP yang ingin mudah ditemukan tim.',
};
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', '@id': canonical, url: canonical, name: `${feature.name} | Fitur RAMUNI`, description: feature.summary, dateModified: pageLastmods.commercial, inLanguage: 'id-ID' },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Beranda', item: origin + '/' }, { '@type': 'ListItem', position: 2, name: 'Fitur', item: origin + '/features/' }, { '@type': 'ListItem', position: 3, name: feature.name, item: canonical }] },
];
---
<BaseLayout title={`${feature.name} | Fitur RAMUNI`} description={feature.summary} canonical={`/features/${feature.slug}/`} schema={schema} pageType="WebPage">
  <div class="commercial-page" data-commercial-page="feature" data-feature-slug={feature.slug}>
    <section class="feature-detail-hero"><div class="container feature-detail-hero__grid"><div><Breadcrumbs items={[{ label: 'Beranda', href: '/' }, { label: 'Fitur', href: '/features/' }, { label: feature.name }]} /><p class="section-kicker">{feature.eyebrow}</p><h1>{feature.name}</h1></div><div class="feature-detail-hero__aside"><span class="status-chip" data-status={feature.status}>{capabilityStatusLabel(feature.status)}</span><p>{feature.statusNote}</p><div class="button-row"><a class="button button--primary" href={featurePrimaryCta.href} data-analytics-event={featurePrimaryEvent} data-analytics-location="feature_hero" data-feature={feature.slug} data-destination={featurePrimaryDestination}>{featurePrimaryLabel}</a><a class="button button--secondary" href={feature.relatedHref}>{feature.relatedLabel}</a></div></div></div></section>
    <ProductScreenshotRail
      id={`feature-${feature.slug}-screens`}
      eyebrow="Screen pembanding"
      heading={`Lihat ${feature.name} di dalam workspace RAMUNI.`}
      body="Lihat area kerja yang relevan untuk fitur ini, lalu coba alurnya dengan data usaha Anda."
      items={screenSet}
      compact
    />
    <section class="feature-detail-flow commercial-section commercial-section--white" aria-labelledby="feature-flow-title">
      <div class="container">
        <div class="commercial-section__head"><div><p class="section-kicker">Input sampai hasil</p><h2 id="feature-flow-title">{sectionCopy.flow}</h2></div><p>Setiap fitur dimulai dari bahan yang jelas, proses yang dapat diterangkan, lalu hasil yang membantu tim menentukan pemeriksaan.</p></div>
        <div class="feature-detail-flow__grid">
          {flow.map((item, index) => <article class="feature-detail-flow__item" style={`--flow-index:${index}`}><span>{item.label}</span><h3>{item.title}</h3><p>{item.text}</p><i aria-hidden="true">{index === flow.length - 1 ? '✓' : '→'}</i></article>)}
        </div>
      </div>
    </section>
    <section class="commercial-section commercial-section--white"><div class="container feature-detail-layout"><aside><p class="section-kicker">Ringkasan</p><h2>{feature.summary}</h2><p>{featureIsComingSoon ? 'Fitur ini belum dibuka sebagai kemampuan aktif. Tim dapat menjelaskan kesiapan dan jalur akses saat konsultasi.' : 'Cakupan fitur masih mengikuti rilis, paket, dan role pengguna. Periksa konteks sebelum menjadikannya dasar keputusan.'}</p></aside><div class="feature-detail-content"><section aria-labelledby="highlights-title"><p class="section-kicker">{featureIsComingSoon ? 'Rancangan kemampuan' : 'Yang tersedia'}</p><h2 id="highlights-title">{sectionCopy.capabilities}</h2><ul>{feature.highlights.map((item) => <li>{item}</li>)}</ul></section><section aria-labelledby="examples-title"><p class="section-kicker">Contoh pertanyaan</p><h2 id="examples-title">{sectionCopy.examples}</h2><div class="feature-example-grid">{feature.examples.map((item) => <p>{item}</p>)}</div></section><section aria-labelledby="limits-title"><p class="section-kicker">Batas penggunaan</p><h2 id="limits-title">{sectionCopy.limits}</h2><ul>{feature.limitations.map((item) => <li>{item}</li>)}</ul></section><div class="feature-related"><span>Jalur terkait: <strong>{feature.relatedLabel}</strong></span><a class="text-link" href={feature.relatedHref}>Buka halaman terkait →</a></div></div></div></section>
    <section class="commercial-section"><div class="container"><div class="commercial-cta"><div><p class="section-kicker">Langkah berikutnya</p><h2>{closingCopy[feature.slug] || 'Mulai dari pekerjaan yang paling dekat dengan tim Anda.'}</h2><p>{featureIsComingSoon ? 'Fitur ini belum tersedia sebagai kemampuan aktif. Kirim permintaan konsultasi untuk membahas kesiapan dan batasnya.' : 'Jika ingin langsung melihat workspace, buka aplikasi. Untuk fitur dan batas yang perlu dipetakan, kirim permintaan konsultasi.'}</p></div><div class="commercial-cta__actions"><a class="button button--primary" href={featurePrimaryCta.href} data-analytics-event={featurePrimaryEvent} data-analytics-location="feature_final" data-feature={feature.slug} data-destination={featurePrimaryDestination}>{featurePrimaryLabel}</a>{!featureIsComingSoon && <a class="button button--secondary" href={featureConsultationHref} data-analytics-event="demo_request" data-analytics-location="feature_final" data-feature={feature.slug} data-destination="consultation">Konsultasi</a>}<a class="money-action-link" href="/features/">Semua fitur</a></div></div></div></section>
  </div>
  <CommercialAnalytics />
</BaseLayout>

---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ClarityTracking from '../components/ClarityTracking.astro';
import FloatingContact from '../components/FloatingContact.astro';
import LeadCapturePopup from '../components/LeadCapturePopup.astro';
import MoneySiteLeadSection from '../components/MoneySiteLeadSection.astro';
import ParallaxMotion from '../components/ParallaxMotion.astro';
import GlobalScrollMotion from '../components/GlobalScrollMotion.astro';
import { releaseGates } from '../config/release';
import '../styles/global.css';
import '../styles/mascot-motion.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  canonical?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: 'website' | 'article';
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
  keywords?: string | string[];
  chrome?: boolean;
  previousPage?: string;
  nextPage?: string;
}

const {
  title,
  description,
  image = '/og-default.png',
  imageAlt = 'RAMUNI, AI Business Companion untuk UMKM Indonesia',
  imageWidth = 1200,
  imageHeight = 630,
  canonical = Astro.url.pathname,
  noindex = false,
  schema,
  ogType = 'website',
  pageType,
  keywords = ['RAMUNI', 'AI Business Companion', 'UMKM Indonesia', 'stok usaha', 'penjualan UMKM', 'arus kas usaha'],
  chrome = true,
  previousPage,
  nextPage,
} = Astro.props;
const absoluteCanonical = new URL(canonical, Astro.site || Astro.url.origin).toString();
const absoluteImage = new URL(image, Astro.site || Astro.url.origin).toString();
const absolutePreviousPage = previousPage ? new URL(previousPage, Astro.site || Astro.url.origin).toString() : undefined;
const absoluteNextPage = nextPage ? new URL(nextPage, Astro.site || Astro.url.origin).toString() : undefined;
const fullTitle = title.includes('RAMUNI') ? title : `${title} | RAMUNI`;
const keywordContent = Array.isArray(keywords) ? keywords.join(', ') : keywords;
const pathname = new URL(absoluteCanonical).pathname;
// The browser-only generator already ships its own editor bundle; keep the
// marketing motion pass off that tool route to preserve its tight JS budget.
const globalScrollMotionEnabled = !pathname.startsWith('/generator/');
const isBlogContext = pathname === '/blog/' || pathname.startsWith('/blog/');
const popupContext = isBlogContext ? 'blog' : 'site';
const moneyLeadAllowed = !isBlogContext && (
  pathname === '/'
  || /^\/(produk|solusi|features|pricing|compare|faq|tentang|industri|untuk|roadmap|sumber-daya|panduan|template|kalkulator|kamus-bisnis|bantuan|keamanan)(\/|$)/.test(pathname)
);
const moneyLeadExcluded = /^(\/kontak|\/tour-produk-gratis|\/terima-kasih|\/status|\/maintenance|\/404|\/500|\/masuk|\/demo|\/early-access)(\/|$)/.test(pathname);
const showMoneyLead = chrome && moneyLeadAllowed && !moneyLeadExcluded;
const moneyLeadLocation = `money-site-${pathname.replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '') || 'home'}`;
const moneyLeadCopy = pathname.startsWith('/produk/') || pathname === '/produk/'
  ? { eyebrow: 'Lihat modul di pekerjaan Anda', title: 'Pilih bagian usaha yang ingin Anda rapikan.', body: 'Pilih penjualan, stok, keuangan, pelanggan, atau laporan. Tim RAMUNI memperlihatkan screen dan cara mulai yang sesuai.' }
  : pathname.startsWith('/solusi/') || pathname === '/solusi/'
    ? { eyebrow: 'Mulai dari masalah yang terasa', title: 'Sebutkan satu masalah usaha. Lihat jalurnya.', body: 'Ceritakan apa yang menghambat pekerjaan. Tim menghubungkan gejala, data yang perlu dibuka, dan modul yang relevan.' }
    : pathname.startsWith('/features/')
      ? { eyebrow: 'Lihat fitur di pekerjaan Anda', title: 'Coba fitur yang paling dekat dengan kebutuhan Anda.', body: 'Pilih satu kebutuhan dan lihat input, hasil, serta batas penggunaan sebelum memilih paket.' }
      : pathname.startsWith('/pricing')
        ? { eyebrow: 'Pilih paket dengan tenang', title: 'Belum yakin paket mana yang pas?', body: 'Isi kontak singkat. Tim RAMUNI membantu mencocokkan jumlah pengguna, alur kerja, dan batas paket dengan kebutuhan Anda.' }
        : pathname.startsWith('/tentang')
          ? { eyebrow: 'Kenali cara kerja kami', title: 'Lihat cara RAMUNI membantu tim mengambil keputusan.', body: 'Mulai dari contoh yang aman. Kami menjelaskan cara kerja produk sebelum Anda menyiapkan data atau memilih paket.' }
          : { eyebrow: 'Mulai dari pekerjaan nyata', title: 'Lihat apa yang ingin Anda pahami minggu ini.', body: 'Pilih satu kebutuhan. Tim RAMUNI memperlihatkan contoh data, modul, dan cara mulai tanpa meminta data bisnis sensitif.' };
const inferredPageType = pageType
  || (/^\/tentang\/?$/.test(pathname) ? 'AboutPage' : undefined)
  || (/^\/kontak\/?$/.test(pathname) ? 'ContactPage' : undefined)
  || (/^\/(sumber-daya|panduan|template|kalkulator|kamus-bisnis)\/?$/.test(pathname) ? 'CollectionPage' : undefined)
  || 'WebPage';
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': inferredPageType,
  '@id': absoluteCanonical,
  url: absoluteCanonical,
  name: fullTitle,
  description,
  inLanguage: 'id-ID',
};
const suppliedSchema = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const hasPageSchema = suppliedSchema.some((entity) => {
  const type = entity?.['@type'];
  return type === inferredPageType || (Array.isArray(type) && type.includes(inferredPageType));
});
const hasBreadcrumbSchema = suppliedSchema.some((entity) => {
  const type = entity?.['@type'];
  return type === 'BreadcrumbList' || (Array.isArray(type) && type.includes('BreadcrumbList'));
});
const breadcrumbRoots: Record<string, string> = {
  produk: 'Produk',
  solusi: 'Solusi',
};
const breadcrumbSegments = pathname.split('/').filter(Boolean);
const needsAutomaticBreadcrumb = !hasBreadcrumbSchema
  && breadcrumbSegments.length > 0
  && breadcrumbSegments[0] in breadcrumbRoots;
const automaticBreadcrumbSchema = needsAutomaticBreadcrumb ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Beranda',
      item: new URL('/', Astro.site || Astro.url.origin).toString(),
    },
    ...breadcrumbSegments.map((segment, index) => {
      const isLast = index === breadcrumbSegments.length - 1;
      const path = `/${breadcrumbSegments.slice(0, index + 1).join('/')}/`;
      const readableSegment = decodeURIComponent(segment)
        .split('-')
        .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
        .join(' ');
      return {
        '@type': 'ListItem',
        position: index + 2,
        name: index === 0 ? breadcrumbRoots[segment] : (isLast ? title.split('|')[0].trim() : readableSegment),
        item: new URL(path, Astro.site || Astro.url.origin).toString(),
      };
    }),
  ],
} : undefined;
const effectiveNoindex = noindex || !releaseGates.siteIndexable;
const schemaWithBreadcrumb = automaticBreadcrumbSchema
  ? [...suppliedSchema, automaticBreadcrumbSchema]
  : suppliedSchema;
const structuredData = effectiveNoindex ? schemaWithBreadcrumb : [
  ...(hasPageSchema ? [] : [webPageSchema]),
  ...schemaWithBreadcrumb,
];
const structuredDataDocument = structuredData.length > 0 ? {
  '@context': 'https://schema.org',
  '@graph': structuredData.map((entity) => {
    const normalizedEntity = { ...(entity as Record<string, unknown>) };
    delete normalizedEntity['@context'];
    return normalizedEntity;
  }),
} : undefined;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F4F0E7" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywordContent} />
    <meta name="robots" content={effectiveNoindex ? 'noindex,follow' : 'index,follow'} />
    <link rel="canonical" href={absoluteCanonical} />
    {absolutePreviousPage && <link rel="prev" href={absolutePreviousPage} />}
    {absoluteNextPage && <link rel="next" href={absoluteNextPage} />}
    <link rel="alternate" hreflang="id-ID" href={absoluteCanonical} />
    <link rel="alternate" hreflang="x-default" href={absoluteCanonical} />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/PlusJakartaSans-ExtraBold.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="RAMUNI" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absoluteCanonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{fullTitle}</title>
    {releaseGates.environment === 'production' && <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="PsIaaBxnCUIP7WSPj21MOg" async></script>}
    {pathname !== '/' && <style is:inline>.page-hero,.article-hero,.category-hero,.author-hero,.search-page-hero,.price-hero,.demo-hero,.catalog-hero,.solution-hub-hero{padding:clamp(42px,5vw,72px) 0 clamp(62px,7vw,104px)!important}.resource-hero,.calculator-hero,.guide-header,.glossary-header{padding:clamp(42px,5vw,72px) 0 clamp(58px,7vw,96px)!important}@media(max-width:740px){.page-hero,.article-hero,.category-hero,.author-hero,.search-page-hero,.price-hero,.demo-hero,.catalog-hero,.solution-hub-hero,.resource-hero,.calculator-hero,.guide-header,.glossary-header{padding:38px 0 56px!important}}</style>}
    <script is:inline>document.documentElement.classList.add('js');</script>
    {structuredDataDocument && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredDataDocument)} />}
  </head>
  <body data-lead-popup-auto-open={chrome ? 'true' : 'false'} data-whatsapp-auto-open={chrome ? 'true' : 'false'} data-popup-context={popupContext}>
    <a class="skip-link" href="#main">Lewati ke konten</a>
    {chrome && <Header />}
    <main id="main"><slot /></main>
    {showMoneyLead && <MoneySiteLeadSection location={moneyLeadLocation} pageType="money-site-footer-lead" {...moneyLeadCopy} />}
    {chrome && <Footer />}
    {chrome && <FloatingContact />}
    {chrome && <LeadCapturePopup context={popupContext} />}
    <ClarityTracking />
    <ParallaxMotion />
    <script is:inline src="/scripts/reveal.js"></script>
    <script is:inline src="/scripts/mascot-motion.js"></script>
    {globalScrollMotionEnabled && <GlobalScrollMotion />}
  </body>
</html>

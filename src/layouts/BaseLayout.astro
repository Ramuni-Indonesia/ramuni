---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentManager from '../components/ConsentManager.astro';
import FloatingContact from '../components/FloatingContact.astro';
import ParallaxMotion from '../components/ParallaxMotion.astro';
import { releaseGates } from '../config/release';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  canonical?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: 'website' | 'article';
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
  keywords?: string | string[];
  chrome?: boolean;
  previousPage?: string;
  nextPage?: string;
}

const {
  title,
  description,
  image = '/og-default.png',
  imageAlt = 'RAMUNI, AI Business Companion untuk UMKM Indonesia',
  imageWidth = 1200,
  imageHeight = 630,
  canonical = Astro.url.pathname,
  noindex = false,
  schema,
  ogType = 'website',
  pageType,
  keywords = ['RAMUNI', 'AI Business Companion', 'UMKM Indonesia', 'stok usaha', 'penjualan UMKM', 'arus kas usaha'],
  chrome = true,
  previousPage,
  nextPage,
} = Astro.props;
const absoluteCanonical = new URL(canonical, Astro.site || Astro.url.origin).toString();
const absoluteImage = new URL(image, Astro.site || Astro.url.origin).toString();
const absolutePreviousPage = previousPage ? new URL(previousPage, Astro.site || Astro.url.origin).toString() : undefined;
const absoluteNextPage = nextPage ? new URL(nextPage, Astro.site || Astro.url.origin).toString() : undefined;
const fullTitle = title.includes('RAMUNI') ? title : `${title} | RAMUNI`;
const keywordContent = Array.isArray(keywords) ? keywords.join(', ') : keywords;
const pathname = new URL(absoluteCanonical).pathname;
const inferredPageType = pageType
  || (/^\/tentang\/?$/.test(pathname) ? 'AboutPage' : undefined)
  || (/^\/kontak\/?$/.test(pathname) ? 'ContactPage' : undefined)
  || (/^\/(sumber-daya|panduan|template|kalkulator|kamus-bisnis)\/?$/.test(pathname) ? 'CollectionPage' : undefined)
  || 'WebPage';
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': inferredPageType,
  '@id': absoluteCanonical,
  url: absoluteCanonical,
  name: fullTitle,
  description,
  inLanguage: 'id-ID',
};
const suppliedSchema = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const hasPageSchema = suppliedSchema.some((entity) => {
  const type = entity?.['@type'];
  return type === inferredPageType || (Array.isArray(type) && type.includes(inferredPageType));
});
const hasBreadcrumbSchema = suppliedSchema.some((entity) => {
  const type = entity?.['@type'];
  return type === 'BreadcrumbList' || (Array.isArray(type) && type.includes('BreadcrumbList'));
});
const breadcrumbRoots: Record<string, string> = {
  produk: 'Produk',
  solusi: 'Solusi',
};
const breadcrumbSegments = pathname.split('/').filter(Boolean);
const needsAutomaticBreadcrumb = !hasBreadcrumbSchema
  && breadcrumbSegments.length > 0
  && breadcrumbSegments[0] in breadcrumbRoots;
const automaticBreadcrumbSchema = needsAutomaticBreadcrumb ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Beranda',
      item: new URL('/', Astro.site || Astro.url.origin).toString(),
    },
    ...breadcrumbSegments.map((segment, index) => {
      const isLast = index === breadcrumbSegments.length - 1;
      const path = `/${breadcrumbSegments.slice(0, index + 1).join('/')}/`;
      const readableSegment = decodeURIComponent(segment)
        .split('-')
        .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
        .join(' ');
      return {
        '@type': 'ListItem',
        position: index + 2,
        name: index === 0 ? breadcrumbRoots[segment] : (isLast ? title.split('|')[0].trim() : readableSegment),
        item: new URL(path, Astro.site || Astro.url.origin).toString(),
      };
    }),
  ],
} : undefined;
const effectiveNoindex = noindex || !releaseGates.siteIndexable;
const schemaWithBreadcrumb = automaticBreadcrumbSchema
  ? [...suppliedSchema, automaticBreadcrumbSchema]
  : suppliedSchema;
const structuredData = effectiveNoindex ? schemaWithBreadcrumb : [
  ...(hasPageSchema ? [] : [webPageSchema]),
  ...schemaWithBreadcrumb,
];
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F4F0E7" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywordContent} />
    <meta name="robots" content={effectiveNoindex ? 'noindex,follow' : 'index,follow'} />
    <link rel="canonical" href={absoluteCanonical} />
    {absolutePreviousPage && <link rel="prev" href={absolutePreviousPage} />}
    {absoluteNextPage && <link rel="next" href={absoluteNextPage} />}
    <link rel="alternate" hreflang="id-ID" href={absoluteCanonical} />
    <link rel="alternate" hreflang="x-default" href={absoluteCanonical} />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/PlusJakartaSans-ExtraBold.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="RAMUNI" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absoluteCanonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{fullTitle}</title>
    {pathname !== '/' && <style is:inline>.page-hero,.article-hero,.category-hero,.author-hero,.search-page-hero,.price-hero,.demo-hero,.catalog-hero,.solution-hub-hero{padding:clamp(42px,5vw,72px) 0 clamp(62px,7vw,104px)!important}.resource-hero,.calculator-hero,.guide-header,.glossary-header{padding:clamp(42px,5vw,72px) 0 clamp(58px,7vw,96px)!important}@media(max-width:740px){.page-hero,.article-hero,.category-hero,.author-hero,.search-page-hero,.price-hero,.demo-hero,.catalog-hero,.solution-hub-hero,.resource-hero,.calculator-hero,.guide-header,.glossary-header{padding:38px 0 56px!important}}</style>}
    <script is:inline>document.documentElement.classList.add('js');</script>
    {structuredData.length > 0 && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Lewati ke konten</a>
    {chrome && <Header />}
    <main id="main"><slot /></main>
    {chrome && <Footer />}
    {chrome && <FloatingContact />}
    <ConsentManager />
    <ParallaxMotion />
    <script is:inline src="/scripts/reveal.js"></script>
  </body>
</html>

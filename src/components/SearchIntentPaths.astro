---
import type { SearchIntentPath } from '../data/searchIntentPaths';

interface Props {
  path?: SearchIntentPath;
}

const { path } = Astro.props;
---

{path && <section class="search-intent-path" aria-labelledby="search-intent-title">
  <div class="container">
    <header>
      <p class="section-kicker">{path.eyebrow}</p>
      <h2 id="search-intent-title">{path.title}</h2>
      <p>{path.intro}</p>
    </header>
    <div class="search-intent-path__grid">
      <div class="search-intent-path__questions">
        {path.questions.map((question, index) => <article>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{question.title}</h3>
          <p>{question.text}</p>
        </article>)}
      </div>
      <nav aria-label="Bacaan dan halaman terkait">
        {path.links.map((link) => <a href={link.href}>
          <strong>{link.label}</strong>
          <span>{link.description}</span>
          <b aria-hidden="true">Buka →</b>
        </a>)}
      </nav>
    </div>
  </div>
</section>}

<style>
  .search-intent-path{padding-block:clamp(58px,7vw,100px);background:var(--rice,#f4f0e7);border-block:1px solid color-mix(in srgb,var(--ink,#0b3045) 12%,transparent)}
  .search-intent-path header{max-width:780px}.search-intent-path header h2{max-width:19ch;margin:8px 0 14px;font-size:clamp(1.8rem,3.5vw,3.3rem);line-height:1.08}.search-intent-path header>p:last-child{max-width:66ch;color:var(--ink-72,#355563);line-height:1.7}
  .search-intent-path__grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.85fr);gap:clamp(24px,5vw,68px);margin-top:clamp(28px,4vw,46px)}
  .search-intent-path__questions{display:grid;gap:1px;background:color-mix(in srgb,var(--ink,#0b3045) 14%,transparent);border:1px solid color-mix(in srgb,var(--ink,#0b3045) 14%,transparent)}
  .search-intent-path__questions article{display:grid;grid-template-columns:36px 1fr;column-gap:15px;padding:24px;background:var(--white,#fff)}.search-intent-path__questions span{grid-row:span 2;color:var(--teal,#168c8c);font-size:.72rem;font-weight:800;letter-spacing:.08em}.search-intent-path__questions h3{margin:0;font-size:1rem}.search-intent-path__questions p{grid-column:2;margin:7px 0 0;color:var(--ink-72,#355563);line-height:1.6}
  .search-intent-path nav{border-top:2px solid var(--teal,#168c8c)}.search-intent-path nav a{position:relative;display:grid;gap:5px;padding:18px 30px 18px 0;border-bottom:1px solid color-mix(in srgb,var(--ink,#0b3045) 14%,transparent);color:var(--ink,#0b3045);text-decoration:none}.search-intent-path nav a:hover strong,.search-intent-path nav a:focus-visible strong{text-decoration:underline;text-decoration-color:var(--teal,#168c8c);text-underline-offset:4px}.search-intent-path nav span{color:var(--ink-72,#355563);font-size:.9rem;line-height:1.5}.search-intent-path nav b{position:absolute;right:0;top:22px;color:var(--teal,#168c8c);font-size:.72rem}
  @media(max-width:760px){.search-intent-path__grid{grid-template-columns:1fr}.search-intent-path__questions article{padding:20px}.search-intent-path header h2{max-width:100%}}
</style>

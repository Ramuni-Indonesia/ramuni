---
import type { SearchIntentPath } from '../data/searchIntentPaths';

interface Props {
  path?: SearchIntentPath;
}

const { path } = Astro.props;
---

{path && <section class="search-intent-path">
  <div class="container">
    <h2>{path.title}</h2>
    <nav aria-label="Bacaan dan halaman terkait">
      {path.links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</section>}

<style>
  .search-intent-path{padding-block:clamp(42px,5vw,62px);background:var(--rice,#f4f0e7);border-block:1px solid color-mix(in srgb,var(--ink,#0b3045) 12%,transparent)}
  .search-intent-path h2{max-width:28ch;margin:0;font-size:clamp(1.45rem,2.6vw,2.15rem);line-height:1.15}.search-intent-path nav{display:flex;flex-wrap:wrap;gap:10px 18px;margin-top:20px}.search-intent-path a{color:var(--ink,#0b3045);font-weight:800}.search-intent-path a:not(:last-child)::after{margin-left:18px;color:var(--teal,#168c8c);content:'→'}
</style>

---
import type { SearchIntentPath } from '../data/searchIntentPaths';

interface Props {
  path?: SearchIntentPath;
}

const { path } = Astro.props;
---

{path && <section class="search-intent-path" aria-labelledby="search-intent-title">
  <div class="container">
    <header>
      <h2 id="search-intent-title">{path.title}</h2>
    </header>
    <nav aria-label="Bacaan dan halaman terkait">
      <ul>{path.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
    </nav>
  </div>
</section>}

<style>
  .search-intent-path{padding-block:clamp(42px,5vw,62px);background:var(--rice,#f4f0e7);border-block:1px solid color-mix(in srgb,var(--ink,#0b3045) 12%,transparent)}
  .search-intent-path h2{max-width:28ch;margin:0;font-size:clamp(1.45rem,2.6vw,2.15rem);line-height:1.15}.search-intent-path ul{display:flex;flex-wrap:wrap;gap:10px 18px;margin:20px 0 0;padding:0;list-style:none}.search-intent-path a{color:var(--ink,#0b3045);font-weight:800}.search-intent-path li:not(:last-child)::after{margin-left:18px;color:var(--teal,#168c8c);content:'→'}
</style>

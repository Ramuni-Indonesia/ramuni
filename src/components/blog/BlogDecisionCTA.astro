---
import { mascots } from '../../data/mascots';

interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  text: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  variant?: 'archive' | 'article';
  stageLabels?: [string, string, string, string];
  metricLabel?: string;
}

const {
  id,
  eyebrow = 'Dari bacaan ke keputusan',
  title,
  text,
  primaryLabel = 'Mulai coba gratis',
  primaryHref = '/tour-produk-gratis/',
  secondaryLabel,
  secondaryHref,
  variant = 'archive',
  stageLabels = ['Catatan', 'Bukti', 'Konteks', 'Arah'],
  metricLabel = 'Contoh pembacaan',
} = Astro.props;

const banner = mascots.dashboardGuide;
---

<div id={id} class:list={['blog-decision-cta', `blog-decision-cta--${variant}`]}>
  <div class="blog-decision-cta__copy">
    <p class="section-kicker">{eyebrow}</p>
    <h2 id={`${id}-heading`}>{title}</h2>
    <p>{text}</p>
    <div class="blog-decision-cta__actions">
      <a class="button button--primary" href={primaryHref}>{primaryLabel}</a>
      {secondaryLabel && secondaryHref && <a class="button button--secondary" href={secondaryHref}>{secondaryLabel}</a>}
    </div>
  </div>

  <div class="blog-decision-cta__visual" aria-label="Alur singkat dari catatan usaha menuju langkah berikutnya.">
    <img class="blog-decision-cta__banner" src={banner.src} width={banner.width} height={banner.height} alt="" aria-hidden="true" loading="lazy" decoding="async" />
    <div class="blog-decision-cta__visual-head">
      <span>Alur yang dapat diperiksa</span>
      <small>{metricLabel}</small>
    </div>
    <ol class="blog-decision-cta__steps">
      {stageLabels.map((label, index) => <li><b>{String(index + 1).padStart(2, '0')}</b><span>{label}</span><i aria-hidden="true"></i></li>)}
    </ol>
    <p class="blog-decision-cta__note">Mulai dari catatan yang sudah ada. Periksa konteksnya, lalu pilih satu langkah yang masuk akal untuk usaha Anda.</p>
  </div>
</div>

---
import DashboardMotion from '../DashboardMotion.astro';
import { dashboardVisuals, type DashboardVisualKey } from '../../data/dashboardVisuals';

interface Props {
  articleId: string;
  articleTitle?: string;
  articleDescription?: string;
  articleCover?: string;
  articleCoverAlt?: string;
  articleCoverWidth?: number;
  articleCoverHeight?: number;
}

const {
  articleId,
  articleTitle = 'Memahami konsep utama artikel',
  articleDescription = 'Visual ringkas membantu menghubungkan penjelasan dengan contoh yang mudah dibaca.',
  articleCover,
  articleCoverAlt,
  articleCoverWidth = 1600,
  articleCoverHeight = 900,
} = Astro.props;

const variants = {
  'ai-business-companion-umkm': {
    label: 'Tampilan ringkasan RAMUNI',
    title: 'Perubahan penting terlihat dalam satu layar.',
    description: 'Dashboard merangkum penjualan, kas, stok, pelanggan, aktivitas, dan wawasan usaha.',
    kind: 'ai',
    dashboard: 'productOverview',
    alt: 'Dashboard RAMUNI berisi ringkasan penjualan, kas, stok, pelanggan, aktivitas, dan wawasan usaha.',
  },
  'arus-kas-umkm-ringan': {
    label: 'Contoh pembacaan arus kas',
    title: 'Pisahkan pergerakan uang dari angka penjualan.',
    description: 'Dashboard menampilkan kas tersedia dan perubahan arus kas untuk membantu pemeriksaan.',
    kind: 'cash',
    dashboard: 'productPerformance',
    alt: 'Dashboard RAMUNI dengan ringkasan kas tersedia dan grafik arus kas.',
  },
  'panduan-membaca-stok-harian': {
    label: 'Tampilan aktivitas RAMUNI',
    title: 'Perubahan stok masuk ke urutan aktivitas usaha.',
    description: 'Dashboard membantu melihat pembaruan stok bersama transaksi dan pengeluaran terbaru.',
    kind: 'stock',
    dashboard: 'productOperations',
    alt: 'Dashboard RAMUNI yang menampilkan aktivitas pembayaran, pembaruan stok, dan pengeluaran operasional.',
  },
  'cara-membaca-omzet-harian': {
    label: 'Tampilan kinerja RAMUNI',
    title: 'Penjualan hari ini dibaca bersama perubahan kas.',
    description: 'Dashboard memperlihatkan indikator penjualan, kas tersedia, produk aktif, dan grafik arus kas.',
    kind: 'sales',
    dashboard: 'productPerformance',
    alt: 'Dashboard RAMUNI dengan indikator penjualan, kas tersedia, produk aktif, dan grafik arus kas.',
  },
  'produk-terlaris-belum-tentu-paling-untung': {
    label: 'Tampilan kinerja RAMUNI',
    title: 'Penjualan perlu dibaca bersama kondisi kas.',
    description: 'Dashboard menyandingkan indikator penjualan, kas tersedia, produk aktif, dan perubahan arus kas.',
    kind: 'cash',
    dashboard: 'productPerformance',
    alt: 'Dashboard RAMUNI dengan indikator penjualan, kas tersedia, produk aktif, dan grafik arus kas.',
  },
  'cara-membandingkan-penjualan-mingguan': {
    label: 'Tampilan kinerja RAMUNI',
    title: 'Perubahan penjualan terlihat dalam ringkasan yang sama.',
    description: 'Dashboard memperlihatkan indikator penjualan dan grafik arus kas tujuh hari terakhir.',
    kind: 'sales',
    dashboard: 'productPerformance',
    alt: 'Dashboard RAMUNI dengan indikator penjualan dan grafik arus kas tujuh hari terakhir.',
  },
  'cara-melihat-pelanggan-yang-kembali-belanja': {
    label: 'Tampilan kinerja RAMUNI',
    title: 'Ringkasan usaha membantu memilih angka yang perlu dibuka lebih jauh.',
    description: 'Dashboard menempatkan perubahan penjualan dan kas dalam satu konteks pemeriksaan.',
    kind: 'sales',
    dashboard: 'productPerformance',
    alt: 'Dashboard RAMUNI dengan indikator penjualan, kas tersedia, produk aktif, dan grafik arus kas.',
  },
  'data-pelanggan-yang-perlu-dicatat-umkm': {
    label: 'Tampilan kinerja RAMUNI',
    title: 'Ringkasan membantu menentukan detail yang benar-benar perlu diperiksa.',
    description: 'Dashboard menyatukan indikator penjualan dan kas tanpa menampilkan data pribadi pelanggan.',
    kind: 'sales',
    dashboard: 'productPerformance',
    alt: 'Dashboard RAMUNI dengan indikator penjualan, kas tersedia, produk aktif, dan grafik arus kas.',
  },
  'checklist-review-bisnis-mingguan-umkm': {
    label: 'Contoh review mingguan',
    title: 'Pilih perubahan, bukti, dan penanggung jawab.',
    description: 'Tampilan produk merangkum penjualan, kas, stok, dan pekerjaan yang perlu diperiksa.',
    kind: 'operations',
    dashboard: 'productOverview',
    alt: 'Tampilan produk RAMUNI untuk review bisnis mingguan.',
  },
  'cara-merapikan-data-produk-dan-sku': {
    label: 'Tampilan aktivitas RAMUNI',
    title: 'Setiap pembaruan produk terlihat dalam aktivitas usaha.',
    description: 'Dashboard membantu melihat pembaruan stok bersama transaksi dan pengeluaran terbaru.',
    kind: 'stock',
    dashboard: 'productOperations',
    alt: 'Dashboard RAMUNI yang menampilkan aktivitas pembayaran, pembaruan stok, dan pengeluaran operasional.',
  },
  'perbedaan-omzet-laba-dan-arus-kas': {
    label: 'Tampilan kinerja RAMUNI',
    title: 'Penjualan dan pergerakan kas dibaca berdampingan.',
    description: 'Dashboard menyandingkan indikator penjualan, kas tersedia, dan grafik arus kas.',
    kind: 'cash',
    dashboard: 'productPerformance',
    alt: 'Dashboard RAMUNI dengan indikator penjualan, kas tersedia, produk aktif, dan grafik arus kas.',
  },
  'cara-menentukan-stok-minimum-umkm': {
    label: 'Tampilan inventori RAMUNI',
    title: 'Saldo stok dibaca bersama kebutuhan isi ulang.',
    description: 'Dashboard membantu memeriksa produk yang mendekati batas dan konteks sebelum menentukan pemesanan.',
    kind: 'stock',
    dashboard: 'productOperations',
    alt: 'Dashboard RAMUNI yang menampilkan aktivitas stok, transaksi, dan pengeluaran operasional.',
  },
  'laporan-laba-rugi-sederhana-umkm': {
    label: 'Tampilan kinerja RAMUNI',
    title: 'Pendapatan dan biaya perlu dibaca dalam periode yang sama.',
    description: 'Dashboard menempatkan penjualan dan perubahan kas sebagai pintu masuk untuk membuka komponen laporan.',
    kind: 'cash',
    dashboard: 'productPerformance',
    alt: 'Dashboard RAMUNI dengan indikator penjualan, kas tersedia, produk aktif, dan grafik arus kas.',
  },
} as const;

// Only the article that actually explains the RAMUNI product keeps a product
// dashboard. Other articles receive a topical explanatory illustration.
const visual = articleId === 'ai-business-companion-umkm' ? variants[articleId] : undefined;
const dashboard = visual ? dashboardVisuals[visual.dashboard as DashboardVisualKey] : null;
// The editorial cover is the canonical, reviewed asset for every article. A
// previous implementation inferred a second generated filename from the
// article id, which allowed a valid article to ship with a 404 visual when
// the optional derivative was not published. Use the reviewed cover here.
const generatedSrc = articleCover || '/website-original/blog/generated/article-visuals/produk-terlaris-belum-tentu-paling-untung.webp';
---

{visual && dashboard ? (
  <figure class:list={['article-context-visual', `article-context-visual--${visual.kind}`]}>
    <div class:list={['article-context-visual__stage', { 'article-context-visual__stage--product': dashboard.type === 'product-screenshot' }]}>
      <DashboardMotion focus={visual.kind} label={visual.alt} {...dashboard} />
    </div>
    <figcaption>
      <span>{visual.label}</span>
      <strong>{visual.title}</strong>
      <p>{visual.description}</p>
    </figcaption>
  </figure>
) : (
  <figure class="article-context-visual article-context-visual--generated">
    <div class="article-context-visual__stage article-context-visual__stage--generated">
      <img src={generatedSrc} width={articleCoverWidth} height={articleCoverHeight} alt={articleCoverAlt || `Visual penjelas untuk ${articleTitle}`} loading="lazy" decoding="async" />
    </div>
    <figcaption>
      <span>Visual penjelas</span>
      <strong>{articleTitle}</strong>
      <p>{articleDescription}</p>
    </figcaption>
  </figure>
)}

<style is:global>
  .article-context-visual{display:grid;grid-template-columns:1fr;gap:0;margin:clamp(30px,5vw,54px) 0 clamp(46px,7vw,76px);border:1px solid var(--ink);background:var(--rice);overflow:hidden}
  .article-context-visual figcaption{display:flex;flex-direction:column;align-items:flex-start;padding:clamp(20px,3vw,30px) clamp(20px,4vw,38px) clamp(22px,3vw,34px)}
  .article-context-visual figcaption span{color:var(--teal);font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .article-context-visual figcaption strong{max-width:28ch;margin-top:10px;font-size:clamp(1.3rem,2.6vw,2.15rem);line-height:1.08;letter-spacing:-.04em}
  .article-context-visual figcaption p{max-width:70ch;margin-top:10px;color:var(--ink-72);font-size:.88rem;line-height:1.6}
  .article-context-visual__stage{position:relative;min-width:0;padding:0;background:var(--rice);overflow:hidden}
  .article-context-visual__stage--product{padding:clamp(14px,2vw,22px)}
  .article-context-visual__stage--generated{padding:0;background:var(--cream)}
  .article-context-visual__stage--generated img{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;background:var(--cream)}
  @media(max-width:740px){.article-context-visual figcaption{padding:18px 16px 22px}.article-context-visual figcaption strong{font-size:clamp(1.25rem,6vw,1.75rem)}}
</style>

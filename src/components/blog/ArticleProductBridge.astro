---
import BlogDecisionCTA from './BlogDecisionCTA.astro';
import { getArticleJourney } from '../../data/articleJourneys';

interface Props {
  categorySlug: string;
  articleId: string;
}

const { categorySlug, articleId } = Astro.props;
const journey = getArticleJourney(categorySlug, articleId);
---

<aside class="article-inline-decision" aria-label={`Lanjut ke ${journey.nextTitle}`}>
  <BlogDecisionCTA
    id={`article-product-${articleId}`}
    eyebrow={`Lanjut ke ${journey.label}`}
    title={journey.title}
    text={journey.text}
    primaryLabel={`Lihat ${journey.nextTitle}`}
    primaryHref={journey.nextHref}
    secondaryLabel={`Pelajari ${journey.productTitle}`}
    secondaryHref={journey.productHref}
    variant="article"
    stageLabels={journey.stages}
    metricLabel={journey.metric}
  />
</aside>

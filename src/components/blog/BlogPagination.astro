---
interface Props {
  currentPage: number;
  totalPages: number;
  label?: string;
}

const { currentPage, totalPages, label = 'Navigasi halaman artikel' } = Astro.props;
const hrefForPage = (page: number) => page <= 1 ? '/blog/' : `/blog/page/${page}/`;

const visiblePages = [...new Set([
  1,
  currentPage - 2,
  currentPage - 1,
  currentPage,
  currentPage + 1,
  currentPage + 2,
  totalPages,
].filter((page) => page >= 1 && page <= totalPages))].sort((a, b) => a - b);

const pageItems: Array<number | string> = [];
visiblePages.forEach((page, index) => {
  const previous = visiblePages[index - 1];
  if (previous && page - previous > 1) pageItems.push(`ellipsis-${previous}`);
  pageItems.push(page);
});
---

{totalPages > 1 && (
  <nav class="blog-pagination" aria-label={label}>
    <a
      class:list={['blog-pagination__direction', currentPage === 1 && 'is-disabled']}
      href={currentPage > 1 ? hrefForPage(currentPage - 1) : undefined}
      aria-disabled={currentPage === 1 ? 'true' : undefined}
      tabindex={currentPage === 1 ? -1 : undefined}
    >
      <span aria-hidden="true">&larr;</span> Sebelumnya
    </a>
    <ol class="blog-pagination__pages">
      {pageItems.map((item) => typeof item === 'number' ? (
        <li>
          <a
            href={hrefForPage(item)}
            aria-current={item === currentPage ? 'page' : undefined}
            aria-label={`Halaman ${item}`}
          >{item}</a>
        </li>
      ) : <li class="blog-pagination__ellipsis" aria-hidden="true">&hellip;</li>)}
    </ol>
    <a
      class:list={['blog-pagination__direction', currentPage === totalPages && 'is-disabled']}
      href={currentPage < totalPages ? hrefForPage(currentPage + 1) : undefined}
      aria-disabled={currentPage === totalPages ? 'true' : undefined}
      tabindex={currentPage === totalPages ? -1 : undefined}
    >
      Berikutnya <span aria-hidden="true">&rarr;</span>
    </a>
  </nav>
)}

<style>
  .blog-pagination{display:grid;grid-template-columns:auto 1fr auto;gap:18px;align-items:center;margin-top:clamp(42px,6vw,72px);padding-top:22px;border-top:1px solid var(--ink)}
  .blog-pagination__direction{display:flex;min-height:44px;align-items:center;gap:8px;color:var(--ink);font-size:.8rem;font-weight:800;text-decoration:none}.blog-pagination__direction:last-child{justify-self:end}.blog-pagination__direction:is(:hover,:focus-visible){color:var(--teal)}.blog-pagination__direction.is-disabled{color:var(--ink-40);pointer-events:none}
  .blog-pagination__pages{display:flex;justify-content:center;gap:8px;margin:0;padding:0;list-style:none}.blog-pagination__pages a,.blog-pagination__ellipsis{display:grid;width:40px;min-height:40px;place-items:center}.blog-pagination__pages a{border:1px solid var(--ink-20);color:var(--ink);font-weight:800;text-decoration:none}.blog-pagination__pages a:is(:hover,:focus-visible){border-color:var(--teal);color:var(--teal)}.blog-pagination__pages a[aria-current='page']{background:var(--ink);color:var(--white)}
  @media(max-width:740px){.blog-pagination{grid-template-columns:1fr 1fr}.blog-pagination__pages{grid-column:1/-1}.blog-pagination__direction:last-child{grid-column:2}}
</style>

---
import MarketingDashboardCanvas from '../MarketingDashboardCanvas.astro';
import { getProductMarketingDashboardContext } from '../../data/marketingDashboardContexts';

interface Props {
  slug?: string;
  title?: string;
  question?: string;
}

const {
  slug = 'hub',
  title = 'RAMUNI',
  question = 'Apa yang perlu diperhatikan hari ini?',
} = Astro.props;

const isHub = slug === 'hub';
const dashboardContext = getProductMarketingDashboardContext(slug);
---

{isHub ? (
  <div class="product-canvas product-canvas--hub-proof" aria-label="Contoh ruang kerja RAMUNI">
    <MarketingDashboardCanvas context={dashboardContext} priority />
  </div>
) : (
  <div class="product-canvas product-canvas--detail-proof" aria-label={`Ruang kerja ${title}: ${question}`}>
    <MarketingDashboardCanvas context={dashboardContext} priority />
  </div>
)}

<style>
  .product-canvas{position:relative;min-width:0;margin:0;overflow:hidden}
  .product-canvas--detail-proof{container-type:inline-size}
  .product-canvas--detail-proof :global(.marketing-dashboard){border-color:rgb(11 48 69/.1);box-shadow:none}
  .product-canvas--detail-proof :global(.marketing-dashboard__content){padding:12px}
  .product-canvas--detail-proof :global(.marketing-dashboard__disclosure){display:none}
  .product-canvas--detail-proof :global(.marketing-dashboard__shell){background:var(--white)}
  @media(max-width:740px){.product-canvas{border-radius:16px}}
  @media(prefers-reduced-motion:reduce){.product-canvas *{animation:none!important;transition:none!important}}
</style>

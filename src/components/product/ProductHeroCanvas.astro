---
import DashboardMotion from '../DashboardMotion.astro';
import { getProductDashboardVisual } from '../../data/dashboardVisuals';
import { getProductDriveVisuals } from '../../data/driveVisuals';

interface Props {
  slug?: string;
  title?: string;
  question?: string;
}

const {
  slug = 'hub',
  title = 'RAMUNI',
  question = 'Apa yang perlu diperhatikan hari ini?',
} = Astro.props;

const dashboard = getProductDashboardVisual(slug);
const driveVisual = getProductDriveVisuals(slug).primary;
const focus = ['katalog-produk', 'inventori', 'integrasi'].includes(slug) ? 'operations' : ['penjualan', 'keuangan', 'pelanggan'].includes(slug) ? 'performance' : 'overview';
---

<div class:list={['product-canvas', { 'product-canvas--hub-proof': slug === 'hub', 'product-canvas--detail-proof': slug !== 'hub' }]} aria-label={`Contoh tampilan ruang kerja ${title}: ${question}`}>
  <DashboardMotion
    focus={focus}
    priority
    label={`${driveVisual.alt} Digunakan sebagai contoh cara membaca ${title}.`}
    driveSrc={driveVisual.src}
    driveWidth={driveVisual.width}
    driveHeight={driveVisual.height}
    {...dashboard}
  />
</div>

<style>
  .product-canvas{position:relative;min-width:0;margin:0;overflow:hidden}.product-canvas :global(.dashboard-motion){border-radius:0;box-shadow:none}
  .product-canvas--detail-proof :global(.dashboard-motion){box-shadow:none}
  @media(max-width:740px){.product-canvas{border-radius:16px}}
  @media(prefers-reduced-motion:reduce){.product-canvas *{animation:none!important;transition:none!important}}
</style>

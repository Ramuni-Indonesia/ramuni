---
import MarketingDashboardCanvas from '../MarketingDashboardCanvas.astro';
import { getProductMarketingDashboardContext } from '../../data/marketingDashboardContexts';

interface Props {
  slug?: string;
  title?: string;
  question?: string;
}

const {
  slug = 'hub',
  title = 'RAMUNI',
  question = 'Apa yang perlu diperhatikan hari ini?',
} = Astro.props;

const isHub = slug === 'hub';
const dashboardContext = getProductMarketingDashboardContext(slug);
---

{isHub ? (
  <div class="product-canvas product-canvas--hub-proof" aria-label="Contoh ruang kerja RAMUNI berbasis data rekaan">
    <MarketingDashboardCanvas context={dashboardContext} priority />
  </div>
) : (
  <div class="product-canvas product-canvas--detail-proof" aria-label={`Contoh ruang kerja ${title}: ${question}`}>
    <MarketingDashboardCanvas context={dashboardContext} priority />
  </div>
)}

<style>
  .product-canvas{position:relative;min-width:0;margin:0;overflow:hidden}
  .product-canvas--detail-proof{container-type:inline-size}
  @media(max-width:740px){.product-canvas{border-radius:16px}}
  @media(prefers-reduced-motion:reduce){.product-canvas *{animation:none!important;transition:none!important}}
</style>

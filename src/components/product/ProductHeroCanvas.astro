---
import { getProductDashboardVisual } from '../../data/dashboardVisuals';

interface Props {
  slug?: string;
  title?: string;
  question?: string;
}

type Profile = {
  mode: 'insight' | 'signal' | 'catalog' | 'chart' | 'ledger' | 'balance' | 'timeline' | 'report' | 'flow' | 'hub';
  focus: string;
  insight: string;
  evidence: [string, string][];
  boundary: string;
  series?: number[];
};

const profiles: Record<string, Profile> = {
  hub: {
    mode: 'hub',
    focus: 'Ruang kerja bisnis',
    insight: 'Catatan operasional menjadi konteks yang bisa dibaca bersama.',
    evidence: [['Transaksi', 'Masuk'], ['Stok', 'Terbaca'], ['Kas', 'Terpisah']],
    boundary: 'Setiap temuan tetap perlu ditinjau manusia.',
  },
  'asisten-ai': {
    mode: 'insight',
    focus: 'Pertanyaan hari ini',
    insight: 'Stok produk yang cepat bergerak perlu dicek sebelum jam ramai.',
    evidence: [['Penjualan 7 hari', 'Tersedia'], ['Saldo terakhir', '08.15'], ['Stok fisik', 'Perlu dicek']],
    boundary: 'Asisten membaca dan menjelaskan. Tindakan tetap dilakukan pengguna.',
  },
  'dashboard-bisnis': {
    mode: 'signal',
    focus: 'Prioritas pagi',
    insight: 'Mulai dari perubahan terbesar, lalu buka angka pendukungnya.',
    evidence: [['Stok cepat bergerak', 'Cek'], ['Biaya operasional', 'Buka'], ['Pembayaran tertunda', 'Tinjau']],
    boundary: 'Prioritas harus membawa alasan, periode, dan waktu pembaruan.',
    series: [42, 55, 48, 78, 63, 84, 69],
  },
  'katalog-produk': {
    mode: 'catalog',
    focus: 'Satu identitas produk',
    insight: 'Tiga penulisan dirapikan menjadi satu produk yang dapat ditelusuri.',
    evidence: [['Nama', 'Kopi Susu 250 ml'], ['SKU', 'KS-250'], ['Unit', 'Botol']],
    boundary: 'Produk lama diarsipkan agar riwayat transaksi tidak hilang.',
  },
  penjualan: {
    mode: 'chart',
    focus: 'Perubahan penjualan',
    insight: 'Periksa produk dan waktu yang membentuk perubahan, bukan total saja.',
    evidence: [['Pembanding', 'Hari kerja setara'], ['Pendorong', 'Produk A'], ['Catatan', '2 pembayaran']],
    boundary: 'Angka pada visual ini adalah contoh sintetis, bukan hasil usaha nyata.',
    series: [35, 52, 44, 72, 58, 86, 66],
  },
  inventori: {
    mode: 'ledger',
    focus: 'Saldo dan gerak stok',
    insight: 'Saldo mendekati batas perhatian. Cek fisik sebelum isi ulang.',
    evidence: [['Saldo contoh', '18 unit'], ['Batas perhatian', '20 unit'], ['Laju 7 hari', '34 unit']],
    boundary: 'Batas minimum adalah tanda untuk memeriksa, bukan pesanan otomatis.',
  },
  keuangan: {
    mode: 'balance',
    focus: 'Arah uang',
    insight: 'Omzet, laba, dan kas perlu dibaca dengan definisi yang berbeda.',
    evidence: [['Uang masuk', 'Diterima'], ['Biaya', 'Dikelompokkan'], ['Tertunda', 'Perlu diperiksa']],
    boundary: 'Ringkasan ini bersifat operasional, bukan nasihat akuntansi atau pajak.',
    series: [68, 45, 74, 52, 81, 63, 77],
  },
  pelanggan: {
    mode: 'timeline',
    focus: 'Riwayat dan izin',
    insight: 'Pola pembelian memberi konteks. Izin menentukan tindak lanjut.',
    evidence: [['Pembelian terakhir', '18 Juni'], ['Frekuensi contoh', '3 kali'], ['Kanal izin', 'Perlu dicek']],
    boundary: 'Tidak ada pesan otomatis tanpa persetujuan dan kontrol manusia.',
  },
  'laporan-insight': {
    mode: 'report',
    focus: 'Laporan mingguan',
    insight: 'Satu periode, satu rumus, dan tindak lanjut yang memiliki pemilik.',
    evidence: [['Perubahan utama', 'Ada bukti'], ['Catatan bahasan', '2 item'], ['Pemilik aksi', 'Ditentukan']],
    boundary: 'Ekspor dan pengiriman terjadwal belum dinyatakan tersedia.',
  },
  integrasi: {
    mode: 'flow',
    focus: 'Jalur data',
    insight: 'File masuk, diperiksa, lalu dipakai setelah baris bermasalah dibenahi.',
    evidence: [['Format', 'CSV'], ['Siap masuk', '124 baris'], ['Perlu dibenahi', '4 baris']],
    boundary: 'Impor file tidak ditampilkan seolah koneksi langsung.',
  },
};

const { slug = 'hub', title = 'Produk RAMUNI', question = 'Apa yang perlu diperhatikan?' } = Astro.props;
const profile = profiles[slug] ?? profiles.hub;
const dashboardVisual = getProductDashboardVisual(slug);
const series = profile.series ?? [28, 44, 36, 68, 52, 76, 62];
const uid = `product-canvas-${slug}`;
---

<figure class={`product-canvas product-canvas--${profile.mode}`} data-product-canvas id={uid} aria-label={`Visual interaktif ${title} dengan data contoh`}>
  <figcaption class="product-canvas__bar">
    <span class="product-canvas__brand"><i aria-hidden="true"></i> Preview dashboard RAMUNI</span>
    <span>Simulasi dengan data contoh</span>
  </figcaption>

  <div class="product-canvas__stage">
    <nav class="product-canvas__tabs" aria-label="Tampilan contoh produk">
      <button type="button" class="is-active" data-canvas-tab="overview" aria-pressed="true">Ringkasan</button>
      <button type="button" data-canvas-tab="evidence" aria-pressed="false">Bukti</button>
      <button type="button" data-canvas-tab="boundary" aria-pressed="false">Batas</button>
    </nav>

    <section class="product-canvas__panel is-active" data-canvas-panel="overview" aria-label="Ringkasan contoh">
      {dashboardVisual ? (
        <div class="product-canvas__image-preview">
          <picture>
            {'mobileSrc' in dashboardVisual && <source media="(max-width: 620px)" srcset={dashboardVisual.mobileSrc} width={dashboardVisual.mobileWidth} height={dashboardVisual.mobileHeight} />}
            <img src={dashboardVisual.src} width={dashboardVisual.width} height={dashboardVisual.height} alt={dashboardVisual.alt} decoding="async" fetchpriority="high" />
          </picture>
          <span>{dashboardVisual.badge}</span>
        </div>
      ) : (<>
      <div class="product-canvas__question">
        <small>{profile.focus}</small>
        <strong>{question}</strong>
      </div>

      {profile.mode === 'hub' ? (
        <div class="product-canvas__hub-map" aria-label="Alur data usaha">
          <div class="product-canvas__hub-source"><span>Catat</span><strong>Operasional</strong></div>
          <div class="product-canvas__hub-core"><span>RAMUNI</span><strong>Baca konteks</strong></div>
          <div class="product-canvas__hub-result"><span>Tinjau</span><strong>Arah berikutnya</strong></div>
        </div>
      ) : profile.mode === 'chart' || profile.mode === 'signal' || profile.mode === 'balance' ? (
        <div class="product-canvas__chart" aria-label="Grafik data sintetis">
          <div class="product-canvas__bars">
            {series.map((value, index) => <i style={`--value:${value}%;--i:${index}`}><span>{index + 1}</span></i>)}
          </div>
          <div class="product-canvas__chart-note"><span>Temuan contoh</span><strong>{profile.insight}</strong></div>
        </div>
      ) : profile.mode === 'flow' || profile.mode === 'catalog' ? (
        <div class="product-canvas__flow" aria-label="Alur pemeriksaan data contoh">
          <div><small>Masuk</small><strong>{profile.evidence[0][1]}</strong></div>
          <span aria-hidden="true"><i></i><i></i><i></i></span>
          <div class="is-focus"><small>Diperiksa</small><strong>{profile.evidence[1][1]}</strong></div>
          <span aria-hidden="true"><i></i><i></i><i></i></span>
          <div><small>Hasil</small><strong>{profile.evidence[2][1]}</strong></div>
        </div>
      ) : profile.mode === 'timeline' || profile.mode === 'ledger' ? (
        <div class="product-canvas__timeline" aria-label="Urutan catatan contoh">
          {profile.evidence.map(([label, value], index) => <div class:list={[index < 2 && 'is-done']}><i></i><span>{label}</span><strong>{value}</strong></div>)}
        </div>
      ) : (
        <div class="product-canvas__insight">
          <div><small>Jawaban ringkas</small><strong>{profile.insight}</strong></div>
          <span>Periksa bukti sebelum bertindak</span>
        </div>
      )}
      </>)}
    </section>

    <section class="product-canvas__panel" data-canvas-panel="evidence" aria-label="Bukti contoh" hidden>
      <div class="product-canvas__evidence">
        <header><small>Jejak yang dibaca</small><strong>Bukan angka tanpa asal.</strong></header>
        <ol>{profile.evidence.map(([label, value], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{label}</strong><em>{value}</em></li>)}</ol>
      </div>
    </section>

    <section class="product-canvas__panel" data-canvas-panel="boundary" aria-label="Batas contoh" hidden>
      <div class="product-canvas__boundary">
        <span aria-hidden="true">!</span>
        <div><small>Sebelum dipakai</small><strong>{profile.boundary}</strong><p>Periode, sumber, dan status data tetap terlihat.</p></div>
      </div>
    </section>
  </div>

  <footer class="product-canvas__status">
    <span><i aria-hidden="true"></i> Sumber terlihat</span>
    <span>Waktu pembaruan dicatat</span>
    <strong>{dashboardVisual?.type === 'product-screenshot' ? 'Produk nyata · data demo' : 'Contoh sintetis'}</strong>
  </footer>
</figure>

<script>
  const bindProductCanvases = () => {
    document.querySelectorAll<HTMLElement>('[data-product-canvas]').forEach((canvas) => {
      if (canvas.dataset.bound === 'true') return;
      canvas.dataset.bound = 'true';
      const tabs = [...canvas.querySelectorAll<HTMLButtonElement>('[data-canvas-tab]')];
      const panels = [...canvas.querySelectorAll<HTMLElement>('[data-canvas-panel]')];
      tabs.forEach((tab) => tab.addEventListener('click', () => {
        const target = tab.dataset.canvasTab;
        tabs.forEach((item) => {
          const active = item === tab;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        panels.forEach((panel) => {
          const active = panel.dataset.canvasPanel === target;
          panel.hidden = !active;
          panel.classList.toggle('is-active', active);
        });
      }));
    });
  };
  bindProductCanvases();
  document.addEventListener('astro:page-load', bindProductCanvases);
</script>

<style>
  .product-canvas{position:relative;min-width:0;margin:0;border:1px solid var(--ink);border-radius:var(--radius);overflow:hidden;background:var(--white);box-shadow:14px 14px 0 var(--ink);isolation:isolate}
  .product-canvas::before{content:"";position:absolute;inset:42px 0 38px;background-image:linear-gradient(var(--ink-10) 1px,transparent 1px),linear-gradient(90deg,var(--ink-10) 1px,transparent 1px);background-size:38px 38px;mask-image:linear-gradient(to bottom,transparent,#000 18%,#000 82%,transparent);pointer-events:none}
  .product-canvas__bar,.product-canvas__status{position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:12px 16px;background:var(--white);font-size:.62rem;font-weight:800;letter-spacing:.035em}
  .product-canvas__bar{border-bottom:1px solid var(--ink-10)}.product-canvas__brand{display:flex;align-items:center;gap:8px}.product-canvas__brand i,.product-canvas__status i{width:8px;height:8px;border-radius:50%;background:var(--teal);box-shadow:0 0 0 4px var(--teal-12)}
  .product-canvas__stage{position:relative;z-index:1;min-height:500px;padding:18px;background:linear-gradient(135deg,rgb(255 255 255/.9),rgb(244 236 216/.76))}
  .product-canvas__tabs{display:flex;width:max-content;max-width:100%;gap:4px;padding:4px;border:1px solid var(--ink-10);border-radius:999px;background:rgb(255 255 255/.88)}
  .product-canvas__tabs button{min-height:34px;border:0;border-radius:999px;padding:7px 13px;background:transparent;color:var(--ink-72);font:inherit;font-size:.67rem;font-weight:800;cursor:pointer}.product-canvas__tabs button.is-active{background:var(--ink);color:var(--white)}
  .product-canvas__panel{min-height:420px;padding:clamp(24px,4vw,44px)}.product-canvas__panel[hidden]{display:none}.product-canvas__panel.is-active{display:grid;align-content:center;animation:canvas-panel-in .42s var(--ease) both}
  .product-canvas__image-preview{position:relative;min-width:0;border:1px solid var(--ink-10);background:var(--rice);overflow:hidden}.product-canvas__image-preview picture{display:block}.product-canvas__image-preview img{display:block;width:100%;height:auto;object-fit:cover;object-position:top}.product-canvas__image-preview span{position:absolute;left:14px;bottom:14px;padding:8px 10px;background:rgb(11 48 69/.9);color:var(--white);font-size:.62rem;font-weight:800}
  .product-canvas__question{display:grid;gap:8px;max-width:72%;margin-bottom:28px}.product-canvas__question small,.product-canvas__insight small,.product-canvas__flow small,.product-canvas__evidence small,.product-canvas__boundary small{color:var(--teal);font-size:.65rem;font-weight:800}.product-canvas__question strong{font-size:clamp(1.1rem,2.2vw,1.65rem);line-height:1.25}
  .product-canvas__chart{display:grid;grid-template-columns:1.35fr .65fr;gap:18px;align-items:stretch}.product-canvas__bars{display:flex;align-items:end;gap:9px;height:220px;border-left:1px solid var(--ink);border-bottom:1px solid var(--ink);padding:18px 18px 0}.product-canvas__bars i{position:relative;flex:1;height:var(--value);background:var(--teal);transform-origin:bottom}.product-canvas__bars i:nth-last-child(2){background:var(--yellow)}.product-canvas__bars span{position:absolute;left:50%;bottom:-20px;transform:translateX(-50%);font-size:.55rem;font-style:normal}.product-canvas__chart-note{display:flex;flex-direction:column;justify-content:flex-end;padding:20px;background:var(--ink);color:var(--white)}.product-canvas__chart-note span{color:var(--yellow);font-size:.63rem;font-weight:800}.product-canvas__chart-note strong{margin-top:16px;font-size:clamp(1rem,1.8vw,1.35rem);line-height:1.35}
  .product-canvas__flow,.product-canvas__hub-map{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:12px;align-items:center}.product-canvas__flow>div,.product-canvas__hub-map>div{display:flex;min-height:150px;flex-direction:column;justify-content:flex-end;border:1px solid var(--ink);padding:18px;background:var(--white)}.product-canvas__flow>div.is-focus,.product-canvas__hub-core{background:var(--yellow)!important}.product-canvas__flow>span{display:flex;gap:4px}.product-canvas__flow>span i{width:5px;height:5px;border-radius:50%;background:var(--teal)}.product-canvas__flow strong,.product-canvas__hub-map strong{margin-top:8px;font-size:1rem}.product-canvas__hub-map{grid-template-columns:1fr 1.2fr 1fr}.product-canvas__hub-source{transform:translateY(26px)}.product-canvas__hub-result{transform:translateY(-24px)}.product-canvas__hub-map>div span{color:var(--teal);font-size:.64rem;font-weight:800}
  .product-canvas__timeline{display:grid;grid-template-columns:repeat(3,1fr);padding-block:48px}.product-canvas__timeline>div{position:relative;display:grid;gap:9px;text-align:center}.product-canvas__timeline>div::after{content:"";position:absolute;top:8px;left:50%;width:100%;height:2px;background:var(--ink-20)}.product-canvas__timeline>div:last-child::after{content:none}.product-canvas__timeline i{position:relative;z-index:1;justify-self:center;width:18px;height:18px;border:3px solid var(--ink);border-radius:50%;background:var(--white)}.product-canvas__timeline .is-done i{background:var(--yellow)}.product-canvas__timeline span{color:var(--ink-72);font-size:.66rem}.product-canvas__timeline strong{font-size:.86rem}
  .product-canvas__insight{display:grid;grid-template-columns:1.35fr .65fr;min-height:235px;border:1px solid var(--ink)}.product-canvas__insight>div{display:flex;flex-direction:column;justify-content:flex-end;padding:clamp(22px,4vw,38px);background:var(--ink);color:var(--white)}.product-canvas__insight strong{max-width:22ch;margin-top:20px;font-size:clamp(1.35rem,2.7vw,2.25rem);line-height:1.2}.product-canvas__insight>span{display:flex;align-items:flex-end;padding:24px;background:var(--yellow);font-size:.72rem;font-weight:800}
  .product-canvas__evidence{display:grid;grid-template-columns:.72fr 1.28fr;gap:32px;align-items:start}.product-canvas__evidence header{display:grid;gap:12px}.product-canvas__evidence header strong{font-size:clamp(1.5rem,3vw,2.7rem);line-height:1.05}.product-canvas__evidence ol{list-style:none;margin:0;padding:0;border-top:1px solid var(--ink)}.product-canvas__evidence li{display:grid;grid-template-columns:34px 1fr auto;gap:12px;padding:20px 0;border-bottom:1px solid var(--ink-10);font-size:.75rem}.product-canvas__evidence li span{color:var(--teal);font-size:.62rem}.product-canvas__evidence li em{color:var(--ink-72);font-style:normal}
  .product-canvas__boundary{display:grid;grid-template-columns:auto 1fr;gap:28px;align-items:center;max-width:620px;margin:auto}.product-canvas__boundary>span{display:grid;place-items:center;width:112px;height:112px;border:1px solid var(--ink);border-radius:50%;background:var(--yellow);font-size:3.5rem;font-weight:800}.product-canvas__boundary>div{display:grid;gap:13px}.product-canvas__boundary strong{font-size:clamp(1.2rem,2.4vw,2rem);line-height:1.25}.product-canvas__boundary p{color:var(--ink-72)}
  .product-canvas__status{border-top:1px solid var(--ink-10);color:var(--ink-72)}.product-canvas__status span:first-child{display:flex;align-items:center;gap:8px}.product-canvas__status strong{color:var(--teal)}
  @media(prefers-reduced-motion:no-preference) and (min-width:1201px) and (hover:hover) and (pointer:fine){.product-canvas__bars i{animation:canvas-grow .7s calc(var(--i)*60ms + 180ms) var(--ease) both}.product-canvas__flow>span i{animation:canvas-dot 1.8s calc(var(--i,0)*120ms) ease-in-out infinite}.product-canvas__hub-map>div{animation:canvas-float 4.5s ease-in-out infinite}.product-canvas__hub-map>div:nth-child(2){animation-delay:-1.5s}.product-canvas__hub-map>div:nth-child(3){animation-delay:-3s}@keyframes canvas-panel-in{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}@keyframes canvas-grow{from{transform:scaleY(0)}to{transform:none}}@keyframes canvas-dot{50%{opacity:.25;transform:scale(.65)}}@keyframes canvas-float{50%{translate:0 -7px}}}
  @media(max-width:740px){.product-canvas{box-shadow:7px 7px 0 var(--ink)}.product-canvas__stage{min-height:450px;padding:12px}.product-canvas__panel{min-height:370px;padding:28px 10px}.product-canvas__question{max-width:100%}.product-canvas__chart,.product-canvas__insight,.product-canvas__evidence{grid-template-columns:1fr}.product-canvas__chart-note{min-height:130px}.product-canvas__flow{grid-template-columns:1fr}.product-canvas__flow>span{justify-content:center;transform:rotate(90deg)}.product-canvas__flow>div{min-height:90px}.product-canvas__hub-map{grid-template-columns:1fr}.product-canvas__hub-map>div{min-height:90px;transform:none}.product-canvas__evidence li{grid-template-columns:28px 1fr}.product-canvas__evidence li em{grid-column:2}.product-canvas__boundary{grid-template-columns:1fr}.product-canvas__boundary>span{width:72px;height:72px;font-size:2rem}.product-canvas__status span:nth-child(2){display:none}}
  @media(max-width:390px){.product-canvas__bar>span:last-child{display:none}.product-canvas__tabs{width:100%}.product-canvas__tabs button{flex:1;padding-inline:8px}.product-canvas__bars{gap:5px;padding-inline:10px}.product-canvas__status{font-size:.56rem}}
  @media(prefers-reduced-motion:reduce){.product-canvas *{animation:none!important;transition:none!important}}
</style>

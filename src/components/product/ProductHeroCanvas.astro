---
import { dashboardVisuals, getProductDashboardVisual } from '../../data/dashboardVisuals';

interface Props {
  slug?: string;
  title?: string;
  question?: string;
}

const {
  slug = 'hub',
  title = 'RAMUNI',
  question = 'Apa yang perlu diperhatikan hari ini?',
} = Astro.props;

const dashboardVisual = getProductDashboardVisual(slug);
const isHub = slug === 'hub';
const hubFrames = [
  dashboardVisuals.productOverview,
  dashboardVisuals.productPerformance,
  dashboardVisuals.productOperations,
];
---

{isHub ? (
  <figure class="product-canvas product-canvas--hub-proof" aria-label="Tiga tampilan dashboard RAMUNI dengan data demo">
    <figcaption class="product-canvas__caption">
      <span><i aria-hidden="true"></i> Tampilan produk RAMUNI</span>
      <strong>Data demo, bukan akun pelanggan</strong>
    </figcaption>
    <div class="product-canvas__hub-media">
      {hubFrames.map((frame, index) => (
        <img
          class={`product-canvas__hub-frame product-canvas__hub-frame--${index + 1}`}
          src={frame.src}
          width={frame.width}
          height={frame.height}
          alt={index === 0 ? frame.alt : ''}
          decoding="async"
          fetchpriority={index === 0 ? 'high' : undefined}
        />
      ))}
    </div>
    <div class="product-canvas__hub-reading" aria-label="Cara membaca tampilan produk">
      <span><b>01</b><strong>Ringkasan</strong><small>Lihat kondisi utama tanpa membuka semua menu.</small></span>
      <span><b>02</b><strong>Perubahan</strong><small>Buka angka yang bergerak pada periode yang sama.</small></span>
      <span><b>03</b><strong>Sumber</strong><small>Kembali ke catatan sebelum menentukan tindakan.</small></span>
    </div>
  </figure>
) : (
  <figure class="product-canvas product-canvas--detail-proof">
    <figcaption class="product-canvas__caption">
      <span><i aria-hidden="true"></i> Dashboard RAMUNI</span>
      <strong>{dashboardVisual.badge}</strong>
    </figcaption>
    <picture class="product-canvas__detail-media">
      {'mobileSrc' in dashboardVisual && <source media="(max-width: 620px)" srcset={dashboardVisual.mobileSrc} width={dashboardVisual.mobileWidth} height={dashboardVisual.mobileHeight} />}
      <img src={dashboardVisual.src} width={dashboardVisual.width} height={dashboardVisual.height} alt={dashboardVisual.alt} decoding="async" fetchpriority="high" />
    </picture>
    <div class="product-canvas__detail-reading">
      <span>Pertanyaan yang dibantu</span>
      <strong>{question}</strong>
      <small>Tampilan ini memperlihatkan dashboard RAMUNI secara umum. Data di layar adalah fixture pengujian, bukan data pelanggan atau bukti bahwa seluruh fitur {title} sudah tersedia.</small>
    </div>
  </figure>
)}

<style>
  .product-canvas{position:relative;min-width:0;margin:0;background:var(--white);overflow:hidden}
  .product-canvas__caption{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:13px 18px;border-bottom:1px solid var(--ink-10);background:var(--ink);color:var(--white);font-size:.66rem;letter-spacing:.04em}
  .product-canvas__caption span{display:flex;align-items:center;gap:9px;font-weight:800}.product-canvas__caption i{width:8px;height:8px;border-radius:50%;background:var(--yellow)}.product-canvas__caption strong{color:rgb(255 255 255/.66);font-size:inherit}
  .product-canvas--hub-proof{border:0;box-shadow:none;background:var(--ink)}
  .product-canvas__hub-media{position:relative;aspect-ratio:1280/618;overflow:hidden;background:var(--rice)}
  .product-canvas__hub-frame{position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:contain;object-position:top center;opacity:0;transform:translate3d(0,10px,0) scale(1.012)}
  .product-canvas__hub-frame--1{opacity:1;transform:none}
  .product-canvas__hub-reading{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));background:var(--white);color:var(--ink)}
  .product-canvas__hub-reading>span{display:grid;grid-template-columns:auto 1fr;gap:5px 12px;min-width:0;padding:17px 20px;border-right:1px solid var(--ink-10)}
  .product-canvas__hub-reading>span:last-child{border-right:0}.product-canvas__hub-reading b{grid-row:1/3;color:var(--teal);font-size:.65rem}.product-canvas__hub-reading strong{font-size:.8rem}.product-canvas__hub-reading small{color:var(--ink-72);font-size:.68rem;line-height:1.45}
  .product-canvas--detail-proof{border:1px solid rgb(11 48 69/.16);border-radius:22px;box-shadow:0 24px 58px rgb(11 48 69/.14)}
  .product-canvas__detail-media{display:block;aspect-ratio:1280/650;background:var(--rice);overflow:hidden}.product-canvas__detail-media img{display:block;width:100%;height:100%;object-fit:contain;object-position:top center}
  .product-canvas__detail-reading{display:grid;grid-template-columns:auto minmax(160px,.8fr) minmax(240px,1.2fr);gap:12px 20px;align-items:start;padding:14px 17px;border-top:1px solid var(--ink-10)}
  .product-canvas__detail-reading span{color:var(--teal);font-size:.56rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.product-canvas__detail-reading strong{font-size:.7rem;line-height:1.45}.product-canvas__detail-reading small{color:var(--ink-56);font-size:.58rem;line-height:1.45}
  @media(prefers-reduced-motion:no-preference){
    .product-canvas__hub-frame--1{animation:product-hub-frame-1 13s cubic-bezier(.22,1,.36,1) infinite}
    .product-canvas__hub-frame--2{animation:product-hub-frame-2 13s cubic-bezier(.22,1,.36,1) infinite}
    .product-canvas__hub-frame--3{animation:product-hub-frame-3 13s cubic-bezier(.22,1,.36,1) infinite}
    @keyframes product-hub-frame-1{0%,30%{opacity:1;transform:none}36%,94%{opacity:0;transform:translate3d(-10px,0,0) scale(1.01)}100%{opacity:1;transform:none}}
    @keyframes product-hub-frame-2{0%,30%,68%,100%{opacity:0;transform:translate3d(10px,10px,0) scale(1.012)}38%,62%{opacity:1;transform:none}}
    @keyframes product-hub-frame-3{0%,62%,100%{opacity:0;transform:translate3d(10px,10px,0) scale(1.012)}70%,94%{opacity:1;transform:none}}
  }
  @media(max-width:740px){
    .product-canvas--detail-proof{border-radius:16px;box-shadow:0 18px 38px rgb(11 48 69/.13)}
    .product-canvas__caption strong{display:none}
    .product-canvas__hub-reading{grid-template-columns:1fr}.product-canvas__hub-reading>span{border-right:0;border-bottom:1px solid var(--ink-10)}.product-canvas__hub-reading>span:last-child{border-bottom:0}
    .product-canvas__detail-media{aspect-ratio:4/3}.product-canvas__detail-reading{grid-template-columns:1fr;gap:6px;padding:13px 14px}
  }
  @media(prefers-reduced-motion:reduce){.product-canvas *{animation:none!important;transition:none!important}.product-canvas__hub-frame:not(.product-canvas__hub-frame--1){display:none}}
</style>

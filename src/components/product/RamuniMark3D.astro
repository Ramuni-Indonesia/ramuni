<div id="ramuni-direction-model" class="ramuni-mark-3d" data-ramuni-mark-3d>
  <img class="ramuni-mark-3d__poster" src="/brand/ramuni-mark-color.webp" width="1024" height="1024" alt="" aria-hidden="true" decoding="async" />
  <canvas aria-label="Model 3D interaktif simbol arah RAMUNI"></canvas>
  <noscript><img src="/brand/ramuni-mark-color.webp" width="1024" height="1024" alt="Simbol arah RAMUNI" /></noscript>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-ramuni-mark-3d]').forEach((host) => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = Boolean((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData);
    if (reducedMotion || saveData) {
      host.dataset.modelState = 'fallback';
      return;
    }
    let requested = false;
    const loadModel = async () => {
      if (requested) return;
      requested = true;
      host.dataset.modelState = 'loading';
      try {
        const { initRamuniMark3D } = await import('../../three/initRamuniMark3D');
        initRamuniMark3D(host);
      } catch {
        host.dataset.modelState = 'fallback';
      }
    };
    if (!('IntersectionObserver' in window)) {
      void loadModel();
      return;
    }
    const loaderObserver = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      loaderObserver.disconnect();
      void loadModel();
    }, { rootMargin: '240px 0px' });
    loaderObserver.observe(host);
  });
</script>

<style>
  .ramuni-mark-3d{position:relative;min-height:360px;overflow:hidden;border:1px solid rgb(255 255 255/.24);background:radial-gradient(circle at 72% 22%,rgb(242 177 52/.28),transparent 34%),linear-gradient(145deg,#f8f6ef 0%,#e7f1ef 100%)}
  .ramuni-mark-3d::after{content:"";position:absolute;inset:18px;border:1px solid rgb(11 48 69/.12);pointer-events:none}
  .ramuni-mark-3d canvas{position:relative;z-index:2;display:block;width:100%;height:100%;min-height:360px;cursor:grab;touch-action:pan-y;opacity:0;transition:opacity .45s ease}
  .ramuni-mark-3d[data-model-state="ready"] canvas{opacity:1}
  .ramuni-mark-3d__poster{position:absolute;z-index:1;inset:9% 13%;width:74%;height:82%;object-fit:contain;opacity:.92;transition:opacity .32s ease,transform .55s cubic-bezier(.16,1,.3,1);filter:drop-shadow(0 24px 24px rgb(11 48 69/.16))}
  .ramuni-mark-3d[data-model-state="loading"] .ramuni-mark-3d__poster{transform:scale(.97)}
  .ramuni-mark-3d[data-model-state="ready"] .ramuni-mark-3d__poster{opacity:0;transform:scale(.96);pointer-events:none}
  .ramuni-mark-3d noscript img{width:100%;height:100%;object-fit:contain;padding:40px}
  @media(max-width:740px){.ramuni-mark-3d,.ramuni-mark-3d canvas{min-height:300px}}
  @media(prefers-reduced-motion:reduce){.ramuni-mark-3d canvas{cursor:default;transition:none}.ramuni-mark-3d__poster{transition:none}}
</style>

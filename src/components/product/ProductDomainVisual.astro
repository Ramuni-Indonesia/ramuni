---
import { getProductContextVisual } from '../../data/dashboardVisuals';

interface Props {
  slug: string;
  title: string;
  question: string;
}

const { slug, title, question } = Astro.props;
const visual = getProductContextVisual(slug);
---

<figure class={`pd-visual pd-visual--${slug} reveal`} aria-label={`Konteks visual untuk ${title}`}>
  <figcaption>
    <span>Contoh konteks</span>
    <strong>{question}</strong>
  </figcaption>
  <div class="pd-visual__image-wrap">
    <img src={visual.src} width={visual.width} height={visual.height} alt={visual.alt} loading="lazy" decoding="async" />
    <span class="pd-visual__image-note">Ilustrasi konteks · bukan data usaha tertentu</span>
  </div>
</figure>

<style>
  .pd-visual{position:relative;min-width:0;margin:0;width:min(100%,980px);justify-self:center;overflow:hidden;border:1px solid var(--ink);border-radius:var(--radius);background:var(--white);box-shadow:12px 12px 0 var(--ink)}
  .pd-visual>figcaption{display:grid;grid-template-columns:auto minmax(0,1fr);gap:16px;align-items:center;padding:14px 18px;border-bottom:1px solid var(--ink-10)}
  .pd-visual>figcaption span{color:var(--teal);font-size:.62rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em}
  .pd-visual>figcaption strong{min-width:0;font-size:.76rem;line-height:1.4;text-align:right}
  .pd-visual__image-wrap{position:relative;min-height:350px;background:var(--rice);overflow:hidden}
  .pd-visual__image-wrap img{display:block;width:100%;height:100%;min-height:350px;object-fit:cover;object-position:center}
  .pd-visual__image-note{position:absolute;left:16px;bottom:16px;padding:7px 10px;background:rgb(11 48 69/.86);color:var(--white);font-size:.62rem;font-weight:700;letter-spacing:.03em}
  @media(max-width:640px){.pd-visual{border-radius:16px;box-shadow:7px 7px 0 var(--ink)}.pd-visual>figcaption{grid-template-columns:1fr;gap:6px;padding:13px 14px}.pd-visual>figcaption strong{text-align:left;font-size:.72rem}.pd-visual__image-wrap,.pd-visual__image-wrap img{min-height:250px}.pd-visual__image-note{left:11px;bottom:11px;font-size:.55rem}}
  @media(prefers-reduced-motion:reduce){.pd-visual *{animation:none!important;transition:none!important}}
</style>

---
import { dashboardVisuals } from '../../data/dashboardVisuals';

interface Props {
  slug: string;
  title: string;
}

const { slug, title } = Astro.props;

const chapters = {
  'asisten-ai': {
    visual: dashboardVisuals.productPerformance,
    eyebrow: 'Dari jawaban ke angka asal',
    heading: 'Ringkasan baru berguna ketika sumbernya bisa dibuka.',
    body: 'Dashboard memberi konteks periode dan perubahan. Asisten membantu menjelaskannya, tetapi angka asal tetap menjadi tempat pemeriksaan.',
    reads: [['Mulai di sini', 'Baca perubahan utama'], ['Lalu buka', 'Periode dan metrik'], ['Sebelum bertindak', 'Periksa catatan asal']],
  },
  'dashboard-bisnis': {
    visual: dashboardVisuals.productOperations,
    eyebrow: 'Satu layar, urutan yang jelas',
    heading: 'Sorotan pagi harus berujung pada pekerjaan yang bisa dibuka.',
    body: 'Ringkasan tidak berhenti pada angka besar. Aktivitas pembayaran, stok, dan biaya memberi jalur untuk menelusuri perubahan yang perlu dibahas.',
    reads: [['Lihat', 'Perubahan terbesar'], ['Telusuri', 'Aktivitas pembentuk'], ['Tandai', 'Pekerjaan hari ini']],
  },
  'katalog-produk': {
    visual: dashboardVisuals.productOverview,
    eyebrow: 'Dampak data yang rapi',
    heading: 'Nama dan satuan yang konsisten membuat ringkasan lebih masuk akal.',
    body: 'Katalog menjadi dasar saat penjualan, stok, dan laporan menyebut produk. Satu identitas mengurangi perbedaan arti di layar berikutnya.',
    reads: [['Samakan', 'Nama dan SKU'], ['Lengkapi', 'Unit, harga, dan HPP'], ['Gunakan', 'Di transaksi dan laporan']],
  },
  penjualan: {
    visual: dashboardVisuals.productOperations,
    eyebrow: 'Dari omzet ke transaksi',
    heading: 'Perubahan penjualan perlu jejak waktu, produk, dan pembayaran.',
    body: 'Aktivitas operasional membantu membedakan transaksi selesai, pembayaran yang perlu dicek, dan produk yang benar-benar membentuk omzet.',
    reads: [['Bandingkan', 'Periode yang setara'], ['Buka', 'Produk dan jam'], ['Periksa', 'Status pembayaran']],
  },
  inventori: {
    visual: dashboardVisuals.productPerformance,
    eyebrow: 'Stok dibaca bersama geraknya',
    heading: 'Saldo hari ini belum cukup untuk menentukan urutan isi ulang.',
    body: 'Penjualan dan pergerakan barang memberi konteks pada sisa stok. Pemeriksaan fisik tetap diperlukan sebelum keputusan pengadaan.',
    reads: [['Baca', 'Saldo terakhir'], ['Bandingkan', 'Laju keluar'], ['Pastikan', 'Stok fisik dan waktu tunggu']],
  },
  keuangan: {
    visual: dashboardVisuals.productOverview,
    eyebrow: 'Angka dengan definisi',
    heading: 'Omzet, laba, dan kas perlu dibaca sebagai tiga hal berbeda.',
    body: 'Ringkasan membantu melihat arah. Definisi, periode, dan transaksi pendukung tetap perlu dibuka sebelum menilai kondisi usaha.',
    reads: [['Pisahkan', 'Penjualan dan biaya'], ['Bandingkan', 'Rumus dan periode'], ['Buka', 'Transaksi pembentuk']],
  },
  pelanggan: {
    visual: dashboardVisuals.productPerformance,
    eyebrow: 'Riwayat sebelum tindak lanjut',
    heading: 'Pola pelanggan dimulai dari transaksi yang memang boleh dipakai.',
    body: 'Frekuensi dan pembelian terakhir memberi konteks. Izin serta kanal yang disetujui tetap menentukan apakah tindak lanjut boleh dilakukan.',
    reads: [['Hubungkan', 'Riwayat pembelian'], ['Kenali', 'Frekuensi dan produk'], ['Hormati', 'Izin dan kanal']],
  },
  'laporan-insight': {
    visual: dashboardVisuals.productOperations,
    eyebrow: 'Laporan yang siap dibahas',
    heading: 'Perubahan, penyebab, dan pemilik tindak lanjut berada dalam satu alur.',
    body: 'Aktivitas harian menjadi dasar ringkasan. Periode dan rumus yang konsisten membuat rapat fokus pada keputusan, bukan menyatukan angka lagi.',
    reads: [['Ringkas', 'Perubahan utama'], ['Sertakan', 'Sumber dan alasan'], ['Tetapkan', 'Pemilik tindak lanjut']],
  },
  integrasi: {
    visual: dashboardVisuals.productOperations,
    eyebrow: 'Data masuk dengan status',
    heading: 'Dashboard hanya dapat dipercaya ketika jalur datanya terlihat.',
    body: 'Waktu pembaruan, baris gagal, dan metode input memberi batas yang jujur sebelum data dipakai untuk membaca kondisi usaha.',
    reads: [['Siapkan', 'Kolom dan format'], ['Periksa', 'Hasil dan baris gagal'], ['Gunakan', 'Setelah statusnya jelas']],
  },
} as const;

const chapter = chapters[slug as keyof typeof chapters] || chapters['dashboard-bisnis'];
---

<section class="pd-dashboard-chapter" aria-labelledby={`product-dashboard-${slug}`}>
  <div class="container pd-dashboard-chapter__layout">
    <header class="pd-dashboard-chapter__intro reveal">
      <span>{chapter.eyebrow}</span>
      <h2 id={`product-dashboard-${slug}`}>{chapter.heading}</h2>
      <p>{chapter.body}</p>
    </header>
    <figure class="pd-dashboard-chapter__proof reveal">
      <div class="pd-dashboard-chapter__label">
        <span><i aria-hidden="true"></i> Dashboard RAMUNI</span>
        <strong>Tampilan produk · data demo</strong>
      </div>
      <picture>
        <source media="(max-width: 620px)" srcset={chapter.visual.mobileSrc} width={chapter.visual.mobileWidth} height={chapter.visual.mobileHeight} />
        <img
          src={chapter.visual.src}
          width={chapter.visual.width}
          height={chapter.visual.height}
          alt={`${chapter.visual.alt} Digunakan sebagai contoh cara membaca ${title}.`}
          loading="lazy"
          decoding="async"
        />
      </picture>
      <figcaption>
        {chapter.reads.map(([verb, object], index) => (
          <span><b>{String(index + 1).padStart(2, '0')}</b><small>{verb}</small><strong>{object}</strong></span>
        ))}
      </figcaption>
    </figure>
    <p class="pd-dashboard-chapter__disclosure">Tampilan memakai fixture pengujian, bukan akun pelanggan. Screenshot ini memperlihatkan dashboard RAMUNI secara umum dan tidak menyatakan seluruh kemampuan {title} sudah tersedia.</p>
  </div>
</section>

<style>
  .pd-dashboard-chapter{padding-block:clamp(72px,9vw,128px);background:var(--white)}
  .pd-dashboard-chapter__layout{display:grid;grid-template-columns:minmax(220px,.46fr) minmax(0,1.54fr);gap:clamp(30px,6vw,88px);align-items:start}
  .pd-dashboard-chapter__intro{position:sticky;top:128px;max-width:430px}
  .pd-dashboard-chapter__intro>span{display:block;color:var(--teal);font-size:.67rem;font-weight:800;text-transform:uppercase;letter-spacing:.09em}
  .pd-dashboard-chapter__intro h2{margin:16px 0 0;max-width:15ch;font-size:clamp(2rem,3.1vw,3.4rem);line-height:1.08;text-wrap:balance}
  .pd-dashboard-chapter__intro p{margin:22px 0 0;max-width:42ch;color:var(--ink-72);line-height:1.75}
  .pd-dashboard-chapter__proof{min-width:0;margin:0;overflow:hidden;border:1px solid var(--ink-10);border-radius:22px;background:var(--rice);box-shadow:0 26px 64px rgb(11 48 69/.12)}
  .pd-dashboard-chapter__label{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:13px 18px;background:var(--ink);color:var(--white);font-size:.66rem;letter-spacing:.04em}
  .pd-dashboard-chapter__label span{display:flex;align-items:center;gap:9px;font-weight:800}.pd-dashboard-chapter__label i{width:8px;height:8px;border-radius:50%;background:var(--yellow)}
  .pd-dashboard-chapter__label strong{color:rgb(255 255 255/.66);font-size:inherit}
  .pd-dashboard-chapter__proof picture{display:block;aspect-ratio:1280/760;overflow:hidden;background:var(--rice)}
  .pd-dashboard-chapter__proof img{display:block;width:100%;height:100%;object-fit:contain;object-position:top center}
  .pd-dashboard-chapter__proof figcaption{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));background:var(--white)}
  .pd-dashboard-chapter__proof figcaption span{display:grid;grid-template-columns:auto 1fr;gap:3px 12px;min-width:0;padding:18px;border-right:1px solid var(--ink-10)}
  .pd-dashboard-chapter__proof figcaption span:last-child{border-right:0}.pd-dashboard-chapter__proof figcaption b{grid-row:1/3;color:var(--teal);font-size:.62rem}
  .pd-dashboard-chapter__proof figcaption small{color:var(--ink-56);font-size:.58rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em}.pd-dashboard-chapter__proof figcaption strong{font-size:.72rem;line-height:1.35}
  .pd-dashboard-chapter__disclosure{grid-column:2;margin:14px 0 0;max-width:82ch;color:var(--ink-56);font-size:.66rem;line-height:1.55}
  @media(max-width:960px){.pd-dashboard-chapter__layout{grid-template-columns:1fr}.pd-dashboard-chapter__intro{position:static;max-width:680px}.pd-dashboard-chapter__intro h2{max-width:18ch}.pd-dashboard-chapter__disclosure{grid-column:auto}}
  @media(max-width:620px){.pd-dashboard-chapter__proof{border-radius:16px}.pd-dashboard-chapter__label strong{display:none}.pd-dashboard-chapter__proof picture{aspect-ratio:4/3}.pd-dashboard-chapter__proof figcaption{grid-template-columns:1fr}.pd-dashboard-chapter__proof figcaption span{border-right:0;border-bottom:1px solid var(--ink-10)}.pd-dashboard-chapter__proof figcaption span:last-child{border-bottom:0}}
  @media(pointer:coarse),(prefers-reduced-motion:reduce){.pd-dashboard-chapter__intro{position:static}}
</style>

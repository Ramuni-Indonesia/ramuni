---
interface CapabilityRow {
  label: string;
  description: string;
  status?: 'Available' | 'Private Beta' | 'Coming Soon';
}

interface SafetyContent {
  heading: string;
  boundary: string;
  checks: string[];
}

interface Props {
  slug: string;
  title: string;
  capabilities: CapabilityRow[];
  safety: SafetyContent;
}

const { slug, title, capabilities, safety } = Astro.props;
const statusLabels: Record<NonNullable<CapabilityRow['status']>, string> = {
  Available: 'Tersedia',
  'Private Beta': 'Beta privat',
  'Coming Soon': 'Segera hadir',
};
const headings: Record<string, string> = {
  'asisten-ai': 'Lihat apa yang dibaca sebelum mengikuti jawaban.',
  'dashboard-bisnis': 'Buka alasan di balik setiap prioritas.',
  'katalog-produk': 'Pastikan satu produk punya satu identitas.',
  penjualan: 'Telusuri perubahan omzet sampai ke transaksinya.',
  inventori: 'Lihat stok mana yang perlu dicek hari ini.',
  keuangan: 'Periksa definisi dan transaksi sebelum menilai kondisi usaha.',
  pelanggan: 'Gunakan riwayat yang relevan sebelum menindaklanjuti pelanggan.',
  'laporan-insight': 'Bawa perubahan, bukti, dan tindak lanjut dalam satu alur.',
  integrasi: 'Periksa format dan hasil validasi sebelum memakai data.',
};
---

{capabilities.length > 0 && <section id="product-capabilities" class="pd-readiness" data-section-id="product-capabilities" data-analytics-id="product_capability_status" aria-labelledby="product-capabilities-title">
  <div class="container pd-readiness__layout">
    <header class="pd-readiness__intro reveal">
      <h2 id="product-capabilities-title">{headings[slug] || `Lihat cara kerja ${title} sebelum mengandalkannya.`}</h2>
      <p>Mulai dari catatan yang terbaca, lalu ikuti alurnya sampai keputusan berikutnya.</p>
    </header>

    <div class="pd-readiness__stage reveal" aria-label={`Alur pemeriksaan kemampuan ${title}`}>
      <ol class="pd-readiness__flow">
        {capabilities.map((capability, index) => (
          <li style={`--i:${index}`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <strong>{capability.label}{capability.status && <small class="pd-readiness__status" data-status={capability.status}>{statusLabels[capability.status]}</small>}</strong>
              <p>{capability.description}</p>
            </div>
          </li>
        ))}
      </ol>

      <aside class="pd-readiness__boundary">
        <div>
          <span>Alur yang dapat ditinjau</span>
          <h3>Setiap langkah membawa alasan dan sumber yang dapat diperiksa.</h3>
          <p>RAMUNI membantu membaca konteks. Anda tetap menentukan tindakan berikutnya.</p>
        </div>
        <ul>
          {safety.checks.map((check) => <li><i aria-hidden="true"></i><span>{check}</span></li>)}
        </ul>
        <a class="text-link" href="/keamanan/">Lihat cara RAMUNI menjaga proses</a>
      </aside>
    </div>
  </div>
</section>}

<style is:inline>
  .pd-readiness__status{display:inline-block;margin-left:8px;color:var(--teal);font-size:.62rem;font-weight:800;letter-spacing:.04em;text-transform:uppercase;vertical-align:middle}
</style>

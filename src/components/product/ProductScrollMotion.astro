<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const desktopMotion = window.matchMedia('(min-width: 1201px) and (hover: hover) and (pointer: fine)');
  const motionRoot = document.querySelector<HTMLElement>('.pd-page, .sd-page, .product-hub');
  let activeContext: { revert: () => void } | undefined;
  let motionLoader: IntersectionObserver | undefined;

  const initialiseMotion = async () => {
    if (reduceMotion.matches || !desktopMotion.matches || !motionRoot || activeContext) return;
    const [{ gsap }, { ScrollTrigger }] = await Promise.all([
      import('gsap'),
      import('gsap/ScrollTrigger'),
    ]);
    if (reduceMotion.matches || !desktopMotion.matches || !motionRoot || activeContext) return;
    gsap.registerPlugin(ScrollTrigger);

    activeContext = gsap.context(() => {
      document.querySelectorAll<HTMLElement>('#product-direction-model [data-decision-flow-3d]').forEach((mark) => {
        gsap.fromTo(mark,
          { autoAlpha: 0.38, y: 54, scale: 0.94, rotateZ: -2 },
          {
            immediateRender: false,
            autoAlpha: 1,
            y: 0,
            scale: 1,
            rotateZ: 0,
            ease: 'none',
            scrollTrigger: {
              trigger: mark,
              start: 'top 92%',
              end: 'bottom 34%',
              scrub: 0.65,
              onUpdate: (self) => {
                mark.dispatchEvent(new CustomEvent('decision-flow-scroll', {
                  detail: { progress: self.progress },
                }));
              },
            },
          },
        );
      });

      document.querySelectorAll<HTMLElement>('.pd-page .product-canvas, .product-catalog .product-canvas').forEach((canvas) => {
        gsap.fromTo(canvas,
          { opacity: 0.78, y: 18 },
          {
            immediateRender: false,
            opacity: 1,
            y: 0,
            duration: 0.62,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: canvas,
              start: 'top 88%',
              once: true,
            },
          },
        );
      });

      document.querySelectorAll<HTMLElement>('.pd-workflow__steps, .product-workflow__rail').forEach((track) => {
        const items = track.querySelectorAll<HTMLElement>('li, article');
        if (!items.length) return;
        gsap.fromTo(items,
          { opacity: 0, y: 22 },
          {
            immediateRender: false,
            opacity: 1,
            y: 0,
            duration: 0.55,
            stagger: 0.08,
            ease: 'power2.out',
            scrollTrigger: { trigger: track, start: 'top 82%', once: true },
          },
        );
      });

      document.querySelectorAll<HTMLElement>('.pd-page > section, .sd-page > section').forEach((section) => {
        const targets = [...section.querySelectorAll<HTMLElement>(
          '.pd-benefit, .pd-related__modules > div > a, .pd-related__paths > a, .sd-symptoms > li, .sd-impact > article, .sd-workflow__step, .sd-capability, .sd-industry-list > a',
        )].filter((target) => !target.classList.contains('reveal'));
        if (!targets.length) return;
        gsap.fromTo(targets,
          { autoAlpha: 0, y: 30 },
          {
            immediateRender: false,
            autoAlpha: 1,
            y: 0,
            duration: 0.72,
            stagger: 0.07,
            ease: 'power3.out',
            scrollTrigger: { trigger: section, start: 'top 78%', once: true },
          },
        );
      });

    });

  };

  const resetMotion = () => {
    motionLoader?.disconnect();
    motionLoader = undefined;
    activeContext?.revert();
    activeContext = undefined;
  };

  const armMotion = () => {
    resetMotion();
    if (reduceMotion.matches || !desktopMotion.matches || !motionRoot) return;
    if (!('IntersectionObserver' in window)) {
      void initialiseMotion();
    } else {
      motionLoader = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        motionLoader?.disconnect();
        motionLoader = undefined;
        void initialiseMotion();
      }, { rootMargin: '120px 0px' });
      motionLoader.observe(motionRoot);
    }
  };

  const handleMotionPreference = () => armMotion();
  reduceMotion.addEventListener('change', handleMotionPreference);
  desktopMotion.addEventListener('change', handleMotionPreference);
  window.addEventListener('pagehide', () => {
    reduceMotion.removeEventListener('change', handleMotionPreference);
    desktopMotion.removeEventListener('change', handleMotionPreference);
    resetMotion();
  }, { once: true });
  armMotion();
</script>

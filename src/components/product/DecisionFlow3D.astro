<div id="ramuni-decision-flow" class="decision-flow-3d" data-decision-flow-3d>
  <img class="decision-flow-3d__poster" src="/website-original/ai-decision-companion.svg" width="1200" height="720" alt="" aria-hidden="true" decoding="async" />
  <canvas aria-label="Sculpture 3D interaktif dari catatan menuju bukti dan arah"></canvas>
  <noscript><img src="/website-original/ai-decision-companion.svg" width="1200" height="720" alt="Ilustrasi alur catatan, bukti, dan keputusan" /></noscript>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-decision-flow-3d]').forEach((host) => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = Boolean((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData);
    if (reducedMotion || saveData) {
      host.dataset.modelState = 'fallback';
      return;
    }
    let requested = false;
    const loadModel = async () => {
      if (requested) return;
      requested = true;
      host.dataset.modelState = 'loading';
      try {
        const { initDecisionFlow3D } = await import('../../three/initDecisionFlow3D');
        initDecisionFlow3D(host);
      } catch {
        host.dataset.modelState = 'fallback';
      }
    };
    if (!('IntersectionObserver' in window)) {
      void loadModel();
      return;
    }
    const loaderObserver = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      loaderObserver.disconnect();
      void loadModel();
    }, { rootMargin: '240px 0px' });
    loaderObserver.observe(host);
    document.addEventListener('astro:before-swap', () => loaderObserver.disconnect(), { once: true });
  });
</script>

<style>
  .decision-flow-3d{position:relative;min-height:360px;overflow:hidden;border:1px solid rgb(255 255 255/.24);background:#f4f0e7}
  .decision-flow-3d::after{content:"";position:absolute;inset:18px;border:1px solid rgb(11 48 69/.12);pointer-events:none}
  .decision-flow-3d canvas{position:relative;z-index:2;display:block;width:100%;height:100%;min-height:360px;cursor:grab;touch-action:pan-y;opacity:0;transition:opacity .45s ease}
  .decision-flow-3d[data-model-state="ready"] canvas{opacity:1}
  .decision-flow-3d__poster{position:absolute;z-index:1;inset:12% 10%;width:80%;height:76%;object-fit:contain;opacity:.9;transition:opacity .32s ease,transform .55s cubic-bezier(.16,1,.3,1)}
  .decision-flow-3d[data-model-state="loading"] .decision-flow-3d__poster{transform:scale(.98)}
  .decision-flow-3d[data-model-state="ready"] .decision-flow-3d__poster{opacity:0;transform:scale(.97);pointer-events:none}
  .decision-flow-3d noscript img{width:100%;height:100%;object-fit:contain;padding:40px}
  @media(max-width:740px){.decision-flow-3d,.decision-flow-3d canvas{min-height:300px}}
  @media(prefers-reduced-motion:reduce){.decision-flow-3d canvas{cursor:default;transition:none}.decision-flow-3d__poster{transition:none}}
</style>

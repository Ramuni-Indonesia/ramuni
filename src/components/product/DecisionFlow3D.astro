---
const stages = [
  {
    key: 'data',
    label: 'Data usaha',
    title: 'Transaksi, stok, biaya, pelanggan',
    note: 'Catatan masuk dengan periode dan sumber yang jelas.',
  },
  {
    key: 'change',
    label: 'Perubahan',
    title: 'Angka dibandingkan',
    note: 'RAMUNI menandai selisih yang layak dibuka lebih dulu.',
  },
  {
    key: 'source',
    label: 'Sumber',
    title: 'Dasar temuan ditampilkan',
    note: 'Pengguna dapat kembali ke catatan yang membentuk ringkasan.',
  },
  {
    key: 'action',
    label: 'Tindakan manusia',
    title: 'Anda memilih langkah',
    note: 'Sistem membantu membaca; keputusan tidak dijalankan otomatis.',
  },
] as const;
---

<div class="decision-path" aria-label="Alur RAMUNI dari data usaha hingga tindakan manusia">
  <ol class="decision-path__steps">
    {stages.map((stage, index) => (
      <li class:list={['decision-path__step', index === stages.length - 1 && 'decision-path__step--human']}>
        <span class="decision-path__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <div class="decision-path__copy">
          <small>{stage.label}</small>
          <strong>{stage.title}</strong>
          <p>{stage.note}</p>
        </div>
        {index < stages.length - 1 && <i class="decision-path__connector" aria-hidden="true"><b></b><b></b><b></b></i>}
      </li>
    ))}
  </ol>
  <p class="decision-path__boundary"><span aria-hidden="true">✓</span> Setiap tahap mempertahankan periode, waktu pembaruan, dan asal data.</p>
</div>

<style>
  .decision-path{min-width:0;border-block:1px solid rgb(11 48 69/.2);background:var(--rice);color:var(--ink)}
  .decision-path__steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;margin:0;padding:0}
  .decision-path__step{position:relative;display:grid;grid-template-rows:auto 1fr;min-width:0;min-height:282px;padding:22px clamp(18px,2.4vw,32px) 28px;border-right:1px solid rgb(11 48 69/.16)}
  .decision-path__step:last-child{border-right:0}
  .decision-path__step--human{background:var(--yellow)}
  .decision-path__index{font-size:.68rem;font-weight:800;letter-spacing:.08em;color:var(--teal)}
  .decision-path__copy{align-self:end;display:grid;gap:10px}
  .decision-path__copy small{font-size:.68rem;font-weight:800;letter-spacing:.07em;text-transform:uppercase;color:var(--teal)}
  .decision-path__copy strong{max-width:17ch;font-size:clamp(1.05rem,1.7vw,1.38rem);line-height:1.22}
  .decision-path__copy p{max-width:30ch;color:var(--ink-72);font-size:.82rem;line-height:1.58}
  .decision-path__connector{position:absolute;z-index:2;top:44px;right:-16px;display:flex;align-items:center;justify-content:center;gap:3px;width:31px;height:31px;border:1px solid var(--ink);border-radius:50%;background:var(--white)}
  .decision-path__connector b{width:3px;height:3px;border-radius:50%;background:var(--teal)}
  .decision-path__boundary{display:flex;align-items:center;gap:10px;margin:0;padding:16px clamp(18px,2.4vw,32px);border-top:1px solid rgb(11 48 69/.16);background:var(--ink);color:rgb(255 255 255/.74);font-size:.76rem;font-weight:700}
  .decision-path__boundary span{display:grid;place-items:center;width:22px;height:22px;border-radius:50%;background:var(--yellow);color:var(--ink);font-size:.72rem}
  @media(prefers-reduced-motion:no-preference) and (min-width:1201px) and (hover:hover) and (pointer:fine){
    .decision-path__connector b{animation:decision-path-pulse 1.8s var(--ease) infinite}
    .decision-path__connector b:nth-child(2){animation-delay:120ms}.decision-path__connector b:nth-child(3){animation-delay:240ms}
    @keyframes decision-path-pulse{0%,60%,100%{opacity:.32;transform:translateX(-2px)}30%{opacity:1;transform:translateX(2px)}}
  }
  @media(max-width:960px){.decision-path__steps{grid-template-columns:repeat(2,minmax(0,1fr))}.decision-path__step:nth-child(2){border-right:0}.decision-path__step:nth-child(-n+2){border-bottom:1px solid rgb(11 48 69/.16)}.decision-path__step:nth-child(2) .decision-path__connector{display:none}}
  @media(max-width:620px){.decision-path__steps{grid-template-columns:1fr}.decision-path__step{grid-template-columns:42px 1fr;grid-template-rows:auto;min-height:0;padding:22px;border-right:0;border-bottom:1px solid rgb(11 48 69/.16)}.decision-path__step:nth-child(n){border-bottom:1px solid rgb(11 48 69/.16)}.decision-path__step:last-child{border-bottom:0}.decision-path__copy{align-self:start}.decision-path__connector{display:none}.decision-path__boundary{align-items:flex-start;line-height:1.5}}
  @media(prefers-reduced-motion:reduce){.decision-path *{animation:none!important;transition:none!important}}
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Item { title: string; text: string; href?: string; }
interface Props { title: string; description: string; eyebrow?: string; items: Item[]; ctaLabel?: string; ctaHref?: string; noindex?: boolean; }
const { title, description, eyebrow, items, ctaLabel = 'Coba Simulasi Gratis', ctaHref = '/tour-produk-gratis/', noindex = false } = Astro.props;
---
<BaseLayout title={title} description={description} noindex={noindex}>
  <section class="policy-hero"><div class="container"><p class="eyebrow">{eyebrow || 'Dokumen RAMUNI'}</p><h1>{title}</h1><p class="lede">{description}</p></div></section>
  <section class="section surface"><div class="container policy-layout"><aside class="policy-index"><span>Isi dokumen</span><ol>{items.map((item, i) => <li><a href={`#bagian-${i + 1}`}>{String(i + 1).padStart(2, '0')} {item.title}</a></li>)}</ol></aside><div class="policy-content">{items.map((item, i) => <section id={`bagian-${i + 1}`} class="policy-section reveal"><span>{String(i + 1).padStart(2, '0')}</span><div><h2>{item.title}</h2><p>{item.text}</p>{item.href && <a class="text-link" href={item.href}>Pelajari lebih lanjut</a>}</div></section>)}</div></div></section>
  <section class="policy-close"><div class="container"><div><p>Masih ada pertanyaan?</p><h2>Hubungi tim RAMUNI tanpa mengirim data sensitif.</h2></div><a class="button button--primary" href={ctaHref}>{ctaLabel}</a></div></section>
</BaseLayout>

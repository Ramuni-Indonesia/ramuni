---
import { calculators, type CalculatorKey } from '../data/calculators';

interface Props {
  kind: CalculatorKey;
  embedded?: boolean;
}

const { kind, embedded = false } = Astro.props;
const calculator = calculators[kind];
const titleId = `calculator-${kind}-${embedded ? 'article' : 'page'}`;
---

<section
  class:list={['ramuni-calculator', { 'ramuni-calculator--embedded': embedded }]}
  data-calculator-widget={kind}
  data-example-values={JSON.stringify(calculator.example)}
  data-result-notes={JSON.stringify({ empty: calculator.emptyNote, positive: calculator.positiveNote, caution: calculator.cautionNote })}
  aria-labelledby={titleId}
>
  <div class="ramuni-calculator__intro">
    <span>{embedded ? 'Coba di artikel' : 'Hitung dengan data Anda'}</span>
    <h2 id={titleId}>{calculator.shortTitle}</h2>
    <p>{calculator.decision}</p>
  </div>

  <div class="ramuni-calculator__workspace">
    <form class="ramuni-calculator__form">
      <div class="ramuni-calculator__scenario">
        <span>Mulai dengan angka sendiri atau</span>
        <button type="button" data-calculator-example>{calculator.exampleLabel}</button>
      </div>
      {calculator.fields.map((field) => <div class="ramuni-calculator__field">
        <label for={`${titleId}-${field.name}`}>{field.label}</label>
        <div class="ramuni-calculator__input">
          <input id={`${titleId}-${field.name}`} name={field.name} type="number" min={field.min ?? 0} max={field.max} step={field.step ?? 'any'} inputmode="decimal" placeholder={field.placeholder} required />
          <span>{field.unit}</span>
        </div>
      </div>)}
      <div class="ramuni-calculator__actions">
        <button class="button button--primary" type="submit">Hitung hasil</button>
        <button class="button button--secondary" type="reset">Atur ulang</button>
      </div>
      <p class="ramuni-calculator__privacy">Hitungan berjalan di browser. Jangan masukkan data pribadi atau informasi sensitif.</p>
    </form>

    <div class="ramuni-calculator__result" aria-live="polite">
      <span>{calculator.resultLabel}</span>
      <strong data-calculator-result>Belum dihitung</strong>
      <p data-calculator-note>{calculator.emptyNote}</p>
      <div class="ramuni-calculator__formula"><small>Rumus yang dipakai</small><code>{calculator.formula}</code><p>{calculator.formulaNote}</p></div>
      <p class="ramuni-calculator__disclaimer">Hasil bersifat edukasi. Periksa kembali satuan, periode, dan catatan usaha Anda.</p>
    </div>
  </div>

  {embedded && <div class="ramuni-calculator__followup" aria-label="Langkah setelah menghitung">
    <div>
      <span>Setelah hasil muncul</span>
      <ol>{calculator.nextSteps.map((step) => <li>{step}</li>)}</ol>
    </div>
    <nav aria-label={`Materi terkait ${calculator.shortTitle}`}>
      <span>Periksa bersama</span>
      {calculator.related.map((item) => <a href={item.href}><strong>{item.label}</strong><i aria-hidden="true">&rarr;</i></a>)}
    </nav>
  </div>}
</section>

<script>
  import { calculateBusinessMetric, shouldUseCautionNote } from '../lib/calculatorEngine.mjs';
  const formatNumber = (value: number) => new Intl.NumberFormat('id-ID', { maximumFractionDigits: 2 }).format(value);
  document.querySelectorAll<HTMLElement>('[data-calculator-widget]').forEach((widget) => {
    if (widget.dataset.ready === 'true') return;
    widget.dataset.ready = 'true';
    const form = widget.querySelector('form');
    const result = widget.querySelector<HTMLElement>('[data-calculator-result]');
    const note = widget.querySelector<HTMLElement>('[data-calculator-note]');
    const exampleButton = widget.querySelector<HTMLButtonElement>('[data-calculator-example]');
    if (!(form instanceof HTMLFormElement) || !result || !note) return;

    const notes = JSON.parse(widget.dataset.resultNotes || '{}') as { empty?: string; positive?: string; caution?: string };

    exampleButton?.addEventListener('click', () => {
      const values = JSON.parse(widget.dataset.exampleValues || '{}') as Record<string, number>;
      Object.entries(values).forEach(([name, value]) => {
        const input = form.elements.namedItem(name);
        if (input instanceof HTMLInputElement) input.value = String(value);
      });
      form.requestSubmit();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const values = Object.fromEntries(Array.from(new FormData(form).entries()).map(([key, value]) => [key, Number(value)]));
      const kind = widget.dataset.calculatorWidget;
      const calculation = calculateBusinessMetric(kind, values);
      const value = calculation.value;
      const isPercentResult = calculation.format === 'percent';
      const isUnitResult = calculation.format === 'unit';
      const isMoneyResult = calculation.format === 'money';
      const valid = Number.isFinite(value);
      result.textContent = valid
        ? `${isMoneyResult ? 'Rp ' : ''}${formatNumber(value)}${isPercentResult ? '%' : isUnitResult ? ` ${calculation.suffix || 'unit'}` : ''}`
        : 'Periksa input';
      note.textContent = shouldUseCautionNote(kind, value) ? notes.caution || '' : notes.positive || '';
      widget.dataset.hasResult = 'true';
      window.dispatchEvent(new CustomEvent('ramuni:calculator:used', {
        detail: { calculatorType: kind, pagePath: window.location.pathname },
      }));
    });

    form.addEventListener('reset', () => {
      result.textContent = 'Belum dihitung';
      note.textContent = notes.empty || 'Isi semua angka untuk melihat hasil dan cara membacanya.';
      delete widget.dataset.hasResult;
    });
  });
</script>

<style is:global>
  .ramuni-calculator__followup{display:grid;grid-template-columns:minmax(0,.9fr) minmax(280px,1.1fr);gap:clamp(24px,5vw,56px);margin-top:32px;padding-top:28px;border-top:1px solid var(--ink-20)}
  .ramuni-calculator__followup>div>span,.ramuni-calculator__followup nav>span{display:block;margin-bottom:14px;color:var(--teal);font-size:.7rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.ramuni-calculator__followup ol{margin:0;padding-left:20px}.ramuni-calculator__followup li+li{margin-top:9px}.ramuni-calculator__followup nav{border-top:1px solid var(--ink);padding-top:16px}.ramuni-calculator__followup nav>a{display:grid;grid-template-columns:1fr auto;gap:18px;padding:14px 0;border-bottom:1px solid var(--ink-10);color:var(--ink);text-decoration:none}.ramuni-calculator__followup nav i{color:var(--teal);font-style:normal}
  @media(max-width:900px){.ramuni-calculator__followup{grid-template-columns:1fr}}
</style>

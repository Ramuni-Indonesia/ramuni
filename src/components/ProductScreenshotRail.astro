---
import type { ProductScreen } from '../data/productScreens';
import DeviceMockup from './DeviceMockup.astro';

interface Props {
  heading: string;
  body?: string;
  items: readonly ProductScreen[];
  eyebrow?: string;
  id?: string;
  compact?: boolean;
}

const {
  heading,
  body,
  items,
  eyebrow = 'Tampilan produk',
  id = 'product-screens',
  compact = false,
} = Astro.props;
---

<section id={id} class:list={['product-screenshot-rail', { 'product-screenshot-rail--compact': compact, 'product-screenshot-rail--single': items.length === 1 }]} aria-labelledby={`${id}-title`}>
  <div class="container">
    <div class="product-screenshot-rail__head">
      <div>
        <p class="section-kicker">{eyebrow}</p>
        <h2 id={`${id}-title`}>{heading}</h2>
      </div>
      {body && <p>{body}</p>}
    </div>
    <div class="product-screenshot-rail__viewport" tabindex="0" aria-label="Geser untuk melihat tampilan produk">
      <div class="product-screenshot-rail__track">
        {items.map((item, index) => (
          <figure class="product-screenshot-card" style={`--i:${index}`}>
            <DeviceMockup label={item.alt}>
              <div class="product-screenshot-card__media">
                <picture>
                  {item.mobileSrc && <source media="(max-width: 740px)" srcset={item.mobileSrc} width={item.mobileWidth} height={item.mobileHeight} />}
                  <img src={item.src} width={item.width} height={item.height} alt={item.alt} loading={index === 0 && !compact ? 'eager' : 'lazy'} decoding="async" />
                </picture>
              </div>
            </DeviceMockup>
            <figcaption>
              <span>{item.eyebrow}</span>
              <strong>{item.title}</strong>
              <small>{item.note}</small>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:inline>
  .product-screenshot-rail{padding:clamp(58px,8vw,108px) 0;background:var(--rice);overflow:hidden}.product-screenshot-rail--compact{padding-block:clamp(42px,6vw,76px);background:var(--white)}
  .product-screenshot-rail__head{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,.72fr);gap:clamp(28px,7vw,100px);align-items:end;margin-bottom:30px}.product-screenshot-rail__head h2{max-width:18ch;margin-top:10px;text-wrap:balance}.product-screenshot-rail__head>p{max-width:46ch;margin:0;color:var(--ink-72);line-height:1.65}
  .product-screenshot-rail__viewport{min-width:0;outline:none}.product-screenshot-rail__viewport:focus-visible{outline:2px solid var(--teal);outline-offset:8px}.product-screenshot-rail__track{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(12px,2vw,22px)}
  .product-screenshot-rail--single .product-screenshot-rail__track{grid-template-columns:minmax(0,1fr)}.product-screenshot-rail--single .product-screenshot-card{width:100%;max-width:min(1080px,100%);margin-inline:auto}
  .product-screenshot-card{min-width:0;margin:0;border:1px solid var(--ink-10);background:var(--white);box-shadow:0 14px 34px rgb(11 48 69/.07);animation:product-screen-enter .6s var(--ease) both;animation-delay:calc(var(--i,0)*70ms)}.product-screenshot-card>.device-mockup{padding:14px 14px 0;background:var(--rice)}.product-screenshot-card__media{display:grid;place-items:center;aspect-ratio:16/10;overflow:hidden;background:#eef1ee}.product-screenshot-card__media picture,.product-screenshot-card__media img{display:block;width:100%;height:100%}.product-screenshot-card__media img{object-fit:contain;padding:10px}.product-screenshot-card figcaption{display:grid;gap:7px;padding:16px 18px 18px}.product-screenshot-card figcaption span{color:var(--teal);font-size:.64rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.product-screenshot-card figcaption strong{font-size:clamp(.98rem,1.4vw,1.14rem);line-height:1.3}.product-screenshot-card figcaption small{color:var(--ink-56);font-size:.68rem;line-height:1.45}
  .product-screenshot-rail--compact .product-screenshot-card__media{aspect-ratio:16/9}
  @keyframes product-screen-enter{from{opacity:.3;transform:translateY(10px)}to{opacity:1;transform:none}}
  @media(max-width:900px){.product-screenshot-rail__head{grid-template-columns:1fr}.product-screenshot-rail__head>p{margin-top:-14px}.product-screenshot-rail__track{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:620px){.product-screenshot-rail{padding-block:52px}.product-screenshot-rail__head{gap:14px;margin-bottom:22px}.product-screenshot-rail__head h2{max-width:22ch}.product-screenshot-rail__viewport{overflow-x:auto;padding:2px 2px 12px;scroll-snap-type:x mandatory;overscroll-behavior-inline:contain}.product-screenshot-rail__track{display:flex;gap:12px;width:max-content}.product-screenshot-card{width:min(82vw,350px);scroll-snap-align:start}.product-screenshot-card__media{aspect-ratio:16/10}.product-screenshot-card figcaption{padding:13px 14px 15px}}
  @media(prefers-reduced-motion:reduce){.product-screenshot-card{animation:none!important}}
  .device-mockup{display:block;width:100%;min-width:0;padding:0 2% clamp(15px,2vw,28px);perspective:1400px;isolation:isolate;position:relative}.device-mockup::after{content:"";position:absolute;z-index:0;left:13%;right:13%;bottom:0;height:18%;border-radius:50%;background:rgb(11 48 69/.18);filter:blur(18px);opacity:.4;pointer-events:none}.device-mockup__frame{position:relative;z-index:1;display:block;width:100%;padding:clamp(8px,.9vw,13px);border:1px solid rgb(11 48 69/.18);border-radius:clamp(12px,1.25vw,20px);background:linear-gradient(180deg,#f4f7f6 0%,#d9e0df 52%,#b8c2c1 100%);box-shadow:0 22px 46px rgb(11 48 69/.16),inset 0 1px rgb(255 255 255/.9);transform:rotateY(-2deg) rotateX(.6deg);transform-style:preserve-3d;backface-visibility:hidden;transition:transform .5s var(--ease),box-shadow .5s var(--ease)}.device-mockup__frame::before{content:"";position:absolute;inset:0;border-radius:inherit;border-top:1px solid rgb(255 255 255/.95);pointer-events:none}.device-mockup__frame::after{content:"";position:absolute;left:7%;right:7%;bottom:3px;height:1px;background:rgb(11 48 69/.16);pointer-events:none}.device-mockup__screen{position:relative;display:block;width:100%;min-width:0;overflow:hidden;border:clamp(3px,.35vw,5px) solid #0a1117;border-radius:clamp(5px,.55vw,9px);background:#071017;box-shadow:0 1px 0 rgb(255 255 255/.12),inset 0 0 0 1px rgb(255 255 255/.07)}.device-mockup__screen>*{min-width:0}.device-mockup__hinge,.device-mockup__base{display:none}
  @media(max-width:900px) and (min-width:621px){.device-mockup--responsive{padding-inline:0}.device-mockup--responsive .device-mockup__frame{width:min(100%,640px);margin-inline:auto;transform:none}.device-mockup--responsive .device-mockup__screen{border-radius:10px}.device-mockup--responsive .product-screenshot-card__media{aspect-ratio:4/3!important}}
  @media(max-width:620px){.device-mockup--responsive{width:min(100%,270px);margin-inline:auto;padding:0}.device-mockup--responsive .device-mockup__frame{padding:9px 7px 11px;border-radius:26px;background:linear-gradient(180deg,#f1f5f3,#c3cfcd);box-shadow:0 20px 42px rgb(11 48 69/.16);transform:none}.device-mockup--responsive .device-mockup__screen{height:auto;aspect-ratio:auto;border-width:3px;border-radius:20px;background:#f4f7f5}.device-mockup--responsive .product-screenshot-card__media{aspect-ratio:9/16!important;background:#f4f7f5}.device-mockup--responsive .product-screenshot-card__media img{object-fit:cover!important;object-position:top center!important;padding:0}}
  @media (hover:hover) and (pointer:fine){.device-mockup:hover .device-mockup__frame{transform:rotateY(-1.5deg) rotateX(.55deg) translateY(-2px);box-shadow:0 28px 52px rgb(11 48 69/.18),inset 0 1px rgb(255 255 255/.9)}}
  @media(max-width:900px) and (min-width:621px){.device-mockup{padding-inline:0}.device-mockup__frame{width:min(100%,640px);margin-inline:auto;transform:rotateY(-1.5deg) rotateX(.6deg)}}
  @media(max-width:620px){.device-mockup::after{display:none}.device-mockup{width:min(100%,270px);margin-inline:auto;padding:0}.device-mockup__frame{aspect-ratio:9/16;padding:9px 7px 11px;border-radius:26px;background:linear-gradient(180deg,#f1f5f3,#c3cfcd);box-shadow:0 20px 42px rgb(11 48 69/.16);transform:none}.device-mockup__screen{height:100%;aspect-ratio:auto;border-width:3px;border-radius:20px;background:#f4f7f5;transform:none}.device-mockup__camera{top:5px;width:38px;height:4px;border-radius:0 0 6px 6px}.device-mockup__hinge,.device-mockup__base{display:none}}
  @media(prefers-reduced-motion:reduce){.device-mockup__frame{transition:none}.device-mockup:hover .device-mockup__frame{transform:none}}
</style>

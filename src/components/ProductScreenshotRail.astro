---
import type { ProductScreen } from '../data/productScreens';

interface Props {
  heading: string;
  body?: string;
  items: readonly ProductScreen[];
  eyebrow?: string;
  id?: string;
  compact?: boolean;
}

const {
  heading,
  body,
  items,
  eyebrow = 'Tampilan produk',
  id = 'product-screens',
  compact = false,
} = Astro.props;
---

<section id={id} class:list={['product-screenshot-rail', { 'product-screenshot-rail--compact': compact }]} aria-labelledby={`${id}-title`}>
  <div class="container">
    <div class="product-screenshot-rail__head">
      <div>
        <p class="section-kicker">{eyebrow}</p>
        <h2 id={`${id}-title`}>{heading}</h2>
      </div>
      {body && <p>{body}</p>}
    </div>
    <div class="product-screenshot-rail__viewport" tabindex="0" aria-label="Geser untuk melihat tampilan produk">
      <div class="product-screenshot-rail__track">
        {items.map((item, index) => (
          <figure class="product-screenshot-card" style={`--i:${index}`}>
            <div class="product-screenshot-card__media">
              <picture>
                {item.mobileSrc && <source media="(max-width: 740px)" srcset={item.mobileSrc} width={item.mobileWidth} height={item.mobileHeight} />}
                <img src={item.src} width={item.width} height={item.height} alt={item.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
              </picture>
            </div>
            <figcaption>
              <span>{item.eyebrow}</span>
              <strong>{item.title}</strong>
              <small>{item.note}</small>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
    <p class="product-screenshot-rail__disclosure">Tampilan di atas adalah contoh screen produk RAMUNI. Ketersediaan dan detail akses mengikuti status rilis yang tercantum di tiap halaman.</p>
  </div>
</section>

<style is:inline>
  .product-screenshot-rail{padding:clamp(58px,8vw,108px) 0;background:var(--rice);overflow:hidden}.product-screenshot-rail--compact{padding-block:clamp(42px,6vw,76px);background:var(--white)}
  .product-screenshot-rail__head{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,.72fr);gap:clamp(28px,7vw,100px);align-items:end;margin-bottom:30px}.product-screenshot-rail__head h2{max-width:18ch;margin-top:10px;text-wrap:balance}.product-screenshot-rail__head>p{max-width:46ch;margin:0;color:var(--ink-72);line-height:1.65}
  .product-screenshot-rail__viewport{min-width:0;outline:none}.product-screenshot-rail__viewport:focus-visible{outline:2px solid var(--teal);outline-offset:8px}.product-screenshot-rail__track{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(12px,2vw,22px)}
  .product-screenshot-card{min-width:0;margin:0;border:1px solid var(--ink-10);background:var(--white);box-shadow:0 14px 34px rgb(11 48 69/.07);animation:product-screen-enter .6s var(--ease) both;animation-delay:calc(var(--i,0)*70ms)}.product-screenshot-card__media{display:grid;place-items:center;aspect-ratio:16/10;overflow:hidden;background:#eef1ee;border-bottom:1px solid var(--ink-10)}.product-screenshot-card__media picture,.product-screenshot-card__media img{display:block;width:100%;height:100%}.product-screenshot-card__media img{object-fit:contain;padding:10px}.product-screenshot-card figcaption{display:grid;gap:7px;padding:16px 18px 18px}.product-screenshot-card figcaption span{color:var(--teal);font-size:.64rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.product-screenshot-card figcaption strong{font-size:clamp(.98rem,1.4vw,1.14rem);line-height:1.3}.product-screenshot-card figcaption small{color:var(--ink-56);font-size:.68rem;line-height:1.45}
  .product-screenshot-rail__disclosure{margin:14px 0 0;color:var(--ink-56);font-size:.67rem;line-height:1.5}.product-screenshot-rail--compact .product-screenshot-card__media{aspect-ratio:16/9}
  @keyframes product-screen-enter{from{opacity:.3;transform:translateY(10px)}to{opacity:1;transform:none}}
  @media(max-width:900px){.product-screenshot-rail__head{grid-template-columns:1fr}.product-screenshot-rail__head>p{margin-top:-14px}.product-screenshot-rail__track{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:620px){.product-screenshot-rail{padding-block:52px}.product-screenshot-rail__head{gap:14px;margin-bottom:22px}.product-screenshot-rail__head h2{max-width:22ch}.product-screenshot-rail__viewport{overflow-x:auto;padding:2px 2px 12px;scroll-snap-type:x mandatory;overscroll-behavior-inline:contain}.product-screenshot-rail__track{display:flex;gap:12px;width:max-content}.product-screenshot-card{width:min(82vw,350px);scroll-snap-align:start}.product-screenshot-card__media{aspect-ratio:16/10}.product-screenshot-card figcaption{padding:13px 14px 15px}}
  @media(prefers-reduced-motion:reduce){.product-screenshot-card{animation:none!important}}
</style>

---
import type { ProductScreen } from '../data/productScreens';

interface Props {
  heading: string;
  body?: string;
  items: readonly ProductScreen[];
  eyebrow?: string;
  id?: string;
  compact?: boolean;
}

const {
  heading,
  body,
  items,
  eyebrow = 'Tampilan produk',
  id = 'product-screens',
  compact = false,
} = Astro.props;
---

<section id={id} class:list={['product-screenshot-rail', { 'product-screenshot-rail--compact': compact, 'product-screenshot-rail--single': items.length === 1 }]} aria-labelledby={`${id}-title`}>
  <div class="container">
    <div class="product-screenshot-rail__head">
      <div>
        <p class="section-kicker">{eyebrow}</p>
        <h2 id={`${id}-title`}>{heading}</h2>
      </div>
      {body && <p>{body}</p>}
    </div>
    <div class="product-screenshot-rail__viewport" tabindex="0" aria-label="Geser untuk melihat tampilan produk">
      <div class="product-screenshot-rail__track">
        {items.map((item, index) => (
          <figure class:list={['product-screenshot-card', { 'product-screenshot-card--featured': index === 0 }]} style={`--i:${index}`}>
            <div class="product-screenshot-card__media">
              <picture>
                {item.mobileSrc && <source media="(max-width: 740px)" srcset={item.mobileSrc} width={item.mobileWidth} height={item.mobileHeight} />}
                {item.tabletSrc && <source media="(max-width: 1024px)" srcset={item.tabletSrc} width={item.tabletWidth} height={item.tabletHeight} />}
                <img src={item.src} width={item.width} height={item.height} alt={item.alt} loading={index === 0 && !compact ? 'eager' : 'lazy'} decoding="async" />
              </picture>
            </div>
            <figcaption>
              <span>{item.eyebrow}</span>
              <strong>{item.title}</strong>
              <small>{item.note}</small>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:inline>
  .product-screenshot-rail{padding:clamp(58px,8vw,108px) 0;background:var(--rice);overflow:hidden}.product-screenshot-rail--compact{padding-block:clamp(42px,6vw,76px);background:var(--white)}
  .product-screenshot-rail__head{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,.72fr);gap:clamp(28px,7vw,100px);align-items:end;margin-bottom:30px}.product-screenshot-rail__head h2{max-width:18ch;margin-top:10px;text-wrap:balance}.product-screenshot-rail__head>p{max-width:46ch;margin:0;color:var(--ink-72);line-height:1.65}
  .product-screenshot-rail__viewport{min-width:0;outline:none}.product-screenshot-rail__viewport:focus-visible{outline:2px solid var(--teal);outline-offset:8px}.product-screenshot-rail__track{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:14px;align-items:start}
  .product-screenshot-rail--single .product-screenshot-rail__track{grid-template-columns:minmax(0,1fr)}.product-screenshot-rail--single .product-screenshot-card{width:100%;max-width:min(1080px,100%);margin-inline:auto}
  .product-screenshot-card{min-width:0;margin:0;border:1px solid var(--ink-10);background:var(--white);box-shadow:0 6px 18px rgb(11 48 69/.05);animation:product-screen-enter .6s var(--ease) both;animation-delay:calc(var(--i,0)*70ms)}.product-screenshot-card--featured{grid-column:span 7}.product-screenshot-card:not(.product-screenshot-card--featured){grid-column:span 5;margin-top:clamp(22px,5vw,70px)}.product-screenshot-card__media{display:grid;place-items:center;aspect-ratio:16/10;overflow:hidden;background:var(--rice);border-bottom:1px solid var(--ink-10)}.product-screenshot-card__media picture,.product-screenshot-card__media img{display:block;width:100%;height:100%}.product-screenshot-card__media img{object-fit:contain;padding:0}.product-screenshot-card figcaption{display:grid;gap:7px;padding:16px 18px 18px}.product-screenshot-card figcaption span{color:var(--teal);font-size:.64rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.product-screenshot-card figcaption strong{font-size:clamp(.98rem,1.4vw,1.14rem);line-height:1.3}.product-screenshot-card figcaption small{color:var(--ink-56);font-size:.68rem;line-height:1.45}
  .product-screenshot-rail--compact .product-screenshot-card__media{aspect-ratio:16/9}
  @keyframes product-screen-enter{from{opacity:.3;transform:translateY(10px)}to{opacity:1;transform:none}}
  @media(max-width:900px){.product-screenshot-rail__head{grid-template-columns:1fr}.product-screenshot-rail__head>p{margin-top:-14px}.product-screenshot-rail__track{grid-template-columns:repeat(2,minmax(0,1fr))}.product-screenshot-card--featured,.product-screenshot-card:not(.product-screenshot-card--featured){grid-column:span 1;margin-top:0}}
  @media(max-width:620px){.product-screenshot-rail{padding-block:52px}.product-screenshot-rail__head{gap:14px;margin-bottom:22px}.product-screenshot-rail__head h2{max-width:22ch}.product-screenshot-rail__track{grid-template-columns:1fr;gap:12px}.product-screenshot-card--featured,.product-screenshot-card:not(.product-screenshot-card--featured){grid-column:auto;margin-top:0}.product-screenshot-card__media{aspect-ratio:auto;display:block;min-height:180px}.product-screenshot-card__media picture{display:block}.product-screenshot-card figcaption{padding:13px 14px 15px}}
  @media(prefers-reduced-motion:reduce){.product-screenshot-card{animation:none!important}}
  @media(max-width:900px) and (min-width:621px){.product-screenshot-card__media{aspect-ratio:4/3}}
  @media(max-width:620px){.product-screenshot-card__media{aspect-ratio:auto!important;background:#f4f7f5}.product-screenshot-card__media img{height:auto;max-height:none;object-fit:contain}}
</style>

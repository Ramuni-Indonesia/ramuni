---
import MarketingDashboardCanvas from '../MarketingDashboardCanvas.astro';
import type { SolutionDetail } from '../../data/solutionDetails';
import { getSolutionMarketingDashboardContext } from '../../data/marketingDashboardContexts';

interface Props {
  visual: SolutionDetail['visual'];
  slug?: string;
}

const { visual, slug = '' } = Astro.props;
const dashboardContext = getSolutionMarketingDashboardContext(slug);
---

<div class={`solution-proof solution-proof--${visual.kind}`} aria-label={`Contoh visual untuk ${visual.title}`}>
  <MarketingDashboardCanvas context={dashboardContext} priority />
</div>

<style>
  .solution-proof{container-type:inline-size;min-width:0;margin:0;overflow:hidden}
  @media(max-width:720px){.solution-proof{border-radius:16px}}
  @media(prefers-reduced-motion:reduce){.solution-proof *{animation:none!important;transition:none!important}}
</style>

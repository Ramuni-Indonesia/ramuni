---
import type { SolutionDetail } from '../../data/solutionDetails';

interface Props {
  visual: SolutionDetail['visual'];
}

const { visual } = Astro.props;
const visualId = `sd-visual-${visual.kind}`;
---
<figure class={`sd-visual sd-visual--${visual.kind}`} aria-labelledby={`${visualId}-title`}>
  <figcaption class="sd-visual__head">
    <span>{visual.label}</span>
    <strong id={`${visualId}-title`}>{visual.title}</strong>
    <small>{visual.period}</small>
  </figcaption>

  <div class="sd-visual__tabs" role="group" aria-label="Mode pembacaan visual">
    <label><input type="radio" name={visualId} value="pattern" checked aria-controls={`${visualId}-pattern`} /><span>Pola</span></label>
    <label><input type="radio" name={visualId} value="evidence" aria-controls={`${visualId}-evidence`} /><span>Bukti</span></label>
    <label><input type="radio" name={visualId} value="step" aria-controls={`${visualId}-step`} /><span>Langkah</span></label>
  </div>

  <div id={`${visualId}-pattern`} class="sd-visual__pane sd-visual__pane--pattern" data-visual-pane="pattern" role="region" aria-label="Pola visual">

  {visual.kind === 'revenue' && (
    <div class="sd-revenue" aria-hidden="true">
      {visual.metrics.map((metric, index) => (
        <div class={`sd-revenue__column ${metric.tone ? `is-${metric.tone}` : ''}`} style={`--level:${[82, 54, 67][index]}%`}>
          <span>{metric.value}</span><i></i><b>{metric.label}</b>
        </div>
      ))}
    </div>
  )}

  {visual.kind === 'stock' && (
    <div class="sd-stock" aria-hidden="true">
      {visual.metrics.map((metric, index) => (
        <div class={`sd-stock__row ${metric.tone ? `is-${metric.tone}` : ''}`}>
          <span>{String(index + 1).padStart(2, '0')}</span><b>{metric.label}</b><i style={`--level:${[36, 70, 55][index]}%`}></i><strong>{metric.value}</strong>
        </div>
      ))}
    </div>
  )}

  {visual.kind === 'cash' && (
    <div class="sd-cash" aria-hidden="true">
      {visual.metrics.map((metric, index) => (
        <div class={`sd-cash__step ${metric.tone ? `is-${metric.tone}` : ''}`} style={`--level:${[100, 62, 48][index]}%`}>
          <span>{metric.label}</span><i></i><strong>{metric.value}</strong>
        </div>
      ))}
    </div>
  )}

  {visual.kind === 'customer' && (
    <div class="sd-customer" aria-hidden="true">
      <i class="sd-customer__line"></i>
      {visual.metrics.map((metric, index) => (
        <div class={`sd-customer__event ${metric.tone ? `is-${metric.tone}` : ''}`} style={`--i:${index}`}>
          <span>{String(index + 1).padStart(2, '0')}</span><b>{metric.label}</b><strong>{metric.value}</strong>
        </div>
      ))}
    </div>
  )}

  {visual.kind === 'report' && (
    <div class="sd-report" aria-hidden="true">
      <div class="sd-report__rule"><span></span><span></span><span></span></div>
      {visual.metrics.map((metric, index) => (
        <div class={`sd-report__item ${metric.tone ? `is-${metric.tone}` : ''}`}>
          <span>{String(index + 1).padStart(2, '0')}</span><b>{metric.label}</b><strong>{metric.value}</strong>
        </div>
      ))}
      <div class="sd-report__approval"><span>Persetujuan</span><b>Menunggu pemeriksaan</b></div>
    </div>
  )}

  </div>

  <dl id={`${visualId}-evidence`} class="sd-visual__metrics sd-visual__pane" data-visual-pane="evidence">
    {visual.metrics.map((metric, index) => (
      <div class={metric.tone ? `is-${metric.tone}` : ''}>
        <dt>Bukti {String(index + 1).padStart(2, '0')} · {metric.label}</dt><dd>{metric.value}</dd><small>{metric.note}</small>
      </div>
    ))}
  </dl>

  <ol id={`${visualId}-step`} class="sd-visual__next sd-visual__pane" data-visual-pane="step">
    <li><span>01</span><div><strong>Samakan periode</strong><small>{visual.period}</small></div></li>
    <li><span>02</span><div><strong>Periksa sumber paling menonjol</strong><small>{visual.metrics.find((metric) => metric.tone === 'warning')?.label ?? visual.metrics[0]?.label}</small></div></li>
    <li><span>03</span><div><strong>Bawa ke keputusan manual</strong><small>Pengguna tetap menentukan tindakan setelah bukti dibaca.</small></div></li>
  </ol>
</figure>

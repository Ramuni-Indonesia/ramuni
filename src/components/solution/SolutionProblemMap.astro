---
interface ProblemEntry {
  label: string;
  text: string;
  prompt: string;
  href: string;
}

import { getSolutionDashboardVisual } from '../../data/dashboardVisuals';
import DashboardMotion from '../DashboardMotion.astro';

interface Props {
  entries: ProblemEntry[];
}

const { entries } = Astro.props;
const solutionSlugs = entries.map((entry) => entry.href.split('/').filter(Boolean).at(-1) || '');
const primaryVisual = getSolutionDashboardVisual(solutionSlugs[0] || '');
const destinations = entries.map((entry) => ({ href: entry.href, label: entry.label.toLowerCase() }));
---

<figure class="solution-map" aria-labelledby="solution-map-title" data-map-destinations={JSON.stringify(destinations)}>
  <figcaption class="solution-map__head">
    <div><span>Contoh pembacaan</span><strong id="solution-map-title">Pilih gejala, lalu lihat konteks pada dashboard</strong></div>
    <small>Tampilan RAMUNI</small>
  </figcaption>

  <div class="solution-map__workspace">
    <div class="solution-map__screens" aria-live="polite">
      {entries.map((entry, index) => (
        <article
          id={`solution-map-panel-${index}`}
          class:list={['solution-map__panel', { 'is-active': index === 0 }]}
          data-map-panel={index}
          role="tabpanel"
          aria-labelledby={`solution-map-tab-${index}`}
          aria-hidden={index === 0 ? 'false' : 'true'}
        >
          <div class="solution-map__media">
            <div class="solution-map__visual solution-map__visual--dashboard">
              <span>{index === 0 ? 'Dashboard RAMUNI' : 'Gejala terpilih'}</span>
              <div class="solution-map__dashboard">
                {index === 0 ? <DashboardMotion
                  focus="performance"
                  label={primaryVisual.alt}
                  priority
                  {...primaryVisual}
                /> : <div class="solution-map__context-note"><span>{entry.label}</span><strong>{entry.text}</strong><small>{entry.prompt}</small></div>}
            </div>
          </div>
          </div>
          <footer><span>{entry.label}</span><strong>{entry.prompt}</strong></footer>
        </article>
      ))}
    </div>

    <div class="solution-map__controls" role="tablist" aria-label="Pilih masalah usaha">
      {entries.map((entry, index) => (
        <button
          type="button"
          role="tab"
          id={`solution-map-tab-${index}`}
          aria-controls={`solution-map-panel-${index}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          data-map-tab={index}
        >
          <span>{String(index + 1).padStart(2, '0')} / {entry.label}</span>
          <strong>{entry.text}</strong>
        </button>
      ))}
      <a class="solution-map__link" data-map-link href={entries[0]?.href}>Buka alur {entries[0]?.label.toLowerCase()}</a>
    </div>
  </div>
</figure>

<script>
  const bindSolutionMap = () => {
    document.querySelectorAll<HTMLElement>('.solution-map').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-map-tab]'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-map-panel]'));
      const link = root.querySelector<HTMLAnchorElement>('[data-map-link]');
      const destinations = JSON.parse(root.dataset.mapDestinations || '[]') as Array<{ href: string; label: string }>;

      const activate = (tab: HTMLButtonElement) => {
        const index = Number(tab.dataset.mapTab || 0);
        tabs.forEach((item) => {
          const active = item === tab;
          item.setAttribute('aria-selected', String(active));
          item.tabIndex = active ? 0 : -1;
        });
        panels.forEach((panel, panelIndex) => {
          const active = panelIndex === index;
          if (active) {
            panel.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((image) => {
              image.src = image.dataset.src || '';
              delete image.dataset.src;
            });
          }
          panel.classList.toggle('is-active', active);
          panel.setAttribute('aria-hidden', String(!active));
        });
        if (link && destinations[index]) {
          link.href = destinations[index].href;
          link.textContent = `Buka alur ${destinations[index].label}`;
        }
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => activate(tab));
        tab.addEventListener('keydown', (event) => {
          if (!['ArrowDown', 'ArrowUp', 'ArrowLeft', 'ArrowRight'].includes(event.key)) return;
          event.preventDefault();
          const forward = event.key === 'ArrowDown' || event.key === 'ArrowRight';
          const next = forward ? (index + 1) % tabs.length : (index - 1 + tabs.length) % tabs.length;
          tabs[next]?.focus();
          if (tabs[next]) activate(tabs[next]);
        });
      });
    });
  };

  bindSolutionMap();
  document.addEventListener('astro:page-load', bindSolutionMap);
</script>

<style>
  .solution-map{min-width:0;margin:0;border:1px solid var(--ink-20);background:var(--white);box-shadow:0 24px 58px rgb(11 48 69/.14);overflow:hidden}
  .solution-map__head{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:15px 18px;border-bottom:1px solid var(--ink-10)}
  .solution-map__head>div{display:grid;gap:4px}.solution-map__head span{color:var(--teal);font-size:.6rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.solution-map__head strong{font-size:.78rem}.solution-map__head small{color:var(--ink-72);font-size:.6rem;font-weight:700}
  .solution-map__workspace{display:grid;grid-template-columns:minmax(0,1.46fr) minmax(230px,.54fr);min-height:430px}
  .solution-map__screens{position:relative;min-width:0;background:var(--rice);overflow:hidden}
  .solution-map__panel{position:absolute;inset:0;display:grid;grid-template-rows:minmax(0,1fr) auto;opacity:0;visibility:hidden;transform:translate3d(12px,0,0);transition:opacity 240ms cubic-bezier(.22,1,.36,1),transform 320ms cubic-bezier(.22,1,.36,1),visibility 0s 320ms}
  .solution-map__panel.is-active{opacity:1;visibility:visible;transform:none;transition-delay:0s}.solution-map__media{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(180px,.7fr);min-height:0;background:var(--rice)}.solution-map__visual{position:relative;min-width:0;min-height:0;overflow:hidden}.solution-map__visual>span{position:absolute;z-index:3;left:10px;top:10px;padding:6px 8px;background:rgb(11 48 69/.9);color:var(--white);font-size:.52rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase}.solution-map__dashboard{height:100%;padding:12px}.solution-map__visual--context{border-left:1px solid var(--ink-10);background:var(--white)}.solution-map__context{display:block;width:100%;height:100%;min-height:0;object-fit:contain;object-position:center;background:var(--white)}.solution-map__panel footer{display:grid;gap:5px;padding:12px 14px;border-top:1px solid var(--ink-10);background:var(--white)}.solution-map__panel footer span{color:var(--teal);font-size:.58rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.solution-map__panel footer strong{font-size:.68rem;line-height:1.45}
  .solution-map__controls{display:flex;flex-direction:column;min-width:0;border-left:1px solid var(--ink-10)}
  .solution-map__controls button{flex:1;display:grid;align-content:center;gap:5px;min-width:0;padding:13px 14px;border:0;border-bottom:1px solid var(--ink-10);background:var(--white);color:var(--ink);font:inherit;text-align:left;cursor:pointer;transition:background-color 150ms cubic-bezier(.22,1,.36,1),padding 220ms cubic-bezier(.22,1,.36,1)}.solution-map__controls button span{color:var(--teal);font-size:.53rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em}.solution-map__controls button strong{font-size:.7rem;line-height:1.35}.solution-map__controls button[aria-selected='true']{padding-left:20px;background:var(--yellow)}.solution-map__controls button[aria-selected='true'] span{color:var(--ink)}.solution-map__controls button:focus-visible{position:relative;z-index:2;outline:3px solid var(--teal);outline-offset:-3px}
  .solution-map__link{display:block;padding:13px 14px;background:var(--ink);color:var(--white);font-size:.66rem;font-weight:800;text-decoration:none}.solution-map__link:hover,.solution-map__link:focus-visible{color:var(--yellow)}
  @media(max-width:720px){.solution-map{box-shadow:0 18px 38px rgb(11 48 69/.13)}.solution-map__head{display:grid}.solution-map__workspace{grid-template-columns:1fr;min-height:0}.solution-map__screens{aspect-ratio:16/10}.solution-map__media{grid-template-columns:1fr}.solution-map__visual--context{display:none}.solution-map__controls{display:grid;grid-template-columns:1fr 1fr;border-left:0;border-top:1px solid var(--ink-10)}.solution-map__controls button{min-height:72px;padding:10px 12px}.solution-map__controls button:nth-child(odd){border-right:1px solid var(--ink-10)}.solution-map__controls button strong{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;font-size:.64rem}.solution-map__link{grid-column:1/-1}.solution-map__controls button[aria-selected='true']{padding-left:12px}}
  @media(prefers-reduced-motion:reduce){.solution-map__panel,.solution-map__controls button{transition:none}}
  .solution-map__media{grid-template-columns:1fr}
  .solution-map__context-note{display:grid;align-content:center;gap:14px;min-height:260px;padding:clamp(24px,4vw,42px);background:var(--rice)}
  .solution-map__context-note span{color:var(--teal);font-size:.64rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .solution-map__context-note strong{max-width:18ch;font-size:clamp(1.25rem,2.4vw,2.2rem);line-height:1.12}
  .solution-map__context-note small{max-width:38ch;color:var(--ink-72);font-size:.78rem;line-height:1.5}
</style>

---
interface ProblemEntry {
  label: string;
  text: string;
  prompt: string;
  href: string;
}

import { mascots } from '../../data/mascots';
import { releaseGates } from '../../config/release';

interface Props {
  entries: ProblemEntry[];
}

const { entries } = Astro.props;
const visualAsset = releaseGates.mascotExplorationEnabled ? mascots.guide3d : mascots.decisionVisual;
---

<figure class="solution-map" aria-labelledby="solution-map-title">
  <figcaption class="solution-map__head">
    <span>Petakan satu gejala</span>
    <strong id="solution-map-title">Dari masalah ke bukti yang perlu diperiksa</strong>
    <small>Alur interaktif · tanpa data usaha</small>
  </figcaption>

  <fieldset class="solution-map__controls">
    <legend class="sr-only">Pilih konteks masalah usaha</legend>
    {entries.map((entry, index) => (
      <label>
        <input type="radio" name="solution-map-problem" value={index} checked={index === 0} aria-controls={`solution-map-panel-${index}`} />
        <span>{String(index + 1).padStart(2, '0')}</span>
        <strong>{entry.label}</strong>
      </label>
    ))}
  </fieldset>

  <div class="solution-map__stage" aria-live="polite">
    <div class="solution-map__mascot" aria-hidden="true">
      <span></span>
      <img src={visualAsset.src} alt="" width={visualAsset.width} height={visualAsset.height} loading="eager" decoding="async" />
    </div>
    {entries.map((entry, index) => (
      <article id={`solution-map-panel-${index}`} class="solution-map__panel" data-map-panel={index} role="region" aria-label={`Alur ${entry.label}`}>
        <span>Gejala</span>
        <h2>{entry.text}</h2>
        <div class="solution-map__route" aria-hidden="true"><i></i><i></i><i></i></div>
        <dl>
          <div><dt>Catatan</dt><dd>Pilih periode dan sumber yang sebanding.</dd></div>
          <div><dt>Bukti</dt><dd>{entry.prompt}</dd></div>
          <div><dt>Arah</dt><dd>Buka alur sebelum menentukan tindakan.</dd></div>
        </dl>
        <a href={entry.href}>Lihat alur {entry.label.toLowerCase()}</a>
      </article>
    ))}
  </div>
</figure>

<style>
  .solution-map{position:relative;min-width:0;margin:0;border:1px solid var(--ink);background:var(--white);box-shadow:12px 12px 0 var(--ink);overflow:hidden}
  .solution-map__head{display:grid;grid-template-columns:1fr auto;gap:6px 20px;padding:17px 20px;border-bottom:1px solid var(--ink-10)}
  .solution-map__head span{color:var(--teal);font-size:.66rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.solution-map__head strong{grid-row:2;max-width:30ch;line-height:1.3}.solution-map__head small{grid-column:2;grid-row:1/3;align-self:center;color:var(--ink-72);font-size:.64rem}
  .solution-map__controls{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));margin:0;padding:0;border:0;border-bottom:1px solid var(--ink-10)}
  .solution-map__controls label{position:relative;display:grid;grid-template-columns:auto 1fr;gap:5px 9px;align-items:center;min-width:0;padding:13px 14px;border-right:1px solid var(--ink-10);cursor:pointer;transition:background-color .25s ease,color .25s ease}.solution-map__controls label:last-child{border-right:0}.solution-map__controls input{position:absolute;inline-size:1px;block-size:1px;opacity:0}.solution-map__controls span{color:var(--teal);font-size:.6rem;font-weight:800}.solution-map__controls strong{min-width:0;font-size:.72rem;overflow-wrap:anywhere}.solution-map__controls label:has(input:checked){background:var(--ink);color:var(--white)}.solution-map__controls label:has(input:focus-visible){outline:3px solid var(--yellow);outline-offset:-3px}.solution-map__controls label:has(input:checked) span{color:var(--yellow)}
  .solution-map__stage{position:relative;display:grid;grid-template-columns:.56fr 1.44fr;min-height:340px;background:var(--rice);overflow:hidden}.solution-map__mascot{position:relative;display:grid;place-items:end center;min-width:0;background:var(--yellow)}.solution-map__mascot::before{content:"";position:absolute;inset:24px;border:1px solid rgb(11 48 69/.22);border-radius:50%}.solution-map__mascot span{position:absolute;top:28px;left:24px;width:54px;height:54px;border:1px solid var(--ink);background:var(--white);transform:rotate(8deg)}.solution-map__mascot span::before,.solution-map__mascot span::after{content:"";position:absolute;background:var(--teal)}.solution-map__mascot span::before{left:12px;right:12px;top:17px;height:2px;box-shadow:0 8px 0 var(--ink)}.solution-map__mascot span::after{right:-10px;bottom:-10px;width:20px;height:20px;background:var(--white);border-right:1px solid var(--ink);border-bottom:1px solid var(--ink)}.solution-map__mascot img{position:relative;z-index:1;width:min(118%,260px);height:auto;object-fit:contain;transform:translateY(18px)}
  .solution-map__panel{display:none;min-width:0;padding:clamp(24px,4vw,42px)}.solution-map__panel:first-of-type{display:block}.solution-map:has(input[value="0"]:checked) [data-map-panel="0"],.solution-map:has(input[value="1"]:checked) [data-map-panel="1"],.solution-map:has(input[value="2"]:checked) [data-map-panel="2"],.solution-map:has(input[value="3"]:checked) [data-map-panel="3"],.solution-map:has(input[value="4"]:checked) [data-map-panel="4"]{display:block}.solution-map:has(input:not([value="0"]):checked) [data-map-panel="0"]{display:none}.solution-map__panel>span{color:var(--teal);font-size:.66rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.solution-map__panel h2{max-width:16ch;margin-top:12px;font-size:clamp(1.25rem,2.3vw,2rem);line-height:1.08}.solution-map__route{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:24px}.solution-map__route i{height:4px;background:var(--teal)}.solution-map__route i:nth-child(2){background:var(--yellow)}.solution-map__route i:nth-child(3){background:var(--ink)}.solution-map__panel dl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;margin:18px 0 0;background:var(--ink-10)}.solution-map__panel dl>div{padding:13px;background:var(--white)}.solution-map__panel dt{color:var(--teal);font-size:.62rem;font-weight:800}.solution-map__panel dd{margin:7px 0 0;color:var(--ink-72);font-size:.69rem;line-height:1.45}.solution-map__panel>a{display:inline-block;margin-top:20px;color:var(--teal);font-size:.76rem;font-weight:800}
  @media(prefers-reduced-motion:no-preference){.solution-map__panel{animation:solution-map-enter .38s cubic-bezier(.16,1,.3,1) both}.solution-map__mascot img{animation:solution-map-mascot 5.4s ease-in-out infinite}@keyframes solution-map-enter{from{opacity:0;transform:translateX(12px)}to{opacity:1;transform:none}}@keyframes solution-map-mascot{0%,100%{transform:translateY(18px) rotate(0)}50%{transform:translateY(12px) rotate(-1.5deg)}}}
  @media(max-width:720px){.solution-map{box-shadow:7px 7px 0 var(--ink)}.solution-map__head{grid-template-columns:1fr}.solution-map__head small{grid-column:1;grid-row:auto}.solution-map__controls{grid-template-columns:repeat(2,1fr)}.solution-map__controls label:nth-child(even){border-right:0}.solution-map__controls label:nth-child(n+3){border-top:1px solid var(--ink-10)}.solution-map__stage{grid-template-columns:1fr}.solution-map__mascot{min-height:190px;place-items:end}.solution-map__mascot::before{inset:20px 26%}.solution-map__mascot img{width:190px}.solution-map__panel h2{max-width:none}.solution-map__panel dl{grid-template-columns:1fr}.solution-map__panel dl>div{display:grid;grid-template-columns:64px 1fr;gap:10px}.solution-map__panel dd{margin:0}}
  @media(prefers-reduced-motion:reduce){.solution-map__controls label,.solution-map__panel,.solution-map__mascot img{animation:none!important;transition:none!important;transform:none!important}}
</style>

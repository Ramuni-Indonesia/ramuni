---
import '../styles/forms-conversion.css';
import { phoneCountries } from '../data/phoneCountries';
import { appCta } from '../data/site';
import CompactLeadFields from './CompactLeadFields.astro';
interface Props {
  kind?: 'early-access' | 'demo' | 'contact';
  submitLabel?: string;
  mode?: 'standard' | 'progressive';
  handoff?: 'thank-you' | 'whatsapp';
  location?: string;
  compact?: boolean;
  variant?: 'standard' | 'chat';
  flow?: 'consultation' | 'trial';
  submitChoices?: boolean;
}
const { kind = 'early-access', submitLabel, mode = 'standard', handoff = 'thank-you', location = 'inline', compact = false, variant = 'standard', flow, submitChoices = false } = Astro.props;
const labels = { 'early-access': 'Ajukan akses', demo: 'Kirim permintaan konsultasi', contact: 'Kirim permintaan konsultasi' };
const endpoint = import.meta.env.PUBLIC_LEAD_ENDPOINT;
const enabled = Boolean(endpoint);
const isProgressive = mode === 'progressive';
const isChat = variant === 'chat';
const phoneCountryData = phoneCountries.map(({ iso, value }) => `${iso}:${value}`).join(',');
---
<form class:list={['lead-form', { 'lead-form--progressive': isProgressive, 'lead-form--compact': compact, 'lead-form--chat': isChat }]} action={enabled ? endpoint : undefined} method="post"
  data-lead-form={kind} data-lead-mode={mode} data-lead-handoff={handoff} data-lead-location={location}
  data-enabled={String(enabled)} data-lead-variant={variant} data-lead-flow={flow} novalidate>
  {isProgressive && !isChat && <ol class="lead-form__steps" aria-label="Langkah formulir konsultasi">
    <li data-step-indicator="1" data-active="true" aria-current="step">Kontak</li><li data-step-indicator="2">Kebutuhan</li><li data-step-indicator="3">Konfirmasi</li>
  </ol>}
  {isChat && <div class="lead-form__chat-history" data-chat-history role="log" aria-live="polite" aria-relevant="additions" aria-label="Riwayat percakapan konsultasi">
    <p class="lead-form__chat-message lead-form__chat-message--agent" data-chat-question="0">Halo, saya bantu arahkan ke tim RAMUNI. Boleh tahu nama Anda?</p>
  </div>}
  {isChat ? (
    <>
      <fieldset class="lead-form__step" data-form-step="1" data-active={isProgressive ? 'true' : undefined} disabled={enabled ? undefined : true}>
        <legend class="visually-hidden">Halo, saya bantu arahkan ke tim RAMUNI. Boleh tahu nama Anda?</legend>
        <div class="chat-composer"><div class="field"><label class="visually-hidden" for={kind + '-' + location + '-name'}>Nama lengkap</label><input id={kind + '-' + location + '-name'} name="name" autocomplete="name" placeholder="Ketik nama Anda" required maxlength="150" /></div><button class="chat-send" type="button" data-progress-next aria-label="Kirim nama"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3.5 4.5 17 7.5-17 7.5 2.1-6.1 8.7-1.4-8.7-1.4-2.1-6.1Z" /></svg></button></div>
      </fieldset>
      <fieldset class="lead-form__step" data-form-step="2" disabled={enabled ? undefined : true}>
        <legend class="visually-hidden">Apa yang paling ingin Anda rapikan atau pahami dari bisnis?</legend>
        <input type="hidden" name="intent" value="support" />
        <div class="chat-composer chat-composer--message"><div class="field field--context"><label class="visually-hidden" for={kind + '-' + location + '-need'}>Kebutuhan utama</label><textarea id={kind + '-' + location + '-need'} name="need" aria-describedby={kind + '-' + location + '-privacy'} placeholder="Contoh: ingin memantau stok dan penjualan" required maxlength="2000"></textarea><small class="visually-hidden" id={kind + '-' + location + '-privacy'}>Jangan masukkan password, token, atau informasi sensitif.</small></div><button class="chat-send" type="button" data-progress-next aria-label="Kirim kebutuhan"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3.5 4.5 17 7.5-17 7.5 2.1-6.1 8.7-1.4-8.7-1.4-2.1-6.1Z" /></svg></button></div>
      </fieldset>
      <fieldset class="lead-form__step" data-form-step="3" disabled={enabled ? undefined : true}>
        <legend class="visually-hidden">Baik. Nomor WhatsApp aktif yang bisa dihubungi?</legend>
        <div class="chat-composer"><div class="field"><label class="visually-hidden" for={kind + '-' + location + '-phone'}>Nomor WhatsApp</label><input id={kind + '-' + location + '-phone'} name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="08xx atau +62xx" required maxlength="24" /></div><button class="chat-send" type="button" data-progress-next aria-label="Kirim nomor WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3.5 4.5 17 7.5-17 7.5 2.1-6.1 8.7-1.4-8.7-1.4-2.1-6.1Z" /></svg></button></div>
      </fieldset>
      <fieldset class="lead-form__step" data-form-step="4" disabled={enabled ? undefined : true}>
        <legend class="visually-hidden">Terakhir, email yang bisa dihubungi?</legend>
        <input type="hidden" name="consent" value="yes" /><input type="hidden" name="leadType" value={kind} /><input type="hidden" name="consentVersion" value="2026-07-25" />
        <div class="chat-composer"><div class="field"><label class="visually-hidden" for={kind + '-' + location + '-email'}>Email</label><input id={kind + '-' + location + '-email'} name="email" type="email" autocomplete="email" placeholder="nama@email.com" required maxlength="254" /></div><button class="chat-send" type="submit" aria-label="Kirim email dan buka WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3.5 4.5 17 7.5-17 7.5 2.1-6.1 8.7-1.4-8.7-1.4-2.1-6.1Z" /></svg></button></div>
        <small class="chat-consent">Dengan mengirim, Anda menyetujui tindak lanjut sesuai <a href="/privasi/">kebijakan privasi</a>. Setelah diterima, WhatsApp akan terbuka dengan pesan yang siap dilengkapi.</small>
      </fieldset>
      <p class="form-status" role="status" aria-live="polite"></p>
    </>
  ) : compact ? (
    <CompactLeadFields kind={kind} location={location} enabled={enabled} submitChoices={submitChoices} />
  ) : (
    <>
      <fieldset class="lead-form__step" data-form-step="1" data-active={isProgressive ? 'true' : undefined} disabled={enabled ? undefined : true}>
        {isProgressive && <legend>Mulai dari kontak yang bisa dihubungi.</legend>}
        <div class="form-grid">
          <div class="field"><label for={kind + '-' + location + '-name'}>Nama lengkap</label><input id={kind + '-' + location + '-name'} name="name" autocomplete="name" placeholder="Nama Anda" required maxlength="150" /></div>
          <div class="field"><label for={kind + '-' + location + '-phone'}>Nomor WhatsApp</label><div class="phone-field-row"><div class="field field--phone-country"><label class="visually-hidden" for={kind + '-' + location + '-phone-country'}>Kode negara</label><select id={kind + '-' + location + '-phone-country'} name="phoneCountry" aria-label="Kode negara" data-phone-countries={phoneCountryData} required><option value="+62" selected>🇮🇩 +62</option></select></div><input id={kind + '-' + location + '-phone'} name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="8123 4567" required maxlength="24" /></div></div>
          <div class="field"><label for={kind + '-' + location + '-email'}>Email</label><input id={kind + '-' + location + '-email'} name="email" type="email" autocomplete="email" placeholder="nama@usaha.com" required maxlength="254" /></div>
          {submitChoices && <div class="field"><label for={kind + '-' + location + '-size'}>Jumlah karyawan</label><select id={kind + '-' + location + '-size'} name="businessSize" required><option value="" disabled selected>Pilih jumlah karyawan</option><option value="1">1 orang</option><option value="2-5">2 sampai 5 orang</option><option value="6-20">6 sampai 20 orang</option><option value="21-50">21 sampai 50 orang</option><option value="51-plus">Lebih dari 50 orang</option></select></div>}
        </div>
      </fieldset>
      <fieldset class="lead-form__step" data-form-step="2" disabled={enabled ? undefined : true}>
        {isProgressive && <legend>Beri konteks minimum agar tim tidak menebak-nebak.</legend>}
        <div class="form-grid">
          {!compact && <div class="field"><label for={kind + '-' + location + '-business'}>Nama usaha</label><input id={kind + '-' + location + '-business'} name="business" autocomplete="organization" placeholder="Contoh: Toko Maju" required maxlength="150" /></div>}
          {!compact && <div class="field"><label for={kind + '-' + location + '-industry'}>Jenis usaha</label><select id={kind + '-' + location + '-industry'} name="industry" required><option value="" disabled selected>Pilih jenis usaha</option><option value="retail">Retail</option><option value="food-beverage">F&amp;B / kuliner</option><option value="distributor">Distributor</option><option value="online-reseller">Reseller online</option><option value="services">Jasa</option><option value="small-manufacturing">Manufaktur kecil</option><option value="other">Lainnya</option></select></div>}
          {!compact && !submitChoices && <div class="field"><label for={kind + '-' + location + '-size'}>Jumlah karyawan</label><select id={kind + '-' + location + '-size'} name="businessSize" required><option value="" disabled selected>Pilih jumlah karyawan</option><option value="1">1 orang</option><option value="2-5">2 sampai 5 orang</option><option value="6-20">6 sampai 20 orang</option><option value="21-50">21 sampai 50 orang</option><option value="51-plus">Lebih dari 50 orang</option></select></div>}
          {!submitChoices && <div class="field"><label for={kind + '-' + location + '-intent'}>Kebutuhan utama</label><select id={kind + '-' + location + '-intent'} name="intent" required><option value="" disabled selected>Pilih kebutuhan</option><option value="overview">Memahami kondisi usaha</option><option value="catalog">Merapikan data produk</option><option value="sales">Memahami penjualan</option><option value="stock">Merapikan stok</option><option value="finance">Membaca laba dan kas</option><option value="customer">Memahami pelanggan</option><option value="report">Merapikan laporan</option><option value="support">Bantuan atau pertanyaan lain</option></select></div>}
        </div>
        <div class="field field--context"><label for={kind + '-' + location + '-need'}>Apa yang ingin Anda pahami?</label><textarea id={kind + '-' + location + '-need'} name="need" aria-describedby={kind + '-' + location + '-privacy'} placeholder="Contoh: Saya ingin melihat alur stok dan penjualan sebelum jam ramai." maxlength="2000" required></textarea><small id={kind + '-' + location + '-privacy'}>Jangan masukkan data pelanggan, transaksi, password, token, atau informasi sensitif.</small></div>
      </fieldset>
      <fieldset class="lead-form__step" data-form-step="3" disabled={enabled ? undefined : true}>
        {isProgressive && <legend>Setujui tindak lanjut sebelum diarahkan ke WhatsApp.</legend>}
        {submitChoices && <input type="hidden" name="consent" value="yes" />}
        {!submitChoices && <><label class="consent-field"><input type="checkbox" name="consent" value="yes" required /><span>Saya setuju informasi ini dipakai untuk menindaklanjuti permintaan sesuai <a href="/privasi/">kebijakan privasi</a>.</span></label>
        <label class="consent-field consent-field--optional"><input type="checkbox" name="marketingConsent" value="yes" /><span>Saya boleh menerima pembaruan produk RAMUNI. Ini opsional.</span></label></>}
        <input type="hidden" name="leadType" value={kind} /><input type="hidden" name="consentVersion" value="2026-07-25" />
      </fieldset>
    </>
  )}
  {!isChat ? <div class:list={['form-actions', { 'lead-form__choice-actions': submitChoices }] }>
    {enabled && isProgressive && <button class="button button--secondary" type="button" data-progress-back hidden>Kembali</button>}
    {enabled && isProgressive && <button class="button button--primary" type="button" data-progress-next>Lanjut</button>}
    {submitChoices ? <>
      {enabled && <button class="button button--primary lead-form__choice-button lead-form__choice-button--consultation" type="submit" name="leadFlow" value="consultation" data-lead-submit-flow="consultation" hidden={isProgressive ? true : undefined}>
        <span>Konsultasi</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5.5h14v10H11l-5 3v-3.5H5v-9.5Zm3.5 4.75h7M8.5 13h4" /></svg>
      </button>}
      <a class="button button--light lead-form__choice-button lead-form__choice-button--trial" href={appCta.href} data-analytics-event="free_trial_click" data-analytics-location={location} data-destination="app" hidden={isProgressive ? true : undefined}>
        <span>{appCta.label}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-5 5 5-5 5" /></svg>
      </a>
    </> : enabled && <button class="button button--primary" type="submit" hidden={isProgressive ? true : undefined}>{submitLabel || labels[kind]}</button>}
    {enabled && <p class="form-status" role="status" aria-live="polite"></p>}
  </div> : null}
</form>
<script is:inline type="module" src="/scripts/lead-form.js"></script>

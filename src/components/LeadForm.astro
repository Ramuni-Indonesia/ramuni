---
interface Props { kind?: 'early-access' | 'demo' | 'contact'; }
const { kind = 'early-access' } = Astro.props;
const labels = { 'early-access': 'Kirim pendaftaran', demo: 'Minta jadwal demo', contact: 'Kirim pesan' };
const isEarlyAccess = kind === 'early-access';
const isContact = kind === 'contact';
const endpoint = import.meta.env.PUBLIC_LEAD_ENDPOINT;
const enabled = Boolean(endpoint);
const consentVersion = '2026-07-25';
---
<form class="lead-form" action={enabled ? endpoint : undefined} method="post" data-lead-form={kind} data-enabled={String(enabled)}>
  <div class="form-grid">
    <div class="field"><label for={`${kind}-name`}>Nama</label><input id={`${kind}-name`} name="name" autocomplete="name" required /></div>
    <div class="field"><label for={`${kind}-email`}>Email bisnis</label><input id={`${kind}-email`} name="email" type="email" autocomplete="email" required /><small>Dipakai hanya untuk menindaklanjuti permintaan.</small></div>
    <div class="field"><label for={`${kind}-business`}>Nama usaha</label><input id={`${kind}-business`} name="business" autocomplete="organization" required /></div>
    {!isContact && !isEarlyAccess && <div class="field"><label for={`${kind}-industry`}>Jenis usaha</label><select id={`${kind}-industry`} name="industry" required><option value="">Pilih jenis usaha</option><option>Retail</option><option>F&B</option><option>Distributor</option><option>Reseller Online</option><option>Jasa</option><option>Manufaktur Kecil</option><option>Lainnya</option></select></div>}
    {!isContact && !isEarlyAccess && <div class="field"><label for={`${kind}-size`}>Ukuran tim</label><select id={`${kind}-size`} name="businessSize" required><option value="">Pilih ukuran tim</option><option value="1">1 orang</option><option value="2-5">2 sampai 5 orang</option><option value="6-20">6 sampai 20 orang</option><option value="21+">Lebih dari 20 orang</option></select></div>}
    {!isContact && <div class="field"><label for={`${kind}-intent`}>Kebutuhan utama</label><select id={`${kind}-intent`} name="intent" required><option value="">Pilih kebutuhan</option><option value="sales">Memahami penjualan</option><option value="stock">Merapikan stok</option><option value="finance">Membaca laba dan kas</option><option value="customer">Memahami pelanggan</option><option value="report">Merapikan laporan</option></select></div>}
  </div>
  <div class="field field--context"><label for={`${kind}-need`}>Konteks singkat</label><textarea id={`${kind}-need`} name="need" aria-describedby={`${kind}-privacy`} placeholder="Contoh: Saya sulit tahu stok mana yang perlu dicek sebelum jam ramai."></textarea><small id={`${kind}-privacy`}>Jangan masukkan data pelanggan, transaksi, atau informasi sensitif.</small></div>
  <label class="consent-field"><input type="checkbox" name="consent" value="yes" required /><span>Saya setuju informasi ini dipakai untuk menindaklanjuti permintaan sesuai <a href="/privasi">kebijakan privasi</a>.</span></label>
  <input type="hidden" name="leadType" value={kind} /><input type="hidden" name="consentVersion" value={consentVersion} />
  <input type="hidden" name="firstTouchAttribution" data-attribution-field="first" />
  <input type="hidden" name="lastTouchAttribution" data-attribution-field="last" />
  {enabled ? <div class="form-actions"><button class="button button--primary" type="submit">{labels[kind]}</button><p class="form-status" role="status" aria-live="polite"></p></div> : <div class="form-unavailable" role="status"><strong>Formulir belum menerima kiriman.</strong><p>Formulir resmi belum tersedia. Gunakan halaman kontak untuk melihat kanal yang sudah aktif.</p></div>}
</form>
{enabled && <script>
  const attributionKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'utm_id', 'gclid', 'gbraid', 'wbraid', 'fbclid', 'msclkid', 'ttclid', 'li_fat_id'];
  const storageKey = 'ramuni-attribution-v1';
  const cleanValue = (value: string) => value.replace(/[\u0000-\u001f\u007f<>]/g, '').slice(0, 180);
  const readStoredAttribution = () => {
    try {
      const stored = JSON.parse(localStorage.getItem(storageKey) || 'null');
      if (!stored || typeof stored !== 'object') return null;
      const cleanTouch = (touch: unknown) => {
        if (!touch || typeof touch !== 'object') return null;
        const source = touch as Record<string, unknown>;
        const cleaned: Record<string, string> = {};
        [...attributionKeys, 'landingPath', 'capturedAt'].forEach((key) => {
          if (typeof source[key] === 'string') cleaned[key] = cleanValue(source[key]);
        });
        return Object.keys(cleaned).length ? cleaned : null;
      };
      return { first: cleanTouch(stored.first), last: cleanTouch(stored.last) };
    } catch { return null; }
  };
  const writeStoredAttribution = (value: unknown) => {
    try { localStorage.setItem(storageKey, JSON.stringify(value)); } catch { /* Attribution still applies to this page view. */ }
  };
  const collectAttribution = () => {
    const params = new URLSearchParams(window.location.search);
    const touch: Record<string, string> = {};
    attributionKeys.forEach((key) => {
      const value = params.get(key);
      if (value) touch[key] = cleanValue(value);
    });
    if (!Object.keys(touch).length) return null;
    return {
      ...touch,
      landingPath: window.location.pathname,
      capturedAt: new Date().toISOString(),
    };
  };
  const currentTouch = collectAttribution();
  const storedAttribution = readStoredAttribution();
  const attribution = {
    first: storedAttribution?.first || currentTouch,
    last: currentTouch || storedAttribution?.last || null,
  };
  if (currentTouch || storedAttribution) writeStoredAttribution(attribution);
  document.querySelectorAll('[data-lead-form][data-enabled="true"]').forEach((form) => {
    if (!(form instanceof HTMLFormElement)) return;
    const firstField = form.querySelector('[data-attribution-field="first"]');
    const lastField = form.querySelector('[data-attribution-field="last"]');
    if (firstField instanceof HTMLInputElement && attribution.first) firstField.value = JSON.stringify(attribution.first);
    if (lastField instanceof HTMLInputElement && attribution.last) lastField.value = JSON.stringify(attribution.last);
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector('button[type="submit"]');
      const status = form.querySelector('.form-status');
      if (!(button instanceof HTMLButtonElement)) return;
      button.disabled = true;
      const original = button.textContent;
      button.textContent = 'Mengirim...';
      if (status) status.textContent = '';
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error('request_failed');
        const kind = form.dataset.leadForm;
        window.dispatchEvent(new CustomEvent('ramuni:lead:accepted', {
          detail: {
            leadType: kind,
            attributionPresent: Boolean(attribution.first || attribution.last),
            acceptedAt: new Date().toISOString(),
          },
        }));
        window.location.assign(`/terima-kasih/${kind === 'contact' ? 'kontak' : kind}`);
      } catch {
        if (status) status.textContent = 'Kiriman belum berhasil. Periksa koneksi lalu coba lagi.';
        button.disabled = false;
        button.textContent = original;
      }
    });
  });
</script>}

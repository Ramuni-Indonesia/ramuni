---
interface DriveCard {
  src: string;
  alt: string;
  eyebrow: string;
  title: string;
  href: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  heading?: string;
  body?: string;
  limit?: number;
}

const {
  id = 'ramuni-component-catalog',
  eyebrow = 'Komponen workspace',
  heading = 'Lihat pekerjaan penting dalam bentuk yang mudah dipindai.',
  body = 'Card di bawah diambil dari workspace RAMUNI dan dipakai sebagai bukti visual untuk tiap alur, bukan dashboard ilustrasi.',
  limit = 4,
} = Astro.props;

const cards: DriveCard[] = [
  { src: '/website-original/marketing/drive/card-1787972978518.webp', alt: 'Card manajemen stok RAMUNI dengan peringatan SKU dan kecepatan jual.', eyebrow: 'Inventori', title: 'Prioritas stok terlihat sebelum rak kosong.', href: '/produk/inventori/' },
  { src: '/website-original/marketing/drive/card-1787991556793.webp', alt: 'Card Asisten AI RAMUNI dengan pertanyaan dan sumber jawaban.', eyebrow: 'Asisten AI', title: 'Tanya kondisi usaha dengan sumber yang jelas.', href: '/produk/asisten-ai/' },
  { src: '/website-original/marketing/drive/card-1787991594833.webp', alt: 'Card Profit Intelligence RAMUNI dengan pendapatan, margin, dan biaya.', eyebrow: 'Profit Intelligence', title: 'Pisahkan omzet, biaya, margin, dan laba.', href: '/produk/laporan-insight/' },
  { src: '/website-original/marketing/drive/card-1787991741271.webp', alt: 'Card ringkasan penjualan RAMUNI dengan transaksi dan status pembayaran.', eyebrow: 'Penjualan', title: 'Perubahan transaksi dapat ditelusuri.', href: '/produk/penjualan/' },
  { src: '/website-original/marketing/drive/card-1787991838265.webp', alt: 'Card laporan mingguan RAMUNI dengan ringkasan dan tindak lanjut.', eyebrow: 'Laporan', title: 'Ringkasan mingguan siap dibahas bersama tim.', href: '/produk/laporan-insight/' },
  { src: '/website-original/marketing/drive/card-1787991862762.webp', alt: 'Card integrasi data RAMUNI dengan status validasi file dan SKU.', eyebrow: 'Integrasi', title: 'Jalur data dan hasil validasi tetap terlihat.', href: '/produk/integrasi/' },
  { src: '/website-original/marketing/drive/card-1787991972418.webp', alt: 'Card Knowledge OS RAMUNI dengan dokumen dan SOP.', eyebrow: 'Knowledge OS', title: 'SOP dan keputusan tidak tercecer.', href: '/features/knowledge-os/' },
  { src: '/website-original/marketing/drive/card-1787991977808.webp', alt: 'Card Inbox dan Pelanggan RAMUNI dengan riwayat dan follow-up.', eyebrow: 'Pelanggan', title: 'Follow-up berangkat dari riwayat yang tersedia.', href: '/produk/pelanggan/' },
].slice(0, Math.max(0, limit));
---

<section id={id} class="drive-card-catalog" aria-labelledby={`${id}-title`}>
  <div class="container">
    <header class="drive-card-catalog__head">
      <div><p class="section-kicker">{eyebrow}</p><h2 id={`${id}-title`}>{heading}</h2></div>
      <p>{body}</p>
    </header>
    <div class="drive-card-catalog__grid">
      {cards.map((card, index) => <a class="drive-card-catalog__card" href={card.href} style={`--i:${index}`}>
        <div class="drive-card-catalog__media"><img src={card.src} width="1408" height="768" alt={card.alt} loading={index < 3 ? 'lazy' : 'lazy'} decoding="async" /></div>
        <div class="drive-card-catalog__copy"><span>{card.eyebrow}</span><strong>{card.title}</strong><b aria-hidden="true">↗</b></div>
      </a>)}
    </div>
  </div>
</section>

<style is:inline>
  .drive-card-catalog{padding:clamp(58px,8vw,106px) 0;background:var(--white);overflow:hidden}
  .drive-card-catalog__head{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,.72fr);gap:clamp(28px,7vw,96px);align-items:end;margin-bottom:30px}.drive-card-catalog__head h2{max-width:20ch;margin-top:10px}.drive-card-catalog__head>p{max-width:48ch;margin:0;color:var(--ink-72);line-height:1.65}
  .drive-card-catalog__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.drive-card-catalog__card{min-width:0;overflow:hidden;border:1px solid var(--ink-10);border-radius:16px;background:var(--rice);color:var(--ink);text-decoration:none;transition:transform .32s var(--ease),border-color .2s,box-shadow .32s var(--ease);animation:drive-card-in .55s var(--ease) both;animation-delay:calc(var(--i,0)*55ms)}.drive-card-catalog__card:hover,.drive-card-catalog__card:focus-visible{border-color:var(--teal);box-shadow:6px 6px 0 var(--yellow);transform:translateY(-4px)}.drive-card-catalog__media{aspect-ratio:16/10;overflow:hidden;background:var(--white);line-height:0}.drive-card-catalog__media img{display:block;width:100%;height:100%;object-fit:cover;object-position:center;transition:transform .55s var(--ease)}.drive-card-catalog__card:hover .drive-card-catalog__media img{transform:scale(1.025)}.drive-card-catalog__copy{display:grid;grid-template-columns:1fr auto;gap:7px 10px;padding:14px 15px 16px}.drive-card-catalog__copy span{grid-column:1/-1;color:var(--teal);font-size:.62rem;font-weight:900;letter-spacing:.09em;text-transform:uppercase}.drive-card-catalog__copy strong{font-size:.84rem;line-height:1.3}.drive-card-catalog__copy b{align-self:end;color:var(--teal);font-size:1rem}
  @keyframes drive-card-in{from{opacity:.2;transform:translateY(10px)}to{opacity:1;transform:none}}
  @media(max-width:980px){.drive-card-catalog__grid{grid-template-columns:repeat(2,minmax(0,1fr))}.drive-card-catalog__head{grid-template-columns:1fr;gap:14px}.drive-card-catalog__head>p{margin-top:-12px}}
  @media(max-width:620px){.drive-card-catalog{padding-block:52px}.drive-card-catalog__grid{grid-template-columns:1fr;gap:12px}.drive-card-catalog__card:hover{transform:none;box-shadow:none}.drive-card-catalog__media{aspect-ratio:16/9}}
  @media(prefers-reduced-motion:reduce){.drive-card-catalog__card,.drive-card-catalog__media img{animation:none;transition:none}.drive-card-catalog__card:hover .drive-card-catalog__media img{transform:none}}
</style>

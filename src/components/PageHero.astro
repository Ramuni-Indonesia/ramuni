---
import HeroContextVisual, { type HeroContextScene } from './HeroContextVisual.astro';
import SupportHeroVisual from './SupportHeroVisual.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  visual?: 'guide' | 'evidence';
  visualScene?: HeroContextScene;
  visualLabel?: string;
  visualTitle?: string;
  compact?: boolean;
}

const {
  eyebrow,
  title,
  description,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  visual,
  visualScene,
  visualLabel = 'Contoh alur',
  visualTitle = 'Catatan dibaca bersama sebelum menentukan arah.',
  compact = false,
} = Astro.props;
const resolvedScene = visualScene ?? (visual === 'evidence' ? 'industry-hub' : 'role-hub');
---
<section class:list={['page-hero', { 'page-hero--visual': visual, 'page-hero--compact': compact }]}>
  <div class:list={['container', 'reveal', 'is-visible', { 'page-hero__layout': visual }]}>
    <div class="page-hero__copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {(primaryLabel || secondaryLabel) && <div class="button-row">
        {primaryLabel && primaryHref && <a class="button button--primary" href={primaryHref}>{primaryLabel}</a>}
        {secondaryLabel && secondaryHref && <a class="button button--secondary" href={secondaryHref}>{secondaryLabel}</a>}
      </div>}
    </div>
    {visual && (
      resolvedScene === 'support'
        ? <SupportHeroVisual label={visualLabel} title={visualTitle} />
        : <HeroContextVisual scene={resolvedScene} label={visualLabel} title={visualTitle} />
    )}
  </div>
</section>

<style>
  .page-hero__copy{min-width:0}.page-hero--visual{overflow:hidden;padding-block:clamp(48px,6vw,90px)}
  .page-hero__layout{display:grid;grid-template-columns:minmax(0,.88fr) minmax(430px,1.12fr);gap:clamp(40px,7vw,104px);align-items:center}
  .page-hero__layout>:global(.hero-context),.page-hero__layout>:global(.support-hero){width:100%;min-width:0}
  .page-hero--visual h1{font-size:var(--type-h1);line-height:1.04;max-width:16ch;text-wrap:balance}
  .page-hero--visual .lede{max-width:48ch}
  .page-hero--visual.page-hero--compact h1{max-width:18ch;font-size:clamp(2.35rem,4.8vw,4.25rem)}
  .page-hero--visual.page-hero--compact :global(.hero-context),.page-hero--visual.page-hero--compact :global(.support-hero){min-height:440px}
  /* Keep tablet in one predictable layout range. The former 961-1080px
     stack followed by a second two-column override squeezed hero copy into
     the remaining space on large tablets. */
  @media(min-width:960px) and (max-width:1199px){
    .page-hero__layout{grid-template-columns:minmax(0,.94fr) minmax(320px,1.06fr);gap:32px}
    .page-hero__layout>:global(.hero-context),.page-hero__layout>:global(.support-hero){width:100%;min-height:360px;justify-self:stretch}
    .page-hero--visual h1{max-width:13ch}
  }
  @media(max-width:959px){
    .page-hero__layout{grid-template-columns:1fr;gap:34px}
    .page-hero--visual h1{max-width:15ch}
    .page-hero__layout>:global(.hero-context),.page-hero__layout>:global(.support-hero){width:min(720px,100%);justify-self:center}
    .page-hero--visual.page-hero--compact :global(.hero-context),.page-hero--visual.page-hero--compact :global(.support-hero){min-height:400px}
  }
  @media(max-width:620px){.page-hero--visual.page-hero--compact :global(.hero-context),.page-hero--visual.page-hero--compact :global(.support-hero){min-height:380px}}
</style>

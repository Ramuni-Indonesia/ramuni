---
import { mascots } from '../data/mascots';
import { releaseGates } from '../config/release';

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  visual?: 'guide' | 'evidence';
  visualLabel?: string;
  visualTitle?: string;
}

const {
  eyebrow,
  title,
  description,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  visual,
  visualLabel = 'Contoh alur',
  visualTitle = 'Catatan dibaca bersama sebelum menentukan arah.',
} = Astro.props;
const requestedVisual = visual === 'evidence' ? mascots.evidence3d : mascots.guide3d;
const visualAsset = releaseGates.mascotExplorationEnabled ? requestedVisual : mascots.decisionVisual;
const visualAlt = releaseGates.mascotExplorationEnabled
  ? `Muni si Manyar ${visual === 'guide' ? 'menunjuk arah pemeriksaan' : 'membantu memeriksa bukti'}`
  : 'Sculpture abstrak Catatan, Bukti, dan Arah RAMUNI';
---
<section class:list={['page-hero', { 'page-hero--visual': visual }]}>
  <div class:list={['container', 'reveal', 'is-visible', { 'page-hero__layout': visual }]}>
    <div class="page-hero__copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {(primaryLabel || secondaryLabel) && <div class="button-row">
        {primaryLabel && primaryHref && <a class="button button--primary" href={primaryHref}>{primaryLabel}</a>}
        {secondaryLabel && secondaryHref && <a class="button button--secondary" href={secondaryHref}>{secondaryLabel}</a>}
      </div>}
    </div>
    {visual && (
      <figure class={`page-hero__visual page-hero__visual--${visual}`}>
        <div class="page-hero__visual-grid" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <img src={visualAsset.src} width={visualAsset.width} height={visualAsset.height} alt={visualAlt} decoding="async" fetchpriority="high" />
        <figcaption><span>{visualLabel}</span><strong>{visualTitle}</strong><small>Data dan alur hanya contoh</small></figcaption>
      </figure>
    )}
  </div>
</section>

<style>
  .page-hero__copy{min-width:0}.page-hero--visual{overflow:hidden;padding-block:clamp(48px,6vw,90px)}
  .page-hero__layout{display:grid;grid-template-columns:minmax(0,.88fr) minmax(430px,1.12fr);gap:clamp(40px,7vw,104px);align-items:center}
  .page-hero--visual h1{font-size:var(--type-h1);line-height:1.04;max-width:16ch;text-wrap:balance}
  .page-hero--visual .lede{max-width:48ch}
  .page-hero__visual{position:relative;min-height:520px;margin:0;background:var(--yellow);border:1px solid var(--ink);overflow:hidden;isolation:isolate;box-shadow:16px 16px 0 var(--ink)}
  .page-hero__visual::before{content:"";position:absolute;z-index:-1;inset:28px;border:1px solid rgb(11 48 69/.18)}
  .page-hero__visual--evidence{background:var(--teal)}
  .page-hero__visual-grid{position:absolute;inset:0;background:linear-gradient(var(--ink-10) 1px,transparent 1px),linear-gradient(90deg,var(--ink-10) 1px,transparent 1px);background-size:46px 46px;opacity:.55}
  .page-hero__visual-grid i{position:absolute;width:11px;height:11px;border-radius:50%;background:var(--ink)}
  .page-hero__visual-grid i:nth-child(1){top:13%;left:10%}.page-hero__visual-grid i:nth-child(2){top:26%;right:9%;background:var(--white)}.page-hero__visual-grid i:nth-child(3){left:18%;bottom:20%;background:var(--teal)}.page-hero__visual--evidence .page-hero__visual-grid i:nth-child(3){background:var(--yellow)}.page-hero__visual-grid i:nth-child(4){right:20%;bottom:12%;background:var(--yellow)}
  .page-hero__visual img{position:absolute;left:4%;right:4%;bottom:82px;width:92%;height:82%;object-fit:contain;object-position:center bottom;filter:drop-shadow(0 24px 22px rgb(11 48 69/.24));transition:transform .55s var(--ease)}
  .page-hero__visual figcaption{position:absolute;z-index:2;left:20px;right:20px;bottom:20px;display:grid;grid-template-columns:auto 1fr;gap:5px 16px;padding:16px 18px;background:rgb(244 240 231/.94);color:var(--ink);backdrop-filter:blur(10px)}
  .page-hero__visual figcaption span{color:var(--teal);font-size:.66rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.page-hero__visual figcaption strong{font-size:.88rem}.page-hero__visual figcaption small{grid-column:1/-1;color:var(--ink-56);font-size:.62rem}
  @media(max-width:1080px){.page-hero__layout{grid-template-columns:1fr}.page-hero--visual h1{max-width:15ch}.page-hero__visual{width:min(720px,100%);min-height:480px;justify-self:center}}
  @media(min-width:961px) and (max-width:1200px){.page-hero__layout{grid-template-columns:minmax(260px,.82fr) minmax(430px,1.18fr);gap:30px}.page-hero__visual{width:100%;min-height:410px;justify-self:stretch}.page-hero__visual img{bottom:72px;height:80%}}
  @media(min-width:1201px) and (hover:hover) and (pointer:fine){.page-hero__visual:hover img{transform:translateY(-7px) rotate(-1deg)}}
  @media(max-width:900px){.page-hero__visual{min-height:440px}}
  @media(max-width:620px){.page-hero__visual{min-height:420px;box-shadow:8px 8px 0 var(--ink)}.page-hero__visual img{height:78%;bottom:96px}.page-hero__visual figcaption{grid-template-columns:1fr}.page-hero__visual figcaption small{grid-column:auto}}
  @media(prefers-reduced-motion:reduce){.page-hero__visual img{transition:none}.page-hero__visual:hover img{transform:none}}
</style>

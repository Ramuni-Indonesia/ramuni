<div class="consent-banner" data-consent-banner hidden>
  <div>
    <strong>Pilih penggunaan cookie.</strong>
    <p>Cookie penting selalu aktif. Analitik dan iklan tetap mati sampai Anda mengizinkannya.</p>
  </div>
  <div class="consent-actions"><button class="button button--secondary" type="button" data-consent-reject>Tolak non-esensial</button><button class="button button--primary" type="button" data-consent-open>Atur pilihan</button></div>
</div>

<dialog class="consent-dialog" data-consent-dialog aria-labelledby="consent-title">
  <form method="dialog">
    <div class="consent-dialog__head"><div><span>Privasi</span><h2 id="consent-title">Pengaturan cookie</h2></div><button type="submit" value="cancel" aria-label="Tutup pengaturan cookie">Tutup</button></div>
    <p>RAMUNI belum memuat alat analitik atau iklan. Pilihan ini menyiapkan izin Anda sebelum integrasi tersebut diaktifkan.</p>
    <div class="consent-choice"><div><strong>Cookie penting</strong><small>Dibutuhkan untuk keamanan dan fungsi dasar.</small></div><input type="checkbox" checked disabled aria-label="Cookie penting selalu aktif" /></div>
    <label class="consent-choice"><div><strong>Analitik</strong><small>Membantu mengukur penggunaan situs tanpa mengirim isi formulir.</small></div><input type="checkbox" name="analytics" /></label>
    <label class="consent-choice"><div><strong>Pemasaran</strong><small>Dipakai untuk pengukuran iklan setelah kanal resmi aktif.</small></div><input type="checkbox" name="marketing" /></label>
    <div class="consent-dialog__actions"><button class="button button--secondary" type="button" data-consent-reject>Tolak non-esensial</button><button class="button button--primary" type="button" data-consent-save>Simpan pilihan</button></div>
  </form>
</dialog>

<script>
  const storageKey = 'ramuni-consent-v1';
  const banner = document.querySelector('[data-consent-banner]');
  const dialog = document.querySelector('[data-consent-dialog]');
  const readChoice = () => {
    try { return JSON.parse(localStorage.getItem(storageKey) || 'null'); } catch { return null; }
  };
  const publish = (choice: { essential: true; analytics: boolean; marketing: boolean }) => {
    try { localStorage.setItem(storageKey, JSON.stringify({ ...choice, savedAt: new Date().toISOString() })); } catch { /* Choice still applies for this page view. */ }
    window.dispatchEvent(new CustomEvent('ramuni:consent', { detail: choice }));
    if (banner instanceof HTMLElement) banner.hidden = true;
    document.body.classList.remove('consent-banner-open');
    if (dialog instanceof HTMLDialogElement) dialog.close();
  };
  const openSettings = () => {
    if (!(dialog instanceof HTMLDialogElement)) return;
    const choice = readChoice();
    const analytics = dialog.querySelector('input[name="analytics"]');
    const marketing = dialog.querySelector('input[name="marketing"]');
    if (analytics instanceof HTMLInputElement) analytics.checked = Boolean(choice?.analytics);
    if (marketing instanceof HTMLInputElement) marketing.checked = Boolean(choice?.marketing);
    dialog.showModal();
  };
  document.querySelectorAll('[data-consent-open], [data-cookie-settings]').forEach((button) => button.addEventListener('click', openSettings));
  document.querySelectorAll('[data-consent-reject]').forEach((button) => button.addEventListener('click', () => publish({ essential: true, analytics: false, marketing: false })));
  document.querySelector('[data-consent-save]')?.addEventListener('click', () => {
    if (!(dialog instanceof HTMLDialogElement)) return;
    const analytics = dialog.querySelector('input[name="analytics"]');
    const marketing = dialog.querySelector('input[name="marketing"]');
    publish({ essential: true, analytics: analytics instanceof HTMLInputElement && analytics.checked, marketing: marketing instanceof HTMLInputElement && marketing.checked });
  });
  if (!readChoice() && banner instanceof HTMLElement) {
    banner.hidden = false;
    document.body.classList.add('consent-banner-open');
  }
</script>

---
import { marketingDashboardContexts, type MarketingDashboardContextKey } from '../data/marketingDashboardContexts';

interface Props {
  context?: MarketingDashboardContextKey;
  priority?: boolean;
}

const { context = 'overview', priority = false } = Astro.props;
const dashboard = marketingDashboardContexts[context] || marketingDashboardContexts.overview;
const metricColumns = dashboard.metrics.slice(0, 3);
---

<div
  class:list={['marketing-dashboard', `marketing-dashboard--${context}`, `marketing-dashboard--${dashboard.layout}`]}
  role="group"
  aria-label={`Visual moneysite RAMUNI untuk konteks ${dashboard.eyebrow}`}
  data-marketing-dashboard
  data-active-index="0"
  data-priority={priority ? 'true' : 'false'}
>
  <header class="marketing-dashboard__topbar">
    <div><span>RAMUNI</span><strong>{dashboard.eyebrow}</strong></div>
    <small>{dashboard.status}</small>
  </header>

  <div class="marketing-dashboard__shell">
    <div class="marketing-dashboard__content">
      {dashboard.layout === 'ai' ? (
        <section class="marketing-dashboard__ai" aria-label="Contoh alur jawaban Asisten AI">
          <div class="marketing-dashboard__ai-question">
            <span>Pertanyaan usaha</span>
            <strong>{dashboard.question || dashboard.subtitle}</strong>
          </div>
          <div class="marketing-dashboard__ai-answer">
            <span>Jawaban RAMUNI</span>
            <p>{dashboard.response || dashboard.insight}</p>
          </div>
          <aside class="marketing-dashboard__ai-evidence" aria-label="Sumber yang dipakai untuk jawaban">
            <header><span>Sumber yang dibaca</span><small>{dashboard.status}</small></header>
            <ol>
              {dashboard.rows.map((row, index) => (
                <li data-dashboard-row={index} class:list={[`is-${row.tone || 'neutral'}`, { 'is-active': index === 0 }]}>
                  <div><strong>{row.label}</strong><small>{row.note}</small></div><b>{row.value}</b>
                </li>
              ))}
            </ol>
          </aside>
          <p class="marketing-dashboard__ai-boundary"><b>Perlu diperiksa:</b> {dashboard.nextAction}</p>
        </section>
      ) : dashboard.layout === 'operations' ? (
        <section class="marketing-dashboard__operations" aria-label="Contoh ruang kerja operasional">
          <header><span>{dashboard.primaryMetric}</span><strong>{dashboard.subtitle}</strong></header>
          <ol>
            {dashboard.rows.map((row, index) => (
              <li data-dashboard-row={index} class:list={[`is-${row.tone || 'neutral'}`, { 'is-active': index === 0 }]}>
                <i aria-hidden="true"></i><div><strong>{row.label}</strong><small>{row.note}</small></div><b>{row.value}</b>
              </li>
            ))}
          </ol>
          <div class="marketing-dashboard__operations-summary" aria-label="Ringkasan contoh">
            {metricColumns.map((metric, index) => <span data-dashboard-metric={index} class:list={{ 'is-active': index === 0 }}><small>{metric.label}</small><strong>{metric.value}</strong></span>)}
          </div>
        </section>
      ) : (
        <>
          <section class="marketing-dashboard__intro" aria-label="Ringkasan konteks dashboard">
            <div><span>{dashboard.primaryMetric}</span><strong class="marketing-dashboard__title">{dashboard.subtitle}</strong></div>
          </section>
          <section class="marketing-dashboard__metrics" aria-label="Indikator contoh">
            {metricColumns.map((metric, index) => (
              <article data-dashboard-metric={index} class:list={[`is-${metric.tone || 'neutral'}`, { 'is-active': index === 0 }]}>
                <span>{metric.label}</span><strong>{metric.value}</strong><small>{metric.note}</small>
              </article>
            ))}
          </section>
          <div class="marketing-dashboard__main">
            <section class="marketing-dashboard__chart" aria-label="Grafik contoh perubahan">
              <header><span>Perubahan terbaca</span><small>{dashboard.segments[dashboard.segments.length - 1]}</small></header>
              <div class="marketing-dashboard__bars">
                {dashboard.bars.map((bar, index) => <span data-dashboard-bar={index} class:list={{ 'is-active': index === dashboard.bars.length - 1 }} style={`--bar:${bar}%`}><i></i><small>{dashboard.segments[index]}</small></span>)}
              </div>
            </section>
            <aside class="marketing-dashboard__insight" aria-label="Wawasan contoh RAMUNI"><span>Wawasan RAMUNI</span><strong>{dashboard.insight}</strong><p>{dashboard.nextAction}</p></aside>
          </div>
        </>
      )}
    </div>
  </div>
  <p class="marketing-dashboard__disclosure">Data contoh untuk menjelaskan alur, bukan hasil pelanggan atau daftar fitur yang dijanjikan.</p>
</div>

<script>
  type DashboardController = {
    bind: () => void;
    destroy: () => void;
  };

  type DashboardWindow = Window & {
    __ramuniMarketingDashboardController?: DashboardController;
  };

  const dashboardWindow = window as DashboardWindow;

  const createDashboardController = (): DashboardController => {
    const dashboards = new Set<HTMLElement>();
    const visibleDashboards = new Set<HTMLElement>();
    const timers = new Map<HTMLElement, number[]>();
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const saveData = Boolean((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData);

    const getCollections = (dashboard: HTMLElement) => ({
      metrics: Array.from(dashboard.querySelectorAll<HTMLElement>('[data-dashboard-metric]')),
      bars: Array.from(dashboard.querySelectorAll<HTMLElement>('[data-dashboard-bar]')),
      rows: Array.from(dashboard.querySelectorAll<HTMLElement>('[data-dashboard-row]')),
    });

    const setActive = (dashboard: HTMLElement, next: number) => {
      const { metrics, bars, rows } = getCollections(dashboard);
      dashboard.dataset.activeIndex = String(next);
      metrics.forEach((item, index) => item.classList.toggle('is-active', index === next % Math.max(metrics.length, 1)));
      bars.forEach((item, index) => item.classList.toggle('is-active', index === next % Math.max(bars.length, 1)));
      rows.forEach((item, index) => item.classList.toggle('is-active', index === next % Math.max(rows.length, 1)));
    };

    const clearSequence = (dashboard: HTMLElement) => {
      (timers.get(dashboard) || []).forEach((timer) => window.clearTimeout(timer));
      timers.delete(dashboard);
    };

    const settle = (dashboard: HTMLElement) => {
      clearSequence(dashboard);
      const { metrics, bars, rows } = getCollections(dashboard);
      const finalIndex = Math.max(metrics.length, bars.length, rows.length, 1) - 1;
      setActive(dashboard, finalIndex);
      dashboard.dataset.motionState = 'rest';
    };

    const play = (dashboard: HTMLElement) => {
      clearSequence(dashboard);
      if (document.hidden || reducedMotion.matches || saveData) {
        settle(dashboard);
        dashboard.dataset.sequencePlayed = 'true';
        return;
      }

      const { metrics, bars, rows } = getCollections(dashboard);
      const itemCount = Math.max(metrics.length, bars.length, rows.length, 1);
      const sequenceSteps = Math.min(itemCount, 4);
      const scheduled: number[] = [];
      dashboard.dataset.motionState = 'playing';
      setActive(dashboard, 0);

      for (let step = 1; step < sequenceSteps; step += 1) {
        scheduled.push(window.setTimeout(() => setActive(dashboard, step), step * 1600));
      }

      scheduled.push(window.setTimeout(() => {
        setActive(dashboard, itemCount - 1);
        dashboard.dataset.motionState = 'rest';
        dashboard.dataset.sequencePlayed = 'true';
        timers.delete(dashboard);
      }, 6400));
      timers.set(dashboard, scheduled);
    };

    const observer = 'IntersectionObserver' in window
      ? new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            const dashboard = entry.target as HTMLElement;
            if (entry.isIntersecting) {
              visibleDashboards.add(dashboard);
              if (dashboard.dataset.sequencePlayed !== 'true') play(dashboard);
            } else {
              visibleDashboards.delete(dashboard);
              clearSequence(dashboard);
            }
          });
        }, { rootMargin: '120px 0px', threshold: 0.18 })
      : undefined;

    const updateForPreference = () => {
      dashboards.forEach((dashboard) => {
        if (reducedMotion.matches || saveData) settle(dashboard);
        else if (visibleDashboards.has(dashboard) && dashboard.dataset.sequencePlayed !== 'true') play(dashboard);
      });
    };

    const updateForVisibility = () => {
      if (document.hidden) {
        dashboards.forEach(clearSequence);
        return;
      }
      visibleDashboards.forEach((dashboard) => {
        if (dashboard.dataset.sequencePlayed !== 'true') play(dashboard);
      });
    };

    const bind = () => {
      document.querySelectorAll<HTMLElement>('[data-marketing-dashboard]').forEach((dashboard) => {
        if (dashboard.dataset.bound === 'true') return;
        dashboard.dataset.bound = 'true';
        dashboards.add(dashboard);
        if (observer) observer.observe(dashboard);
        else {
          visibleDashboards.add(dashboard);
          play(dashboard);
        }
      });
    };

    const destroy = () => {
      observer?.disconnect();
      dashboards.forEach((dashboard) => {
        clearSequence(dashboard);
        delete dashboard.dataset.bound;
      });
      dashboards.clear();
      visibleDashboards.clear();
      document.removeEventListener('visibilitychange', updateForVisibility);
      reducedMotion.removeEventListener?.('change', updateForPreference);
    };

    document.addEventListener('visibilitychange', updateForVisibility);
    reducedMotion.addEventListener?.('change', updateForPreference);
    return { bind, destroy };
  };

  const bindMarketingDashboards = () => {
    dashboardWindow.__ramuniMarketingDashboardController ||= createDashboardController();
    dashboardWindow.__ramuniMarketingDashboardController.bind();
  };

  bindMarketingDashboards();
  document.addEventListener('astro:page-load', bindMarketingDashboards);
  document.addEventListener('astro:before-swap', () => {
    dashboardWindow.__ramuniMarketingDashboardController?.destroy();
    delete dashboardWindow.__ramuniMarketingDashboardController;
  });
</script>

<style>
  .marketing-dashboard{--md-watch:#b96f00;--md-good:#087f6a;min-width:0;overflow:hidden;border:1px solid rgb(11 48 69/.14);background:var(--white);color:var(--ink);contain:layout paint;font-variant-numeric:tabular-nums}
  .marketing-dashboard__topbar{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:11px 15px;background:var(--ink);color:var(--white)}
  .marketing-dashboard__topbar>div{display:flex;align-items:baseline;gap:9px;min-width:0}.marketing-dashboard__topbar span{color:var(--yellow);font-size:.65rem;font-weight:900;letter-spacing:.08em}.marketing-dashboard__topbar strong{font-size:.78rem}.marketing-dashboard__topbar small{color:rgb(255 255 255/.74);font-size:.62rem;font-weight:800}
  .marketing-dashboard__shell{background:var(--rice)}.marketing-dashboard__content{display:grid;gap:12px;min-width:0;padding:14px}.marketing-dashboard__disclosure{margin:0;padding:7px 14px;border-top:1px solid var(--ink-10);color:var(--ink-56);font-size:.62rem;font-weight:700;line-height:1.45}
  .marketing-dashboard__intro span,.marketing-dashboard__operations>header span{color:var(--teal);font-size:.64rem;font-weight:900;text-transform:uppercase;letter-spacing:.08em}.marketing-dashboard__title{display:block;max-width:48ch;margin-top:4px;font-size:clamp(.96rem,1.45vw,1.22rem);line-height:1.25;text-wrap:balance}
  .marketing-dashboard__metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.marketing-dashboard__metrics article{display:grid;align-content:space-between;gap:6px;min-width:0;min-height:78px;padding:10px;border:1px solid var(--ink-10);border-radius:12px;background:var(--white);transition:border-color 220ms var(--ease),background 220ms var(--ease),transform 220ms var(--ease)}.marketing-dashboard [data-dashboard-metric].is-active,.marketing-dashboard [data-dashboard-row].is-active{border-color:var(--teal);background:var(--teal-12);transform:translateY(-2px)}.marketing-dashboard__metrics span{color:var(--ink-72);font-size:.66rem;font-weight:900}.marketing-dashboard__metrics strong{font-size:clamp(1.08rem,2vw,1.55rem);line-height:1}.marketing-dashboard__metrics small{color:var(--ink-56);font-size:.61rem;line-height:1.3}
  .marketing-dashboard__main{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(170px,.8fr);gap:12px;min-width:0}.marketing-dashboard__chart,.marketing-dashboard__insight{min-width:0;border:1px solid var(--ink-10);border-radius:12px}.marketing-dashboard__chart{display:grid;grid-template-rows:auto 116px;padding:12px;background:var(--white)}.marketing-dashboard__chart header{display:flex;justify-content:space-between;gap:12px}.marketing-dashboard__chart header span{font-size:.7rem;font-weight:900}.marketing-dashboard__chart header small{color:var(--ink-56);font-size:.62rem;font-weight:800}
  .marketing-dashboard__bars{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));align-items:end;gap:7px;padding-top:12px}.marketing-dashboard__bars span{display:grid;align-items:end;gap:7px;height:100%;text-align:center}.marketing-dashboard__bars i{display:block;min-height:18px;height:var(--bar);border-radius:7px 7px 3px 3px;background:color-mix(in srgb,var(--teal) 26%,var(--ink));transform-origin:bottom;transition:background 260ms var(--ease),transform 260ms var(--ease)}.marketing-dashboard__bars .is-active i{background:var(--yellow);transform:scaleY(1.05)}.marketing-dashboard__bars small{color:var(--ink-56);font-size:.59rem;font-weight:800;white-space:nowrap}
  .marketing-dashboard__insight{display:grid;align-content:start;gap:10px;padding:13px;background:var(--ink);color:var(--white)}.marketing-dashboard__insight span{color:var(--yellow);font-size:.63rem;font-weight:900;text-transform:uppercase;letter-spacing:.08em}.marketing-dashboard__insight strong{font-size:.82rem;line-height:1.35}.marketing-dashboard__insight p{display:none}
  .marketing-dashboard__ai{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(190px,.88fr);gap:10px}.marketing-dashboard__ai-question,.marketing-dashboard__ai-answer,.marketing-dashboard__ai-evidence,.marketing-dashboard__ai-boundary{min-width:0;border:1px solid var(--ink-10);border-radius:12px;background:var(--white);padding:13px}.marketing-dashboard__ai-question{display:grid;align-content:start;gap:6px}.marketing-dashboard__ai-question span,.marketing-dashboard__ai-answer span,.marketing-dashboard__ai-evidence header span{color:var(--teal);font-size:.62rem;font-weight:900;text-transform:uppercase;letter-spacing:.08em}.marketing-dashboard__ai-question strong{font-size:clamp(.94rem,1.5vw,1.18rem);line-height:1.3}.marketing-dashboard__ai-answer{grid-column:1;display:grid;gap:7px;background:var(--ink);color:var(--white)}.marketing-dashboard__ai-answer span{color:var(--yellow)}.marketing-dashboard__ai-answer p{margin:0;font-size:.79rem;line-height:1.5}.marketing-dashboard__ai-evidence{grid-column:2;grid-row:1/3}.marketing-dashboard__ai-evidence header{display:flex;justify-content:space-between;gap:8px}.marketing-dashboard__ai-evidence header small{color:var(--ink-56);font-size:.59rem;font-weight:800}.marketing-dashboard__ai-evidence ol{display:grid;gap:6px;margin:10px 0 0;padding:0;list-style:none}.marketing-dashboard__ai-evidence li{display:flex;justify-content:space-between;gap:8px;padding:7px;border:1px solid transparent;border-radius:8px;transition:border-color 220ms var(--ease),background 220ms var(--ease),transform 220ms var(--ease)}.marketing-dashboard__ai-evidence strong,.marketing-dashboard__ai-evidence small{display:block}.marketing-dashboard__ai-evidence strong{font-size:.66rem}.marketing-dashboard__ai-evidence small{margin-top:2px;color:var(--ink-56);font-size:.59rem}.marketing-dashboard__ai-evidence b{font-size:.62rem;text-align:right}.marketing-dashboard__ai-boundary{grid-column:1/-1;margin:0;padding-block:9px;color:var(--ink-72);font-size:.67rem}.marketing-dashboard__ai-boundary b{color:var(--ink)}
  .marketing-dashboard__operations{display:grid;gap:11px}.marketing-dashboard__operations>header{display:grid;gap:4px}.marketing-dashboard__operations>header strong{max-width:54ch;font-size:clamp(.92rem,1.4vw,1.14rem);line-height:1.3}.marketing-dashboard__operations ol{display:grid;gap:7px;margin:0;padding:0;list-style:none}.marketing-dashboard__operations li{display:grid;grid-template-columns:24px minmax(0,1fr) auto;gap:10px;align-items:center;padding:9px;border:1px solid transparent;border-radius:10px;background:var(--white);transition:border-color 220ms var(--ease),background 220ms var(--ease),transform 220ms var(--ease)}.marketing-dashboard__operations li>i{width:24px;height:24px;border-radius:7px;background:var(--teal-12)}.marketing-dashboard__operations li strong,.marketing-dashboard__operations li small{display:block}.marketing-dashboard__operations li strong{font-size:.7rem}.marketing-dashboard__operations li small{margin-top:2px;color:var(--ink-56);font-size:.62rem}.marketing-dashboard__operations li b{font-size:.67rem;white-space:nowrap}.marketing-dashboard__operations-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--ink-10)}.marketing-dashboard__operations-summary span{display:grid;gap:4px;min-width:0;padding:10px;background:var(--white)}.marketing-dashboard__operations-summary small{color:var(--ink-56);font-size:.6rem;font-weight:800}.marketing-dashboard__operations-summary strong{font-size:.88rem}
  @media(max-width:960px){.marketing-dashboard__metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.marketing-dashboard__main,.marketing-dashboard__ai{grid-template-columns:1fr}.marketing-dashboard__chart{grid-template-rows:auto 150px}.marketing-dashboard__ai-evidence{grid-column:1;grid-row:auto}.marketing-dashboard__topbar small{display:none}}
  @media(max-width:560px){.marketing-dashboard{border-radius:14px}.marketing-dashboard__content{padding:11px}.marketing-dashboard__metrics,.marketing-dashboard__operations-summary{grid-template-columns:1fr}.marketing-dashboard__metrics article{min-height:76px}.marketing-dashboard__bars{gap:5px}.marketing-dashboard__bars small{font-size:.55rem}.marketing-dashboard__topbar{padding:10px 12px}.marketing-dashboard__disclosure{padding:8px 11px;font-size:.59rem}.marketing-dashboard__ai-question,.marketing-dashboard__ai-answer,.marketing-dashboard__ai-evidence{padding:11px}.marketing-dashboard__operations li{grid-template-columns:22px minmax(0,1fr)}.marketing-dashboard__operations li b{grid-column:2}}
  @media(prefers-reduced-motion:reduce){.marketing-dashboard *{animation:none!important;transition:none!important;transform:none!important}}
</style>

---
import { marketingDashboardContexts, type MarketingDashboardContextKey } from '../data/marketingDashboardContexts';

interface Props {
  context?: MarketingDashboardContextKey;
  compact?: boolean;
  priority?: boolean;
}

const { context = 'overview', compact = false, priority = false } = Astro.props;
const dashboard = marketingDashboardContexts[context] || marketingDashboardContexts.overview;
const metricColumns = compact ? dashboard.metrics.slice(0, 3) : dashboard.metrics;
---

<div
  class:list={['marketing-dashboard', `marketing-dashboard--${context}`, { 'marketing-dashboard--compact': compact }]}
  role="group"
  aria-label={`Visual moneysite RAMUNI untuk konteks ${dashboard.eyebrow}`}
  data-marketing-dashboard
  data-active-index="0"
  data-priority={priority ? 'true' : 'false'}
>
  <header class="marketing-dashboard__topbar">
    <div>
      <span>RAMUNI / {dashboard.eyebrow}</span>
      <strong>{dashboard.title}</strong>
    </div>
    <small>{dashboard.status}</small>
  </header>

  <div class="marketing-dashboard__shell">
    <div class="marketing-dashboard__content">
      <section class="marketing-dashboard__intro" aria-label="Ringkasan konteks dashboard">
        <div>
          <span>{dashboard.primaryMetric}</span>
          <strong class="marketing-dashboard__title">{dashboard.subtitle}</strong>
        </div>
        <p>Visual moneysite · data contoh</p>
      </section>

      <section class="marketing-dashboard__metrics" aria-label="Indikator contoh">
        {metricColumns.map((metric, index) => (
          <article data-dashboard-metric={index} class:list={[`is-${metric.tone || 'neutral'}`, { 'is-active': index === 0 }]}>
            <span>{metric.label}</span>
            <strong>{metric.value}</strong>
            <small>{metric.note}</small>
          </article>
        ))}
      </section>

      <div class="marketing-dashboard__main">
        <section class="marketing-dashboard__chart" aria-label="Grafik contoh perubahan">
          <header><span>Perubahan terbaca</span><small>{dashboard.segments[dashboard.segments.length - 1]}</small></header>
          <div class="marketing-dashboard__bars">
            {dashboard.bars.map((bar, index) => (
              <span data-dashboard-bar={index} class:list={{ 'is-active': index === dashboard.bars.length - 1 }} style={`--bar:${bar}%;--i:${index}`}>
                <i></i><small>{dashboard.segments[index]}</small>
              </span>
            ))}
          </div>
        </section>

        <aside class="marketing-dashboard__insight" aria-label="Wawasan contoh RAMUNI">
          <span>Wawasan RAMUNI</span>
          <strong>{dashboard.insight}</strong>
          <p>{dashboard.nextAction}</p>
        </aside>
      </div>

      <section class="marketing-dashboard__activity" aria-label="Catatan contoh yang mendukung pembacaan">
        <header><span>Catatan pendukung</span><small>Diperbarui 08.15</small></header>
        <ol>
          {dashboard.rows.map((row, index) => (
            <li data-dashboard-row={index} class:list={[`is-${row.tone || 'neutral'}`, { 'is-active': index === 0 }]}>
              <i aria-hidden="true"></i>
              <div><strong>{row.label}</strong><small>{row.note}</small></div>
              <b>{row.value}</b>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </div>
  <p class="marketing-dashboard__disclosure">
    Visual moneysite dengan data rekaan untuk menjelaskan alur, bukan hasil pelanggan atau janji fitur tersedia.
  </p>
</div>

<script>
  type DashboardController = {
    bind: () => void;
    destroy: () => void;
  };

  type DashboardWindow = Window & {
    __ramuniMarketingDashboardController?: DashboardController;
  };

  const dashboardWindow = window as DashboardWindow;

  const createDashboardController = (): DashboardController => {
    const dashboards = new Set<HTMLElement>();
    const visibleDashboards = new Set<HTMLElement>();
    const timers = new Map<HTMLElement, number[]>();
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const saveData = Boolean((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData);

    const getCollections = (dashboard: HTMLElement) => ({
      metrics: Array.from(dashboard.querySelectorAll<HTMLElement>('[data-dashboard-metric]')),
      bars: Array.from(dashboard.querySelectorAll<HTMLElement>('[data-dashboard-bar]')),
      rows: Array.from(dashboard.querySelectorAll<HTMLElement>('[data-dashboard-row]')),
    });

    const setActive = (dashboard: HTMLElement, next: number) => {
      const { metrics, bars, rows } = getCollections(dashboard);
      dashboard.dataset.activeIndex = String(next);
      metrics.forEach((item, index) => item.classList.toggle('is-active', index === next % Math.max(metrics.length, 1)));
      bars.forEach((item, index) => item.classList.toggle('is-active', index === next % Math.max(bars.length, 1)));
      rows.forEach((item, index) => item.classList.toggle('is-active', index === next % Math.max(rows.length, 1)));
    };

    const clearSequence = (dashboard: HTMLElement) => {
      (timers.get(dashboard) || []).forEach((timer) => window.clearTimeout(timer));
      timers.delete(dashboard);
    };

    const settle = (dashboard: HTMLElement) => {
      clearSequence(dashboard);
      const { metrics, bars, rows } = getCollections(dashboard);
      const finalIndex = Math.max(metrics.length, bars.length, rows.length, 1) - 1;
      setActive(dashboard, finalIndex);
      dashboard.dataset.motionState = 'rest';
    };

    const play = (dashboard: HTMLElement) => {
      clearSequence(dashboard);
      if (document.hidden || reducedMotion.matches || saveData) {
        settle(dashboard);
        dashboard.dataset.sequencePlayed = 'true';
        return;
      }

      const { metrics, bars, rows } = getCollections(dashboard);
      const itemCount = Math.max(metrics.length, bars.length, rows.length, 1);
      const sequenceSteps = Math.min(itemCount, 4);
      const scheduled: number[] = [];
      dashboard.dataset.motionState = 'playing';
      setActive(dashboard, 0);

      for (let step = 1; step < sequenceSteps; step += 1) {
        scheduled.push(window.setTimeout(() => setActive(dashboard, step), step * 1600));
      }

      scheduled.push(window.setTimeout(() => {
        setActive(dashboard, itemCount - 1);
        dashboard.dataset.motionState = 'rest';
        dashboard.dataset.sequencePlayed = 'true';
        timers.delete(dashboard);
      }, 6400));
      timers.set(dashboard, scheduled);
    };

    const observer = 'IntersectionObserver' in window
      ? new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            const dashboard = entry.target as HTMLElement;
            if (entry.isIntersecting) {
              visibleDashboards.add(dashboard);
              if (dashboard.dataset.sequencePlayed !== 'true') play(dashboard);
            } else {
              visibleDashboards.delete(dashboard);
              clearSequence(dashboard);
            }
          });
        }, { rootMargin: '120px 0px', threshold: 0.18 })
      : undefined;

    const updateForPreference = () => {
      dashboards.forEach((dashboard) => {
        if (reducedMotion.matches || saveData) settle(dashboard);
        else if (visibleDashboards.has(dashboard) && dashboard.dataset.sequencePlayed !== 'true') play(dashboard);
      });
    };

    const updateForVisibility = () => {
      if (document.hidden) {
        dashboards.forEach(clearSequence);
        return;
      }
      visibleDashboards.forEach((dashboard) => {
        if (dashboard.dataset.sequencePlayed !== 'true') play(dashboard);
      });
    };

    const bind = () => {
      document.querySelectorAll<HTMLElement>('[data-marketing-dashboard]').forEach((dashboard) => {
        if (dashboard.dataset.bound === 'true') return;
        dashboard.dataset.bound = 'true';
        dashboards.add(dashboard);
        if (observer) observer.observe(dashboard);
        else {
          visibleDashboards.add(dashboard);
          play(dashboard);
        }
      });
    };

    const destroy = () => {
      observer?.disconnect();
      dashboards.forEach((dashboard) => {
        clearSequence(dashboard);
        delete dashboard.dataset.bound;
      });
      dashboards.clear();
      visibleDashboards.clear();
      document.removeEventListener('visibilitychange', updateForVisibility);
      reducedMotion.removeEventListener?.('change', updateForPreference);
    };

    document.addEventListener('visibilitychange', updateForVisibility);
    reducedMotion.addEventListener?.('change', updateForPreference);
    return { bind, destroy };
  };

  const bindMarketingDashboards = () => {
    dashboardWindow.__ramuniMarketingDashboardController ||= createDashboardController();
    dashboardWindow.__ramuniMarketingDashboardController.bind();
  };

  bindMarketingDashboards();
  document.addEventListener('astro:page-load', bindMarketingDashboards);
  document.addEventListener('astro:before-swap', () => {
    dashboardWindow.__ramuniMarketingDashboardController?.destroy();
    delete dashboardWindow.__ramuniMarketingDashboardController;
  });
</script>

<style>
  .marketing-dashboard{--md-watch:#b96f00;--md-good:#087f6a;position:relative;min-width:0;margin:0;overflow:hidden;border:1px solid rgb(11 48 69/.14);background:var(--white);color:var(--ink);contain:layout paint;font-variant-numeric:tabular-nums}
  .marketing-dashboard__topbar{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:14px 18px;border-bottom:1px solid var(--ink-10);background:var(--ink);color:var(--white)}
  .marketing-dashboard__topbar>div{display:grid;gap:3px;min-width:0}.marketing-dashboard__topbar span{color:var(--yellow);font-size:.64rem;font-weight:900;text-transform:uppercase;letter-spacing:.08em}.marketing-dashboard__topbar strong{min-width:0;font-size:clamp(.9rem,1.4vw,1.04rem);line-height:1.25;text-wrap:balance}.marketing-dashboard__topbar small{flex:0 0 auto;border:1px solid rgb(255 255 255/.16);border-radius:999px;padding:7px 10px;color:rgb(255 255 255/.74);font-size:.64rem;font-weight:800}
  .marketing-dashboard__shell{min-height:560px;background:var(--rice)}
  .marketing-dashboard__content{min-width:0;padding:clamp(14px,2vw,22px);display:grid;gap:clamp(12px,1.8vw,18px)}
  .marketing-dashboard__intro{display:flex;align-items:start;justify-content:space-between;gap:18px}.marketing-dashboard__intro span{color:var(--teal);font-size:.64rem;font-weight:900;text-transform:uppercase;letter-spacing:.08em}.marketing-dashboard__title{display:block;max-width:48ch;margin-top:5px;font-size:clamp(1rem,1.55vw,1.3rem);line-height:1.25;text-wrap:balance}.marketing-dashboard__intro p{margin:0;color:var(--ink-56);font-size:.64rem;font-weight:800;text-align:right}
  .marketing-dashboard__metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.marketing-dashboard__metrics article{position:relative;display:grid;gap:8px;min-width:0;min-height:118px;align-content:space-between;border:1px solid var(--ink-10);border-radius:14px;background:var(--white);padding:14px;transition:border-color 220ms var(--ease),transform 220ms var(--ease),background 220ms var(--ease)}.marketing-dashboard__metrics article::before{content:"";position:absolute;inset:0 auto 0 0;width:4px;background:transparent}.marketing-dashboard__metrics article.is-active{border-color:var(--teal);background:var(--teal-12);transform:translateY(-2px)}.marketing-dashboard__metrics article.is-active::before{background:var(--teal)}.marketing-dashboard__metrics span{color:var(--ink-72);font-size:.66rem;font-weight:900}.marketing-dashboard__metrics strong{font-size:clamp(1.15rem,2.1vw,1.7rem);line-height:1}.marketing-dashboard__metrics small{color:var(--ink-56);font-size:.64rem;line-height:1.35}.marketing-dashboard__metrics .is-good small,.marketing-dashboard__activity .is-good b{color:var(--md-good)}.marketing-dashboard__metrics .is-watch small,.marketing-dashboard__activity .is-watch b{color:var(--md-watch)}
  .marketing-dashboard__main{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(220px,.65fr);gap:12px;min-width:0}.marketing-dashboard__chart,.marketing-dashboard__insight,.marketing-dashboard__activity{min-width:0;border:1px solid var(--ink-10);border-radius:16px;background:var(--white)}.marketing-dashboard__chart{display:grid;grid-template-rows:auto minmax(180px,1fr);padding:16px}.marketing-dashboard__chart header,.marketing-dashboard__activity header{display:flex;align-items:center;justify-content:space-between;gap:12px}.marketing-dashboard__chart header span,.marketing-dashboard__activity header span{font-size:.7rem;font-weight:900}.marketing-dashboard__chart header small,.marketing-dashboard__activity header small{color:var(--ink-56);font-size:.64rem;font-weight:800}
  .marketing-dashboard__bars{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));align-items:end;gap:8px;padding-top:22px}.marketing-dashboard__bars span{display:grid;gap:8px;align-items:end;min-width:0;height:100%;text-align:center}.marketing-dashboard__bars i{display:block;min-height:24px;height:var(--bar);border-radius:10px 10px 4px 4px;background:color-mix(in srgb,var(--teal) 26%,var(--ink));transform-origin:bottom;transition:background 260ms var(--ease),transform 260ms var(--ease)}.marketing-dashboard__bars .is-active i{background:var(--yellow);transform:scaleY(1.06)}.marketing-dashboard__bars small{color:var(--ink-56);font-size:.62rem;font-weight:800;white-space:nowrap}
  .marketing-dashboard__insight{display:grid;align-content:start;gap:14px;padding:18px;background:var(--ink);color:var(--white)}.marketing-dashboard__insight span{color:var(--yellow);font-size:.64rem;font-weight:900;text-transform:uppercase;letter-spacing:.08em}.marketing-dashboard__insight strong{font-size:clamp(1rem,1.55vw,1.35rem);line-height:1.25;text-wrap:balance}.marketing-dashboard__insight p{margin:0;color:rgb(255 255 255/.72);font-size:.74rem;line-height:1.55}
  .marketing-dashboard__activity{padding:15px}.marketing-dashboard__activity ol{display:grid;gap:8px;margin:12px 0 0;padding:0;list-style:none}.marketing-dashboard__activity li{display:grid;grid-template-columns:28px minmax(0,1fr) auto;gap:12px;align-items:center;min-width:0;border:1px solid transparent;border-radius:12px;padding:10px;background:var(--rice);transition:border-color 220ms var(--ease),background 220ms var(--ease),transform 220ms var(--ease)}.marketing-dashboard__activity li.is-active{border-color:var(--teal);background:var(--white);transform:translateX(3px)}.marketing-dashboard__activity li>i{width:28px;height:28px;border-radius:9px;background:var(--teal-12)}.marketing-dashboard__activity strong,.marketing-dashboard__activity small{display:block;min-width:0}.marketing-dashboard__activity strong{font-size:.7rem;line-height:1.35}.marketing-dashboard__activity small{margin-top:2px;color:var(--ink-56);font-size:.62rem;line-height:1.35}.marketing-dashboard__activity b{font-size:.66rem;white-space:nowrap}
  .marketing-dashboard__disclosure{margin:0;padding:10px 16px;border-top:1px solid var(--ink-10);background:var(--white);color:var(--ink-56);font-size:.64rem;font-weight:700;line-height:1.5}
  .marketing-dashboard--compact .marketing-dashboard__shell{min-height:500px}.marketing-dashboard--compact .marketing-dashboard__metrics{grid-template-columns:repeat(3,minmax(0,1fr))}.marketing-dashboard--compact .marketing-dashboard__main{grid-template-columns:minmax(0,1fr)}.marketing-dashboard--compact .marketing-dashboard__insight{min-height:178px}
  @media(max-width:960px){.marketing-dashboard__shell{min-height:0}.marketing-dashboard__metrics,.marketing-dashboard--compact .marketing-dashboard__metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.marketing-dashboard__main{grid-template-columns:1fr}.marketing-dashboard__chart{grid-template-rows:auto 170px}.marketing-dashboard__intro{display:grid}.marketing-dashboard__intro p{text-align:left}.marketing-dashboard__topbar small{display:none}}
  @media(max-width:560px){.marketing-dashboard{border-radius:16px}.marketing-dashboard__content{padding:12px}.marketing-dashboard__metrics,.marketing-dashboard--compact .marketing-dashboard__metrics{grid-template-columns:1fr}.marketing-dashboard__metrics article{min-height:96px}.marketing-dashboard__bars{gap:5px}.marketing-dashboard__bars small{font-size:.58rem}.marketing-dashboard__activity li{grid-template-columns:24px minmax(0,1fr)}.marketing-dashboard__activity li b{grid-column:2}.marketing-dashboard__topbar{padding:13px 14px}.marketing-dashboard__topbar strong{font-size:.88rem}.marketing-dashboard__disclosure{padding:10px 12px;font-size:.62rem}}
  @media(prefers-reduced-motion:reduce){.marketing-dashboard *{animation:none!important;transition:none!important;transform:none!important}}
</style>

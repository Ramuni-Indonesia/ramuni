---
interface Props {
  class?: string;
  label?: string;
}

const { class: className = '', label = 'Tampilan produk RAMUNI dalam mockup laptop' } = Astro.props;
---

  <span class:list={['ramuni-laptop-mockup', className]} role="img" aria-label={label} data-device-motion="true">
  <span class="ramuni-laptop-frame">
    <picture class="ramuni-device-shell-picture">
      <source media="(max-width: 620px)" srcset="/website-original/product-screens/shots-iphone-17-shell.png" width="401" height="301" />
      <img class="ramuni-laptop-shell-image" src="/website-original/product-screens/ramuni-laptop-shell.webp" width="1600" height="977" alt="" aria-hidden="true" loading="lazy" decoding="async" />
    </picture>
    <span class="ramuni-laptop-screen"><slot /></span>
  </span>
  <span class="ramuni-laptop-hinge" aria-hidden="true"></span>
  <span class="ramuni-laptop-base" aria-hidden="true"></span>
</span>

<style is:inline>
  /* Front-facing product showcase: the real dashboard stays fully readable. */
  .ramuni-laptop-mockup{position:relative;display:block;width:100%;min-width:0;padding:0;isolation:isolate}
  .ramuni-laptop-frame{position:relative;z-index:1;display:block;width:100%;aspect-ratio:1600/977;overflow:hidden;border:0;border-radius:0;background:transparent;box-shadow:none;transform:none;backface-visibility:hidden}
  .ramuni-device-shell-picture{position:absolute;z-index:0;inset:0;display:block;width:100%;height:100%}
  .ramuni-laptop-shell-image{position:absolute;z-index:0;inset:0;display:block;width:100%;height:100%;object-fit:cover;object-position:center}
  .ramuni-laptop-screen{position:absolute;z-index:1;left:9.1%;top:2.45%;width:81.8%;height:86.4%;overflow:hidden;background:var(--rice);box-shadow:none;transform:none}
  .ramuni-laptop-screen>*{min-width:0}
  .ramuni-laptop-screen>.dashboard-motion__screen,.ramuni-laptop-screen>.animated-dashboard-proof,.ramuni-laptop-screen>.tour-evidence-cta__image-frame,.ramuni-laptop-screen>.product-screenshot-card__media{width:100%;height:100%;aspect-ratio:auto!important}
  .ramuni-laptop-screen>.dashboard-motion__screen .dashboard-motion__image,.ramuni-laptop-screen>.animated-dashboard-proof img,.ramuni-laptop-screen>.tour-evidence-cta__image-frame img,.ramuni-laptop-screen>.product-screenshot-card__media img{object-fit:fill;object-position:center;padding:0}
  .ramuni-laptop-hinge,.ramuni-laptop-base{display:none}
  @media (hover:hover) and (pointer:fine){.ramuni-laptop-mockup:hover .ramuni-laptop-frame{transform:none;box-shadow:none}}
  @media(max-width:900px) and (min-width:621px){.ramuni-laptop-mockup{padding-inline:0}.ramuni-laptop-frame{width:min(100%,640px);margin-inline:auto;transform:none}.ramuni-laptop-screen{left:9.1%;top:2.45%;width:81.8%;height:86.4%}.ramuni-laptop-screen>.dashboard-motion,.ramuni-laptop-screen>.animated-dashboard-proof{height:100%;aspect-ratio:4/3!important}.ramuni-laptop-screen>.dashboard-motion .dashboard-motion__screen{height:100%;aspect-ratio:4/3!important}.ramuni-laptop-screen>.tour-evidence-cta__image-frame{height:100%;aspect-ratio:4/3!important}}
  @media(max-width:620px){.ramuni-laptop-mockup{width:min(100%,270px);margin-inline:auto;padding:0}.ramuni-laptop-frame{aspect-ratio:402/874;border-radius:0;background:transparent;box-shadow:none;transform:none}.ramuni-laptop-shell-image{object-fit:cover;object-position:center}.ramuni-laptop-screen{left:10.5%;top:8.8%;width:79%;height:82%;border:0;border-radius:clamp(18px,8vw,28px);background:#f4f7f5;box-shadow:none}.ramuni-laptop-screen::before{content:"";position:absolute;z-index:3;top:6px;left:37%;width:26%;height:12px;border-radius:999px;background:#090d12;pointer-events:none}.ramuni-laptop-screen>.dashboard-motion,.ramuni-laptop-screen>.animated-dashboard-proof{height:100%;aspect-ratio:9/16!important}.ramuni-laptop-screen>.dashboard-motion .dashboard-motion__screen{height:100%;aspect-ratio:9/16!important}.ramuni-laptop-screen>.dashboard-motion__screen .dashboard-motion__image,.ramuni-laptop-screen>.animated-dashboard-proof img,.ramuni-laptop-screen>.tour-evidence-cta__image-frame img,.ramuni-laptop-screen>.product-screenshot-card__media img{object-fit:cover;object-position:top center}.ramuni-laptop-screen>.animated-dashboard-proof .animated-dashboard-proof__picture img{object-fit:cover;object-position:top center}.ramuni-laptop-screen>.tour-evidence-cta__image-frame{height:100%;aspect-ratio:9/16!important}}
  @media(prefers-reduced-motion:reduce){.ramuni-laptop-frame{transition:none}.ramuni-laptop-mockup:hover .ramuni-laptop-frame{transform:none}}
</style>

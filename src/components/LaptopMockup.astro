---
interface Props {
  class?: string;
  label?: string;
  style?: string;
}

const { class: className = '', label = 'Tampilan produk RAMUNI dalam mockup MacBook', style = '' } = Astro.props;
---

<span class:list={['ramuni-laptop-mockup', className]} style={style} role="img" aria-label={label} data-device="macbook">
  <span class="ramuni-laptop-frame">
    <span class="ramuni-laptop-camera" aria-hidden="true"></span>
    <span class="ramuni-laptop-screen"><slot /></span>
  </span>
  <span class="ramuni-laptop-hinge" aria-hidden="true"></span>
  <span class="ramuni-laptop-base" aria-hidden="true"></span>
</span>

<style is:inline>
  /* A restrained, front-facing CSS MacBook shell. The screen is deliberately
     the visual focus: it receives the real RAMUNI capture edge to edge and
     never depends on a third-party mockup image or external URL. */
  .ramuni-laptop-mockup{position:relative;display:block;width:100%;min-width:0;padding:0 0 clamp(7px,1vw,13px);isolation:isolate;--ramuni-screen-fit:cover}
  .ramuni-laptop-frame{position:relative;z-index:1;display:block;width:100%;aspect-ratio:16/10;overflow:hidden;border:1px solid rgb(11 48 69/.16);border-radius:clamp(13px,1.6vw,22px) clamp(13px,1.6vw,22px) 5px 5px;background:linear-gradient(155deg,#f6f9f7 0%,#d9e3e0 54%,#becbc8 100%);box-shadow:0 10px 24px rgb(11 48 69/.1),inset 0 1px rgb(255 255 255/.86);backface-visibility:hidden;transition:transform .3s var(--ease),box-shadow .3s var(--ease)}
  .ramuni-laptop-frame::before{content:"";position:absolute;z-index:0;inset:1.5% 1.45% 10.2%;border-radius:clamp(9px,1.1vw,16px);background:#10252d;box-shadow:inset 0 0 0 1px rgb(255 255 255/.16);pointer-events:none}
  .ramuni-laptop-screen{position:absolute;z-index:1;left:2.25%;top:2.55%;width:95.5%;height:87.15%;overflow:hidden;border:1px solid rgb(11 48 69/.3);border-radius:clamp(7px,1vw,14px);background:#f4f7f5;box-shadow:none;transform:none}
  .ramuni-laptop-camera{position:absolute;z-index:3;top:.45%;left:50%;width:8%;height:1.6%;min-height:4px;border-radius:0 0 999px 999px;background:#10252d;transform:translateX(-50%);pointer-events:none}
  .ramuni-laptop-screen>*{display:block;min-width:0;width:100%;height:100%}
  .ramuni-laptop-screen picture,.ramuni-laptop-screen picture img{display:block;width:100%;height:100%}
  .ramuni-laptop-screen img{object-fit:var(--ramuni-screen-fit);object-position:top center}
  .ramuni-laptop-screen>.dashboard-motion__screen,.ramuni-laptop-screen>.animated-dashboard-proof,.ramuni-laptop-screen>.tour-evidence-cta__image-frame,.ramuni-laptop-screen>.product-screenshot-card__media,.ramuni-laptop-screen>.saas-evidence-card__screen{width:100%;height:100%;aspect-ratio:auto!important}
  .ramuni-laptop-screen>.dashboard-motion__screen .dashboard-motion__image,.ramuni-laptop-screen>.animated-dashboard-proof img,.ramuni-laptop-screen>.tour-evidence-cta__image-frame img,.ramuni-laptop-screen>.product-screenshot-card__media img,.ramuni-laptop-screen>.saas-evidence-card__screen img{width:100%;height:100%;object-fit:var(--ramuni-screen-fit);object-position:top center;padding:0}
  .ramuni-laptop-hinge{position:absolute;z-index:2;left:38%;right:38%;bottom:8.2%;height:1.2%;min-height:3px;border-radius:999px 999px 0 0;background:#b7c4c1;box-shadow:0 -1px rgb(255 255 255/.78);pointer-events:none}
  .ramuni-laptop-base{position:absolute;z-index:3;left:-1.6%;right:-1.6%;bottom:0;height:8.4%;border-radius:0 0 13px 13px;background:linear-gradient(180deg,#e2ebe8 0%,#c2ceca 55%,#aab9b6 100%);box-shadow:inset 0 1px rgb(255 255 255/.82);pointer-events:none}
  .ramuni-laptop-base::before{content:"";position:absolute;left:39%;top:11%;width:22%;height:42%;border-radius:0 0 9px 9px;background:#c3cfcc;box-shadow:inset 0 1px rgb(255 255 255/.62)}
  @media (hover:hover) and (pointer:fine){.ramuni-laptop-mockup:hover .ramuni-laptop-frame{transform:translateY(-2px);box-shadow:0 14px 28px rgb(11 48 69/.13),inset 0 1px rgb(255 255 255/.86)}}
  @media(max-width:900px) and (min-width:621px){.ramuni-laptop-frame{width:min(100%,760px);margin-inline:auto;aspect-ratio:4/3;border-radius:18px 18px 5px 5px}.ramuni-laptop-screen{left:2.2%;top:2.6%;width:95.6%;height:87.3%;border-radius:11px}.ramuni-laptop-camera{width:9%;height:1.5%}.ramuni-laptop-hinge{bottom:8.1%}.ramuni-laptop-base{height:8.4%}}
  @media(max-width:620px){.ramuni-laptop-mockup{width:min(100%,278px);margin-inline:auto;padding:0}.ramuni-laptop-frame{width:100%;aspect-ratio:402/874;border-radius:38px;background:linear-gradient(155deg,#f4f8f6 0%,#d4dfdc 55%,#b7c5c1 100%);box-shadow:0 12px 26px rgb(11 48 69/.12)}.ramuni-laptop-frame::before{inset:1.5%;border-radius:35px;background:#0f2028}.ramuni-laptop-screen{left:5.1%;top:3.8%;width:89.8%;height:92.5%;border:1px solid rgb(11 48 69/.24);border-radius:29px}.ramuni-laptop-camera{top:2.2%;width:29%;height:1.1%;min-height:4px;border-radius:999px;background:#0f2028}.ramuni-laptop-hinge,.ramuni-laptop-base{display:none}.ramuni-laptop-screen>.dashboard-motion,.ramuni-laptop-screen>.animated-dashboard-proof{height:100%;aspect-ratio:9/16!important}.ramuni-laptop-screen>.dashboard-motion__screen{height:100%;aspect-ratio:9/16!important}.ramuni-laptop-screen img{object-fit:cover;object-position:top center}.ramuni-laptop-screen>.dashboard-motion__screen .dashboard-motion__image,.ramuni-laptop-screen>.animated-dashboard-proof img,.ramuni-laptop-screen>.tour-evidence-cta__image-frame img,.ramuni-laptop-screen>.product-screenshot-card__media img,.ramuni-laptop-screen>.saas-evidence-card__screen img{object-fit:cover;object-position:top center}}
  @media(prefers-reduced-motion:reduce){.ramuni-laptop-frame{transition:none}.ramuni-laptop-mockup:hover .ramuni-laptop-frame{transform:none}}
</style>

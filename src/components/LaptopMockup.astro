---
interface Props {
  class?: string;
  label?: string;
}

const { class: className = '', label = 'Tampilan produk RAMUNI dalam mockup laptop' } = Astro.props;
---

<span class:list={['ramuni-laptop-mockup', className]} role="img" aria-label={label} data-device-motion="true">
  <span class="ramuni-laptop-frame">
    <span class="ramuni-laptop-camera" aria-hidden="true"></span>
    <span class="ramuni-laptop-screen"><slot /></span>
  </span>
  <span class="ramuni-laptop-hinge" aria-hidden="true"></span>
  <span class="ramuni-laptop-base" aria-hidden="true"></span>
</span>

<style is:inline>
  .ramuni-laptop-mockup{position:relative;display:block;width:100%;min-width:0;perspective:1400px;isolation:isolate}
  .ramuni-laptop-mockup::after{content:"";position:absolute;z-index:0;left:9%;right:9%;bottom:-5%;height:32%;border-radius:50%;background:linear-gradient(180deg,rgb(11 48 69/.18),transparent 72%);opacity:.5;transform:scaleY(-1);mask-image:linear-gradient(180deg,#000,transparent 72%);pointer-events:none}
  .ramuni-laptop-frame{position:relative;z-index:1;display:block;width:100%;padding:clamp(9px,1.1vw,15px);border:1px solid rgb(11 48 69/.2);border-radius:clamp(12px,1.55vw,22px) clamp(12px,1.55vw,22px) 8px 8px;background:linear-gradient(145deg,#f8faf9 0%,#d5dfe1 58%,#b9c7cb 100%);box-shadow:0 26px 54px rgb(11 48 69/.19),inset 0 1px rgb(255 255 255/.75);transform:rotateY(7deg) rotateX(1.2deg);transform-style:preserve-3d;backface-visibility:hidden}
  .ramuni-laptop-frame::before{content:"";position:absolute;inset:0;border-radius:inherit;background:radial-gradient(ellipse at 24% 10%,rgb(255 255 255/.78),transparent 40%),radial-gradient(ellipse at 80% 88%,rgb(255 255 255/.22),transparent 52%);opacity:.72;pointer-events:none}
  .ramuni-laptop-frame::after{content:"";position:absolute;inset:5px;border:1px solid rgb(255 255 255/.35);border-radius:inherit;pointer-events:none}
  .ramuni-laptop-camera{position:absolute;z-index:3;top:5px;left:50%;width:5px;height:5px;border-radius:50%;background:#27333a;box-shadow:0 0 0 2px rgb(39 51 58/.08);transform:translateX(-50%)}
  .ramuni-laptop-screen{position:relative;display:block;width:100%;min-width:0;overflow:hidden;border:1px solid rgb(11 48 69/.3);border-radius:clamp(4px,.55vw,8px);background:var(--ink);box-shadow:0 4px 0 rgb(11 48 69/.14),0 0 0 1px rgb(255 255 255/.22);transform:translateZ(6px)}
  .ramuni-laptop-screen>*{min-width:0}
  .ramuni-laptop-hinge{display:block;width:14%;height:4px;margin:-1px auto 0;border-radius:0 0 7px 7px;background:#aab8bd;box-shadow:0 2px 3px rgb(11 48 69/.14)}
  .ramuni-laptop-base{display:block;width:108%;height:clamp(9px,1.15vw,16px);margin:-1px auto 0;border-radius:0 0 12px 12px;background:linear-gradient(#d9e2e3,#adbcc1);box-shadow:0 10px 18px rgb(11 48 69/.15),inset 0 1px rgb(255 255 255/.65);clip-path:polygon(2% 0,98% 0,100% 72%,91% 100%,9% 100%,0 72%);transform:translateZ(-2px)}
  @keyframes ramuni-device-turntable{0%,100%{transform:rotateY(6deg) rotateX(1.1deg)}50%{transform:rotateY(8deg) rotateX(1.5deg)}}
  @media(prefers-reduced-motion:no-preference){.ramuni-laptop-mockup[data-device-motion='true'] .ramuni-laptop-frame{animation:ramuni-device-turntable 10s ease-in-out infinite alternate}}
  @media(max-width:900px) and (min-width:621px){.ramuni-laptop-frame{width:min(100%,520px);margin-inline:auto;padding:10px;border-radius:22px;transform:rotateY(3deg) rotateX(.6deg)}.ramuni-laptop-screen{aspect-ratio:4/3;border-radius:12px}.ramuni-laptop-camera{top:5px;width:4px;height:4px}.ramuni-laptop-hinge,.ramuni-laptop-base{display:none}.ramuni-laptop-screen>.dashboard-motion,.ramuni-laptop-screen>.animated-dashboard-proof{height:100%;aspect-ratio:4/3!important}.ramuni-laptop-screen>.dashboard-motion .dashboard-motion__screen{aspect-ratio:4/3!important}.ramuni-laptop-screen>.tour-evidence-cta__image-frame{height:100%;aspect-ratio:4/3!important}}
  @media(max-width:620px){.ramuni-laptop-mockup{width:min(100%,240px);margin-inline:auto}.ramuni-laptop-mockup::after{display:none}.ramuni-laptop-frame{aspect-ratio:9/16;padding:10px 8px 12px;border-radius:28px;background:linear-gradient(145deg,#f5f8f8,#cbd6db);box-shadow:0 22px 44px rgb(11 48 69/.18);transform:rotateY(-4deg) rotateX(.8deg)}.ramuni-laptop-screen{height:100%;aspect-ratio:auto;border-radius:20px;background:#f4f7f5;transform:translateZ(4px)}.ramuni-laptop-camera{top:6px;width:36px;height:4px;border-radius:99px;background:#27333a}.ramuni-laptop-hinge,.ramuni-laptop-base{display:none}.ramuni-laptop-screen>.dashboard-motion,.ramuni-laptop-screen>.animated-dashboard-proof{height:100%;aspect-ratio:9/16!important}.ramuni-laptop-screen>.dashboard-motion .dashboard-motion__screen{height:100%;aspect-ratio:9/16!important}.ramuni-laptop-screen>.animated-dashboard-proof .animated-dashboard-proof__picture img{object-fit:cover;object-position:top center}.ramuni-laptop-screen>.tour-evidence-cta__image-frame{height:100%;aspect-ratio:9/16!important}}
  @media(prefers-reduced-motion:reduce){.ramuni-laptop-mockup[data-device-motion='true'] .ramuni-laptop-frame{animation:none;transform:rotateY(3deg) rotateX(.6deg)}}
</style>

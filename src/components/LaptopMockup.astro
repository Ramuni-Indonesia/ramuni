---
interface Props {
  class?: string;
  label?: string;
}

const { class: className = '', label = 'Tampilan produk RAMUNI dalam mockup MacBook' } = Astro.props;
---

<span class:list={['ramuni-laptop-mockup', className]} role="img" aria-label={label} data-device="macbook" data-device-motion="true">
  <span class="ramuni-laptop-frame">
    <span class="ramuni-laptop-screen"><slot /></span>
  </span>
  <span class="ramuni-laptop-hinge" aria-hidden="true"></span>
  <span class="ramuni-laptop-base" aria-hidden="true"></span>
</span>

<style is:inline>
  /* CSS-only device shell: no third-party UI is baked into the chassis. */
  .ramuni-laptop-mockup{position:relative;display:block;width:100%;min-width:0;padding:0;isolation:isolate}
  .ramuni-laptop-frame{position:relative;z-index:1;display:block;width:100%;aspect-ratio:16/10;overflow:visible;border:0;border-radius:clamp(14px,1.8vw,28px) clamp(14px,1.8vw,28px) 6px 6px;background:linear-gradient(145deg,#16232a 0%,#071017 45%,#020509 100%);box-shadow:inset 0 1px rgb(255 255 255/.22);transform:none;backface-visibility:hidden;transition:transform .32s var(--ease)}
  .ramuni-laptop-frame::before{content:"";position:absolute;z-index:0;inset:1.4% 1.4% 13.5%;border-radius:clamp(9px,1.2vw,18px);background:#02070b;box-shadow:inset 0 0 0 1px rgb(255 255 255/.12);pointer-events:none}
  .ramuni-laptop-screen{position:absolute;z-index:1;left:2.8%;top:3.4%;width:94.4%;height:81.2%;overflow:hidden;border:1px solid rgb(255 255 255/.12);border-radius:clamp(8px,1.1vw,16px);background:#f4f7f5;box-shadow:none;transform:none}
  .ramuni-laptop-screen::before{content:"";position:absolute;z-index:5;top:-1px;left:43.5%;width:13%;height:4.8%;min-height:9px;border-radius:0 0 10px 10px;background:#020509;box-shadow:0 1px 0 rgb(255 255 255/.08);pointer-events:none}
  .ramuni-laptop-screen>*{display:block;min-width:0;width:100%;height:100%}
  .ramuni-laptop-screen picture,.ramuni-laptop-screen picture img{display:block;width:100%;height:100%}
  .ramuni-laptop-screen>.dashboard-motion__screen,.ramuni-laptop-screen>.animated-dashboard-proof,.ramuni-laptop-screen>.tour-evidence-cta__image-frame,.ramuni-laptop-screen>.product-screenshot-card__media{width:100%;height:100%;aspect-ratio:auto!important}
  .ramuni-laptop-screen>.dashboard-motion__screen .dashboard-motion__image,.ramuni-laptop-screen>.animated-dashboard-proof img,.ramuni-laptop-screen>.tour-evidence-cta__image-frame img,.ramuni-laptop-screen>.product-screenshot-card__media img{width:100%;height:100%;object-fit:cover;object-position:top center;padding:0}
  .ramuni-laptop-hinge{position:absolute;z-index:2;left:38%;right:38%;bottom:11.5%;height:2.4%;border-radius:999px 999px 0 0;background:linear-gradient(180deg,#aab8bb,#3d4d53 70%,#111b20);box-shadow:0 -1px 0 rgb(255 255 255/.35);pointer-events:none}
  .ramuni-laptop-base{position:absolute;z-index:3;left:-1.8%;right:-1.8%;bottom:0;height:12.5%;border-radius:0 0 18px 18px;background:linear-gradient(180deg,#819398 0%,#4a5a60 28%,#1f2d33 75%,#0c151a 100%);box-shadow:inset 0 1px rgb(255 255 255/.3);pointer-events:none}
  .ramuni-laptop-base::before{content:"";position:absolute;left:39%;top:11%;width:22%;height:38%;border-radius:0 0 12px 12px;background:linear-gradient(180deg,#b8c5c7,#56676c);box-shadow:inset 0 1px rgb(255 255 255/.42)}
  @media (hover:hover) and (pointer:fine){.ramuni-laptop-mockup:hover .ramuni-laptop-frame{transform:translateY(-2px)}}
  @media(max-width:900px) and (min-width:621px){.ramuni-laptop-mockup{padding-inline:0}.ramuni-laptop-frame{width:min(100%,760px);margin-inline:auto}.ramuni-laptop-screen{left:2.8%;top:3.4%;width:94.4%;height:81.2%}.ramuni-laptop-hinge{bottom:11.5%}.ramuni-laptop-base{height:12.5%}}
  @media(max-width:620px){.ramuni-laptop-mockup{width:min(100%,270px);margin-inline:auto;padding:0}.ramuni-laptop-frame{aspect-ratio:402/874;border-radius:46px;background:linear-gradient(145deg,#1d2931,#050a0e 55%,#020509);box-shadow:inset 0 1px rgb(255 255 255/.22)}.ramuni-laptop-frame::before{inset:2.1%;border-radius:40px;background:#020509}.ramuni-laptop-screen{left:5.5%;top:4.1%;width:89%;height:91.8%;border-radius:34px;border-width:1px}.ramuni-laptop-screen::before{top:1.2%;left:31%;width:38%;height:3.1%;min-height:10px;border-radius:0 0 14px 14px}.ramuni-laptop-hinge,.ramuni-laptop-base{display:none}.ramuni-laptop-screen>.dashboard-motion,.ramuni-laptop-screen>.animated-dashboard-proof{height:100%;aspect-ratio:9/16!important}.ramuni-laptop-screen>.dashboard-motion .dashboard-motion__screen{height:100%;aspect-ratio:9/16!important}.ramuni-laptop-screen>.tour-evidence-cta__image-frame{height:100%;aspect-ratio:9/16!important}.ramuni-laptop-screen>.dashboard-motion__screen .dashboard-motion__image,.ramuni-laptop-screen>.animated-dashboard-proof img,.ramuni-laptop-screen>.tour-evidence-cta__image-frame img,.ramuni-laptop-screen>.product-screenshot-card__media img{object-fit:cover;object-position:top center}.ramuni-laptop-screen>.animated-dashboard-proof .animated-dashboard-proof__picture img{object-fit:cover;object-position:top center}}
  @media(prefers-reduced-motion:reduce){.ramuni-laptop-frame{transition:none}.ramuni-laptop-mockup:hover .ramuni-laptop-frame{transform:none}}
</style>

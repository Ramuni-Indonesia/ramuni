---
interface Props {
  class?: string;
  label?: string;
}

const { class: className = '', label = 'Tampilan produk RAMUNI dalam mockup laptop' } = Astro.props;
---

<span class:list={['ramuni-laptop-mockup', className]} role="img" aria-label={label}>
  <span class="ramuni-laptop-frame">
    <span class="ramuni-laptop-camera" aria-hidden="true"></span>
    <span class="ramuni-laptop-screen"><slot /></span>
  </span>
  <span class="ramuni-laptop-hinge" aria-hidden="true"></span>
  <span class="ramuni-laptop-base" aria-hidden="true"></span>
</span>

<style is:inline>
  @media(max-width:900px) and (min-width:621px){.ramuni-laptop-frame{width:min(100%,520px);margin-inline:auto;padding:10px;border-radius:22px;background:linear-gradient(145deg,#e9eef0,#cfd9dd)}.ramuni-laptop-screen{aspect-ratio:4/3;border-radius:12px}.ramuni-laptop-camera{top:5px;width:4px;height:4px}.ramuni-laptop-hinge,.ramuni-laptop-base{display:none}.ramuni-laptop-screen>.dashboard-motion,.ramuni-laptop-screen>.animated-dashboard-proof{height:100%;aspect-ratio:4/3!important}.ramuni-laptop-screen>.dashboard-motion .dashboard-motion__screen{aspect-ratio:4/3!important}.ramuni-laptop-screen>.tour-evidence-cta__image-frame{height:100%;aspect-ratio:4/3!important}}
  @media(max-width:620px){.ramuni-laptop-mockup{width:min(100%,240px);margin-inline:auto}.ramuni-laptop-frame{aspect-ratio:9/16;padding:10px 8px 12px;border-radius:28px;background:linear-gradient(145deg,#e9eef0,#cbd6db);box-shadow:0 18px 38px rgb(11 48 69/.16)}.ramuni-laptop-screen{height:100%;aspect-ratio:auto;border-radius:20px;background:#f4f7f5}.ramuni-laptop-camera{top:6px;width:36px;height:4px;border-radius:99px;background:#27333a}.ramuni-laptop-hinge,.ramuni-laptop-base{display:none}.ramuni-laptop-screen>.dashboard-motion,.ramuni-laptop-screen>.animated-dashboard-proof{height:100%;aspect-ratio:9/16!important}.ramuni-laptop-screen>.dashboard-motion .dashboard-motion__screen{height:100%;aspect-ratio:9/16!important}.ramuni-laptop-screen>.animated-dashboard-proof .animated-dashboard-proof__frame,.ramuni-laptop-screen>.animated-dashboard-proof .animated-dashboard-proof__fallback{object-fit:contain}.ramuni-laptop-screen>.tour-evidence-cta__image-frame{height:100%;aspect-ratio:9/16!important}}
</style>

---
interface Props {
  class?: string;
  label?: string;
}

const { class: className = '', label = 'Tampilan produk RAMUNI dalam mockup laptop' } = Astro.props;
---

<span class:list={['ramuni-laptop-mockup', className]} role="img" aria-label={label}>
  <span class="ramuni-laptop-frame">
    <span class="ramuni-laptop-camera" aria-hidden="true"></span>
    <span class="ramuni-laptop-screen"><slot /></span>
  </span>
  <span class="ramuni-laptop-hinge" aria-hidden="true"></span>
  <span class="ramuni-laptop-base" aria-hidden="true"></span>
</span>

<style is:inline>
  .ramuni-laptop-mockup{display:block;width:100%;min-width:0}
  .ramuni-laptop-frame{position:relative;display:block;width:100%;padding:clamp(9px,1.1vw,15px) clamp(9px,1.1vw,15px) clamp(8px,1vw,13px);border:1px solid rgb(11 48 69/.16);border-radius:clamp(12px,1.55vw,22px) clamp(12px,1.55vw,22px) 8px 8px;background:linear-gradient(145deg,#eef2f3,#d6dde0);box-shadow:0 20px 48px rgb(11 48 69/.15)}
  .ramuni-laptop-camera{position:absolute;z-index:2;top:5px;left:50%;width:5px;height:5px;border-radius:50%;background:#27333a;transform:translateX(-50%)}
  .ramuni-laptop-screen{display:block;width:100%;min-width:0;overflow:hidden;border:1px solid rgb(11 48 69/.2);border-radius:clamp(4px,.55vw,8px);background:var(--ink)}
  .ramuni-laptop-screen>*{min-width:0}
  .ramuni-laptop-hinge{display:block;width:14%;height:4px;margin:-1px auto 0;border-radius:0 0 7px 7px;background:#c3cdd1}
  .ramuni-laptop-base{display:block;width:108%;height:clamp(9px,1.15vw,16px);margin:-1px auto 0;border-radius:0 0 12px 12px;background:linear-gradient(#d9e0e2,#bdc8cc);box-shadow:0 8px 15px rgb(11 48 69/.13);clip-path:polygon(2% 0,98% 0,100% 72%,91% 100%,9% 100%,0 72%)}
  @media(max-width:900px) and (min-width:621px){.ramuni-laptop-frame{width:min(100%,520px);margin-inline:auto;padding:10px;border-radius:22px;background:linear-gradient(145deg,#e9eef0,#cfd9dd)}.ramuni-laptop-screen{aspect-ratio:4/3;border-radius:12px}.ramuni-laptop-camera{top:5px;width:4px;height:4px}.ramuni-laptop-hinge,.ramuni-laptop-base{display:none}.ramuni-laptop-screen>.dashboard-motion,.ramuni-laptop-screen>.animated-dashboard-proof{height:100%;aspect-ratio:4/3!important}.ramuni-laptop-screen>.dashboard-motion .dashboard-motion__screen{aspect-ratio:4/3!important}.ramuni-laptop-screen>.tour-evidence-cta__image-frame{height:100%;aspect-ratio:4/3!important}}
  @media(max-width:620px){.ramuni-laptop-mockup{width:min(100%,240px);margin-inline:auto}.ramuni-laptop-frame{aspect-ratio:9/16;padding:10px 8px 12px;border-radius:28px;background:linear-gradient(145deg,#e9eef0,#cbd6db);box-shadow:0 18px 38px rgb(11 48 69/.16)}.ramuni-laptop-screen{height:100%;aspect-ratio:auto;border-radius:20px;background:#f4f7f5}.ramuni-laptop-camera{top:6px;width:36px;height:4px;border-radius:99px;background:#27333a}.ramuni-laptop-hinge,.ramuni-laptop-base{display:none}.ramuni-laptop-screen>.dashboard-motion,.ramuni-laptop-screen>.animated-dashboard-proof{height:100%;aspect-ratio:9/16!important}.ramuni-laptop-screen>.dashboard-motion .dashboard-motion__screen{height:100%;aspect-ratio:9/16!important}.ramuni-laptop-screen>.animated-dashboard-proof .animated-dashboard-proof__picture img{object-fit:cover;object-position:top center}.ramuni-laptop-screen>.tour-evidence-cta__image-frame{height:100%;aspect-ratio:9/16!important}}
</style>

---
interface Props {
  class?: string;
  label?: string;
  style?: string;
}

const { class: className = '', label = 'Tampilan produk RAMUNI dalam mockup MacBook', style = '' } = Astro.props;
---

<span class:list={['ramuni-laptop-mockup', className]} style={style} role="img" aria-label={label} data-device="macbook" data-device-motion="true">
  <span class="ramuni-laptop-frame">
    <span class="ramuni-laptop-screen"><slot /></span>
  </span>
  <span class="ramuni-laptop-hinge" aria-hidden="true"></span>
  <span class="ramuni-laptop-base" aria-hidden="true"></span>
</span>

<style is:inline>
  /* CSS-only MacBook Air / iPhone 17 style shell. The screen is always filled by
     the supplied RAMUNI UI; no external mockup image is loaded. */
  .ramuni-laptop-mockup{position:relative;display:block;width:100%;min-width:0;padding:0;isolation:isolate}
  .ramuni-laptop-frame{position:relative;z-index:1;display:block;width:100%;aspect-ratio:var(--ramuni-device-aspect,var(--dashboard-aspect,16/10));overflow:visible;border:1px solid rgb(11 48 69/.18);border-radius:clamp(14px,1.8vw,28px) clamp(14px,1.8vw,28px) 6px 6px;background:linear-gradient(145deg,#eef4f1 0%,#bdc9c9 48%,#8b999b 100%);box-shadow:inset 0 1px rgb(255 255 255/.82);backface-visibility:hidden;transition:transform .32s var(--ease)}
  .ramuni-laptop-frame::before{content:"";position:absolute;z-index:0;inset:1.2% 1.1% 13.4%;border-radius:clamp(10px,1.2vw,18px);background:#172329;box-shadow:inset 0 0 0 1px rgb(255 255 255/.22);pointer-events:none}
  .ramuni-laptop-screen{position:absolute;z-index:1;left:1.8%;top:2.5%;width:96.4%;height:83.4%;overflow:hidden;border:1px solid rgb(255 255 255/.5);border-radius:clamp(9px,1.2vw,18px);background:#f4f7f5;box-shadow:none;transform:none}
  .ramuni-laptop-screen::before{content:"";position:absolute;z-index:5;top:-1px;left:44.3%;width:11.4%;height:4.3%;min-height:9px;border-radius:0 0 12px 12px;background:#172329;box-shadow:0 1px 0 rgb(255 255 255/.12);pointer-events:none}
  .ramuni-laptop-screen>*{display:block;min-width:0;width:100%;height:100%}
  .ramuni-laptop-screen picture,.ramuni-laptop-screen picture img{display:block;width:100%;height:100%}
  .ramuni-laptop-screen>.dashboard-motion__screen,.ramuni-laptop-screen>.animated-dashboard-proof,.ramuni-laptop-screen>.tour-evidence-cta__image-frame,.ramuni-laptop-screen>.product-screenshot-card__media{width:100%;height:100%;aspect-ratio:auto!important}
  .ramuni-laptop-screen>.dashboard-motion__screen .dashboard-motion__image,.ramuni-laptop-screen>.animated-dashboard-proof img,.ramuni-laptop-screen>.tour-evidence-cta__image-frame img,.ramuni-laptop-screen>.product-screenshot-card__media img{width:100%;height:100%;object-fit:contain;object-position:top center;padding:0}
  .ramuni-laptop-hinge{position:absolute;z-index:2;left:37%;right:37%;bottom:11.3%;height:2%;border-radius:999px 999px 0 0;background:linear-gradient(180deg,#e8eeee,#a4b0b1);box-shadow:0 -1px 0 rgb(255 255 255/.8);pointer-events:none}
  .ramuni-laptop-base{position:absolute;z-index:3;left:-1.8%;right:-1.8%;bottom:0;height:12.5%;border-radius:0 0 18px 18px;background:linear-gradient(180deg,#dce5e3 0%,#b3c0bf 34%,#899899 100%);box-shadow:inset 0 1px rgb(255 255 255/.75);pointer-events:none}
  .ramuni-laptop-base::before{content:"";position:absolute;left:39%;top:12%;width:22%;height:38%;border-radius:0 0 12px 12px;background:linear-gradient(180deg,#d7e1df,#9aa8a9);box-shadow:inset 0 1px rgb(255 255 255/.55)}
  @media (hover:hover) and (pointer:fine){.ramuni-laptop-mockup:hover .ramuni-laptop-frame{transform:translateY(-2px)}}
  @media(max-width:900px) and (min-width:621px){.ramuni-laptop-mockup{padding-inline:0}.ramuni-laptop-frame{width:min(100%,760px);margin-inline:auto}.ramuni-laptop-screen{left:1.8%;top:2.5%;width:96.4%;height:83.4%}}
  @media(max-width:620px){.ramuni-laptop-mockup{width:min(100%,278px);margin-inline:auto;padding:0}.ramuni-laptop-frame{aspect-ratio:402/874;border:1px solid rgb(11 48 69/.24);border-radius:54px;background:linear-gradient(145deg,#f0f3f0 0%,#b9c4c3 48%,#718083 100%);box-shadow:inset 0 1px rgb(255 255 255/.9)}.ramuni-laptop-frame::before{inset:1.7%;border-radius:48px;background:#172329;box-shadow:inset 0 0 0 1px rgb(255 255 255/.18)}.ramuni-laptop-screen{left:3.7%;top:2.4%;width:92.6%;height:95.1%;border-radius:45px;border-width:1px}.ramuni-laptop-screen::before{top:1.25%;left:30%;width:40%;height:3.4%;min-height:12px;border-radius:0 0 16px 16px;background:#172329}.ramuni-laptop-hinge,.ramuni-laptop-base{display:none}.ramuni-laptop-screen>.dashboard-motion,.ramuni-laptop-screen>.animated-dashboard-proof{height:100%;aspect-ratio:9/16!important}.ramuni-laptop-screen>.dashboard-motion .dashboard-motion__screen{height:100%;aspect-ratio:9/16!important}.ramuni-laptop-screen>.tour-evidence-cta__image-frame{height:100%;aspect-ratio:9/16!important}.ramuni-laptop-screen>.dashboard-motion__screen .dashboard-motion__image,.ramuni-laptop-screen>.animated-dashboard-proof img,.ramuni-laptop-screen>.tour-evidence-cta__image-frame img,.ramuni-laptop-screen>.product-screenshot-card__media img{object-fit:contain;object-position:top center}.ramuni-laptop-screen>.animated-dashboard-proof .animated-dashboard-proof__picture img{object-fit:contain;object-position:top center}}
  @media(prefers-reduced-motion:reduce){.ramuni-laptop-frame{transition:none}.ramuni-laptop-mockup:hover .ramuni-laptop-frame{transform:none}}
</style>

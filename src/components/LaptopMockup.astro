---
interface Props {
  class?: string;
  label?: string;
}

const { class: className = '', label = 'Tampilan produk RAMUNI dalam mockup laptop' } = Astro.props;
---

  <span class:list={['ramuni-laptop-mockup', className]} role="img" aria-label={label} data-device-motion="true">
  <span class="ramuni-laptop-frame">
    <img class="ramuni-laptop-shell-image" src="/website-original/product-screens/ramuni-laptop-shell.webp" width="1600" height="977" alt="" aria-hidden="true" loading="lazy" decoding="async" />
    <span class="ramuni-laptop-screen"><slot /></span>
  </span>
  <span class="ramuni-laptop-hinge" aria-hidden="true"></span>
  <span class="ramuni-laptop-base" aria-hidden="true"></span>
</span>

<style is:inline>
  /* Front-facing product showcase: the real dashboard stays fully readable. */
  .ramuni-laptop-mockup{position:relative;display:block;width:100%;min-width:0;padding:0 2% clamp(15px,2vw,28px);perspective:1800px;isolation:isolate}
  .ramuni-laptop-mockup::after{content:"";position:absolute;z-index:0;left:13%;right:13%;bottom:0;height:18%;border-radius:50%;background:rgb(11 48 69/.18);filter:blur(18px);opacity:.46;pointer-events:none}
  .ramuni-laptop-frame{position:relative;z-index:1;display:block;width:100%;aspect-ratio:1600/977;overflow:hidden;border:0;border-radius:clamp(12px,1.25vw,20px);background:transparent;box-shadow:0 22px 46px rgb(11 48 69/.16);transform:rotateY(-2deg) rotateX(.6deg);transform-style:preserve-3d;backface-visibility:hidden;transition:transform .5s var(--ease),box-shadow .5s var(--ease)}
  .ramuni-laptop-frame::before{content:"";position:absolute;inset:0;border-radius:inherit;border-top:1px solid rgb(255 255 255/.95);pointer-events:none}
  .ramuni-laptop-frame::after{content:"";position:absolute;left:7%;right:7%;bottom:3px;height:1px;background:rgb(11 48 69/.16);pointer-events:none}
  .ramuni-laptop-shell-image{position:absolute;z-index:0;inset:0;display:block;width:100%;height:100%;object-fit:cover;object-position:center}
  .ramuni-laptop-screen{position:absolute;z-index:1;left:9.1%;top:2.45%;width:81.8%;height:86.4%;overflow:hidden;background:var(--rice);box-shadow:0 0 0 1px rgb(0 0 0/.28);transform:none}
  .ramuni-laptop-screen>*{min-width:0}
  .ramuni-laptop-screen>.dashboard-motion__screen,.ramuni-laptop-screen>.animated-dashboard-proof,.ramuni-laptop-screen>.tour-evidence-cta__image-frame{width:100%;height:100%;aspect-ratio:auto!important}
  .ramuni-laptop-screen>.dashboard-motion__screen .dashboard-motion__image,.ramuni-laptop-screen>.animated-dashboard-proof img,.ramuni-laptop-screen>.tour-evidence-cta__image-frame img{object-fit:contain;object-position:center}
  .ramuni-laptop-hinge,.ramuni-laptop-base{display:none}
  @media (hover:hover) and (pointer:fine){.ramuni-laptop-mockup:hover .ramuni-laptop-frame{transform:rotateY(-1.5deg) rotateX(.55deg) translateY(-2px);box-shadow:0 28px 52px rgb(11 48 69/.18),inset 0 1px rgb(255 255 255/.9)}}
  @media(max-width:900px) and (min-width:621px){.ramuni-laptop-mockup{padding-inline:0}.ramuni-laptop-frame{width:min(100%,640px);margin-inline:auto;transform:none}.ramuni-laptop-screen{left:9.1%;top:2.45%;width:81.8%;height:86.4%}.ramuni-laptop-screen>.dashboard-motion,.ramuni-laptop-screen>.animated-dashboard-proof{height:100%;aspect-ratio:4/3!important}.ramuni-laptop-screen>.dashboard-motion .dashboard-motion__screen{height:100%;aspect-ratio:4/3!important}.ramuni-laptop-screen>.tour-evidence-cta__image-frame{height:100%;aspect-ratio:4/3!important}}
  @media(max-width:620px){.ramuni-laptop-mockup{width:min(100%,270px);margin-inline:auto;padding:0}.ramuni-laptop-mockup::after{display:none}.ramuni-laptop-frame{aspect-ratio:9/16;padding:9px 7px 11px;border-radius:26px;background:linear-gradient(180deg,#f1f5f3,#c3cfcd);box-shadow:0 20px 42px rgb(11 48 69/.16);transform:none}.ramuni-laptop-shell-image{display:none}.ramuni-laptop-screen{position:relative;left:auto;top:auto;width:100%;height:100%;aspect-ratio:auto;border:3px solid #0a1117;border-radius:20px;background:#f4f7f5;transform:none}.ramuni-laptop-screen>.dashboard-motion,.ramuni-laptop-screen>.animated-dashboard-proof{height:100%;aspect-ratio:9/16!important}.ramuni-laptop-screen>.dashboard-motion .dashboard-motion__screen{height:100%;aspect-ratio:9/16!important}.ramuni-laptop-screen>.dashboard-motion__screen .dashboard-motion__image,.ramuni-laptop-screen>.animated-dashboard-proof img,.ramuni-laptop-screen>.tour-evidence-cta__image-frame img{object-fit:cover;object-position:top center}.ramuni-laptop-screen>.animated-dashboard-proof .animated-dashboard-proof__picture img{object-fit:cover;object-position:top center}.ramuni-laptop-screen>.tour-evidence-cta__image-frame{height:100%;aspect-ratio:9/16!important}}
  @media(prefers-reduced-motion:reduce){.ramuni-laptop-frame{transition:none}.ramuni-laptop-mockup:hover .ramuni-laptop-frame{transform:none}}
</style>

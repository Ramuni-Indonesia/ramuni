---
import { headerNavigation, launchCta, type MegaNavigationGroup } from '../data/site';
import { navigationIconAttributes } from '../data/capabilityIcons';
import '../styles/forms-conversion.css';
const path = Astro.url.pathname;
const isHome = path === '/';
const routePath = (href: string) => href === '/' ? '/' : href.replace(/\/+$/, '');
const exactCurrent = (href: string) => routePath(path) === routePath(href);
const current = (href: string) => {
  const target = routePath(href);
  const currentPath = routePath(path);
  return currentPath === target || (target !== '/' && currentPath.startsWith(`${target}/`));
};
const matchesRoute = (href: string, route: string) => routePath(href) === route;
const isMegaGroup = (item: (typeof headerNavigation)[number]): item is MegaNavigationGroup => 'columns' in item;
const publicHeaderNavigation = headerNavigation.filter((item) => !matchesRoute(item.href, '/harga'));
const publicHref = (href: string) => matchesRoute(href, '/demo') ? '/tour-produk-gratis/' : href;
const publicActions = (actions: { label: string; href: string }[] = []) => actions.filter((action) => !matchesRoute(action.href, '/harga'));
const isPublicNavigationLink = (href: string) => !matchesRoute(href, '/harga') && !matchesRoute(href, '/status');
const groupId = (label: string) => `nav-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const groupClass = (label: string) => `mega-menu mega-menu--${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const megaCopy: Record<string, { title: string; description: string; featuredTitle?: string; featuredText?: string; featuredCta?: string }> = {
  Produk: {
    title: 'Pilih bagian usaha yang ingin Anda rapikan.',
    description: 'Mulai dari penjualan, stok, keuangan, pelanggan, atau laporan.',
    featuredTitle: 'Belum tahu harus mulai dari mana?',
    featuredText: 'Pilih masalah usaha terlebih dahulu. Kami tunjukkan modul yang relevan.',
    featuredCta: 'Lihat semua produk',
  },
  Solusi: {
    title: 'Mulai dari masalah yang paling sering menghambat keputusan.',
    description: 'Lihat data apa yang perlu diperiksa untuk penjualan, stok, kas, pelanggan, atau laporan.',
  },
  'Sumber Daya': {
    title: 'Cari jawaban sesuai pekerjaan Anda.',
    description: 'Baca panduan, gunakan alat hitung, atau cari istilah bisnis.',
  },
};
const linkDescriptionOverrides: Record<string, string> = {
  '/solusi/naikkan-omzet/': 'Cari produk, waktu, dan pelanggan yang memengaruhi omzet.',
  '/solusi/pahami-pelanggan/': 'Kenali pembelian berulang dari riwayat yang tersedia.',
  '/solusi/laporan-bisnis-otomatis/': 'Samakan periode, rumus, dan sumber laporan.',
  '/bantuan/': 'Temukan panduan dan jalur bantuan.',
};
const linkLabelOverrides: Record<string, string> = {
  '/solusi/laporan-bisnis-otomatis/': 'Laporan Bisnis',
};
const actionLabelOverrides: Record<string, string> = { '/demo': 'Lihat cara kerja' };
const groupActive = (item: MegaNavigationGroup) => {
  const links = item.columns.flatMap((column) => column.links).filter((link) => isPublicNavigationLink(link.href)).concat(item.featured ? [{ label: item.featured.title, href: item.featured.href }] : [], item.actions || []);
  return current(item.href) || links.some((link) => current(link.href));
};
---
<header class="site-header">
  {isHome && <div class="announcement"><div class="container"><span class="announcement-long">Lihat cara RAMUNI membaca stok, penjualan, dan kas.</span><span class="announcement-short">Coba RAMUNI dengan data contoh.</span><a href="/tour-produk-gratis/">Coba simulasi</a></div></div>}
  <div class="container nav-shell">
    <a class="brand-link" href="/" aria-label="RAMUNI, kembali ke beranda"><img src="/brand/ramuni-lockup-horizontal-color-tight.webp" width="1187" height="355" alt="RAMUNI" /></a>
    <nav class="desktop-nav" aria-label="Navigasi utama">
      {publicHeaderNavigation.map((item) => (
        isMegaGroup(item) ? (
          <details class="nav-group" data-nav-group>
            <summary data-current={groupActive(item) ? 'true' : undefined} aria-controls={groupId(item.label)}>{item.label}</summary>
            <div class={groupClass(item.label)} id={groupId(item.label)}>
              <div class="mega-lead">
                <span>{item.eyebrow}</span><strong>{megaCopy[item.label]?.title || item.title}</strong><p>{megaCopy[item.label]?.description || item.description}</p>
                <div class="mega-actions">
                  <a class="mega-hub-link" href={publicHref(item.href)} aria-current={exactCurrent(publicHref(item.href)) ? 'page' : undefined}>Buka {item.label}</a>
                  {publicActions(item.actions).map((action) => <a href={publicHref(action.href)}>{actionLabelOverrides[action.href] || action.label}</a>)}
                </div>
                {item.featured && !matchesRoute(item.featured.href, '/harga') && <a class="mega-feature" href={publicHref(item.featured.href)}><span>{item.featured.eyebrow}</span><strong>{megaCopy[item.label]?.featuredTitle || item.featured.title}</strong><small>{megaCopy[item.label]?.featuredText || item.featured.text}</small><b>{megaCopy[item.label]?.featuredCta || item.featured.cta}</b></a>}
              </div>
              <div class="mega-columns">
                {item.columns.map((column) => (
                  <section class="mega-column" aria-labelledby={`${groupId(item.label)}-${groupId(column.label)}`}>
                    <h2 id={`${groupId(item.label)}-${groupId(column.label)}`}>{column.label}</h2>
                    <div class="mega-links">{column.links.filter((link) => isPublicNavigationLink(link.href)).map((link) => <a href={publicHref(link.href)} aria-current={exactCurrent(publicHref(link.href)) && publicHref(link.href) !== publicHref(item.href) ? 'page' : undefined} {...navigationIconAttributes(publicHref(link.href))}><span class="mega-link-copy"><strong>{linkLabelOverrides[link.href] || link.label}</strong>{(linkDescriptionOverrides[link.href] || link.description) && <span>{linkDescriptionOverrides[link.href] || link.description}</span>}</span></a>)}</div>
                  </section>
                ))}
              </div>
            </div>
          </details>
        ) : <a href={publicHref(item.href)} aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="button button--primary" href={launchCta.href}>{launchCta.label}</a>
    </nav>
    <details class="mobile-menu" data-mobile-menu>
      <summary aria-controls="mobile-navigation-panel" aria-expanded="false"><span class="mobile-menu__icon" aria-hidden="true"><i></i><i></i><i></i></span><span class="mobile-menu__label">Menu</span></summary>
      <div class="mobile-panel" id="mobile-navigation-panel">
        <nav aria-label="Navigasi seluler">
          {publicHeaderNavigation.map((item) => (
            isMegaGroup(item) ? (
              <details>
                <summary data-current={groupActive(item) ? 'true' : undefined}>{item.label}</summary>
                <div>
                  <a class="mobile-hub" href={publicHref(item.href)} aria-current={exactCurrent(publicHref(item.href)) ? 'page' : undefined}>Buka {item.label}</a>
                  {item.columns.map((column) => (
                    <section>
                      <h2>{column.label}</h2>
                      {column.links.filter((link) => isPublicNavigationLink(link.href)).map((link) => <a href={publicHref(link.href)} aria-current={exactCurrent(publicHref(link.href)) && publicHref(link.href) !== publicHref(item.href) ? 'page' : undefined} {...navigationIconAttributes(publicHref(link.href))}><span>{linkLabelOverrides[link.href] || link.label}</span></a>)}
                    </section>
                  ))}
                  {item.featured && !matchesRoute(item.featured.href, '/harga') && <a class="mobile-feature" href={publicHref(item.featured.href)}>{megaCopy[item.label]?.featuredCta || item.featured.cta}</a>}
                </div>
              </details>
            ) : <a href={publicHref(item.href)} aria-current={current(publicHref(item.href)) ? 'page' : undefined}>{item.label}</a>
          ))}
          <a href="https://wa.me/message/K35W6X6WT7YMJ1">Kontak</a><a href="/kebijakan-cookie/">Pengaturan cookie</a>
        </nav>
        <a class="button button--primary" href={launchCta.href}>{launchCta.label}</a>
      </div>
    </details>
  </div>
</header>
<script is:inline type="module" src="/scripts/header-nav.js"></script>

---
import { accountNavigation, headerNavigation, launchCta, type MegaNavigationGroup } from '../data/site';
const path = Astro.url.pathname;
const isHome = path === '/';
const current = (href: string) => path === href || path.startsWith(`${href}/`);
const isMegaGroup = (item: (typeof headerNavigation)[number]): item is MegaNavigationGroup => 'columns' in item;
const groupId = (label: string) => `nav-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const groupClass = (label: string) => `mega-menu mega-menu--${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const groupActive = (item: MegaNavigationGroup) => {
  const links = item.columns.flatMap((column) => column.links).concat(item.featured ? [{ label: item.featured.title, href: item.featured.href }] : [], item.actions || []);
  return current(item.href) || links.some((link) => current(link.href));
};
---
<header class="site-header">
  {isHome && <div class="announcement"><div class="container"><span>Program early access RAMUNI sedang dibuka.</span><a href="/early-access">Lihat detail</a></div></div>}
  <div class="container nav-shell">
    <a class="brand-link" href="/" aria-label="RAMUNI, kembali ke beranda"><img src="/brand/ramuni-lockup-horizontal-color.webp" width="560" height="140" alt="RAMUNI" /></a>
    <nav class="desktop-nav" aria-label="Navigasi utama">
      {headerNavigation.map((item) => (
        isMegaGroup(item) ? (
          <details class="nav-group" data-nav-group>
            <summary aria-current={groupActive(item) ? 'page' : undefined} aria-controls={groupId(item.label)}>{item.label}</summary>
            <div class={groupClass(item.label)} id={groupId(item.label)}>
              <div class="mega-lead">
                <span>{item.eyebrow}</span><strong>{item.title}</strong><p>{item.description}</p>
                {item.actions && <div class="mega-actions">{item.actions.map((action) => <a href={action.href}>{action.label}</a>)}</div>}
                {item.featured && <a class="mega-feature" href={item.featured.href}><span>{item.featured.eyebrow}</span><strong>{item.featured.title}</strong><small>{item.featured.text}</small><b>{item.featured.cta}</b></a>}
              </div>
              <div class="mega-columns">
                {item.columns.map((column) => (
                  <section class="mega-column" aria-labelledby={`${groupId(item.label)}-${groupId(column.label)}`}>
                    <h2 id={`${groupId(item.label)}-${groupId(column.label)}`}>{column.label}</h2>
                    <div class="mega-links">{column.links.map((link) => <a href={link.href}><strong>{link.label}</strong>{link.description && <span>{link.description}</span>}</a>)}</div>
                  </section>
                ))}
              </div>
            </div>
          </details>
        ) : <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      {accountNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class="button button--primary" href={launchCta.href}>{launchCta.label}</a>
    </nav>
    <details class="mobile-menu" data-mobile-menu>
      <summary>Menu</summary>
      <div class="mobile-panel">
        <nav aria-label="Navigasi seluler">
          {headerNavigation.map((item) => (
            isMegaGroup(item) ? (
              <details>
                <summary>{item.label}</summary>
                <div>
                  <a class="mobile-hub" href={item.href}>Buka {item.label}</a>
                  {item.columns.map((column) => (
                    <section>
                      <h2>{column.label}</h2>
                      {column.links.map((link) => <a href={link.href}>{link.label}</a>)}
                    </section>
                  ))}
                  {item.featured && <a class="mobile-feature" href={item.featured.href}>{item.featured.cta}</a>}
                </div>
              </details>
            ) : <a href={item.href}>{item.label}</a>
          ))}
          {accountNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href="/kontak">Kontak</a><a href="/kebijakan-cookie">Pengaturan cookie</a>
        </nav>
        <a class="button button--primary" href={launchCta.href}>{launchCta.label}</a>
      </div>
    </details>
  </div>
</header>
<script>
  const groups = [...document.querySelectorAll('[data-nav-group]')];
  const mobile = document.querySelector('[data-mobile-menu]');
  const desktopNav = document.querySelector('.desktop-nav');
  const desktopItems = desktopNav
    ? [...desktopNav.querySelectorAll(':scope > a:not(.button), :scope > details > summary')]
    : [];
  const desktopIndex = (node: Element | null) => desktopItems.findIndex((item) => item === node);
  const closeDesktopGroups = () => groups.forEach((group) => {
    group.removeAttribute('open');
    group.querySelector(':scope > summary')?.setAttribute('aria-expanded', 'false');
  });
  groups.forEach((group) => {
    if (!(group instanceof HTMLDetailsElement)) return;
    const summary = group.querySelector(':scope > summary');
    if (summary instanceof HTMLElement) summary.setAttribute('aria-expanded', String(group.open));
    group.addEventListener('toggle', () => {
      const trigger = group.querySelector(':scope > summary');
      if (trigger instanceof HTMLElement) trigger.setAttribute('aria-expanded', String(group.open));
      if (group.open) groups.filter((item) => item !== group).forEach((item) => {
        item.removeAttribute('open');
        item.querySelector(':scope > summary')?.setAttribute('aria-expanded', 'false');
      });
    });
  });
  if (desktopNav instanceof HTMLElement) {
    desktopNav.addEventListener('keydown', (event) => {
      const currentIndex = desktopIndex(document.activeElement);
      const focused = document.activeElement;
      const activeMenu = focused instanceof HTMLElement ? focused.closest('.mega-menu') : null;
      const focusItem = (index: number) => {
        const item = desktopItems.at((index + desktopItems.length) % desktopItems.length);
        if (item instanceof HTMLElement) item.focus();
      };
      if (activeMenu instanceof HTMLElement && focused instanceof HTMLElement && focused.matches('a')) {
        const menuLinks = [...activeMenu.querySelectorAll('a')].filter((link): link is HTMLAnchorElement => link instanceof HTMLAnchorElement);
        const menuIndex = menuLinks.indexOf(focused as HTMLAnchorElement);
        if (['ArrowDown', 'ArrowRight', 'ArrowUp', 'ArrowLeft', 'Home', 'End'].includes(event.key)) {
          event.preventDefault();
          const targetIndex = event.key === 'Home'
            ? 0
            : event.key === 'End'
              ? menuLinks.length - 1
              : menuIndex + (event.key === 'ArrowDown' || event.key === 'ArrowRight' ? 1 : -1);
          menuLinks.at((targetIndex + menuLinks.length) % menuLinks.length)?.focus();
        }
      }
      if (currentIndex >= 0 && (event.key === 'ArrowRight' || event.key === 'ArrowLeft' || event.key === 'Home' || event.key === 'End')) {
        event.preventDefault();
        if (event.key === 'Home') focusItem(0);
        else if (event.key === 'End') focusItem(desktopItems.length - 1);
        else focusItem(currentIndex + (event.key === 'ArrowRight' ? 1 : -1));
      }
      if (document.activeElement instanceof HTMLElement && document.activeElement.matches('.nav-group > summary')) {
        const parent = document.activeElement.parentElement;
        if (event.key === 'ArrowDown' && parent instanceof HTMLDetailsElement) {
          event.preventDefault();
          parent.open = true;
          const firstLink = parent.querySelector('.mega-menu a');
          if (firstLink instanceof HTMLElement) firstLink.focus();
        }
        if (event.key === 'ArrowUp' && parent instanceof HTMLDetailsElement) {
          event.preventDefault();
          parent.open = false;
        }
      }
      if (event.key === 'Escape' && desktopNav.contains(document.activeElement)) {
        const openGroup = groups.find((group) => group instanceof HTMLDetailsElement && group.open);
        closeDesktopGroups();
        const trigger = openGroup?.querySelector(':scope > summary');
        if (trigger instanceof HTMLElement) trigger.focus();
      }
    });
  }
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeDesktopGroups();
      if (mobile instanceof HTMLDetailsElement && mobile.open) {
        mobile.removeAttribute('open');
        document.body.classList.remove('menu-open');
        const trigger = mobile.querySelector(':scope > summary');
        if (trigger instanceof HTMLElement) trigger.focus();
      }
    }
  });
  if (mobile instanceof HTMLDetailsElement) {
    mobile.addEventListener('toggle', () => document.body.classList.toggle('menu-open', mobile.open));
    mobile.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab' || !mobile.open) return;
      const focusable = [...mobile.querySelectorAll('summary, a[href], button:not([disabled])')].filter((node) => node instanceof HTMLElement && node.offsetParent !== null);
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (!(first instanceof HTMLElement) || !(last instanceof HTMLElement)) return;
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    });
  }
</script>

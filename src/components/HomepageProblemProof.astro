---
const stories = [
  {
    label: 'Penjualan',
    question: 'Omzet berubah. Bagian mana yang perlu dibuka dulu?',
    answer: 'Bandingkan hari, jumlah transaksi, dan produk yang berubah.',
    href: '/solusi/naikkan-omzet/',
    mascot: '/website-original/mascot/phase-1/muni-manyar-friendly-v2.webp',
    mascotAlt: 'Muni Manyar membantu membaca perubahan penjualan',
  },
  {
    label: 'Stok',
    question: 'Barang apa yang berisiko habis saat permintaan naik?',
    answer: 'Lihat sisa stok bersama laju penjualan dan aktivitas terbaru.',
    href: '/solusi/kelola-stok/',
    mascot: '/website-original/mascot/phase-1/kancil-cermat-friendly-v2.webp',
    mascotAlt: 'Kancil Cermat memegang catatan untuk memeriksa stok',
  },
  {
    label: 'Kas',
    question: 'Usaha ramai, tetapi mengapa kas terasa seret?',
    answer: 'Pisahkan omzet, biaya, laba, dan pergerakan kas pada periode yang sama.',
    href: '/solusi/pantau-laba-dan-arus-kas/',
    mascot: '/website-original/mascot/phase-1/si-ramu-friendly-v2.webp',
    mascotAlt: 'Si Ramu membantu menghubungkan catatan omzet, biaya, laba, dan kas',
  },
];
---

<div class="problem-selector" data-problem-selector>
  <figure class="problem-selector__stage reveal">
    <div class="problem-selector__art" aria-live="polite">
      {stories.map((story, index) => (
        <img
          class:list={['problem-selector__mascot', { 'is-active': index === 0 }]}
          src={story.mascot}
          width="1024"
          height="1024"
          alt={story.mascotAlt}
          loading="lazy"
          decoding="async"
          data-problem-mascot={String(index)}
          aria-hidden={index === 0 ? 'false' : 'true'}
        />
      ))}
      <span class="problem-selector__orbit" aria-hidden="true"></span>
    </div>
    <figcaption>
      <span data-problem-label>Penjualan</span>
      <strong data-problem-answer>{stories[0].answer}</strong>
      <a href={stories[0].href} data-problem-active-link>Buka solusi terkait</a>
    </figcaption>
  </figure>

  <div class="problem-selector__questions reveal" role="tablist" aria-label="Pilih masalah usaha">
    {stories.map((story, index) => (
      <button
        type="button"
        role="tab"
        aria-selected={index === 0 ? 'true' : 'false'}
        tabindex={index === 0 ? 0 : -1}
        data-problem-tab={String(index)}
        data-label={story.label}
        data-answer={story.answer}
        data-href={story.href}
      >
        <span>{story.label}</span>
        <strong>{story.question}</strong>
      </button>
    ))}
  </div>
</div>

<script>
  const bindProblemSelector = () => {
    document.querySelectorAll<HTMLElement>('[data-problem-selector]').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-problem-tab]'));
      const mascots = Array.from(root.querySelectorAll<HTMLElement>('[data-problem-mascot]'));
      const label = root.querySelector<HTMLElement>('[data-problem-label]');
      const answer = root.querySelector<HTMLElement>('[data-problem-answer]');
      const activeLink = root.querySelector<HTMLAnchorElement>('[data-problem-active-link]');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let activeIndex = 0;
      let timer = 0;

      const activate = (tab: HTMLButtonElement) => {
        const index = Number(tab.dataset.problemTab || 0);
        activeIndex = index;
        tabs.forEach((item) => {
          const active = item === tab;
          item.setAttribute('aria-selected', String(active));
          item.tabIndex = active ? 0 : -1;
        });
        mascots.forEach((mascot, mascotIndex) => {
          const active = mascotIndex === index;
          mascot.classList.toggle('is-active', active);
          mascot.setAttribute('aria-hidden', String(!active));
        });
        if (label) label.textContent = tab.dataset.label || '';
        if (answer) answer.textContent = tab.dataset.answer || '';
        if (activeLink) activeLink.href = tab.dataset.href || '/solusi/';
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => activate(tab));
        tab.addEventListener('keydown', (event) => {
          if (!['ArrowDown', 'ArrowUp', 'ArrowLeft', 'ArrowRight'].includes(event.key)) return;
          event.preventDefault();
          const forward = event.key === 'ArrowDown' || event.key === 'ArrowRight';
          const next = forward ? (index + 1) % tabs.length : (index - 1 + tabs.length) % tabs.length;
          tabs[next]?.focus();
          if (tabs[next]) activate(tabs[next]);
        });
      });

      const stopRotation = () => {
        if (timer) window.clearInterval(timer);
        timer = 0;
      };
      const startRotation = () => {
        stopRotation();
        if (reducedMotion.matches || document.hidden || tabs.length < 2) return;
        timer = window.setInterval(() => {
          activeIndex = (activeIndex + 1) % tabs.length;
          if (tabs[activeIndex]) activate(tabs[activeIndex]);
        }, 6200);
      };
      root.addEventListener('pointerenter', stopRotation);
      root.addEventListener('pointerleave', startRotation);
      root.addEventListener('focusin', stopRotation);
      root.addEventListener('focusout', (event) => {
        if (event.relatedTarget instanceof Node && root.contains(event.relatedTarget)) return;
        startRotation();
      });
      const cleanupRotation = () => {
        stopRotation();
        document.removeEventListener('visibilitychange', startRotation);
        reducedMotion.removeEventListener?.('change', startRotation);
      };
      document.addEventListener('visibilitychange', startRotation);
      reducedMotion.addEventListener?.('change', startRotation);
      document.addEventListener('astro:before-swap', cleanupRotation, { once: true });
      startRotation();
    });
  };

  bindProblemSelector();
  document.addEventListener('astro:page-load', bindProblemSelector);
</script>

<style>
  .problem-selector{display:grid;grid-template-columns:minmax(360px,.86fr) minmax(0,1.14fr);gap:clamp(30px,5vw,72px);align-items:stretch;margin-top:clamp(36px,5vw,64px)}
  .problem-selector__stage{display:grid;grid-template-rows:minmax(0,1fr) auto;min-height:560px;margin:0;overflow:hidden;border:1px solid var(--ink);background:var(--rice);box-shadow:14px 14px 0 var(--ink)}
  .problem-selector__art{position:relative;display:grid;place-items:center;min-height:420px;overflow:hidden;background:radial-gradient(circle at 50% 48%,rgb(242 177 52/.34),transparent 28%),linear-gradient(145deg,rgb(22 140 140/.1),transparent 62%)}
  .problem-selector__orbit{position:absolute;width:min(340px,72%);aspect-ratio:1;border:1px solid rgb(11 48 69/.15);border-radius:50%;box-shadow:0 0 0 42px rgb(22 140 140/.05),0 0 0 84px rgb(242 177 52/.05)}
  .problem-selector__orbit::before,.problem-selector__orbit::after{content:'';position:absolute;width:18px;aspect-ratio:1;border-radius:50%;background:var(--teal);box-shadow:0 0 0 7px rgb(22 140 140/.12)}
  .problem-selector__orbit::before{left:12%;top:8%}.problem-selector__orbit::after{right:5%;bottom:18%;background:var(--yellow);box-shadow:0 0 0 7px rgb(242 177 52/.15)}
  .problem-selector__mascot{position:absolute;z-index:2;display:block;width:min(360px,76%);height:auto;opacity:0;filter:drop-shadow(0 26px 34px rgb(11 48 69/.18));mix-blend-mode:multiply;transform:translate3d(32px,16px,0) scale(.92);transform-origin:50% 90%;transition:opacity .45s ease,transform .65s var(--ease)}
  .problem-selector__mascot.is-active{opacity:1;transform:none}
  .problem-selector__stage figcaption{position:relative;z-index:3;display:grid;grid-template-columns:auto minmax(0,1fr);gap:8px 18px;padding:20px;border-top:1px solid var(--ink);background:var(--white)}
  .problem-selector__stage figcaption span{color:var(--teal);font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.problem-selector__stage figcaption strong{font-size:.84rem;line-height:1.45}.problem-selector__stage figcaption a{grid-column:2;width:max-content;max-width:100%;color:var(--teal);font-size:.72rem;font-weight:800;text-underline-offset:4px}
  .problem-selector__questions{display:grid;align-content:start;border-top:1px solid var(--ink)}
  .problem-selector__questions button{display:grid;gap:10px;min-height:150px;padding:24px 22px;border:0;border-bottom:1px solid var(--ink-10);background:transparent;color:var(--ink);font:inherit;text-align:left;cursor:pointer;transition:padding-left .35s var(--ease),background-color .35s ease}
  .problem-selector__questions button span{color:var(--teal);font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.problem-selector__questions button strong{max-width:34ch;font-size:clamp(1.05rem,1.6vw,1.36rem);line-height:1.3}.problem-selector__questions button[aria-selected='true']{padding-left:34px;background:var(--yellow)}.problem-selector__questions button[aria-selected='true'] span{color:var(--ink)}.problem-selector__questions button:focus-visible{outline:3px solid var(--teal);outline-offset:3px}
  @media(prefers-reduced-motion:no-preference){
    .problem-selector__mascot.is-active{animation:problem-mascot-work 5.8s var(--ease) infinite}
    .problem-selector__mascot:nth-child(2).is-active{animation-name:problem-mascot-check}
    .problem-selector__mascot:nth-child(3).is-active{animation-name:problem-mascot-connect}
    .problem-selector__orbit{animation:problem-orbit-drift 15s linear infinite}
    .problem-selector__orbit::before{animation:problem-orbit-pulse 2.4s var(--ease) infinite}
    .problem-selector__orbit::after{animation:problem-orbit-pulse 2.4s 1.2s var(--ease) infinite}
    @keyframes problem-mascot-work{0%,100%{transform:translate3d(0,0,0) rotate(-.8deg)}34%{transform:translate3d(-7px,-10px,0) rotate(.9deg)}68%{transform:translate3d(8px,-4px,0) rotate(-.2deg)}}
    @keyframes problem-mascot-check{0%,100%{transform:translate3d(0,0,0) rotate(.4deg)}32%{transform:translate3d(5px,-7px,0) rotate(-1deg)}60%{transform:translate3d(-4px,-12px,0) rotate(.8deg)}}
    @keyframes problem-mascot-connect{0%,100%{transform:translate3d(0,0,0) scale(1)}42%{transform:translate3d(0,-10px,0) scale(1.018)}72%{transform:translate3d(6px,-4px,0) scale(.995)}}
    @keyframes problem-orbit-drift{to{transform:rotate(360deg)}}
    @keyframes problem-orbit-pulse{0%,100%{transform:scale(.78);opacity:.48}50%{transform:scale(1.12);opacity:1}}
  }
  @media(max-width:960px){.problem-selector{grid-template-columns:1fr}.problem-selector__stage{min-height:500px}.problem-selector__questions{grid-template-columns:repeat(3,minmax(0,1fr));border-left:1px solid var(--ink)}.problem-selector__questions button{min-height:150px;border-right:1px solid var(--ink-10)}.problem-selector__questions button:last-child{border-right:0}.problem-selector__questions button[aria-selected='true']{padding-left:22px}}
  @media(max-width:620px){.problem-selector{gap:22px}.problem-selector__stage{min-height:430px;box-shadow:8px 8px 0 var(--ink)}.problem-selector__art{min-height:310px}.problem-selector__mascot{width:min(285px,78%)}.problem-selector__stage figcaption{grid-template-columns:1fr;padding:16px}.problem-selector__stage figcaption a{grid-column:auto}.problem-selector__questions{grid-template-columns:1fr;border-left:0}.problem-selector__questions button{min-height:0;padding:17px 4px 17px 0;border-right:0}.problem-selector__questions button[aria-selected='true']{padding-left:16px}}
  @media(prefers-reduced-motion:reduce){.problem-selector__mascot,.problem-selector__orbit{animation:none!important;transition:none!important}.problem-selector__mascot.is-active{transform:none}}
</style>

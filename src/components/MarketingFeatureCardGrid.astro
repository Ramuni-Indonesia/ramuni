---
import MarketingDashboardCanvas from './MarketingDashboardCanvas.astro';
import type { MarketingFeatureCard } from '../data/marketingFeatureCards';
import { capabilityStatusLabel } from '../data/commercial';

interface Props {
  cards: readonly MarketingFeatureCard[];
  id: string;
  eyebrow: string;
  heading: string;
  body: string;
  compact?: boolean;
  filters?: readonly { label: string; value: string }[];
}

const { cards, id, eyebrow, heading, body, compact = true, filters = [] } = Astro.props;
---

<section id={id} class="marketing-card-system" data-marketing-card-system aria-labelledby={`${id}-title`}>
  <div class="container">
    <header class="marketing-card-system__head">
      <div><p class="section-kicker">{eyebrow}</p><h2 id={`${id}-title`}>{heading}</h2></div>
      <p>{body}</p>
    </header>
    {filters.length > 0 && <div class="marketing-card-filters" role="tablist" aria-label="Pilih jenis katalog">
      {filters.map((filter, index) => <button type="button" class="marketing-card-filter" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-card-filter={filter.value}>{filter.label}</button>)}
    </div>}
    <div class="marketing-card-grid">
      {cards.map((card, index) => (
        <a
          class:list={['marketing-feature-card', `marketing-feature-card--${card.size || 'standard'}`, 'marketing-feature-card--motion']}
          href={card.href}
          style={`--card-index:${index}`}
          data-marketing-card
          data-card-family={card.family}
          data-card-slug={card.slug}
        >
          <header class="marketing-feature-card__head">
            <span class="marketing-feature-card__eyebrow">{card.eyebrow}</span>
            <span class="marketing-feature-card__status" data-status={card.status || 'module'}>{card.status ? capabilityStatusLabel(card.status) : 'Modul RAMUNI'}</span>
          </header>
          <div class="marketing-feature-card__copy">
            <h3>{card.title}</h3>
            <p>{card.summary}</p>
          </div>
          <div class="marketing-feature-card__preview">
            <MarketingDashboardCanvas context={card.context} compact={compact} />
          </div>
          <footer class="marketing-feature-card__footer">
            <span>{card.action}</span>
            <strong aria-hidden="true">↗</strong>
          </footer>
          <div class="marketing-feature-card__signal" aria-label={`${card.signal} ${card.signalLabel}`}>
            <strong>{card.signal}</strong><span>{card.signalLabel}</span>
          </div>
        </a>
      ))}
    </div>
    <p class="marketing-card-system__disclosure">Preview di kartu menggunakan data simulasi terkontrol untuk menjelaskan alur produk, bukan data live pengunjung.</p>
  </div>
</section>

<script>
  const setupMarketingCardMotion = () => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const systems = Array.from(document.querySelectorAll<HTMLElement>('[data-marketing-card-system]'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-marketing-card]'));
    if (!cards.length) return;
    systems.forEach((system) => {
      const filters = Array.from(system.querySelectorAll<HTMLButtonElement>('[data-card-filter]'));
      const systemCards = Array.from(system.querySelectorAll<HTMLElement>('[data-marketing-card]'));
      if (filters.length) {
        const applyFilter = (value: string) => {
          filters.forEach((button) => {
            const active = button.dataset.cardFilter === value;
            button.setAttribute('aria-selected', String(active));
          });
          systemCards.forEach((card) => {
            const visible = value === 'all' || card.dataset.cardFamily === value;
            card.hidden = !visible;
            if (visible) card.classList.add('is-visible');
          });
        };
        filters.forEach((button) => button.addEventListener('click', () => applyFilter(button.dataset.cardFilter || 'all')));
        applyFilter(filters.find((button) => button.getAttribute('aria-selected') === 'true')?.dataset.cardFilter || 'all');
      }
      if (reduceMotion || !('IntersectionObserver' in window)) {
        systemCards.forEach((card) => card.classList.add('is-visible'));
        return;
      }
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { rootMargin: '120px 0px', threshold: 0.12 });
      systemCards.forEach((card) => observer.observe(card));
      document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
    });
  };
  setupMarketingCardMotion();
  document.addEventListener('astro:page-load', setupMarketingCardMotion);
</script>

<style is:inline>
  .marketing-card-system{padding:clamp(58px,8vw,116px) 0;background:var(--white);overflow:hidden}
  .marketing-card-system__head{display:grid;grid-template-columns:minmax(0,.88fr) minmax(260px,.72fr);gap:clamp(28px,7vw,112px);align-items:end;margin-bottom:34px}.marketing-card-system__head h2{max-width:17ch;margin-top:10px}.marketing-card-system__head>p{max-width:48ch;margin:0;color:var(--ink-72);line-height:1.65}
  .marketing-card-filters{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 22px}.marketing-card-filter{border:1px solid var(--ink-20);border-radius:999px;background:var(--white);padding:9px 14px;color:var(--ink);font:inherit;font-size:.75rem;font-weight:800;cursor:pointer;transition:background .2s ease,color .2s ease,border-color .2s ease}.marketing-card-filter[aria-selected=true]{border-color:var(--ink);background:var(--ink);color:var(--white)}.marketing-card-filter:focus-visible{outline:3px solid var(--teal);outline-offset:2px}
  .marketing-card-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:14px;align-items:stretch}.marketing-feature-card{--card-border:rgb(11 48 69/.14);position:relative;display:flex;flex-direction:column;grid-column:span 4;min-width:0;overflow:hidden;padding:18px;border:1px solid var(--card-border);background:var(--rice);color:var(--ink);text-decoration:none;opacity:1;transform:none;transition:opacity .55s var(--ease),transform .55s var(--ease),border-color .25s ease,box-shadow .25s ease}.js .marketing-feature-card[data-marketing-card]{opacity:1;transform:none}.marketing-feature-card.is-visible{opacity:1;transform:none;transition-delay:calc(var(--card-index,0)*45ms)}.marketing-feature-card[hidden]{display:none}.marketing-feature-card--lead{grid-column:span 7}.marketing-feature-card--wide{grid-column:span 5}.marketing-feature-card:hover,.marketing-feature-card:focus-visible{border-color:var(--teal);box-shadow:-6px 6px 0 var(--yellow);transform:translateY(-5px)}.marketing-feature-card:focus-visible{outline:3px solid var(--teal);outline-offset:3px}.marketing-feature-card__head{display:flex;align-items:center;justify-content:space-between;gap:10px}.marketing-feature-card__eyebrow{color:var(--teal);font-size:.65rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.marketing-feature-card__status{padding:4px 7px;border:1px solid var(--teal);color:var(--teal);font-size:.58rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap}.marketing-feature-card__copy{display:grid;gap:8px;min-height:104px;padding:22px 0 14px}.marketing-feature-card__copy h3{max-width:14ch;font-size:clamp(1.3rem,2.1vw,2.2rem);line-height:1.06;letter-spacing:-.035em}.marketing-feature-card__copy p{max-width:42ch;color:var(--ink-72);font-size:.79rem;line-height:1.5}.marketing-feature-card__preview{min-width:0;overflow:hidden;border:1px solid var(--ink-10);background:var(--white)}.marketing-feature-card__preview .marketing-dashboard{border:0;border-radius:0}.marketing-feature-card__preview .marketing-dashboard__disclosure{font-size:.55rem;padding-block:6px}.marketing-feature-card__footer{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:14px;color:var(--teal);font-size:.74rem;font-weight:900}.marketing-feature-card__footer strong{font-size:1.1rem;line-height:1}.marketing-feature-card__signal{position:absolute;right:14px;bottom:45px;display:grid;justify-items:end;gap:2px;padding:7px 9px;border:1px solid var(--ink-10);background:rgb(255 255 255/.88);backdrop-filter:blur(5px)}.marketing-feature-card__signal strong{font-size:.85rem;line-height:1}.marketing-feature-card__signal span{color:var(--ink-56);font-size:.56rem;font-weight:800;text-align:right}.marketing-card-system__disclosure{margin:18px 0 0;color:var(--ink-56);font-size:.67rem;line-height:1.5}
  @media(max-width:980px){.marketing-card-system__head{grid-template-columns:1fr;gap:14px}.marketing-card-grid{grid-template-columns:repeat(6,minmax(0,1fr))}.marketing-feature-card,.marketing-feature-card--wide{grid-column:span 3}.marketing-feature-card--lead{grid-column:span 6}}
  @media(max-width:620px){.marketing-card-system{padding-block:54px}.marketing-card-system__head h2{max-width:22ch}.marketing-card-grid{display:grid;grid-template-columns:1fr;gap:12px}.marketing-feature-card,.marketing-feature-card--wide,.marketing-feature-card--lead{grid-column:auto;padding:15px}.marketing-feature-card__copy{min-height:0;padding-block:18px 12px}.marketing-feature-card__copy h3{max-width:18ch;font-size:1.42rem}.marketing-feature-card__signal{right:11px;bottom:42px}.marketing-feature-card:hover,.marketing-feature-card:focus-visible{transform:none}}
  @media(prefers-reduced-motion:reduce){.marketing-feature-card{opacity:1;transform:none;transition:none}.marketing-feature-card:hover,.marketing-feature-card:focus-visible{transform:none}}
</style>

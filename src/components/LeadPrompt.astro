---
import LeadForm from './LeadForm.astro';
import '../styles/forms-conversion.css';
---
<dialog class="lead-dialog" data-lead-dialog aria-labelledby="lead-dialog-title">
  <div class="lead-dialog__layout">
    <div class="lead-dialog__intro">
      <button class="lead-dialog__close" type="button" data-lead-close aria-label="Tutup formulir">Tutup</button>
      <p class="section-kicker">Coba RAMUNI</p>
      <h2 id="lead-dialog-title">Mulai dari satu masalah usaha.</h2>
      <p>Pilih hal yang ingin Anda lihat. Kami tunjukkan alurnya dengan data contoh, tanpa meminta data sensitif.</p>
      <a href="/tour-produk-gratis">Belum ingin mengisi formulir? Coba simulasi gratis.</a>
    </div>
    <div class="lead-dialog__form"><LeadForm kind="early-access" submitLabel="Kirim permintaan tour" /></div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector('[data-lead-dialog]');
  document.querySelectorAll('[data-lead-open]').forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      if (!(dialog instanceof HTMLDialogElement)) return;
      event.preventDefault();
      dialog.showModal();
      document.body.classList.add('lead-dialog-open');
    });
  });
  document.querySelector('[data-lead-close]')?.addEventListener('click', () => {
    if (dialog instanceof HTMLDialogElement) dialog.close();
  });
  dialog?.addEventListener('cancel', () => {
    document.body.classList.remove('lead-dialog-open');
  });
  dialog?.addEventListener('close', () => {
    document.body.classList.remove('lead-dialog-open');
  });
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
  });
</script>

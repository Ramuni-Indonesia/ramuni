---
import DashboardMotion from './DashboardMotion.astro';

interface Props {
  id?: string;
  eyebrow?: string;
  heading?: string;
  body?: string;
  focus?: 'overview' | 'performance' | 'operations' | 'full' | string;
  location?: string;
}

const {
  id = 'commercial-proof',
  eyebrow = 'Bukti di layar',
  heading = 'Lihat bentuk pekerjaan sebelum memilih paket.',
  body = 'Satu tampilan penuh membantu tim memahami apa yang masuk, apa yang berubah, dan bagian mana yang perlu diperiksa berikutnya.',
  focus = 'overview',
  location = 'commercial_proof',
} = Astro.props;

const proofScreen = focus === 'performance'
  ? {
      src: '/website-original/product-screens/ramuni-product-dashboard-performance.webp',
      width: 1280,
      height: 854,
      mobileSrc: '/website-original/product-screens/ramuni-saas-dashboard-real-mobile-pixel7.webp',
      mobileWidth: 720,
      mobileHeight: 4299,
    }
  : focus === 'operations'
    ? {
        src: '/website-original/product-screens/ramuni-product-dashboard-operations.webp',
        width: 1280,
        height: 854,
        mobileSrc: '/website-original/product-screens/ramuni-saas-dashboard-real-mobile-pixel7.webp',
        mobileWidth: 720,
        mobileHeight: 4299,
      }
    : {
        src: '/website-original/product-screens/ramuni-saas-dashboard-desktop-1440.webp',
        width: 1440,
        height: 1202,
        mobileSrc: '/website-original/product-screens/ramuni-saas-dashboard-real-mobile-pixel7.webp',
        mobileWidth: 720,
        mobileHeight: 4299,
      };
---

<section id={id} class="commercial-proof-showcase" aria-labelledby={`${id}-title`} data-proof-location={location}>
  <div class="container">
    <div class="commercial-proof-showcase__head">
      <div><p class="section-kicker">{eyebrow}</p><h2 id={`${id}-title`}>{heading}</h2></div>
      <p>{body}</p>
    </div>
    <div class="commercial-proof-showcase__grid">
      <div class="commercial-proof-showcase__screen">
        <DashboardMotion
          focus={focus}
          priority
          label="Tampilan penuh dashboard RAMUNI dengan sidebar, metrik, grafik, aktivitas, dan insight."
          src={proofScreen.src}
          width={proofScreen.width}
          height={proofScreen.height}
          mobileSrc={proofScreen.mobileSrc}
          mobileWidth={proofScreen.mobileWidth}
          mobileHeight={proofScreen.mobileHeight}
        />
        <p class="commercial-proof-showcase__caption">Tampilan produk RAMUNI · data demo terkontrol · buka demo untuk melihat alurnya.</p>
      </div>
      <div class="commercial-proof-showcase__notes">
        <article><span>01 · Masuk</span><strong>Catatan usaha</strong><p>Transaksi, stok, biaya, dan dokumen ditempatkan pada periode yang jelas.</p></article>
        <article><span>02 · Terbaca</span><strong>Perubahan utama</strong><p>Ringkasan menyorot pergeseran yang layak dibuka lebih dulu, bukan sekadar angka besar.</p></article>
        <article><span>03 · Lanjut</span><strong>Pemeriksaan berikutnya</strong><p>Tim kembali ke sumber dan memilih tindakan sendiri dengan konteks yang sama.</p></article>
        <a class="text-link" href="/tour-produk-gratis/?flow=demo" data-analytics-event="demo_request" data-analytics-location={location} data-destination="tour">Lihat alur di demo →</a>
      </div>
    </div>
  </div>
</section>

<style is:inline>
  .commercial-proof-showcase{padding:clamp(54px,8vw,112px) 0;background:var(--ink);color:var(--white);overflow:hidden}
  .commercial-proof-showcase__head{display:grid;grid-template-columns:minmax(0,.85fr) minmax(260px,.7fr);gap:clamp(26px,7vw,100px);align-items:end;margin-bottom:34px}.commercial-proof-showcase__head h2{max-width:17ch;margin-top:10px}.commercial-proof-showcase__head>p{max-width:48ch;margin:0;color:rgb(255 255 255/.72);line-height:1.65}.commercial-proof-showcase .section-kicker{color:var(--yellow)}
  .commercial-proof-showcase__grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(240px,.65fr);gap:clamp(22px,4vw,56px);align-items:center}.commercial-proof-showcase__screen{min-width:0}.commercial-proof-showcase__screen .dashboard-motion{width:100%;max-width:100%}.commercial-proof-showcase__caption{margin:12px 0 0;color:rgb(255 255 255/.52);font-size:.66rem;line-height:1.45}.commercial-proof-showcase__notes{display:grid;gap:0;border-top:1px solid rgb(255 255 255/.2)}.commercial-proof-showcase__notes article{display:grid;gap:7px;padding:18px 0;border-bottom:1px solid rgb(255 255 255/.2)}.commercial-proof-showcase__notes article span{color:var(--yellow);font-size:.62rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.commercial-proof-showcase__notes article strong{font-size:1rem}.commercial-proof-showcase__notes article p{margin:0;color:rgb(255 255 255/.68);font-size:.78rem;line-height:1.5}.commercial-proof-showcase__notes .text-link{margin-top:18px;color:var(--white);text-underline-offset:5px}
  @media(max-width:900px){.commercial-proof-showcase__head{grid-template-columns:1fr;gap:16px}.commercial-proof-showcase__grid{grid-template-columns:1fr}.commercial-proof-showcase__screen{max-width:760px;margin-inline:auto}.commercial-proof-showcase__notes{grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;border-top:0}.commercial-proof-showcase__notes article{border:1px solid rgb(255 255 255/.2);padding:14px}.commercial-proof-showcase__notes .text-link{grid-column:1/-1;margin-top:2px}}
  @media(max-width:620px){.commercial-proof-showcase{padding-block:54px}.commercial-proof-showcase__head h2{max-width:20ch}.commercial-proof-showcase__notes{grid-template-columns:1fr;gap:0}.commercial-proof-showcase__notes article{border-inline:0;padding-inline:0}.commercial-proof-showcase__notes .text-link{margin-top:14px}}
  @media(prefers-reduced-motion:reduce){.commercial-proof-showcase__notes article{transition:none}}
</style>

---
import { homepageIndustryVisuals } from '../data/homepageVisuals';
---

<section class="home-industry-stories" aria-labelledby="home-industry-title">
  <div class="container">
      <header class="home-industry-stories__head reveal">
      <h2 id="home-industry-title">Cara kerja usaha berbeda. Pertanyaan pertama juga.</h2>
      <p>Mulai dari konteks yang Anda kenal, lalu lihat data yang perlu diperiksa.</p>
    </header>
    <div class="home-industry-stories__grid">
      {homepageIndustryVisuals.map((story, index) => <a class:list={['home-industry-story', 'reveal', { 'home-industry-story--feature': index === 0 }]} style={`--i:${index}`} href={story.href}>
        <div class="home-industry-story__image">
          <img src={story.image} width="1200" height="800" loading="lazy" decoding="async" alt={story.alt} />
          <span>{story.title}</span>
        </div>
        <div class="home-industry-story__copy">
          <h3>{story.question}</h3>
          <p>{story.text}</p>
          <small>{story.credit}</small>
        </div>
      </a>)}
      <a class="home-industry-story home-industry-story--text reveal" style="--i:3" href="/industri/">
        <span class="home-v2-kicker">Enam konteks usaha</span>
        <h3>Retail, F&amp;B, distributor, reseller, jasa, dan manufaktur kecil.</h3>
        <p>Bandingkan alur yang paling dekat dengan pekerjaan Anda.</p>
        <strong>Lihat semua industri <span aria-hidden="true">↗</span></strong>
      </a>
    </div>
  </div>
</section>

<style is:inline>
  .home-industry-stories{padding:clamp(72px,9vw,132px) 0;background:var(--ink);color:var(--white);overflow:hidden}
  .home-industry-stories__head{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(220px,.55fr);gap:30px;align-items:end;margin-bottom:clamp(34px,5vw,62px)}
  .home-industry-stories__head h2{max-width:16ch;font-size:clamp(2.2rem,5vw,5rem);line-height:.98;letter-spacing:-.06em}
  .home-industry-stories__head p{max-width:32ch;color:rgb(255 255 255/.72);line-height:1.6}
  .home-industry-stories__grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:14px}
  .home-industry-story{grid-column:span 4;display:flex;min-width:0;flex-direction:column;overflow:hidden;border:1px solid rgb(255 255 255/.2);border-radius:16px;color:var(--white);text-decoration:none;background:#12394b;transition:transform var(--base) var(--ease),border-color var(--fast),box-shadow var(--base)}
  .home-industry-story--feature{grid-column:span 6;background:var(--teal)}
  .home-industry-story:hover,.home-industry-story:focus-visible{border-color:var(--yellow);box-shadow:8px 8px 0 var(--yellow);transform:translateY(-5px)}
  .home-industry-story__image{position:relative;aspect-ratio:16/10;overflow:hidden}
  .home-industry-story__image::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 48%,rgb(5 26 35/.58))}
  .home-industry-story__image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform 620ms var(--ease)}
  .home-industry-story:hover .home-industry-story__image img{transform:scale(1.04)}
  .home-industry-story__image span{position:absolute;z-index:1;left:16px;bottom:14px;color:var(--yellow);font-size:.64rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
  .home-industry-story__copy{display:grid;gap:8px;padding:18px 18px 21px}
  .home-industry-story__copy h3{font-size:clamp(1.1rem,1.8vw,1.6rem);line-height:1.1}
  .home-industry-story__copy p{color:rgb(255 255 255/.72);font-size:.78rem;line-height:1.5}
  .home-industry-story__copy small{color:rgb(255 255 255/.48);font-size:.62rem}
  .home-industry-story--text{grid-column:span 6;justify-content:flex-end;min-height:260px;padding:clamp(22px,3vw,38px);background:var(--yellow);color:var(--ink)}
  .home-industry-story--text .home-v2-kicker{color:var(--teal)}
  .home-industry-story--text h3{max-width:15ch;margin-top:auto;font-size:clamp(1.55rem,3.1vw,2.8rem);line-height:1.02;letter-spacing:-.04em}
  .home-industry-story--text p{max-width:34ch;margin-top:14px;color:var(--ink-72);font-size:.82rem;line-height:1.5}
  .home-industry-story--text strong{display:inline-flex;gap:5px;margin-top:22px;color:var(--ink);font-size:.78rem}
  @media(max-width:900px){.home-industry-stories__head{grid-template-columns:1fr;gap:15px}.home-industry-story,.home-industry-story--feature,.home-industry-story--text{grid-column:span 6}}
  @media(max-width:620px){.home-industry-stories{padding-block:58px}.home-industry-stories__head h2{font-size:clamp(2rem,10vw,3rem)}.home-industry-stories__head p{font-size:.9rem}.home-industry-stories__grid{grid-template-columns:1fr;gap:12px}.home-industry-story,.home-industry-story--feature,.home-industry-story--text{grid-column:auto}.home-industry-story--text{min-height:230px}.home-industry-story:hover,.home-industry-story:focus-visible{transform:none;box-shadow:none}.home-industry-story:hover .home-industry-story__image img{transform:none}}
  @media(prefers-reduced-motion:reduce){.home-industry-story,.home-industry-story__image img{transition:none}.home-industry-story:hover,.home-industry-story:focus-visible{transform:none;box-shadow:none}.home-industry-story:hover .home-industry-story__image img{transform:none}}
</style>

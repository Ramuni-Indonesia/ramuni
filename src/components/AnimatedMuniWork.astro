---
interface Props {
  class?: string;
  label?: string;
}

const {
  class: className = '',
  label = 'Muni sedang membaca dashboard dan menandai informasi yang perlu diperiksa',
} = Astro.props;
---

<span
  class:list={['animated-muni-work', className]}
  role="img"
  aria-label={label}
  data-animated-muni-work
  data-animate="false"
>
  <video
    muted
    playsinline
    preload="metadata"
    poster="/website-original/mascot/ramuni-mascot-work-loop-poster.webp"
    aria-hidden="true"
    tabindex="-1"
  >
    <source src="/website-original/mascot/ramuni-mascot-work-loop.webm" type="video/webm" />
    <source src="/website-original/mascot/ramuni-mascot-work-loop.mp4" type="video/mp4" />
  </video>
</span>

<script>
  const bindAnimatedMuniWork = () => {
    document.querySelectorAll<HTMLElement>('[data-animated-muni-work]').forEach((mascot) => {
      if (mascot.dataset.bound === 'true') return;
      mascot.dataset.bound = 'true';

      const video = mascot.querySelector<HTMLVideoElement>('video');
      if (!video) return;

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const saveData = Boolean((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData);
      let inView = false;
      let hasPlayed = false;

      const update = () => {
        const canAnimate = inView && !document.hidden && !reducedMotion.matches && !saveData;
        mascot.dataset.animate = canAnimate ? 'true' : 'false';
        if (canAnimate && !hasPlayed) {
          hasPlayed = true;
          video.playbackRate = 0.86;
          video.currentTime = 0;
          void video.play().catch(() => undefined);
        } else {
          video.pause();
          if (!inView || document.hidden || reducedMotion.matches) {
            hasPlayed = false;
            video.currentTime = 0;
          }
        }
      };

      if (!('IntersectionObserver' in window)) {
        inView = true;
        update();
        return;
      }

      const observer = new IntersectionObserver(([entry]) => {
        inView = entry?.isIntersecting ?? false;
        update();
      }, { rootMargin: '120px 0px', threshold: 0.08 });

      observer.observe(mascot);
      document.addEventListener('visibilitychange', update);
      reducedMotion.addEventListener?.('change', update);
    });
  };

  bindAnimatedMuniWork();
  document.addEventListener('astro:page-load', bindAnimatedMuniWork);
</script>

<style>
  .animated-muni-work{
    position:relative;
    display:block;
    width:var(--animated-muni-size,148px);
    aspect-ratio:188/211;
    flex:0 0 auto;
    border:1px solid rgb(11 48 69/.18);
    background-color:var(--rice);
    box-shadow:7px 7px 0 var(--yellow);
    overflow:hidden;
    contain:paint;
  }

  .animated-muni-work::after{
    content:'Memeriksa bukti';
    position:absolute;
    z-index:2;
    left:10px;
    bottom:10px;
    padding:6px 8px;
    background:rgb(11 48 69/.9);
    color:var(--white);
    font-size:.5rem;
    font-weight:800;
    letter-spacing:.06em;
    text-transform:uppercase;
    opacity:0;
    transform:translateY(6px);
    pointer-events:none;
  }

  .animated-muni-work video{
    display:block;
    width:100%;
    height:100%;
    object-fit:cover;
  }

  @media(prefers-reduced-motion:no-preference){
    .animated-muni-work[data-animate='true']{animation:muni-work-attend 7.2s cubic-bezier(.22,1,.36,1) both}
    .animated-muni-work[data-animate='true']::after{animation:muni-work-label 6s 1.2s cubic-bezier(.22,1,.36,1) both}
    @keyframes muni-work-attend{0%{transform:translateY(10px)}12%,68%{transform:none}78%{transform:translateY(-3px)}100%{transform:none}}
    @keyframes muni-work-label{0%{opacity:0;transform:translateY(6px)}10%,58%{opacity:1;transform:none}78%,100%{opacity:0;transform:none}}
  }

  @media(max-width:680px){.animated-muni-work{--animated-muni-size:112px;box-shadow:5px 5px 0 var(--yellow)}}
  @media(prefers-reduced-motion:reduce){
    .animated-muni-work video{visibility:hidden}
    .animated-muni-work{
      background:var(--rice) url('/website-original/mascot/ramuni-mascot-work-loop-poster.webp') center/cover no-repeat;
    }
    .animated-muni-work::after{display:none}
  }
</style>

---
interface Props {
  class?: string;
  label?: string;
}

const {
  class: className = '',
  label = 'Muni sedang membaca dashboard dan menandai informasi yang perlu diperiksa',
} = Astro.props;
---

<span
  class:list={['animated-muni-work', className]}
  role="img"
  aria-label={label}
  data-animated-muni-work
  data-mascot-motion="work"
  data-animate="false"
>
  <video
    muted
    loop
    playsinline
    preload="metadata"
    poster="/website-original/mascot/ramuni-mascot-work-loop-poster.webp"
    aria-hidden="true"
    tabindex="-1"
  >
    <source src="/website-original/mascot/ramuni-mascot-work-loop.webm" type="video/webm" />
    <source src="/website-original/mascot/ramuni-mascot-work-loop.mp4" type="video/mp4" />
  </video>
</span>

<script>
  const animatedMuniCleanups = new Map<HTMLElement, () => void>();

  const bindAnimatedMuniWork = () => {
    document.querySelectorAll<HTMLElement>('[data-animated-muni-work]').forEach((mascot) => {
      if (mascot.dataset.bound === 'true') return;
      mascot.dataset.bound = 'true';

      const video = mascot.querySelector<HTMLVideoElement>('video');
      if (!video) return;

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const saveData = Boolean((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData);
      let inView = false;
      const update = () => {
        const canAnimate = inView && !document.hidden && !reducedMotion.matches && !saveData;
        mascot.dataset.animate = canAnimate ? 'true' : 'false';
        if (canAnimate) {
          video.playbackRate = 0.9;
          void video.play().catch(() => undefined);
        } else {
          video.pause();
          if (reducedMotion.matches || saveData) {
            video.currentTime = 0;
          }
        }
      };

      let observer: IntersectionObserver | undefined;
      if (!('IntersectionObserver' in window)) {
        inView = true;
        update();
      } else {
        observer = new IntersectionObserver(([entry]) => {
          inView = entry?.isIntersecting ?? false;
          update();
        }, { rootMargin: '120px 0px', threshold: 0.08 });
        observer.observe(mascot);
      }
      document.addEventListener('visibilitychange', update);
      reducedMotion.addEventListener?.('change', update);
      animatedMuniCleanups.set(mascot, () => {
        observer?.disconnect();
        document.removeEventListener('visibilitychange', update);
        reducedMotion.removeEventListener?.('change', update);
        video.pause();
        delete mascot.dataset.bound;
      });
    });
  };

  bindAnimatedMuniWork();
  document.addEventListener('astro:page-load', bindAnimatedMuniWork);
  document.addEventListener('astro:before-swap', () => {
    animatedMuniCleanups.forEach((cleanup) => cleanup());
    animatedMuniCleanups.clear();
  });
</script>

<style>
  .animated-muni-work{
    position:relative;
    display:block;
    width:var(--animated-muni-size,148px);
    aspect-ratio:188/211;
    flex:0 0 auto;
    border:0;
    border-radius:34% 34% 30% 30%;
    background:transparent;
    filter:drop-shadow(0 16px 24px rgb(11 48 69/.14));
    overflow:hidden;
    contain:paint;
  }

  .animated-muni-work video{
    display:block;
    width:100%;
    height:100%;
    object-fit:cover;
    mix-blend-mode:multiply;
  }

  @media(max-width:680px){.animated-muni-work{--animated-muni-size:112px;filter:drop-shadow(0 12px 20px rgb(11 48 69/.12))}}
  @media(prefers-reduced-motion:reduce){
    .animated-muni-work video{visibility:hidden}
    .animated-muni-work{
      background:var(--rice) url('/website-original/mascot/ramuni-mascot-work-loop-poster.webp') center/cover no-repeat;
    }
  }
</style>

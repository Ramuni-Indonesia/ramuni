---
interface Props {
  class?: string;
  label?: string;
  static?: boolean;
}

const {
  class: className = '',
  label = 'Muni sedang membaca dashboard dan menandai informasi yang perlu diperiksa',
  static: staticMuni = false,
} = Astro.props;
---

<span
  class:list={['animated-muni-work', className]}
  role="img"
  aria-label={label}
  data-animated-muni-work
  data-mascot-motion="work"
>
  {staticMuni ? (
    <img src="/website-original/mascot/ramuni-mascot-3d-guide.webp" width="384" height="384" alt="" aria-hidden="true" loading="lazy" decoding="async" />
  ) : (
    <video
      data-animated-muni-video
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/website-original/mascot/ramuni-mascot-work-loop-poster.webp"
      aria-hidden="true"
    >
      <source src="/website-original/mascot/ramuni-mascot-work-loop.webm" type="video/webm" />
      <source src="/website-original/mascot/ramuni-mascot-work-loop.mp4" type="video/mp4" />
    </video>
  )}
</span>

<style>
  .animated-muni-work{
    position:relative;
    display:block;
    width:var(--animated-muni-size,148px);
    aspect-ratio:1;
    flex:0 0 auto;
    border:0;
    border-radius:0;
    background:transparent;
    filter:drop-shadow(0 16px 24px rgb(11 48 69/.14));
    overflow:visible;
    contain:layout;
  }

  .animated-muni-work video,.animated-muni-work img{
    display:block;
    width:100%;
    height:100%;
    object-fit:contain;
    mix-blend-mode:multiply;
    transform-origin:50% 84%;
    will-change:translate,rotate,scale;
  }

  @media(max-width:680px){.animated-muni-work{--animated-muni-size:112px;filter:drop-shadow(0 12px 20px rgb(11 48 69/.12))}}
  @media(prefers-reduced-motion:reduce){.animated-muni-work video{will-change:auto}}
</style>

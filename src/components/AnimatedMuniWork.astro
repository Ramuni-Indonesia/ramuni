---
interface Props {
  class?: string;
  label?: string;
}

const {
  class: className = '',
  label = 'Muni sedang membaca dashboard dan menandai informasi yang perlu diperiksa',
} = Astro.props;
---

<span
  class:list={['animated-muni-work', className]}
  role="img"
  aria-label={label}
  data-animated-muni-work
  data-mascot-motion="work"
>
  <img
    src="/website-original/ramuni-mascot-muni-manyar.webp"
    width="720"
    height="720"
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
  />
</span>

<style>
  .animated-muni-work{
    position:relative;
    display:block;
    width:var(--animated-muni-size,148px);
    aspect-ratio:1;
    flex:0 0 auto;
    border:0;
    border-radius:0;
    background:transparent;
    filter:drop-shadow(0 16px 24px rgb(11 48 69/.14));
    overflow:visible;
    contain:layout;
  }

  .animated-muni-work img{
    display:block;
    width:100%;
    height:100%;
    object-fit:contain;
    mix-blend-mode:multiply;
  }

  @media(max-width:680px){.animated-muni-work{--animated-muni-size:112px;filter:drop-shadow(0 12px 20px rgb(11 48 69/.12))}}
</style>

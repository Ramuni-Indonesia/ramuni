---
import dashboardMotionStyles from '../styles/dashboard-motion.css?inline';
import LaptopMockup from './LaptopMockup.astro';

interface Props {
  class?: string;
  label?: string;
  focus?: 'overview' | 'performance' | 'operations' | 'full' | string;
  priority?: boolean;
  src?: string;
  width?: number;
  height?: number;
  mobileSrc?: string;
  mobileWidth?: number;
  mobileHeight?: number;
  /** Defer hidden tab-panel imagery until its panel is activated. */
  defer?: boolean;
}

const {
  class: className = '',
  label = 'Tampilan dashboard RAMUNI yang bergerak memperlihatkan ringkasan, arus kas, aktivitas, dan status data.',
  focus = 'overview',
  priority = false,
  src = '/website-original/product-screens/ramuni-saas-dashboard-desktop-1440.webp',
  width = 1440,
  height = 1202,
  mobileSrc,
  mobileWidth,
  mobileHeight,
  defer = false,
} = Astro.props;

const aspectRatio = `${width}/${height}`;
const mobileAspectRatio = mobileWidth && mobileHeight ? `${mobileWidth}/${mobileHeight}` : aspectRatio;
const scanDistance = Math.round((height / width) * 8000) / 100;
const mobileScanDistance = mobileWidth && mobileHeight ? Math.round((mobileHeight / mobileWidth) * 8000) / 100 : scanDistance;
---

<style is:inline set:html={dashboardMotionStyles} />

<span
  class:list={['dashboard-motion', 'dashboard-motion--' + focus, className]}
  style={`--dashboard-aspect:${aspectRatio};--dashboard-mobile-aspect:${mobileAspectRatio};--dashboard-scan-distance:calc(${scanDistance}cqw - 2px);--dashboard-mobile-scan-distance:calc(${mobileScanDistance}cqw - 2px)`}
  data-dashboard-motion
  data-active="false"
>
  <LaptopMockup label={label}>
    <span class="dashboard-motion__screen">
      <picture>
        {mobileSrc && <source media="(max-width: 740px)" srcset={mobileSrc} width={mobileWidth} height={mobileHeight} />}
      <img
          class="dashboard-motion__image"
          src={defer ? undefined : src}
          data-src={defer ? src : undefined}
          width={width}
          height={height}
          alt={label}
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
          decoding="async"
        />
      </picture>
      <span class="dashboard-motion__scanline"></span>
    </span>
  </LaptopMockup>
</span>

<script>
  const dashboardMotionObservers = new Map<HTMLElement, IntersectionObserver>();

  const bindDashboardMotion = () => {
    document.querySelectorAll<HTMLElement>('[data-dashboard-motion]').forEach((dashboard) => {
      if (dashboard.dataset.bound === 'true') return;
      dashboard.dataset.bound = 'true';
      if (!('IntersectionObserver' in window)) {
        dashboard.dataset.active = 'true';
        return;
      }
      const observer = new IntersectionObserver(([entry]) => {
        dashboard.dataset.active = entry?.isIntersecting && !document.hidden ? 'true' : 'false';
      }, { rootMargin: '120px 0px', threshold: 0.08 });
      observer.observe(dashboard);
      dashboardMotionObservers.set(dashboard, observer);
    });
  };

  bindDashboardMotion();
  document.addEventListener('astro:page-load', bindDashboardMotion);
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      document.querySelectorAll<HTMLElement>('[data-dashboard-motion]').forEach((dashboard) => {
        dashboard.dataset.active = 'false';
      });
    } else {
      document.querySelectorAll<HTMLElement>('[data-dashboard-motion]').forEach((dashboard) => {
        const bounds = dashboard.getBoundingClientRect();
        dashboard.dataset.active = bounds.bottom >= -120 && bounds.top <= window.innerHeight + 120 ? 'true' : 'false';
      });
    }
  });
  document.addEventListener('astro:before-swap', () => {
    dashboardMotionObservers.forEach((observer, dashboard) => {
      observer.disconnect();
      delete dashboard.dataset.bound;
    });
    dashboardMotionObservers.clear();
  });
</script>

---
import '../styles/dashboard-motion.css';

interface Props {
  class?: string;
  label?: string;
  focus?: 'overview' | 'performance' | 'operations' | 'full' | string;
  priority?: boolean;
  src?: string;
  width?: number;
  height?: number;
  mobileSrc?: string;
  mobileWidth?: number;
  mobileHeight?: number;
}

const {
  class: className = '',
  label = 'Tampilan dashboard RAMUNI yang bergerak memperlihatkan ringkasan, arus kas, aktivitas, dan status data.',
  focus = 'overview',
  priority = false,
  src = '/website-original/product-screens/ramuni-saas-dashboard-desktop-1440.webp',
  width = 1440,
  height = 1202,
  mobileSrc,
  mobileWidth,
  mobileHeight,
} = Astro.props;

const aspectRatio = `${width}/${height}`;
const mobileAspectRatio = mobileWidth && mobileHeight ? `${mobileWidth}/${mobileHeight}` : aspectRatio;
const scanDistance = Math.round((height / width) * 8000) / 100;
const mobileScanDistance = mobileWidth && mobileHeight ? Math.round((mobileHeight / mobileWidth) * 8000) / 100 : scanDistance;
---

<span
  class:list={['dashboard-motion', 'dashboard-motion--' + focus, className]}
  style={`--dashboard-aspect:${aspectRatio};--dashboard-mobile-aspect:${mobileAspectRatio};--dashboard-scan-distance:calc(${scanDistance}cqw - 2px);--dashboard-mobile-scan-distance:calc(${mobileScanDistance}cqw - 2px)`}
  role="img"
  aria-label={label}
>
  <span class="dashboard-motion__screen" aria-hidden="true">
    <picture>
      {mobileSrc && <source media="(max-width: 740px)" srcset={mobileSrc} width={mobileWidth} height={mobileHeight} />}
      <img
        class="dashboard-motion__image"
        src={src}
        width={width}
        height={height}
        alt=""
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
      />
    </picture>
    <span class="dashboard-motion__scanline"></span>
  </span>
  <span class="dashboard-motion__timeline" aria-hidden="true">
    <i></i><i></i><i></i>
  </span>
</span>

---

interface Props {
  kind: string;
  location: string;
  enabled: boolean;
  submitChoices?: boolean;
}

const { kind, location, enabled, submitChoices = false } = Astro.props;
const fieldId = (name: string) => `${kind}-${location}-${name}`;
---

<fieldset class="lead-form__step" data-form-step="1" data-active="true" disabled={enabled ? undefined : true}>
  <div class="form-grid">
    <div class="field">
      <label for={fieldId('name')}>Nama lengkap</label>
      <input id={fieldId('name')} name="name" autocomplete="name" placeholder="Nama Anda" required maxlength="150" />
    </div>
    <div class="field">
      <label for={fieldId('phone')}>Nomor WhatsApp</label>
      <div class="phone-field-row">
        <div class="field field--phone-country">
          <label class="visually-hidden" for={fieldId('phone-country')}>Kode negara</label>
          <select id={fieldId('phone-country')} name="phoneCountry" aria-label="Kode negara" data-phone-countries="ID:+62" required>
            <option value="+62" selected>🇮🇩 +62</option>
          </select>
        </div>
        <input id={fieldId('phone')} name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="8123 4567" required maxlength="24" />
      </div>
    </div>
    <div class="field">
      <label for={fieldId('email')}>Email</label>
      <input id={fieldId('email')} name="email" type="email" autocomplete="email" placeholder="nama@usaha.com" required maxlength="254" />
    </div>
    {submitChoices && <div class="field">
      <label for={fieldId('size')}>Jumlah karyawan</label>
      <select id={fieldId('size')} name="businessSize" required>
        <option value="" disabled selected>Pilih jumlah karyawan</option>
        <option value="1">1 orang</option>
        <option value="2-5">2 sampai 5 orang</option>
        <option value="6-20">6 sampai 20 orang</option>
        <option value="21-50">21 sampai 50 orang</option>
        <option value="51-plus">Lebih dari 50 orang</option>
      </select>
    </div>}
  </div>
  <input type="hidden" name="consent" value="yes" />
  <input type="hidden" name="leadType" value={kind} />
  <input type="hidden" name="consentVersion" value="2026-07-25" />
</fieldset>

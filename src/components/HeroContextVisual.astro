---
export type HeroContextScene =
  | 'industry-hub' | 'retail' | 'fnb' | 'distributor' | 'reseller-online' | 'jasa' | 'manufaktur-kecil'
  | 'role-hub' | 'pemilik-usaha' | 'admin-toko' | 'kasir' | 'supervisor' | 'support';

type SceneMode = 'workspace' | 'inventory' | 'sales' | 'cash' | 'people' | 'support';
interface Props { scene?: HeroContextScene; label?: string; title?: string; }

const { scene = 'industry-hub', label, title } = Astro.props;
const baseMascots = {
  muni: '/website-original/mascot/phase-1/muni-manyar-friendly-v2.webp',
  ramu: '/website-original/mascot/phase-1/si-ramu-friendly-v2.webp',
  kancil: '/website-original/mascot/phase-1/kancil-cermat-friendly-v2.webp',
} as const;
const profiles: Record<HeroContextScene, { mode: SceneMode; eyebrow: string; headline: string; image: string; imageAlt: string; mascot: keyof typeof baseMascots; chips: string[]; accent: 'teal' | 'yellow' | 'ink' }> = {
  'industry-hub': { mode: 'workspace', eyebrow: 'Konteks usaha', headline: 'Setiap usaha dibaca dari ritme pekerjaan hariannya.', image: '/website-original/context/ramuni-context-umkm-signal-workspace.webp', imageAlt: 'Meja kerja usaha dengan catatan, kalkulator, dan alur arah berwarna RAMUNI', mascot: 'kancil', chips: ['Ritme usaha', 'Catatan harian', 'Arah cek'], accent: 'teal' },
  retail: { mode: 'inventory', eyebrow: 'Rak dan SKU', headline: 'Laju jual dilihat bersama stok yang tersedia.', image: '/website-original/context/ramuni-context-stock-operations.webp', imageAlt: 'Rak stok toko dengan produk tersusun dan catatan pemeriksaan', mascot: 'muni', chips: ['Produk laris', 'Sisa stok', 'Reorder'], accent: 'yellow' },
  fnb: { mode: 'inventory', eyebrow: 'Menu dan bahan', headline: 'Menu ramai dipasangkan dengan kebutuhan bahan.', image: '/website-original/context/ramuni-context-stock-operations.webp', imageAlt: 'Rak bahan dan produk yang disusun untuk pemeriksaan operasional', mascot: 'kancil', chips: ['Menu ramai', 'Bahan utama', 'Jam puncak'], accent: 'yellow' },
  distributor: { mode: 'sales', eyebrow: 'Pesanan ulang', headline: 'Order, pelanggan rutin, dan stok dibaca dalam satu urutan.', image: '/website-original/context/ramuni-context-sales-customer.webp', imageAlt: 'Ilustrasi hubungan penjualan dan pelanggan pada konteks usaha', mascot: 'ramu', chips: ['Order aktif', 'Pelanggan rutin', 'Stok kirim'], accent: 'teal' },
  'reseller-online': { mode: 'sales', eyebrow: 'Kanal penjualan', headline: 'Produk ramai tetap dicek bersama margin dan kanal.', image: '/website-original/context/ramuni-context-sales-customer.webp', imageAlt: 'Ilustrasi penjualan dan pelanggan untuk membaca kanal usaha', mascot: 'muni', chips: ['Katalog', 'Kanal jual', 'Margin'], accent: 'ink' },
  jasa: { mode: 'cash', eyebrow: 'Layanan dan biaya', headline: 'Pendapatan layanan dibaca bersama biaya pendukung.', image: '/website-original/context/ramuni-context-cash-report.webp', imageAlt: 'Ilustrasi arus kas dan laporan usaha dalam gaya RAMUNI', mascot: 'ramu', chips: ['Kas masuk', 'Biaya', 'Repeat order'], accent: 'teal' },
  'manufaktur-kecil': { mode: 'inventory', eyebrow: 'Bahan ke barang jadi', headline: 'Bahan, proses, dan penjualan tidak dibaca terpisah.', image: '/website-original/context/ramuni-context-stock-operations.webp', imageAlt: 'Rak persediaan dan alur pemeriksaan stok untuk usaha kecil', mascot: 'kancil', chips: ['Bahan', 'Proses', 'Barang jadi'], accent: 'yellow' },
  'role-hub': { mode: 'people', eyebrow: 'Akses peran', headline: 'Satu sumber data, sudut baca berbeda untuk setiap orang.', image: '/website-original/context/ramuni-context-ai-import.webp', imageAlt: 'Ilustrasi ruang kerja data dengan catatan yang siap diperiksa', mascot: 'ramu', chips: ['Pemilik', 'Admin', 'Kasir'], accent: 'teal' },
  'pemilik-usaha': { mode: 'people', eyebrow: 'Layar pemilik', headline: 'Ringkasan menyorot keputusan yang perlu disetujui.', image: '/website-original/context/ramuni-context-umkm-signal-workspace.webp', imageAlt: 'Meja kerja pemilik usaha dengan catatan dan arah pemeriksaan', mascot: 'kancil', chips: ['Arah bisnis', 'Bukti', 'Keputusan'], accent: 'ink' },
  'admin-toko': { mode: 'workspace', eyebrow: 'Ruang admin', headline: 'Data yang belum rapi ditandai sebelum masuk ringkasan.', image: '/website-original/context/ramuni-context-ai-import.webp', imageAlt: 'Ilustrasi impor catatan usaha dan pemeriksaan data', mascot: 'ramu', chips: ['Import', 'Koreksi', 'Sinkron'], accent: 'teal' },
  kasir: { mode: 'sales', eyebrow: 'Meja kasir', headline: 'Transaksi dibantu tanpa membuka area sensitif.', image: '/website-original/context/ramuni-context-sales-customer.webp', imageAlt: 'Ilustrasi transaksi dan pelanggan untuk konteks kasir', mascot: 'muni', chips: ['Transaksi', 'Pembayaran', 'Bantuan'], accent: 'yellow' },
  supervisor: { mode: 'people', eyebrow: 'Pengecualian', headline: 'Masalah harian dikirim dengan konteks yang jelas.', image: '/website-original/context/ramuni-context-stock-operations.webp', imageAlt: 'Rak operasional untuk membaca pengecualian stok dan pekerjaan tim', mascot: 'kancil', chips: ['Antrian', 'Stok turun', 'Tindak lanjut'], accent: 'teal' },
  support: { mode: 'support', eyebrow: 'Alur bantuan', headline: 'Cari masalah, siapkan konteks aman, lalu pilih dukungan.', image: '/website-original/context/ramuni-context-ai-import.webp', imageAlt: 'Ilustrasi catatan dukungan dan pemeriksaan konteks', mascot: 'muni', chips: ['Cari topik', 'Baca rujukan', 'Hubungi'], accent: 'teal' },
};
const profile = profiles[scene] ?? profiles['industry-hub'];
const mascotSrc = baseMascots[profile.mascot];
---

<figure class:list={['hero-context', 'hero-context--' + profile.mode, 'hero-context--' + profile.accent]} aria-labelledby={'hero-context-' + scene}>
  <div class="hero-context__media">
    <img class="hero-context__image" src={profile.image} width="1200" height="720" alt={profile.imageAlt} loading="lazy" decoding="async" />
    <div class="hero-context__soft-panel" aria-hidden="true">
      <span>{profile.eyebrow}</span>
      <strong>Fokus yang dibuka</strong>
      <ol>{profile.chips.map((chip) => <li>{chip}</li>)}</ol>
    </div>
  </div>

  <img class="hero-context__mascot" data-mascot-motion="guide" src={mascotSrc} width="1024" height="1024" alt="" loading="lazy" decoding="async" aria-hidden="true" />

  <figcaption>
    <span>{label || profile.eyebrow}</span>
    <strong id={'hero-context-' + scene}>{title || profile.headline}</strong>
  </figcaption>
</figure>

<style>
  .hero-context{--hero-accent:var(--teal);position:relative;min-height:520px;margin:0;overflow:hidden;border:1px solid var(--ink);background:var(--rice);box-shadow:16px 16px 0 var(--ink);isolation:isolate}
  .hero-context--yellow{--hero-accent:var(--yellow)}.hero-context--ink{--hero-accent:var(--ink)}
  .hero-context::before{position:absolute;inset:0;z-index:-2;background:radial-gradient(circle at 82% 16%,rgb(242 177 52/.34),transparent 28%),radial-gradient(circle at 12% 82%,rgb(22 140 140/.18),transparent 31%);content:""}
  .hero-context::after{position:absolute;right:-86px;bottom:-112px;z-index:-1;width:310px;height:310px;border-radius:50%;background:var(--hero-accent);opacity:.18;content:""}
  .hero-context__media{position:absolute;inset:28px 28px 100px 92px;overflow:hidden;border:1px solid var(--ink);background:var(--white);box-shadow:10px 10px 0 rgb(11 48 69/.14)}
  .hero-context__image{display:block;width:100%;height:100%;object-fit:cover;object-position:center}
  .hero-context__media::after{position:absolute;inset:0;background:linear-gradient(90deg,rgb(11 48 69/.04),transparent 42%),linear-gradient(0deg,rgb(11 48 69/.3),transparent 46%);content:""}
  .hero-context__soft-panel{position:absolute;right:18px;bottom:18px;z-index:2;width:min(265px,58%);padding:16px;border:1px solid rgb(255 255 255/.5);border-radius:18px;background:rgb(255 255 255/.86);box-shadow:0 18px 46px rgb(11 48 69/.16);backdrop-filter:blur(12px)}
  .hero-context__soft-panel>span{display:block;color:var(--teal);font-size:.64rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.hero-context__soft-panel strong{display:block;margin-top:8px;font-size:.92rem}.hero-context__soft-panel ol{display:flex;flex-wrap:wrap;gap:6px;margin:12px 0 0;padding:0;list-style:none}.hero-context__soft-panel li{padding:6px 9px;border-radius:999px;background:var(--rice);color:var(--ink);font-size:.64rem;font-weight:800}
  .hero-context__mascot{position:absolute;left:-58px;bottom:70px;z-index:3;width:clamp(170px,28%,245px);height:auto;filter:drop-shadow(0 16px 26px rgb(11 48 69/.18));mix-blend-mode:multiply;transform-origin:50% 100%}
  .hero-context figcaption{position:absolute;right:20px;bottom:20px;left:20px;z-index:4;display:grid;gap:6px;padding:16px 18px;border:1px solid var(--ink-10);background:var(--rice);color:var(--ink)}
  .hero-context figcaption span{color:var(--teal);font-size:.66rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.hero-context figcaption strong{max-width:54ch;font-size:.9rem;line-height:1.35}

  @media(prefers-reduced-motion:no-preference){
    .hero-context__image{animation:hero-context-image-drift 12s var(--ease) infinite alternate}
    .hero-context__soft-panel{animation:hero-context-panel-in .7s var(--ease) both}
    .hero-context__soft-panel li{animation:hero-context-chip-in .55s var(--ease) both}.hero-context__soft-panel li:nth-child(2){animation-delay:90ms}.hero-context__soft-panel li:nth-child(3){animation-delay:180ms}
  }
  @keyframes hero-context-image-drift{from{transform:scale(1.02) translate3d(-.6%,0,0)}to{transform:scale(1.07) translate3d(.8%,-.8%,0)}}
  @keyframes hero-context-panel-in{from{opacity:.35;transform:translate3d(18px,12px,0)}to{opacity:1;transform:none}}
  @keyframes hero-context-chip-in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

  @media(max-width:900px){.hero-context{min-height:450px}.hero-context__media{inset:26px 22px 116px 72px}.hero-context__mascot{left:-56px;bottom:88px;width:188px}}
  @media(max-width:620px){.hero-context{min-height:430px;box-shadow:8px 8px 0 var(--ink)}.hero-context__media{inset:18px 14px 136px 46px}.hero-context__soft-panel{right:12px;bottom:12px;width:min(245px,72%);padding:13px}.hero-context__soft-panel li{font-size:.6rem}.hero-context__mascot{left:-68px;bottom:120px;width:152px}.hero-context figcaption{right:14px;bottom:14px;left:14px}}
  @media(prefers-reduced-motion:reduce){.hero-context__image,.hero-context__mascot,.hero-context__soft-panel,.hero-context__soft-panel li{animation:none!important;transform:none!important}}
</style>

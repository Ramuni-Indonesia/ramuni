---
type Visual = {
  src: string;
  width: number;
  height: number;
  alt: string;
};

interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  headingId?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  visual: Visual;
  visualBadge?: string;
  points?: string[];
  theme?: 'rice' | 'ink' | 'teal';
}


const {
  eyebrow = 'Langkah berikutnya',
  title,
  body,
  headingId,
  primaryLabel = 'Konsultasi',
  primaryHref = '/tour-produk-gratis/?flow=consultation',
  secondaryLabel,
  secondaryHref,
  visual,
  visualBadge = 'Ilustrasi konteks',
  points = ['Bawa satu pertanyaan usaha', 'Lihat data dan alurnya', 'Bahas langkah yang dapat dilakukan'],
  theme = 'rice',
} = Astro.props;
---

<aside class:list={['tour-evidence-cta', `tour-evidence-cta--${theme}`]} aria-label="Ajakan untuk melihat contoh alur RAMUNI" data-tour-evidence-motion data-motion-active="false">
  <div class="tour-evidence-cta__copy">
    <p>{eyebrow}</p>
    <h2 id={headingId}>{title}</h2>
    <p>{body}</p>
    <div class="tour-evidence-cta__actions">
      <a class="button button--primary" href={primaryHref}>{primaryLabel}</a>
      {secondaryLabel && secondaryHref && <a class="button button--secondary" href={secondaryHref}>{secondaryLabel}</a>}
    </div>
  </div>

  <figure class="tour-evidence-cta__visual">
    <div class="tour-evidence-cta__image-frame">
      <img src={visual.src} width={visual.width} height={visual.height} alt={visual.alt} loading="lazy" decoding="async" />
    </div>
    <figcaption aria-label={visualBadge}>
      <span class="sr-only">{visualBadge}</span>
      <ol>
        {points.slice(0, 3).map((point, index) => <li><b>{String(index + 1).padStart(2, '0')}</b><small>{point}</small></li>)}
      </ol>
    </figcaption>
  </figure>
</aside>

<script>
  const tourEvidenceCleanups = new Map<HTMLElement, () => void>();

  const bindTourEvidenceMotion = () => {
    document.querySelectorAll<HTMLElement>('[data-tour-evidence-motion]').forEach((cta) => {
      if (cta.dataset.motionBound === 'true') return;
      cta.dataset.motionBound = 'true';

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let inView = false;
      const update = () => {
        cta.dataset.motionActive = inView && !document.hidden && !reducedMotion.matches ? 'true' : 'false';
      };

      let observer: IntersectionObserver | undefined;
      if ('IntersectionObserver' in window) {
        observer = new IntersectionObserver(([entry]) => {
          inView = entry?.isIntersecting ?? false;
          update();
        }, { rootMargin: '80px 0px', threshold: 0.12 });
        observer.observe(cta);
      } else {
        inView = true;
        update();
      }

      document.addEventListener('visibilitychange', update);
      reducedMotion.addEventListener?.('change', update);
      tourEvidenceCleanups.set(cta, () => {
        observer?.disconnect();
        document.removeEventListener('visibilitychange', update);
        reducedMotion.removeEventListener?.('change', update);
        cta.dataset.motionActive = 'false';
        delete cta.dataset.motionBound;
      });
    });
  };

  bindTourEvidenceMotion();
  document.addEventListener('astro:page-load', bindTourEvidenceMotion);
  document.addEventListener('astro:before-swap', () => {
    tourEvidenceCleanups.forEach((cleanup) => cleanup());
    tourEvidenceCleanups.clear();
  });
</script>

<style>
  .tour-evidence-cta{position:relative;display:grid;grid-template-columns:minmax(0,.82fr) minmax(420px,1.18fr);gap:clamp(28px,5vw,72px);align-items:center;padding:clamp(28px,5vw,62px);overflow:hidden;border:1px solid var(--ink-10);background:var(--rice);color:var(--ink);contain:paint}
  .tour-evidence-cta::before{content:"";position:absolute;top:0;left:0;width:clamp(54px,8vw,112px);height:4px;background:var(--yellow);transform:scaleX(.35);transform-origin:left}
  .tour-evidence-cta--ink{border-color:rgb(255 255 255/.16);background:var(--ink);color:var(--white)}
  .tour-evidence-cta--teal{border-color:rgb(255 255 255/.18);background:var(--teal);color:var(--white)}
  .tour-evidence-cta__copy{min-width:0}
  .tour-evidence-cta__copy>p:first-child{margin:0;color:var(--teal);font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .tour-evidence-cta--ink .tour-evidence-cta__copy>p:first-child,.tour-evidence-cta--teal .tour-evidence-cta__copy>p:first-child{color:var(--yellow)}
  .tour-evidence-cta__copy h2{max-width:18ch;margin:16px 0 0;font-size:var(--type-h2);line-height:1.04;text-wrap:balance}
  .tour-evidence-cta__copy>p:not(:first-child){max-width:49ch;margin:20px 0 0;color:var(--ink-72);line-height:1.65;text-wrap:pretty}
  .tour-evidence-cta--ink .tour-evidence-cta__copy>p:not(:first-child),.tour-evidence-cta--teal .tour-evidence-cta__copy>p:not(:first-child){color:rgb(255 255 255/.74)}
  .tour-evidence-cta__actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
  .tour-evidence-cta--rice .button--secondary{border-color:var(--ink);color:var(--ink)}
  .tour-evidence-cta--ink .button--secondary,.tour-evidence-cta--teal .button--secondary{border-color:rgb(255 255 255/.46);color:var(--white)}
  .tour-evidence-cta__visual{position:relative;min-width:0;margin:0;overflow:visible;border:1px solid var(--ink-10);background:var(--white);box-shadow:none}
  .tour-evidence-cta--ink .tour-evidence-cta__visual,.tour-evidence-cta--teal .tour-evidence-cta__visual{border-color:rgb(255 255 255/.18);box-shadow:none}
  .tour-evidence-cta__image-frame{display:grid;place-items:center;overflow:hidden;background:var(--rice);aspect-ratio:1.55;padding:0}
  .tour-evidence-cta__card-frame{display:grid;place-items:center;overflow:hidden;background:var(--rice);aspect-ratio:1.55;padding:0}
  .tour-evidence-cta__visual img{display:block;width:100%;height:100%;object-fit:contain;transform:translate3d(0,0,0)}
  .tour-evidence-cta__visual figcaption{display:block;background:var(--white);color:var(--ink);border-top:1px solid var(--ink-10)}
  .tour-evidence-cta__visual ol{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin:0;padding:0;list-style:none;background:var(--white)}
  .tour-evidence-cta__visual li{display:grid;gap:8px;min-width:0;padding:15px;border-right:1px solid var(--ink-10)}
  .tour-evidence-cta__visual li:last-child{border-right:0}
  .tour-evidence-cta__visual b{color:var(--teal);font-size:.6rem}
  .tour-evidence-cta__visual small{font-size:.72rem;font-weight:800;line-height:1.35;text-wrap:pretty}
  @media(prefers-reduced-motion:no-preference){
    .tour-evidence-cta::before{animation:tour-evidence-rule 5.8s var(--ease) infinite;animation-play-state:paused}
    .tour-evidence-cta__visual img{animation:tour-evidence-image 9s ease-in-out infinite alternate;animation-play-state:paused}
    .tour-evidence-cta__visual li{animation:tour-evidence-point 4.8s var(--ease) infinite;animation-play-state:paused}
    .tour-evidence-cta__visual li:nth-child(2){animation-delay:-3.2s}.tour-evidence-cta__visual li:nth-child(3){animation-delay:-1.6s}
    .tour-evidence-cta[data-motion-active='true']::before,.tour-evidence-cta[data-motion-active='true'] .tour-evidence-cta__visual img,.tour-evidence-cta[data-motion-active='true'] .tour-evidence-cta__visual li{animation-play-state:running}
    .tour-evidence-cta[data-motion-active='true'] .tour-evidence-cta__visual img{will-change:transform}
  }
  @keyframes tour-evidence-rule{0%,18%{transform:scaleX(.35)}48%,68%{transform:scaleX(1)}100%{transform:scaleX(.35)}}
  @keyframes tour-evidence-image{0%{transform:translate3d(0,0,0)}100%{transform:translate3d(-.7%,.5%,0)}}
  @keyframes tour-evidence-point{0%,68%,100%{background:var(--white)}78%,90%{background:var(--yellow-18)}}
  @media(max-width:960px){.tour-evidence-cta{grid-template-columns:1fr}.tour-evidence-cta__copy{max-width:720px}.tour-evidence-cta__visual{width:min(100%,760px);justify-self:center}}
  @media(max-width:680px){.tour-evidence-cta{padding:28px 18px}.tour-evidence-cta__copy h2{font-size:clamp(2rem,10vw,3rem)}.tour-evidence-cta__actions,.tour-evidence-cta__actions .button{width:100%}.tour-evidence-cta__actions .button{justify-content:center}.tour-evidence-cta__visual ol{grid-template-columns:1fr}.tour-evidence-cta__visual li{border-right:0;border-bottom:1px solid var(--ink-10)}.tour-evidence-cta__visual li:last-child{border-bottom:0}}
  @media(prefers-reduced-motion:reduce){.tour-evidence-cta::before,.tour-evidence-cta__visual img,.tour-evidence-cta__visual li{animation:none!important;transition:none!important}.tour-evidence-cta__visual img{transform:none}}
</style>

---
interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  theme?: 'teal' | 'yellow' | 'ink';
  headingId?: string;
  mascot?: 'welcome2d' | 'guide3d' | 'evidence3d';
}

import { mascots } from '../data/mascots';
import { releaseGates } from '../config/release';

const {
  eyebrow = 'Langkah berikutnya',
  title,
  body,
  primaryLabel = 'Coba Simulasi Gratis',
  primaryHref = '/tour-produk-gratis',
  secondaryLabel = 'Lihat Semua Produk',
  secondaryHref = '/produk',
  theme = 'teal',
  headingId,
  mascot = 'guide3d',
} = Astro.props;
const mascotAsset = releaseGates.mascotExplorationEnabled ? mascots[mascot] : mascots.decisionVisual;

const stages = [
  { label: 'Catatan', title: 'Mulai dari satu pertanyaan', text: 'Pilih angka atau kejadian usaha yang paling perlu dipahami.' },
  { label: 'Bukti', title: 'Periksa jejaknya', text: 'Lihat periode, sumber, dan catatan sebelum menyimpulkan.' },
  { label: 'Arah', title: 'Tentukan langkah', text: 'Gunakan simulasi untuk membahas pilihan tanpa menyerahkan kendali.' },
];
const instanceId = `mascot-decision-${(headingId || title).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
---

<div class={`mascot-decision mascot-decision--${theme}`} data-mascot-decision>
  <div class="mascot-decision__copy">
    <span>{eyebrow}</span>
    <h2 id={headingId}>{title}</h2>
    <p>{body}</p>
    <div class="button-row">
      <a class="button button--primary" href={primaryHref}>{primaryLabel}</a>
      <a class="button button--secondary" href={secondaryHref}>{secondaryLabel}</a>
    </div>
  </div>

  <div class="mascot-decision__visual" aria-label="Alur interaktif dari catatan menuju arah keputusan">
    <div class="mascot-decision__mascot" aria-hidden="true">
      <span class="mascot-decision__orbit"></span>
      <img src={mascotAsset.src} width={mascotAsset.width} height={mascotAsset.height} alt="" loading="lazy" decoding="async" />
    </div>
    <div class="mascot-decision__workspace">
      <div class="mascot-decision__tabs" role="group" aria-label="Tahap membaca kondisi usaha">
        {stages.map((stage, index) => (
          <button type="button" id={`${instanceId}-tab-${index}`} data-decision-tab={index} class:list={{ 'is-active': index === 0 }} aria-pressed={index === 0 ? 'true' : 'false'} aria-controls={`${instanceId}-panel-${index}`}>
            <small>{String(index + 1).padStart(2, '0')}</small>
            <span>{stage.label}</span>
          </button>
        ))}
      </div>
      <div class="mascot-decision__cards">
        {stages.map((stage, index) => (
          <article id={`${instanceId}-panel-${index}`} data-decision-panel={index} class:list={{ 'is-active': index === 0 }} role="region" aria-labelledby={`${instanceId}-tab-${index}`} hidden={index !== 0}>
            <small>{stage.label}</small>
            <strong>{stage.title}</strong>
            <p>{stage.text}</p>
            <div aria-hidden="true"><i></i><i></i><i></i></div>
          </article>
        ))}
      </div>
      <footer><span><i aria-hidden="true"></i> Contoh alur</span><strong>Kendali tetap pada Anda</strong></footer>
    </div>
  </div>
</div>

<script>
  const bindMascotDecisions = () => {
    document.querySelectorAll<HTMLElement>('[data-mascot-decision]').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-decision-tab]')];
      const panels = [...root.querySelectorAll<HTMLElement>('[data-decision-panel]')];
      tabs.forEach((tab) => tab.addEventListener('click', () => {
        const target = tab.dataset.decisionTab;
        tabs.forEach((item) => {
          const active = item === tab;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        panels.forEach((panel) => {
          const active = panel.dataset.decisionPanel === target;
          panel.hidden = !active;
          panel.classList.toggle('is-active', active);
        });
      }));
    });
  };
  bindMascotDecisions();
  document.addEventListener('astro:page-load', bindMascotDecisions);
</script>

<style>
  .mascot-decision{--cta-bg:var(--teal);--cta-fg:var(--white);--cta-accent:var(--yellow);display:grid;grid-template-columns:minmax(0,.82fr) minmax(440px,1.18fr);gap:clamp(34px,6vw,88px);align-items:center;padding:clamp(30px,5vw,66px);overflow:hidden;background:var(--cta-bg);color:var(--cta-fg)}
  .mascot-decision--yellow{--cta-bg:var(--yellow);--cta-fg:var(--ink);--cta-accent:var(--teal)}
  .mascot-decision--ink{--cta-bg:var(--ink);--cta-fg:var(--white);--cta-accent:var(--yellow)}
  .mascot-decision__copy>span{color:var(--cta-accent);font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.mascot-decision__copy h2{max-width:18ch;margin:18px 0 0;font-size:var(--type-h2);line-height:1.04}.mascot-decision__copy p{max-width:49ch;margin:20px 0 0;color:color-mix(in srgb,var(--cta-fg) 72%,transparent);line-height:1.65}.mascot-decision__copy .button-row{display:flex;flex-wrap:wrap;margin-top:30px}.mascot-decision__copy .button--secondary{border-color:color-mix(in srgb,var(--cta-fg) 55%,transparent);color:var(--cta-fg)}.mascot-decision--yellow .button--secondary{border-color:var(--ink);color:var(--ink)}
  .mascot-decision__visual{position:relative;display:grid;grid-template-columns:minmax(130px,.42fr) minmax(0,1fr);align-items:end;min-height:430px;perspective:1100px}.mascot-decision__mascot{position:relative;z-index:3;align-self:end;margin-right:-42px;filter:drop-shadow(0 24px 22px rgb(11 48 69/.2));transform:translateY(18px) rotate(-2deg)}.mascot-decision__mascot img{position:relative;z-index:2;display:block;width:clamp(190px,24vw,310px);height:auto;object-fit:contain}.mascot-decision__orbit{position:absolute;z-index:1;inset:22% 5% 9%;border:1px solid color-mix(in srgb,var(--cta-accent) 72%,transparent);border-radius:50%;transform:rotate(-16deg)}.mascot-decision__orbit::before,.mascot-decision__orbit::after{content:"";position:absolute;width:12px;height:12px;border-radius:50%;background:var(--cta-accent)}.mascot-decision__orbit::before{top:8%;right:13%}.mascot-decision__orbit::after{left:4%;bottom:22%}
  .mascot-decision__workspace{position:relative;z-index:2;min-width:0;border:1px solid var(--ink);background:var(--rice);color:var(--ink);box-shadow:14px 14px 0 rgb(11 48 69/.36);transform:rotateY(-3deg) rotateX(1deg);transform-origin:left center}.mascot-decision__tabs{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid var(--ink)}.mascot-decision__tabs button{display:grid;grid-template-columns:auto 1fr;gap:8px;align-items:center;min-height:54px;border:0;border-right:1px solid var(--ink-10);padding:10px 12px;background:transparent;color:var(--ink);font:inherit;text-align:left;cursor:pointer}.mascot-decision__tabs button:last-child{border-right:0}.mascot-decision__tabs button.is-active{background:var(--yellow)}.mascot-decision__tabs small{color:var(--teal);font-size:.56rem;font-weight:800}.mascot-decision__tabs span{font-size:.7rem;font-weight:800}
  .mascot-decision__cards{min-height:270px;padding:clamp(22px,4vw,38px)}.mascot-decision__cards article{min-height:210px}.mascot-decision__cards article[hidden]{display:none}.mascot-decision__cards article.is-active{display:grid;align-content:end;animation:mascot-card-in .38s var(--ease) both}.mascot-decision__cards small{color:var(--teal);font-size:.65rem;font-weight:800;text-transform:uppercase}.mascot-decision__cards strong{max-width:17ch;margin-top:14px;font-size:clamp(1.35rem,2.5vw,2.15rem);line-height:1.1}.mascot-decision__cards p{max-width:38ch;margin:14px 0 0;color:var(--ink-72);font-size:.82rem}.mascot-decision__cards article>div{display:flex;gap:6px;margin-top:24px}.mascot-decision__cards article>div i{display:block;width:30%;height:7px;background:var(--teal)}.mascot-decision__cards article>div i:nth-child(2){width:22%;background:var(--yellow)}.mascot-decision__cards article>div i:nth-child(3){width:14%;background:var(--ink)}.mascot-decision__workspace footer{display:flex;justify-content:space-between;gap:16px;padding:12px 16px;border-top:1px solid var(--ink-10);font-size:.6rem;font-weight:800}.mascot-decision__workspace footer span{display:flex;align-items:center;gap:7px}.mascot-decision__workspace footer i{width:7px;height:7px;border-radius:50%;background:var(--teal)}
  @media(prefers-reduced-motion:no-preference){.mascot-decision__mascot{animation:mascot-guide-float 4.8s ease-in-out infinite}.mascot-decision__orbit{animation:mascot-orbit 12s linear infinite}@keyframes mascot-card-in{from{opacity:0;transform:translateY(9px)}to{opacity:1;transform:none}}@keyframes mascot-guide-float{50%{transform:translateY(8px) rotate(1deg)}}@keyframes mascot-orbit{to{transform:rotate(344deg)}}}
  @media(max-width:1200px){.mascot-decision{grid-template-columns:1fr}.mascot-decision__copy{max-width:740px}.mascot-decision__visual{width:min(100%,760px);justify-self:center}}
  @media(max-width:620px){.mascot-decision{padding:28px 18px}.mascot-decision__copy h2{font-size:clamp(2rem,10vw,3rem)}.mascot-decision__copy .button-row,.mascot-decision__copy .button{width:100%}.mascot-decision__copy .button{justify-content:center}.mascot-decision__visual{grid-template-columns:1fr;min-height:0;padding-top:120px}.mascot-decision__mascot{position:absolute;z-index:4;top:0;right:4px;margin:0;transform:rotate(3deg)}.mascot-decision__mascot img{width:170px}.mascot-decision__orbit{inset:16% 0 8%}.mascot-decision__workspace{box-shadow:7px 7px 0 rgb(11 48 69/.32);transform:none}.mascot-decision__tabs button{grid-template-columns:1fr;gap:2px;text-align:center}.mascot-decision__cards{min-height:250px;padding:24px 18px}.mascot-decision__workspace footer strong{display:none}}
  @media(prefers-reduced-motion:reduce){.mascot-decision *{animation:none!important;transition:none!important}.mascot-decision__workspace,.mascot-decision__mascot,.mascot-decision__orbit{transform:none!important}}
</style>

---
interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  theme?: 'teal' | 'yellow' | 'ink';
  headingId?: string;
  mascot?: 'welcome2d' | 'working2d' | 'guide3d' | 'evidence3d';
}

import { mascots } from '../data/mascots';
import { releaseGates } from '../config/release';

const {
  eyebrow = 'Langkah berikutnya',
  title,
  body,
  primaryLabel = 'Konsultasi',
  primaryHref = '/tour-produk-gratis/?flow=consultation',
  secondaryLabel = 'Lihat Semua Produk',
  secondaryHref = '/produk/',
  theme = 'teal',
  headingId,
  mascot = 'guide3d',
} = Astro.props;
const fallbackMascot = releaseGates.mascotExplorationEnabled ? mascots[mascot] : mascots.decisionVisual;

const stages = [
  { label: 'Catatan', title: 'Mulai dari satu pertanyaan', text: 'Pilih angka atau kejadian usaha yang paling perlu dipahami.', mascot: 'working2d' as const },
  { label: 'Bukti', title: 'Periksa jejaknya', text: 'Lihat periode, sumber, dan catatan sebelum menyimpulkan.', mascot: 'workLoop2d' as const },
  { label: 'Arah', title: 'Tentukan langkah', text: 'Gunakan contoh alur untuk membahas pilihan tanpa menyerahkan kendali.', mascot: 'welcome2d' as const },
];
const stageMascots = stages.map((stage) => releaseGates.mascotExplorationEnabled ? mascots[stage.mascot] : fallbackMascot);
const instanceSeed = headingId || title;
const instanceHash = [...instanceSeed].reduce((hash, char) => ((hash * 31) + char.charCodeAt(0)) >>> 0, 7).toString(36);
const instanceId = `md-${instanceHash}`;
---

<div class={`mascot-decision mascot-decision--${theme}`} data-mascot-decision>
  <div class="mascot-decision__copy">
    <span>{eyebrow}</span>
    <h2 id={headingId}>{title}</h2>
    <p>{body}</p>
    <div class="button-row">
      <a class="button button--primary" href={primaryHref}>{primaryLabel}</a>
      <a class="button button--secondary" href={secondaryHref}>{secondaryLabel}</a>
    </div>
  </div>

  <div class="mascot-decision__visual" aria-label="Alur interaktif dari catatan menuju arah keputusan">
    <div class="mascot-decision__mascot" aria-hidden="true">
      <img data-decision-mascot data-mascot-motion="guide" src={stageMascots[0].src} width={stageMascots[0].width} height={stageMascots[0].height} alt="Maskot RAMUNI membantu menentukan langkah berikutnya" loading="lazy" decoding="async" />
    </div>
    <div class="mascot-decision__workspace">
      <div class="mascot-decision__tabs" role="group" aria-label="Tahap membaca kondisi usaha">
        {stages.map((stage, index) => (
          <button type="button" id={`${instanceId}-tab-${index}`} data-decision-tab={index} data-mascot-src={stageMascots[index].src} class:list={{ 'is-active': index === 0 }} aria-pressed={index === 0 ? 'true' : 'false'} aria-controls={`${instanceId}-panel-${index}`}>
            <small>{String(index + 1).padStart(2, '0')}</small>
            <span>{stage.label}</span>
          </button>
        ))}
      </div>
      <div class="mascot-decision__cards">
        {stages.map((stage, index) => (
          <article id={`${instanceId}-panel-${index}`} data-decision-panel={index} class:list={{ 'is-active': index === 0 }} role="region" aria-labelledby={`${instanceId}-tab-${index}`} hidden={index !== 0}>
            <small>{stage.label}</small>
            <strong>{stage.title}</strong>
            <p>{stage.text}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  const bindMascotDecisions = () => {
    document.querySelectorAll<HTMLElement>('[data-mascot-decision]').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-decision-tab]')];
      const panels = [...root.querySelectorAll<HTMLElement>('[data-decision-panel]')];
      const mascotImage = root.querySelector<HTMLImageElement>('[data-decision-mascot]');
      let mascotRequest = 0;

      const swapMascot = async (src?: string) => {
        const request = ++mascotRequest;
        if (!mascotImage) return false;
        mascotImage.dataset.transitioning = 'false';
        if (!src) return false;
        if (mascotImage.dataset.currentSrc === src) return true;
        const preload = new Image();
        preload.decoding = 'async';
        preload.src = src;
        try {
          await preload.decode();
        } catch {
          return false;
        }
        if (request !== mascotRequest) return false;

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduceMotion) {
          const fadedOut = new Promise<void>((resolve) => {
            let timeout = 0;
            const finish = () => {
              window.clearTimeout(timeout);
              mascotImage.removeEventListener('transitionend', onTransitionEnd);
              resolve();
            };
            const onTransitionEnd = (event: TransitionEvent) => {
              if (event.propertyName === 'opacity') finish();
            };
            mascotImage.addEventListener('transitionend', onTransitionEnd);
            timeout = window.setTimeout(finish, 260);
          });
          mascotImage.dataset.transitioning = 'true';
          await fadedOut;
          if (request !== mascotRequest) return false;
        }

        mascotImage.src = src;
        mascotImage.dataset.currentSrc = src;
        if (!reduceMotion) {
          await new Promise<void>((resolve) => {
            requestAnimationFrame(() => requestAnimationFrame(() => resolve()));
          });
          if (request !== mascotRequest) return false;
          mascotImage.dataset.transitioning = 'false';
        }
        return true;
      };

      if (mascotImage) mascotImage.dataset.currentSrc = mascotImage.getAttribute('src') || '';

      tabs.forEach((tab) => tab.addEventListener('click', () => {
        const target = tab.dataset.decisionTab;
        tabs.forEach((item) => {
          const active = item === tab;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        panels.forEach((panel) => {
          const active = panel.dataset.decisionPanel === target;
          panel.hidden = !active;
          panel.classList.toggle('is-active', active);
        });
        void swapMascot(tab.dataset.mascotSrc).then((isCurrent) => {
          if (!isCurrent) return;
          root.dataset.stateChanging = 'false';
          void root.offsetWidth;
          root.dataset.stateChanging = 'true';
        });
      }));
    });
  };
  bindMascotDecisions();
  document.addEventListener('astro:page-load', bindMascotDecisions);
</script>

<style>
  .mascot-decision{--cta-bg:var(--teal);--cta-fg:var(--white);--cta-accent:var(--yellow);display:grid;grid-template-columns:minmax(0,.82fr) minmax(440px,1.18fr);gap:clamp(34px,6vw,88px);align-items:center;padding:clamp(30px,5vw,66px);overflow:hidden;background:var(--cta-bg);color:var(--cta-fg)}
  .mascot-decision--yellow{--cta-bg:var(--yellow);--cta-fg:var(--ink);--cta-accent:var(--teal)}
  .mascot-decision--ink{--cta-bg:var(--ink);--cta-fg:var(--white);--cta-accent:var(--yellow)}
  .mascot-decision__copy>span{color:var(--cta-accent);font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.mascot-decision__copy h2{max-width:18ch;margin:18px 0 0;font-size:var(--type-h2);line-height:1.04}.mascot-decision__copy p{max-width:49ch;margin:20px 0 0;color:color-mix(in srgb,var(--cta-fg) 72%,transparent);line-height:1.65}.mascot-decision__copy .button-row{display:flex;flex-wrap:wrap;margin-top:30px}.mascot-decision__copy .button--secondary{border-color:color-mix(in srgb,var(--cta-fg) 55%,transparent);color:var(--cta-fg)}.mascot-decision--yellow .button--secondary{border-color:var(--ink);color:var(--ink)}
  .mascot-decision__visual{position:relative;display:grid;grid-template-columns:minmax(96px,.3fr) minmax(0,1fr);align-items:end;min-height:360px}.mascot-decision__mascot{position:relative;z-index:3;align-self:end;margin-right:-24px;filter:drop-shadow(0 18px 18px rgb(11 48 69/.18));transform:translateY(10px) rotate(-1deg)}.mascot-decision__mascot img{position:relative;z-index:2;display:block;width:clamp(150px,18vw,225px);height:auto;object-fit:contain;transition:opacity .2s var(--ease),transform .28s var(--ease)}.mascot-decision__mascot img[data-transitioning='true']{opacity:0;transform:translateY(4px)}
  .mascot-decision__workspace{position:relative;z-index:2;min-width:0;border:1px solid var(--ink);background:var(--rice);color:var(--ink);box-shadow:10px 10px 0 rgb(11 48 69/.3)}.mascot-decision__tabs{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid var(--ink)}.mascot-decision__tabs button{display:grid;grid-template-columns:auto 1fr;gap:8px;align-items:center;min-height:54px;border:0;border-right:1px solid var(--ink-10);padding:10px 12px;background:transparent;color:var(--ink);font:inherit;text-align:left;cursor:pointer}.mascot-decision__tabs button:last-child{border-right:0}.mascot-decision__tabs button.is-active{background:var(--yellow)}.mascot-decision__tabs small{color:var(--teal);font-size:.56rem;font-weight:800}.mascot-decision__tabs span{font-size:.7rem;font-weight:800}
  .mascot-decision__cards{min-height:270px;padding:clamp(22px,4vw,38px)}.mascot-decision__cards article{min-height:210px}.mascot-decision__cards article[hidden]{display:none}.mascot-decision__cards article.is-active{display:grid;align-content:end}.mascot-decision__cards small{color:var(--teal);font-size:.65rem;font-weight:800;text-transform:uppercase}.mascot-decision__cards strong{max-width:17ch;margin-top:14px;font-size:clamp(1.35rem,2.5vw,2.15rem);line-height:1.1}.mascot-decision__cards p{max-width:38ch;margin:14px 0 0;color:var(--ink-72);font-size:.82rem}
  @media(prefers-reduced-motion:no-preference) and (min-width:1201px) and (hover:hover) and (pointer:fine){.mascot-decision[data-state-changing='true'] .mascot-decision__mascot img{animation:mascot-guide-state 340ms var(--ease) both}.mascot-decision__cards article.is-active{animation:mascot-card-in .3s var(--ease) both}@keyframes mascot-card-in{from{opacity:.35;transform:translateY(6px)}to{opacity:1;transform:none}}@keyframes mascot-guide-state{from{transform:translateY(8px) rotate(-1deg)}to{transform:none}}}
  @media(max-width:960px){.mascot-decision{grid-template-columns:1fr}.mascot-decision__copy{max-width:740px}.mascot-decision__visual{width:min(100%,760px);justify-self:center}}
  @media(min-width:961px) and (max-width:1200px){.mascot-decision{grid-template-columns:minmax(260px,.76fr) minmax(430px,1.24fr);gap:28px;padding:38px}.mascot-decision__visual{min-height:330px;grid-template-columns:92px minmax(0,1fr)}.mascot-decision__mascot{margin-right:-20px}.mascot-decision__mascot img{width:165px}.mascot-decision__cards{min-height:230px;padding:24px}.mascot-decision__cards article{min-height:170px}}
  @media(max-width:620px){.mascot-decision{padding:28px 18px}.mascot-decision__copy h2{font-size:clamp(2rem,10vw,3rem)}.mascot-decision__copy .button-row,.mascot-decision__copy .button{width:100%}.mascot-decision__copy .button{justify-content:center}.mascot-decision__visual{grid-template-columns:1fr;min-height:0;padding-top:105px}.mascot-decision__mascot{position:absolute;z-index:4;top:0;right:4px;margin:0;transform:rotate(2deg)}.mascot-decision__mascot img{width:148px}.mascot-decision__workspace{box-shadow:7px 7px 0 rgb(11 48 69/.32)}.mascot-decision__tabs button{grid-template-columns:1fr;gap:2px;text-align:center}.mascot-decision__cards{min-height:240px;padding:22px 18px}}
  @media(max-width:1200px) and (hover:none){.mascot-decision__mascot{animation:none;transform:translateY(4px)}.mascot-decision__cards article.is-active{animation:none}}
  @media(prefers-reduced-motion:reduce){.mascot-decision *{animation:none!important;transition:none!important}.mascot-decision__workspace,.mascot-decision__mascot{transform:none!important}}
</style>

---
import LeadForm from './LeadForm.astro';

interface Props {
  context?: 'blog' | 'site';
}

const { context = 'site' } = Astro.props;
const isBlog = context === 'blog';
const asideVisual = isBlog
  ? '/website-original/context/ramuni-lead-customer-support.webp'
  : '/website-original/context/ramuni-lead-free-demo.webp';
const asideVisualLabel = isBlog
  ? 'Pemilik usaha berbicara dengan pelanggan sambil meninjau langkah usaha'
  : 'Tim RAMUNI menunjukkan contoh dashboard dalam sesi konsultasi';
---
<dialog class:list={['lead-capture-dialog', `lead-capture-dialog--${context}`]} id="lead-capture-dialog" data-lead-popup data-lead-popup-context={context} aria-label="Formulir RAMUNI" aria-labelledby="lead-capture-title" aria-describedby="lead-capture-description">
  <div class="lead-capture-dialog__shell">
    <aside class="lead-capture-dialog__aside">
      <span class="lead-capture-dialog__eyebrow">{isBlog ? 'Dari bacaan ke langkah berikutnya' : 'Konsultasi RAMUNI'}</span>
      <h2>{isBlog ? 'Jadikan masalah usaha lebih mudah diperiksa.' : 'Bahas kebutuhan yang paling dekat.'}</h2>
      <p>{isBlog ? 'Isi kontak singkat agar tim dapat mengarahkan Anda ke alur yang relevan, tanpa perlu menyiapkan data bisnis.' : 'Kirim konteks singkat. Tim RAMUNI akan membantu memilih alur yang relevan tanpa meminta data bisnis sensitif.'}</p>
      <figure class="lead-capture-dialog__aside-visual">
        <div class="lead-capture-dialog__aside-visual-image" role="img" aria-label={asideVisualLabel} style={`--lead-capture-image: url("${asideVisual}")`}></div>
        <figcaption>{isBlog ? 'Bawa pertanyaan usaha ke percakapan yang lebih terarah.' : 'Lihat contoh alur demo sebelum menentukan langkah berikutnya.'}</figcaption>
      </figure>
      <ul class="lead-capture-dialog__signals" aria-label="Manfaat mengisi formulir">
        <li><span>01</span>Tanpa komitmen dan tanpa data sensitif</li>
        <li><span>02</span>Respons diarahkan sesuai kebutuhan usaha</li>
        <li><span>03</span>WhatsApp terbuka setelah CRM menerima detail</li>
      </ul>
    </aside>
    <section class="lead-capture-dialog__main">
      <header class="lead-capture-dialog__header">
        <div><span>Mulai di sini</span><h3 id="lead-capture-title">Kirim permintaan konsultasi</h3></div>
        <button class="lead-capture-dialog__close" type="button" data-lead-popup-close aria-label="Tutup formulir">×</button>
      </header>
      <p class="lead-capture-dialog__description" id="lead-capture-description">Isi kontak singkat. Tim menerima detailnya sebelum WhatsApp dibuka. Jika ingin langsung mencoba, gunakan tombol Coba gratis.</p>
      <LeadForm kind="demo" handoff="whatsapp" location="auto-lead-popup" submitChoices />
    </section>
  </div>
</dialog>
<script is:inline type="module" src="/scripts/lead-popup.js"></script>

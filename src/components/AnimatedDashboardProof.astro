---
interface Props {
  class?: string;
  label?: string;
}

const {
  class: className = '',
  label = 'Tampilan dashboard RAMUNI dengan data demo: ringkasan penjualan, kas, stok, pelanggan, dan aktivitas usaha',
} = Astro.props;
---

<span
  class:list={['animated-dashboard-proof', className]}
  role="img"
  aria-label={label}
>
  <img
    class="animated-dashboard-proof__frame"
    src="/website-original/product-screens/ramuni-product-dashboard-overview.webp"
    width="1280"
    height="618"
    alt=""
    fetchpriority="high"
    decoding="async"
  />
</span>

<style>
  .animated-dashboard-proof{
    position:relative;
    display:block;
    width:100%;
    aspect-ratio:60/29;
    overflow:hidden;
    background:var(--rice);
    contain:paint;
  }

  .animated-dashboard-proof__frame{
    position:absolute;
    inset:0;
    display:block;
    width:100%;
    height:100%;
    object-fit:contain;
    object-position:top center;
    opacity:1;
    transform:none;
  }

  @media(max-width:680px){
    .animated-dashboard-proof{aspect-ratio:16/10}
    .animated-dashboard-proof__frame{object-fit:contain;object-position:top center}
  }

</style>

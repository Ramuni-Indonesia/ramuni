---
interface Props {
  class?: string;
  label?: string;
}

const {
  class: className = '',
  label = 'Tampilan dashboard RAMUNI: ringkasan penjualan, kas, stok, pelanggan, dan aktivitas usaha',
} = Astro.props;
---

<span
  class:list={['animated-dashboard-proof', className]}
  role="img"
  aria-label={label}
>
  <img
    class="animated-dashboard-proof__frame"
    src="/website-original/product-screens/ramuni-saas-dashboard-desktop-1440.webp"
    width="1440"
    height="1202"
    alt=""
    fetchpriority="high"
    decoding="async"
  />
</span>

<style>
  .animated-dashboard-proof{
    position:relative;
    display:block;
    width:100%;
    aspect-ratio:1440/1202;
    overflow:hidden;
    background:var(--rice);
    contain:paint;
  }

  .animated-dashboard-proof__frame{
    position:absolute;
    inset:0;
    display:block;
    width:100%;
    height:100%;
    object-fit:contain;
    object-position:top center;
    opacity:1;
    transform:none;
  }

</style>

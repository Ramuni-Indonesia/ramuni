---
interface Props {
  class?: string;
  label?: string;
}

const {
  class: className = '',
  label = 'Tiga tampilan dashboard RAMUNI dengan data demo: ringkasan usaha, performa, dan aktivitas operasional',
} = Astro.props;
---

<span
  class:list={['animated-dashboard-proof', className]}
  role="img"
  aria-label={label}
>
  <img
    class="animated-dashboard-proof__frame animated-dashboard-proof__frame--overview"
    src="/website-original/product-screens/ramuni-product-dashboard-overview.webp"
    width="1280"
    height="618"
    alt=""
    fetchpriority="high"
    decoding="async"
  />
  <img
    class="animated-dashboard-proof__frame animated-dashboard-proof__frame--performance"
    src="/website-original/product-screens/ramuni-product-dashboard-performance.webp"
    width="1280"
    height="854"
    alt=""
    decoding="async"
  />
  <img
    class="animated-dashboard-proof__frame animated-dashboard-proof__frame--operations"
    src="/website-original/product-screens/ramuni-product-dashboard-operations.webp"
    width="1280"
    height="854"
    alt=""
    decoding="async"
  />
</span>

<style>
  .animated-dashboard-proof{
    position:relative;
    display:block;
    width:100%;
    aspect-ratio:60/29;
    overflow:hidden;
    background:var(--rice);
    contain:paint;
  }

  .animated-dashboard-proof__frame{
    position:absolute;
    inset:0;
    display:block;
    width:100%;
    height:100%;
    object-fit:contain;
    object-position:top center;
    opacity:0;
    transform:translate3d(0,10px,0) scale(1.015);
  }

  .animated-dashboard-proof__frame--overview{opacity:1;transform:none}

  @media(prefers-reduced-motion:no-preference){
    .animated-dashboard-proof__frame--overview{animation:dashboard-overview 12s cubic-bezier(.22,1,.36,1) infinite}
    .animated-dashboard-proof__frame--performance{animation:dashboard-performance 12s cubic-bezier(.22,1,.36,1) infinite}
    .animated-dashboard-proof__frame--operations{animation:dashboard-operations 12s cubic-bezier(.22,1,.36,1) infinite}

    @keyframes dashboard-overview{
      0%,27%{opacity:1;transform:none}
      33%,94%{opacity:0;transform:translate3d(-8px,0,0) scale(1.012)}
      100%{opacity:1;transform:none}
    }
    @keyframes dashboard-performance{
      0%,27%,66%,100%{opacity:0;transform:translate3d(8px,10px,0) scale(1.015)}
      34%,60%{opacity:1;transform:none}
    }
    @keyframes dashboard-operations{
      0%,60%,100%{opacity:0;transform:translate3d(8px,10px,0) scale(1.015)}
      68%,94%{opacity:1;transform:none}
    }
  }

  @media(max-width:680px){
    .animated-dashboard-proof{aspect-ratio:16/10}
    .animated-dashboard-proof__frame{object-fit:cover;object-position:top left}
  }

  @media(prefers-reduced-motion:reduce){
    .animated-dashboard-proof__frame:not(.animated-dashboard-proof__frame--overview){display:none}
  }
</style>

---
interface Props {
  class?: string;
  label?: string;
}

const {
  class: className = '',
  label = 'Dashboard RAMUNI bergerak menampilkan ringkasan penjualan, kas, stok, pelanggan, dan aktivitas usaha',
} = Astro.props;
import LaptopMockup from './LaptopMockup.astro';
---

<LaptopMockup label={label}>
  <span
    class:list={['animated-dashboard-proof', className]}
    role="img"
    aria-label={label}
    data-animate="false"
  >
    <video
      class="animated-dashboard-proof__frame"
      muted
      loop
      playsinline
      preload="metadata"
      poster="/website-original/product-screens/ramuni-product-dashboard-overview.webp"
      aria-hidden="true"
      tabindex="-1"
    >
      <source src="/website-original/product-screens/ramuni-product-dashboard-overview-loop.webm" type="video/webm" />
      <source src="/website-original/product-screens/ramuni-product-dashboard-overview-loop.mp4" type="video/mp4" />
    </video>
    <img class="animated-dashboard-proof__fallback" src="/website-original/product-screens/ramuni-product-dashboard-overview.webp" width="1280" height="618" alt="Tampilan ringkasan dashboard produk RAMUNI" fetchpriority="high" decoding="async" aria-hidden="true" />
    <span class="animated-dashboard-proof__scanline" aria-hidden="true"></span>
  </span>
</LaptopMockup>

<script>
  const animatedDashboardCleanups = new Map<HTMLElement, () => void>();

  const bindAnimatedDashboardProof = () => {
    document.querySelectorAll<HTMLElement>('.animated-dashboard-proof').forEach((proof) => {
      if (proof.dataset.bound === 'true') return;
      proof.dataset.bound = 'true';
      const video = proof.querySelector<HTMLVideoElement>('video');
      if (!video) return;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const saveData = Boolean((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData);
      let inView = false;
      const update = () => {
        const canAnimate = inView && !document.hidden && !reducedMotion.matches && !saveData;
        proof.dataset.animate = canAnimate ? 'true' : 'false';
        if (canAnimate) void video.play().catch(() => undefined);
        else {
          video.pause();
          if (!inView || reducedMotion.matches) video.currentTime = 0;
        }
      };
      let observer: IntersectionObserver | undefined;
      if (!('IntersectionObserver' in window)) {
        inView = true;
        update();
      } else {
        observer = new IntersectionObserver(([entry]) => {
          inView = entry?.isIntersecting ?? false;
          update();
        }, { rootMargin: '120px 0px', threshold: 0.08 });
        observer.observe(proof);
      }
      document.addEventListener('visibilitychange', update);
      reducedMotion.addEventListener?.('change', update);
      animatedDashboardCleanups.set(proof, () => {
        observer?.disconnect();
        document.removeEventListener('visibilitychange', update);
        reducedMotion.removeEventListener?.('change', update);
        video.pause();
        delete proof.dataset.bound;
      });
    });
  };
  bindAnimatedDashboardProof();
  document.addEventListener('astro:page-load', bindAnimatedDashboardProof);
  document.addEventListener('astro:before-swap', () => {
    animatedDashboardCleanups.forEach((cleanup) => cleanup());
    animatedDashboardCleanups.clear();
  });
</script>

<style>
  .animated-dashboard-proof{
    position:relative;
    display:block;
    width:100%;
    aspect-ratio:1280/618;
    overflow:hidden;
    border:0;
    border-radius:0;
    background:var(--rice);
    box-shadow:none;
    contain:paint;
    container-type:inline-size;
    --hero-dashboard-scan-distance:calc(38.6cqw - 2px);
  }

  .animated-dashboard-proof__frame{
    position:relative;
    z-index:1;
    display:block;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center;
  }

  .animated-dashboard-proof__fallback{
    position:absolute;
    inset:0;
    z-index:0;
    display:block;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center;
    opacity:1;
    transition:opacity .35s ease;
  }

  .animated-dashboard-proof[data-animate='true'] .animated-dashboard-proof__fallback{opacity:0}

  .animated-dashboard-proof__scanline{
    position:absolute;
    z-index:2;
    left:2%;
    right:2%;
    top:10%;
    height:2px;
    border-radius:999px;
    background:linear-gradient(90deg,transparent,rgb(22 140 140/.42),transparent);
    opacity:0;
    pointer-events:none;
  }

  @media(prefers-reduced-motion:no-preference){
    .animated-dashboard-proof__scanline{animation:hero-dashboard-scanline 7s cubic-bezier(.45,0,.18,1) infinite;animation-play-state:paused}
    .animated-dashboard-proof[data-animate='true'] .animated-dashboard-proof__scanline{animation-play-state:running}
  }

  @keyframes hero-dashboard-scanline{
    0%,12%{opacity:0;transform:translate3d(0,0,0)}
    20%{opacity:.72}
    78%{opacity:.42;transform:translate3d(0,var(--hero-dashboard-scan-distance),0)}
    88%,100%{opacity:0;transform:translate3d(0,var(--hero-dashboard-scan-distance),0)}
  }

  @media(max-width:740px){
    .animated-dashboard-proof{aspect-ratio:1280/618;border-radius:0;box-shadow:none}
  }

  @media(prefers-reduced-motion:reduce){
    .animated-dashboard-proof__frame{visibility:hidden}
    .animated-dashboard-proof__fallback{opacity:1}
    .animated-dashboard-proof__scanline{animation:none;transform:none;opacity:0}
  }
</style>

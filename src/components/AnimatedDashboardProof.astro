---
interface Props {
  class?: string;
  label?: string;
}

const {
  class: className = '',
  label = 'Dashboard RAMUNI dengan data demo bergerak dari ringkasan ke aktivitas usaha',
} = Astro.props;
---

<span
  class:list={['animated-dashboard-proof', className]}
  role="img"
  aria-label={label}
  data-animated-dashboard-proof
  data-animate="false"
>
  <video
    muted
    loop
    playsinline
    preload="metadata"
    poster="/website-original/product-screens/ramuni-product-dashboard-overview.webp"
    aria-hidden="true"
    tabindex="-1"
  >
    <source src="/website-original/product-screens/ramuni-product-dashboard-overview-loop.webm" type="video/webm" />
    <source src="/website-original/product-screens/ramuni-product-dashboard-overview-loop.mp4" type="video/mp4" />
  </video>
  <span class="animated-dashboard-proof__story" aria-hidden="true">
    <span class="animated-dashboard-proof__step animated-dashboard-proof__step--notes"><b>01</b> Catatan masuk</span>
    <span class="animated-dashboard-proof__step animated-dashboard-proof__step--evidence"><b>02</b> Bukti disorot</span>
    <span class="animated-dashboard-proof__step animated-dashboard-proof__step--direction"><b>03</b> Arah muncul</span>
  </span>
  <span class="animated-dashboard-proof__direction" aria-hidden="true">
    <small>Arah berikutnya</small>
    <strong>Periksa stok cepat sebelum jam ramai.</strong>
  </span>
</span>

<script>
  const bindAnimatedDashboardProof = () => {
    document.querySelectorAll<HTMLElement>('[data-animated-dashboard-proof]').forEach((proof) => {
      if (proof.dataset.bound === 'true') return;
      proof.dataset.bound = 'true';

      const video = proof.querySelector<HTMLVideoElement>('video');
      if (!video) return;
      const heroStory = proof.closest<HTMLElement>('.home-decision-demo');

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const saveData = Boolean((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData);
      let inView = false;
      const update = () => {
        const canAnimate = inView && !document.hidden && !reducedMotion.matches && !saveData;
        proof.dataset.animate = canAnimate ? 'true' : 'false';
        if (heroStory) heroStory.dataset.storyActive = canAnimate ? 'true' : 'false';
        if (canAnimate) {
          video.playbackRate = 1;
          void video.play().catch(() => undefined);
        } else {
          video.pause();
          if (!inView || document.hidden || reducedMotion.matches) {
            video.currentTime = 0;
          }
        }
      };

      if (!('IntersectionObserver' in window)) {
        inView = true;
        update();
        return;
      }

      const observer = new IntersectionObserver(([entry]) => {
        inView = entry?.isIntersecting ?? false;
        update();
      }, { rootMargin: '160px 0px', threshold: 0.08 });

      observer.observe(proof);
      document.addEventListener('visibilitychange', update);
      reducedMotion.addEventListener?.('change', update);
    });
  };

  bindAnimatedDashboardProof();
  document.addEventListener('astro:page-load', bindAnimatedDashboardProof);
</script>

<style>
  .animated-dashboard-proof{
    position:relative;
    display:block;
    width:100%;
    aspect-ratio:60/29;
    overflow:hidden;
    background:var(--rice);
    contain:paint;
  }

  .animated-dashboard-proof video{
    display:block;
    width:100%;
    height:100%;
    object-fit:contain;
    object-position:top;
  }

  .animated-dashboard-proof__story{position:absolute;z-index:2;inset:12px auto auto 12px;display:grid;gap:6px;pointer-events:none}
  .animated-dashboard-proof__step{width:max-content;max-width:calc(100vw - 80px);padding:7px 9px;border:1px solid rgb(11 48 69/.16);background:rgb(244 240 231/.92);color:var(--ink);box-shadow:0 9px 22px rgb(11 48 69/.08);font-size:.57rem;font-weight:800;letter-spacing:.04em;opacity:0;transform:translateY(8px)}
  .animated-dashboard-proof__step b{color:var(--teal);font-weight:800}.animated-dashboard-proof__step--evidence{background:rgb(255 255 255/.94)}.animated-dashboard-proof__step--direction{background:var(--yellow)}
  .animated-dashboard-proof__direction{position:absolute;z-index:3;right:14px;bottom:14px;width:min(260px,44%);padding:12px 14px;background:rgb(11 48 69/.93);color:var(--white);box-shadow:0 16px 34px rgb(11 48 69/.22);opacity:0;transform:translateY(10px);pointer-events:none}
  .animated-dashboard-proof__direction small{display:block;color:var(--yellow);font-size:.55rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.animated-dashboard-proof__direction strong{display:block;margin-top:5px;font-size:.68rem;line-height:1.35}

  @media(prefers-reduced-motion:no-preference){
    .animated-dashboard-proof[data-animate='true'] .animated-dashboard-proof__step--notes{animation:dashboard-step-in 7.2s cubic-bezier(.22,1,.36,1) both}
    .animated-dashboard-proof[data-animate='true'] .animated-dashboard-proof__step--evidence{animation:dashboard-step-in 6.25s .95s cubic-bezier(.22,1,.36,1) both}
    .animated-dashboard-proof[data-animate='true'] .animated-dashboard-proof__step--direction{animation:dashboard-step-in 5.15s 2.05s cubic-bezier(.22,1,.36,1) both}
    .animated-dashboard-proof[data-animate='true'] .animated-dashboard-proof__direction{animation:dashboard-direction 4.5s 2.7s cubic-bezier(.22,1,.36,1) both}
    @keyframes dashboard-step-in{0%{opacity:0;transform:translateY(8px)}8%,72%{opacity:1;transform:none}100%{opacity:.88;transform:none}}
    @keyframes dashboard-direction{0%{opacity:0;transform:translateY(10px)}12%,100%{opacity:1;transform:none}}
  }

  @media(max-width:620px){.animated-dashboard-proof__story{inset:8px auto auto 8px}.animated-dashboard-proof__step{padding:5px 7px;font-size:.5rem}.animated-dashboard-proof__direction{right:8px;bottom:8px;width:53%;padding:8px 10px}.animated-dashboard-proof__direction strong{font-size:.57rem}}

  @media(prefers-reduced-motion:reduce){
    .animated-dashboard-proof video{visibility:hidden}
    .animated-dashboard-proof{
      background:var(--rice) url('/website-original/product-screens/ramuni-product-dashboard-overview.webp') top center/cover no-repeat;
    }
    .animated-dashboard-proof__story,.animated-dashboard-proof__direction{display:none}
  }
</style>

---
interface Props {
  class?: string;
  label?: string;
}

const {
  class: className = '',
  label = 'Tampilan dashboard RAMUNI: ringkasan penjualan, kas, stok, pelanggan, dan aktivitas usaha',
} = Astro.props;
---

<span
  class:list={['animated-dashboard-proof', className]}
  role="img"
  aria-label={label}
>
  <img
    class="animated-dashboard-proof__frame"
    src="/website-original/product-screens/ramuni-saas-dashboard-desktop-1440.webp"
    width="1440"
    height="1202"
    alt=""
    fetchpriority="high"
    decoding="async"
  />
</span>

<style>
  .animated-dashboard-proof{
    position:relative;
    display:block;
    width:100%;
    aspect-ratio:16/10;
    overflow:hidden;
    border:1px solid rgb(11 48 69/.16);
    border-radius:22px;
    background:var(--rice);
    box-shadow:0 24px 70px rgb(11 48 69/.13);
    contain:paint;
  }

  .animated-dashboard-proof__frame{
    display:block;
    width:100%;
    height:auto;
    object-fit:contain;
    object-position:top center;
    transform:translate3d(0,0,0);
  }

  @media(prefers-reduced-motion:no-preference){
    .animated-dashboard-proof__frame{animation:hero-dashboard-scan 14s cubic-bezier(.45,0,.18,1) infinite}
  }

  @keyframes hero-dashboard-scan{
    0%,14%{transform:translate3d(0,0,0)}
    38%,52%{transform:translate3d(0,-12%,0)}
    72%,86%{transform:translate3d(0,-25%,0)}
    100%{transform:translate3d(0,0,0)}
  }

  @media(max-width:740px){
    .animated-dashboard-proof{aspect-ratio:4/3;border-radius:16px;box-shadow:0 16px 38px rgb(11 48 69/.12)}
  }

  @media(prefers-reduced-motion:reduce){
    .animated-dashboard-proof__frame{animation:none;transform:none}
  }
</style>

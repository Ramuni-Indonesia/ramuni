---
import AnimatedDashboardProof from './AnimatedDashboardProof.astro';
import AnimatedMuniWork from './AnimatedMuniWork.astro';
---

<div class="ramuni-hero-visual home-decision-demo" aria-label="Tampilan dashboard RAMUNI dengan data demo dan Muni yang sedang bekerja">
  <div class="direction-fold" aria-hidden="true">
    <span class="direction-fold__ink"></span>
    <span class="direction-fold__teal"></span>
    <span class="direction-fold__yellow"></span>
  </div>

  <figure class="home-hero-proof">
    <header class="home-hero-proof__head">
      <span>Dashboard RAMUNI</span>
      <strong><i aria-hidden="true"></i>Data demo</strong>
    </header>
    <AnimatedDashboardProof class="home-hero-proof__dashboard" />
    <figcaption>
      <span>Tampilan produk · data demo</span>
      <strong>Ringkasan usaha bergerak dari sinyal utama ke aktivitas yang perlu diperiksa.</strong>
    </figcaption>
  </figure>

  <AnimatedMuniWork
    class="home-hero-proof__mascot"
    label="Muni bergerak sambil memeriksa catatan dan dashboard RAMUNI"
  />
  <div class="visual-note visual-note--evidence" aria-hidden="true">
    <span>Bukti produk</span>
    <strong>Diambil dari dashboard RAMUNI SaaS</strong>
  </div>
</div>

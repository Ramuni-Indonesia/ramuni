---
import AnimatedDashboardProof from './AnimatedDashboardProof.astro';
---

<div class="ramuni-hero-visual home-decision-demo">
  <figure class="home-hero-proof">
    <header class="home-hero-proof__head">
      <span>Dashboard RAMUNI</span>
      <strong><i aria-hidden="true"></i> Tampilan produk · data demo</strong>
    </header>
    <AnimatedDashboardProof class="home-hero-proof__dashboard" />
    <figcaption>
      <strong>Satu layar untuk melihat perubahan penjualan, kas, stok, dan aktivitas usaha.</strong>
      <small>Angka di layar adalah fixture pengujian, bukan data pelanggan.</small>
    </figcaption>
  </figure>

  <div class="home-hero-story" aria-label="Tampilan dashboard yang berganti otomatis">
    <span class="home-hero-story__step home-hero-story__step--overview"><b>01</b> Ringkasan</span>
    <span class="home-hero-story__step home-hero-story__step--performance"><b>02</b> Perubahan</span>
    <span class="home-hero-story__step home-hero-story__step--operations"><b>03</b> Perlu perhatian</span>
  </div>
  <img
    class="home-hero-guide"
    src="/website-original/mascot/ramuni-mascot-work-loop-poster.webp"
    width="376"
    height="422"
    alt="Muni menemani contoh dashboard RAMUNI"
    loading="eager"
    decoding="async"
  />
</div>

---
import AnimatedMuniWork from './AnimatedMuniWork.astro';
---

<div class="ramuni-hero-visual home-decision-demo">
  <figure class="home-hero-product">
    <div class="home-hero-product__viewport">
      <div class="home-hero-product__dashboard">
        <div class="home-dashboard" role="img" aria-label="Contoh dashboard RAMUNI dengan ringkasan penjualan, kas, stok, dan wawasan">
          <header><span>RAMUNI</span><strong>Ringkasan usaha</strong><small>4 sinyal aktif</small></header>
          <div class="home-dashboard__body">
            <div class="home-dashboard__summary"><span>Prioritas pagi</span><strong>Penjualan, kas, stok, dan pelanggan dibaca dalam satu ruang kerja.</strong></div>
            <div class="home-dashboard__metrics">
              <span><small>Penjualan hari ini</small><strong>Rp4,8 jt</strong><em>+8,4%</em></span>
              <span><small>Kas tersedia</small><strong>Rp18,6 jt</strong><em>2 biaya jatuh tempo</em></span>
              <span><small>Produk aktif</small><strong>126</strong><em>2 stok menipis</em></span>
            </div>
            <div class="home-dashboard__reading">
              <div class="home-dashboard__chart" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
              <div class="home-dashboard__insight"><span>Wawasan RAMUNI</span><strong>Penjualan sore cenderung naik.</strong><p>Periksa stok produk cepat bergerak sebelum jam ramai.</p></div>
            </div>
          </div>
          <p class="home-dashboard__note">Data contoh untuk menjelaskan alur.</p>
        </div>
      </div>
      <aside class="home-hero-guide" aria-label="Muni membantu membaca dashboard">
        <AnimatedMuniWork class="home-hero-guide__mascot" label="Muni bergerak sambil membantu membaca dashboard RAMUNI" />
      </aside>
    </div>
    <figcaption>
      <strong>Dashboard RAMUNI</strong>
      <span>Perubahan penting bergerak ke urutan teratas, lalu angka pendukung tetap bisa dibuka.</span>
    </figcaption>
  </figure>
</div>

<style>
  .home-dashboard{overflow:hidden;border:1px solid rgb(11 48 69/.14);background:var(--rice);color:var(--ink);font-variant-numeric:tabular-nums}
  .home-dashboard>header{display:grid;grid-template-columns:auto 1fr auto;gap:9px;align-items:baseline;padding:11px 15px;background:var(--ink);color:var(--white)}.home-dashboard>header span{color:var(--yellow);font-size:.64rem;font-weight:900;letter-spacing:.08em}.home-dashboard>header strong{font-size:.77rem}.home-dashboard>header small{color:rgb(255 255 255/.72);font-size:.61rem;font-weight:800}
  .home-dashboard__body{display:grid;gap:12px;padding:14px}.home-dashboard__summary{display:grid;gap:4px}.home-dashboard__summary span,.home-dashboard__insight span{color:var(--teal);font-size:.63rem;font-weight:900;text-transform:uppercase;letter-spacing:.08em}.home-dashboard__summary strong{font-size:clamp(.96rem,1.45vw,1.2rem);line-height:1.3}
  .home-dashboard__metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.home-dashboard__metrics>span{display:grid;gap:6px;min-width:0;padding:11px;border:1px solid var(--ink-10);border-radius:12px;background:var(--white)}.home-dashboard__metrics small{color:var(--ink-72);font-size:.64rem;font-weight:800}.home-dashboard__metrics strong{font-size:clamp(1.1rem,2vw,1.52rem)}.home-dashboard__metrics em{color:var(--ink-56);font-size:.6rem;font-style:normal}
  .home-dashboard__reading{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(170px,.75fr);gap:12px}.home-dashboard__chart{display:flex;align-items:end;gap:8px;min-height:112px;padding:14px;border:1px solid var(--ink-10);border-radius:12px;background:var(--white)}.home-dashboard__chart i{flex:1;height:var(--h,42%);border-radius:7px 7px 3px 3px;background:var(--teal);transform-origin:bottom}.home-dashboard__chart i:nth-child(2){--h:58%}.home-dashboard__chart i:nth-child(3){--h:48%}.home-dashboard__chart i:nth-child(4){--h:72%}.home-dashboard__chart i:nth-child(5){--h:68%}.home-dashboard__chart i:nth-child(6){--h:86%;background:var(--yellow)}
  .home-dashboard__insight{display:grid;align-content:start;gap:8px;padding:13px;border-radius:12px;background:var(--ink);color:var(--white)}.home-dashboard__insight span{color:var(--yellow)}.home-dashboard__insight strong{font-size:.82rem;line-height:1.35}.home-dashboard__insight p{margin:0;color:rgb(255 255 255/.72);font-size:.67rem;line-height:1.45}.home-dashboard__note{margin:0;padding:7px 14px;border-top:1px solid var(--ink-10);background:var(--white);color:var(--ink-56);font-size:.6rem;font-weight:700}
  @media(prefers-reduced-motion:no-preference){.home-dashboard__chart i{animation:home-dashboard-read 4.8s cubic-bezier(.22,1,.36,1) both}.home-dashboard__chart i:nth-child(2){animation-delay:90ms}.home-dashboard__chart i:nth-child(3){animation-delay:180ms}.home-dashboard__chart i:nth-child(4){animation-delay:270ms}.home-dashboard__chart i:nth-child(5){animation-delay:360ms}.home-dashboard__chart i:nth-child(6){animation-delay:450ms}@keyframes home-dashboard-read{from{transform:scaleY(.18);opacity:.45}to{transform:scaleY(1);opacity:1}}}
  @media(max-width:620px){.home-dashboard__metrics{grid-template-columns:1fr 1fr}.home-dashboard__metrics>span:last-child{grid-column:1/-1}.home-dashboard__reading{grid-template-columns:1fr}.home-dashboard__chart{min-height:96px}.home-dashboard>header small{display:none}.home-dashboard__body{padding:11px}}
  @media(prefers-reduced-motion:reduce){.home-dashboard__chart i{animation:none}}
</style>

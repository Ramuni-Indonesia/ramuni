---
import AnimatedDashboardProof from './AnimatedDashboardProof.astro';
import AnimatedMuniWork from './AnimatedMuniWork.astro';
---

<div class="ramuni-hero-visual home-decision-demo">
  <figure class="home-hero-product">
    <div class="home-hero-product__viewport">
      <AnimatedDashboardProof class="home-hero-product__dashboard" />
    </div>
    <figcaption>
      <strong>Dashboard RAMUNI</strong>
      <span>Satu layar untuk membaca perubahan usaha.</span>
      <small>Contoh tampilan RAMUNI.</small>
    </figcaption>
  </figure>

  <aside class="home-hero-guide" aria-label="Muni membantu membaca dashboard">
    <AnimatedMuniWork class="home-hero-guide__mascot" label="Muni bergerak sambil membantu membaca dashboard RAMUNI" />
    <p><strong>Lihat perubahan dulu.</strong><span>Buka angkanya saat perlu memeriksa.</span></p>
  </aside>
</div>

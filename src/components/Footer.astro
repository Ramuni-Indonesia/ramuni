---
import { appCta, footerNavigation } from '../data/site';
const year = new Date().getFullYear();
const routePath = (href: string) => href === '/' ? '/' : href.replace(/\/+$/, '');
const matchesRoute = (href: string, route: string) => routePath(href) === route;
const publicHref = (href: string) => matchesRoute(href, '/demo') ? '/tour-produk-gratis/' : href;
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand"><img src="/brand/ramuni-lockup-horizontal-white-tight.webp" width="1187" height="355" alt="RAMUNI" /><p>AI Business Companion untuk membantu UMKM memahami bisnis dan menentukan perhatian berikutnya.</p></div>
      {footerNavigation.map((group) => (
        <nav class="footer-col" aria-label={group.label}>
          <h2>{group.label}</h2>
          {group.links.filter((link) => !matchesRoute(link.href, '/harga') && !matchesRoute(link.href, '/status')).map((link) => <a href={publicHref(link.href)} data-destination={link.href === appCta.href ? 'app' : undefined}>{matchesRoute(link.href, '/demo') ? appCta.label : link.label}</a>)}
        </nav>
      ))}
    </div>
    <div class="footer-bottom"><span>© {year} RAMUNI. Hak cipta dilindungi.</span><span>Bahasa Indonesia · Meramu insight. Memberi arah.</span></div>
  </div>
</footer>

---
import { footerNavigation } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand"><img src="/brand/ramuni-lockup-horizontal-white.webp" width="560" height="140" alt="RAMUNI" /><p>AI Business Companion untuk membantu UMKM memahami bisnis dan menentukan perhatian berikutnya.</p></div>
      {footerNavigation.map((group) => (
        <nav class="footer-col" aria-label={group.label}>
          <h2>{group.label}</h2>
          {group.links.map((link) => <a href={link.href}>{link.label}</a>)}
          {group.label === 'Legal' && <button class="footer-button" type="button" data-cookie-settings>Kelola Cookie</button>}
        </nav>
      ))}
    </div>
    <div class="footer-bottom"><span>© {year} RAMUNI. Hak cipta dilindungi.</span><span>Bahasa Indonesia · Meramu insight. Memberi arah.</span></div>
  </div>
</footer>

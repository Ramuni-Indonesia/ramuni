---
interface Props {
  class?: string;
  label?: string;
  mode?: 'responsive' | 'laptop' | 'tablet' | 'phone';
}

const {
  class: className = '',
  label = 'Tampilan produk RAMUNI dalam mockup perangkat',
  mode = 'responsive',
} = Astro.props;
---

  <span class:list={['device-mockup', `device-mockup--${mode}`, className]} role="img" aria-label={label} data-device-motion="true">
  <span class="device-mockup__frame">
    <span class="device-mockup__screen"><slot /></span>
  </span>
  <span class="device-mockup__hinge" aria-hidden="true"></span>
  <span class="device-mockup__base" aria-hidden="true"></span>
</span>

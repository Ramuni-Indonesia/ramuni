{
  "name": "ramuni-marketing-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "cross-env NAPI_RS_FORCE_WASI=1 astro dev",
    "build": "cross-env NAPI_RS_FORCE_WASI=1 astro check && cross-env NAPI_RS_FORCE_WASI=1 astro build",
    "preview": "cross-env NAPI_RS_FORCE_WASI=1 astro preview",
    "check": "cross-env NAPI_RS_FORCE_WASI=1 astro check",
    "test:content-gateway": "node scripts/test-content-gateway.mjs",
    "test:cms-candidate-render": "node scripts/test-cms-candidate-render.mjs",
    "test:cms-article-candidate-render": "node scripts/test-cms-article-candidate-render.mjs",
    "test:calculators": "node --test test/calculator-engine.test.mjs",
    "test:cms-provider": "node --test test/cms-build-provider.test.mjs",
    "test:r2-sync": "node --test test/sync-r2-assets.test.mjs",
    "audit": "node scripts/site-audit.mjs",
    "r2:sync": "node scripts/sync-r2-assets.mjs",
    "assets:cdn": "node scripts/rewrite-cdn-assets.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@types/three": "^0.185.1",
    "astro": "^7.1.3",
    "gsap": "^3.15.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/compiler-binding-wasm32-wasi": "^0.3.1",
    "@bruits/satteri-wasm32-wasi": "^0.9.5",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "sharp": "^0.35.3",
    "typescript": "^5.9.2"
  }
}
